namespace EGF

open MeasureTheory ProbabilityTheory Filter Set
open scoped ENNReal NNReal Topology symmDiff

variable {S : Type*} [MeasurableSpace S]

/-! ## The group generated by the moves -/

/-- **The group generated by the moves** `Φᵢ`, as permutations of `𝒮`. -/
def egfGroup {p : ℕ} (Φ : Fin p → S ≃ᵐ S) : Subgroup (Equiv.Perm S) :=
  Subgroup.closure (Set.range fun i => (Φ i).toEquiv)

theorem toEquiv_mem_egfGroup {p : ℕ} (Φ : Fin p → S ≃ᵐ S) (i : Fin p) :
    (Φ i).toEquiv ∈ egfGroup Φ :=
  Subgroup.subset_closure ⟨i, rfl⟩

/-! ## Definition 3.1 (DEC-146) -/

/-- **An Ergodic Generative Flow** (`def:egf`, `main.tex:216–222`, in DEC-146's corrected form,
C-26 with C-27): a generative flow `F` on `(𝒮, λ)` whose forward policy is
`π(s) = ∑ᵢ αⁱ(s) δ_{Φᵢ(s)}` for a measurable policy `α` with values in the simplex, the moves `Φᵢ`
being measurable equivalences that preserve the `λ`-null sets both ways (the property
diffeomorphisms have for the Riemannian volume), and the group they generate being ergodic for
`λ`. -/
structure IsEGFErgodic (lam : Measure S) (F : GenerativeFlow S) {p : ℕ} (Φ : Fin p → S ≃ᵐ S)
    (α : Fin p → S → ℝ) : Prop where
  /-- `π(s) = ∑ᵢ αⁱ(s) δ_{Φᵢ(s)}`, `α` measurable, `αⁱ ≥ 0`, `∑ᵢ αⁱ = 1` (C-27). -/
  policy : IsEGFPolicy F.policy (fun i => Φ i) α
  /-- Each move and its inverse preserve the `λ`-null sets: `(Φᵢ)₊λ ≪ λ`, `(Φᵢ⁻¹)₊λ ≪ λ` (C-6). -/
  nonsingular : ∀ i, lam.map (Φ i) ≪ lam ∧ lam.map (Φ i).symm ≪ lam
  /-- The group generated by the moves is ergodic for `λ` (DEC-146, C-26). -/
  ergodic : IsGroupErgodic lam (egfGroup Φ)

/-! ## From the generators to the group -/

/-- **A set a.e.-invariant under nonsingular generators is a.e.-invariant under the group they
generate**: `EGF.ae_invariant_of_mem_closure` (`EGF/TorusFamilies.lean:567`) with the generators
and their inverses quasi-measure-preserving instead of measure-preserving. -/
theorem ae_invariant_of_mem_closure_of_quasi {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {s : Set (Equiv.Perm X)}
    (hs : ∀ g ∈ s, Measure.QuasiMeasurePreserving ⇑g μ μ ∧
      Measure.QuasiMeasurePreserving ⇑g⁻¹ μ μ)
    {A : Set X} (hA : ∀ g ∈ s, ⇑g ⁻¹' A =ᵐ[μ] A) {h : Equiv.Perm X}
    (hh : h ∈ Subgroup.closure s) : ⇑h ⁻¹' A =ᵐ[μ] A := by
  suffices H : Measure.QuasiMeasurePreserving ⇑h μ μ ∧ Measure.QuasiMeasurePreserving ⇑h⁻¹ μ μ ∧
      ⇑h ⁻¹' A =ᵐ[μ] A from H.2.2
  induction hh using Subgroup.closure_induction with
  | mem g hg => exact ⟨(hs g hg).1, (hs g hg).2, hA g hg⟩
  | one =>
    refine ⟨?_, ?_, ?_⟩
    · rw [Equiv.Perm.coe_one]; exact Measure.QuasiMeasurePreserving.id μ
    · rw [inv_one, Equiv.Perm.coe_one]; exact Measure.QuasiMeasurePreserving.id μ
    · rw [Equiv.Perm.coe_one, Set.preimage_id]
  | mul g k _ _ ihg ihk =>
    refine ⟨?_, ?_, ?_⟩
    · rw [Equiv.Perm.coe_mul]; exact ihg.1.comp ihk.1
    · rw [mul_inv_rev, Equiv.Perm.coe_mul]; exact ihk.2.1.comp ihg.2.1
    · rw [Equiv.Perm.coe_mul, Set.preimage_comp]
      exact (ihk.1.preimage_ae_eq ihg.2.2).trans ihk.2.2
  | inv g _ ih =>
    refine ⟨ih.2.1, by rw [inv_inv]; exact ih.1, ?_⟩
    have key := ih.2.1.preimage_ae_eq ih.2.2
    rw [← Set.preimage_comp, ← Equiv.Perm.coe_mul, mul_inv_cancel, Equiv.Perm.coe_one,
      Set.preimage_id] at key
    exact key.symm

/-- The generator form implies the group form, with no hypothesis on the moves. -/
theorem isGroupErgodic_egfGroup_of_forall {lam : Measure S} {p : ℕ} {Φ : Fin p → S ≃ᵐ S}
    (h : ∀ A, MeasurableSet A → (∀ i, Φ i ⁻¹' A =ᵐ[lam] A) → lam A = 0 ∨ lam Aᶜ = 0) :
    IsGroupErgodic lam (egfGroup Φ) := fun A hA hinv =>
  h A hA fun i => hinv _ (toEquiv_mem_egfGroup Φ i)

/-- **DEC-146's generator wording is the group form** for nonsingular moves: every set
a.e.-invariant under all the `Φᵢ` is null or conull iff the group the `Φᵢ` generate is ergodic
for `λ` (C-26's corrected text states both, joined by "that is"). -/
theorem isGroupErgodic_egfGroup_iff {lam : Measure S} {p : ℕ} {Φ : Fin p → S ≃ᵐ S}
    (hns : ∀ i, lam.map (Φ i) ≪ lam ∧ lam.map (Φ i).symm ≪ lam) :
    IsGroupErgodic lam (egfGroup Φ) ↔
      ∀ A, MeasurableSet A → (∀ i, Φ i ⁻¹' A =ᵐ[lam] A) → lam A = 0 ∨ lam Aᶜ = 0 := by
  refine ⟨fun herg A hA hinv => herg A hA fun h hh =>
    ae_invariant_of_mem_closure_of_quasi ?_ ?_ hh, isGroupErgodic_egfGroup_of_forall⟩
  · rintro g ⟨i, rfl⟩
    exact ⟨⟨(Φ i).measurable, (hns i).1⟩, ⟨(Φ i).symm.measurable, (hns i).2⟩⟩
  · rintro g ⟨i, rfl⟩
    exact hinv i

/-- The ergodicity of an EGF, in the generator form of C-26's corrected text. -/
theorem IsEGFErgodic.ergodic_moves {lam : Measure S} {F : GenerativeFlow S} {p : ℕ}
    {Φ : Fin p → S ≃ᵐ S} {α : Fin p → S → ℝ} (h : IsEGFErgodic lam F Φ α) :
    ∀ A, MeasurableSet A → (∀ i, Φ i ⁻¹' A =ᵐ[lam] A) → lam A = 0 ∨ lam Aᶜ = 0 :=
  (isGroupErgodic_egfGroup_iff h.nonsingular).1 h.ergodic

/-- **`def:egf` in C-26's words**: an EGF is a generative flow with an EGF policy, nonsingular
moves, and every set a.e.-invariant under all the moves null or conull. -/
theorem isEGFErgodic_iff {lam : Measure S} {F : GenerativeFlow S} {p : ℕ} {Φ : Fin p → S ≃ᵐ S}
    {α : Fin p → S → ℝ} :
    IsEGFErgodic lam F Φ α ↔ IsEGFPolicy F.policy (fun i => Φ i) α ∧
      (∀ i, lam.map (Φ i) ≪ lam ∧ lam.map (Φ i).symm ≪ lam) ∧
      ∀ A, MeasurableSet A → (∀ i, Φ i ⁻¹' A =ᵐ[lam] A) → lam A = 0 ∨ lam Aᶜ = 0 :=
  ⟨fun h => ⟨h.policy, h.nonsingular, h.ergodic_moves⟩, fun ⟨hπ, hns, herg⟩ =>
    ⟨hπ, hns, (isGroupErgodic_egfGroup_iff hns).2 herg⟩⟩

/-- **`def:egf` in the words of C-26's corrected text**: `λ(Φᵢ⁻¹(A) ∆ A) = 0` for all `i` forces
`λ(A) = 0` or `λ(𝒮 ∖ A) = 0`. -/
theorem isEGFErgodic_iff_symmDiff {lam : Measure S} {F : GenerativeFlow S} {p : ℕ}
    {Φ : Fin p → S ≃ᵐ S} {α : Fin p → S → ℝ} :
    IsEGFErgodic lam F Φ α ↔ IsEGFPolicy F.policy (fun i => Φ i) α ∧
      (∀ i, lam.map (Φ i) ≪ lam ∧ lam.map (Φ i).symm ≪ lam) ∧
      ∀ A, MeasurableSet A → (∀ i, lam ((Φ i ⁻¹' A) ∆ A) = 0) →
        lam A = 0 ∨ lam (Set.univ \ A) = 0 := by
  rw [isEGFErgodic_iff]
  simp only [← Set.compl_eq_univ_sdiff]
  refine and_congr Iff.rfl (and_congr Iff.rfl (forall_congr' fun A => forall_congr' fun _ => ?_))
  exact imp_congr (forall_congr' fun i => (measure_symmDiff_eq_zero_iff (μ := lam)).symm) Iff.rfl

/-- **The star inflow of an EGF has a density** (C-6): `F_out ≪ λ` gives `F_in = F_out π ≪ λ`. -/
theorem IsEGFErgodic.inflowAC {lam : Measure S} {F : GenerativeFlow S} {p : ℕ}
    {Φ : Fin p → S ≃ᵐ S} {α : Fin p → S → ℝ} (h : IsEGFErgodic lam F Φ α)
    (hout : F.outflow ≪ lam) : InflowAC lam F :=
  InflowAC.of_map_ac lam F h.policy (fun i => (h.nonsingular i).1) hout

/-! ## Ergodicity of the kernel of an EGF -/

/-- A set a.e.-invariant under every move is invariant for an EGF policy (weights sum to `1`). -/
theorem IsEGFPolicy.ae_apply_eq_indicator {π : Kernel S S} {p : ℕ} {Φ : Fin p → S → S}
    {α : Fin p → S → ℝ} (h : IsEGFPolicy π Φ α) {μ : Measure S} {A : Set S}
    (hA : MeasurableSet A) (hinv : ∀ i, Φ i ⁻¹' A =ᵐ[μ] A) :
    ∀ᵐ x ∂μ, π x A = A.indicator 1 x := by
  have hall : ∀ᵐ x ∂μ, ∀ i, (Φ i x ∈ A ↔ x ∈ A) := by
    rw [ae_all_iff]
    intro i
    filter_upwards [hinv i] with x hx
    exact Iff.of_eq hx
  filter_upwards [hall] with x hx
  rw [h.apply_set x hA]
  have hi : ∀ i, A.indicator (1 : S → ℝ≥0∞) (Φ i x) = A.indicator 1 x := fun i => by
    by_cases hxA : x ∈ A
    · rw [Set.indicator_of_mem hxA, Set.indicator_of_mem ((hx i).2 hxA), Pi.one_apply,
        Pi.one_apply]
    · rw [Set.indicator_of_notMem hxA, Set.indicator_of_notMem fun h' => hxA ((hx i).1 h')]
  simp_rw [hi]
  rw [← Finset.sum_mul, ← ENNReal.ofReal_sum_of_nonneg (fun i _ => h.weight_nonneg i x),
    h.weight_sum x, ENNReal.ofReal_one, one_mul]

/-- **An ergodic EGF kernel has no common non-trivial a.e.-invariant set of its moves** (any
weights). -/
theorem IsEGFPolicy.forall_of_isKernelErgodic {π : Kernel S S} {p : ℕ} {Φ : Fin p → S → S}
    {α : Fin p → S → ℝ} (h : IsEGFPolicy π Φ α) {μ : Measure S} (herg : IsKernelErgodic π μ) :
    ∀ A, MeasurableSet A → (∀ i, Φ i ⁻¹' A =ᵐ[μ] A) → μ A = 0 ∨ μ Aᶜ = 0 :=
  fun A hA hinv => herg A hA (h.ae_apply_eq_indicator hA hinv)

/-- **With positive weights, the EGF kernel is ergodic iff its moves have no common non-trivial
a.e.-invariant set.** -/
theorem IsEGFPolicy.isKernelErgodic_iff {π : Kernel S S} {p : ℕ} {Φ : Fin p → S → S}
    {α : Fin p → S → ℝ} (h : IsEGFPolicy π Φ α) (hpos : ∀ i s, 0 < α i s) {μ : Measure S} :
    IsKernelErgodic π μ ↔
      ∀ A, MeasurableSet A → (∀ i, Φ i ⁻¹' A =ᵐ[μ] A) → μ A = 0 ∨ μ Aᶜ = 0 :=
  ⟨h.forall_of_isKernelErgodic, h.isKernelErgodic hpos⟩

/-- **The kernel of an EGF with positive weights is ergodic for `λ`**. -/
theorem IsEGFErgodic.isKernelErgodic {lam : Measure S} {F : GenerativeFlow S} {p : ℕ}
    {Φ : Fin p → S ≃ᵐ S} {α : Fin p → S → ℝ} (h : IsEGFErgodic lam F Φ α)
    (hpos : ∀ i s, 0 < α i s) : IsKernelErgodic F.policy lam :=
  h.policy.isKernelErgodic hpos h.ergodic_moves

/-- **Conversely, an ergodic kernel makes an EGF**: an EGF policy with nonsingular moves whose
kernel is ergodic for `λ` is an EGF in DEC-146's sense (any weights). -/
theorem isEGFErgodic_of_isKernelErgodic {lam : Measure S} {F : GenerativeFlow S} {p : ℕ}
    {Φ : Fin p → S ≃ᵐ S} {α : Fin p → S → ℝ} (hπ : IsEGFPolicy F.policy (fun i => Φ i) α)
    (hns : ∀ i, lam.map (Φ i) ≪ lam ∧ lam.map (Φ i).symm ≪ lam)
    (herg : IsKernelErgodic F.policy lam) : IsEGFErgodic lam F Φ α :=
  ⟨hπ, hns, (isGroupErgodic_egfGroup_iff hns).2 (hπ.forall_of_isKernelErgodic herg)⟩

/-- For positive weights, the ergodicity clause of an EGF is the ergodicity of its kernel. -/
theorem isEGFErgodic_iff_isKernelErgodic {lam : Measure S} {F : GenerativeFlow S} {p : ℕ}
    {Φ : Fin p → S ≃ᵐ S} {α : Fin p → S → ℝ} (hπ : IsEGFPolicy F.policy (fun i => Φ i) α)
    (hns : ∀ i, lam.map (Φ i) ≪ lam ∧ lam.map (Φ i).symm ≪ lam) (hpos : ∀ i s, 0 < α i s) :
    IsEGFErgodic lam F Φ α ↔ IsKernelErgodic F.policy lam :=
  ⟨fun h => h.isKernelErgodic hpos, isEGFErgodic_of_isKernelErgodic hπ hns⟩

/-! ## The link to the universality theorems (C-29) -/

/-- **A measure-preserving move is nonsingular both ways.** -/
theorem nonsingular_of_measurePreserving {lam : Measure S} {Φ : S ≃ᵐ S}
    (h : MeasurePreserving Φ lam lam) : lam.map Φ ≪ lam ∧ lam.map Φ.symm ≪ lam :=
  ⟨map_ac_of_measurePreserving h, map_ac_of_measurePreserving (h.symm Φ)⟩

/-- **An EGF is a universal policy** (Theorem B.1 under ergodicity, C-29): positive weights and a
finite invariant measure `λ̂ ~ λ` for its kernel, `λ` finite. -/
theorem IsEGFErgodic.isUniversalPolicy {lam : Measure S} [IsFiniteMeasure lam]
    {F : GenerativeFlow S} {p : ℕ} {Φ : Fin p → S ≃ᵐ S} {α : Fin p → S → ℝ}
    (h : IsEGFErgodic lam F Φ α) (hpos : ∀ i s, 0 < α i s) (lamHat : Measure S)
    [IsFiniteMeasure lamHat] (hinv : lamHat.bind F.policy = lamHat) (hac : lamHat ≪ lam)
    (hac' : lam ≪ lamHat) : IsUniversalPolicy lam F.policy :=
  isUniversalPolicy_of_ergodic lam F.policy lamHat hinv hac hac'
    ((isKernelErgodic_congr hac' hac).mp (h.isKernelErgodic hpos))

/-- **DEC-146's clause is exactly what universality needs**: for an EGF policy with positive
weights and nonsingular moves, whose kernel has a finite invariant `λ̂ ~ λ`, `λ` finite, the flow
is an EGF in DEC-146's sense iff its policy is universal. -/
theorem isEGFErgodic_iff_isUniversalPolicy {lam : Measure S} [IsFiniteMeasure lam]
    {F : GenerativeFlow S} {p : ℕ} {Φ : Fin p → S ≃ᵐ S} {α : Fin p → S → ℝ}
    (hπ : IsEGFPolicy F.policy (fun i => Φ i) α)
    (hns : ∀ i, lam.map (Φ i) ≪ lam ∧ lam.map (Φ i).symm ≪ lam) (hpos : ∀ i s, 0 < α i s)
    (lamHat : Measure S) [IsFiniteMeasure lamHat] (hinv : lamHat.bind F.policy = lamHat)
    (hac : lamHat ≪ lam) (hac' : lam ≪ lamHat) :
    IsEGFErgodic lam F Φ α ↔ IsUniversalPolicy lam F.policy :=
  ⟨fun h => h.isUniversalPolicy hpos lamHat hinv hac hac', fun hU =>
    isEGFErgodic_of_isKernelErgodic hπ hns (isKernelErgodic_of_isUniversalPolicy lam F.policy hU)⟩

/-- **Theorem 3.4 for an EGF** (C-29, C-31): a family containing `(π, f λ)` for the kernel `π` of
an EGF with positive weights and a finite invariant `λ̂ ~ λ`, and every `f` of a set dense in the
non-negative cone of `L²(λ)`, is ε-universal. -/
theorem IsEGFErgodic.isUniversalFamilyEps {lam : Measure S} [IsFiniteMeasure lam]
    {F₀ : GenerativeFlow S} {p : ℕ} {Φ : Fin p → S ≃ᵐ S} {α : Fin p → S → ℝ}
    (h : IsEGFErgodic lam F₀ Φ α) (hpos : ∀ i s, 0 < α i s) (lamHat : Measure S)
    [IsFiniteMeasure lamHat] (hinv : lamHat.bind F₀.policy = lamHat) (hac : lamHat ≪ lam)
    (hac' : lam ≪ lamHat) (𝓕 : Set (GenerativeFlow S)) (D : Set (S → ℝ))
    (hD : ∀ f ∈ D, ∃ F ∈ 𝓕, F.policy = F₀.policy ∧
      F.outflow = lam.withDensity fun s => ENNReal.ofReal (f s))
    (hdense : IsDenseNonnegConeL2 lam D) : IsUniversalFamilyEps lam 𝓕 :=
  universality_of_ergodic_family lam 𝓕 F₀.policy lamHat hinv hac hac'
    ((isKernelErgodic_congr hac' hac).mp (h.isKernelErgodic hpos)) D hD hdense

/-- **The uniform kernel of the moves** `π(s) = (1/p) ∑ᵢ δ_{Φᵢ(s)}`. -/
noncomputable def uniformEGFKernel {p : ℕ} (Φ : Fin p → S ≃ᵐ S) : Kernel S S :=
  egfKernel (fun i => Φ i) (fun _ _ => 1 / (p : ℝ)) (fun i => (Φ i).measurable)
    fun _ => measurable_const

/-- The uniform kernel of `p ≥ 1` moves is the EGF policy with weights `αⁱ ≡ 1/p`. -/
theorem isEGFPolicy_uniformEGFKernel {p : ℕ} (hp : 0 < p) (Φ : Fin p → S ≃ᵐ S) :
    IsEGFPolicy (uniformEGFKernel Φ) (fun i => Φ i) (fun _ _ => 1 / (p : ℝ)) :=
  isEGFPolicy_egfKernel _ _ _ _ (fun _ _ => by positivity) fun _ => by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    field_simp

/-- **Theorem 3.4 for the uniform EGF of measure-preserving moves** (C-29, C-31): if the group of
the moves is ergodic for the finite `λ`, a family containing `(π, f λ)` for the uniform kernel `π`
of the moves and every `f` of a set dense in the non-negative cone of `L²(λ)` is ε-universal. -/
theorem isUniversalFamilyEps_of_isGroupErgodic {lam : Measure S} [IsFiniteMeasure lam] {p : ℕ}
    (hp : 0 < p) (Φ : Fin p → S ≃ᵐ S) (hmp : ∀ i, MeasurePreserving (Φ i) lam lam)
    (herg : IsGroupErgodic lam (egfGroup Φ)) (𝓕 : Set (GenerativeFlow S)) (D : Set (S → ℝ))
    (hD : ∀ f ∈ D, ∃ F ∈ 𝓕, F.policy = uniformEGFKernel Φ ∧
      F.outflow = lam.withDensity fun s => ENNReal.ofReal (f s))
    (hdense : IsDenseNonnegConeL2 lam D) : IsUniversalFamilyEps lam 𝓕 := by
  have hpol := isEGFPolicy_uniformEGFKernel hp Φ
  haveI := hpol.isMarkovKernel
  have hns : ∀ i, lam.map (Φ i) ≪ lam ∧ lam.map (Φ i).symm ≪ lam := fun i =>
    nonsingular_of_measurePreserving (hmp i)
  have hpos : ∀ (i : Fin p) (s : S), 0 < 1 / (p : ℝ) := fun _ _ => by positivity
  exact universality_of_ergodic_family lam 𝓕 (uniformEGFKernel Φ) lam (hpol.bind_eq_of_uniform hmp)
    Measure.AbsolutelyContinuous.rfl Measure.AbsolutelyContinuous.rfl
    (hpol.isKernelErgodic hpos ((isGroupErgodic_egfGroup_iff hns).1 herg)) D hD hdense

/-- **Universality iff DEC-146's ergodicity**, for measure-preserving moves, `λ` finite and the
uniform policy: a family of flows with the uniform kernel of the moves and outflows `≪ λ`, which
contains `(π, f λ)` for every `f` of a set dense in the non-negative cone of `L²(λ)`, is
ε-universal iff the group generated by the moves is ergodic for `λ`. -/
theorem universality_of_isEGFErgodic {lam : Measure S} [IsFiniteMeasure lam] {p : ℕ} (hp : 0 < p)
    (Φ : Fin p → S ≃ᵐ S) (hmp : ∀ i, MeasurePreserving (Φ i) lam lam)
    (𝓕 : Set (GenerativeFlow S))
    (h𝓕 : ∀ F ∈ 𝓕, F.policy = uniformEGFKernel Φ ∧ F.outflow ≪ lam) (D : Set (S → ℝ))
    (hD : ∀ f ∈ D, ∃ F ∈ 𝓕, F.policy = uniformEGFKernel Φ ∧
      F.outflow = lam.withDensity fun s => ENNReal.ofReal (f s))
    (hdense : IsDenseNonnegConeL2 lam D) :
    IsUniversalFamilyEps lam 𝓕 ↔ IsGroupErgodic lam (egfGroup Φ) := by
  have hpol := isEGFPolicy_uniformEGFKernel hp Φ
  haveI := hpol.isMarkovKernel
  have hns : ∀ i, lam.map (Φ i) ≪ lam ∧ lam.map (Φ i).symm ≪ lam := fun i =>
    nonsingular_of_measurePreserving (hmp i)
  refine ⟨fun hU => ?_, fun herg => isUniversalFamilyEps_of_isGroupErgodic hp Φ hmp herg 𝓕 D hD
    hdense⟩
  rw [isGroupErgodic_egfGroup_iff hns]
  refine hpol.forall_of_isKernelErgodic (by_contra fun herg => ?_)
  exact not_isUniversalFamilyEps_of_not_ergodic lam 𝓕 (uniformEGFKernel Φ) h𝓕 herg hU

/-- **The same, member by member**: the family is ε-universal iff each of its members is an EGF
in DEC-146's sense. -/
theorem isUniversalFamilyEps_iff_forall_isEGFErgodic {lam : Measure S} [IsFiniteMeasure lam]
    {p : ℕ} (hp : 0 < p) (Φ : Fin p → S ≃ᵐ S) (hmp : ∀ i, MeasurePreserving (Φ i) lam lam)
    (𝓕 : Set (GenerativeFlow S))
    (h𝓕 : ∀ F ∈ 𝓕, F.policy = uniformEGFKernel Φ ∧ F.outflow ≪ lam) (D : Set (S → ℝ))
    (hD : ∀ f ∈ D, ∃ F ∈ 𝓕, F.policy = uniformEGFKernel Φ ∧
      F.outflow = lam.withDensity fun s => ENNReal.ofReal (f s))
    (hdense : IsDenseNonnegConeL2 lam D) :
    IsUniversalFamilyEps lam 𝓕 ↔ ∀ F ∈ 𝓕, IsEGFErgodic lam F Φ (fun _ _ => 1 / (p : ℝ)) := by
  rw [universality_of_isEGFErgodic hp Φ hmp 𝓕 h𝓕 D hD hdense]
  have hns : ∀ i, lam.map (Φ i) ≪ lam ∧ lam.map (Φ i).symm ≪ lam := fun i =>
    nonsingular_of_measurePreserving (hmp i)
  constructor
  · intro herg F hF
    refine ⟨?_, hns, herg⟩
    rw [(h𝓕 F hF).1]
    exact isEGFPolicy_uniformEGFKernel hp Φ
  · intro h
    obtain ⟨f, hfD, -, -⟩ := hdense 0 MemLp.zero (fun _ => le_rfl) 1 one_pos
    obtain ⟨F, hF, -, -⟩ := hD f hfD
    exact (h F hF).ergodic

/-! ## Instances: nonsingular moves -/

section Euclidean

open scoped Manifold

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E] [BorelSpace E]

/-- **A `Cⁿ` diffeomorphism (`n ≥ 1`) of a finite-dimensional space is nonsingular both ways for
Haar measure** (the volume of `ℝᵈ`, `main.tex:225`). -/
theorem nonsingular_of_diffeomorph {n : WithTop ℕ∞} (hn : n ≠ 0) (μ : Measure E)
    [μ.IsAddHaarMeasure] (Φ : Diffeomorph 𝓘(ℝ, E) 𝓘(ℝ, E) E E n) :
    μ.map Φ.toHomeomorph.toMeasurableEquiv ≪ μ ∧
      μ.map Φ.toHomeomorph.toMeasurableEquiv.symm ≪ μ :=
  ⟨map_ac_of_diffeomorph hn μ Φ, map_ac_of_diffeomorph hn μ Φ.symm⟩

/-- **On `ℝᵈ` with Lebesgue measure, DEC-146's `def:egf` adds nothing to the policy and the
ergodicity**: for `Cⁿ` diffeomorphisms (`n ≥ 1`) and Haar measure, the nonsingularity clause is
automatic. -/
theorem isEGFErgodic_diffeomorph_iff {n : WithTop ℕ∞} (hn : n ≠ 0) (μ : Measure E)
    [μ.IsAddHaarMeasure] (F : GenerativeFlow E) {p : ℕ}
    (Φ : Fin p → Diffeomorph 𝓘(ℝ, E) 𝓘(ℝ, E) E E n) (α : Fin p → E → ℝ) :
    IsEGFErgodic μ F (diffeoEquiv Φ) α ↔
      IsEGFPolicy F.policy (fun i => Φ i) α ∧ IsGroupErgodic μ (egfGroup (diffeoEquiv Φ)) :=
  ⟨fun h => ⟨h.policy, h.ergodic⟩, fun ⟨hπ, herg⟩ =>
    ⟨hπ, fun i => nonsingular_of_diffeomorph hn μ (Φ i), herg⟩⟩

end Euclidean

/-! ## Instances: tori -/

section Torus

variable {d : ℕ}

/-- The affine map `x ↦ Ax + b` of the torus, `det A = ±1`, as a measurable equivalence. -/
noncomputable def torusAffineME (A : Matrix (Fin d) (Fin d) ℤ) (b : UnitAddTorus (Fin d))
    (hA : IsUnit A.det) : UnitAddTorus (Fin d) ≃ᵐ UnitAddTorus (Fin d) where
  toEquiv := torusAffineEquiv A b hA
  measurable_toFun := measurable_torusAffine A b
  measurable_invFun := measurable_torusAffine A⁻¹ (-torusLin A⁻¹ b)

theorem coe_torusAffineME (A : Matrix (Fin d) (Fin d) ℤ) (b : UnitAddTorus (Fin d))
    (hA : IsUnit A.det) : ⇑(torusAffineME A b hA) = torusAffine A b := rfl

/-- The group of the EGF is the group of `EGF/TorusFamilies.lean`. -/
theorem egfGroup_torusAffineME {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (b : Fin p → UnitAddTorus (Fin d)) (hA : ∀ i, IsUnit (A i).det) :
    egfGroup (fun i => torusAffineME (A i) (b i) (hA i)) = torusAffineGroup A b hA := rfl

/-- **The affine moves of the torus are nonsingular both ways** (they preserve `λ`). -/
theorem nonsingular_torusAffineME (A : Matrix (Fin d) (Fin d) ℤ) (b : UnitAddTorus (Fin d))
    (hA : IsUnit A.det) :
    volume.map (torusAffineME A b hA) ≪ volume ∧ volume.map (torusAffineME A b hA).symm ≪ volume :=
  nonsingular_of_measurePreserving (measurePreserving_torusAffine hA b)

/-- **The flows of an affine toroidal model are EGFs iff the group of their moves is ergodic.** -/
theorem AffineToroidalModel.isEGFErgodic_flow_iff {p : ℕ} (M : AffineToroidalModel d p)
    (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det) (θ : M.Θ) :
    IsEGFErgodic volume (M.flow A θ) (fun i => torusAffineME (A i) (M.b θ i) (hA i)) (M.α θ) ↔
      IsGroupErgodic volume (torusAffineGroup A (M.b θ) hA) :=
  ⟨fun h => h.ergodic, fun herg =>
    ⟨isEGFPolicy_flow M A θ, fun _ => nonsingular_torusAffineME _ _ _, herg⟩⟩

/-- **A flow with the uniform kernel of affine moves is an EGF iff the group is ergodic.** -/
theorem isEGFErgodic_torus_iff {p : ℕ} (hp : 0 < p) (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (hA : ∀ i, IsUnit (A i).det) (b : Fin p → UnitAddTorus (Fin d))
    (F : GenerativeFlow (UnitAddTorus (Fin d))) (hF : F.policy = torusUniformKernel A b) :
    IsEGFErgodic volume F (fun i => torusAffineME (A i) (b i) (hA i)) (fun _ _ => 1 / (p : ℝ)) ↔
      IsGroupErgodic volume (torusAffineGroup A b hA) := by
  refine ⟨fun h => h.ergodic, fun herg => ⟨?_, fun _ => nonsingular_torusAffineME _ _ _, herg⟩⟩
  rw [hF]
  exact isEGFPolicy_torusUniformKernel hp A b

end Torus

/-! ## Instances: spheres -/

section Sphere

/-- The rotation `x ↦ Ax` of `S^{n−1}`, `A ∈ SO(n)`, as a measurable equivalence. -/
noncomputable def rotME {n : ℕ} (A : SO n) : RoundSphere n ≃ᵐ RoundSphere n where
  toEquiv := rotPerm A
  measurable_toFun := measurable_rotSphere A
  measurable_invFun := measurable_rotSphere A⁻¹

theorem coe_rotME {n : ℕ} (A : SO n) : ⇑(rotME A) = rotSphere A := rfl

/-- The group of the EGF is the group of `EGF/SphereFamilies.lean`. -/
theorem egfGroup_rotME {n p : ℕ} (Φ : Fin p → SO n) :
    egfGroup (fun i => rotME (Φ i)) = sphereRotGroup Φ := rfl

/-- **Rotations of the sphere are nonsingular both ways** (they preserve `σ`). -/
theorem nonsingular_rotME {n : ℕ} (A : SO n) :
    (sphereVolume n).map (rotME A) ≪ sphereVolume n ∧
      (sphereVolume n).map (rotME A).symm ≪ sphereVolume n :=
  nonsingular_of_measurePreserving (measurePreserving_rotSphere A)

/-- **The flows of an isometry spherical model are EGFs iff the group of their rotations is
ergodic.** -/
theorem IsometrySphericalModel.isEGFErgodic_flow_iff {n p : ℕ} (M : IsometrySphericalModel n p)
    (θ : M.Θ) :
    IsEGFErgodic (sphereVolume n) (M.flow θ) (fun i => rotME (M.rot θ i)) (M.α θ) ↔
      IsGroupErgodic (sphereVolume n) (sphereRotGroup (M.rot θ)) :=
  ⟨fun h => h.ergodic, fun herg =>
    ⟨M.isEGFPolicy_flow θ, fun _ => nonsingular_rotME _, herg⟩⟩

/-- **A flow with the uniform kernel of rotations is an EGF iff the group is ergodic.** -/
theorem isEGFErgodic_sphere_iff {n p : ℕ} (hp : 0 < p) (Φ : Fin p → SO n)
    (F : GenerativeFlow (RoundSphere n)) (hF : F.policy = sphereUniformKernel Φ) :
    IsEGFErgodic (sphereVolume n) F (fun i => rotME (Φ i)) (fun _ _ => 1 / (p : ℝ)) ↔
      IsGroupErgodic (sphereVolume n) (sphereRotGroup Φ) := by
  refine ⟨fun h => h.ergodic, fun herg => ⟨?_, fun _ => nonsingular_rotME _, herg⟩⟩
  rw [hF]
  exact isEGFPolicy_sphereUniformKernel hp Φ

/-- **An inhabitant on `𝕊¹`**: the flows of the `L²` model with the single rotation of cosine
`3/5` are EGFs. -/
theorem isEGFErgodic_sphere_two_witness
    (θ : (l2SphericalModel one_pos ![rotMat angle35]).Θ) :
    IsEGFErgodic (sphereVolume 2) ((l2SphericalModel one_pos ![rotMat angle35]).flow θ)
      (fun i => rotME (![rotMat angle35] i)) (fun _ _ => 1 / ((1 : ℕ) : ℝ)) :=
  (IsometrySphericalModel.isEGFErgodic_flow_iff _ θ).2
    ((isGroupErgodic_sphereRotGroup_iff _).2 fun A hA hinv =>
      ergodic_rotSphere_two irrational_angle35 A hA (hinv 0))

end Sphere

/-! ## Concrete inhabitants: an irrational rotation of the circle, the swap of two points -/

section Circle

variable {T : ℝ} [Fact (0 < T)]

/-- The rotation flow `(δ_{a + ·}, λ)` on the circle `AddCircle T` with its Haar measure. -/
noncomputable def circleRotFlow (a : AddCircle T) : GenerativeFlow (AddCircle T) where
  policy := Kernel.deterministic (a + ·) (measurable_const_add a)
  outflow := volume
  isMarkovKernel_policy := inferInstance
  isFiniteMeasure_outflow := inferInstance

theorem isEGFPolicy_circleRotFlow (a : AddCircle T) :
    IsEGFPolicy (circleRotFlow a).policy (fun _ : Fin 1 => ⇑(MeasurableEquiv.addLeft a))
      (fun _ _ => 1) := by
  refine ⟨fun _ => (MeasurableEquiv.addLeft a).measurable, fun _ => measurable_const,
    fun _ _ => zero_le_one, fun _ => by simp, fun s => ?_⟩
  simp [circleRotFlow, Kernel.deterministic_apply]

/-- **A rotation of the circle is an EGF iff it is of infinite order** (irrational). -/
theorem isEGFErgodic_circleRotFlow_iff (a : AddCircle T) :
    IsEGFErgodic volume (circleRotFlow a) (fun _ : Fin 1 => MeasurableEquiv.addLeft a)
      (fun _ _ => 1) ↔ addOrderOf a = 0 := by
  constructor
  · intro h
    refine AddCircle.ergodic_add_left.mp
      ⟨measurePreserving_add_left volume a, ⟨fun s hs hinv => ?_⟩⟩
    rcases h.ergodic_moves s hs (fun _ => by rw [MeasurableEquiv.coe_addLeft, hinv]) with h0 | h1
    · exact eventuallyConst_set'.2 (Or.inl (ae_eq_empty.2 h0))
    · exact eventuallyConst_set'.2 (Or.inr (ae_eq_univ.2 h1))
  · intro ha
    have herg : Ergodic (a + ·) (volume : Measure (AddCircle T)) :=
      AddCircle.ergodic_add_left.mpr ha
    exact isEGFErgodic_of_isKernelErgodic (isEGFPolicy_circleRotFlow a)
      (fun _ => nonsingular_of_measurePreserving (measurePreserving_add_left volume a))
      (isKernelErgodic_deterministic (measurable_const_add a) herg).2

end Circle

/-- **The swap of two points is an EGF** for the uniform `λ` on `Bool`. -/
theorem Swap.isEGFErgodic_flow :
    IsEGFErgodic Coin.lam Swap.flow (fun _ : Fin 1 => Swap.notEquiv) (fun _ _ => 1) := by
  have hπ : IsEGFPolicy Swap.flow.policy (fun _ : Fin 1 => ⇑Swap.notEquiv) (fun _ _ => 1) := by
    refine ⟨fun _ => Swap.notEquiv.measurable, fun _ => measurable_const, fun _ _ => zero_le_one,
      fun _ => by simp, fun s => ?_⟩
    rw [Swap.policy_eq_deterministic]
    simp [Kernel.deterministic_apply]
  exact isEGFErgodic_of_isKernelErgodic hπ
    (fun _ => nonsingular_of_measurePreserving ⟨Swap.notEquiv.measurable, Swap.lam_map_notEquiv⟩)
    Swap.isKernelErgodic_policy

/-! ## Topological and measure ergodicity are independent (C-26's finding) -/

section Independence

variable {T : ℝ} [Fact (0 < T)]

omit [Fact (0 < T)] in
/-- **One move generates a translation's forward orbit**: `w.foldl (a + ·) x = |w| • a + x`. -/
theorem foldl_const_add_addCircle (a x : AddCircle T) (w : List (Fin 1)) :
    w.foldl (fun z _ => a + z) x = w.length • a + x := by
  induction w generalizing x with
  | nil => simp
  | cons i w ih =>
    simp only [List.foldl_cons, List.length_cons, ih, succ_nsmul]
    abel

/-- `-a` is a limit of non-negative multiples of `a` on the circle (compactness: `n_{j+1} − n_j − 1`
along a convergent subsequence of `(n • a)`). -/
theorem neg_mem_closure_range_nsmul_addCircle (a : AddCircle T) :
    -a ∈ closure (range fun n : ℕ => n • a) := by
  obtain ⟨c, φ, hφ, hlim⟩ := CompactSpace.tendsto_subseq (fun n : ℕ => n • a)
  have hlim' : Tendsto (fun j => (φ (j + 1)) • a - (φ j) • a - a) atTop (𝓝 (c - c - a)) :=
    ((hlim.comp (tendsto_add_atTop_nat 1)).sub hlim).sub tendsto_const_nhds
  rw [sub_self, zero_sub] at hlim'
  refine mem_closure_of_tendsto hlim' (Eventually.of_forall fun j => ?_)
  refine ⟨φ (j + 1) - (φ j + 1), ?_⟩
  have hle : φ j + 1 ≤ φ (j + 1) := hφ (Nat.lt_succ_self j)
  simp only
  rw [sub_nsmul a hle, succ_nsmul]
  abel

/-- **The forward orbit of a rotation of infinite order is dense** (Mathlib has the `ℤ`-orbit,
`AddCircle.denseRange_zsmul_iff`): its closure is stable under `· − a`, so it contains `ℤ • a`. -/
theorem denseRange_nsmul_of_addOrderOf_eq_zero {a : AddCircle T} (ha : addOrderOf a = 0) :
    DenseRange fun n : ℕ => n • a := by
  set R := range fun n : ℕ => n • a with hR
  set F := closure R with hF
  have hFc : IsClosed F := isClosed_closure
  have hsub : ∀ y ∈ F, y - a ∈ F := by
    have himg : (fun y => y - a) '' R ⊆ F := by
      rintro _ ⟨_, ⟨n, rfl⟩, rfl⟩
      rcases n with _ | n
      · simpa using neg_mem_closure_range_nsmul_addCircle a
      · exact subset_closure ⟨n, by simp [succ_nsmul]⟩
    intro y hy
    have := image_closure_subset_closure_image (f := fun y => y - a) (s := R)
      (continuous_sub_right a) ⟨y, hy, rfl⟩
    exact closure_minimal himg hFc this
  have hnat : ∀ k : ℕ, k • a ∈ F := fun k => subset_closure ⟨k, rfl⟩
  have hneg : ∀ k : ℕ, -(k • a) ∈ F := by
    intro k
    induction k with
    | zero => simpa using hnat 0
    | succ k ih =>
      have := hsub _ ih
      rwa [succ_nsmul, neg_add, ← sub_eq_add_neg]
  have hint : range (fun m : ℤ => m • a) ⊆ F := by
    rintro _ ⟨m, rfl⟩
    rcases m with k | k
    · simpa using hnat k
    · show Int.negSucc k • a ∈ F
      rw [negSucc_zsmul]; exact hneg (k + 1)
  have hdz : DenseRange (fun m : ℤ => m • a) := AddCircle.denseRange_zsmul_iff.mpr ha
  intro y
  have := closure_mono hint (hdz y)
  rwa [hFc.closure_eq] at this

/-- **A rotation of infinite order is topologically ergodic in the printed sense** (forward words,
`EGF.IsTopologicallyErgodic`). -/
theorem isTopologicallyErgodic_addLeft {a : AddCircle T} (ha : addOrderOf a = 0) :
    IsTopologicallyErgodic (fun _ : Fin 1 => ⇑(Homeomorph.addLeft a)) := by
  intro x y U hU
  have hV : (fun z => z + x) ⁻¹' U ∈ 𝓝 (y - x) :=
    (continuous_add_const x).continuousAt.preimage_mem_nhds (by rwa [sub_add_cancel])
  obtain ⟨_, hzV, ⟨n, rfl⟩⟩ :=
    mem_closure_iff_nhds.mp (denseRange_nsmul_of_addOrderOf_eq_zero ha (y - x)) _ hV
  refine ⟨List.replicate n 0, ?_⟩
  simp only [Homeomorph.coe_addLeft]
  rw [foldl_const_add_addCircle, List.length_replicate]
  exact hzV

/-- Summable positive weights on `ℤ`: `wₙ = 2^{−e(n)}`, `e = Equiv.intEquivNat : ℤ ≃ ℕ`. -/
noncomputable def orbitWeight (n : ℤ) : ℝ≥0∞ := 2⁻¹ ^ (Equiv.intEquivNat n)

theorem orbitWeight_ne_zero (n : ℤ) : orbitWeight n ≠ 0 :=
  pow_ne_zero _ (ENNReal.inv_ne_zero.2 ENNReal.ofNat_ne_top)

/-- **Lebesgue measure plus atoms on one orbit**: `λ = vol + ∑ₙ wₙ δ_{n•a}`, finite. -/
noncomputable def orbitLam (a : AddCircle T) : Measure (AddCircle T) :=
  volume + Measure.sum fun n : ℤ => orbitWeight n • Measure.dirac (n • a)

instance isFiniteMeasure_orbitLam (a : AddCircle T) : IsFiniteMeasure (orbitLam a) := by
  constructor
  simp only [orbitLam, Measure.add_apply, Measure.sum_apply _ MeasurableSet.univ,
    Measure.smul_apply, measure_univ, smul_eq_mul, mul_one]
  refine ENNReal.add_lt_top.2 ⟨measure_lt_top _ _, ?_⟩
  simp only [orbitWeight]
  rw [Equiv.intEquivNat.tsum_eq (fun k => (2⁻¹ : ℝ≥0∞) ^ k),
    ENNReal.tsum_geometric]
  rw [ENNReal.one_sub_inv_two, inv_inv]
  exact ENNReal.ofNat_lt_top

theorem orbitLam_eq_zero_iff (a : AddCircle T) {A : Set (AddCircle T)} (hA : MeasurableSet A) :
    orbitLam a A = 0 ↔ volume A = 0 ∧ ∀ n : ℤ, n • a ∉ A := by
  simp only [orbitLam, Measure.add_apply, Measure.sum_apply _ hA, Measure.smul_apply, smul_eq_mul,
    Measure.dirac_apply' _ hA, add_eq_zero, ENNReal.tsum_eq_zero, mul_eq_zero,
    orbitWeight_ne_zero, false_or, Set.indicator_apply_eq_zero, Pi.one_apply, one_ne_zero,
    imp_false]

/-- **Translations along the orbit are nonsingular for `λ`.** -/
theorem orbitLam_map_ac {a c : AddCircle T} (hc : ∃ k : ℤ, k • a = c) :
    (orbitLam a).map (c + ·) ≪ orbitLam a := by
  refine Measure.AbsolutelyContinuous.mk fun A hA h0 => ?_
  rw [Measure.map_apply (measurable_const_add c) hA]
  rw [orbitLam_eq_zero_iff a hA] at h0
  rw [orbitLam_eq_zero_iff a (measurable_const_add c hA)]
  refine ⟨?_, fun n hn => ?_⟩
  · rw [← Measure.map_apply (measurable_const_add c) hA,
      (measurePreserving_add_left volume c).map_eq]
    exact h0.1
  · obtain ⟨k, rfl⟩ := hc
    exact h0.2 (k + n) (by rw [add_zsmul]; exact hn)

/-- **Topological ergodicity does not give DEC-146's ergodicity** (C-26's finding): a rotation `a`
of infinite order of the circle is an EGF in the printed sense (`EGF.IsEGF`: forward words, hence
also the group reading), its move is nonsingular both ways for the finite measure
`λ = vol + ∑ₙ 2^{−e(n)} δ_{n•a}` (`e : ℤ ≃ ℕ`, `EGF.orbitWeight`), and it is not an EGF in
DEC-146's sense for that `λ`: the orbit `ℤ • a` is invariant, of positive measure (its atoms) and
of co-measure `≥ vol(𝒮) > 0`. (For `λ` the volume the
same rotation is an EGF: `isEGFErgodic_circleRotFlow_iff`.) -/
theorem isEGF_not_isEGFErgodic {a : AddCircle T} (ha : addOrderOf a = 0) :
    IsEGF (circleRotFlow a) (fun _ : Fin 1 => Homeomorph.addLeft a) (fun _ _ => 1) ∧
      (∀ i : Fin 1, (orbitLam a).map ((fun _ : Fin 1 => MeasurableEquiv.addLeft a) i) ≪ orbitLam a ∧
        (orbitLam a).map ((fun _ : Fin 1 => MeasurableEquiv.addLeft a) i).symm ≪ orbitLam a) ∧
      ¬ IsEGFErgodic (orbitLam a) (circleRotFlow a) (fun _ : Fin 1 => MeasurableEquiv.addLeft a)
        (fun _ _ => 1) := by
  have hns : ∀ i : Fin 1, (orbitLam a).map ((fun _ : Fin 1 => MeasurableEquiv.addLeft a) i) ≪
      orbitLam a ∧ (orbitLam a).map ((fun _ : Fin 1 => MeasurableEquiv.addLeft a) i).symm ≪
      orbitLam a := fun _ => by
    refine ⟨?_, ?_⟩
    · rw [MeasurableEquiv.coe_addLeft]; exact orbitLam_map_ac ⟨1, one_zsmul a⟩
    · rw [MeasurableEquiv.symm_addLeft, MeasurableEquiv.coe_addLeft]
      exact orbitLam_map_ac ⟨-1, by rw [neg_zsmul, one_zsmul]⟩
  refine ⟨⟨isEGFPolicy_circleRotFlow a, isTopologicallyErgodic_addLeft ha⟩, hns, fun h => ?_⟩
  set O : Set (AddCircle T) := range fun n : ℤ => n • a with hO
  have hOm : MeasurableSet O := (countable_range _).measurableSet
  have hOinv : ⇑(MeasurableEquiv.addLeft a) ⁻¹' O = O := by
    ext x
    simp only [MeasurableEquiv.coe_addLeft, mem_preimage, hO, mem_range]
    constructor
    · rintro ⟨k, hk⟩
      exact ⟨k - 1, by rw [sub_zsmul, hk, one_zsmul]; abel⟩
    · rintro ⟨k, hk⟩
      exact ⟨k + 1, by rw [add_zsmul, hk, one_zsmul]; abel⟩
  rcases h.ergodic_moves O hOm (fun _ => by rw [hOinv]) with h0 | h1
  · exact ((orbitLam_eq_zero_iff a hOm).1 h0).2 0 ⟨0, rfl⟩
  · haveI : NoAtoms (volume : Measure (AddCircle T)) :=
      ⟨fun x => by rw [← Metric.closedBall_zero, AddCircle.volume_closedBall]; simp⟩
    have hvO : volume O = 0 := (countable_range _).measure_zero _
    have hvOc : volume Oᶜ = 0 := ((orbitLam_eq_zero_iff a hOm.compl).1 h1).1
    have hle := measure_univ_le_add_compl (μ := (volume : Measure (AddCircle T))) O
    rw [hvO, hvOc, add_zero, AddCircle.measure_univ] at hle
    exact absurd (le_antisymm hle zero_le) (ENNReal.ofReal_pos.2 (Fact.out : 0 < T)).ne'

end Independence

/-- **A rotation of infinite order**: `√2` on `ℝ/ℤ`. -/
theorem addOrderOf_sqrt_two_unitAddCircle : addOrderOf ((√2 : ℝ) : UnitAddCircle) = 0 := by
  rw [← AddCircle.denseRange_zsmul_iff, AddCircle.denseRange_zsmul_coe_iff, div_one]
  exact irrational_sqrt_two

/-- **A concrete inhabitant**: the rotation by `√2` of `ℝ/ℤ` with its Haar measure is an EGF. -/
theorem isEGFErgodic_circleRotFlow_sqrt_two :
    IsEGFErgodic volume (circleRotFlow ((√2 : ℝ) : UnitAddCircle))
      (fun _ : Fin 1 => MeasurableEquiv.addLeft ((√2 : ℝ) : UnitAddCircle)) (fun _ _ => 1) :=
  (isEGFErgodic_circleRotFlow_iff _).2 addOrderOf_sqrt_two_unitAddCircle

/-- **The witness of `isEGF_not_isEGFErgodic` exists**: at the rotation by `√2` of `ℝ/ℤ`. -/
theorem isEGF_not_isEGFErgodic_sqrt_two :
    IsEGF (circleRotFlow ((√2 : ℝ) : UnitAddCircle))
        (fun _ : Fin 1 => Homeomorph.addLeft ((√2 : ℝ) : UnitAddCircle)) (fun _ _ => 1) ∧
      ¬ IsEGFErgodic (orbitLam ((√2 : ℝ) : UnitAddCircle))
        (circleRotFlow ((√2 : ℝ) : UnitAddCircle))
        (fun _ : Fin 1 => MeasurableEquiv.addLeft ((√2 : ℝ) : UnitAddCircle)) (fun _ _ => 1) :=
  ⟨(isEGF_not_isEGFErgodic addOrderOf_sqrt_two_unitAddCircle).1,
    (isEGF_not_isEGFErgodic addOrderOf_sqrt_two_unitAddCircle).2.2⟩

/-- The identity flow on `Bool`: policy `s ↦ δ_s`, outflow `δ_true`. -/
noncomputable def idFlowBool : GenerativeFlow Bool where
  policy := Kernel.deterministic id measurable_id
  outflow := Measure.dirac true
  isMarkovKernel_policy := inferInstance
  isFiniteMeasure_outflow := inferInstance

/-- Every group is ergodic for a Dirac mass. -/
theorem isGroupErgodic_dirac {X : Type*} [MeasurableSpace X] (x : X)
    (H : Subgroup (Equiv.Perm X)) : IsGroupErgodic (Measure.dirac x) H := by
  intro A hA _
  by_cases hx : x ∈ A
  · right; rw [Measure.dirac_apply' _ hA.compl]; simp [hx]
  · left; rw [Measure.dirac_apply' _ hA]; simp [hx]

/-- **DEC-146's ergodicity does not give topological ergodicity** (C-26's finding, the converse
direction): on `Bool` with `λ = δ_true`, the identity is an EGF in DEC-146's sense, and is
topologically ergodic in neither reading (so not an EGF in the printed sense). The measure is not
of full support, unlike a Riemannian volume (see SCOPE). -/
theorem isEGFErgodic_not_isEGF :
    IsEGFErgodic (Measure.dirac true) idFlowBool (fun _ : Fin 1 => MeasurableEquiv.refl Bool)
        (fun _ _ => 1) ∧
      ¬ IsTopologicallyErgodicGroup (fun _ : Fin 1 => Homeomorph.refl Bool) ∧
      ¬ IsEGF idFlowBool (fun _ : Fin 1 => Homeomorph.refl Bool) (fun _ _ => 1) := by
  have hgrp : ¬ IsTopologicallyErgodicGroup (fun _ : Fin 1 => Homeomorph.refl Bool) := by
    intro h
    obtain ⟨w, hw⟩ := h true false {false} (by simp)
    have key : ∀ (w : List (Fin 1 × Bool)) (z : Bool),
        w.foldl (fun z ib => if ib.2 then (fun _ : Fin 1 => Homeomorph.refl Bool) ib.1 z
          else ((fun _ : Fin 1 => Homeomorph.refl Bool) ib.1).symm z) z = z := by
      intro w
      induction w with
      | nil => intro z; rfl
      | cons ib w ih => intro z; rw [List.foldl_cons, ih]; split_ifs <;> rfl
    rw [key] at hw
    simp at hw
  refine ⟨⟨?_, fun _ => ?_, isGroupErgodic_dirac true _⟩, hgrp, fun h => hgrp h.ergodic.group⟩
  · refine ⟨fun _ => measurable_id, fun _ => measurable_const, fun _ _ => zero_le_one,
      fun _ => by simp, fun s => ?_⟩
    simp [idFlowBool, Kernel.deterministic_apply]
  · have hid : ⇑(MeasurableEquiv.refl Bool) = id := rfl
    rw [MeasurableEquiv.symm_refl, hid, Measure.map_id]
    exact ⟨Measure.AbsolutelyContinuous.rfl, Measure.AbsolutelyContinuous.rfl⟩

/-! ## The generator form needs nonsingular moves -/

namespace FourCycle

/-- The rotation `i ↦ i + 1` of `Fin 4`, a measurable equivalence. -/
def rot : Fin 4 ≃ᵐ Fin 4 where
  toEquiv := finRotate 4
  measurable_toFun := measurable_of_finite _
  measurable_invFun := measurable_of_finite _

/-- Two atoms, at `0` and `2`. -/
noncomputable def lam : Measure (Fin 4) := Measure.dirac 0 + Measure.dirac 2

/-- `λ`-a.e. is at `0` and at `2`. -/
theorem ae_lam_iff {P : Fin 4 → Prop} : (∀ᵐ x ∂lam, P x) ↔ P 0 ∧ P 2 := by
  simp [lam, ae_add_measure_iff, ae_dirac_eq]

theorem lam_apply (A : Set (Fin 4)) : lam A = A.indicator 1 0 + A.indicator 1 2 := by
  simp [lam]

/-- **The nonsingularity in `isGroupErgodic_egfGroup_iff` cannot be dropped**: for the rotation of
`Fin 4` and `λ = δ₀ + δ₂`, the generated group is ergodic for `λ` (its element `i ↦ i + 2` swaps
the two atoms), the generator form fails (`{0, 1}` is a.e.-invariant under the rotation, of measure
`1` and co-measure `1`), and the rotation is singular (`λ{1} = 0 < (rot₊λ){1}`). -/
theorem isGroupErgodic_not_forall :
    IsGroupErgodic lam (egfGroup fun _ : Fin 1 => rot) ∧
      ¬ (∀ A, MeasurableSet A → (∀ i : Fin 1, (fun _ : Fin 1 => rot) i ⁻¹' A =ᵐ[lam] A) →
        lam A = 0 ∨ lam Aᶜ = 0) ∧
      ¬ lam.map rot ≪ lam := by
  refine ⟨fun A _ hinv => ?_, fun h => ?_, fun hac => ?_⟩
  · have h2 := hinv (rot.toEquiv * rot.toEquiv)
      (Subgroup.mul_mem _ (toEquiv_mem_egfGroup _ 0) (toEquiv_mem_egfGroup _ 0))
    rw [Filter.EventuallyEq, ae_lam_iff] at h2
    have e0 : (rot.toEquiv * rot.toEquiv) 0 = 2 := by decide
    have hiff : (2 : Fin 4) ∈ A ↔ (0 : Fin 4) ∈ A := by
      have := Iff.of_eq h2.1
      change (rot.toEquiv * rot.toEquiv) 0 ∈ A ↔ (0 : Fin 4) ∈ A at this
      rwa [e0] at this
    by_cases h0 : (0 : Fin 4) ∈ A
    · right
      rw [lam_apply]
      simp [h0, hiff.2 h0]
    · left
      rw [lam_apply]
      have h2' : (2 : Fin 4) ∉ A := fun h => h0 (hiff.1 h)
      simp [h0, h2']
  · have hA : (rot ⁻¹' ({0, 1} : Set (Fin 4))) =ᵐ[lam] ({0, 1} : Set (Fin 4)) := by
      rw [Filter.EventuallyEq, ae_lam_iff]
      refine ⟨propext ?_, propext ?_⟩
      · show (finRotate 4 0 ∈ ({0, 1} : Set (Fin 4))) ↔ (0 : Fin 4) ∈ ({0, 1} : Set (Fin 4))
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff]; decide
      · show (finRotate 4 2 ∈ ({0, 1} : Set (Fin 4))) ↔ (2 : Fin 4) ∈ ({0, 1} : Set (Fin 4))
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff]; decide
    rcases h {0, 1} MeasurableSet.of_discrete (fun _ => hA) with h0 | h1
    · rw [lam_apply] at h0; simp at h0
    · rw [lam_apply] at h1; simp at h1
  · have h1 : lam {1} = 0 := by rw [lam_apply]; simp
    have := hac h1
    rw [Measure.map_apply rot.measurable (measurableSet_singleton 1), lam_apply] at this
    have e : (rot ⁻¹' {1}) = {0} := by
      ext x; simp only [Set.mem_preimage, Set.mem_singleton_iff]
      show finRotate 4 x = 1 ↔ x = 0
      revert x; decide
    rw [e] at this
    simp at this
end FourCycle

end EGF
