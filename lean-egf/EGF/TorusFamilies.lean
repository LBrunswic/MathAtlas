namespace EGF

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal Topology Matrix

/-! ## The torus and its affine maps -/

/-- The volume of `UnitAddCircle` is a probability measure (`UnitAddCircle.measure_univ`; Mathlib
has the instance only locally, in `Analysis/Fourier/AddCircleMulti.lean`). -/
instance isProbabilityMeasure_volume_unitAddCircle :
    IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  ⟨UnitAddCircle.measure_univ⟩

variable {d : ℕ}

/-- The endomorphism `x ↦ Ax` of the torus `𝕋^d = UnitAddTorus (Fin d)`, for an integer matrix. -/
def torusLin (A : Matrix (Fin d) (Fin d) ℤ) : UnitAddTorus (Fin d) →+ UnitAddTorus (Fin d) where
  toFun x i := ∑ j, A i j • x j
  map_zero' := by funext i; simp
  map_add' x y := by funext i; simp [smul_add, Finset.sum_add_distrib]

theorem torusLin_apply (A : Matrix (Fin d) (Fin d) ℤ) (x : UnitAddTorus (Fin d)) (i : Fin d) :
    torusLin A x i = ∑ j, A i j • x j := rfl

/-- **The affine map** `x ↦ Ax + b` of the torus (`main.tex:283`). -/
def torusAffine (A : Matrix (Fin d) (Fin d) ℤ) (b x : UnitAddTorus (Fin d)) :
    UnitAddTorus (Fin d) :=
  fun i => (∑ j, A i j • x j) + b i

theorem torusAffine_eq (A : Matrix (Fin d) (Fin d) ℤ) (b : UnitAddTorus (Fin d)) :
    torusAffine A b = fun x => torusLin A x + b := rfl

theorem torusLin_mul (A B : Matrix (Fin d) (Fin d) ℤ) (x : UnitAddTorus (Fin d)) :
    torusLin (A * B) x = torusLin A (torusLin B x) := by
  funext i
  simp only [torusLin_apply, Matrix.mul_apply, Finset.sum_smul, Finset.smul_sum, mul_smul]
  exact Finset.sum_comm

theorem torusLin_one (x : UnitAddTorus (Fin d)) : torusLin 1 x = x := by
  funext i
  simp [torusLin_apply, Matrix.one_apply, ite_smul]

theorem torusAffine_comp (A B : Matrix (Fin d) (Fin d) ℤ) (b c x : UnitAddTorus (Fin d)) :
    torusAffine A b (torusAffine B c x) = torusAffine (A * B) (torusLin A c + b) x := by
  simp only [torusAffine_eq, map_add, torusLin_mul, add_assoc]

theorem torusAffine_one_zero : torusAffine (1 : Matrix (Fin d) (Fin d) ℤ) 0 = id := by
  funext x; simp [torusAffine_eq, torusLin_one]

theorem torusAffine_inv_left {A : Matrix (Fin d) (Fin d) ℤ} (hA : IsUnit A.det)
    (b x : UnitAddTorus (Fin d)) :
    torusAffine A⁻¹ (-torusLin A⁻¹ b) (torusAffine A b x) = x := by
  rw [torusAffine_comp, Matrix.nonsing_inv_mul A hA, add_neg_cancel, torusAffine_one_zero, id]

theorem torusAffine_inv_right {A : Matrix (Fin d) (Fin d) ℤ} (hA : IsUnit A.det)
    (b x : UnitAddTorus (Fin d)) :
    torusAffine A b (torusAffine A⁻¹ (-torusLin A⁻¹ b) x) = x := by
  rw [torusAffine_comp, Matrix.mul_nonsing_inv A hA, map_neg, ← torusLin_mul,
    Matrix.mul_nonsing_inv A hA, torusLin_one, neg_add_cancel, torusAffine_one_zero, id]

theorem continuous_torusLin (A : Matrix (Fin d) (Fin d) ℤ) : Continuous (torusLin A) := by
  refine continuous_pi fun i => ?_
  simp only [torusLin_apply]
  fun_prop

theorem continuous_torusAffine (A : Matrix (Fin d) (Fin d) ℤ) (b : UnitAddTorus (Fin d)) :
    Continuous (torusAffine A b) := by
  refine continuous_pi fun i => ?_
  unfold torusAffine
  fun_prop

theorem measurable_torusAffine (A : Matrix (Fin d) (Fin d) ℤ) (b : UnitAddTorus (Fin d)) :
    Measurable (torusAffine A b) :=
  (continuous_torusAffine A b).measurable

/-- For `det A = ±1`, `x ↦ Ax` is a bijection of the torus, with inverse `x ↦ A⁻¹x`. -/
theorem torusLin_bijective {A : Matrix (Fin d) (Fin d) ℤ} (hA : IsUnit A.det) :
    Function.Bijective (torusLin A) := by
  refine ⟨fun x y h => ?_, fun y => ⟨torusLin A⁻¹ y, ?_⟩⟩
  · have := congrArg (torusLin A⁻¹) h
    simpa [← torusLin_mul, Matrix.nonsing_inv_mul A hA, torusLin_one] using this
  · rw [← torusLin_mul, Matrix.mul_nonsing_inv A hA, torusLin_one]

/-- **A toral automorphism preserves the Haar probability**: for `det A = ±1`, the image of
`volume` under the continuous surjective endomorphism `x ↦ Ax` is a Haar probability, hence
`volume` (uniqueness of the Haar probability). -/
theorem measurePreserving_torusLin {A : Matrix (Fin d) (Fin d) ℤ} (hA : IsUnit A.det) :
    MeasurePreserving (torusLin A) volume volume := by
  refine ⟨(continuous_torusLin A).measurable, ?_⟩
  haveI : (Measure.map (torusLin A) volume).IsAddHaarMeasure :=
    Measure.isAddHaarMeasure_map_of_isFiniteMeasure volume (torusLin A) (continuous_torusLin A)
      (torusLin_bijective hA).2
  haveI : IsProbabilityMeasure
      (Measure.map (torusLin A) (volume : Measure (UnitAddTorus (Fin d)))) :=
    Measure.isProbabilityMeasure_map (continuous_torusLin A).measurable.aemeasurable
  exact Measure.isAddHaarMeasure_eq_of_isProbabilityMeasure _ _

/-- **An affine map with `det A = ±1` preserves the Haar probability** of the torus. -/
theorem measurePreserving_torusAffine {A : Matrix (Fin d) (Fin d) ℤ} (hA : IsUnit A.det)
    (b : UnitAddTorus (Fin d)) : MeasurePreserving (torusAffine A b) volume volume :=
  (measurePreserving_add_right volume b).comp (measurePreserving_torusLin hA)

/-- On `ℝ/ℤ`, `n • t = 0` for every `t` forces `n = 0` (`t = 1/(2n)`). -/
theorem zsmul_unitAddCircle_eq_zero {n : ℤ} (h : ∀ t : UnitAddCircle, n • t = 0) : n = 0 := by
  by_contra hn
  have ht := h ((1 / (2 * n) : ℝ) : UnitAddCircle)
  rw [← AddCircle.coe_zsmul, AddCircle.coe_eq_zero_iff] at ht
  obtain ⟨k, hk⟩ := ht
  have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast hn
  rw [zsmul_eq_mul, zsmul_eq_mul, mul_one, mul_one_div] at hk
  have h2 : (2 * k : ℝ) = 1 := by
    rw [hk]; field_simp
  have h3 : (2 * k : ℤ) = 1 := by exact_mod_cast h2
  omega

/-- **The linear part and the translation of an affine map are unique**: `p_a` is well defined. -/
theorem torusAffine_inj {A A' : Matrix (Fin d) (Fin d) ℤ} {b b' : UnitAddTorus (Fin d)}
    (h : torusAffine A b = torusAffine A' b') : A = A' ∧ b = b' := by
  have hb : b = b' := by
    have := congrFun h 0
    simpa [torusAffine_eq] using this
  subst hb
  refine ⟨?_, rfl⟩
  ext i j
  have key : ∀ t : UnitAddCircle, (A i j - A' i j) • t = 0 := by
    intro t
    have := congrFun (congrFun h (Pi.single j t)) i
    simp only [torusAffine, add_left_inj] at this
    rw [sub_smul, sub_eq_zero]
    simpa [Pi.single_apply, smul_ite] using this
  exact sub_eq_zero.mp (zsmul_unitAddCircle_eq_zero key)

/-- `x ↦ Ax + b` as a permutation of the torus, for `det A = ±1`; its inverse is
`x ↦ A⁻¹x − A⁻¹b`. -/
noncomputable def torusAffineEquiv (A : Matrix (Fin d) (Fin d) ℤ) (b : UnitAddTorus (Fin d))
    (hA : IsUnit A.det) : Equiv.Perm (UnitAddTorus (Fin d)) where
  toFun := torusAffine A b
  invFun := torusAffine A⁻¹ (-torusLin A⁻¹ b)
  left_inv x := torusAffine_inv_left hA b x
  right_inv x := torusAffine_inv_right hA b x

theorem coe_torusAffineEquiv (A : Matrix (Fin d) (Fin d) ℤ) (b : UnitAddTorus (Fin d))
    (hA : IsUnit A.det) : ⇑(torusAffineEquiv A b hA) = torusAffine A b := rfl

theorem coe_torusAffineEquiv_inv (A : Matrix (Fin d) (Fin d) ℤ) (b : UnitAddTorus (Fin d))
    (hA : IsUnit A.det) : ⇑(torusAffineEquiv A b hA)⁻¹ = torusAffine A⁻¹ (-torusLin A⁻¹ b) := rfl

/-! ## Groups of affine maps -/

/-- A permutation of the torus is **affine**: `x ↦ Ax + b` with `det A = ±1` (an element of
`Aff(𝕋^d) = GL_d(ℤ) ⋉ 𝕋^d`). -/
def IsTorusAffine (h : Equiv.Perm (UnitAddTorus (Fin d))) : Prop :=
  ∃ (A : Matrix (Fin d) (Fin d) ℤ) (b : UnitAddTorus (Fin d)), IsUnit A.det ∧ ⇑h = torusAffine A b

theorem isTorusAffine_one : IsTorusAffine (1 : Equiv.Perm (UnitAddTorus (Fin d))) :=
  ⟨1, 0, by simp, by rw [torusAffine_one_zero]; rfl⟩

theorem IsTorusAffine.mul {g h : Equiv.Perm (UnitAddTorus (Fin d))} (hg : IsTorusAffine g)
    (hh : IsTorusAffine h) : IsTorusAffine (g * h) := by
  obtain ⟨A, b, hA, hg⟩ := hg
  obtain ⟨B, c, hB, hh⟩ := hh
  refine ⟨A * B, torusLin A c + b, by rw [Matrix.det_mul]; exact hA.mul hB, ?_⟩
  funext x
  rw [Equiv.Perm.coe_mul, Function.comp_apply, hg, hh, torusAffine_comp]

theorem IsTorusAffine.inv {h : Equiv.Perm (UnitAddTorus (Fin d))} (hh : IsTorusAffine h) :
    IsTorusAffine h⁻¹ := by
  obtain ⟨A, b, hA, hh⟩ := hh
  refine ⟨A⁻¹, -torusLin A⁻¹ b, Matrix.isUnit_nonsing_inv_det A hA, ?_⟩
  funext x
  apply h.injective
  rw [show h (h⁻¹ x) = x from h.apply_symm_apply x, hh, torusAffine_inv_right hA]

theorem IsTorusAffine.measurePreserving {h : Equiv.Perm (UnitAddTorus (Fin d))}
    (hh : IsTorusAffine h) : MeasurePreserving ⇑h volume volume := by
  obtain ⟨A, b, hA, hh⟩ := hh
  rw [hh]; exact measurePreserving_torusAffine hA b

/-- **The linear parts** `p_a(H)` of a group of affine maps (unique, `torusAffine_inj`). -/
def linearParts (H : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))) :
    Set (Matrix (Fin d) (Fin d) ℤ) :=
  {A | ∃ h ∈ H, ∃ b, ⇑h = torusAffine A b}

/-- **The group generated by the moves** `Φᵢ = x ↦ Aᵢx + bᵢ`. -/
def torusAffineGroup {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (b : Fin p → UnitAddTorus (Fin d)) (hA : ∀ i, IsUnit (A i).det) :
    Subgroup (Equiv.Perm (UnitAddTorus (Fin d))) :=
  Subgroup.closure (Set.range fun i => torusAffineEquiv (A i) (b i) (hA i))

theorem isTorusAffine_of_mem_torusAffineGroup {p : ℕ} {A : Fin p → Matrix (Fin d) (Fin d) ℤ}
    {b : Fin p → UnitAddTorus (Fin d)} {hA : ∀ i, IsUnit (A i).det} {h : Equiv.Perm _}
    (hh : h ∈ torusAffineGroup A b hA) : IsTorusAffine h := by
  induction hh using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨i, rfl⟩ := hg
    exact ⟨A i, b i, hA i, rfl⟩
  | one => exact isTorusAffine_one
  | mul g k _ _ ihg ihk => exact ihg.mul ihk
  | inv g _ ih => exact ih.inv

/-- The group generated by finitely many moves is countable (Theorem 5 is for countable `H`). -/
theorem countable_torusAffineGroup {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (b : Fin p → UnitAddTorus (Fin d)) (hA : ∀ i, IsUnit (A i).det) :
    Countable (torusAffineGroup A b hA) := by
  haveI : Countable (FreeGroup (Set.range fun i => torusAffineEquiv (A i) (b i) (hA i))) :=
    inferInstanceAs (Countable (Quot _))
  unfold torusAffineGroup
  rw [FreeGroup.closure_eq_range]
  exact (Set.countable_range _).to_subtype

/-! ## Spectral gap, amenability, factor tori -/

section SpectralGap

variable {X : Type*} [MeasurableSpace X]

/-- **Almost invariant vectors** of the Koopman representation `U(h)ξ = ξ ∘ h⁻¹` of `H` on
`L²₀(X, μ)` (Bekka–Guivarc'h, p. 1): a sequence of unit vectors `ξₙ` of the complex `L²(μ)` with
`∫ ξₙ dμ = 0` and `‖U(h)ξₙ − ξₙ‖₂ → 0` for every `h ∈ H`. -/
def HasAlmostInvariantVectors (μ : Measure X) (H : Subgroup (Equiv.Perm X)) : Prop :=
  ∃ ξ : ℕ → X → ℂ, (∀ n, MemLp (ξ n) 2 μ) ∧ (∀ n, ∫ x, ξ n x ∂μ = 0) ∧
    (∀ n, eLpNorm (ξ n) 2 μ = 1) ∧
    ∀ h ∈ H, Tendsto (fun n => eLpNorm (fun x => ξ n (h⁻¹ x) - ξ n x) 2 μ) atTop (𝓝 0)

/-- **The action of `H` on `(X, μ)` has a spectral gap** (Bekka–Guivarc'h, p. 1): the Koopman
representation on `L²₀(X, μ)` has no almost invariant vectors. -/
def HasSpectralGap (μ : Measure X) (H : Subgroup (Equiv.Perm X)) : Prop :=
  ¬ HasAlmostInvariantVectors μ H

/-- **Ergodicity of a group action**: every measurable set a.e.-invariant under every element of
`H` is null or conull. This is Mathlib's `ErgodicSMul H X μ` (`Dynamics/Ergodic/Action/Basic.lean`)
without the invariance of `μ` it includes, for a subgroup of `Equiv.Perm X` acting by evaluation;
for measure-preserving `H` the two agree (`isGroupErgodic_iff_ergodicSMul`). -/
def IsGroupErgodic (μ : Measure X) (H : Subgroup (Equiv.Perm X)) : Prop :=
  ∀ A, MeasurableSet A → (∀ h ∈ H, ⇑h ⁻¹' A =ᵐ[μ] A) → μ A = 0 ∨ μ Aᶜ = 0

/-- **The bridge to Mathlib's ergodic actions**: for a subgroup `H` of measure-preserving
permutations, `IsGroupErgodic μ H` is `ErgodicSMul H X μ`. -/
theorem isGroupErgodic_iff_ergodicSMul {μ : Measure X} {H : Subgroup (Equiv.Perm X)}
    (hmp : ∀ h ∈ H, MeasurePreserving ⇑h μ μ) : IsGroupErgodic μ H ↔ ErgodicSMul H X μ := by
  have hsmul : ∀ h : H, (fun x : X => h • x) = ⇑(h : Equiv.Perm X) := fun _ => rfl
  constructor
  · intro herg
    haveI : SMulInvariantMeasure H X μ := ⟨fun h s hs => by
      rw [hsmul]
      exact (hmp h h.2).measure_preimage hs.nullMeasurableSet⟩
    refine ⟨fun {s} hs hinv => ?_⟩
    · rcases herg s hs (fun h hh => by simpa [hsmul] using hinv ⟨h, hh⟩) with h0 | h1
      · exact eventuallyConst_set'.2 (Or.inl (ae_eq_empty.2 h0))
      · exact eventuallyConst_set'.2 (Or.inr (ae_eq_univ.2 h1))
  · intro herg A hA hinv
    have hc := herg.aeconst_of_forall_preimage_smul_ae_eq hA fun h => by
      rw [hsmul]; exact hinv h h.2
    rcases eventuallyConst_set'.1 hc with h0 | h1
    · exact Or.inl (ae_eq_empty.1 h0)
    · exact Or.inr (ae_eq_univ.1 h1)

end SpectralGap

/-- **An amenable (discrete) group**: there is a left-invariant finitely additive probability on
all its subsets (von Neumann's definition). -/
def IsAmenableGroup (G : Type*) [Group G] : Prop :=
  ∃ m : Set G → ℝ, (∀ E, 0 ≤ m E) ∧ m Set.univ = 1 ∧
    (∀ E F, Disjoint E F → m (E ∪ F) = m E + m F) ∧ ∀ (g : G) (E : Set G), m ((g * ·) '' E) = m E

/-- **A virtually abelian group**: it contains an abelian subgroup of finite index
(Bekka–Guivarc'h, Theorem 1 (iii)). -/
def IsVirtuallyAbelian (G : Type*) [Group G] : Prop :=
  ∃ K : Subgroup G, K.FiniteIndex ∧ ∀ x ∈ K, ∀ y ∈ K, x * y = y * x

/-- **The projection of the linear parts `L` on the automorphisms of the factor torus**
`𝕋^d/S`, `S = W/(W ∩ ℤ^d)` for a rational subspace `W` (the `ℚ`-subspace of `ℚ^d`), read in
`GL_ℚ(ℚ^d/W)`: the linear automorphisms `u` of `ℚ^d/W` with `u [v] = [Av]` for some `A ∈ L`. -/
def factorProjection (W : Submodule ℚ (Fin d → ℚ)) (L : Set (Matrix (Fin d) (Fin d) ℤ)) :
    Set (((Fin d → ℚ) ⧸ W) ≃ₗ[ℚ] ((Fin d → ℚ) ⧸ W)) :=
  {u | ∃ A ∈ L, ∀ v, u (W.mkQ v) = W.mkQ ((A.map (Int.cast : ℤ → ℚ)) *ᵥ v)}

/-- **Nothing is dropped by `factorProjection`**: every `A` with `det A = ±1` leaving `W`
invariant has a projection on `ℚ^d/W` (`W` is then `A`-stable, `A W = W` by dimension). -/
theorem exists_factorProjection {W : Submodule ℚ (Fin d → ℚ)} {A : Matrix (Fin d) (Fin d) ℤ}
    (hA : IsUnit A.det) (hW : ∀ w ∈ W, (A.map (Int.cast : ℤ → ℚ)) *ᵥ w ∈ W) :
    ∃ u : ((Fin d → ℚ) ⧸ W) ≃ₗ[ℚ] ((Fin d → ℚ) ⧸ W),
      ∀ v, u (W.mkQ v) = W.mkQ ((A.map (Int.cast : ℤ → ℚ)) *ᵥ v) := by
  set B : Matrix (Fin d) (Fin d) ℚ := A.map (Int.cast : ℤ → ℚ) with hB
  have hdet : IsUnit B.det := by
    have := hA.map (Int.castRingHom ℚ)
    rwa [RingHom.map_det] at this
  letI := B.invertibleOfIsUnitDet hdet
  set e := B.toLinearEquiv' this with he
  have hle : W.map (e : (Fin d → ℚ) →ₗ[ℚ] (Fin d → ℚ)) ≤ W := by
    rintro _ ⟨w, hw, rfl⟩
    exact hW w hw
  have hmap : W.map (e : (Fin d → ℚ) →ₗ[ℚ] (Fin d → ℚ)) = W :=
    Submodule.eq_of_le_of_finrank_eq hle (LinearEquiv.finrank_map_eq e W)
  exact ⟨Submodule.Quotient.equiv W W e hmap, fun v => rfl⟩

/-- The projection of `A` on `ℚ^d/W` is unique. -/
theorem factorProjection_unique {W : Submodule ℚ (Fin d → ℚ)} {A : Matrix (Fin d) (Fin d) ℤ}
    {u u' : ((Fin d → ℚ) ⧸ W) ≃ₗ[ℚ] ((Fin d → ℚ) ⧸ W)}
    (hu : ∀ v, u (W.mkQ v) = W.mkQ ((A.map (Int.cast : ℤ → ℚ)) *ᵥ v))
    (hu' : ∀ v, u' (W.mkQ v) = W.mkQ ((A.map (Int.cast : ℤ → ℚ)) *ᵥ v)) : u = u' := by
  ext q
  obtain ⟨v, rfl⟩ := W.mkQ_surjective q
  rw [hu, hu']

/-- The linear parts of a group of affine maps have `det = ±1` (`torusAffine_inj`). -/
theorem isUnit_det_of_mem_linearParts {H : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))}
    (haff : ∀ h ∈ H, IsTorusAffine h) {A : Matrix (Fin d) (Fin d) ℤ} (hA : A ∈ linearParts H) :
    IsUnit A.det := by
  obtain ⟨h, hh, b, hb⟩ := hA
  obtain ⟨A', b', hA', hb'⟩ := haff h hh
  rw [hb] at hb'
  rw [(torusAffine_inj hb').1]
  exact hA'

theorem map_intCast_mul (A B : Matrix (Fin d) (Fin d) ℤ) :
    (A * B).map (Int.cast : ℤ → ℚ) = A.map (Int.cast : ℤ → ℚ) * B.map (Int.cast : ℤ → ℚ) :=
  Matrix.map_mul (f := Int.castRingHom ℚ)

/-- `p_a(H)` is closed under products. -/
theorem mul_mem_linearParts {H : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))}
    {A B : Matrix (Fin d) (Fin d) ℤ} (hA : A ∈ linearParts H) (hB : B ∈ linearParts H) :
    A * B ∈ linearParts H := by
  obtain ⟨g, hg, b, hgb⟩ := hA
  obtain ⟨h, hh, c, hhc⟩ := hB
  refine ⟨g * h, H.mul_mem hg hh, torusLin A c + b, ?_⟩
  funext x
  rw [Equiv.Perm.coe_mul, Function.comp_apply, hgb, hhc, torusAffine_comp]

/-- `p_a(H)` is closed under inverses, for a group of affine maps. -/
theorem inv_mem_linearParts {H : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))}
    (haff : ∀ h ∈ H, IsTorusAffine h) {A : Matrix (Fin d) (Fin d) ℤ} (hA : A ∈ linearParts H) :
    A⁻¹ ∈ linearParts H := by
  have hdet := isUnit_det_of_mem_linearParts haff hA
  obtain ⟨h, hh, b, hb⟩ := hA
  refine ⟨h⁻¹, H.inv_mem hh, -torusLin A⁻¹ b, ?_⟩
  funext x
  apply h.injective
  rw [show h (h⁻¹ x) = x from h.apply_symm_apply x, hb, torusAffine_inv_right hdet]

theorem one_mem_linearParts (H : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))) :
    (1 : Matrix (Fin d) (Fin d) ℤ) ∈ linearParts H :=
  ⟨1, H.one_mem, 0, by rw [torusAffine_one_zero]; rfl⟩

/-- **The subgroup generated by the projections is the projection of `p_a(H)`**: for a group `H`
of affine maps and `W` invariant under `p_a(H)`, `factorProjection W (linearParts H)` is already a
subgroup (`A ↦ u_A` is multiplicative), so `Subgroup.closure` in (ii) and (iii) adds nothing and
`Subgroup.closure (factorProjection W (linearParts H))` is exactly "the projection of `p_a(H)` on
`Aut(𝕋̄)`" of Bekka–Guivarc'h. -/
theorem mem_closure_factorProjection_iff {H : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))}
    (haff : ∀ h ∈ H, IsTorusAffine h) {W : Submodule ℚ (Fin d → ℚ)}
    (u : ((Fin d → ℚ) ⧸ W) ≃ₗ[ℚ] ((Fin d → ℚ) ⧸ W)) :
    u ∈ Subgroup.closure (factorProjection W (linearParts H)) ↔
      u ∈ factorProjection W (linearParts H) := by
  refine ⟨fun hu => ?_, fun hu => Subgroup.subset_closure hu⟩
  let K : Subgroup (((Fin d → ℚ) ⧸ W) ≃ₗ[ℚ] ((Fin d → ℚ) ⧸ W)) :=
    { carrier := factorProjection W (linearParts H)
      mul_mem' := by
        rintro u₁ u₂ ⟨A, hA, h₁⟩ ⟨B, hB, h₂⟩
        refine ⟨A * B, mul_mem_linearParts hA hB, fun v => ?_⟩
        rw [LinearEquiv.mul_apply, h₂, h₁, Matrix.mulVec_mulVec, map_intCast_mul]
      one_mem' := ⟨1, one_mem_linearParts H, fun v => by
        rw [Matrix.map_one _ Int.cast_zero Int.cast_one, Matrix.one_mulVec]; rfl⟩
      inv_mem' := by
        rintro u₁ ⟨A, hA, h₁⟩
        refine ⟨A⁻¹, inv_mem_linearParts haff hA, fun v => ?_⟩
        have hdet := isUnit_det_of_mem_linearParts haff hA
        apply u₁.injective
        rw [show u₁ (u₁⁻¹ (W.mkQ v)) = W.mkQ v from u₁.apply_symm_apply _, h₁,
          Matrix.mulVec_mulVec, ← map_intCast_mul, Matrix.mul_nonsing_inv A hdet,
          Matrix.map_one _ Int.cast_zero Int.cast_one, Matrix.one_mulVec] }
  exact (Subgroup.closure_le K).2 (fun _ hx => hx) hu

/-- **Condition (ii) of Theorem 5** (Bekka–Guivarc'h, §2): a non-trivial invariant factor torus
(a rational subspace `W ≠ ℚ^d` invariant under every linear part) on which the projection of the
linear parts is amenable. -/
def BGConditionII (L : Set (Matrix (Fin d) (Fin d) ℤ)) : Prop :=
  ∃ W : Submodule ℚ (Fin d → ℚ), W ≠ ⊤ ∧
    (∀ A ∈ L, ∀ w ∈ W, (A.map (Int.cast : ℤ → ℚ)) *ᵥ w ∈ W) ∧
    IsAmenableGroup (Subgroup.closure (factorProjection W L))

/-- **Condition (iii) of Theorem 5**: the same with "virtually abelian". -/
def BGConditionIII (L : Set (Matrix (Fin d) (Fin d) ℤ)) : Prop :=
  ∃ W : Submodule ℚ (Fin d → ℚ), W ≠ ⊤ ∧
    (∀ A ∈ L, ∀ w ∈ W, (A.map (Int.cast : ℤ → ℚ)) *ᵥ w ∈ W) ∧
    IsVirtuallyAbelian (Subgroup.closure (factorProjection W L))

/-- **Theorem 5 of Bekka–Guivarc'h** (arXiv:1106.2623v1, §2; `theo:spectral_gap_tori`,
`main.tex:810`), the named external result of DEC-141: for every countable subgroup `H` of
`Aff(𝕋^d)`, (i) the action of `H` on `𝕋^d` has no spectral gap ⟺ (ii) ⟺ (iii). A `Prop`, never an
axiom: it is a hypothesis of `universality_tori` only. -/
def BekkaGuivarchTheorem5 (d : ℕ) : Prop :=
  ∀ H : Subgroup (Equiv.Perm (UnitAddTorus (Fin d))), Countable H → (∀ h ∈ H, IsTorusAffine h) →
    (¬ HasSpectralGap volume H ↔ BGConditionII (linearParts H)) ∧
      (BGConditionII (linearParts H) ↔ BGConditionIII (linearParts H))

/-- **`theo:spectral_gap_tori` as printed** (`main.tex:810–817`), from the named `Prop`. -/
theorem spectral_gap_tori (hBG : BekkaGuivarchTheorem5 d)
    (H : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))) (hH : Countable H)
    (haff : ∀ h ∈ H, IsTorusAffine h) :
    ¬ HasSpectralGap volume H ↔ BGConditionII (linearParts H) :=
  (hBG H hH haff).1

/-! ## A spectral gap makes the action ergodic -/

section Ergodic

variable {X : Type*} [MeasurableSpace X]

/-- A non-trivial measurable set gives a unit vector `ξ ∈ L²₀(μ)`, a multiple of `1_A − μ(A)`,
fixed by every map leaving `A` a.e.-invariant. -/
theorem exists_unit_meanZero_of_set {μ : Measure X} [IsProbabilityMeasure μ] {A : Set X}
    (hA : MeasurableSet A) (h0 : μ A ≠ 0) (h1 : μ Aᶜ ≠ 0) :
    ∃ ξ : X → ℂ, MemLp ξ 2 μ ∧ ∫ x, ξ x ∂μ = 0 ∧ eLpNorm ξ 2 μ = 1 ∧
      ∀ g : X → X, g ⁻¹' A =ᵐ[μ] A → (fun x => ξ (g x)) =ᵐ[μ] ξ := by
  set c : ℂ := (μ.real A : ℂ) with hc
  set ξ₀ : X → ℂ := fun x => A.indicator (fun _ => (1 : ℂ)) x - c with hξ₀
  have hmem₀ : MemLp ξ₀ 2 μ :=
    ((memLp_const (1 : ℂ)).indicator hA).sub (memLp_const c)
  have hint₀ : ∫ x, ξ₀ x ∂μ = 0 := by
    rw [hξ₀, integral_sub ((integrable_const (1 : ℂ)).indicator hA) (integrable_const c),
      integral_indicator_const _ hA, integral_const, probReal_univ, hc]
    simp
  have hc1 : μ.real A ≠ 1 := by
    intro h
    apply h1
    rw [prob_compl_eq_zero_iff hA]
    rw [Measure.real, ENNReal.toReal_eq_one_iff] at h
    exact h
  have hne0 : eLpNorm ξ₀ 2 μ ≠ 0 := by
    intro h
    rw [eLpNorm_eq_zero_iff hmem₀.1 two_ne_zero] at h
    apply h0
    refine measure_mono_null (show A ⊆ {x | ξ₀ x ≠ 0} from fun x hx => ?_) (ae_iff.mp h)
    simp only [Set.mem_setOf_eq, hξ₀, Set.indicator_of_mem hx, hc]
    intro h'
    apply hc1
    have := congrArg Complex.re (sub_eq_zero.mp h')
    simpa using this.symm
  have hnetop : eLpNorm ξ₀ 2 μ ≠ ∞ := hmem₀.eLpNorm_ne_top
  set r : ℝ := (eLpNorm ξ₀ 2 μ).toReal⁻¹ with hr
  have hrpos : 0 < r := inv_pos.mpr (ENNReal.toReal_pos hne0 hnetop)
  refine ⟨(r : ℂ) • ξ₀, hmem₀.const_smul _, ?_, ?_, fun g hg => ?_⟩
  · show ∫ x, (r : ℂ) • ξ₀ x ∂μ = 0
    rw [integral_smul, hint₀, smul_zero]
  · rw [eLpNorm_const_smul, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg hrpos.le, hr,
      ENNReal.ofReal_inv_of_pos (ENNReal.toReal_pos hne0 hnetop), ENNReal.ofReal_toReal hnetop,
      ENNReal.inv_mul_cancel hne0 hnetop]
  · have hind : (g ⁻¹' A).indicator (fun _ => (1 : ℂ)) =ᵐ[μ] A.indicator (fun _ => (1 : ℂ)) :=
      indicator_ae_eq_of_ae_eq_set hg
    filter_upwards [hind] with x hx
    have : A.indicator (fun _ => (1 : ℂ)) (g x) = (g ⁻¹' A).indicator (fun _ => (1 : ℂ)) x := rfl
    show (r : ℂ) • ξ₀ (g x) = (r : ℂ) • ξ₀ x
    congr 1
    show A.indicator _ (g x) - c = A.indicator _ x - c
    rw [this, hx]

/-- **A spectral gap makes the action ergodic** (C-28): an `H`-invariant set `A` with
`0 < μ(A) < 1` would give the invariant unit vector `1_A − μ(A)` of `L²₀(μ)`. -/
theorem ergodic_of_hasSpectralGap {μ : Measure X} [IsProbabilityMeasure μ]
    {H : Subgroup (Equiv.Perm X)} (h : HasSpectralGap μ H) : IsGroupErgodic μ H := by
  intro A hA hinv
  by_contra hcon
  push Not at hcon
  obtain ⟨ξ, hmem, hint, hnorm, hfix⟩ := exists_unit_meanZero_of_set hA hcon.1 hcon.2
  refine h ⟨fun _ => ξ, fun _ => hmem, fun _ => hint, fun _ => hnorm, fun g hg => ?_⟩
  have hfix' := hfix (⇑g⁻¹) (hinv g⁻¹ (H.inv_mem hg))
  have h0 : eLpNorm (fun x => ξ (g⁻¹ x) - ξ x) 2 μ = 0 := by
    rw [eLpNorm_congr_ae (g := (0 : X → ℂ)) (hfix'.mono fun x hx => by
      simp only [Pi.zero_apply]; exact sub_eq_zero.mpr hx)]
    simp
  simp only [h0]
  exact tendsto_const_nhds

/-- A set a.e.-invariant under measure-preserving generators is a.e.-invariant under the group
they generate. -/
theorem ae_invariant_of_mem_closure {μ : Measure X} {s : Set (Equiv.Perm X)}
    (hs : ∀ g ∈ s, MeasurePreserving ⇑g μ μ ∧ MeasurePreserving ⇑g⁻¹ μ μ) {A : Set X}
    (hA : ∀ g ∈ s, ⇑g ⁻¹' A =ᵐ[μ] A) {h : Equiv.Perm X} (hh : h ∈ Subgroup.closure s) :
    ⇑h ⁻¹' A =ᵐ[μ] A := by
  suffices H : MeasurePreserving ⇑h μ μ ∧ MeasurePreserving ⇑h⁻¹ μ μ ∧ ⇑h ⁻¹' A =ᵐ[μ] A from
    H.2.2
  induction hh using Subgroup.closure_induction with
  | mem g hg => exact ⟨(hs g hg).1, (hs g hg).2, hA g hg⟩
  | one =>
    refine ⟨?_, ?_, ?_⟩
    · rw [Equiv.Perm.coe_one]; exact MeasurePreserving.id μ
    · rw [inv_one, Equiv.Perm.coe_one]; exact MeasurePreserving.id μ
    · rw [Equiv.Perm.coe_one, Set.preimage_id]
  | mul g k _ _ ihg ihk =>
    refine ⟨?_, ?_, ?_⟩
    · rw [Equiv.Perm.coe_mul]; exact ihg.1.comp ihk.1
    · rw [mul_inv_rev, Equiv.Perm.coe_mul]; exact ihk.2.1.comp ihg.2.1
    · rw [Equiv.Perm.coe_mul, Set.preimage_comp]
      exact (ihk.1.quasiMeasurePreserving.preimage_ae_eq ihg.2.2).trans ihk.2.2
  | inv g _ ih =>
    refine ⟨ih.2.1, by rw [inv_inv]; exact ih.1, ?_⟩
    have key := ih.2.1.quasiMeasurePreserving.preimage_ae_eq ih.2.2
    rw [← Set.preimage_comp, ← Equiv.Perm.coe_mul, mul_inv_cancel, Equiv.Perm.coe_one,
      Set.preimage_id] at key
    exact key.symm

end Ergodic

/-! ## Non-vacuity: the trivial group -/

theorem linearParts_bot : linearParts (⊥ : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))) = {1} := by
  ext A
  simp only [linearParts, Subgroup.mem_bot, Set.mem_setOf_eq, Set.mem_singleton_iff]
  constructor
  · rintro ⟨h, rfl, b, hb⟩
    rw [Equiv.Perm.coe_one, ← torusAffine_one_zero] at hb
    exact (torusAffine_inj hb).1.symm
  · rintro rfl
    exact ⟨1, rfl, 0, by rw [torusAffine_one_zero]; rfl⟩

/-- A finite group is amenable: the normalized counting measure. -/
theorem isAmenableGroup_of_finite (G : Type*) [Group G] [Finite G] : IsAmenableGroup G := by
  refine ⟨fun E => (E.ncard : ℝ) / Nat.card G, fun E => by positivity, ?_, fun E F hEF => ?_,
    fun g E => ?_⟩
  · have : (0 : ℝ) < Nat.card G := by exact_mod_cast Nat.card_pos
    simp only [Set.ncard_univ]
    exact div_self this.ne'
  · simp only
    rw [Set.ncard_union_eq hEF (Set.toFinite E) (Set.toFinite F)]
    push_cast
    ring
  · simp only
    rw [Set.ncard_image_of_injective E (mul_right_injective g)]

/-- A finite group is virtually abelian: its trivial subgroup has finite index. -/
theorem isVirtuallyAbelian_of_finite (G : Type*) [Group G] [Finite G] : IsVirtuallyAbelian G :=
  ⟨⊥, inferInstance, fun x hx y hy => by rw [Subgroup.mem_bot] at hx hy; rw [hx, hy]⟩

/-- The projection of the identity matrix on any factor is the identity. -/
theorem factorProjection_one_subset (W : Submodule ℚ (Fin d → ℚ)) :
    factorProjection W {1} ⊆ {1} := by
  rintro u ⟨A, hA, hu⟩
  rw [Set.mem_singleton_iff] at hA ⊢
  subst hA
  ext q
  obtain ⟨v, rfl⟩ := W.mkQ_surjective q
  rw [hu, Matrix.map_one _ Int.cast_zero Int.cast_one, Matrix.one_mulVec]
  rfl

/-- For `d ≥ 1` the trivial group satisfies (ii) and (iii) of Theorem 5, with `W = 0`
(`𝕋̄ = 𝕋^d`): the projection of its linear parts `{1}` is the trivial group. -/
theorem bgConditionII_bot (hd : 0 < d) :
    BGConditionII (linearParts (⊥ : Subgroup (Equiv.Perm (UnitAddTorus (Fin d))))) ∧
      BGConditionIII (linearParts (⊥ : Subgroup (Equiv.Perm (UnitAddTorus (Fin d))))) := by
  haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  have hW : (⊥ : Submodule ℚ (Fin d → ℚ)) ≠ ⊤ := bot_ne_top
  have hinv : ∀ A ∈ linearParts (⊥ : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))),
      ∀ w ∈ (⊥ : Submodule ℚ (Fin d → ℚ)),
        (A.map (Int.cast : ℤ → ℚ)) *ᵥ w ∈ (⊥ : Submodule ℚ _) := by
    intro A _ w hw
    rw [Submodule.mem_bot] at hw ⊢
    rw [hw, Matrix.mulVec_zero]
  have hK : Subgroup.closure (factorProjection (⊥ : Submodule ℚ (Fin d → ℚ))
      (linearParts (⊥ : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))))) ≤ ⊥ := by
    rw [Subgroup.closure_le, Subgroup.coe_bot, linearParts_bot]
    exact factorProjection_one_subset _
  haveI : Subsingleton (Subgroup.closure (factorProjection (⊥ : Submodule ℚ (Fin d → ℚ))
      (linearParts (⊥ : Subgroup (Equiv.Perm (UnitAddTorus (Fin d))))))) :=
    ⟨fun x y => Subtype.ext
      ((Subgroup.mem_bot.1 (hK x.2)).trans (Subgroup.mem_bot.1 (hK y.2)).symm)⟩
  exact ⟨⟨⊥, hW, hinv, isAmenableGroup_of_finite _⟩, ⟨⊥, hW, hinv, isVirtuallyAbelian_of_finite _⟩⟩

/-- For `d ≥ 1` the torus has a measurable set of volume `½`: `{x | x₀ ∈ [−¼, ¼]}`. -/
theorem exists_measurableSet_volume_half (hd : 0 < d) :
    ∃ E : Set (UnitAddTorus (Fin d)), MeasurableSet E ∧ volume E = ENNReal.ofReal (1 / 2) := by
  set i : Fin d := ⟨0, hd⟩
  set B : Set UnitAddCircle := Metric.closedBall 0 (1 / 4)
  have hB : MeasurableSet B := Metric.isClosed_closedBall.measurableSet
  refine ⟨(fun x => x i) ⁻¹' B, measurable_pi_apply i hB, ?_⟩
  have hvolB : volume B = ENNReal.ofReal (1 / 2) := by
    rw [AddCircle.volume_closedBall]; norm_num
  rw [← hvolB]
  exact (measurePreserving_eval (fun _ : Fin d => (volume : Measure UnitAddCircle))
    i).measure_preimage hB.nullMeasurableSet

/-- **The non-vacuity witness** of `BekkaGuivarchTheorem5` (DEC-141): for `d ≥ 1` the trivial
group satisfies its hypotheses and its three items (it fixes the non-trivial set
`{x | x₀ ∈ [−¼, ¼]}`, so it is not ergodic and has no spectral gap). -/
theorem bekkaGuivarch_witness_bot (hd : 0 < d) :
    Countable (⊥ : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))) ∧
      (∀ h ∈ (⊥ : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))), IsTorusAffine h) ∧
      ¬ HasSpectralGap volume (⊥ : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))) ∧
      BGConditionII (linearParts (⊥ : Subgroup (Equiv.Perm (UnitAddTorus (Fin d))))) ∧
      BGConditionIII (linearParts (⊥ : Subgroup (Equiv.Perm (UnitAddTorus (Fin d))))) := by
  refine ⟨inferInstance, fun h hh => ?_, fun hgap => ?_, bgConditionII_bot hd⟩
  · rw [Subgroup.mem_bot] at hh
    rw [hh]
    exact isTorusAffine_one
  · obtain ⟨E, hE, hvolE⟩ := exists_measurableSet_volume_half hd
    have herg := ergodic_of_hasSpectralGap hgap E hE fun h hh => by
      rw [Subgroup.mem_bot] at hh
      rw [hh, Equiv.Perm.coe_one, Set.preimage_id]
    rcases herg with h0 | h1
    · rw [hvolE] at h0; norm_num at h0
    · rw [prob_compl_eq_zero_iff hE, hvolE] at h1
      norm_num at h1

/-- **`BekkaGuivarchTheorem5 0` holds**: on the one-point torus `𝕋⁰` the three items are false for
every `H` (`L²₀` is `0`, and `ℚ⁰` has no proper subspace). The named `Prop` is not refutable at
`d = 0`; Bekka–Guivarc'h assume `d ≥ 1`. -/
theorem bekkaGuivarchTheorem5_zero : BekkaGuivarchTheorem5 0 := by
  have hII : ∀ L : Set (Matrix (Fin 0) (Fin 0) ℤ), ¬ BGConditionII L :=
    fun L ⟨W, hW, _⟩ => hW (Subsingleton.elim _ _)
  have hIII : ∀ L : Set (Matrix (Fin 0) (Fin 0) ℤ), ¬ BGConditionIII L :=
    fun L ⟨W, hW, _⟩ => hW (Subsingleton.elim _ _)
  intro H _ _
  refine ⟨⟨fun h => ?_, fun h => absurd h (hII _)⟩,
    ⟨fun h => absurd h (hII _), fun h => absurd h (hIII _)⟩⟩
  exfalso
  apply h
  rintro ⟨ξ, -, hint, hnorm, -⟩
  have hz := hint 0
  rw [integral_unique, probReal_univ, one_smul] at hz
  have : ξ 0 = (0 : UnitAddTorus (Fin 0) → ℂ) := by
    funext x
    rw [Pi.zero_apply, ← hz]
    congr 1
    exact Subsingleton.elim _ _
  have h1 := hnorm 0
  rw [this, eLpNorm_zero] at h1
  exact zero_ne_one h1


/-! ## Dimension one: condition (ii) always holds (C-28 (b)) -/

theorem mulVec_fin_one (A : Matrix (Fin 1) (Fin 1) ℤ) (v : Fin 1 → ℚ) :
    (A.map (Int.cast : ℤ → ℚ)) *ᵥ v = ((A 0 0 : ℤ) : ℚ) • v := by
  funext i
  fin_cases i
  simp [Matrix.mulVec, dotProduct]

/-- On `ℚ¹` the projection of a linear part `±1` is `±1`. -/
theorem factorProjection_fin_one {W : Submodule ℚ (Fin 1 → ℚ)} {L : Set (Matrix (Fin 1) (Fin 1) ℤ)}
    (hL : ∀ A ∈ L, IsUnit A.det) {u : ((Fin 1 → ℚ) ⧸ W) ≃ₗ[ℚ] ((Fin 1 → ℚ) ⧸ W)}
    (hu : u ∈ factorProjection W L) : u = 1 ∨ u = LinearEquiv.neg ℚ := by
  obtain ⟨A, hA, hu⟩ := hu
  have h := hL A hA
  rw [Matrix.det_fin_one, Int.isUnit_iff] at h
  rcases h with h | h
  · left
    ext q
    obtain ⟨v, rfl⟩ := W.mkQ_surjective q
    rw [hu, mulVec_fin_one, h]
    simp
  · right
    ext q
    obtain ⟨v, rfl⟩ := W.mkQ_surjective q
    rw [hu, mulVec_fin_one, h]
    simp

/-- **On `𝕋¹` condition (ii) holds for every group of affine maps** (C-28 (b)): with `W = 0` the
projection of the linear parts lies in `{±1}`, a finite, hence amenable and virtually abelian,
group. So the hypothesis `¬ BGConditionII` of `universality_tori` is never met for `d = 1`: the
paper's route (`main.tex:818–821`) gives nothing on the circle, while one translation of infinite
order is ergodic there (`EGF.isUniversalPolicy_addCircle`). -/
theorem bgConditionII_dim_one (H : Subgroup (Equiv.Perm (UnitAddTorus (Fin 1))))
    (haff : ∀ h ∈ H, IsTorusAffine h) :
    BGConditionII (linearParts H) ∧ BGConditionIII (linearParts H) := by
  have hW : (⊥ : Submodule ℚ (Fin 1 → ℚ)) ≠ ⊤ := bot_ne_top
  have hinv : ∀ A ∈ linearParts H, ∀ w ∈ (⊥ : Submodule ℚ (Fin 1 → ℚ)),
      (A.map (Int.cast : ℤ → ℚ)) *ᵥ w ∈ (⊥ : Submodule ℚ _) := by
    intro A _ w hw
    rw [Submodule.mem_bot] at hw ⊢
    rw [hw, Matrix.mulVec_zero]
  have hneg : (LinearEquiv.neg ℚ : ((Fin 1 → ℚ) ⧸ (⊥ : Submodule ℚ (Fin 1 → ℚ))) ≃ₗ[ℚ] _) *
      LinearEquiv.neg ℚ = 1 := by
    ext x; simp
  have hcl : ∀ u ∈ Subgroup.closure (factorProjection (⊥ : Submodule ℚ (Fin 1 → ℚ))
      (linearParts H)), u = 1 ∨ u = LinearEquiv.neg ℚ := by
    intro u hu
    induction hu using Subgroup.closure_induction with
    | mem u hu =>
      exact factorProjection_fin_one (fun A hA => isUnit_det_of_mem_linearParts haff hA) hu
    | one => exact Or.inl rfl
    | mul u v _ _ hu hv =>
      rcases hu with rfl | rfl <;> rcases hv with rfl | rfl
      · exact Or.inl (one_mul 1)
      · exact Or.inr (one_mul _)
      · exact Or.inr (mul_one _)
      · exact Or.inl hneg
    | inv u _ hu =>
      rcases hu with rfl | rfl
      · exact Or.inl inv_one
      · exact Or.inr (inv_eq_of_mul_eq_one_right hneg)
  haveI : Finite (Subgroup.closure (factorProjection (⊥ : Submodule ℚ (Fin 1 → ℚ))
      (linearParts H))) := by
    have hsub : ((Subgroup.closure (factorProjection (⊥ : Submodule ℚ (Fin 1 → ℚ))
        (linearParts H)) : Set (((Fin 1 → ℚ) ⧸ (⊥ : Submodule ℚ (Fin 1 → ℚ))) ≃ₗ[ℚ]
          ((Fin 1 → ℚ) ⧸ (⊥ : Submodule ℚ (Fin 1 → ℚ)))))) ⊆ {1, LinearEquiv.neg ℚ} := by
      intro u hu
      rcases hcl u (SetLike.mem_coe.mp hu) with rfl | rfl
      · exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ rfl
    exact ((Set.toFinite _).subset hsub).to_subtype
  exact ⟨⟨⊥, hW, hinv, isAmenableGroup_of_finite _⟩, ⟨⊥, hW, hinv, isVirtuallyAbelian_of_finite _⟩⟩

/-! ## Affine toroidal families -/

/-- **The uniform EGF kernel of the moves** `Φᵢ = x ↦ Aᵢx + bᵢ`: `π(x) = (1/p) ∑ᵢ δ_{Φᵢ(x)}`. -/
noncomputable def torusUniformKernel {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (b : Fin p → UnitAddTorus (Fin d)) : Kernel (UnitAddTorus (Fin d)) (UnitAddTorus (Fin d)) :=
  egfKernel (fun i => torusAffine (A i) (b i)) (fun _ _ => 1 / (p : ℝ))
    (fun i => measurable_torusAffine (A i) (b i)) fun _ => measurable_const

/-- The uniform kernel of the moves is the EGF policy with weights `αⁱ ≡ 1/p`. -/
theorem isEGFPolicy_torusUniformKernel {p : ℕ} (hp : 0 < p) (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (b : Fin p → UnitAddTorus (Fin d)) :
    IsEGFPolicy (torusUniformKernel A b) (fun i => torusAffine (A i) (b i))
      (fun _ _ => 1 / (p : ℝ)) :=
  isEGFPolicy_egfKernel _ _ _ _ (fun _ _ => by positivity) fun _ => by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    field_simp

/-- **The group generated by the moves acts ergodically iff the moves have no common non-trivial
a.e.-invariant set** (the moves and their inverses preserve `λ`). -/
theorem isGroupErgodic_torusAffineGroup_iff {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (hA : ∀ i, IsUnit (A i).det) (b : Fin p → UnitAddTorus (Fin d)) :
    IsGroupErgodic volume (torusAffineGroup A b hA) ↔
      ∀ E, MeasurableSet E → (∀ i, torusAffine (A i) (b i) ⁻¹' E =ᵐ[volume] E) →
        volume E = 0 ∨ volume Eᶜ = 0 := by
  constructor
  · intro herg E hE hinv
    refine herg E hE fun h hh => ae_invariant_of_mem_closure ?_ ?_ hh
    · rintro g ⟨i, rfl⟩
      exact ⟨measurePreserving_torusAffine (hA i) (b i),
        measurePreserving_torusAffine (Matrix.isUnit_nonsing_inv_det _ (hA i)) _⟩
    · rintro g ⟨i, rfl⟩
      exact hinv i
  · intro herg E hE hinv
    exact herg E hE fun i => hinv _ (Subgroup.subset_closure ⟨i, rfl⟩)

/-- **The uniform kernel is ergodic iff the generated group is** (`λ` is invariant for both). -/
theorem isKernelErgodic_torusUniformKernel_iff {p : ℕ} (hp : 0 < p)
    (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det)
    (b : Fin p → UnitAddTorus (Fin d)) :
    IsKernelErgodic (torusUniformKernel A b) volume ↔
      IsGroupErgodic volume (torusAffineGroup A b hA) := by
  rw [isGroupErgodic_torusAffineGroup_iff]
  constructor
  · intro hk E hE hinv
    refine hk E hE ?_
    have hall : ∀ᵐ x ∂volume, ∀ i, (torusAffine (A i) (b i) x ∈ E ↔ x ∈ E) := by
      rw [ae_all_iff]
      intro i
      filter_upwards [hinv i] with x hx
      exact Iff.of_eq hx
    have hone : (p : ℝ≥0∞) * ENNReal.ofReal (1 / (p : ℝ)) = 1 := by
      rw [ENNReal.ofReal_div_of_pos (by exact_mod_cast hp), ENNReal.ofReal_one,
        ENNReal.ofReal_natCast, one_div]
      exact ENNReal.mul_inv_cancel (by exact_mod_cast hp.ne') (ENNReal.natCast_ne_top p)
    filter_upwards [hall] with x hx
    rw [(isEGFPolicy_torusUniformKernel hp A b).apply_set x hE]
    have hi : ∀ i, E.indicator (1 : UnitAddTorus (Fin d) → ℝ≥0∞) (torusAffine (A i) (b i) x) =
        E.indicator 1 x := fun i => by
      by_cases h : x ∈ E
      · rw [Set.indicator_of_mem h, Set.indicator_of_mem ((hx i).2 h), Pi.one_apply, Pi.one_apply]
      · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem fun h' => h ((hx i).1 h')]
    simp_rw [hi]
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, ← mul_assoc, hone,
      one_mul]
  · intro herg
    exact (isKernelErgodic_egfKernel_uniform hp _ (fun i => measurable_torusAffine (A i) (b i))
      (fun i => measurePreserving_torusAffine (hA i) (b i)) herg).2

/-! ### Affine toroidal models and their families (`main.tex:288`) -/

/-- **An affine toroidal model** with `p` moves on `𝕋^d` (`main.tex:288`): a non-empty parameter
type `Θ`; for each parameter `θ`, the translation parts `bθ` of the moves (a function of the
parameter: free as in `constToroidalModel`, tied in inverse pairs, or fixed as in
`constToroidalModelAt`), a softmax head `αθ` (positive measurable weights summing to `1`) and a
scalar head `fθ` (the outflow density, clipped at `0`, of finite mass). The continuity of the
family (`main.tex:288`) is not encoded: the class is larger, and the refuting models are
continuous. -/
structure AffineToroidalModel (d p : ℕ) where
  /-- The parameter space of the model. -/
  Θ : Type
  nonempty : Nonempty Θ
  /-- The translation parts of the moves. -/
  b : Θ → Fin p → UnitAddTorus (Fin d)
  /-- The softmax head. -/
  α : Θ → Fin p → UnitAddTorus (Fin d) → ℝ
  /-- The scalar head. -/
  f : Θ → UnitAddTorus (Fin d) → ℝ
  measurable_α : ∀ θ i, Measurable (α θ i)
  α_pos : ∀ θ i s, 0 < α θ i s
  α_sum : ∀ θ s, ∑ i, α θ i s = 1
  lintegral_f_ne_top : ∀ θ, ∫⁻ s, ENNReal.ofReal (f θ s) ≠ ∞

/-- The EGF of the parameter `θ`: moves `x ↦ Aᵢx + bθᵢ`, policy `Σᵢ αθⁱ δ_{Φᵢ}`, outflow `fθ λ`. -/
noncomputable def AffineToroidalModel.flow {p : ℕ} (M : AffineToroidalModel d p)
    (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (θ : M.Θ) : GenerativeFlow (UnitAddTorus (Fin d)) where
  policy := egfKernel (fun i => torusAffine (A i) (M.b θ i)) (M.α θ)
    (fun i => measurable_torusAffine (A i) (M.b θ i)) (M.measurable_α θ)
  outflow := volume.withDensity fun s => ENNReal.ofReal (M.f θ s)
  isMarkovKernel_policy := (isEGFPolicy_egfKernel _ _ _ _ (fun i s => (M.α_pos θ i s).le)
    (M.α_sum θ)).isMarkovKernel
  isFiniteMeasure_outflow := isFiniteMeasure_withDensity (M.lintegral_f_ne_top θ)

/-- **The affine toroidal family of a model** (`main.tex:288`): the image `θ ↦ flow θ` of its
parameter space, non-empty. -/
def affineToroidalFamily {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (M : AffineToroidalModel d p) : Set (GenerativeFlow (UnitAddTorus (Fin d))) :=
  Set.range (M.flow A)

theorem affineToroidalFamily_nonempty {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (M : AffineToroidalModel d p) : (affineToroidalFamily A M).Nonempty :=
  haveI := M.nonempty
  Set.range_nonempty _

theorem isEGFPolicy_flow {p : ℕ} (M : AffineToroidalModel d p)
    (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (θ : M.Θ) :
    IsEGFPolicy (M.flow A θ).policy (fun i => torusAffine (A i) (M.b θ i)) (M.α θ) :=
  isEGFPolicy_egfKernel _ _ (fun i => measurable_torusAffine (A i) (M.b θ i)) (M.measurable_α θ)
    (fun i s => (M.α_pos θ i s).le) (M.α_sum θ)

/-- **C-31's model richness**: for the translations `b`, the family contains `(π, f λ)` for the
uniform policy `π` of the moves and every `f` of a set dense in the non-negative cone of `L²(λ)`. -/
def IsRichToroidalModel {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (b : Fin p → UnitAddTorus (Fin d)) (𝓕 : Set (GenerativeFlow (UnitAddTorus (Fin d)))) : Prop :=
  ∃ D : Set (UnitAddTorus (Fin d) → ℝ), IsDenseNonnegConeL2 volume D ∧
    ∀ f ∈ D, ∃ F ∈ 𝓕, F.policy = torusUniformKernel A b ∧
      F.outflow = volume.withDensity fun s => ENNReal.ofReal (f s)

/-- **The `L²` model** at translations `b`: `Θ = {f ∈ L²(λ) | f ≥ 0}`, uniform softmax head, scalar
head `f`. It is rich (`isRichToroidalModel_l2ToroidalModel`). -/
noncomputable def l2ToroidalModel {p : ℕ} (hp : 0 < p) (b : Fin p → UnitAddTorus (Fin d)) :
    AffineToroidalModel d p where
  Θ := {f : UnitAddTorus (Fin d) → ℝ // MemLp f 2 volume ∧ ∀ s, 0 ≤ f s}
  nonempty := ⟨⟨0, MemLp.zero, fun _ => le_rfl⟩⟩
  b _ := b
  α _ _ _ := 1 / (p : ℝ)
  f θ := θ.1
  measurable_α _ _ := measurable_const
  α_pos _ _ _ := by positivity
  α_sum _ _ := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    field_simp
  lintegral_f_ne_top θ := Markov.lintegral_ofReal_ne_top (θ.2.1.integrable one_le_two)

theorem isRichToroidalModel_l2ToroidalModel {p : ℕ} (hp : 0 < p)
    (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (b : Fin p → UnitAddTorus (Fin d)) :
    IsRichToroidalModel A b (affineToroidalFamily A (l2ToroidalModel hp b)) :=
  ⟨{f | MemLp f 2 volume ∧ ∀ s, 0 ≤ f s},
    fun g hg hgnn η hη => ⟨g, ⟨hg, hgnn⟩, hg.1, by simpa using hη⟩,
    fun f hf => ⟨(l2ToroidalModel hp b).flow A ⟨f, hf⟩, ⟨⟨f, hf⟩, rfl⟩, rfl, rfl⟩⟩

/-- **Theorem 3.5, the strongest form** (C-28 tori half, C-29, C-31): if the group generated by the
moves `x ↦ Aᵢx + bᵢ` (`det Aᵢ = ±1`) acts ergodically on `(𝕋^d, λ)` and the family contains the
uniform policy with outflows dense in the non-negative cone of `L²(λ)` (`IsRichToroidalModel`), the
family is ε-universal. No spectral gap, no aperiodicity, no inverse-stability; any family, in
particular the family `affineToroidalFamily A M` of any affine toroidal model `M` that is rich. -/
theorem universality_tori_of_ergodic {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (hA : ∀ i, IsUnit (A i).det) (b : Fin p → UnitAddTorus (Fin d))
    (herg : IsGroupErgodic volume (torusAffineGroup A b hA))
    (𝓕 : Set (GenerativeFlow (UnitAddTorus (Fin d)))) (hrich : IsRichToroidalModel A b 𝓕) :
    IsUniversalFamilyEps volume 𝓕 := by
  obtain ⟨D, hdense, hD⟩ := hrich
  -- `p ≥ 1`: the policy of a member of the family is a Markov kernel
  have hp : 0 < p := by
    obtain ⟨f, hfD, -, -⟩ := hdense 0 MemLp.zero (fun _ => le_rfl) 1 one_pos
    obtain ⟨F, -, hFπ, -⟩ := hD f hfD
    rcases Nat.eq_zero_or_pos p with h0 | h0
    · subst h0
      have h1 := (F.isMarkovKernel_policy.isProbabilityMeasure 0).measure_univ
      rw [hFπ] at h1
      simp [torusUniformKernel, egfKernel] at h1
    · exact h0
  have herg' := (isGroupErgodic_torusAffineGroup_iff A hA b).mp herg
  obtain ⟨hinv, hke⟩ := isKernelErgodic_egfKernel_uniform hp (fun i => torusAffine (A i) (b i))
    (fun i => measurable_torusAffine (A i) (b i))
    (fun i => measurePreserving_torusAffine (hA i) (b i)) herg'
  exact universality_of_ergodic_family volume 𝓕 (torusUniformKernel A b) volume hinv
    Measure.AbsolutelyContinuous.rfl Measure.AbsolutelyContinuous.rfl hke D hD hdense

/-- **Theorem 3.5 from Bekka–Guivarc'h** (`main.tex:291`, `:818–821`; C-28, C-31): under the named
`Prop` `BekkaGuivarchTheorem5 d`, if the group generated by the moves violates (ii) and the model
is rich, the family is ε-universal. The paper's condition of `main.tex:820` without its
inverse-stability. Any family, in particular `affineToroidalFamily A M` for a rich model `M`. For
`d = 1` the hypothesis `hII` is never met (`bgConditionII_dim_one`). -/
theorem universality_tori (hBG : BekkaGuivarchTheorem5 d) {p : ℕ}
    (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det)
    (b : Fin p → UnitAddTorus (Fin d))
    (hII : ¬ BGConditionII (linearParts (torusAffineGroup A b hA)))
    (𝓕 : Set (GenerativeFlow (UnitAddTorus (Fin d)))) (hrich : IsRichToroidalModel A b 𝓕) :
    IsUniversalFamilyEps volume 𝓕 := by
  have hgap : HasSpectralGap volume (torusAffineGroup A b hA) := fun hng =>
    hII ((spectral_gap_tori hBG _ (countable_torusAffineGroup A b hA)
      fun _ hh => isTorusAffine_of_mem_torusAffineGroup hh).mp (not_not_intro hng))
  exact universality_tori_of_ergodic A hA b (ergodic_of_hasSpectralGap hgap) 𝓕 hrich

/-- **Ergodicity of the generated group is necessary and sufficient** (C-28, C-29): the family
of the `L²` model (uniform policy of the moves `x ↦ Aᵢx + bᵢ`, every outflow `f λ`, `f ≥ 0` in
`L²(λ)`) is ε-universal iff the group the moves generate acts ergodically. -/
theorem universality_tori_iff {p : ℕ} (hp : 0 < p) (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (hA : ∀ i, IsUnit (A i).det) (b : Fin p → UnitAddTorus (Fin d)) :
    IsUniversalFamilyEps volume (affineToroidalFamily A (l2ToroidalModel hp b)) ↔
      IsGroupErgodic volume (torusAffineGroup A b hA) := by
  refine ⟨fun hU => ?_, fun herg => universality_tori_of_ergodic A hA b herg _
    (isRichToroidalModel_l2ToroidalModel hp A b)⟩
  haveI := (isEGFPolicy_torusUniformKernel hp A b).isMarkovKernel
  refine (isKernelErgodic_torusUniformKernel_iff hp A hA b).mp (by_contra fun herg => ?_)
  refine not_isUniversalFamilyEps_of_not_ergodic volume _ (torusUniformKernel A b) ?_ herg hU
  rintro F ⟨θ, rfl⟩
  exact ⟨rfl, withDensity_absolutelyContinuous _ _⟩

/-! ## The printed Theorem 3.5 needs the model (C-31) -/

/-- **A flow whose outflow is fixed by its policy cannot reduce the defect**: on `𝕋^d`, `d ≥ 1`, a
family all of whose members satisfy `F_out π = F_out` is not ε-universal (from `2·1_{Eᶜ} λ` to
`2·1_E λ`, `λ(E) = ½`, the defect is at least the total variation, at least `1`, in fact `2`). -/
theorem not_isUniversalFamilyEps_of_inflow_eq (hd : 0 < d)
    (𝓕 : Set (GenerativeFlow (UnitAddTorus (Fin d))))
    (h𝓕 : ∀ F ∈ 𝓕, inflow F.policy F.outflow = F.outflow) :
    ¬ IsUniversalFamilyEps volume 𝓕 := by
  intro hU
  obtain ⟨E, hE, hvolE⟩ := exists_measurableSet_volume_half hd
  have hvolEc : volume Eᶜ = ENNReal.ofReal (1 / 2) := by
    rw [prob_compl_eq_one_sub hE, hvolE, ← ENNReal.ofReal_one,
      ← ENNReal.ofReal_sub _ (by norm_num)]
    norm_num
  have htwo : (2 : ℝ≥0∞) * ENNReal.ofReal (1 / 2) = 1 := by
    rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp, ← ENNReal.ofReal_mul (by norm_num)]
    norm_num
  -- the two probability measures `2·1_E λ` and `2·1_{Eᶜ} λ`
  set μ₁ : Measure (UnitAddTorus (Fin d)) := volume.withDensity (E.indicator fun _ => 2)
  set μ₀ : Measure (UnitAddTorus (Fin d)) := volume.withDensity (Eᶜ.indicator fun _ => 2)
  have hμ₁ : μ₁ = (2 : ℝ≥0∞) • volume.restrict E := by
    show volume.withDensity _ = _
    rw [withDensity_indicator hE, withDensity_const]
  have hμ₀ : μ₀ = (2 : ℝ≥0∞) • volume.restrict Eᶜ := by
    show volume.withDensity _ = _
    rw [withDensity_indicator hE.compl, withDensity_const]
  have hP₁ : IsProbabilityMeasure μ₁ := ⟨by
    rw [hμ₁, Measure.smul_apply, Measure.restrict_apply MeasurableSet.univ, Set.univ_inter,
      hvolE, smul_eq_mul, htwo]⟩
  have hP₀ : IsProbabilityMeasure μ₀ := ⟨by
    rw [hμ₀, Measure.smul_apply, Measure.restrict_apply MeasurableSet.univ, Set.univ_inter,
      hvolEc, smul_eq_mul, htwo]⟩
  have hbdd : ∀ {S : Set (UnitAddTorus (Fin d))}, MeasurableSet S →
      ∃ C : ℝ≥0, ∀ᵐ s ∂volume, (volume.withDensity (S.indicator fun _ => (2 : ℝ≥0∞))).rnDeriv
        volume s ≤ C := fun {S} hS =>
    ⟨2, (Measure.rnDeriv_withDensity volume (measurable_const.indicator hS)).mono fun s hs => by
      rw [hs]
      by_cases h : s ∈ S <;> simp [Set.indicator_of_mem, Set.indicator_of_notMem, h]⟩
  obtain ⟨F, hF, hlt⟩ := hU μ₁ μ₀ hP₁ hP₀ (withDensity_absolutelyContinuous _ _)
    (withDensity_absolutelyContinuous _ _) (hbdd hE) (hbdd hE.compl) 1 one_pos
  have hle := tvMass_le_errors_of_inflow_eq F.policy F.outflow μ₀ μ₁ (h𝓕 F hF)
  have h1 : 1 ≤ tvMass μ₀ μ₁ := by
    have h : μ₀ ≤ (μ₀ - μ₁) + μ₁ := Measure.sub_le_iff_le_add.mp le_rfl
    have h1 := h Eᶜ
    rw [Measure.add_apply] at h1
    have hT : μ₀ Eᶜ = 1 := by
      rw [hμ₀, Measure.smul_apply, Measure.restrict_apply hE.compl, Set.inter_self, hvolEc,
        smul_eq_mul, htwo]
    have hF : μ₁ Eᶜ = 0 := by
      rw [hμ₁, Measure.smul_apply, Measure.restrict_apply hE.compl, Set.compl_inter_self,
        measure_empty, smul_zero]
    calc (1 : ℝ≥0∞) = μ₀ Eᶜ := hT.symm
      _ ≤ (μ₀ - μ₁) Eᶜ + μ₁ Eᶜ := h1
      _ = (μ₀ - μ₁) Eᶜ := by rw [hF, add_zero]
      _ ≤ (μ₀ - μ₁) Set.univ := measure_mono (Set.subset_univ _)
      _ ≤ tvMass μ₀ μ₁ := le_self_add
  exact absurd (h1.trans hle) (not_le.2 hlt)

/-- **A model whose heads ignore the state is never ε-universal** (C-31): for `d ≥ 1`, linear
parts with `det = ±1` and any affine toroidal model whose softmax head `αθ` and scalar head `fθ`
are constant in the state (translations arbitrary, varying with `θ`), every member leaves `λ`
invariant and has `F_out = c λ`, so `F_out π = F_out`. -/
theorem not_isUniversalFamilyEps_of_constantHeads (hd : 0 < d) {p : ℕ}
    (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det)
    (M : AffineToroidalModel d p) (hα : ∀ θ i s s', M.α θ i s = M.α θ i s')
    (hf : ∀ θ s s', M.f θ s = M.f θ s') :
    ¬ IsUniversalFamilyEps volume (affineToroidalFamily A M) := by
  refine not_isUniversalFamilyEps_of_inflow_eq hd _ ?_
  rintro F ⟨θ, rfl⟩
  have hpol := isEGFPolicy_flow M A θ
  have hmp : ∀ i, MeasurePreserving (torusAffine (A i) (M.b θ i)) volume volume :=
    fun i => measurePreserving_torusAffine (hA i) _
  -- `λ` is invariant under the policy
  have hinv : (volume : Measure (UnitAddTorus (Fin d))).bind (M.flow A θ).policy = volume := by
    rw [hpol.bind_eq_sum_map volume]
    have hc : ∀ i, (volume.withDensity fun s => ENNReal.ofReal (M.α θ i s)).map
        (torusAffine (A i) (M.b θ i)) = ENNReal.ofReal (M.α θ i 0) • volume := by
      intro i
      rw [show (fun s => ENNReal.ofReal (M.α θ i s)) = fun _ => ENNReal.ofReal (M.α θ i 0) from
        funext fun s => by rw [hα θ i s 0], withDensity_const, Measure.map_smul, (hmp i).map_eq]
    simp_rw [hc]
    rw [← Finset.sum_smul, ← ENNReal.ofReal_sum_of_nonneg fun i _ => (M.α_pos θ i 0).le,
      M.α_sum θ 0, ENNReal.ofReal_one, one_smul]
  have hout : (M.flow A θ).outflow = ENNReal.ofReal (M.f θ 0) • volume := by
    show volume.withDensity _ = _
    rw [show (fun s => ENNReal.ofReal (M.f θ s)) = fun _ => ENNReal.ofReal (M.f θ 0) from
      funext fun s => by rw [hf θ s 0], withDensity_const]
  rw [inflow, hout, Measure.bind_smul, hinv]

/-- **The constant model at translations `b`**: `Θ = ℝ≥0` (the outflow level `c`), translations
fixed at `b`, uniform softmax head, constant scalar head `c`. -/
noncomputable def constToroidalModelAt {p : ℕ} (hp : 0 < p) (b : Fin p → UnitAddTorus (Fin d)) :
    AffineToroidalModel d p where
  Θ := ℝ≥0
  nonempty := ⟨0⟩
  b _ := b
  α _ _ _ := 1 / (p : ℝ)
  f c _ := c
  measurable_α _ _ := measurable_const
  α_pos _ _ _ := by positivity
  α_sum _ _ := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    field_simp
  lintegral_f_ne_top _ := by simp [lintegral_const]

/-- **The constant model with free translations** (`main.tex:288` read literally: the translation
parts are parameters): `Θ = (Fin p → 𝕋^d) × ℝ≥0`, uniform softmax head, constant scalar head. -/
noncomputable def constToroidalModel {p : ℕ} (hp : 0 < p) : AffineToroidalModel d p where
  Θ := (Fin p → UnitAddTorus (Fin d)) × ℝ≥0
  nonempty := ⟨(0, 0)⟩
  b θ := θ.1
  α _ _ _ := 1 / (p : ℝ)
  f θ _ := θ.2
  measurable_α _ _ := measurable_const
  α_pos _ _ _ := by positivity
  α_sum _ _ := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    field_simp
  lintegral_f_ne_top _ := by simp [lintegral_const]

/-- **The printed Theorem 3.5 is false for every choice of linear parts** (C-31): for `d ≥ 1`,
`p ≥ 1` and `det Aᵢ = ±1`, the affine toroidal family of the constant model is not ε-universal,
whether the translations are free parameters (`main.tex:288`) or fixed at any `b` (the moves of
`main.tex:291`). No satisfiable assumption on the `Φᵢ` alone makes the theorem true (at `d = 1`
the unsatisfiable one of `main.tex:820` makes it vacuously true, `universalityToriPrinted_one`). -/
theorem not_isUniversalFamilyEps_constOutflow (hd : 0 < d) {p : ℕ} (hp : 0 < p)
    (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det) :
    ¬ IsUniversalFamilyEps volume (affineToroidalFamily A (constToroidalModel (d := d) hp)) ∧
      ∀ b : Fin p → UnitAddTorus (Fin d),
        ¬ IsUniversalFamilyEps volume (affineToroidalFamily A (constToroidalModelAt hp b)) :=
  ⟨not_isUniversalFamilyEps_of_constantHeads hd A hA _ (fun _ _ _ _ => rfl) fun _ _ _ => rfl,
    fun _ => not_isUniversalFamilyEps_of_constantHeads hd A hA _ (fun _ _ _ _ => rfl)
      fun _ _ _ => rfl⟩

/-- **The technical assumption of `main.tex:820`** for moves `x ↦ Aᵢx + bᵢ`: the set of moves is
stable under inverse and the group they generate violates (ii). -/
def IsPrintedToriCondition {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (b : Fin p → UnitAddTorus (Fin d)) (hA : ∀ i, IsUnit (A i).det) : Prop :=
  (∀ i, ∃ j, torusAffineEquiv (A j) (b j) (hA j) = (torusAffineEquiv (A i) (b i) (hA i))⁻¹) ∧
    ¬ BGConditionII (linearParts (torusAffineGroup A b hA))

/-- **Theorem 3.5 as printed** (`main.tex:288–291`), with the technical assumption the appendix
states (`main.tex:820`): for linear parts `Aᵢ` (`det = ±1`) and every affine toroidal model whose
moves meet that assumption at every parameter, the family of the model is universal (here in the
ε-form, weaker than the exact Definition 3.2, so its refutation is the stronger). Kept as a `Prop`
beside its refutation (`not_universalityToriPrinted`). Disclosed: `IsUnit det` admits `GL_d(ℤ)`
moves where the paper has `SL_d(ℤ)`, a strengthening of this refuted `Prop` (moves meeting
`main.tex:820` exist in `SL_d(ℤ)` for `d ≥ 2`, not in Lean); with all translations free over the
torus and d ≥ 1, `main.tex:820` cannot hold at every parameter (vacuity in that reading), so the refutation
ties them; a one-point model refutes it too, and the informative statements are
`not_isUniversalFamilyEps_of_constantHeads` and `not_isUniversalFamilyEps_constOutflow`. -/
def UniversalityToriPrinted (d : ℕ) : Prop :=
  ∀ (p : ℕ) (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det)
    (M : AffineToroidalModel d p), (∀ θ, IsPrintedToriCondition A (M.b θ) hA) →
      IsUniversalFamilyEps volume (affineToroidalFamily A M)

/-- **The printed Theorem 3.5 is false as soon as its technical assumption is satisfiable**
(C-31): for moves meeting `main.tex:820`, the constant model at these translations (a non-empty
family, every member with these very moves) refutes it. Whether some moves meet the assumption is
not proved here (it needs a group of linear parts with no amenable factor projection, e.g.
`SL₂(ℤ)`, through a free subgroup). -/
theorem not_universalityToriPrinted (hd : 0 < d)
    (hex : ∃ (p : ℕ) (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det)
      (b : Fin p → UnitAddTorus (Fin d)), IsPrintedToriCondition A b hA) :
    ¬ UniversalityToriPrinted d := by
  intro hP
  obtain ⟨p, A, hA, b, hcond⟩ := hex
  rcases Nat.eq_zero_or_pos p with hp | hp
  · -- `p = 0`: the generated group is trivial and satisfies (ii) (`bgConditionII_bot`)
    subst hp
    apply hcond.2
    have hbot : torusAffineGroup A b hA = ⊥ := by
      rw [torusAffineGroup, Set.range_eq_empty, Subgroup.closure_empty]
    rw [hbot]
    exact (bgConditionII_bot hd).1
  · exact (not_isUniversalFamilyEps_constOutflow hd hp A hA).2 b
      (hP p A hA (constToroidalModelAt hp b) fun _ => hcond)

/-- **On `𝕋¹` the printed Theorem 3.5 holds vacuously** (C-28 (b)): no group of affine maps of the
circle violates (ii) (`bgConditionII_dim_one`), so its technical assumption is never met and the
theorem says nothing in dimension `1`, against "in any dimension" (`main.tex:293`). -/
theorem universalityToriPrinted_one : UniversalityToriPrinted 1 := by
  intro p A hA M hcond
  obtain ⟨θ⟩ := M.nonempty
  exact absurd ((bgConditionII_dim_one _ fun _ hh =>
    isTorusAffine_of_mem_torusAffineGroup hh).1) (hcond θ).2

end EGF
