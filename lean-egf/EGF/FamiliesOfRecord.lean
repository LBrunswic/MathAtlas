namespace EGF

open MeasureTheory ProbabilityTheory Filter UnitAddTorus
open scoped ENNReal NNReal Topology Matrix

variable {d : ℕ}

/-! ## Translations of the torus and their order -/

/-- The powers of a translation are translations: `(x ↦ x + c)ⁿ = (x ↦ x + n • c)`. -/
theorem torusAffine_one_pow {h : Equiv.Perm (UnitAddTorus (Fin d))} {c : UnitAddTorus (Fin d)}
    (hc : ⇑h = torusAffine 1 c) (n : ℕ) : ⇑(h ^ n) = torusAffine 1 (n • c) := by
  induction n with
  | zero => funext x; simp [torusAffine_eq, torusLin_one]
  | succ n ih =>
    rw [pow_succ, Equiv.Perm.coe_mul, ih, hc]
    funext x
    simp only [Function.comp_apply, torusAffine_eq, torusLin_one, succ_nsmul]
    abel

/-- A translation is the identity iff its translation part vanishes. -/
theorem torusAffine_one_eq_id_iff (c : UnitAddTorus (Fin d)) :
    torusAffine 1 c = id ↔ c = 0 := by
  constructor
  · intro h
    have := congrFun h 0
    simpa [torusAffine_eq, torusLin_one] using this
  · rintro rfl; exact torusAffine_one_zero

/-- **A translation of the torus has the order of its translation part**: for `⇑h = (x ↦ x + c)`,
`orderOf h = addOrderOf c`. So "a translation of infinite order" is `orderOf h = 0`, equivalently
`addOrderOf c = 0`. -/
theorem orderOf_eq_addOrderOf_of_translation {h : Equiv.Perm (UnitAddTorus (Fin d))}
    {c : UnitAddTorus (Fin d)} (hc : ⇑h = torusAffine 1 c) : orderOf h = addOrderOf c := by
  rw [← orderOf_ofAdd_eq_addOrderOf, orderOf_eq_orderOf_iff]
  intro n
  rw [← ofAdd_nsmul, ofAdd_eq_one, ← torusAffine_one_eq_id_iff, ← torusAffine_one_pow hc n]
  constructor
  · intro h1; rw [h1]; rfl
  · intro h1; exact Equiv.ext (congrFun h1)

/-- On `𝕋¹ = (ℝ/ℤ)^{Fin 1}` the order of a point is the order of its coordinate. -/
theorem addOrderOf_unitAddTorus_one (c : UnitAddTorus (Fin 1)) :
    addOrderOf c = addOrderOf (c 0) := by
  rw [← orderOf_ofAdd_eq_addOrderOf, ← orderOf_ofAdd_eq_addOrderOf, orderOf_eq_orderOf_iff]
  intro n
  rw [← ofAdd_nsmul, ← ofAdd_nsmul, ofAdd_eq_one, ofAdd_eq_one]
  constructor
  · intro h; have := congrFun h 0; simpa using this
  · intro h; funext i; rw [Subsingleton.elim i 0]; simpa using h

/-! ## Theorem 3.5: the sufficient conditions for ergodicity -/

/-- **Theorem 3.5's `𝕋¹` clause in its element form** (AUDIT-1 of T-egf-tori-minimal): if the group
generated by the moves contains a translation `x ↦ x + c` with `c` of infinite order, a rich model
gives an ε-universal family. -/
theorem universality_tori_one_of_mem {p : ℕ} {A : Fin p → Matrix (Fin 1) (Fin 1) ℤ}
    (hA : ∀ i, IsUnit (A i).det) (b : Fin p → UnitAddTorus (Fin 1))
    {h : Equiv.Perm (UnitAddTorus (Fin 1))} (hh : h ∈ torusAffineGroup A b hA)
    {c : UnitAddTorus (Fin 1)} (hc : ⇑h = torusAffine 1 c) (hord : addOrderOf (c 0) = 0)
    (𝓕 : Set (GenerativeFlow (UnitAddTorus (Fin 1)))) (hrich : IsRichToroidalModel A b 𝓕) :
    IsUniversalFamilyEps volume 𝓕 := by
  have herg : Ergodic ⇑h volume := by
    rw [hc]; exact ergodic_torusAffine_one_dim_one hord
  exact universality_tori_of_ergodic A hA b (isGroupErgodic_of_ergodic_mem hh herg) 𝓕 hrich

/-- **The Bekka–Guivarc'h clause through the cited theorem** (the route of `EGF.universality_tori`):
under the named `Prop` `BekkaGuivarchTheorem5 d`, a group of moves violating (ii) has a spectral
gap, hence acts ergodically. Superseded by `isGroupErgodic_torus_of_not_bgConditionII`, which needs
no named `Prop`. -/
theorem isGroupErgodic_torus_of_bekkaGuivarch (hBG : BekkaGuivarchTheorem5 d) {p : ℕ}
    (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det)
    (b : Fin p → UnitAddTorus (Fin d))
    (hII : ¬ BGConditionII (linearParts (torusAffineGroup A b hA))) :
    IsGroupErgodic volume (torusAffineGroup A b hA) :=
  ergodic_of_hasSpectralGap fun hng =>
    hII ((spectral_gap_tori hBG _ (countable_torusAffineGroup A b hA)
      fun _ hh => isTorusAffine_of_mem_torusAffineGroup hh).mp (not_not_intro hng))

/-- **No factor torus with amenable projection ⇒ ergodic** (the clause of Theorem 3.5 citing
Theorem 5 of Bekka–Guivarc'h, in the direction it needs, proved): a group `H` of affine maps of
`𝕋^d` whose linear parts violate (ii) acts ergodically. If `E` were a non-trivial invariant set,
its indicator would have a frequency `k ≠ 0` with `1̂_E(k) ≠ 0`; the moduli of the coefficients are
constant along `k ↦ Bᵀk`, `B ∈ p_a(H)`, so this orbit is finite (Parseval), and its annihilator
`W ≠ ℚ^d` is invariant with a projection of `p_a(H)` determined by a permutation of the orbit:
a finite, hence amenable, group, and (ii) holds. -/
theorem isGroupErgodic_of_not_bgConditionII {H : Subgroup (Equiv.Perm (UnitAddTorus (Fin d)))}
    (haff : ∀ h ∈ H, IsTorusAffine h) (hII : ¬ BGConditionII (linearParts H)) :
    IsGroupErgodic volume H := by
  intro E hE hinv
  by_contra hcon
  push Not at hcon
  apply hII
  -- the indicator of `E` is invariant
  set g : UnitAddTorus (Fin d) → ℂ := E.indicator fun _ => 1 with hgdef
  have hg1 : ∀ x ∈ E, g x = 1 := fun x hx => by rw [hgdef, Set.indicator_of_mem hx]
  have hg0 : ∀ x ∉ E, g x = 0 := fun x hx => by rw [hgdef, Set.indicator_of_notMem hx]
  have hg : MemLp g 2 volume := (memLp_const (1 : ℂ)).indicator hE
  have hginv : ∀ h ∈ H, g ∘ ⇑h =ᵐ[volume] g := by
    intro h hh
    have : g ∘ ⇑h = (⇑h ⁻¹' E).indicator fun _ => 1 := by
      funext x
      by_cases hx : h x ∈ E
      · rw [Function.comp_apply, hg1 _ hx, Set.indicator_of_mem (Set.mem_preimage.2 hx)]
      · rw [Function.comp_apply, hg0 _ hx,
          Set.indicator_of_notMem (show x ∉ ⇑h ⁻¹' E from hx)]
    rw [this, hgdef]
    exact indicator_ae_eq_of_ae_eq_set (hinv h hh)
  -- a non-zero frequency
  obtain ⟨k, hk0, hk⟩ : ∃ k, k ≠ 0 ∧ mFourierCoeff g k ≠ 0 := by
    by_contra hall
    push Not at hall
    have hconst := ae_eq_const_of_mFourierCoeff_eq_zero hg hall
    by_cases hc1 : mFourierCoeff g 0 = 1
    · apply hcon.2
      rw [measure_eq_zero_iff_ae_notMem]
      filter_upwards [hconst] with x hx hxc
      rw [hg0 x hxc] at hx
      exact zero_ne_one (hx.trans hc1)
    · apply hcon.1
      rw [measure_eq_zero_iff_ae_notMem]
      filter_upwards [hconst] with x hx hxE
      rw [hg1 x hxE] at hx
      exact hc1 hx.symm
  -- its orbit under the transposed linear parts is finite
  set L := linearParts H with hLdef
  set O : Set (Fin d → ℤ) := {k' | ∃ B ∈ L, k' = Bᵀ *ᵥ k} with hOdef
  have hnorm : ∀ k' ∈ O, ‖mFourierCoeff g k'‖ = ‖mFourierCoeff g k‖ := by
    rintro _ ⟨B, ⟨h, hh, c, hc⟩, rfl⟩
    have hBdet := isUnit_det_of_mem_linearParts haff ⟨h, hh, c, hc⟩
    exact norm_mFourierCoeff_eq_of_invariant hBdet c (hg.integrable one_le_two)
      (by rw [← hc]; exact hginv h hh) k
  have hOfin : O.Finite := by
    have hsum := (summable_sq_mFourierCoeff hg).tendsto_cofinite_zero
    have hpos : 0 < ‖mFourierCoeff g k‖ ^ 2 := by positivity
    have hev := hsum.eventually (gt_mem_nhds hpos)
    rw [Filter.eventually_cofinite] at hev
    refine hev.subset fun k' hk' => ?_
    simp only [Set.mem_setOf_eq, not_lt]
    rw [hnorm k' hk']
  have hkO : k ∈ O := ⟨1, one_mem_linearParts H, by rw [Matrix.transpose_one, Matrix.one_mulVec]⟩
  have hOinv : ∀ A ∈ L, ∀ k' ∈ O, Aᵀ *ᵥ k' ∈ O := by
    rintro A hA _ ⟨B, hB, rfl⟩
    exact ⟨B * A, mul_mem_linearParts hB hA, by rw [Matrix.mulVec_mulVec, Matrix.transpose_mul]⟩
  -- the annihilator of the orbit
  let castV : (Fin d → ℤ) → (Fin d → ℚ) := fun v i => (v i : ℚ)
  have hcast : ∀ (A : Matrix (Fin d) (Fin d) ℤ) (k' : Fin d → ℤ) (v : Fin d → ℚ),
      castV k' ⬝ᵥ ((A.map (Int.cast : ℤ → ℚ)) *ᵥ v) = castV (Aᵀ *ᵥ k') ⬝ᵥ v := by
    intro A k' v
    simp only [castV, dotProduct, Matrix.mulVec, Matrix.transpose_apply, Matrix.map_apply]
    push_cast
    simp only [Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
  let W : Submodule ℚ (Fin d → ℚ) :=
    { carrier := {v | ∀ k' ∈ O, castV k' ⬝ᵥ v = 0}
      add_mem' := fun {a b} ha hb k' hk' => by
        rw [dotProduct_add, ha k' hk', hb k' hk', add_zero]
      zero_mem' := fun k' _ => dotProduct_zero _
      smul_mem' := fun c v hv k' hk' => by
        rw [dotProduct_smul, hv k' hk', smul_zero] }
  have hmemW : ∀ v, v ∈ W ↔ ∀ k' ∈ O, castV k' ⬝ᵥ v = 0 := fun v => Iff.rfl
  have hW : W ≠ ⊤ := by
    intro htop
    have h0 := (hmemW (castV k)).1 (htop ▸ Submodule.mem_top) k hkO
    rw [dotProduct_self_eq_zero] at h0
    apply hk0
    funext i
    have := congrFun h0 i
    simpa [castV] using this
  have hWinv : ∀ A ∈ L, ∀ w ∈ W, (A.map (Int.cast : ℤ → ℚ)) *ᵥ w ∈ W := by
    intro A hA w hw
    rw [hmemW] at hw ⊢
    intro k' hk'
    rw [hcast]
    exact hw _ (hOinv A hA k' hk')
  refine ⟨W, hW, hWinv, ?_⟩
  -- the projection of the linear parts on `ℚ^d/W` is finite: a map of the orbit determines it
  haveI : Finite O := hOfin.to_subtype
  have hsel : ∀ u : Subgroup.closure (factorProjection W L), ∃ A, A ∈ L ∧
      ∀ v, (u : ((Fin d → ℚ) ⧸ W) ≃ₗ[ℚ] ((Fin d → ℚ) ⧸ W)) (W.mkQ v) =
        W.mkQ ((A.map (Int.cast : ℤ → ℚ)) *ᵥ v) := by
    intro u
    have hu := (mem_closure_factorProjection_iff haff
      (u : ((Fin d → ℚ) ⧸ W) ≃ₗ[ℚ] ((Fin d → ℚ) ⧸ W))).1 u.2
    obtain ⟨A, hA, hAu⟩ := hu
    exact ⟨A, hA, hAu⟩
  choose Asel hAselL hAsel using hsel
  let φ : Subgroup.closure (factorProjection W L) → (O → O) :=
    fun u k' => ⟨(Asel u)ᵀ *ᵥ k'.1, hOinv _ (hAselL u) k'.1 k'.2⟩
  have hφ : Function.Injective φ := by
    intro u u' huu'
    apply Subtype.ext
    apply LinearEquiv.ext
    intro q
    obtain ⟨v, rfl⟩ := W.mkQ_surjective q
    rw [hAsel u, hAsel u', Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq,
      hmemW]
    intro k' hk'
    have hk := congrArg Subtype.val (congrFun huu' ⟨k', hk'⟩)
    simp only [φ] at hk
    rw [dotProduct_sub, hcast, hcast, hk, sub_self]
  haveI : Finite (Subgroup.closure (factorProjection W L)) := Finite.of_injective φ hφ
  exact isAmenableGroup_of_finite _

/-- **Theorem 3.5, first sufficient condition** (no named `Prop`): the group of the moves has no
non-trivial invariant factor torus on which its linear part projects to an amenable group. -/
theorem isGroupErgodic_torus_of_not_bgConditionII {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (hA : ∀ i, IsUnit (A i).det) (b : Fin p → UnitAddTorus (Fin d))
    (hII : ¬ BGConditionII (linearParts (torusAffineGroup A b hA))) :
    IsGroupErgodic volume (torusAffineGroup A b hA) :=
  isGroupErgodic_of_not_bgConditionII (fun _ hh => isTorusAffine_of_mem_torusAffineGroup hh) hII

/-- **`EGF.universality_tori` without its named `Prop`** (C-28): if the group of the moves violates
(ii) of Bekka–Guivarc'h's Theorem 5 and the model is rich, the family is ε-universal. The hypothesis
`BekkaGuivarchTheorem5 d` of `EGF.universality_tori` is not needed. -/
theorem universality_tori_of_not_bgConditionII {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (hA : ∀ i, IsUnit (A i).det) (b : Fin p → UnitAddTorus (Fin d))
    (hII : ¬ BGConditionII (linearParts (torusAffineGroup A b hA)))
    (𝓕 : Set (GenerativeFlow (UnitAddTorus (Fin d)))) (hrich : IsRichToroidalModel A b 𝓕) :
    IsUniversalFamilyEps volume 𝓕 :=
  universality_tori_of_ergodic A hA b (isGroupErgodic_torus_of_not_bgConditionII A hA b hII) 𝓕
    hrich

/-- **Theorem 3.5, second sufficient condition**: the group of the moves contains an affine map
whose linear part has no periodic integer vector. -/
theorem isGroupErgodic_torus_of_noPeriodic {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (hA : ∀ i, IsUnit (A i).det) (b : Fin p → UnitAddTorus (Fin d))
    {h : Equiv.Perm (UnitAddTorus (Fin d))} (hh : h ∈ torusAffineGroup A b hA)
    {B : Matrix (Fin d) (Fin d) ℤ} {c : UnitAddTorus (Fin d)} (hc : ⇑h = torusAffine B c)
    (hper : NoPeriodicVector B) : IsGroupErgodic volume (torusAffineGroup A b hA) := by
  have hBdet : IsUnit B.det :=
    isUnit_det_of_mem_linearParts (fun _ hh => isTorusAffine_of_mem_torusAffineGroup hh)
      ⟨h, hh, c, hc⟩
  have herg : Ergodic ⇑h volume := by
    rw [hc]; exact ergodic_torusAffine_of_noPeriodic hBdet hper c
  exact isGroupErgodic_of_ergodic_mem hh herg

/-- **Theorem 3.5, third sufficient condition**: on `𝕋¹`, the group of the moves contains a
translation of infinite order. -/
theorem isGroupErgodic_torus_one_of_translation {p : ℕ} {A : Fin p → Matrix (Fin 1) (Fin 1) ℤ}
    (hA : ∀ i, IsUnit (A i).det) (b : Fin p → UnitAddTorus (Fin 1))
    {h : Equiv.Perm (UnitAddTorus (Fin 1))} (hh : h ∈ torusAffineGroup A b hA)
    {c : UnitAddTorus (Fin 1)} (hc : ⇑h = torusAffine 1 c) (hord : orderOf h = 0) :
    IsGroupErgodic volume (torusAffineGroup A b hA) := by
  have hc0 : addOrderOf (c 0) = 0 := by
    rw [← addOrderOf_unitAddTorus_one, ← orderOf_eq_addOrderOf_of_translation hc, hord]
  have herg : Ergodic ⇑h volume := by
    rw [hc]; exact ergodic_torusAffine_one_dim_one hc0
  exact isGroupErgodic_of_ergodic_mem hh herg

/-- `T(STS⁻¹)⁻¹ = [[2, 1], [1, 1]]`, the matrix identity of the e.g. of Theorem 3.5 as printed in
v2 (it is the commutator `T S T⁻¹ S⁻¹`, `EGF.matT_mul_matS_mul_inv`). -/
theorem matT_mul_inv_conj : matT * (matS * matT * matS⁻¹)⁻¹ = catMat := by
  have h1 : matS * matT * matS⁻¹ = !![1, 0; -1, 1] := by
    rw [matS_inv]; simp [matS, matT]
  have h2 : (!![1, 0; -1, 1] : Matrix (Fin 2) (Fin 2) ℤ)⁻¹ = !![1, 0; 1, 1] :=
    Matrix.inv_eq_right_inv (by simp [Matrix.one_fin_two])
  rw [h1, h2]
  simp [matT, catMat]

/-- **The e.g. of Theorem 3.5**: for the minimal four moves (linear parts `S, S⁻¹, T, T⁻¹`) and
every choice of their translations, the element `Φ_T (Φ_S Φ_T Φ_S⁻¹)⁻¹` of the group they generate
is affine with linear part `T(STS⁻¹)⁻¹ = [[2, 1], [1, 1]]`, which has no periodic integer
vector. -/
theorem minimalMoves_example_of_record (b : Fin 4 → UnitAddTorus (Fin 2)) :
    let ΦS := torusAffineEquiv (minimalMoves 0) (b 0) (isUnit_det_minimalMoves 0)
    let ΦT := torusAffineEquiv (minimalMoves 2) (b 2) (isUnit_det_minimalMoves 2)
    ΦT * (ΦS * ΦT * ΦS⁻¹)⁻¹ ∈ torusAffineGroup minimalMoves b isUnit_det_minimalMoves ∧
      (∃ c, ⇑(ΦT * (ΦS * ΦT * ΦS⁻¹)⁻¹) = torusAffine (matT * (matS * matT * matS⁻¹)⁻¹) c) ∧
      matT * (matS * matT * matS⁻¹)⁻¹ = !![2, 1; 1, 1] ∧
      NoPeriodicVector (matT * (matS * matT * matS⁻¹)⁻¹) := by
  intro ΦS ΦT
  have hgroup : ΦT * (ΦS * ΦT * ΦS⁻¹)⁻¹ = ΦT * ΦS * ΦT⁻¹ * ΦS⁻¹ := by group
  obtain ⟨hmem, c, hc⟩ := mem_torusAffineGroup_commutator minimalMoves isUnit_det_minimalMoves b
    (i := 0) (j := 2) rfl rfl
  refine ⟨hgroup ▸ hmem, ⟨c, ?_⟩, by rw [matT_mul_inv_conj]; rfl, ?_⟩
  · rw [hgroup, matT_mul_inv_conj]; exact hc
  · rw [matT_mul_inv_conj]; exact noPeriodicVector_catMat

/-- The group of the minimal four moves acts ergodically, for every choice of the translations. -/
theorem isGroupErgodic_minimalMoves (b : Fin 4 → UnitAddTorus (Fin 2)) :
    IsGroupErgodic volume (torusAffineGroup minimalMoves b isUnit_det_minimalMoves) := by
  obtain ⟨hmem, c, hc⟩ := mem_torusAffineGroup_commutator minimalMoves isUnit_det_minimalMoves b
    (i := 0) (j := 2) rfl rfl
  exact isGroupErgodic_torus_of_noPeriodic _ _ b hmem hc noPeriodicVector_catMat

/-- **The sufficient conditions of Theorem 3.5 in one statement** (C-28): the group of the moves
acts ergodically when (1) it violates (ii) of Bekka–Guivarc'h's Theorem 5, (2) it contains an
affine map whose linear part has no periodic integer vector, or (3) `d = 1` and it contains a
translation of infinite order. No named `Prop`. -/
theorem isGroupErgodic_torus_of_conditions {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (hA : ∀ i, IsUnit (A i).det) (b : Fin p → UnitAddTorus (Fin d)) :
    (¬ BGConditionII (linearParts (torusAffineGroup A b hA)) →
        IsGroupErgodic volume (torusAffineGroup A b hA)) ∧
      (∀ h ∈ torusAffineGroup A b hA, ∀ (B : Matrix (Fin d) (Fin d) ℤ) (c : UnitAddTorus (Fin d)),
        ⇑h = torusAffine B c → NoPeriodicVector B →
          IsGroupErgodic volume (torusAffineGroup A b hA)) ∧
      (d = 1 → ∀ h ∈ torusAffineGroup A b hA, ∀ c : UnitAddTorus (Fin d),
        ⇑h = torusAffine 1 c → orderOf h = 0 →
          IsGroupErgodic volume (torusAffineGroup A b hA)) := by
  refine ⟨isGroupErgodic_torus_of_not_bgConditionII A hA b,
    fun h hh B c hc hper => isGroupErgodic_torus_of_noPeriodic A hA b hh hc hper, fun hd => ?_⟩
  subst hd
  exact fun h hh c hc hord => isGroupErgodic_torus_one_of_translation hA b hh hc hord

/-! ## Theorem 3.5: the main clause -/

/-- A rich family has `p ≥ 1` moves: the policy of a member is a Markov kernel. -/
theorem IsRichToroidalModel.pos {p : ℕ} {A : Fin p → Matrix (Fin d) (Fin d) ℤ}
    {b : Fin p → UnitAddTorus (Fin d)} {𝓕 : Set (GenerativeFlow (UnitAddTorus (Fin d)))}
    (hrich : IsRichToroidalModel A b 𝓕) : 0 < p := by
  obtain ⟨D, hdense, hD⟩ := hrich
  obtain ⟨f, hfD, -, -⟩ := hdense 0 MemLp.zero (fun _ => le_rfl) 1 one_pos
  obtain ⟨F, -, hFπ, -⟩ := hD f hfD
  rcases Nat.eq_zero_or_pos p with h0 | h0
  · subst h0
    have h1 := (F.isMarkovKernel_policy.isProbabilityMeasure 0).measure_univ
    rw [hFπ] at h1
    simp [torusUniformKernel, egfKernel] at h1
  · exact h0

/-- **"Its model realizes the uniform policy and a dense set of outflows" implies richness**: if for
every `f` of a set `D` dense in the non-negative cone of `L²(λ)` some parameter `θ` has translation
parts `b`, softmax head `1/p` and scalar head `f`, the family of the model is rich at `b`. -/
theorem isRichToroidalModel_of_realizes {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (M : AffineToroidalModel d p) (b : Fin p → UnitAddTorus (Fin d))
    (D : Set (UnitAddTorus (Fin d) → ℝ)) (hD : IsDenseNonnegConeL2 volume D)
    (hreal : ∀ f ∈ D, ∃ θ, M.b θ = b ∧ (∀ i s, M.α θ i s = 1 / (p : ℝ)) ∧ M.f θ = f) :
    IsRichToroidalModel A b (affineToroidalFamily A M) := by
  refine ⟨D, hD, fun f hf => ?_⟩
  obtain ⟨θ, hb, hα, hfθ⟩ := hreal f hf
  refine ⟨M.flow A θ, ⟨θ, rfl⟩, ?_, ?_⟩
  · ext s : 1
    show ∑ i, ENNReal.ofReal (M.α θ i s) • Measure.dirac (torusAffine (A i) (M.b θ i) s) =
      ∑ i, ENNReal.ofReal (1 / (p : ℝ)) • Measure.dirac (torusAffine (A i) (b i) s)
    simp only [hb, hα]
  · show volume.withDensity (fun s => ENNReal.ofReal (M.f θ s)) = _
    rw [hfθ]

/-- **Theorem 3.5's main clause, of record** (C-28, C-31, C-54): if the family contains the uniform
policy of the moves `x ↦ Aᵢx + bᵢ` with outflows dense in the non-negative cone of `L²(λ)` and the
group these moves generate acts ergodically, then the family is ε-universal, it contains EGFs of
these moves, and every member whose policy is `∑ᵢ αⁱ δ_{Φᵢ}` for these moves is an EGF. -/
theorem universality_tori_of_record {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (hA : ∀ i, IsUnit (A i).det) (b : Fin p → UnitAddTorus (Fin d))
    (𝓕 : Set (GenerativeFlow (UnitAddTorus (Fin d)))) (hrich : IsRichToroidalModel A b 𝓕)
    (herg : IsGroupErgodic volume (torusAffineGroup A b hA)) :
    IsUniversalFamilyEps volume 𝓕 ∧
      (∃ F ∈ 𝓕, IsEGFErgodic volume F (fun i => torusAffineME (A i) (b i) (hA i))
        (fun _ _ => 1 / (p : ℝ))) ∧
      ∀ F ∈ 𝓕, ∀ α : Fin p → UnitAddTorus (Fin d) → ℝ,
        IsEGFPolicy F.policy (fun i => torusAffine (A i) (b i)) α →
          IsEGFErgodic volume F (fun i => torusAffineME (A i) (b i) (hA i)) α := by
  refine ⟨universality_tori_of_ergodic A hA b herg 𝓕 hrich, ?_,
    fun F _ α hα => ⟨hα, fun _ => nonsingular_torusAffineME _ _ _, herg⟩⟩
  have hp := hrich.pos
  obtain ⟨D, hdense, hD⟩ := hrich
  obtain ⟨f, hfD, -, -⟩ := hdense 0 MemLp.zero (fun _ => le_rfl) 1 one_pos
  obtain ⟨F, hF, hFπ, -⟩ := hD f hfD
  exact ⟨F, hF, (isEGFErgodic_torus_iff hp A hA b F hFπ).2 herg⟩

/-- **Theorem 3.5's main clause for the family of a model** (C-54): if the family of an affine
toroidal model is rich at the translation parts `b` and the group of the moves at `b` acts
ergodically, the family is ε-universal and its flows at every parameter `θ` with `M.b θ = b` are
EGFs. -/
theorem universality_tori_of_record_model {p : ℕ} (A : Fin p → Matrix (Fin d) (Fin d) ℤ)
    (hA : ∀ i, IsUnit (A i).det) (M : AffineToroidalModel d p) (b : Fin p → UnitAddTorus (Fin d))
    (hrich : IsRichToroidalModel A b (affineToroidalFamily A M))
    (herg : IsGroupErgodic volume (torusAffineGroup A b hA)) :
    IsUniversalFamilyEps volume (affineToroidalFamily A M) ∧
      ∀ θ, M.b θ = b →
        IsEGFErgodic volume (M.flow A θ) (fun i => torusAffineME (A i) (b i) (hA i)) (M.α θ) := by
  obtain ⟨hU, -, hEGF⟩ := universality_tori_of_record A hA b _ hrich herg
  refine ⟨hU, fun θ hθ => hEGF _ ⟨θ, rfl⟩ _ ?_⟩
  have := isEGFPolicy_flow M A θ
  rwa [hθ] at this

/-- **Theorem 3.5 of record, as a `Prop`** (v2 `main.tex:316`; C-28, C-31, C-54): on `𝕋^d`,
(main clause) for moves `x ↦ Aᵢx + bᵢ`, a family rich at `b` whose moves at `b` generate a group
acting ergodically is ε-universal, contains EGFs of these moves (its uniform members), and its
members with a policy `∑ᵢ αⁱ δ_{Φᵢ}` on these moves are EGFs; and (sufficient conditions) that
group acts ergodically when it has no non-trivial invariant factor torus with amenable projection,
when it contains an affine map whose linear part has no periodic integer vector, and, on `𝕋¹`,
when it contains a translation of infinite order. The e.g. of the minimal four moves is
`minimalMoves_example_of_record`. -/
def UniversalityToriOfRecord (d : ℕ) : Prop :=
  (∀ (p : ℕ) (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det)
      (b : Fin p → UnitAddTorus (Fin d)) (𝓕 : Set (GenerativeFlow (UnitAddTorus (Fin d)))),
      IsRichToroidalModel A b 𝓕 → IsGroupErgodic volume (torusAffineGroup A b hA) →
        IsUniversalFamilyEps volume 𝓕 ∧
          (∃ F ∈ 𝓕, IsEGFErgodic volume F (fun i => torusAffineME (A i) (b i) (hA i))
            (fun _ _ => 1 / (p : ℝ))) ∧
          ∀ F ∈ 𝓕, ∀ α : Fin p → UnitAddTorus (Fin d) → ℝ,
            IsEGFPolicy F.policy (fun i => torusAffine (A i) (b i)) α →
              IsEGFErgodic volume F (fun i => torusAffineME (A i) (b i) (hA i)) α) ∧
    (∀ (p : ℕ) (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det)
      (b : Fin p → UnitAddTorus (Fin d)),
      ¬ BGConditionII (linearParts (torusAffineGroup A b hA)) →
        IsGroupErgodic volume (torusAffineGroup A b hA)) ∧
    (∀ (p : ℕ) (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det)
      (b : Fin p → UnitAddTorus (Fin d)), ∀ h ∈ torusAffineGroup A b hA,
      ∀ (B : Matrix (Fin d) (Fin d) ℤ) (c : UnitAddTorus (Fin d)), ⇑h = torusAffine B c →
        NoPeriodicVector B → IsGroupErgodic volume (torusAffineGroup A b hA)) ∧
    (d = 1 → ∀ (p : ℕ) (A : Fin p → Matrix (Fin d) (Fin d) ℤ) (hA : ∀ i, IsUnit (A i).det)
      (b : Fin p → UnitAddTorus (Fin d)), ∀ h ∈ torusAffineGroup A b hA,
      ∀ c : UnitAddTorus (Fin d), ⇑h = torusAffine 1 c → orderOf h = 0 →
        IsGroupErgodic volume (torusAffineGroup A b hA))

/-- **Theorem 3.5 holds in its corrected form of record, in every dimension** (with the e.g.
`minimalMoves_example_of_record`). No named `Prop` is assumed. -/
theorem universalityToriOfRecord (d : ℕ) : UniversalityToriOfRecord d :=
  ⟨fun _ A hA b 𝓕 hrich herg => universality_tori_of_record A hA b 𝓕 hrich herg,
    fun _ A hA b => (isGroupErgodic_torus_of_conditions A hA b).1,
    fun _ A hA b h hh B c hc hper =>
      (isGroupErgodic_torus_of_conditions A hA b).2.1 h hh B c hc hper,
    fun hd _ A hA b => (isGroupErgodic_torus_of_conditions A hA b).2.2 hd⟩

/-- **Non-vacuity of Theorem 3.5 of record**: its main clause's hypotheses are met on `𝕋²` by the
minimal four moves with the `L²` model, for every choice of the translations (the family is then
ε-universal and its flows are EGFs), and its `𝕋¹` clause by the translation by `√2`. -/
theorem universalityToriOfRecord_nonvacuous :
    (∀ b : Fin 4 → UnitAddTorus (Fin 2),
      IsRichToroidalModel minimalMoves b
          (affineToroidalFamily minimalMoves (l2ToroidalModel (by norm_num) b)) ∧
        IsGroupErgodic volume (torusAffineGroup minimalMoves b isUnit_det_minimalMoves)) ∧
      ∃ h ∈ torusAffineGroup (fun _ : Fin 1 => (1 : Matrix (Fin 1) (Fin 1) ℤ))
          (fun _ _ => ((√2 : ℝ) : UnitAddCircle))
          (fun _ => by rw [Matrix.det_one]; exact isUnit_one),
        ∃ c : UnitAddTorus (Fin 1), ⇑h = torusAffine 1 c ∧ orderOf h = 0 := by
  refine ⟨fun b => ⟨isRichToroidalModel_l2ToroidalModel _ _ b, isGroupErgodic_minimalMoves b⟩,
    torusAffineEquiv 1 (fun _ => ((√2 : ℝ) : UnitAddCircle))
      (by rw [Matrix.det_one]; exact isUnit_one), Subgroup.subset_closure ⟨0, rfl⟩,
    fun _ => ((√2 : ℝ) : UnitAddCircle), rfl, ?_⟩
  rw [orderOf_eq_addOrderOf_of_translation rfl, addOrderOf_unitAddTorus_one]
  exact addOrderOf_coe_eq_zero_of_irrational irrational_sqrt_two

/-! ## Theorem 3.6 -/

/-- **"Its model realizes `αⁱ ≡ 1/p` and a dense set of outflows" implies richness** (spheres): if
for every `f` of a set `D` dense in the non-negative cone of `L²(σ)` some parameter `θ` has
rotations `Φ`, softmax head `1/p` and scalar head `f`, the family of the model is rich at `Φ`. -/
theorem isRichSphericalModel_of_realizes {n p : ℕ} (M : IsometrySphericalModel n p)
    (Φ : Fin p → SO n) (D : Set (RoundSphere n → ℝ)) (hD : IsDenseNonnegConeL2 (sphereVolume n) D)
    (hreal : ∀ f ∈ D, ∃ θ, M.rot θ = Φ ∧ (∀ i s, M.α θ i s = 1 / (p : ℝ)) ∧ M.f θ = f) :
    IsRichSphericalModel Φ (isometrySphericalFamily M) := by
  refine ⟨D, hD, fun f hf => ?_⟩
  obtain ⟨θ, hrot, hα, hfθ⟩ := hreal f hf
  refine ⟨M.flow θ, ⟨θ, rfl⟩, ?_, ?_⟩
  · ext s : 1
    show ∑ i, ENNReal.ofReal (M.α θ i s) • Measure.dirac (rotSphere (M.rot θ i) s) =
      ∑ i, ENNReal.ofReal (1 / (p : ℝ)) • Measure.dirac (rotSphere (Φ i) s)
    simp only [hrot, hα]
  · show (sphereVolume n).withDensity (fun s => ENNReal.ofReal (M.f θ s)) = _
    rw [hfθ]

/-- **Theorem 3.6's clause, of record** (C-28, C-31, C-49, C-54): on `S^{n−1}`, `n ≥ 2`, if the
family contains the uniform kernel of the rotations `Φᵢ` with outflows dense in the non-negative
cone of `L²(σ)` and the `Φᵢ` generate a dense subgroup of `SO(n)`, the family is ε-universal, it
contains EGFs of these rotations, and every member whose policy is `∑ᵢ αⁱ δ_{Φᵢ}` is an EGF. -/
theorem universality_sphere_of_record {n p : ℕ} (hn : 2 ≤ n) (Φ : Fin p → SO n)
    (hdense : Dense ((Subgroup.closure (Set.range Φ) : Subgroup (SO n)) : Set (SO n)))
    (𝓕 : Set (GenerativeFlow (RoundSphere n))) (hrich : IsRichSphericalModel Φ 𝓕) :
    IsUniversalFamilyEps (sphereVolume n) 𝓕 ∧
      (∃ F ∈ 𝓕, IsEGFErgodic (sphereVolume n) F (fun i => rotME (Φ i)) (fun _ _ => 1 / (p : ℝ))) ∧
      ∀ F ∈ 𝓕, ∀ α : Fin p → RoundSphere n → ℝ,
        IsEGFPolicy F.policy (fun i => rotSphere (Φ i)) α →
          IsEGFErgodic (sphereVolume n) F (fun i => rotME (Φ i)) α := by
  have herg := isGroupErgodic_sphereRotGroup_of_dense hn Φ hdense
  refine ⟨universality_sphere hn Φ hdense 𝓕 hrich, ?_,
    fun F _ α hα => ⟨hα, fun _ => nonsingular_rotME _, herg⟩⟩
  have hp := hrich.pos (by omega)
  obtain ⟨D, hdense', hD⟩ := hrich
  obtain ⟨f, hfD, -, -⟩ := hdense' 0 MemLp.zero (fun _ => le_rfl) 1 one_pos
  obtain ⟨F, hF, hFπ, -⟩ := hD f hfD
  exact ⟨F, hF, (isEGFErgodic_sphere_iff hp Φ F hFπ).2 herg⟩

/-- **Theorem 3.6's clause for the family of a model** (C-54): if the family of an isometry
spherical model is rich at the rotations `Φ` and these generate a dense subgroup of `SO(n)`,
`n ≥ 2`, the family is ε-universal and its flows at every parameter with rotations `Φ` are EGFs. -/
theorem universality_sphere_of_record_model {n p : ℕ} (hn : 2 ≤ n) (M : IsometrySphericalModel n p)
    (Φ : Fin p → SO n)
    (hdense : Dense ((Subgroup.closure (Set.range Φ) : Subgroup (SO n)) : Set (SO n)))
    (hrich : IsRichSphericalModel Φ (isometrySphericalFamily M)) :
    IsUniversalFamilyEps (sphereVolume n) (isometrySphericalFamily M) ∧
      ∀ θ, M.rot θ = Φ →
        IsEGFErgodic (sphereVolume n) (M.flow θ) (fun i => rotME (Φ i)) (M.α θ) := by
  obtain ⟨hU, -, hEGF⟩ := universality_sphere_of_record hn Φ hdense _ hrich
  refine ⟨hU, fun θ hθ => hEGF _ ⟨θ, rfl⟩ _ ?_⟩
  have := M.isEGFPolicy_flow θ
  rwa [hθ] at this

/-- **Theorem 3.6 of record, as a `Prop`** (v2 `main.tex:333`; C-28, C-31, C-49, C-54): on `𝕊^d`,
`d ≥ 1`, rotations `Φᵢ ∈ SO(d + 1)` generating a dense subgroup and a family rich at them give an
ε-universal family which contains EGFs of these rotations (its uniform members) and whose members
with a policy `∑ᵢ αⁱ δ_{Φᵢ}` are EGFs. -/
def UniversalitySphereOfRecord (d : ℕ) : Prop :=
  1 ≤ d → ∀ (p : ℕ) (Φ : Fin p → SO (d + 1)),
    Dense ((Subgroup.closure (Set.range Φ) : Subgroup (SO (d + 1))) : Set (SO (d + 1))) →
    ∀ 𝓕 : Set (GenerativeFlow (RoundSphere (d + 1))), IsRichSphericalModel Φ 𝓕 →
      IsUniversalFamilyEps (sphereVolume (d + 1)) 𝓕 ∧
        (∃ F ∈ 𝓕, IsEGFErgodic (sphereVolume (d + 1)) F (fun i => rotME (Φ i))
          (fun _ _ => 1 / (p : ℝ))) ∧
        ∀ F ∈ 𝓕, ∀ α : Fin p → RoundSphere (d + 1) → ℝ,
          IsEGFPolicy F.policy (fun i => rotSphere (Φ i)) α →
            IsEGFErgodic (sphereVolume (d + 1)) F (fun i => rotME (Φ i)) α

/-- **Theorem 3.6 holds in its corrected form of record on every sphere** (no named `Prop` is
assumed). -/
theorem universalitySphereOfRecord (d : ℕ) : UniversalitySphereOfRecord d :=
  fun hd _ Φ hdense 𝓕 hrich => universality_sphere_of_record (by omega) Φ hdense 𝓕 hrich

/-! ## The move counts of C-56 -/

/-- The two moves `S`, `T` on `𝕋²`, without their inverses. -/
def twoMoves : Fin 2 → Matrix (Fin 2) (Fin 2) ℤ := ![matS, matT]

theorem isUnit_det_twoMoves : ∀ i, IsUnit (twoMoves i).det := by
  intro i
  fin_cases i
  · simp [twoMoves, det_matS]
  · simp [twoMoves, det_matT]

/-- **Two moves suffice on `𝕋²`** (C-56): the moves `x ↦ Sx + b₀`, `x ↦ Tx + b₁`, for every choice
of the translations, with a rich model, give an ε-universal family whose members on these moves are
EGFs. -/
theorem universality_tori_two_moves (b : Fin 2 → UnitAddTorus (Fin 2))
    (𝓕 : Set (GenerativeFlow (UnitAddTorus (Fin 2)))) (hrich : IsRichToroidalModel twoMoves b 𝓕) :
    IsUniversalFamilyEps volume 𝓕 ∧
      ∀ F ∈ 𝓕, ∀ α : Fin 2 → UnitAddTorus (Fin 2) → ℝ,
        IsEGFPolicy F.policy (fun i => torusAffine (twoMoves i) (b i)) α →
          IsEGFErgodic volume F (fun i => torusAffineME (twoMoves i) (b i) (isUnit_det_twoMoves i))
            α := by
  obtain ⟨hmem, c, hc⟩ := mem_torusAffineGroup_commutator twoMoves isUnit_det_twoMoves b
    (i := 0) (j := 1) rfl rfl
  have herg := isGroupErgodic_torus_of_noPeriodic _ _ b hmem hc noPeriodicVector_catMat
  obtain ⟨hU, -, hEGF⟩ := universality_tori_of_record twoMoves isUnit_det_twoMoves b 𝓕 hrich herg
  exact ⟨hU, hEGF⟩

/-- Non-vacuity: the `L²` model with the two moves `S`, `T`. -/
theorem universality_tori_two_moves_l2 (b : Fin 2 → UnitAddTorus (Fin 2)) :
    IsUniversalFamilyEps volume (affineToroidalFamily twoMoves (l2ToroidalModel (by norm_num) b)) :=
  (universality_tori_two_moves b _ (isRichToroidalModel_l2ToroidalModel _ twoMoves b)).1

/-- **Two rotations of `𝕊²`, without their inverses** (C-56): the rotations of cosine `3/5` about
the third and the first axes. -/
noncomputable def so3Pair : Fin 2 → SO 3 := ![rotZ angle35, rotX angle35]

/-- **The pair generates a dense subgroup of `SO(3)`**: its generated subgroup contains that of
`so3Witness` (the pair and its inverses), which is dense (`so3Witness_dense`). -/
theorem so3Pair_dense :
    Dense ((Subgroup.closure (Set.range so3Pair) : Subgroup (SO 3)) : Set (SO 3)) := by
  refine so3Witness_dense.mono (SetLike.coe_subset_coe.2 ((Subgroup.closure_le _).2 ?_))
  have h0 : rotZ angle35 ∈ Subgroup.closure (Set.range so3Pair) :=
    Subgroup.subset_closure ⟨0, rfl⟩
  have h1 : rotX angle35 ∈ Subgroup.closure (Set.range so3Pair) :=
    Subgroup.subset_closure ⟨1, rfl⟩
  rintro _ ⟨i, rfl⟩
  fin_cases i
  · exact h0
  · show rotZ (-angle35) ∈ _
    rw [rotZ_neg]; exact inv_mem h0
  · exact h1
  · show rotX (-angle35) ∈ _
    rw [rotX_neg]; exact inv_mem h1

/-- **Two rotations suffice on `𝕊²`** (C-56): with a rich model at `so3Pair`, the family is
ε-universal and its members on these rotations are EGFs. -/
theorem universality_sphere_two_moves_three (𝓕 : Set (GenerativeFlow (RoundSphere 3)))
    (hrich : IsRichSphericalModel so3Pair 𝓕) :
    IsUniversalFamilyEps (sphereVolume 3) 𝓕 ∧
      ∀ F ∈ 𝓕, ∀ α : Fin 2 → RoundSphere 3 → ℝ,
        IsEGFPolicy F.policy (fun i => rotSphere (so3Pair i)) α →
          IsEGFErgodic (sphereVolume 3) F (fun i => rotME (so3Pair i)) α := by
  obtain ⟨hU, -, hEGF⟩ := universality_sphere_of_record (by norm_num) so3Pair so3Pair_dense 𝓕 hrich
  exact ⟨hU, hEGF⟩

/-- Non-vacuity: the `L²` model at the two rotations `so3Pair`. -/
theorem universality_sphere_two_moves_three_l2 :
    IsUniversalFamilyEps (sphereVolume 3)
      (isometrySphericalFamily (l2SphericalModel (by norm_num) so3Pair)) :=
  universality_sphere_l2 (by norm_num) (by norm_num) so3Pair so3Pair_dense

/-- **One rotation suffices on `𝕊¹`** (C-56; `universality_sphere_one` at `p = 1`): the rotation
of cosine `3/5`, with a rich model. -/
theorem universality_sphere_one_move (𝓕 : Set (GenerativeFlow (RoundSphere 2)))
    (hrich : IsRichSphericalModel ![rotMat angle35] 𝓕) :
    IsUniversalFamilyEps (sphereVolume 2) 𝓕 :=
  universality_sphere_one _ (i₀ := 0) rfl irrational_angle35 𝓕 hrich

/-- **Non-vacuity of Theorem 3.6 of record**: its hypotheses are met on `𝕊²` (`d = 2`) by the two
rotations `so3Pair` with the `L²` model, and on `𝕊¹` (`d = 1`) by `so2Witness` with the `L²`
model. -/
theorem universalitySphereOfRecord_nonvacuous :
    (Dense ((Subgroup.closure (Set.range so3Pair) : Subgroup (SO 3)) : Set (SO 3)) ∧
      IsRichSphericalModel so3Pair
        (isometrySphericalFamily (l2SphericalModel (by norm_num) so3Pair))) ∧
      Dense ((Subgroup.closure (Set.range so2Witness) : Subgroup (SO 2)) : Set (SO 2)) ∧
      IsRichSphericalModel so2Witness
        (isometrySphericalFamily (l2SphericalModel (by norm_num) so2Witness)) :=
  ⟨⟨so3Pair_dense, isRichSphericalModel_l2 _ _⟩, so2Witness_dense, isRichSphericalModel_l2 _ _⟩

end EGF
