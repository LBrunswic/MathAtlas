import Syracuse.Approaches.R1.Skeleton

/-!
# Skeleton `S B:1:1:0 S` (generated by `skeleton.py compile`)

Uniform in the words: blocks `β0` with `|βᵢ| = kᵢ p`, `len βᵢ = kᵢ q`; spacers
`σ0, σ1` arbitrary. Degree `N = 1`. Every cycle member `W(a)` satisfies
`D(W(a)) ∣ -1 · R'(data)` (`ceiling`), and if that number is nonzero only finitely many `a`
give cycles (`finite`). `R'` is the resultant of `D` and `(∏ D(βᵢ)) S` in `[2^{pa} : 3^{qa}]`
with its `6`-unit factors removed.
-/

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 40000000
set_option maxRecDepth 20000

namespace Syracuse.R1.Skel.OneBlock

open Syracuse Syracuse.CocycleCombine Filter

/-- The family member. -/
def word (β0 σ0 σ1 : Word) (a : ℕ) : Word := σ0 ++ wpow β0 (1 * a + 0) ++ σ1

section Ring
variable {R : Type*} [CommRing R]

/-- `D` in the universal data. -/
def Du (zz ss PP QQ Sb0 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 : R) : R := Ps0*Ps1*zz - Qs0*Qs1*ss

/-- `(∏ D(βᵢ)) · S` in the universal data. -/
def Gu (zz ss PP QQ Sb0 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 : R) : R := PP*Ps0*Ss1*zz + PP*Qs1*Ss0*ss - Ps0*QQ*Ss1*zz - Ps0*Qs1*Sb0*ss + Ps0*Qs1*Sb0*zz - QQ*Qs1*Ss0*ss

/-- The ceiling polynomial `R'`. -/
def Rp (zz ss PP QQ Sb0 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 : R) : R := PP*Ps1*Ss0 + PP*Qs0*Ss1 - Ps0*Ps1*Sb0 - Ps1*QQ*Ss0 - QQ*Qs0*Ss1 + Qs0*Qs1*Sb0

def Au (zz ss PP QQ Sb0 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 : R) : R := PP*Ps0*Ss1 - Ps0*QQ*Ss1 + Ps0*Qs1*Sb0

def Bu (zz ss PP QQ Sb0 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 : R) : R := -Ps0*Ps1

/-- **Universal certificate** (`ring`). -/
theorem certificate (zz ss PP QQ Sb0 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 : R) :
    ss ^ 1 * (Ps0*Qs1) * (-1 * Rp zz ss PP QQ Sb0 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1) =
      Au zz ss PP QQ Sb0 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 * Du zz ss PP QQ Sb0 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 + Bu zz ss PP QQ Sb0 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 * Gu zz ss PP QQ Sb0 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 := by
  unfold Au Du Bu Gu Rp; ring

variable (X Y : R) (p q a : ℕ) (β0 σ0 σ1 : Word)

theorem closedD (h0s : β0.sum = 1 * p) (h0l : β0.length = 1 * q) :
    D X Y (word β0 σ0 σ1 a) = Du (X ^ (p * a)) (Y ^ (q * a)) (X ^ p) (Y ^ q) (S X Y β0) (S X Y σ0) (X ^ σ0.sum) (Y ^ σ0.length) (S X Y σ1) (X ^ σ1.sum) (Y ^ σ1.length) := by
  simp only [word, D, List.sum_append, List.length_append, wpow_sum, wpow_length, h0s, h0l]
  unfold Du; ring

theorem closedS (h0s : β0.sum = 1 * p) (h0l : β0.length = 1 * q) :
    (X ^ (1 * p) - Y ^ (1 * q)) * S X Y (word β0 σ0 σ1 a) = Gu (X ^ (p * a)) (Y ^ (q * a)) (X ^ p) (Y ^ q) (S X Y β0) (S X Y σ0) (X ^ σ0.sum) (Y ^ σ0.length) (S X Y σ1) (X ^ σ1.sum) (Y ^ σ1.length) := by
  have r0 := wpow_rel X Y β0 (1 * a + 0)
  rw [h0s, h0l] at r0
  have d0 : D X Y β0 = X ^ (1 * p) - Y ^ (1 * q) := by simp [D, h0s, h0l]
  rw [d0] at r0
  simp only [word, S_append, List.sum_append, List.length_append, wpow_sum, wpow_length, h0s, h0l]
  unfold Gu
  linear_combination ((X ^ (0 * p) * Y ^ (0 * q)) * Y ^ (σ1.length) * X ^ (σ0.sum)) * r0

end Ring

/-- **Ceiling, uniform in the words.** -/
theorem ceiling {p q : ℕ} {β0 σ0 σ1 : Word} (a : ℕ) (h0s : β0.sum = 1 * p) (h0l : β0.length = 1 * q)
    (hpos : (word β0 σ0 σ1 a).Pos) (hc : IsCycleWord (word β0 σ0 σ1 a)) :
    Dz (word β0 σ0 σ1 a) ∣ -1 * Rp ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) := by
  obtain ⟨hne, hdvd⟩ := hc
  have hD := closedD (2 : ℤ) 3 p q a β0 σ0 σ1 h0s h0l
  have hS := closedS (2 : ℤ) 3 p q a β0 σ0 σ1 h0s h0l
  have hcert := certificate ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length)
  have hG : Dz (word β0 σ0 σ1 a) ∣ Gu ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) := by
    rw [← hS]; exact dvd_mul_of_dvd_right hdvd _
  have hDu : Dz (word β0 σ0 σ1 a) ∣ Du ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) := by rw [Dz, ← hD]
  have h6 : Dz (word β0 σ0 σ1 a) ∣ 2 ^ (σ0.sum * 1) * 3 ^ (q * a * 1 + σ1.length * 1) * (-1 * Rp ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length)) := by
    have : (2 : ℤ) ^ (σ0.sum * 1) * 3 ^ (q * a * 1 + σ1.length * 1) * (-1 * Rp ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length)) =
        Au ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) * Du ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) + Bu ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) * Gu ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) := by
      rw [← hcert]; ring
    rw [this]; exact dvd_add (dvd_mul_of_dvd_right hDu _) (dvd_mul_of_dvd_right hG _)
  exact dvd_of_isCoprime_six_of_dvd (cop6 hpos hne) _ _ h6

/-- **Finiteness, uniform in the words**, whenever the ceiling is nonzero. -/
theorem finite {p q : ℕ} {β0 σ0 σ1 : Word} (h0s : β0.sum = 1 * p) (h0l : β0.length = 1 * q) (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hpos : ∀ a, (word β0 σ0 σ1 a).Pos) (hR : -1 * Rp ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) ≠ 0) :
    {a | IsCycleWord (word β0 σ0 σ1 a)}.Finite := by
  apply finite_of_ceiling (c := -1 * Rp ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length)) hR (E₀ := σ0.sum + σ1.sum + 1 * 0 * p) (o₀ := σ0.length + σ1.length + 1 * 0 * q)
    (α := p * 1) (β := q * 1) (by omega) (by omega)
  · intro a
    simp only [Dz, word, D, List.sum_append, List.length_append, wpow_sum, wpow_length, h0s, h0l]
    ring
  · intro a hc
    exact ceiling a h0s h0l (hpos a) hc

end Syracuse.R1.Skel.OneBlock
