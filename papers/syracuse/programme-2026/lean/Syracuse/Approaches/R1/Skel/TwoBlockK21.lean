def Bu_0 (zz ss PP QQ Sb0 Sb1 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 : R) : R := PP^4*Ps0^3*Ps1^2*Qs0*Qs1^2*Ss0*Ss1*zz^2 - PP^4*Ps0^3*Ps1*Qs0^2*Qs1^2*Ss1^2*ss^2 - PP^4*Ps0^2*Ps1^2*Qs0*Qs1^3*Ss0^2*ss*zz - PP^3*Ps0^4*Ps1^2*Qs0*Qs1^2*Sb1*Ss1*zz^2 + PP^3*Ps0^3*Ps1^2*Qs0*Qs1^3*Sb1*Ss0*zz^2 - 2*PP^3*Ps0^3*Ps1*Qs0^2*Qs1^3*Sb1*Ss1*ss^2 - PP^2*Ps0^4*Ps1^2*Qs0*Qs1^3*Sb1^2*ss*zz - PP^2*Ps0^4*Ps1^2*Qs0*Qs1^3*Sb1^2*zz^2 - PP^2*Ps0^3*Ps1^3*Qs0*Qs1^2*Sb0*Ss0*zz^2 + PP^2*Ps0^3*Ps1^2*Qs0^2*Qs1^2*Sb0*Ss1*zz^2 - PP^2*Ps0^3*Ps1*Qs0^2*Qs1^4*Sb1^2*ss^2 + PP*Ps0^4*Ps1^3*Qs0*Qs1^2*Sb0*Sb1*zz^2 - 2*PP*Ps0^4*Ps1^2*QQ*Qs0*Qs1^3*Sb1^2*zz^2 + PP*Ps0^3*Ps1^2*Qs0^2*Qs1^3*Sb0*Sb1*zz^2 - 2*PP*Ps0^3*Ps1*QQ*Qs0^2*Qs1^4*Sb1^2*ss^2 + Ps0^4*Ps1^3*QQ*Qs0*Qs1^2*Sb0*Sb1*zz^2 + Ps0^4*Ps1^2*QQ^3*Qs0*Qs1^2*Sb1*Ss1*zz^2 - Ps0^4*Ps1^2*QQ^2*Qs0*Qs1^3*Sb1^2*ss*zz - Ps0^4*Ps1^2*QQ^2*Qs0*Qs1^3*Sb1^2*zz^2 + Ps0^3*Ps1^3*QQ^2*Qs0*Qs1^2*Sb0*Ss0*zz^2 - Ps0^3*Ps1^3*Qs0^2*Qs1^2*Sb0^2*ss^2 - Ps0^3*Ps1^3*Qs0^2*Qs1^2*Sb0^2*zz^2 + Ps0^3*Ps1^2*QQ^4*Qs0*Qs1^2*Ss0*Ss1*zz^2 - Ps0^3*Ps1^2*QQ^3*Qs0*Qs1^3*Sb1*Ss0*zz^2 - Ps0^3*Ps1^2*QQ^2*Qs0^2*Qs1^2*Sb0*Ss1*zz^2 + Ps0^3*Ps1^2*QQ*Qs0^2*Qs1^3*Sb0*Sb1*zz^2 - Ps0^3*Ps1*QQ^4*Qs0^2*Qs1^2*Ss1^2*ss^2 - Ps0^3*Ps1*QQ^2*Qs0^2*Qs1^4*Sb1^2*ss^2 - Ps0^2*Ps1^2*QQ^4*Qs0*Qs1^3*Ss0^2*ss*zz - Ps0^2*Ps1^2*Qs0^3*Qs1^3*Sb0^2*ss*zz

def Bu_1 (zz ss PP QQ Sb0 Sb1 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 : R) : R := 2*PP^3*Ps0^3*Ps1^2*Qs0*Qs1^3*Sb1*Ss0*ss*zz - PP^2*Ps0^4*Ps1^2*QQ*Qs0*Qs1^2*Sb1*Ss1*zz^2 - 2*PP^2*Ps0^3*Ps1^2*QQ^2*Qs0*Qs1^2*Ss0*Ss1*zz^2 + 2*PP^2*Ps0^3*Ps1^2*QQ*Qs0*Qs1^3*Sb1*Ss0*ss*zz + PP^2*Ps0^3*Ps1^2*QQ*Qs0*Qs1^3*Sb1*Ss0*zz^2 + 2*PP^2*Ps0^3*Ps1^2*Qs0^2*Qs1^2*Sb0*Ss1*ss^2 + 2*PP^2*Ps0^3*Ps1*QQ^2*Qs0^2*Qs1^2*Ss1^2*ss^2 - 2*PP^2*Ps0^3*Ps1*QQ*Qs0^2*Qs1^3*Sb1*Ss1*ss^2 + 2*PP^2*Ps0^2*Ps1^2*QQ^2*Qs0*Qs1^3*Ss0^2*ss*zz - 2*PP^2*Ps0^2*Ps1^2*Qs0^2*Qs1^3*Sb0*Ss0*ss*zz + PP*Ps0^4*Ps1^2*QQ^2*Qs0*Qs1^2*Sb1*Ss1*zz^2 - 2*PP*Ps0^4*Ps1^2*QQ*Qs0*Qs1^3*Sb1^2*ss*zz - 2*PP*Ps0^3*Ps1^2*QQ^2*Qs0*Qs1^3*Sb1*Ss0*ss*zz - PP*Ps0^3*Ps1^2*QQ^2*Qs0*Qs1^3*Sb1*Ss0*zz^2 + 2*PP*Ps0^3*Ps1^2*Qs0^2*Qs1^3*Sb0*Sb1*ss^2 + 2*PP*Ps0^3*Ps1^2*Qs0^2*Qs1^3*Sb0*Sb1*ss*zz + 2*PP*Ps0^3*Ps1*QQ^2*Qs0^2*Qs1^3*Sb1*Ss1*ss^2 - 2*Ps0^3*Ps1^2*QQ^3*Qs0*Qs1^3*Sb1*Ss0*ss*zz - 2*Ps0^3*Ps1^2*QQ^2*Qs0^2*Qs1^2*Sb0*Ss1*ss^2 + 2*Ps0^3*Ps1^2*QQ*Qs0^2*Qs1^3*Sb0*Sb1*ss^2 + 2*Ps0^3*Ps1^2*QQ*Qs0^2*Qs1^3*Sb0*Sb1*ss*zz + 2*Ps0^3*Ps1*QQ^3*Qs0^2*Qs1^3*Sb1*Ss1*ss^2 + 2*Ps0^2*Ps1^2*QQ^2*Qs0^2*Qs1^3*Sb0*Ss0*ss*zz

def Bu (zz ss PP QQ Sb0 Sb1 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 : R) : R := Bu_0 zz ss PP QQ Sb0 Sb1 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 + Bu_1 zz ss PP QQ Sb0 Sb1 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1

/-- **Universal certificate** (`ring`). -/
theorem certificate (zz ss PP QQ Sb0 Sb1 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 : R) :
    ss ^ 5 * (Ps0*Qs0^2*Qs1^3) * (-1 * Rp zz ss PP QQ Sb0 Sb1 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1) =
      Au zz ss PP QQ Sb0 Sb1 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 * Du zz ss PP QQ Sb0 Sb1 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 + Bu zz ss PP QQ Sb0 Sb1 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 * Gu zz ss PP QQ Sb0 Sb1 Ss0 Ps0 Qs0 Ss1 Ps1 Qs1 := by
  unfold Au Au_0 Au_1 Au_2 Au_3 Au_4 Du Bu Bu_0 Bu_1 Gu Rp Rp_0 Rp_1; ring

variable (X Y : R) (p q a : ℕ) (β0 β1 σ0 σ1 : Word)

theorem closedD (h0s : β0.sum = 2 * p) (h0l : β0.length = 2 * q) (h1s : β1.sum = 1 * p) (h1l : β1.length = 1 * q) :
    D X Y (word β0 β1 σ0 σ1 a) = Du (X ^ (p * a)) (Y ^ (q * a)) (X ^ p) (Y ^ q) (S X Y β0) (S X Y β1) (S X Y σ0) (X ^ σ0.sum) (Y ^ σ0.length) (S X Y σ1) (X ^ σ1.sum) (Y ^ σ1.length) := by
  simp only [word, D, List.sum_append, List.length_append, wpow_sum, wpow_length, h0s, h0l, h1s, h1l]
  unfold Du; ring

theorem closedS (h0s : β0.sum = 2 * p) (h0l : β0.length = 2 * q) (h1s : β1.sum = 1 * p) (h1l : β1.length = 1 * q) :
    (X ^ (2 * p) - Y ^ (2 * q)) * S X Y (word β0 β1 σ0 σ1 a) = Gu (X ^ (p * a)) (Y ^ (q * a)) (X ^ p) (Y ^ q) (S X Y β0) (S X Y β1) (S X Y σ0) (X ^ σ0.sum) (Y ^ σ0.length) (S X Y σ1) (X ^ σ1.sum) (Y ^ σ1.length) := by
  have r0 := wpow_rel X Y β0 (1 * a + 0)
  rw [h0s, h0l] at r0
  have d0 : D X Y β0 = X ^ (2 * p) - Y ^ (2 * q) := by simp [D, h0s, h0l]
  rw [d0] at r0
  have r1 := wpow_rel X Y β1 (1 * a + 0)
  rw [h1s, h1l] at r1
  have d1 : D X Y β1 = X ^ (1 * p) - Y ^ (1 * q) := by simp [D, h1s, h1l]
  rw [d1] at r1
  simp only [word, S_append, List.sum_append, List.length_append, wpow_sum, wpow_length, h0s, h0l, h1s, h1l]
  unfold Gu
  linear_combination ((X ^ (0 * p) * Y ^ (0 * q)) * Y ^ (σ0.length + ((1 * a + 0) * (1 * q)) + σ1.length) * X ^ (0)) * r0 + ((X ^ (0 * p) * Y ^ (1 * q) + X ^ (1 * p) * Y ^ (0 * q)) * Y ^ (σ1.length) * X ^ (((1 * a + 0) * (2 * p)) + σ0.sum)) * r1

end Ring

/-- **Ceiling, uniform in the words.** -/
theorem ceiling {p q : ℕ} {β0 β1 σ0 σ1 : Word} (a : ℕ) (h0s : β0.sum = 2 * p) (h0l : β0.length = 2 * q) (h1s : β1.sum = 1 * p) (h1l : β1.length = 1 * q)
    (hpos : (word β0 β1 σ0 σ1 a).Pos) (hc : IsCycleWord (word β0 β1 σ0 σ1 a)) :
    Dz (word β0 β1 σ0 σ1 a) ∣ -1 * Rp ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) := by
  obtain ⟨hne, hdvd⟩ := hc
  have hD := closedD (2 : ℤ) 3 p q a β0 β1 σ0 σ1 h0s h0l h1s h1l
  have hS := closedS (2 : ℤ) 3 p q a β0 β1 σ0 σ1 h0s h0l h1s h1l
  have hcert := certificate ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length)
  have hG : Dz (word β0 β1 σ0 σ1 a) ∣ Gu ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) := by
    rw [← hS]; exact dvd_mul_of_dvd_right hdvd _
  have hDu : Dz (word β0 β1 σ0 σ1 a) ∣ Du ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) := by rw [Dz, ← hD]
  have h6 : Dz (word β0 β1 σ0 σ1 a) ∣ 2 ^ (σ0.sum * 1) * 3 ^ (q * a * 5 + σ0.length * 2 + σ1.length * 3) * (-1 * Rp ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length)) := by
    have : (2 : ℤ) ^ (σ0.sum * 1) * 3 ^ (q * a * 5 + σ0.length * 2 + σ1.length * 3) * (-1 * Rp ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length)) =
        Au ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) * Du ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) + Bu ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) * Gu ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) := by
      rw [← hcert]; ring
    rw [this]; exact dvd_add (dvd_mul_of_dvd_right hDu _) (dvd_mul_of_dvd_right hG _)
  exact dvd_of_isCoprime_six_of_dvd (cop6 hpos hne) _ _ h6

/-- **Finiteness, uniform in the words**, whenever the ceiling is nonzero. -/
theorem finite {p q : ℕ} {β0 β1 σ0 σ1 : Word} (h0s : β0.sum = 2 * p) (h0l : β0.length = 2 * q) (h1s : β1.sum = 1 * p) (h1l : β1.length = 1 * q) (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hpos : ∀ a, (word β0 β1 σ0 σ1 a).Pos) (hR : -1 * Rp ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length) ≠ 0) :
    {a | IsCycleWord (word β0 β1 σ0 σ1 a)}.Finite := by
  apply finite_of_ceiling (c := -1 * Rp ((2 : ℤ) ^ (p * a)) ((3 : ℤ) ^ (q * a)) ((2 : ℤ) ^ p) ((3 : ℤ) ^ q) (Sz β0) (Sz β1) (Sz σ0) ((2 : ℤ) ^ σ0.sum) ((3 : ℤ) ^ σ0.length) (Sz σ1) ((2 : ℤ) ^ σ1.sum) ((3 : ℤ) ^ σ1.length)) hR (E₀ := σ0.sum + σ1.sum + 2 * 0 * p + 1 * 0 * p) (o₀ := σ0.length + σ1.length + 2 * 0 * q + 1 * 0 * q)
    (α := p * 3) (β := q * 3) (by omega) (by omega)
  · intro a
    simp only [Dz, word, D, List.sum_append, List.length_append, wpow_sum, wpow_length, h0s, h0l, h1s, h1l]
    ring
  · intro a hc
    exact ceiling a h0s h0l h1s h1l (hpos a) hc

