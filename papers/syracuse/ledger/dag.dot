digraph formalization {
  rankdir=BT; node [style=filled,fontname="Helvetica",fontsize=9];
  edge [color="#888888",arrowsize=0.6];
  subgraph "cluster_P" {
    label="P"; color="#cccccc";
    "def:ring_define" [label="def:ring_define\n", shape=box, fillcolor="#ffe08a"];
    "prop:ring_both_continuous_extends" [label="prop:ring_both_continuous_extends\n", shape=ellipse, fillcolor="#ffe08a"];
    "def:ring_define_2" [label="def:ring_define_2\n", shape=box, fillcolor="#ffe08a"];
    "lem:base" [label="lem:base\n", shape=ellipse, fillcolor="#ffe08a"];
    "def:define_n__n_" [label="def:define_n__n_\n", shape=box, fillcolor="#b7e4c7"];
    "lem:ring_maps_rhs_n_" [label="lem:ring_maps_rhs_n_\n", shape=ellipse, fillcolor="#ffe08a"];
    "theo:rep" [label="theo:rep\n", shape=doubleoctagon, fillcolor="#ffe08a"];
    "cor:ring_following_equivalent_enumerate" [label="cor:ring_following_equivalent_enumerate\n", shape=ellipse, fillcolor="#ffe08a"];
    "cor:ring_periodic_minimal_period" [label="cor:ring_periodic_minimal_period\n", shape=ellipse, fillcolor="#ffe08a"];
    "cor:corollary" [label="cor:corollary\n", shape=ellipse, fillcolor="#ffffff"];
    "lem:one_has" [label="lem:one_has\n", shape=ellipse, fillcolor="#b7e4c7"];
    "lem:itemize_furthermore_itemize" [label="lem:itemize_furthermore_itemize\n", shape=ellipse, fillcolor="#ffe08a"];
    "cor:corollary_2" [label="cor:corollary_2\n", shape=ellipse, fillcolor="#b7e4c7"];
    "cor:bounds" [label="cor:bounds\n", shape=ellipse, fillcolor="#ffe08a"];
    "theo:mr" [label="theo:mr\n[MR1074572]", shape=doubleoctagon, fillcolor="#ffffff"];
    "theo:steiner" [label="theo:steiner\nSteiner []", shape=doubleoctagon, fillcolor="#ffffff"];
    "theo:matveev" [label="theo:matveev\nMatveev", shape=doubleoctagon, fillcolor="#ffffff"];
    "cor:property_defined_cycles_gcd" [label="cor:property_defined_cycles_gcd\n", shape=ellipse, fillcolor="#ffffff"];
    "prop:have_gcd_n__l_k" [label="prop:have_gcd_n__l_k\n", shape=ellipse, fillcolor="#ffe08a"];
    "prop:proposition" [label="prop:proposition\n", shape=ellipse, fillcolor="#ffffff"];
    "lem:periodic_exists_i_a_i_" [label="lem:periodic_exists_i_a_i_\n", shape=ellipse, fillcolor="#ffe08a"];
    "def:circuit" [label="def:circuit\nε-circuit", shape=box, fillcolor="#ffe08a"];
    "theo:exists_no_circuit_other" [label="theo:exists_no_circuit_other\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "def:syracuse_cycle_period_denote" [label="def:syracuse_cycle_period_denote\n", shape=box, fillcolor="#ffe08a"];
    "lem:syracuse_cycle_n__n_" [label="lem:syracuse_cycle_n__n_\n", shape=ellipse, fillcolor="#ffe08a"];
    "lem:syracuse_cycle" [label="lem:syracuse_cycle\n", shape=ellipse, fillcolor="#ffe08a"];
    "cor:intertwined_i_" [label="cor:intertwined_i_\n", shape=ellipse, fillcolor="#ffe08a"];
    "theo:steiner_2" [label="theo:steiner_2\nSteiner", shape=doubleoctagon, fillcolor="#ffffff"];
    "theo:syracuse_cycle" [label="theo:syracuse_cycle\n", shape=doubleoctagon, fillcolor="#ffffff"];
  }
  "theo:rep" -> "lem:base";
  "cor:ring_following_equivalent_enumerate" -> "theo:rep";
  "lem:one_has" -> "lem:base";
  "prop:have_gcd_n__l_k" -> "lem:base";
  "prop:proposition" -> "cor:bounds";
  subgraph "cluster_legend" {
    label="legend"; color="#cccccc"; fontsize=10;
    l0 [label="closed in Lean", fillcolor="#b7e4c7", shape=box];
    l1 [label="stated, partial", fillcolor="#ffe08a", shape=box];
    l2 [label="scaffold", fillcolor="#ffd6a5", shape=box];
    l3 [label="no Lean", fillcolor="#ffffff", shape=box];
    l0 -> l1 -> l2 -> l3 [style=invis];
  }
}
