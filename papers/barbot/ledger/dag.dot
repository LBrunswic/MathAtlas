digraph formalization {
  rankdir=BT; node [style=filled,fontname="Helvetica",fontsize=9];
  edge [color="#888888",arrowsize=0.6];
  subgraph "cluster_P" {
    label="P"; color="#cccccc";
    "bthm:caucomp" [label="bthm:caucomp\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "bthm:cauclo" [label="bthm:cauclo\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "bprop:laoucapulse" [label="bprop:laoucapulse\n", shape=ellipse, fillcolor="#ffffff"];
    "bdef:omega_lambda" [label="bdef:omega_lambda\n", shape=box, fillcolor="#ffffff"];
    "bdef:regular_domain" [label="bdef:regular_domain\n", shape=box, fillcolor="#ffffff"];
    "blem:fermons" [label="blem:fermons\n", shape=ellipse, fillcolor="#ffffff"];
    "bcor:closeregular" [label="bcor:closeregular\n", shape=ellipse, fillcolor="#ffffff"];
    "blem:closecool" [label="blem:closecool\n", shape=ellipse, fillcolor="#ffffff"];
    "blem:fermonsbis" [label="blem:fermonsbis\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:regular_iff_bounded" [label="bprop:regular_iff_bounded\n", shape=ellipse, fillcolor="#ffffff"];
    "bcor:futetpast" [label="bcor:futetpast\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:lip" [label="bprop:lip\n", shape=ellipse, fillcolor="#ffffff"];
    "bcor:level_sets_complete" [label="bcor:level_sets_complete\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:regular_cauchy_complete" [label="bprop:regular_cauchy_complete\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:agissons" [label="bprop:agissons\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:admlox" [label="bprop:admlox\n", shape=ellipse, fillcolor="#ffffff"];
    "bdef:definitioncauchyhyp" [label="bdef:definitioncauchyhyp\n", shape=box, fillcolor="#ffffff"];
    "blem:admissible_cone" [label="blem:admissible_cone\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:tri" [label="bprop:tri\n", shape=ellipse, fillcolor="#ffffff"];
    "bdef:geometrically_finite" [label="bdef:geometrically_finite\n", shape=box, fillcolor="#ffffff"];
    "bthm:convex_cocompact" [label="bthm:convex_cocompact\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "bthm:ausl" [label="bthm:ausl\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "bthm:unip" [label="bthm:unip\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "blem:suspendre" [label="blem:suspendre\n", shape=ellipse, fillcolor="#ffffff"];
    "blem:paranongh" [label="blem:paranongh\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:project" [label="bprop:project\n", shape=ellipse, fillcolor="#ffffff"];
    "bcor:quo" [label="bcor:quo\n", shape=ellipse, fillcolor="#ffffff"];
    "bcor:quoiso" [label="bcor:quoiso\n", shape=ellipse, fillcolor="#ffffff"];
    "bcor:abel" [label="bcor:abel\n", shape=ellipse, fillcolor="#ffffff"];
    "bdef:U_g" [label="bdef:U_g\n", shape=box, fillcolor="#ffffff"];
    "blem:SdanU" [label="blem:SdanU\n", shape=ellipse, fillcolor="#ffffff"];
    "bdef:omega_gamma" [label="bdef:omega_gamma\n", shape=box, fillcolor="#ffffff"];
    "bprop:ghyp" [label="bprop:ghyp\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:splitting" [label="bprop:splitting\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:danom" [label="bprop:danom\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:sanloxo" [label="bprop:sanloxo\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:limites" [label="bprop:limites\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:extension" [label="bprop:extension\n", shape=ellipse, fillcolor="#ffffff"];
    "blem:sanlox" [label="blem:sanlox\n", shape=ellipse, fillcolor="#ffffff"];
    "blem:loxregular" [label="blem:loxregular\n", shape=ellipse, fillcolor="#ffffff"];
    "bcor:loxo_proper" [label="bcor:loxo_proper\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:U_timelike" [label="bprop:U_timelike\n", shape=ellipse, fillcolor="#ffffff"];
    "bprop:LU_discrete" [label="bprop:LU_discrete\n", shape=ellipse, fillcolor="#ffffff"];
    "bthm:cmc" [label="bthm:cmc\n", shape=doubleoctagon, fillcolor="#ffffff"];
  }
  subgraph "cluster_legend" {
    label="legend"; color="#cccccc"; fontsize=10;
    l0 [label="closed in Lean", fillcolor="#b7e4c7", shape=box];
    l1 [label="stated, partial", fillcolor="#ffe08a", shape=box];
    l2 [label="scaffold", fillcolor="#ffd6a5", shape=box];
    l3 [label="no Lean", fillcolor="#ffffff", shape=box];
    l0 -> l1 -> l2 -> l3 [style=invis];
  }
}
