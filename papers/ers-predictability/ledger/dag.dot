digraph formalization {
  rankdir=BT; node [style=filled,fontname="Helvetica",fontsize=9];
  edge [color="#888888",arrowsize=0.6];
  subgraph "cluster_P" {
    label="Predictability of subluminal and superluminal wave equations (one file)"; color="#cccccc";
    "ersthm:diffeo_theorem" [label="ersthm:diffeo_theorem\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "erslem:nec_cond" [label="erslem:nec_cond\n", shape=ellipse, fillcolor="#ffffff"];
    "erslem:lemma_sing" [label="erslem:lemma_sing\n", shape=ellipse, fillcolor="#ffffff"];
    "erslem:grhosigma" [label="erslem:grhosigma\n", shape=ellipse, fillcolor="#ffffff"];
    "erslem:lemma_orientation" [label="erslem:lemma_orientation\n", shape=ellipse, fillcolor="#ffffff"];
    "erslem:glob_hyp_lemma" [label="erslem:glob_hyp_lemma\n", shape=ellipse, fillcolor="#ffffff"];
    "erslem:sep_lemma" [label="erslem:sep_lemma\n", shape=ellipse, fillcolor="#ffffff"];
    "ersthm:global_theorem" [label="ersthm:global_theorem\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "erslem:solution_theorem_global_theorem" [label="erslem:solution_theorem_global_theorem\n", shape=ellipse, fillcolor="#ffffff"];
    "ersthm:ThmNonUniqueness" [label="ersthm:ThmNonUniqueness\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "ersrem:emphasise_two_ghds_constructed" [label="ersrem:emphasise_two_ghds_constructed\n", shape=note, fillcolor="#ffffff"];
    "ersrem:note_two_ghds_constructed" [label="ersrem:note_two_ghds_constructed\n", shape=note, fillcolor="#ffffff"];
    "ersrem:initial_data_constructed_proof" [label="ersrem:initial_data_constructed_proof\n", shape=note, fillcolor="#ffffff"];
    "ersrem:RemCutOff" [label="ersrem:RemCutOff\n", shape=note, fillcolor="#ffffff"];
    "ersprop:PropLocUniqueness" [label="ersprop:PropLocUniqueness\nLocal uniqueness", shape=ellipse, fillcolor="#ffffff"];
    "ersthm:ThmUnique" [label="ersthm:ThmUnique\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "ersrem:RemTime" [label="ersrem:RemTime\n", shape=note, fillcolor="#ffffff"];
    "erscor:CorDisCon" [label="erscor:CorDisCon\n", shape=ellipse, fillcolor="#ffffff"];
    "erscor:globally_defined_globally_hyperbolic" [label="erscor:globally_defined_globally_hyperbolic\n", shape=ellipse, fillcolor="#ffffff"];
    "erslem:LemConnected" [label="erslem:LemConnected\n", shape=ellipse, fillcolor="#ffffff"];
    "erscor:CorSupLum" [label="erscor:CorSupLum\n", shape=ellipse, fillcolor="#ffffff"];
    "erslem:two_ghds_subluminal_quasilinear" [label="erslem:two_ghds_subluminal_quasilinear\n", shape=ellipse, fillcolor="#ffffff"];
    "erscor:CorUniqueSub" [label="erscor:CorUniqueSub\n", shape=ellipse, fillcolor="#ffffff"];
    "ersrem:us_remark_better_bounds" [label="ersrem:us_remark_better_bounds\n", shape=note, fillcolor="#ffffff"];
    "ersthm:ThmEx" [label="ersthm:ThmEx\nLocal existence", shape=doubleoctagon, fillcolor="#ffffff"];
    "ersthm:ThmUMGHD" [label="ersthm:ThmUMGHD\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "ersrem:RemMGHD" [label="ersrem:RemMGHD\n", shape=note, fillcolor="#ffffff"];
    "ersthm:ThmMUGHD" [label="ersthm:ThmMUGHD\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "ersthm:consider_subluminal_quasilinear_wave" [label="ersthm:consider_subluminal_quasilinear_wave\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "ersconj:ConUni" [label="ersconj:ConUni\n", shape=ellipse, fillcolor="#ffffff"];
    "ersthm:ThmNotBlocking" [label="ersthm:ThmNotBlocking\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "erslem:PropertyTimelike" [label="erslem:PropertyTimelike\n", shape=ellipse, fillcolor="#ffffff"];
  }
  "erslem:grhosigma" -> "ersthm:diffeo_theorem";
  "erslem:lemma_orientation" -> "ersthm:diffeo_theorem";
  "erslem:lemma_orientation" -> "erslem:grhosigma";
  "erslem:glob_hyp_lemma" -> "ersthm:diffeo_theorem";
  "erslem:glob_hyp_lemma" -> "erslem:grhosigma";
  "erslem:sep_lemma" -> "erslem:glob_hyp_lemma";
  "ersthm:global_theorem" -> "ersthm:diffeo_theorem";
  "erslem:solution_theorem_global_theorem" -> "ersthm:global_theorem";
  "erslem:solution_theorem_global_theorem" -> "erslem:glob_hyp_lemma";
  "erslem:solution_theorem_global_theorem" -> "erslem:lemma_orientation";
  "ersthm:ThmNonUniqueness" -> "ersthm:diffeo_theorem";
  "ersthm:ThmNonUniqueness" -> "erslem:glob_hyp_lemma";
  "ersthm:ThmNonUniqueness" -> "erslem:lemma_sing";
  "ersrem:emphasise_two_ghds_constructed" -> "ersthm:ThmNonUniqueness";
  "ersrem:note_two_ghds_constructed" -> "ersthm:ThmNonUniqueness";
  "ersrem:initial_data_constructed_proof" -> "ersthm:ThmNonUniqueness";
  "ersthm:ThmUnique" -> "ersprop:PropLocUniqueness";
  "ersrem:RemTime" -> "ersthm:ThmUnique";
  "erscor:CorSupLum" -> "erslem:LemConnected";
  "erscor:CorSupLum" -> "ersthm:ThmUnique";
  "ersthm:ThmEx" -> "ersthm:ThmUnique";
  "ersthm:ThmEx" -> "ersrem:RemTime";
  "ersthm:ThmUMGHD" -> "ersthm:ThmEx";
  "ersthm:ThmUMGHD" -> "erscor:CorSupLum";
  "ersthm:ThmUMGHD" -> "ersrem:RemTime";
  "ersthm:ThmMUGHD" -> "ersthm:ThmEx";
  "ersthm:ThmMUGHD" -> "erscor:CorUniqueSub";
  "ersthm:ThmMUGHD" -> "ersthm:ThmUMGHD";
  "ersthm:consider_subluminal_quasilinear_wave" -> "ersthm:ThmMUGHD";
  "ersthm:consider_subluminal_quasilinear_wave" -> "erscor:CorUniqueSub";
  "ersthm:consider_subluminal_quasilinear_wave" -> "ersrem:RemMGHD";
  "ersthm:consider_subluminal_quasilinear_wave" -> "ersthm:ThmUMGHD";
  "ersthm:ThmNotBlocking" -> "ersthm:ThmUnique";
  "ersthm:ThmNotBlocking" -> "ersrem:RemTime";
  subgraph "cluster_legend" {
    label="legend"; color="#cccccc"; fontsize=10;
    l0 [label="closed in Lean", fillcolor="#b7e4c7", shape=box];
    l1 [label="stated, partial", fillcolor="#ffe08a", shape=box];
    l2 [label="scaffold", fillcolor="#ffd6a5", shape=box];
    l3 [label="no Lean", fillcolor="#ffffff", shape=box];
    l0 -> l1 -> l2 -> l3 [style=invis];
  }
}
