digraph formalization {
  rankdir=BT; node [style=filled,fontname="Helvetica",fontsize=9];
  edge [color="#888888",arrowsize=0.6];
  subgraph "cluster_P" {
    label="P"; color="#cccccc";
    "bzthm:intro_A" [label="bzthm:intro_A\nA", shape=doubleoctagon, fillcolor="#ffffff"];
    "bzthm:intro_B" [label="bzthm:intro_B\nB", shape=doubleoctagon, fillcolor="#ffffff"];
    "bzthm:intro_C" [label="bzthm:intro_C\nC", shape=doubleoctagon, fillcolor="#ffffff"];
    "bzdef:c1s1d1_espace_affin" [label="bzdef:c1s1d1_espace_affin\n1", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d2_application_affine" [label="bzdef:c1s1d2_application_affine\n2", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d3_sphere" [label="bzdef:c1s1d3_sphere\n3", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d4_sous_variete_lineaire" [label="bzdef:c1s1d4_sous_variete_lineaire\n4", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d5_hemisphere" [label="bzdef:c1s1d5_hemisphere\n5", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d6_structure_affine_hemisphere" [label="bzdef:c1s1d6_structure_affine_hemisphere\n6", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d7_segment" [label="bzdef:c1s1d7_segment\n7", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d8_partie_convexe" [label="bzdef:c1s1d8_partie_convexe\n8", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d9_convexe_strict" [label="bzdef:c1s1d9_convexe_strict\n9", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d10_quotient" [label="bzdef:c1s1d10_quotient\n10", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d11_corps_convexe" [label="bzdef:c1s1d11_corps_convexe\n11", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d12_variete_localement_projective" [label="bzdef:c1s1d12_variete_localement_projective\n12", shape=box, fillcolor="#b7e4c7"];
    "bzrem:c1s1r1_affine_vers_projective" [label="bzrem:c1s1r1_affine_vers_projective\n", shape=note, fillcolor="#b7e4c7"];
    "bzdef:c1s1d13_carte_compatible" [label="bzdef:c1s1d13_carte_compatible\n13", shape=box, fillcolor="#b7e4c7"];
    "bzprop:c1s1p1_cartes_compatibles" [label="bzprop:c1s1p1_cartes_compatibles\n1", shape=ellipse, fillcolor="#b7e4c7"];
    "bzprop:c1s1p2_developpement" [label="bzprop:c1s1p2_developpement\n2", shape=ellipse, fillcolor="#b7e4c7"];
    "bzprop:c1s1p3_atlas" [label="bzprop:c1s1p3_atlas\n3", shape=ellipse, fillcolor="#b7e4c7"];
    "bzdef:c1s1d14_segment_variete" [label="bzdef:c1s1d14_segment_variete\n14", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s1d15_homogene_balayable_divisible" [label="bzdef:c1s1d15_homogene_balayable_divisible\n15", shape=box, fillcolor="#b7e4c7"];
    "bzthm:c1s1_revetement_universel_divisible" [label="bzthm:c1s1_revetement_universel_divisible\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "bzdef:c1s1d16_maximale" [label="bzdef:c1s1d16_maximale\n16", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s2d1_cone_ouvert" [label="bzdef:c1s2d1_cone_ouvert\n1", shape=box, fillcolor="#b7e4c7"];
    "bzdef:c1s2d2_variete_conique_affine" [label="bzdef:c1s2d2_variete_conique_affine\n2", shape=box, fillcolor="#b7e4c7"];
    "bzprop:c1s2p1_atlas_conique" [label="bzprop:c1s2p1_atlas_conique\n1", shape=ellipse, fillcolor="#b7e4c7"];
    "bzdef:c1s2d3_homotheties_positives" [label="bzdef:c1s2d3_homotheties_positives\n3", shape=box, fillcolor="#b7e4c7"];
    "bzprop:c1s2p2_base_cone" [label="bzprop:c1s2p2_base_cone\n2", shape=ellipse, fillcolor="#b7e4c7"];
    "bzthm:c1s2_isomorphisme_fonctoriel" [label="bzthm:c1s2_isomorphisme_fonctoriel\n", shape=doubleoctagon, fillcolor="#ffd6a5"];
    "bzprop:c1s3p1_F_homogene" [label="bzprop:c1s3p1_F_homogene\n1", shape=ellipse, fillcolor="#ffffff"];
    "bzcor:c1s3p1c_produit_cercle" [label="bzcor:c1s3p1c_produit_cercle\n", shape=ellipse, fillcolor="#ffffff"];
    "bzdef:c1s3d1_produit_cones" [label="bzdef:c1s3d1_produit_cones\n1", shape=box, fillcolor="#ffffff"];
    "bzprop:c1s3p2_fibre_produit" [label="bzprop:c1s3p2_fibre_produit\n2", shape=ellipse, fillcolor="#ffffff"];
    "bzprop:c1s3p3_produit_homogene" [label="bzprop:c1s3p3_produit_homogene\n3", shape=ellipse, fillcolor="#ffffff"];
    "bzcor:c1s3p3c_produit_projectif" [label="bzcor:c1s3p3c_produit_projectif\n", shape=ellipse, fillcolor="#ffffff"];
    "bzdef:c1s3d2_automorphisme_compatible" [label="bzdef:c1s3d2_automorphisme_compatible\n2", shape=box, fillcolor="#ffffff"];
    "bzprop:c1s3p4_reciproque" [label="bzprop:c1s3p4_reciproque\n4", shape=ellipse, fillcolor="#ffffff"];
  }
  "bzthm:intro_A" -> "bzcor:c1s3p1c_produit_cercle";
  "bzthm:intro_A" -> "bzcor:c1s3p3c_produit_projectif";
  "bzthm:intro_B" -> "bzdef:c1s1d11_corps_convexe";
  "bzprop:c1s1p1_cartes_compatibles" -> "bzdef:c1s1d12_variete_localement_projective";
  "bzdef:c1s1d14_segment_variete" -> "bzdef:c1s1d7_segment";
  "bzdef:c1s2d2_variete_conique_affine" -> "bzdef:c1s1d13_carte_compatible";
  "bzprop:c1s3p1_F_homogene" -> "bzdef:c1s1d15_homogene_balayable_divisible";
  "bzprop:c1s3p4_reciproque" -> "bzdef:c1s3d2_automorphisme_compatible";
  subgraph "cluster_legend" {
    label="legend"; color="#cccccc"; fontsize=10;
    l0 [label="closed in Lean", fillcolor="#b7e4c7", shape=box];
    l1 [label="stated, partial", fillcolor="#ffe08a", shape=box];
    l2 [label="scaffold", fillcolor="#ffd6a5", shape=box];
    l3 [label="no Lean", fillcolor="#ffffff", shape=box];
    l0 -> l1 -> l2 -> l3 [style=invis];
  }
}
