  "bzdef:c1s2d2_variete_conique_affine" -> "bzdef:c1s1d13_carte_compatible";
  "bzprop:c1s3p1_F_homogene" -> "bzdef:c1s1d15_homogene_balayable_divisible";
  "bzprop:c1s3p4_reciproque" -> "bzdef:c1s3d2_automorphisme_compatible";
  "bzdef:c2s1d1_poche_affine" -> "bzdef:c1s1d14_segment_variete";
  "bzdef:c2s1d1_poche_affine" -> "bzprop:c1s1p1_cartes_compatibles";
  "bzdef:c2s1d1prime_poche_projective" -> "bzdef:c1s1d6_structure_affine_hemisphere";
  "bzrem:c2s1r0_poche_affine_vers_projective" -> "bzrem:c1s1r1_affine_vers_projective";
  "bzthm:c2s2_proprietes_pseudo_longueur" -> "bzdef:c2s2d2_segment_majore";
