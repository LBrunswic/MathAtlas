    "bzprop:c2s2p2_pseudo_longueur_corps_convexe" [label="bzprop:c2s2p2_pseudo_longueur_corps_convexe\n2", shape=ellipse, fillcolor="#ffffff"];
    "bzdef:c2s2d4_partie_majoree" [label="bzdef:c2s2d4_partie_majoree\n4", shape=box, fillcolor="#b7e4c7"];
