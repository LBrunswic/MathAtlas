  "bzthm:c2s2_proprietes_pseudo_longueur" -> "bzdef:c2s1d1prime_poche_projective";
  "bzprop:c2s2p3_voisinage_majore" -> "bzthm:c2s2_proprietes_pseudo_longueur";
  "bzprop:c2s2p6_ligne_brisee_poche" -> "bzthm:c2s2_proprietes_pseudo_longueur";
  "bzprop:c2s2p7_compact_dans_poche" -> "bzdef:c1s1d15_homogene_balayable_divisible";
