  "bzthm:c2s3t1_poche_balayable" -> "bzdef:c2s1d1prime_poche_projective";
  "bzthm:c2s3t2_poche_balayable_affine" -> "bzthm:c2s3t1_poche_balayable";
  "bzprop:c2s3p2_hemisphere_corps_convexe" -> "bzthm:c2s3t1_poche_balayable";
  "bzprop:c2s3p2_hemisphere_corps_convexe" -> "bzdef:c2s2d5_nombre_recouvrement";
  "bzprop:c2s3p2_hemisphere_corps_convexe" -> "bzprop:c2s2p5_ouvert_plein";
  subgraph "cluster_legend" {
    label="legend"; color="#cccccc"; fontsize=10;
    l0 [label="closed in Lean", fillcolor="#b7e4c7", shape=box];
    l1 [label="stated, partial", fillcolor="#ffe08a", shape=box];
    l2 [label="scaffold", fillcolor="#ffd6a5", shape=box];
    l3 [label="no Lean", fillcolor="#ffffff", shape=box];
    l0 -> l1 -> l2 -> l3 [style=invis];
  }
}
