digraph formalization {
  rankdir=BT; node [style=filled,fontname="Helvetica",fontsize=9];
  edge [color="#888888",arrowsize=0.6];
  subgraph "cluster_P" {
    label="Ergodic Generative Flows (body and appendices, one file)"; color="#cccccc";
    "theo:sampling_theorem" [label="theo:sampling_theorem\n[bengio2021flow]", shape=doubleoctagon, fillcolor="#ffffff"];
    "def:egf" [label="def:egf\nErgodic Generative Flows", shape=box, fillcolor="#ffe08a"];
    "def:universal_family" [label="def:universal_family\n", shape=box, fillcolor="#ffe08a"];
    "def:summably_mixing" [label="def:summably_mixing\n", shape=box, fillcolor="#b7e4c7"];
    "theo:universality" [label="theo:universality\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "theo:universality_tori" [label="theo:universality_tori\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "theo:universality_sphere" [label="theo:universality_sphere\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "def:virtual_flows" [label="def:virtual_flows\nVirtual initial and terminal", shape=box, fillcolor="#ffffff"];
    "theo:negative_control" [label="theo:negative_control\nQuantitative Sampling of Gen", shape=doubleoctagon, fillcolor="#ffffff"];
    "cor:sampling_error_control" [label="cor:sampling_error_control\n", shape=ellipse, fillcolor="#ffffff"];
    "cor:pinsker_negative_control" [label="cor:pinsker_negative_control\n", shape=ellipse, fillcolor="#ffffff"];
    "theo:backward_policy" [label="theo:backward_policy\n", shape=doubleoctagon, fillcolor="#ffffff"];
    "theo:universality_true" [label="theo:universality_true\n", shape=doubleoctagon, fillcolor="#b7e4c7"];
    "theo:spectral_gap_tori" [label="theo:spectral_gap_tori\nTheorem 5 of [bekka2015spect", shape=doubleoctagon, fillcolor="#ffffff"];
    "theo:spectral_gap_sphere" [label="theo:spectral_gap_sphere\nReformulation of Theorem 1 o", shape=doubleoctagon, fillcolor="#ffffff"];
    "theo:negative_control_appendix" [label="theo:negative_control_appendix\n", shape=doubleoctagon, fillcolor="#ffffff"];
  }
  subgraph "cluster_legend" {
    label="legend"; color="#cccccc"; fontsize=10;
    l0 [label="closed in Lean", fillcolor="#b7e4c7", shape=box];
    l1 [label="stated, partial", fillcolor="#ffe08a", shape=box];
    l2 [label="scaffold", fillcolor="#ffd6a5", shape=box];
    l3 [label="no Lean", fillcolor="#ffffff", shape=box];
    l0 -> l1 -> l2 -> l3 [style=invis];
  }
}
