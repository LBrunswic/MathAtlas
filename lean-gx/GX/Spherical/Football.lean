/-! ### The half-turn `(t, w) ↦ (−t, w̄)` of `𝕊²` -/

section HalfTurn

/-- The linear isometry `(t, w) ↦ (−t, w̄)` of `ℝ ⊕ ℂ`. -/
def flipIsom : Euc3 ≃ₗᵢ[ℝ] Euc3 where
  toLinearEquiv := (WithLp.linearEquiv 2 ℝ (ℝ × ℂ)).trans
    (((LinearEquiv.neg ℝ).prodCongr Complex.conjLIE.toLinearEquiv).trans
      (WithLp.linearEquiv 2 ℝ (ℝ × ℂ)).symm)
  norm_map' x := by
    rw [WithLp.prod_norm_eq_of_L2, WithLp.prod_norm_eq_of_L2]
    simp

theorem flipIsom_apply (x : Euc3) :
    flipIsom x = WithLp.toLp 2 (-x.fst, (starRingEnd ℂ) x.snd) :=
  rfl

theorem det_flipIsom : LinearMap.det (flipIsom.toLinearEquiv : Euc3 →ₗ[ℝ] Euc3) = 1 := by
  set e := (WithLp.linearEquiv 2 ℝ (ℝ × ℂ)).symm
  have : (flipIsom.toLinearEquiv : Euc3 →ₗ[ℝ] Euc3) =
      (e : (ℝ × ℂ) →ₗ[ℝ] Euc3) ∘ₗ
        (LinearMap.prodMap (-LinearMap.id) (Complex.conjLIE.toLinearEquiv : ℂ →ₗ[ℝ] ℂ)) ∘ₗ
          (e.symm : Euc3 →ₗ[ℝ] (ℝ × ℂ)) := by
    ext x
    all_goals rfl
  rw [this, LinearMap.det_conj, LinearMap.det_prodMap, Complex.det_conjLIE]
  simp

/-- **The half-turn** about the first equatorial axis, `(t, w) ↦ (−t, w̄)`, an element of
`SO(3)`: in the stereographic chart it reads `v ↦ 1/v` (`halfTurn_smul_stereoInv`), and it
exchanges the poles. -/
def halfTurn : SO3 := ⟨flipIsom, det_flipIsom⟩

theorem coe_halfTurn_smul (y : Sph2) : ((halfTurn • y : Sph2) : Euc3) = flipIsom y := rfl

theorem halfTurn_mul_self : halfTurn * halfTurn = 1 := by
  refine Subtype.ext (LinearIsometryEquiv.ext fun x => ?_)
  show flipIsom (flipIsom x) = x
  rw [flipIsom_apply, flipIsom_apply]
  simp only [WithLp.fst, WithLp.snd, neg_neg, Complex.conj_conj]

theorem halfTurn_smul_halfTurn_smul (y : Sph2) : halfTurn • halfTurn • y = y := by
  rw [← mul_smul, halfTurn_mul_self, one_smul]

/-- **The half-turn reads `v ↦ 1/v`** in the stereographic chart. -/
theorem halfTurn_smul_stereoInv {v : ℂ} (hv : v ≠ 0) :
    halfTurn • stereoInv v = stereoInv v⁻¹ := by
  refine Subtype.ext ?_
  rw [coe_halfTurn_smul, flipIsom_apply, stereoInv_fst, stereoInv_snd]
  show _ = WithLp.toLp 2 ((1 - ‖v⁻¹‖ ^ 2) / (1 + ‖v⁻¹‖ ^ 2), (2 / (1 + ‖v⁻¹‖ ^ 2)) • v⁻¹)
  have hn : 0 < ‖v‖ := norm_pos_iff.2 hv
  congr 1
  refine Prod.ext ?_ ?_
  · simp only [norm_inv]
    field_simp
    ring
  · simp only [norm_inv, Complex.real_smul, map_mul, Complex.conj_ofReal]
    rw [Complex.inv_def, Complex.normSq_eq_norm_sq]
    push_cast
    have hn' : ((‖v‖ : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.2 hn.ne'
    field_simp
    rw [add_comm]

/-- The south pole `(−1, 0)` of `𝕊²`, the image of the north pole by the half-turn. -/
def southPole : Sph2 := halfTurn • northPole

theorem southPole_fst : (southPole : Euc3).fst = -1 := by
  show (flipIsom (WithLp.toLp 2 ((1 : ℝ), (0 : ℂ)))).fst = -1
  rw [flipIsom_apply]
  rfl

theorem halfTurn_smul_southPole : halfTurn • southPole = northPole :=
  halfTurn_smul_halfTurn_smul _

theorem northPole_ne_southPole : (northPole : Sph2) ≠ southPole := by
  intro h
  have h1 : ((northPole : Sph2) : Euc3).fst = 1 := rfl
  rw [h, southPole_fst] at h1
  norm_num at h1

/-- A point of `𝕊²` with polar coordinate `−1` is the south pole. -/
theorem eq_southPole_of_fst {y : Sph2} (h : (y : Euc3).fst = -1) : y = southPole := by
  have hn := norm_polarSum_sq (y : Euc3)
  rw [norm_raySphere, h] at hn
  have hs : ‖(y : Euc3).snd‖ = 0 := by nlinarith [norm_nonneg (y : Euc3).snd]
  rw [norm_eq_zero] at hs
  refine Subtype.ext ?_
  apply WithLp.ofLp_injective 2
  refine Prod.ext ?_ ?_
  · show (y : Euc3).fst = (southPole : Euc3).fst
    rw [h, southPole_fst]
  · show (y : Euc3).snd = (flipIsom (WithLp.toLp 2 ((1 : ℝ), (0 : ℂ)))).snd
    rw [hs, flipIsom_apply]
    simp

/-- The inverse stereographic projection `ℂ → 𝕊²` from the south pole misses only it. -/
theorem range_stereoInv : range (stereoInv : ℂ → Sph2) = {southPole}ᶜ := by
  ext y
  constructor
  · rintro ⟨v, rfl⟩ h
    exact stereoInv_fst_ne v (by rw [h, southPole_fst])
  · intro hy
    refine ⟨stereoFun y, stereoInv_stereoFun y fun h => hy (eq_southPole_of_fst h)⟩

end HalfTurn

/-! ### The football as a space, its polar parametrisation -/

section FootballSpace

/-- **The football of angle `θ`**, as a space: the round sphere `𝕊²`. Its singular
`(SO(3), 𝕊²)`-structure (`footballSingularGXStructure`) has the two cone points `N`, `S` of
angle `θ`. -/
def Football (_θ : ConeAngle) : Type := Sph2

variable (θ : ConeAngle)

instance : TopologicalSpace (Football θ) := inferInstanceAs (TopologicalSpace Sph2)

instance : T2Space (Football θ) := inferInstanceAs (T2Space Sph2)

instance : LocallyConnectedSpace (Football θ) := inferInstanceAs (LocallyConnectedSpace Sph2)

instance : SecondCountableTopology (Football θ) :=
  inferInstanceAs (SecondCountableTopology Sph2)

instance : ConnectedSpace (Football θ) := inferInstanceAs (ConnectedSpace Sph2)

/-- The underlying point of `𝕊²`. -/
def Football.toSph2 (y : Football θ) : Sph2 := y

/-- A point of `𝕊²` as a point of the football. -/
def Football.ofSph2 (y : Sph2) : Football θ := y

/-- `F_θ` is `𝕊²` as a space. -/
def Football.homeoSph2 : Football θ ≃ₜ Sph2 := Homeomorph.refl Sph2

/-- The north pole of the football: the apex of the first copy of `C_θ`. -/
def Football.north : Football θ := Football.ofSph2 θ northPole

/-- The south pole of the football: the apex of the second copy of `C_θ`. -/
def Football.south : Football θ := Football.ofSph2 θ southPole

theorem Football.north_ne_south : Football.north θ ≠ Football.south θ := northPole_ne_southPole

/-- **The embedding `C_θ → F_θ`**: `C_θ ≅ ℂ` (cylindrical coordinates `(r, φ) ↦ r e^{2πiφ}`)
followed by the inverse stereographic projection; the apex goes to the north pole, the image is
`𝕊² ∖ {S}`. -/
def footballEmb (c : SphCone θ) : Football θ :=
  Football.ofSph2 θ (stereoInv (SphCone.homeoComplex θ c))

theorem isOpenEmbedding_footballEmb : IsOpenEmbedding (footballEmb θ) :=
  (isOpenEmbedding_stereoInv (W := ℂ)).comp (SphCone.homeoComplex θ).isOpenEmbedding

theorem footballEmb_apex : footballEmb θ (SphCone.apex θ) = Football.north θ := by
  show Football.ofSph2 θ (stereoInv (DInfty.cplx 1 DInfty.apex)) = Football.ofSph2 θ northPole
  rw [DInfty.cplx_apex, stereoInv_zero]

theorem range_footballEmb : range (footballEmb θ) = {Football.south θ}ᶜ := by
  show range (stereoInv ∘ SphCone.homeoComplex θ) = ({southPole}ᶜ : Set Sph2)
  rw [(SphCone.homeoComplex θ).surjective.range_comp, range_stereoInv]

/-- **The half-turn of the football**, an involution exchanging the poles. -/
def footballFlip : Football θ ≃ₜ Football θ where
  toFun y := Football.ofSph2 θ (halfTurn • Football.toSph2 θ y)
  invFun y := Football.ofSph2 θ (halfTurn • Football.toSph2 θ y)
  left_inv y := halfTurn_smul_halfTurn_smul (Football.toSph2 θ y)
  right_inv y := halfTurn_smul_halfTurn_smul (Football.toSph2 θ y)
  continuous_toFun := continuous_const_smul (T := Sph2) halfTurn
  continuous_invFun := continuous_const_smul (T := Sph2) halfTurn

theorem footballFlip_apply (y : Football θ) :
    footballFlip θ y = Football.ofSph2 θ (halfTurn • Football.toSph2 θ y) := rfl

theorem footballFlip_footballFlip (y : Football θ) : footballFlip θ (footballFlip θ y) = y :=
  halfTurn_smul_halfTurn_smul (Football.toSph2 θ y)

theorem footballFlip_north : footballFlip θ (Football.north θ) = Football.south θ := rfl

theorem footballFlip_south : footballFlip θ (Football.south θ) = Football.north θ :=
  halfTurn_smul_southPole

/-- The open half-plane `{r > 0}`, the polar coordinates of `𝕊² ∖ {N, S}`. -/
abbrev PolarHalfPlane : Type := {q : ℝ × ℝ // 0 < q.1}

/-- The inversion `(r, φ) ↦ (1/r, −φ)` of the half-plane. -/
def polarHalfPlaneInv (q : PolarHalfPlane) : PolarHalfPlane := ⟨(q.1.1⁻¹, -q.1.2), inv_pos.2 q.2⟩

theorem continuous_polarHalfPlaneInv : Continuous polarHalfPlaneInv :=
  (((continuous_fst.comp continuous_subtype_val).inv₀ fun q : PolarHalfPlane => q.2.ne').prodMk
    (continuous_snd.comp continuous_subtype_val).neg).subtype_mk _

/-- The point `(posEmb q, ())` of the cover `𝔻_∞ × {*}` of `C_θ`. -/
def polarHalfPlaneLift (q : PolarHalfPlane) : DInfty × Unit := (DInfty.posEmb q, ())

theorem continuous_polarHalfPlaneLift : Continuous polarHalfPlaneLift :=
  DInfty.continuous_posEmb.prodMk continuous_const

/-- **The polar parametrisation** of `𝕊² ∖ {N, S}`: `(r, φ) ↦ stereoInv(r e^{2πiφ})`. -/
def footballPolar (q : PolarHalfPlane) : Football θ :=
  Football.ofSph2 θ (stereoInv (DInfty.cplx 1 (DInfty.posEmb q)))

theorem footballEmb_mk (q : PolarHalfPlane) :
    footballEmb θ (SphCone.mk θ (polarHalfPlaneLift q)) = footballPolar θ q := rfl

theorem isOpenMap_footballPolar : IsOpenMap (footballPolar θ) :=
  (isOpenEmbedding_stereoInv (W := ℂ)).isOpenMap.comp
    ((DInfty.isOpenMap_cplx one_ne_zero).comp DInfty.isOpenMap_posEmb)

theorem cplx_posEmb_polarHalfPlaneInv (α : ℝ) (q : PolarHalfPlane) :
    DInfty.cplx α (DInfty.posEmb (polarHalfPlaneInv q)) = (DInfty.cplx α (DInfty.posEmb q))⁻¹ := by
  simp only [DInfty.cplx, DInfty.posEmb_r, DInfty.posEmb_θ, polarHalfPlaneInv, mul_inv,
    ← Complex.exp_neg]
  push_cast
  ring_nf

/-- The half-turn in polar coordinates: `(r, φ) ↦ (1/r, −φ)`. -/
theorem footballFlip_polar (q : PolarHalfPlane) :
    footballFlip θ (footballPolar θ q) = footballPolar θ (polarHalfPlaneInv q) := by
  have hne : DInfty.cplx 1 (DInfty.posEmb q) ≠ 0 := by
    rw [← norm_pos_iff, DInfty.norm_cplx]; exact q.2
  show Football.ofSph2 θ (halfTurn • stereoInv (DInfty.cplx 1 (DInfty.posEmb q))) =
    Football.ofSph2 θ (stereoInv (DInfty.cplx 1 (DInfty.posEmb (polarHalfPlaneInv q))))
  rw [halfTurn_smul_stereoInv hne, cplx_posEmb_polarHalfPlaneInv]

/-- The developing map of `C_θ` intertwines `(r, φ) ↦ (1/r, −φ)` and the half-turn. -/
theorem halfTurn_smul_sphConeDev (q : PolarHalfPlane) :
    halfTurn • sphConeDev θ.1 (polarHalfPlaneLift q) =
      sphConeDev θ.1 (polarHalfPlaneLift (polarHalfPlaneInv q)) := by
  have hne : DInfty.cplx (2 * π / θ.1) (DInfty.posEmb q) ≠ 0 := by
    rw [← norm_pos_iff, DInfty.norm_cplx]; exact q.2
  show halfTurn • stereoInv (DInfty.cplx (2 * π / θ.1) (DInfty.posEmb q)) =
    stereoInv (DInfty.cplx (2 * π / θ.1) (DInfty.posEmb (polarHalfPlaneInv q)))
  rw [halfTurn_smul_stereoInv hne, cplx_posEmb_polarHalfPlaneInv]

/-- Every point of `𝕊² ∖ {N, S}` has polar coordinates. -/
theorem exists_footballPolar_eq {x : Football θ} (hN : x ≠ Football.north θ)
    (hS : x ≠ Football.south θ) : ∃ q, footballPolar θ q = x := by
  set y := Football.toSph2 θ x with hydef
  have hyS : (y : Euc3).fst ≠ -1 := fun h => hS (eq_southPole_of_fst h)
  set v := stereoFun y with hvdef
  have hv : stereoInv v = y := stereoInv_stereoFun y hyS
  have hv0 : v ≠ 0 := by
    intro h
    have : y = northPole := by rw [← hv, h, stereoInv_zero]
    exact hN this
  set p := DInfty.ofCplx 1 v with hpdef
  have hp : 0 < p.r := by rw [hpdef, DInfty.ofCplx_r]; exact norm_pos_iff.2 hv0
  obtain ⟨q, hq⟩ : p ∈ range DInfty.posEmb := by rw [DInfty.range_posEmb]; exact hp
  refine ⟨q, ?_⟩
  show Football.ofSph2 θ (stereoInv (DInfty.cplx 1 (DInfty.posEmb q))) = x
  rw [hq, hpdef, DInfty.cplx_ofCplx one_ne_zero, hv]
  rfl

end FootballSpace

/-! ### Charts pushed forward along an open embedding, and `X_α`-charts -/

section Pushforward

variable {G : Type*} {X : Type*} [TopologicalSpace X] [Group G] [MulAction G X]
  [ContinuousConstSMul G X] [LocallyConnectedSpace X] [T2Space X] [IsRigidAction G X]
  {M : Type*} [TopologicalSpace M] {N : Type*} [TopologicalSpace N]

/-- **A map reading the charts of a generating atlas as charts of another is an a.e.
morphism** between the maximal atlases: if every chart `b ∈ B` is `e ∘ Φ` on its source for some
`e ∈ A`, then `Φ` is an a.e. `(G,X)`-morphism `max B → max A`. -/
theorem isAEMorphismOf_maximalAEAtlas_of_forall {B : Set (OpenPartialHomeomorph N X)}
    {A : Set (OpenPartialHomeomorph M X)} (hB : IsAEAtlas G B) (hA : IsAEAtlas G A) {Φ : N → M}
    (hΦ : Continuous Φ)
    (h : ∀ b ∈ B, ∃ e ∈ A, MapsTo Φ b.source e.source ∧ ∀ x ∈ b.source, e (Φ x) = b x) :
    IsAEMorphismOf G (maximalAEAtlas G B) (maximalAEAtlas G A) Φ := by
  have hAm := hA.maximalAEAtlas
  have hBm := hB.maximalAEAtlas
  refine (isAEMorphismOf_iff hAm).2 ⟨hΦ, support B, hB.2, ?_⟩
  refine IsRegularOn.of_exists hBm.1 hAm.1 (isOpen_support B)
    (support_mono hB.subset_maximalAEAtlas) ?_ hΦ.continuousOn ?_
  · intro x hx
    obtain ⟨b, hb, hxb⟩ := mem_support.1 hx
    obtain ⟨e, he, hmaps, -⟩ := h b hb
    exact mem_support.2 ⟨e, hA.subset_maximalAEAtlas he, hmaps hxb⟩
  · intro x hx
    obtain ⟨b, hb, hxb⟩ := mem_support.1 hx
    obtain ⟨e, he, hmaps, heq⟩ := h b hb
    refine ⟨b, hB.subset_maximalAEAtlas hb, e, hA.subset_maximalAEAtlas he, hxb, hmaps hxb, 1, ?_⟩
    filter_upwards [b.open_source.mem_nhds hxb] with y hy
    rw [heq y hy, one_smul]

end Pushforward

section XAChartOfEmbedding

universe u

variable {G : Type*} {X : Type*} [TopologicalSpace X] [Group G] [MulAction G X]
  [ContinuousConstSMul G X] [LocallyConnectedSpace X] [T2Space X] [IsRigidAction G X]
  {A : Type*} {Xα : A → Type u} [∀ a, TopologicalSpace (Xα a)]
  [∀ a, LocallyConnectedSpace (Xα a)] [∀ a, SingularGXStructure G X (Xα a)]
  {S : ∀ a, Set (Xα a)} {M : Type*} [TopologicalSpace M] [SingularGXStructure G X M]

/-- **An open embedding of a connected model which is an a.e. morphism is an `X_α`-chart**
(`def:atlas`, `RamcovGX.tex:1905`) around the image of each point of `S_α`: the chart is the
inverse of the embedding, from its (open) image onto the whole model. -/
def XAChart.ofIsOpenEmbedding {a : A} [ConnectedSpace (Xα a)] {Φ : Xα a → M}
    (hΦ : IsOpenEmbedding Φ) (hΦm : IsAEMorphism G X Φ) {s : Xα a} (hs : s ∈ S a) :
    XAChart G X Xα S a (Φ s) :=
  let U : Opens M := ⟨range Φ, hΦ.isOpen_range⟩
  let ψ : (⊤ : Opens (Xα a)) ≃ₜ U :=
    (Homeomorph.setCongr Opens.coe_top).trans
      ((Homeomorph.Set.univ (Xα a)).trans hΦ.isEmbedding.toHomeomorph)
  have hψ : IsAEMorphism G X (ψ : (⊤ : Opens (Xα a)) → U) := by
    refine isAEMorphism_of_val_comp U ?_
    have h : (Subtype.val ∘ (ψ : (⊤ : Opens (Xα a)) → U)) =
        Φ ∘ (Subtype.val : (⊤ : Opens (Xα a)) → Xα a) := rfl
    rw [h]
    exact hΦm.comp (isAEMorphism_opensSingular_val ⊤)
  { U := U
    V := ⊤
    φ := ψ.symm
    mem := mem_range_self s
    isConnected_V := by rw [Opens.coe_top]; exact isConnected_univ
    isAEMorphism := IsAEMorphism.symm_of_homeomorph hψ
    mem_S := by
      have h : ψ ⟨s, by simp⟩ = ⟨Φ s, mem_range_self s⟩ := rfl
      rw [← h, Homeomorph.symm_apply_apply]
      exact hs }

end XAChartOfEmbedding

/-! ### The singular `(SO(3), 𝕊²)`-structure of the football -/

section FootballStructure

variable (θ : ConeAngle)

/-- `C_θ → F_θ` as an open partial homeomorphism (source `C_θ`, target `𝕊² ∖ {S}`). -/
def footballEmbPH : OpenPartialHomeomorph (SphCone θ) (Football θ) :=
  (isOpenEmbedding_footballEmb θ).toOpenPartialHomeomorph _

theorem footballEmbPH_target : (footballEmbPH θ).target = range (footballEmb θ) :=
  IsOpenEmbedding.toOpenPartialHomeomorph_target _ _

theorem footballEmbPH_source : (footballEmbPH θ).source = univ :=
  IsOpenEmbedding.toOpenPartialHomeomorph_source _ _

theorem footballEmbPH_symm_apply (c : SphCone θ) :
    (footballEmbPH θ).symm (footballEmb θ c) = c :=
  (footballEmbPH θ).left_inv (by rw [footballEmbPH_source]; exact mem_univ c)

theorem footballEmbPH_symm_polar (q : PolarHalfPlane) :
    (footballEmbPH θ).symm (footballPolar θ q) = SphCone.mk θ (polarHalfPlaneLift q) := by
  rw [← footballEmb_mk]
  exact footballEmbPH_symm_apply θ _

/-- The charts of `C_θ` read on `𝕊² ∖ {S}` through `footballEmb`. -/
def footballAtlas₁ : Set (OpenPartialHomeomorph (Football θ) Sph2) :=
  (fun a => (footballEmbPH θ).symm.trans a) '' aeAtlas SO3 Sph2 (SphCone θ)

/-- **The generating atlas of the football**: the charts of `C_θ` read through `footballEmb`, and
their transforms by the half-turn (the charts of the second copy of `C_θ`, about `S`). -/
def footballAtlas : Set (OpenPartialHomeomorph (Football θ) Sph2) :=
  footballAtlas₁ θ ∪
    (fun e => (footballFlip θ).toOpenPartialHomeomorph.trans e) '' footballAtlas₁ θ

variable {θ} in
/-- Two charts of the same copy of `C_θ` differ, near every common point, by an element of
`SO(3)`: those of `C_θ` do. -/
theorem footballAtlas₁_eventually {a b : OpenPartialHomeomorph (SphCone θ) Sph2}
    (ha : a ∈ aeAtlas SO3 Sph2 (SphCone θ)) (hb : b ∈ aeAtlas SO3 Sph2 (SphCone θ))
    {x : Football θ} (hxa : x ∈ ((footballEmbPH θ).symm.trans a).source)
    (hxb : x ∈ ((footballEmbPH θ).symm.trans b).source) :
    ∃ g : SO3, ∀ᶠ y in 𝓝 x,
      ((footballEmbPH θ).symm.trans b) y = g • ((footballEmbPH θ).symm.trans a) y := by
  rw [OpenPartialHomeomorph.trans_source] at hxa hxb
  obtain ⟨g, hg⟩ := (isMaximalAEAtlas_aeAtlas SO3 Sph2 (SphCone θ)).1.1.eventually_smul_eq
    ha hb hxa.2 hxb.2
  exact ⟨g, ((footballEmbPH θ).continuousAt_symm hxa.1).eventually hg⟩

variable {θ} in
/-- **The chart changes across the two copies of `C_θ` lie in `SO(3)`**: at a point of polar
coordinates `(r, φ)` in the first copy, `(1/r, −φ)` in the second, both charts are translates of
the developing map of `C_θ` (`sphCone_chart_dev`), which intertwines `(r, φ) ↦ (1/r, −φ)` and the
half-turn (`halfTurn_smul_sphConeDev`). -/
theorem footballAtlas_cross {a b : OpenPartialHomeomorph (SphCone θ) Sph2}
    (ha : a ∈ aeAtlas SO3 Sph2 (SphCone θ)) (hb : b ∈ aeAtlas SO3 Sph2 (SphCone θ))
    {x : Football θ} (hxa : x ∈ ((footballEmbPH θ).symm.trans a).source)
    (hxb : x ∈ ((footballFlip θ).toOpenPartialHomeomorph.trans
      ((footballEmbPH θ).symm.trans b)).source) :
    ∃ g : SO3, ∀ᶠ y in 𝓝 x,
      ((footballFlip θ).toOpenPartialHomeomorph.trans ((footballEmbPH θ).symm.trans b)) y =
        g • ((footballEmbPH θ).symm.trans a) y := by
  rw [OpenPartialHomeomorph.trans_source] at hxa hxb
  have hxb' : footballFlip θ x ∈ ((footballEmbPH θ).symm.trans b).source := hxb.2
  rw [OpenPartialHomeomorph.trans_source] at hxb'
  have hx1 : x ∈ range (footballEmb θ) := by
    rw [← footballEmbPH_target]; exact hxa.1
  have hx2 : footballFlip θ x ∈ range (footballEmb θ) := by
    rw [← footballEmbPH_target]; exact hxb'.1
  rw [range_footballEmb] at hx1 hx2
  have hS : x ≠ Football.south θ := hx1
  have hN : x ≠ Football.north θ := fun h => hx2 (by rw [h, footballFlip_north]; rfl)
  obtain ⟨q, rfl⟩ := exists_footballPolar_eq θ hN hS
  have hqa : SphCone.mk θ (polarHalfPlaneLift q) ∈ a.source := by
    have := hxa.2
    rwa [mem_preimage, footballEmbPH_symm_polar] at this
  have hqb : SphCone.mk θ (polarHalfPlaneLift (polarHalfPlaneInv q)) ∈ b.source := by
    have := hxb'.2
    rwa [mem_preimage, footballFlip_polar, footballEmbPH_symm_polar] at this
  obtain ⟨k, hk⟩ := sphCone_chart_dev θ (y := polarHalfPlaneLift q) q.2 ha hqa
  obtain ⟨k', hk'⟩ := sphCone_chart_dev θ (y := polarHalfPlaneLift (polarHalfPlaneInv q))
    (polarHalfPlaneInv q).2 hb hqb
  have h1 := (continuous_polarHalfPlaneLift.continuousAt (x := q)).eventually hk
  have h2 := ((continuous_polarHalfPlaneLift.comp continuous_polarHalfPlaneInv).continuousAt
    (x := q)).eventually hk'
  refine ⟨k' * halfTurn * k⁻¹, (isOpenMap_footballPolar θ).nhds_le q (Filter.eventually_map.2 ?_)⟩
  filter_upwards [h1, h2] with q' e1 e2
  show b ((footballEmbPH θ).symm (footballFlip θ (footballPolar θ q'))) =
    (k' * halfTurn * k⁻¹) • a ((footballEmbPH θ).symm (footballPolar θ q'))
  rw [footballFlip_polar, footballEmbPH_symm_polar, footballEmbPH_symm_polar]
  simp only [Function.comp_apply] at e1 e2
  rw [e2, e1, ← halfTurn_smul_sphConeDev, mul_smul, mul_smul, inv_smul_smul]

/-- The generating atlas is a `(SO(3), 𝕊²)`-atlas. -/
theorem isGXAtlas_footballAtlas : IsGXAtlas SO3 (footballAtlas θ) := by
  refine isGXAtlas_of_eventually ?_
  have h11 : ∀ e ∈ footballAtlas₁ θ, ∀ e' ∈ footballAtlas₁ θ, ∀ x ∈ e.source ∩ e'.source,
      ∃ g : SO3, ∀ᶠ y in 𝓝 x, e' y = g • e y := by
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩ x ⟨hxa, hxb⟩
    exact footballAtlas₁_eventually ha hb hxa hxb
  have h12 : ∀ e ∈ footballAtlas₁ θ, ∀ e' ∈ footballAtlas₁ θ,
      ∀ x ∈ e.source ∩ ((footballFlip θ).toOpenPartialHomeomorph.trans e').source,
      ∃ g : SO3, ∀ᶠ y in 𝓝 x,
        ((footballFlip θ).toOpenPartialHomeomorph.trans e') y = g • e y := by
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩ x ⟨hxa, hxb⟩
    exact footballAtlas_cross ha hb hxa hxb
  rintro e (he | ⟨e₁, he₁, rfl⟩) e' (he' | ⟨e₁', he₁', rfl⟩) x hx
  · exact h11 e he e' he' x hx
  · exact h12 e he e₁' he₁' x hx
  · obtain ⟨g, hg⟩ := h12 e' he' e₁ he₁ x ⟨hx.2, hx.1⟩
    exact ⟨g⁻¹, by filter_upwards [hg] with y hy; rw [hy, inv_smul_smul]⟩
  · have hx' : footballFlip θ x ∈ e₁.source ∩ e₁'.source := ⟨hx.1.2, hx.2.2⟩
    obtain ⟨g, hg⟩ := h11 e₁ he₁ e₁' he₁' (footballFlip θ x) hx'
    exact ⟨g, (footballFlip θ).continuous.continuousAt.eventually hg⟩

/-- Off the poles, the first copy of `C_θ` covers the football by regular charts. -/
theorem compl_poles_subset_support :
    ({Football.north θ}ᶜ ∩ {Football.south θ}ᶜ : Set (Football θ)) ⊆
      support (footballAtlas₁ θ) := by
  rintro x ⟨hN, hS⟩
  obtain ⟨q, rfl⟩ := exists_footballPolar_eq θ hN hS
  obtain ⟨a, ha, hqa⟩ := mem_support.1 (SphCone.mk_mem_reg θ (x := polarHalfPlaneLift q) q.2)
  refine mem_support.2 ⟨_, ⟨a, ha, rfl⟩, ?_⟩
  rw [OpenPartialHomeomorph.trans_source]
  refine ⟨?_, ?_⟩
  · show footballPolar θ q ∈ (footballEmbPH θ).target
    rw [footballEmbPH_target]; exact ⟨_, footballEmb_mk θ q⟩
  · rw [mem_preimage, footballEmbPH_symm_polar]; exact hqa

/-- `𝕊² ∖ {N, S}` is portly in the football. -/
theorem isPortly_compl_poles :
    IsPortly ({Football.north θ}ᶜ ∩ {Football.south θ}ᶜ : Set (Football θ)) := by
  have hN : IsPortly ({Football.north θ}ᶜ : Set (Football θ)) :=
    isPortly_compl_singleton_of_chart (E := ℂ) (by rw [Complex.rank_real_complex]; norm_num)
      ((Football.homeoSph2 θ).toOpenPartialHomeomorph.trans stereoChart)
      (v := Football.north θ)
      ⟨mem_univ _, show ((northPole : Sph2) : Euc3).fst ≠ -1 by
        show (1 : ℝ) ≠ -1; norm_num⟩
  have hS : IsPortly ({Football.south θ}ᶜ : Set (Football θ)) := by
    have h := hN.preimage_of_isLocalHomeomorph (footballFlip θ).isLocalHomeomorph
    convert h using 1
    ext y
    simp only [mem_compl_iff, mem_singleton_iff, mem_preimage]
    constructor
    · intro h h'
      apply h
      rw [← footballFlip_footballFlip θ y, h', footballFlip_north]
    · intro h h'
      apply h
      rw [h', footballFlip_south]
  exact hN.inter hS

/-- **The generating atlas is an a.e. `(SO(3), 𝕊²)`-atlas**: within each copy, the chart changes
are those of `C_θ`; across the copies, at `(r, φ)` and `(1/r, −φ)`, they are read by the
developing map as the half-turn (`halfTurn_smul_sphConeDev`); the support contains
`𝕊² ∖ {N, S}`, portly. -/
theorem isAEAtlas_footballAtlas : IsAEAtlas SO3 (footballAtlas θ) :=
  ⟨isGXAtlas_footballAtlas θ, (isPortly_compl_poles θ).mono
    ((compl_poles_subset_support θ).trans (support_mono subset_union_left)) (isOpen_support _)⟩

/-- **The singular `(SO(3), 𝕊²)`-structure of the football**: the maximal a.e. atlas generated by
`footballAtlas` (`cor:maximal_atlas`). -/
instance footballSingularGXStructure : SingularGXStructure SO3 Sph2 (Football θ) :=
  ⟨maximalAEAtlas SO3 (footballAtlas θ),
    (isAEAtlas_footballAtlas θ).isMaximalAEAtlas_maximalAEAtlas⟩

theorem aeAtlas_football :
    aeAtlas SO3 Sph2 (Football θ) = maximalAEAtlas SO3 (footballAtlas θ) := rfl

/-- **`C_θ → F_θ` is an a.e. `(SO(3), 𝕊²)`-morphism** (onto `𝕊² ∖ {S}`, apex to `N`). -/
theorem isAEMorphism_footballEmb : IsAEMorphism SO3 Sph2 (footballEmb θ) := by
  have hB := isMaximalAEAtlas_aeAtlas SO3 Sph2 (SphCone θ)
  have h := isAEMorphismOf_maximalAEAtlas_of_forall hB.1 (isAEAtlas_footballAtlas θ)
    (isOpenEmbedding_footballEmb θ).continuous fun b hb => by
      refine ⟨(footballEmbPH θ).symm.trans b, Or.inl ⟨b, hb, rfl⟩, fun c hc => ?_, fun c _ => ?_⟩
      · rw [OpenPartialHomeomorph.trans_source]
        refine ⟨?_, ?_⟩
        · show footballEmb θ c ∈ (footballEmbPH θ).target
          rw [footballEmbPH_target]; exact mem_range_self c
        · rw [mem_preimage, footballEmbPH_symm_apply]; exact hc
      · show b ((footballEmbPH θ).symm (footballEmb θ c)) = b c
        rw [footballEmbPH_symm_apply]
  rwa [hB.maximalAEAtlas_eq] at h

/-- The second copy: `C_θ → F_θ`, apex to `S`, is an a.e. morphism. -/
theorem isAEMorphism_footballFlip_comp :
    IsAEMorphism SO3 Sph2 (footballFlip θ ∘ footballEmb θ) := by
  have hB := isMaximalAEAtlas_aeAtlas SO3 Sph2 (SphCone θ)
  have h := isAEMorphismOf_maximalAEAtlas_of_forall hB.1 (isAEAtlas_footballAtlas θ)
    ((footballFlip θ).continuous.comp (isOpenEmbedding_footballEmb θ).continuous) fun b hb => by
      refine ⟨(footballFlip θ).toOpenPartialHomeomorph.trans ((footballEmbPH θ).symm.trans b),
        Or.inr ⟨_, ⟨b, hb, rfl⟩, rfl⟩, fun c hc => ?_, fun c _ => ?_⟩
      · rw [OpenPartialHomeomorph.trans_source]
        refine ⟨by rw [Homeomorph.toOpenPartialHomeomorph_source]; exact mem_univ _, ?_⟩
        show footballFlip θ (footballFlip θ (footballEmb θ c)) ∈
          ((footballEmbPH θ).symm.trans b).source
        rw [footballFlip_footballFlip, OpenPartialHomeomorph.trans_source]
        refine ⟨?_, ?_⟩
        · show footballEmb θ c ∈ (footballEmbPH θ).target
          rw [footballEmbPH_target]; exact mem_range_self c
        · rw [mem_preimage, footballEmbPH_symm_apply]; exact hc
      · show b ((footballEmbPH θ).symm (footballFlip θ (footballFlip θ (footballEmb θ c)))) = b c
        rw [footballFlip_footballFlip, footballEmbPH_symm_apply]
  rwa [hB.maximalAEAtlas_eq] at h

/-- **The half-turn is an automorphism of the football** exchanging its cone points. -/
theorem footballFlip_mem_singularAut : footballFlip θ ∈ singularAut SO3 Sph2 (Football θ) := by
  refine mem_singularAut.2 ?_
  refine isAEMorphismOf_maximalAEAtlas_of_forall (isAEAtlas_footballAtlas θ)
    (isAEAtlas_footballAtlas θ) (footballFlip θ).continuous ?_
  rintro e (he | ⟨e₁, he₁, rfl⟩)
  · refine ⟨(footballFlip θ).toOpenPartialHomeomorph.trans e, Or.inr ⟨e, he, rfl⟩,
      fun x hx => ?_, fun x _ => ?_⟩
    · rw [OpenPartialHomeomorph.trans_source]
      refine ⟨by rw [Homeomorph.toOpenPartialHomeomorph_source]; exact mem_univ _, ?_⟩
      show footballFlip θ (footballFlip θ x) ∈ e.source
      rw [footballFlip_footballFlip]; exact hx
    · show e (footballFlip θ (footballFlip θ x)) = e x
      rw [footballFlip_footballFlip]
  · refine ⟨e₁, Or.inl he₁, fun x hx => ?_, fun x _ => rfl⟩
    rw [OpenPartialHomeomorph.trans_source] at hx
    exact hx.2

/-- **The north pole is a cone point of angle `θ`**. -/
theorem isConePoint_football_north : IsConePoint θ (Football.north θ) := by
  rw [← footballEmb_apex]
  exact ⟨XAChart.ofIsOpenEmbedding (Φ := footballEmb θ) (isOpenEmbedding_footballEmb θ)
    (isAEMorphism_footballEmb θ) (mem_singleton (SphCone.apex θ))⟩

/-- **The south pole is a cone point of angle `θ`**. -/
theorem isConePoint_football_south : IsConePoint θ (Football.south θ) := by
  rw [← footballFlip_north, ← footballEmb_apex]
  exact ⟨XAChart.ofIsOpenEmbedding (Φ := footballFlip θ ∘ footballEmb θ)
    ((footballFlip θ).isOpenEmbedding.comp (isOpenEmbedding_footballEmb θ))
    (isAEMorphism_footballFlip_comp θ) (mem_singleton (SphCone.apex θ))⟩

/-- Off the poles, the football is regular. -/
theorem football_sing_subset :
    Sing SO3 Sph2 (Football θ) ⊆ {Football.north θ, Football.south θ} := by
  intro x hx
  by_contra h
  simp only [mem_insert_iff, mem_singleton_iff, not_or] at h
  exact hx (support_mono (isAEAtlas_footballAtlas θ).subset_maximalAEAtlas
    (support_mono subset_union_left (compl_poles_subset_support θ ⟨h.1, h.2⟩)))

/-- **The football is a cone sphere with two cone points of angle `θ`**
(`cex:start_singular_manifold_homeomorphic`'s objects, `RamcovGX.tex:1930`, with `s = 2`): `F_θ`
is homeomorphic to `𝕊²`, `N ≠ S` are cone points of angle `θ`, and there is no other singular
point. For `θ = 2π`, `N` and `S` are marked regular points (`football_sing_eq_empty`). -/
theorem isConeSphere_football :
    IsConeSphere (Football θ) ![θ.1, θ.1] ![Football.north θ, Football.south θ] where
  homeomorphic := ⟨Football.homeoSph2 θ⟩
  injective := by
    intro i j hij
    fin_cases i <;> fin_cases j
    · rfl
    · exact absurd hij (Football.north_ne_south θ)
    · exact absurd hij.symm (Football.north_ne_south θ)
    · rfl
  pos i := by fin_cases i <;> exact θ.2
  isConePoint i := by
    fin_cases i
    · exact isConePoint_football_north θ
    · exact isConePoint_football_south θ
  sing_subset := by
    intro x hx
    rcases football_sing_subset θ hx with h | h
    · exact ⟨0, h.symm⟩
    · exact ⟨1, (mem_singleton_iff.1 h).symm⟩

/-- **`sing F_θ = {N, S}`** for `θ ≠ 2π`: exactly two genuine cone points. -/
theorem football_sing_eq (hθ : θ.1 ≠ 2 * π) :
    Sing SO3 Sph2 (Football θ) = {Football.north θ, Football.south θ} := by
  refine Subset.antisymm (football_sing_subset θ) ?_
  rintro x (rfl | rfl)
  · exact (isConePoint_football_north θ).mem_sing hθ
  · exact (isConePoint_football_south θ).mem_sing hθ

/-- **`F_{2π}` is regular**: the statement holds with no singular point. -/
theorem football_sing_eq_empty (hθ : θ.1 = 2 * π) : Sing SO3 Sph2 (Football θ) = ∅ := by
  refine eq_empty_iff_forall_notMem.2 fun x hx => ?_
  rcases football_sing_subset θ hx with rfl | rfl
  · exact hx ((isConePoint_football_north θ).mem_reg hθ)
  · exact hx ((isConePoint_football_south θ).mem_reg hθ)

/-! ### `θ = 2π`: the football is the round sphere -/

variable {θ} in
/-- For `θ = 2π`, off the north pole, a chart of the first copy of `C_θ` is a translate of the
identity of `𝕊²` (the developing map of `C_{2π}` is the polar parametrisation itself). -/
theorem footballAtlas₁_eventually_eq_smul_of_ne (hθ : θ.1 = 2 * π)
    {a : OpenPartialHomeomorph (SphCone θ) Sph2} (ha : a ∈ aeAtlas SO3 Sph2 (SphCone θ))
    {y : Football θ} (hy : y ∈ ((footballEmbPH θ).symm.trans a).source)
    (hN : y ≠ Football.north θ) :
    ∃ g : SO3, ∀ᶠ z in 𝓝 y, ((footballEmbPH θ).symm.trans a) z = g • Football.toSph2 θ z := by
  rw [OpenPartialHomeomorph.trans_source] at hy
  have hy1 : y ∈ range (footballEmb θ) := by
    rw [← footballEmbPH_target]; exact hy.1
  rw [range_footballEmb] at hy1
  obtain ⟨q, rfl⟩ := exists_footballPolar_eq θ hN hy1
  have hqa : SphCone.mk θ (polarHalfPlaneLift q) ∈ a.source := by
    have := hy.2
    rwa [mem_preimage, footballEmbPH_symm_polar] at this
  obtain ⟨k, hk⟩ := sphCone_chart_dev θ (y := polarHalfPlaneLift q) q.2 ha hqa
  have h1 := (continuous_polarHalfPlaneLift.continuousAt (x := q)).eventually hk
  refine ⟨k, (isOpenMap_footballPolar θ).nhds_le q (Filter.eventually_map.2 ?_)⟩
  filter_upwards [h1] with q' e1
  have e1' : a (SphCone.mk θ (polarHalfPlaneLift q')) =
      k • sphConeDev θ.1 (polarHalfPlaneLift q') := e1
  show a ((footballEmbPH θ).symm (footballPolar θ q')) =
    k • Football.toSph2 θ (footballPolar θ q')
  rw [footballEmbPH_symm_polar, e1']
  congr 1
  show stereoInv (DInfty.cplx (2 * π / θ.1) (DInfty.posEmb q')) =
    stereoInv (DInfty.cplx 1 (DInfty.posEmb q'))
  rw [hθ, div_self (by positivity)]

variable {θ} in
/-- For `θ = 2π`, a chart of the first copy of `C_θ` is, near every point of its source, a
translate of the identity of `𝕊²`; at the north pole by rigidity on a punctured stereographic
disc (preconnected) and continuity. -/
theorem footballAtlas₁_eventually_eq_smul (hθ : θ.1 = 2 * π)
    {a : OpenPartialHomeomorph (SphCone θ) Sph2} (ha : a ∈ aeAtlas SO3 Sph2 (SphCone θ))
    {y : Football θ} (hy : y ∈ ((footballEmbPH θ).symm.trans a).source) :
    ∃ g : SO3, ∀ᶠ z in 𝓝 y, ((footballEmbPH θ).symm.trans a) z = g • Football.toSph2 θ z := by
  by_cases hN : y = Football.north θ
  swap
  · exact footballAtlas₁_eventually_eq_smul_of_ne hθ ha hy hN
  subst hN
  set e := (footballEmbPH θ).symm.trans a with hedef
  set j : ℂ → Football θ := fun v => Football.ofSph2 θ (stereoInv v) with hjdef
  have hjc : Continuous j := continuous_stereoInv
  have hjo : IsOpenMap j := (isOpenEmbedding_stereoInv (W := ℂ)).isOpenMap
  have hjinj : Injective j := (isOpenEmbedding_stereoInv (W := ℂ)).injective
  have hj0 : j 0 = Football.north θ := by
    show Football.ofSph2 θ (stereoInv 0) = Football.ofSph2 θ northPole
    rw [stereoInv_zero]
  have hO : j ⁻¹' e.source ∈ 𝓝 (0 : ℂ) :=
    hjc.continuousAt.preimage_mem_nhds (e.open_source.mem_nhds (by rw [hj0]; exact hy))
  obtain ⟨ε, hε, hεO⟩ := Metric.mem_nhds_iff.1 hO
  set S' : Set (Football θ) := j '' (Metric.ball (0 : ℂ) ε \ {0}) with hS'def
  have hS'c : IsPreconnected S' := (isPreconnected_ball_diff_zero ε).image j hjc.continuousOn
  set ι := (Football.homeoSph2 θ).toOpenPartialHomeomorph with hιdef
  have hloc : ∀ z ∈ S', ∃ g : SO3, ∀ᶠ z' in 𝓝 z, e z' = g • ι z' := by
    rintro _ ⟨v, ⟨hvB, hv0⟩, rfl⟩
    have hvN : j v ≠ Football.north θ := fun h => hv0 (hjinj (h.trans hj0.symm))
    exact footballAtlas₁_eventually_eq_smul_of_ne hθ ha (hεO hvB) hvN
  obtain ⟨g, hg⟩ := exists_smul_eq_on_of_isPreconnected hS'c
    (fun _ _ => by rw [Homeomorph.toOpenPartialHomeomorph_source]; exact mem_univ _) hloc
  have hW : IsOpen (j '' Metric.ball (0 : ℂ) ε) := hjo _ Metric.isOpen_ball
  have hWe : j '' Metric.ball (0 : ℂ) ε ⊆ e.source := by
    rintro _ ⟨v, hv, rfl⟩; exact hεO hv
  have hSW : S' ⊆ j '' Metric.ball (0 : ℂ) ε := image_mono sdiff_subset
  have hWcl : j '' Metric.ball (0 : ℂ) ε ⊆ closure S' :=
    (image_mono ((dense_compl_singleton (0 : ℂ)).open_subset_closure_inter
      Metric.isOpen_ball)).trans (image_closure_subset_closure_image hjc)
  have hιc : ContinuousOn (fun z => g • ι z) (j '' Metric.ball (0 : ℂ) ε) :=
    ((continuous_const_smul g).comp (Football.homeoSph2 θ).continuous).continuousOn
  have heq := Set.EqOn.of_subset_closure hg (e.continuousOn.mono hWe) hιc hSW hWcl
  refine ⟨g, ?_⟩
  filter_upwards [hW.mem_nhds ⟨0, Metric.mem_ball_self hε, hj0⟩] with z hz
  exact heq hz

/-- **`F_{2π}` is the round sphere**: for `θ = 2π`, the identity of `𝕊²` is a chart of the
football's maximal a.e. atlas (`N`, `S` are marked regular points of the round sphere). -/
theorem football_two_pi_round (hθ : θ.1 = 2 * π) :
    (Football.homeoSph2 θ).toOpenPartialHomeomorph ∈ aeAtlas SO3 Sph2 (Football θ) := by
  set ι := (Football.homeoSph2 θ).toOpenPartialHomeomorph with hιdef
  have hA := isAEAtlas_footballAtlas θ
  have hM := isMaximalAEAtlas_aeAtlas SO3 Sph2 (Football θ)
  have hgen : ∀ e ∈ footballAtlas θ, ∀ y ∈ e.source,
      ∃ g : SO3, ∀ᶠ z in 𝓝 y, e z = g • ι z := by
    rintro e (⟨a, ha, rfl⟩ | ⟨_, ⟨a, ha, rfl⟩, rfl⟩) y hy
    · exact footballAtlas₁_eventually_eq_smul hθ ha hy
    · rw [OpenPartialHomeomorph.trans_source] at hy
      obtain ⟨g, hg⟩ := footballAtlas₁_eventually_eq_smul hθ ha hy.2
      refine ⟨g * halfTurn, ?_⟩
      filter_upwards [(footballFlip θ).continuous.continuousAt.eventually hg] with z hz
      rw [mul_smul]
      exact hz
  have hapex : SphCone.apex θ ∈ Reg SO3 Sph2 (SphCone θ) := by
    by_contra h
    have h' : SphCone.apex θ ∈ Sing SO3 Sph2 (SphCone θ) := h
    rw [SphCone.sing_eq_empty θ hθ] at h'
    exact h'
  obtain ⟨a, ha, hapa⟩ := mem_support.1 hapex
  have hNa : Football.north θ ∈ ((footballEmbPH θ).symm.trans a).source := by
    rw [OpenPartialHomeomorph.trans_source, ← footballEmb_apex]
    refine ⟨?_, ?_⟩
    · rw [OpenPartialHomeomorph.symm_source, footballEmbPH_target]; exact mem_range_self _
    · rw [mem_preimage, footballEmbPH_symm_apply]; exact hapa
  have hcov : ∀ y : Football θ, ∃ e ∈ footballAtlas θ, y ∈ e.source := by
    intro y
    by_cases hyN : y = Football.north θ
    · exact ⟨_, Or.inl ⟨a, ha, rfl⟩, hyN ▸ hNa⟩
    by_cases hyS : y = Football.south θ
    · refine ⟨_, Or.inr ⟨_, ⟨a, ha, rfl⟩, rfl⟩, ?_⟩
      rw [OpenPartialHomeomorph.trans_source]
      refine ⟨by rw [Homeomorph.toOpenPartialHomeomorph_source]; exact mem_univ _, ?_⟩
      show footballFlip θ y ∈ ((footballEmbPH θ).symm.trans a).source
      rw [hyS, footballFlip_south]
      exact hNa
    · obtain ⟨e, he, hye⟩ := mem_support.1 (compl_poles_subset_support θ ⟨hyN, hyS⟩)
      exact ⟨e, Or.inl he, hye⟩
  refine hM.mem_of_compatible fun c hc y hy => ?_
  obtain ⟨e, he, hye⟩ := hcov y
  obtain ⟨h, hh⟩ := hM.1.1.eventually_smul_eq (hA.subset_maximalAEAtlas he) hc hye hy.2
  obtain ⟨g, hg⟩ := hgen e he y hye
  refine ⟨h * g, ?_⟩
  filter_upwards [hh, hg] with z h1 h2
  rw [h1, h2, mul_smul]

/-- **`F_{2π}` is isomorphic to the round sphere** `𝕊²` (the regular `(SO(3), 𝕊²)`-manifold,
`SingularGXStructure.ofHasGroupoid`) by the identity: for `θ = 2π`, `IsConeSphere` holds for the
round sphere with two marked regular points. -/
theorem football_two_pi_isAEMorphism_round (hθ : θ.1 = 2 * π) :
    letI : SingularGXStructure SO3 Sph2 Sph2 := SingularGXStructure.ofHasGroupoid SO3 Sph2 Sph2
    IsAEMorphism SO3 Sph2 (Football.homeoSph2 θ) ∧
      IsAEMorphism SO3 Sph2 (Football.homeoSph2 θ).symm := by
  letI : SingularGXStructure SO3 Sph2 Sph2 := SingularGXStructure.ofHasGroupoid SO3 Sph2 Sph2
  have hround : IsMaximalAEAtlas SO3 (aeAtlas SO3 Sph2 Sph2) :=
    isMaximalAEAtlas_aeAtlas SO3 Sph2 Sph2
  have hF := isMaximalAEAtlas_aeAtlas SO3 Sph2 (Football θ)
  have hι := football_two_pi_round θ hθ
  have hrefl : OpenPartialHomeomorph.refl Sph2 ∈ aeAtlas SO3 Sph2 Sph2 :=
    (gxGroupoid SO3 Sph2).chart_mem_maximalAtlas (northPole : Sph2)
  have h1 : IsAEMorphism SO3 Sph2 (Football.homeoSph2 θ) := by
    refine (isAEMorphismOf_iff hround.1).2 ⟨(Football.homeoSph2 θ).continuous, univ, isPortly_univ,
      IsRegularOn.of_exists hF.1.1 hround.1.1 isOpen_univ (fun y _ => mem_support.2 ⟨_, hι,
        by rw [Homeomorph.toOpenPartialHomeomorph_source]; exact mem_univ y⟩)
        (fun y _ => mem_support.2 ⟨_, hrefl, mem_univ _⟩)
        (Football.homeoSph2 θ).continuous.continuousOn fun y _ => ?_⟩
    refine ⟨_, hι, _, hrefl, by rw [Homeomorph.toOpenPartialHomeomorph_source]; exact mem_univ y,
      mem_univ _, 1, Eventually.of_forall fun z => ?_⟩
    rw [one_smul]
    rfl
  exact ⟨h1, IsAEMorphism.symm_of_homeomorph h1⟩

/-- The football is a spherical cone surface: every singular point is a cone point. -/
theorem isSphericalConeSurface_football : IsSphericalConeSurface (Football θ) :=
  (isConeSphere_football θ).isSphericalConeSurface

end FootballStructure

/-- **For every `θ > 0` there is a spherical cone sphere with exactly two cone points, both of
angle `θ`**: a singular `(SO(3), 𝕊²)`-manifold (locally connected, Hausdorff, second countable)
homeomorphic to `𝕊²` (`IsConeSphere` with `s = 2`), whose singular locus is the two cone points
when `θ ≠ 2π`. -/
theorem exists_isConeSphere_two (θ : ℝ) (hθ : 0 < θ) :
    ∃ (M : Type) (_ : TopologicalSpace M) (_ : SingularGXStructure SO3 Sph2 M),
      LocallyConnectedSpace M ∧ T2Space M ∧ SecondCountableTopology M ∧
      ∃ p : Fin 2 → M, IsConeSphere M ![θ, θ] p ∧ (θ ≠ 2 * π → Sing SO3 Sph2 M = range p) := by
  refine ⟨Football ⟨θ, hθ⟩, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, ![Football.north _, Football.south _], isConeSphere_football ⟨θ, hθ⟩,
    fun h => ?_⟩
  rw [football_sing_eq ⟨θ, hθ⟩ h]
  ext x
  simp only [mem_insert_iff, mem_singleton_iff, mem_range, Fin.exists_fin_two,
    Matrix.cons_val_zero, Matrix.cons_val_one]
  constructor
  · rintro (h | h)
    · exact Or.inl h.symm
    · exact Or.inr h.symm
  · rintro (h | h)
    · exact Or.inl h.symm
    · exact Or.inr h.symm

end GX
