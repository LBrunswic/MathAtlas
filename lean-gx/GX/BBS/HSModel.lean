/-! ### The normalised action of the linear group on `S(V)` -/

section LinRay

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]

/-- **The normalised action** `A · σ = A σ / ‖A σ‖` of a linear automorphism on the ray sphere
`S(V)` (BBS-Q3: `S(V)` is represented by the unit sphere, `GX.RaySphere`). -/
def linRaySmul (A : V ≃ₗ[ℝ] V) (σ : RaySphere V) : RaySphere V :=
  ⟨‖A σ‖⁻¹ • A σ, mem_sphere_zero_iff_norm.2
    (norm_inv_smul_self ((LinearEquiv.map_ne_zero_iff A).2 (raySphere_ne_zero σ)))⟩

theorem coe_linRaySmul (A : V ≃ₗ[ℝ] V) (σ : RaySphere V) :
    (linRaySmul A σ : V) = ‖A σ‖⁻¹ • A σ := rfl

/-- `A · σ = τ` iff `A σ` is a positive multiple of `τ`. -/
theorem linRaySmul_eq_iff {A : V ≃ₗ[ℝ] V} {σ τ : RaySphere V} :
    linRaySmul A σ = τ ↔ ∃ c : ℝ, 0 < c ∧ A σ = c • (τ : V) := by
  have hA : A σ ≠ 0 := (LinearEquiv.map_ne_zero_iff A).2 (raySphere_ne_zero σ)
  have hn : 0 < ‖A σ‖ := norm_pos_iff.2 hA
  constructor
  · rintro rfl
    refine ⟨‖A σ‖, hn, ?_⟩
    rw [coe_linRaySmul, smul_smul, mul_inv_cancel₀ hn.ne', one_smul]
  · rintro ⟨c, hc, h⟩
    refine Subtype.ext ?_
    have : ‖A σ‖ = c := by
      rw [h, norm_smul, norm_raySphere, mul_one, Real.norm_eq_abs, abs_of_pos hc]
    rw [coe_linRaySmul, this, h, smul_smul, inv_mul_cancel₀ hc.ne', one_smul]

theorem linRaySmul_one (σ : RaySphere V) : linRaySmul (1 : V ≃ₗ[ℝ] V) σ = σ := by
  exact linRaySmul_eq_iff.2 ⟨1, one_pos, by rw [one_smul]; rfl⟩

theorem linRaySmul_mul (A B : V ≃ₗ[ℝ] V) (σ : RaySphere V) :
    linRaySmul (A * B) σ = linRaySmul A (linRaySmul B σ) := by
  rw [linRaySmul_eq_iff]
  obtain ⟨b, hb, hB⟩ := linRaySmul_eq_iff.1 (rfl : linRaySmul B σ = _)
  obtain ⟨a, ha, hA⟩ := linRaySmul_eq_iff.1 (rfl : linRaySmul A (linRaySmul B σ) = _)
  refine ⟨b * a, mul_pos hb ha, ?_⟩
  rw [LinearEquiv.mul_apply, hB, map_smul, hA, smul_smul]

/-- Two normalised actions agree at `σ` iff `A σ` is a positive multiple of `B σ`. -/
theorem linRaySmul_eq_linRaySmul_iff {A B : V ≃ₗ[ℝ] V} {σ : RaySphere V} :
    linRaySmul A σ = linRaySmul B σ ↔ ∃ c : ℝ, 0 < c ∧ A σ = c • B σ := by
  obtain ⟨b, hb, hB⟩ := linRaySmul_eq_iff.1 (rfl : linRaySmul B σ = _)
  constructor
  · intro h
    obtain ⟨a, ha, hA⟩ := linRaySmul_eq_iff.1 h
    refine ⟨a / b, div_pos ha hb, ?_⟩
    rw [hA, hB, smul_smul, div_mul_cancel₀ _ hb.ne']
  · rintro ⟨c, hc, h⟩
    exact linRaySmul_eq_iff.2 ⟨c * b, mul_pos hc hb, by rw [h, hB, smul_smul]⟩

/-- The normalised action commutes with the antipodal map. -/
theorem linRaySmul_neg (A : V ≃ₗ[ℝ] V) (σ : RaySphere V) :
    linRaySmul A (-σ) = -linRaySmul A σ := by
  refine Subtype.ext ?_
  simp only [coe_linRaySmul, coe_neg_sphere, map_neg, norm_neg, smul_neg]

theorem continuous_linRaySmul [FiniteDimensional ℝ V] (A : V ≃ₗ[ℝ] V) :
    Continuous (linRaySmul A) := by
  have hA : Continuous fun v : V => A v :=
    LinearMap.continuous_of_finiteDimensional (A : V →ₗ[ℝ] V)
  have h1 : Continuous fun σ : RaySphere V => A σ := hA.comp continuous_subtype_val
  refine Continuous.subtype_mk ?_ _
  exact (h1.norm.inv₀ fun σ => norm_ne_zero_iff.2
    ((LinearEquiv.map_ne_zero_iff A).2 (raySphere_ne_zero σ))).smul h1

/-- **A linear map whose eigenvectors fill a neighbourhood of a nonzero vector is a scalar.** -/
theorem eq_smul_of_eventually_eigen {T : V →ₗ[ℝ] V} {v₀ : V} (hv₀ : v₀ ≠ 0) {c₀ : ℝ}
    (h₀ : T v₀ = c₀ • v₀) (hT : ∀ᶠ v in 𝓝 v₀, ∃ c : ℝ, T v = c • v) (w : V) :
    T w = c₀ • w := by
  have hc1 : Tendsto (fun s : ℝ => v₀ + s • w) (𝓝 0) (𝓝 v₀) := by
    have : Continuous fun s : ℝ => v₀ + s • w := by fun_prop
    simpa using this.tendsto 0
  have hc2 : Tendsto (fun s : ℝ => v₀ + (2 * s) • w) (𝓝 0) (𝓝 v₀) := by
    have : Continuous fun s : ℝ => v₀ + (2 * s) • w := by fun_prop
    simpa using this.tendsto 0
  obtain ⟨s, ⟨⟨a, ha⟩, ⟨b, hb⟩⟩, hs⟩ :=
    ((((hc1.eventually hT).and (hc2.eventually hT)).filter_mono nhdsWithin_le_nhds).and
      (self_mem_nhdsWithin : Ioi (0 : ℝ) ∈ 𝓝[>] 0)).exists
  have hs0 : (s : ℝ) ≠ 0 := ne_of_gt hs
  rw [map_add, map_smul, h₀] at ha hb
  have key : (c₀ - 2 * a + b) • v₀ = (2 * s * (a - b)) • w := by
    linear_combination (norm := module) (2 : ℝ) • ha - hb
  by_cases hβ : 2 * s * (a - b) = 0
  · have hab : a = b := by
      rcases mul_eq_zero.1 hβ with h | h
      · exact absurd h (mul_ne_zero two_ne_zero hs0)
      · exact sub_eq_zero.1 h
    rw [hβ, zero_smul] at key
    have hα : c₀ - 2 * a + b = 0 := (smul_eq_zero.1 key).resolve_right hv₀
    have hca : c₀ = a := by rw [← hab] at hα; linarith
    have : s • T w = s • (c₀ • w) := by
      rw [hca] at ha ⊢
      linear_combination (norm := module) ha
    exact smul_right_injective V hs0 this
  · have hw : w = ((c₀ - 2 * a + b) / (2 * s * (a - b))) • v₀ := by
      rw [div_eq_mul_inv, mul_comm, ← smul_smul, key, smul_smul, inv_mul_cancel₀ hβ, one_smul]
    rw [hw, map_smul, h₀, smul_comm]

/-- If the normalised actions of `A` and `B` agree on a neighbourhood of `σ₀` in `S(V)`, every
vector near `σ₀` is an eigenvector of `B⁻¹ A`. -/
theorem eventually_eigen_of_eqOn {A B : V ≃ₗ[ℝ] V} {U : Set (RaySphere V)} (hU : IsOpen U)
    {σ₀ : RaySphere V} (hσ₀ : σ₀ ∈ U) (heq : EqOn (linRaySmul A) (linRaySmul B) U) :
    ∀ᶠ v in 𝓝 (σ₀ : V), ∃ c : ℝ, B.symm (A v) = c • v := by
  have hcont := continuousAt_rayNormalize σ₀ (raySphere_ne_zero σ₀)
  rw [ContinuousAt, rayNormalize_raySphere] at hcont
  filter_upwards [hcont (hU.mem_nhds hσ₀), isOpen_ne.mem_nhds (raySphere_ne_zero σ₀)] with
    v hvU hv0
  set τ := rayNormalize σ₀ v
  have hτ : (τ : V) = ‖v‖⁻¹ • v := coe_rayNormalize σ₀ hv0
  have hv : v = ‖v‖ • (τ : V) := by
    rw [hτ, smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.2 hv0), one_smul]
  obtain ⟨c, -, hc⟩ := linRaySmul_eq_linRaySmul_iff.1 (heq hvU)
  refine ⟨c, ?_⟩
  calc B.symm (A v) = B.symm (A (‖v‖ • (τ : V))) := by rw [← hv]
    _ = ‖v‖ • B.symm (A τ) := by rw [map_smul, map_smul]
    _ = c • (‖v‖ • (τ : V)) := by rw [hc, map_smul, LinearEquiv.symm_apply_apply, smul_comm]
    _ = c • v := by rw [← hv]

end LinRay

/-! ### `HSⁿ` and the analytic action of `SO₀(1,n)` -/

section Model

variable {d : ℕ}

variable (d) in
/-- **`HSᵈ`** (BBS §3.1, `colI_v1.tex:584–585`: "the set of geodesic rays into `ℝ^{1,2}`", for
`d = 2`): the ray sphere `S(ℝ^{1,d})`, represented by the unit sphere of `Causal.Minkowski d`
(BBS-Q3), whose norm is the sup norm `max(|t|, ‖x‖)`. -/
abbrev HS : Type := RaySphere (Causal.Minkowski d)

/-- The future timelike pole `(1, 0)` of `HSᵈ`. -/
def HS.pole (d : ℕ) : HS d :=
  ⟨(1, 0), mem_sphere_zero_iff_norm.2 (by simp [Prod.norm_def])⟩

instance (d : ℕ) : Nonempty (HS d) := ⟨HS.pole d⟩

/-- **`SO₀(1,d)` acts on `HSᵈ`** by the normalised action. -/
instance hsAction : MulAction (Causal.Flat.lorentz d) (HS d) where
  smul A σ := linRaySmul (A : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) σ
  one_smul σ := linRaySmul_one σ
  mul_smul _ _ σ := linRaySmul_mul _ _ σ

theorem hs_smul_def (A : Causal.Flat.lorentz d) (σ : HS d) :
    A • σ = linRaySmul (A : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) σ := rfl

theorem coe_hs_smul (A : Causal.Flat.lorentz d) (σ : HS d) :
    ((A • σ : HS d) : Causal.Minkowski d) =
      ‖(A : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) σ‖⁻¹ •
        (A : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) σ := rfl

instance : ContinuousConstSMul (Causal.Flat.lorentz d) (HS d) :=
  ⟨fun _ => continuous_linRaySmul _⟩

/-- **Rigidity**: two elements of `SO₀(1,d)` whose actions agree on a nonempty open subset of
`HSᵈ` are equal. -/
theorem hs_eq_of_eqOn {A B : Causal.Flat.lorentz d} {U : Set (HS d)} (hU : IsOpen U)
    (hne : U.Nonempty) (heq : EqOn (fun σ : HS d => A • σ) (fun σ => B • σ) U) : A = B := by
  obtain ⟨σ₀, hσ₀⟩ := hne
  set A' : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d := A.1
  set B' : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d := B.1
  have heq' : EqOn (linRaySmul A') (linRaySmul B') U := heq
  obtain ⟨c₀, hc₀, h₀⟩ := linRaySmul_eq_linRaySmul_iff.1 (heq' hσ₀)
  have hT := eventually_eigen_of_eqOn hU hσ₀ heq'
  set T : Causal.Minkowski d →ₗ[ℝ] Causal.Minkowski d := (A'.trans B'.symm).toLinearMap
  have hT0 : T σ₀ = c₀ • (σ₀ : Causal.Minkowski d) := by
    show B'.symm (A' σ₀) = _
    rw [h₀, map_smul, LinearEquiv.symm_apply_apply]
  have hall := eq_smul_of_eventually_eigen (T := T) (raySphere_ne_zero σ₀) hT0 hT
  have hAB : ∀ w, A' w = c₀ • B' w := fun w => by
    have := hall w
    change B'.symm (A' w) = c₀ • w at this
    have h2 := congrArg B' this
    rwa [LinearEquiv.apply_symm_apply, map_smul] at h2
  -- `c₀ = 1`, since both preserve `minkQ` and `minkQ (1, 0) = -1`
  have hq : Causal.Flat.minkQ (A' (Causal.Flat.timeUnit d)) =
      c₀ ^ 2 * Causal.Flat.minkQ (B' (Causal.Flat.timeUnit d)) := by
    rw [hAB, Causal.Flat.minkQ_smul]
  rw [Causal.Flat.lorentz.minkQ_apply A.2, Causal.Flat.lorentz.minkQ_apply B.2,
    Causal.Flat.minkQ_timeUnit] at hq
  have hc1 : c₀ = 1 := by nlinarith
  refine Subtype.ext (LinearEquiv.ext fun w => ?_)
  rw [hAB w, hc1, one_smul]

/-- **`(SO₀(1,d), HSᵈ)` is analytic** (gx's sense, `RamcovGX.tex:341`): faithful and rigid. -/
instance isAnalyticAction_hs : IsAnalyticAction (Causal.Flat.lorentz d) (HS d) :=
  IsAnalyticAction.of_eq_of_eqOn hs_eq_of_eqOn

theorem connectedSpace_hs (hd : 1 ≤ d) : ConnectedSpace (HS d) := by
  have hrank : 1 < Module.rank ℝ (Causal.Minkowski d) := by
    rw [← Module.finrank_eq_rank]
    have : Module.finrank ℝ (Causal.Minkowski d) = 1 + d := by
      rw [Module.finrank_prod, Module.finrank_self, finrank_euclideanSpace_fin]
    rw [this]
    exact_mod_cast (by omega : 1 < 1 + d)
  exact { toPreconnectedSpace := preconnectedSpace_raySphere hrank, toNonempty := inferInstance }

/-- **The analytical structure `(SO₀(1,d), HSᵈ)`**, `d ≥ 1`: `HSᵈ` connected, locally
connected, Hausdorff, `SO₀(1,d)` acting faithfully and rigidly by homeomorphisms. -/
theorem analyticStructure_hs (hd : 1 ≤ d) :
    AnalyticStructure (Causal.Flat.lorentz d) (HS d) where
  connectedSpace := connectedSpace_hs hd
  locallyConnectedSpace := inferInstance
  t2Space := inferInstance
  continuousConstSMul := inferInstance
  isAnalyticAction := inferInstance

/-- **`(SO₀(1,2), HS²)` is an analytical structure.** -/
theorem analyticStructure_hs2 : AnalyticStructure (Causal.Flat.lorentz 2) (HS 2) :=
  analyticStructure_hs (by norm_num)

theorem hs_smul_neg (A : Causal.Flat.lorentz d) (σ : HS d) : A • (-σ) = -(A • σ) :=
  linRaySmul_neg _ σ

end Model

/-! ### The five pieces of `HSᵈ` (BBS l.586–591) -/

/-- The five pieces of `HS²` (`colI_v1.tex:586–591`): `ℍ²₊`, `ℍ²₋` (future and past timelike
rays), `dS²` (spacelike rays), `∂ℍ²₊`, `∂ℍ²₋` (future and past lightlike rays). -/
inductive HSPiece
  | hypPlus
  | hypMinus
  | deSitter
  | bdPlus
  | bdMinus
  deriving DecidableEq, Fintype

namespace HS

variable {d : ℕ}

variable (d) in
/-- **The decomposition of `HSᵈ`** (`colI_v1.tex:586–591`): `piece d .hypPlus = ℍᵈ₊`, the
future timelike rays; `.hypMinus = ℍᵈ₋`, the past timelike rays; `.deSitter = dSᵈ`, the
spacelike rays; `.bdPlus = ∂ℍᵈ₊` and `.bdMinus = ∂ℍᵈ₋`, the future and past lightlike rays. -/
def piece : HSPiece → Set (HS d)
  | .hypPlus => {σ | Causal.Flat.IsFutureTimelike (σ : Causal.Minkowski d)}
  | .hypMinus => {σ | Causal.Flat.IsFutureTimelike (-(σ : Causal.Minkowski d))}
  | .deSitter => {σ | 0 < Causal.Flat.minkQ (σ : Causal.Minkowski d)}
  | .bdPlus => {σ | Causal.Flat.minkQ (σ : Causal.Minkowski d) = 0 ∧ 0 < (σ : Causal.Minkowski d).1}
  | .bdMinus => {σ | Causal.Flat.minkQ (σ : Causal.Minkowski d) = 0 ∧ (σ : Causal.Minkowski d).1 < 0}

open Classical in
/-- The piece a ray lies in. -/
def region (σ : HS d) : HSPiece :=
  if 0 < Causal.Flat.minkQ (σ : Causal.Minkowski d) then .deSitter
  else if Causal.Flat.minkQ (σ : Causal.Minkowski d) < 0 then
    (if 0 < (σ : Causal.Minkowski d).1 then .hypPlus else .hypMinus)
  else (if 0 < (σ : Causal.Minkowski d).1 then .bdPlus else .bdMinus)

/-- A ray with `minkQ ≤ 0` is not horizontal. -/
theorem fst_ne_zero_of_minkQ_nonpos (σ : HS d) (h : Causal.Flat.minkQ (σ : Causal.Minkowski d) ≤ 0) :
    (σ : Causal.Minkowski d).1 ≠ 0 := fun h0 =>
  raySphere_ne_zero σ (Causal.Flat.eq_zero_of_fst_eq_zero h0 h)

theorem mem_piece_region (σ : HS d) : σ ∈ piece d (region σ) := by
  have h0 := fst_ne_zero_of_minkQ_nonpos σ
  unfold region
  split_ifs with h1 h2 h3 h4
  · exact h1
  · exact ⟨h3, h2⟩
  · refine ⟨?_, by simpa using h2⟩
    have := h0 h2.le
    simp only [Prod.fst_neg, Left.neg_pos_iff]
    exact lt_of_le_of_ne (not_lt.1 h3) this
  · exact ⟨le_antisymm (not_lt.1 h1) (not_lt.1 h2), h4⟩
  · exact ⟨le_antisymm (not_lt.1 h1) (not_lt.1 h2),
      lt_of_le_of_ne (not_lt.1 h4) (h0 (not_lt.1 h1))⟩

theorem region_eq_of_mem {σ : HS d} {k : HSPiece} (h : σ ∈ piece d k) : region σ = k := by
  unfold region
  rcases k with _ | _ | _ | _ | _
  · obtain ⟨h1, h2⟩ := (h : Causal.Flat.IsFutureTimelike (σ : Causal.Minkowski d))
    rw [if_neg (not_lt.2 h2.le), if_pos h2, if_pos h1]
  · obtain ⟨h1, h2⟩ := (h : Causal.Flat.IsFutureTimelike (-(σ : Causal.Minkowski d)))
    rw [Causal.Flat.minkQ_neg] at h2
    simp only [Prod.fst_neg, Left.neg_pos_iff] at h1
    rw [if_neg (not_lt.2 h2.le), if_pos h2, if_neg (not_lt.2 h1.le)]
  · exact if_pos (h : 0 < Causal.Flat.minkQ (σ : Causal.Minkowski d))
  · obtain ⟨h1, h2⟩ := (h : Causal.Flat.minkQ (σ : Causal.Minkowski d) = 0 ∧ _)
    rw [if_neg (by rw [h1]; exact lt_irrefl 0), if_neg (by rw [h1]; exact lt_irrefl 0), if_pos h2]
  · obtain ⟨h1, h2⟩ := (h : Causal.Flat.minkQ (σ : Causal.Minkowski d) = 0 ∧ _)
    rw [if_neg (by rw [h1]; exact lt_irrefl 0), if_neg (by rw [h1]; exact lt_irrefl 0),
      if_neg (not_lt.2 h2.le)]

theorem mem_piece_iff_region {σ : HS d} {k : HSPiece} : σ ∈ piece d k ↔ region σ = k :=
  ⟨region_eq_of_mem, fun h => h ▸ mem_piece_region σ⟩

/-- **The five pieces cover `HSᵈ`.** -/
theorem iUnion_piece : ⋃ k, piece d k = univ :=
  eq_univ_of_forall fun σ => mem_iUnion.2 ⟨region σ, mem_piece_region σ⟩

/-- **The five pieces are pairwise disjoint.** -/
theorem pairwise_disjoint_piece : Pairwise fun k k' => Disjoint (piece d k) (piece d k') := by
  intro k k' hkk'
  refine Set.disjoint_left.2 fun σ h h' => hkk' ?_
  rw [← region_eq_of_mem h, ← region_eq_of_mem h']

theorem isFutureTimelike_smul_iff {c : ℝ} (hc : 0 < c) {v : Causal.Minkowski d} :
    Causal.Flat.IsFutureTimelike (c • v) ↔ Causal.Flat.IsFutureTimelike v := by
  simp only [Causal.Flat.IsFutureTimelike, Prod.smul_fst, smul_eq_mul, Causal.Flat.minkQ_smul]
  rw [mul_pos_iff_of_pos_left hc]
  have hc2 := pow_pos hc 2
  constructor <;> rintro ⟨h1, h2⟩ <;> refine ⟨h1, ?_⟩ <;> nlinarith

theorem isFutureCausal_smul_iff {c : ℝ} (hc : 0 < c) {v : Causal.Minkowski d} :
    Causal.Flat.IsFutureCausal (c • v) ↔ Causal.Flat.IsFutureCausal v := by
  simp only [Causal.Flat.IsFutureCausal, Prod.smul_fst, smul_eq_mul, Causal.Flat.minkQ_smul]
  rw [mul_nonneg_iff_of_pos_left hc]
  have hc2 := pow_pos hc 2
  constructor <;> rintro ⟨h1, h2⟩ <;> refine ⟨h1, ?_⟩ <;> nlinarith

theorem minkQ_smul_eq_zero_iff {c : ℝ} (hc : 0 < c) {v : Causal.Minkowski d} :
    Causal.Flat.minkQ (c • v) = 0 ↔ Causal.Flat.minkQ v = 0 := by
  rw [Causal.Flat.minkQ_smul, mul_eq_zero, or_iff_right (pow_pos hc 2).ne']

theorem minkQ_smul_pos_iff {c : ℝ} (hc : 0 < c) {v : Causal.Minkowski d} :
    0 < Causal.Flat.minkQ (c • v) ↔ 0 < Causal.Flat.minkQ v := by
  rw [Causal.Flat.minkQ_smul, mul_pos_iff_of_pos_left (pow_pos hc 2)]

/-- A null vector is future iff its time component is positive. -/
theorem fst_pos_iff_isFutureCausal {v : Causal.Minkowski d} (hv : v ≠ 0)
    (hq : Causal.Flat.minkQ v = 0) : 0 < v.1 ↔ Causal.Flat.IsFutureCausal v :=
  ⟨fun h => ⟨h.le, hq.le⟩, fun h => lt_of_le_of_ne h.1 fun h0 =>
    hv (Causal.Flat.eq_zero_of_fst_eq_zero h0.symm hq.le)⟩

theorem mem_bdPlus_iff' {σ : HS d} : σ ∈ piece d .bdPlus ↔
    Causal.Flat.minkQ (σ : Causal.Minkowski d) = 0 ∧
      Causal.Flat.IsFutureCausal (σ : Causal.Minkowski d) :=
  ⟨fun h => ⟨h.1, (fst_pos_iff_isFutureCausal (raySphere_ne_zero σ) h.1).1 h.2⟩,
    fun h => ⟨h.1, (fst_pos_iff_isFutureCausal (raySphere_ne_zero σ) h.1).2 h.2⟩⟩

theorem mem_bdMinus_iff' {σ : HS d} : σ ∈ piece d .bdMinus ↔
    Causal.Flat.minkQ (σ : Causal.Minkowski d) = 0 ∧
      Causal.Flat.IsFutureCausal (-(σ : Causal.Minkowski d)) := by
  have hne : -(σ : Causal.Minkowski d) ≠ 0 := neg_ne_zero.2 (raySphere_ne_zero σ)
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨h1, (fst_pos_iff_isFutureCausal hne (by rw [Causal.Flat.minkQ_neg, h1])).1 ?_⟩
    simpa using h2
  · rintro ⟨h1, h2⟩
    refine ⟨h1, ?_⟩
    have := (fst_pos_iff_isFutureCausal hne (by rw [Causal.Flat.minkQ_neg, h1])).2 h2
    simpa using this

theorem exists_coe_smul (A : Causal.Flat.lorentz d) (σ : HS d) : ∃ c : ℝ, 0 < c ∧
    ((A • σ : HS d) : Causal.Minkowski d) =
      c • (A : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) σ :=
  ⟨_, inv_pos.2 (norm_pos_iff.2 ((LinearEquiv.map_ne_zero_iff _).2 (raySphere_ne_zero σ))),
    coe_hs_smul A σ⟩

/-- **`SO₀(1,d)` preserves the decomposition** (`colI_v1.tex:596`). -/
theorem smul_mem_piece_iff (A : Causal.Flat.lorentz d) {σ : HS d} {k : HSPiece} :
    A • σ ∈ piece d k ↔ σ ∈ piece d k := by
  obtain ⟨c, hc, h⟩ := exists_coe_smul A σ
  set A' : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d := A.1
  have hQ : ∀ v, Causal.Flat.minkQ (A' v) = Causal.Flat.minkQ v :=
    Causal.Flat.lorentz.minkQ_apply A.2
  rcases k with _ | _ | _ | _ | _
  · show Causal.Flat.IsFutureTimelike _ ↔ Causal.Flat.IsFutureTimelike _
    rw [h, isFutureTimelike_smul_iff hc]
    exact Causal.Flat.lorentz.isFutureTimelike_apply_iff A.2
  · show Causal.Flat.IsFutureTimelike _ ↔ Causal.Flat.IsFutureTimelike _
    rw [h, ← smul_neg, ← map_neg, isFutureTimelike_smul_iff hc]
    exact Causal.Flat.lorentz.isFutureTimelike_apply_iff A.2
  · show 0 < Causal.Flat.minkQ _ ↔ 0 < Causal.Flat.minkQ _
    rw [h, minkQ_smul_pos_iff hc, hQ]
  · rw [mem_bdPlus_iff', mem_bdPlus_iff', h, minkQ_smul_eq_zero_iff hc, hQ,
      isFutureCausal_smul_iff hc, Causal.Flat.lorentz.isFutureCausal_apply_iff A.2]
  · rw [mem_bdMinus_iff', mem_bdMinus_iff', h, minkQ_smul_eq_zero_iff hc, hQ, ← smul_neg,
      ← map_neg, isFutureCausal_smul_iff hc, Causal.Flat.lorentz.isFutureCausal_apply_iff A.2]

theorem region_smul (A : Causal.Flat.lorentz d) (σ : HS d) : region (A • σ) = region σ :=
  region_eq_of_mem ((smul_mem_piece_iff A).2 (mem_piece_region σ))

/-- The antipodal map exchanges `ℍᵈ₊` and `ℍᵈ₋`. -/
theorem neg_mem_hypMinus_iff {σ : HS d} : -σ ∈ piece d .hypMinus ↔ σ ∈ piece d .hypPlus := by
  show Causal.Flat.IsFutureTimelike (-((-σ : HS d) : Causal.Minkowski d)) ↔ _
  rw [coe_neg_sphere, neg_neg]; rfl

/-- The antipodal map exchanges `∂ℍᵈ₊` and `∂ℍᵈ₋`. -/
theorem neg_mem_bdMinus_iff {σ : HS d} : -σ ∈ piece d .bdMinus ↔ σ ∈ piece d .bdPlus := by
  show Causal.Flat.minkQ ((-σ : HS d) : Causal.Minkowski d) = 0 ∧
    ((-σ : HS d) : Causal.Minkowski d).1 < 0 ↔ _
  rw [coe_neg_sphere, Causal.Flat.minkQ_neg, Prod.fst_neg, neg_lt_zero]; rfl

/-! #### Coordinates: the sup norm puts `ℍᵈ₊` on the Klein disc `{t = 1}` -/

theorem max_abs_fst_norm_snd (σ : HS d) :
    max |(σ : Causal.Minkowski d).1| ‖(σ : Causal.Minkowski d).2‖ = 1 := by
  have := norm_raySphere σ
  rwa [Prod.norm_def, Real.norm_eq_abs] at this

theorem minkQ_lt_zero_iff_norm {v : Causal.Minkowski d} :
    Causal.Flat.minkQ v < 0 ↔ ‖v.2‖ < |v.1| := by
  rw [Causal.Flat.minkQ_lt_zero_iff, sq_lt_sq, abs_norm]

theorem minkQ_eq_zero_iff_norm {v : Causal.Minkowski d} :
    Causal.Flat.minkQ v = 0 ↔ ‖v.2‖ = |v.1| := by
  rw [← abs_norm, ← sq_eq_sq_iff_abs_eq_abs, Causal.Flat.minkQ]
  constructor <;> intro h <;> linarith

theorem minkQ_pos_iff_norm {v : Causal.Minkowski d} :
    0 < Causal.Flat.minkQ v ↔ |v.1| < ‖v.2‖ := by
  rw [← abs_norm (v.2), ← sq_lt_sq, Causal.Flat.minkQ]
  constructor <;> intro h <;> linarith

theorem mem_hypPlus_iff {σ : HS d} :
    σ ∈ piece d .hypPlus ↔ (σ : Causal.Minkowski d).1 = 1 ∧ ‖(σ : Causal.Minkowski d).2‖ < 1 := by
  have hm := max_abs_fst_norm_snd σ
  show Causal.Flat.IsFutureTimelike _ ↔ _
  rw [Causal.Flat.IsFutureTimelike, minkQ_lt_zero_iff_norm]
  constructor
  · rintro ⟨h1, h2⟩
    rw [max_eq_left h2.le, abs_of_pos h1] at hm
    rw [abs_of_pos h1, hm] at h2
    exact ⟨hm, h2⟩
  · rintro ⟨h1, h2⟩
    rw [h1, abs_one]
    exact ⟨one_pos, h2⟩

theorem mem_hypMinus_iff {σ : HS d} :
    σ ∈ piece d .hypMinus ↔ (σ : Causal.Minkowski d).1 = -1 ∧ ‖(σ : Causal.Minkowski d).2‖ < 1 := by
  have hm := max_abs_fst_norm_snd σ
  show Causal.Flat.IsFutureTimelike _ ↔ _
  rw [Causal.Flat.IsFutureTimelike, Causal.Flat.minkQ_neg, minkQ_lt_zero_iff_norm, Prod.fst_neg,
    Left.neg_pos_iff]
  constructor
  · rintro ⟨h1, h2⟩
    rw [max_eq_left h2.le, abs_of_neg h1] at hm
    rw [abs_of_neg h1, hm] at h2
    exact ⟨by linarith, h2⟩
  · rintro ⟨h1, h2⟩
    rw [h1]
    exact ⟨by norm_num, by rw [abs_neg, abs_one]; exact h2⟩

theorem mem_bdPlus_iff {σ : HS d} :
    σ ∈ piece d .bdPlus ↔ (σ : Causal.Minkowski d).1 = 1 ∧ ‖(σ : Causal.Minkowski d).2‖ = 1 := by
  have hm := max_abs_fst_norm_snd σ
  show Causal.Flat.minkQ _ = 0 ∧ 0 < _ ↔ _
  rw [minkQ_eq_zero_iff_norm]
  constructor
  · rintro ⟨h1, h2⟩
    rw [h1, max_self, abs_of_pos h2] at hm
    rw [h1, abs_of_pos h2, hm]
    exact ⟨rfl, rfl⟩
  · rintro ⟨h1, h2⟩
    rw [h1, h2, abs_one]
    exact ⟨rfl, one_pos⟩

theorem mem_bdMinus_iff {σ : HS d} :
    σ ∈ piece d .bdMinus ↔ (σ : Causal.Minkowski d).1 = -1 ∧ ‖(σ : Causal.Minkowski d).2‖ = 1 := by
  have hm := max_abs_fst_norm_snd σ
  show Causal.Flat.minkQ _ = 0 ∧ _ < 0 ↔ _
  rw [minkQ_eq_zero_iff_norm]
  constructor
  · rintro ⟨h1, h2⟩
    rw [h1, max_self, abs_of_neg h2] at hm
    rw [h1, abs_of_neg h2, hm]
    exact ⟨by linarith, rfl⟩
  · rintro ⟨h1, h2⟩
    rw [h1, h2, abs_neg, abs_one]
    exact ⟨rfl, by norm_num⟩

theorem mem_deSitter_iff {σ : HS d} :
    σ ∈ piece d .deSitter ↔ |(σ : Causal.Minkowski d).1| < 1 ∧ ‖(σ : Causal.Minkowski d).2‖ = 1 := by
  have hm := max_abs_fst_norm_snd σ
  show 0 < Causal.Flat.minkQ _ ↔ _
  rw [minkQ_pos_iff_norm]
  constructor
  · intro h
    rw [max_eq_right h.le] at hm
    exact ⟨lt_of_lt_of_eq h hm, hm⟩
  · rintro ⟨h1, h2⟩
    rw [h2]; exact h1

/-- The sup norm of a future causal vector is its time component. -/
theorem norm_eq_fst_of_isFutureCausal {v : Causal.Minkowski d}
    (hv : Causal.Flat.IsFutureCausal v) : ‖v‖ = v.1 := by
  have h2 : ‖v.2‖ ≤ v.1 := by
    exact (sq_le_sq₀ (norm_nonneg _) hv.1).1 (Causal.Flat.minkQ_le_zero_iff.1 hv.2)
  rw [Prod.norm_def, Real.norm_eq_abs, abs_of_nonneg hv.1, max_eq_left h2]

/-- On future causal rays the action is **projective** in the chart `{t = 1}`:
`A · σ = A σ / (A σ)₀`. -/
theorem coe_smul_of_isFutureCausal (A : Causal.Flat.lorentz d) {σ : HS d}
    (hσ : Causal.Flat.IsFutureCausal (σ : Causal.Minkowski d)) :
    ((A • σ : HS d) : Causal.Minkowski d) =
      ((A : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) σ).1⁻¹ •
        (A : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) σ := by
  rw [coe_hs_smul, norm_eq_fst_of_isFutureCausal (Causal.Flat.lorentz.isFutureCausal_apply A.2 hσ)]

/-! #### Topology: `ℍᵈ±`, `dSᵈ` open, `∂ℍᵈ±` their frontiers -/

theorem isOpen_hypPlus : IsOpen (piece d .hypPlus) := by
  have : IsOpen {v : Causal.Minkowski d | Causal.Flat.IsFutureTimelike v} :=
    (isOpen_lt continuous_const continuous_fst).inter
      (isOpen_lt Causal.Flat.continuous_minkQ continuous_const)
  exact this.preimage continuous_subtype_val

theorem isOpen_hypMinus : IsOpen (piece d .hypMinus) := by
  have : IsOpen {v : Causal.Minkowski d | Causal.Flat.IsFutureTimelike (-v)} :=
    ((isOpen_lt continuous_const continuous_fst).inter
      (isOpen_lt Causal.Flat.continuous_minkQ continuous_const)).preimage continuous_neg
  exact this.preimage continuous_subtype_val

theorem isOpen_deSitter : IsOpen (piece d .deSitter) := by
  exact isOpen_lt continuous_const (Causal.Flat.continuous_minkQ.comp continuous_subtype_val)

/-- The antipodal map of `HSᵈ`, a homeomorphism. -/
def negHomeomorph : HS d ≃ₜ HS d where
  toEquiv := Equiv.neg (HS d)
  continuous_toFun := continuous_neg
  continuous_invFun := continuous_neg

theorem hypMinus_eq_preimage :
    piece d .hypMinus = (negHomeomorph : HS d → HS d) ⁻¹' piece d .hypPlus := by
  ext σ
  show σ ∈ piece d .hypMinus ↔ -σ ∈ piece d .hypPlus
  rw [← neg_mem_hypMinus_iff, neg_neg]

theorem bdMinus_eq_preimage :
    piece d .bdMinus = (negHomeomorph : HS d → HS d) ⁻¹' piece d .bdPlus := by
  ext σ
  show σ ∈ piece d .bdMinus ↔ -σ ∈ piece d .bdPlus
  rw [← neg_mem_bdMinus_iff, neg_neg]

theorem closure_hypPlus : closure (piece d .hypPlus) = piece d .hypPlus ∪ piece d .bdPlus := by
  refine subset_antisymm ?_ (union_subset subset_closure ?_)
  · -- the closed set of future causal rays
    have hC : IsClosed {σ : HS d | Causal.Flat.IsFutureCausal (σ : Causal.Minkowski d)} :=
      ((isClosed_le continuous_const continuous_fst).inter
        (isClosed_le Causal.Flat.continuous_minkQ continuous_const)).preimage continuous_subtype_val
    have hsub : piece d .hypPlus ⊆
        {σ : HS d | Causal.Flat.IsFutureCausal (σ : Causal.Minkowski d)} :=
      fun σ (hσ : Causal.Flat.IsFutureTimelike _) => ⟨hσ.1.le, hσ.2.le⟩
    refine (closure_minimal hsub hC).trans fun σ hσ => ?_
    rcases (hσ.2 : Causal.Flat.minkQ (σ : Causal.Minkowski d) ≤ 0).lt_or_eq with h | h
    · exact Or.inl ⟨lt_of_le_of_ne hσ.1 (fst_ne_zero_of_minkQ_nonpos σ h.le).symm, h⟩
    · exact Or.inr ((mem_bdPlus_iff').2 ⟨h, hσ⟩)
  · intro σ hσ
    obtain ⟨h1, h2⟩ := mem_bdPlus_iff.1 hσ
    rw [IsInducing.subtypeVal.closure_eq_preimage_closure_image, mem_preimage]
    set x := (σ : Causal.Minkowski d).2
    have hf : Tendsto (fun s : ℝ => ((1 : ℝ), s • x)) (𝓝[<] 1) (𝓝 (σ : Causal.Minkowski d)) := by
      have : Continuous fun s : ℝ => ((1 : ℝ), s • x) := by fun_prop
      have h := this.tendsto 1
      rw [one_smul] at h
      have he : ((1 : ℝ), x) = (σ : Causal.Minkowski d) := Prod.ext h1.symm rfl
      rw [he] at h
      exact h.mono_left nhdsWithin_le_nhds
    refine mem_closure_of_tendsto hf ?_
    have hev : ∀ᶠ s in 𝓝[<] (1 : ℝ), s ∈ Ioo (0 : ℝ) 1 := Ioo_mem_nhdsLT (by norm_num)
    filter_upwards [hev] with s hs
    have hn : ‖s • x‖ = s := by rw [norm_smul, h2, mul_one, Real.norm_eq_abs, abs_of_pos hs.1]
    refine ⟨⟨((1 : ℝ), s • x), mem_sphere_zero_iff_norm.2 ?_⟩, mem_hypPlus_iff.2 ⟨rfl, ?_⟩, rfl⟩
    · rw [Prod.norm_mk, norm_one, hn, max_eq_left hs.2.le]
    · show ‖s • x‖ < 1
      rw [hn]; exact hs.2

theorem closure_hypMinus :
    closure (piece d .hypMinus) = piece d .hypMinus ∪ piece d .bdMinus := by
  rw [hypMinus_eq_preimage, bdMinus_eq_preimage, ← Homeomorph.preimage_closure, closure_hypPlus,
    preimage_union]

/-- **`∂ℍᵈ₊` is the boundary of `ℍᵈ₊` in `HSᵈ`** (`colI_v1.tex:590`). -/
theorem frontier_hypPlus : frontier (piece d .hypPlus) = piece d .bdPlus := by
  rw [isOpen_hypPlus.frontier_eq, closure_hypPlus, union_sdiff_left]
  exact sdiff_eq_left.2 (pairwise_disjoint_piece (by decide : HSPiece.bdPlus ≠ .hypPlus))

/-- **`∂ℍᵈ₋` is the boundary of `ℍᵈ₋` in `HSᵈ`** (`colI_v1.tex:590`). -/
theorem frontier_hypMinus : frontier (piece d .hypMinus) = piece d .bdMinus := by
  rw [isOpen_hypMinus.frontier_eq, closure_hypMinus, union_sdiff_left]
  exact sdiff_eq_left.2 (pairwise_disjoint_piece (by decide : HSPiece.bdMinus ≠ .hypMinus))

theorem isClosed_bdPlus : IsClosed (piece d .bdPlus) := by
  rw [← frontier_hypPlus]; exact isClosed_frontier

theorem isClosed_bdMinus : IsClosed (piece d .bdMinus) := by
  rw [← frontier_hypMinus]; exact isClosed_frontier

/-! #### The Klein disc, the circle at infinity, the de Sitter cylinder -/

/-- **`ℍᵈ₊` is the Klein disc**: `σ ↦ x` for `σ = (1, x)`, onto the open unit ball of `ℝᵈ`
(`colI_v1.tex:593`: "the Klein models of the hyperbolic plane"). -/
def hypPlusHomeomorph : piece d .hypPlus ≃ₜ ball (0 : EuclideanSpace ℝ (Fin d)) 1 where
  toFun σ := ⟨(σ.1 : Causal.Minkowski d).2, mem_ball_zero_iff.2 (mem_hypPlus_iff.1 σ.2).2⟩
  invFun x := ⟨⟨(1, x), mem_sphere_zero_iff_norm.2 (by
      rw [Prod.norm_mk, norm_one, max_eq_left (mem_ball_zero_iff.1 x.2).le])⟩,
    mem_hypPlus_iff.2 ⟨rfl, mem_ball_zero_iff.1 x.2⟩⟩
  left_inv σ := by
    exact Subtype.ext (Subtype.ext (Prod.ext (mem_hypPlus_iff.1 σ.2).1.symm rfl))
  right_inv x := rfl
  continuous_toFun := by
    exact (continuous_snd.comp (continuous_subtype_val.comp continuous_subtype_val)).subtype_mk _
  continuous_invFun := by
    exact ((continuous_const.prodMk continuous_subtype_val).subtype_mk _).subtype_mk _

/-- The lightlike point `(1, u)` of `∂ℍᵈ₊` over `u ∈ 𝕊ᵈ⁻¹` (lean-causal's `nullVec`). -/
def nullPt (u : Causal.Flat.PenroseSphere d) : HS d :=
  ⟨Causal.Flat.nullVec u, mem_sphere_zero_iff_norm.2 (by
    rw [Causal.Flat.nullVec, Prod.norm_mk, norm_one, Causal.Flat.norm_penroseSphere, max_self])⟩

theorem nullPt_mem_bdPlus (u : Causal.Flat.PenroseSphere d) : nullPt u ∈ piece d .bdPlus :=
  mem_bdPlus_iff.2 ⟨rfl, Causal.Flat.norm_penroseSphere u⟩

/-- **`∂ℍᵈ₊` is the sphere `𝕊ᵈ⁻¹`** (a circle for `d = 2`), through `nullPt`. -/
def bdPlusHomeomorph : piece d .bdPlus ≃ₜ Causal.Flat.PenroseSphere d where
  toFun σ := ⟨(σ.1 : Causal.Minkowski d).2, mem_sphere_zero_iff_norm.2 (mem_bdPlus_iff.1 σ.2).2⟩
  invFun u := ⟨nullPt u, nullPt_mem_bdPlus u⟩
  left_inv σ := by
    exact Subtype.ext (Subtype.ext (Prod.ext (mem_bdPlus_iff.1 σ.2).1.symm rfl))
  right_inv u := rfl
  continuous_toFun := by
    exact (continuous_snd.comp (continuous_subtype_val.comp continuous_subtype_val)).subtype_mk _
  continuous_invFun := by
    exact ((continuous_const.prodMk continuous_subtype_val).subtype_mk _).subtype_mk _

/-- **On `∂ℍᵈ₊` the action is lean-causal's (Barbot's) action on the Penrose sphere**:
`A · (1, u) = (1, [A]u)`. -/
theorem smul_nullPt (A : Causal.Flat.lorentz d) (u : Causal.Flat.PenroseSphere d) :
    A • nullPt u = nullPt (Causal.Flat.lorentzSphere A u) := by
  refine Subtype.ext ?_
  rw [coe_smul_of_isFutureCausal A (Causal.Flat.isFutureCausal_nullVec u)]
  exact (Causal.Flat.nullVec_lorentzSphere A u).symm

/-- **`dSᵈ` is the cylinder `]−1, 1[ × 𝕊ᵈ⁻¹`** (an annulus for `d = 2`). -/
def deSitterHomeomorph :
    piece d .deSitter ≃ₜ Ioo (-1 : ℝ) 1 × Causal.Flat.PenroseSphere d where
  toFun σ := (⟨(σ.1 : Causal.Minkowski d).1, abs_lt.1 (mem_deSitter_iff.1 σ.2).1⟩,
    ⟨(σ.1 : Causal.Minkowski d).2, mem_sphere_zero_iff_norm.2 (mem_deSitter_iff.1 σ.2).2⟩)
  invFun p := ⟨⟨((p.1 : ℝ), (p.2 : EuclideanSpace ℝ (Fin d))), mem_sphere_zero_iff_norm.2 (by
      rw [Prod.norm_mk, Causal.Flat.norm_penroseSphere, Real.norm_eq_abs,
        max_eq_right (abs_lt.2 p.1.2).le])⟩,
    mem_deSitter_iff.2 ⟨abs_lt.2 p.1.2, Causal.Flat.norm_penroseSphere p.2⟩⟩
  left_inv σ := by
    rfl
  right_inv p := rfl
  continuous_toFun := by
    exact ((continuous_fst.comp (continuous_subtype_val.comp continuous_subtype_val)).subtype_mk
      _).prodMk ((continuous_snd.comp (continuous_subtype_val.comp continuous_subtype_val)).subtype_mk _)
  continuous_invFun := by
    exact (((continuous_subtype_val.comp continuous_fst).prodMk
      (continuous_subtype_val.comp continuous_snd)).subtype_mk _).subtype_mk _

/-! #### Transitivity: the five pieces are the five orbits (`d ≥ 2`) -/

/-- A spatial rotation `(t, x) ↦ (t, R x)` of `ℝ^{1,d}`, as a linear map. -/
def rotLin (R : SpecialOrth (EuclideanSpace ℝ (Fin d))) :
    Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d :=
  LinearEquiv.prodCongr (LinearEquiv.refl ℝ ℝ)
    ((R : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] _).toLinearEquiv)

theorem rotLin_apply (R : SpecialOrth (EuclideanSpace ℝ (Fin d))) (v : Causal.Minkowski d) :
    rotLin R v = (v.1, (R : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] _) v.2) := rfl

theorem rotLin_mem (R : SpecialOrth (EuclideanSpace ℝ (Fin d))) :
    rotLin R ∈ Causal.Flat.lorentz d := by
  have hQ : ∀ v, Causal.Flat.minkQ (rotLin R v) = Causal.Flat.minkQ v := fun v => by
    rw [rotLin_apply]; simp only [Causal.Flat.minkQ, LinearIsometryEquiv.norm_map]
  refine Causal.Flat.mem_lorentz_of hQ ?_ ?_
  · rw [rotLin_apply]; simp [Causal.Flat.timeUnit]
  · show LinearMap.det (LinearMap.prodMap (LinearMap.id : ℝ →ₗ[ℝ] ℝ)
        (((R : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin d)).toLinearEquiv :
          EuclideanSpace ℝ (Fin d) ≃ₗ[ℝ] EuclideanSpace ℝ (Fin d)) :
          EuclideanSpace ℝ (Fin d) →ₗ[ℝ] EuclideanSpace ℝ (Fin d))) = 1
    rw [LinearMap.det_prodMap, LinearMap.det_id, one_mul]
    exact R.2

/-- A spatial rotation `(t, x) ↦ (t, R x)`, `R ∈ SO(d)`, as an element of `SO₀(1,d)`. -/
def rot (R : SpecialOrth (EuclideanSpace ℝ (Fin d))) : Causal.Flat.lorentz d :=
  ⟨rotLin R, rotLin_mem R⟩

theorem rot_apply (R : SpecialOrth (EuclideanSpace ℝ (Fin d))) (v : Causal.Minkowski d) :
    (rot R : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) v =
      (v.1, (R : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] _) v.2) := rfl

/-- The boost of rapidity `ζ` along the spatial coordinate `i` (lean-causal's `stdBoost`), as an
element of `SO₀(1,d)`. -/
def boost (i : Fin d) (ζ : ℝ) : Causal.Flat.lorentz d :=
  ⟨Causal.Flat.stdBoost i ζ, Causal.Flat.stdBoost_mem_lorentz i ζ⟩

theorem boost_apply_timeUnit (i : Fin d) (ζ : ℝ) :
    (boost i ζ : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) (Causal.Flat.timeUnit d) =
      (Real.cosh ζ, Real.sinh ζ • EuclideanSpace.single i (1 : ℝ)) := by
  refine Prod.ext ?_ ?_
  · simp [boost, Causal.Flat.stdBoost, Causal.Flat.boost_apply, Causal.Flat.boostLin_apply,
      Causal.Flat.minkB, Causal.Flat.timeUnit, Causal.Flat.spaceUnit]
    try module
  · simp [boost, Causal.Flat.stdBoost, Causal.Flat.boost_apply, Causal.Flat.boostLin_apply,
      Causal.Flat.minkB, Causal.Flat.timeUnit, Causal.Flat.spaceUnit]
    try module

theorem boost_apply_spaceUnit (i : Fin d) (ζ : ℝ) :
    (boost i ζ : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) (Causal.Flat.spaceUnit i) =
      (Real.sinh ζ, Real.cosh ζ • EuclideanSpace.single i (1 : ℝ)) := by
  refine Prod.ext ?_ ?_
  · simp [boost, Causal.Flat.stdBoost, Causal.Flat.boost_apply, Causal.Flat.boostLin_apply,
      Causal.Flat.minkB, Causal.Flat.timeUnit, Causal.Flat.spaceUnit]
    try module
  · simp [boost, Causal.Flat.stdBoost, Causal.Flat.boost_apply, Causal.Flat.boostLin_apply,
      Causal.Flat.minkB, Causal.Flat.timeUnit, Causal.Flat.spaceUnit]
    try module

/-- The subgroup of `SO₀(1,d)` generated by the spatial rotations and the boosts along the first
spatial axis. -/
def boostRot (hd : 2 ≤ d) : Subgroup (Causal.Flat.lorentz d) :=
  Subgroup.closure (range (rot (d := d)) ∪ range (boost ⟨0, by omega⟩))

/-- The first spatial axis `e₀ ∈ 𝕊ᵈ⁻¹` (`d ≥ 1`). -/
def axisPt (hd : 1 ≤ d) : Causal.Flat.PenroseSphere d :=
  ⟨EuclideanSpace.single ⟨0, hd⟩ 1, mem_sphere_zero_iff_norm.2 (by simp)⟩

/-- A base point of each piece: `(1, 0)`, `(−1, 0)`, `(0, e₀)`, `(1, e₀)`, `(−1, −e₀)`. -/
def base (hd : 1 ≤ d) : HSPiece → HS d
  | .hypPlus => pole d
  | .hypMinus => -pole d
  | .deSitter => ⟨Causal.Flat.spaceUnit ⟨0, hd⟩, mem_sphere_zero_iff_norm.2 (by
      simp [Causal.Flat.spaceUnit, Prod.norm_def])⟩
  | .bdPlus => nullPt (axisPt hd)
  | .bdMinus => -nullPt (axisPt hd)

theorem pole_mem_hypPlus : pole d ∈ piece d .hypPlus :=
  mem_hypPlus_iff.2 ⟨rfl, by simp [pole]⟩

theorem base_mem (hd : 1 ≤ d) (k : HSPiece) : base hd k ∈ piece d k := by
  rcases k with _ | _ | _ | _ | _
  · exact pole_mem_hypPlus
  · exact neg_mem_hypMinus_iff.2 pole_mem_hypPlus
  · exact mem_deSitter_iff.2 ⟨by simp [base, Causal.Flat.spaceUnit],
      by simp [base, Causal.Flat.spaceUnit]⟩
  · exact nullPt_mem_bdPlus _
  · exact neg_mem_bdMinus_iff.2 (nullPt_mem_bdPlus _)

theorem exists_eq_norm_smul (hd : 1 ≤ d) (x : EuclideanSpace ℝ (Fin d)) :
    ∃ u : Causal.Flat.PenroseSphere d, x = ‖x‖ • (u : EuclideanSpace ℝ (Fin d)) := by
  by_cases hx : x = 0
  · exact ⟨axisPt hd, by rw [hx, norm_zero, zero_smul]⟩
  · refine ⟨⟨‖x‖⁻¹ • x, mem_sphere_zero_iff_norm.2 (norm_inv_smul_self hx)⟩, ?_⟩
    show x = ‖x‖ • ‖x‖⁻¹ • x
    rw [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.2 hx), one_smul]

/-- `SO(d)` takes `e₀` to any unit vector (`d ≥ 2`; kb/0018). -/
theorem exists_rot_axis (hd : 2 ≤ d) (u : Causal.Flat.PenroseSphere d) :
    ∃ R : SpecialOrth (EuclideanSpace ℝ (Fin d)),
      (R : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin d))
        (EuclideanSpace.single ⟨0, by omega⟩ 1) = (u : EuclideanSpace ℝ (Fin d)) := by
  obtain ⟨R, hR⟩ := exists_specialOrth_smul_eq (V := EuclideanSpace ℝ (Fin d))
    (by rw [finrank_euclideanSpace_fin]; exact hd) (axisPt (by omega)) u
  exact ⟨R, congrArg Subtype.val hR⟩

theorem rot_mem_boostRot (hd : 2 ≤ d) (R : SpecialOrth (EuclideanSpace ℝ (Fin d))) :
    rot R ∈ boostRot hd :=
  Subgroup.subset_closure (Or.inl ⟨R, rfl⟩)

theorem boost_mem_boostRot (hd : 2 ≤ d) (ζ : ℝ) : boost ⟨0, by omega⟩ ζ ∈ boostRot hd :=
  Subgroup.subset_closure (Or.inr ⟨ζ, rfl⟩)

theorem sinh_artanh_eq {s : ℝ} (hs : s ∈ Ioo (-1 : ℝ) 1) :
    Real.sinh (Real.artanh s) = s * Real.cosh (Real.artanh s) := by
  rw [Real.sinh_artanh hs, Real.cosh_artanh hs]; ring

/-- `ℍᵈ₊` is the orbit of the pole under rotations and boosts. -/
theorem exists_smul_pole (hd : 2 ≤ d) {σ : HS d} (hσ : σ ∈ piece d .hypPlus) :
    ∃ A ∈ boostRot hd, A • pole d = σ := by
  obtain ⟨h1, h2⟩ := mem_hypPlus_iff.1 hσ
  set x := (σ : Causal.Minkowski d).2 with hx_def
  obtain ⟨u, hu⟩ := exists_eq_norm_smul (by omega) x
  obtain ⟨R, hR⟩ := exists_rot_axis hd u
  have hxI : ‖x‖ ∈ Ioo (-1 : ℝ) 1 := ⟨by linarith [norm_nonneg x], h2⟩
  set ζ := Real.artanh ‖x‖
  refine ⟨rot R * boost ⟨0, by omega⟩ ζ, mul_mem (rot_mem_boostRot hd R)
    (boost_mem_boostRot hd ζ), ?_⟩
  rw [hs_smul_def, linRaySmul_eq_iff]
  refine ⟨Real.cosh ζ, Real.cosh_pos ζ, ?_⟩
  show (rot R : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d)
    ((boost (d := d) ⟨0, by omega⟩ ζ : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d)
      (Causal.Flat.timeUnit d)) = _
  rw [boost_apply_timeUnit, rot_apply]
  refine Prod.ext ?_ ?_
  · show Real.cosh ζ = Real.cosh ζ * (σ : Causal.Minkowski d).1
    rw [h1, mul_one]
  · show (R : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] _) (Real.sinh ζ • EuclideanSpace.single _ 1) =
      Real.cosh ζ • x
    rw [map_smul, hR, sinh_artanh_eq hxI]
    conv_rhs => rw [hu]
    rw [smul_smul, mul_comm]

/-- `dSᵈ` is the orbit of `(0, e₀)` under rotations and boosts. -/
theorem exists_smul_deSitterBase (hd : 2 ≤ d) {σ : HS d} (hσ : σ ∈ piece d .deSitter) :
    ∃ A ∈ boostRot hd, A • base (by omega) .deSitter = σ := by
  obtain ⟨h1, h2⟩ := mem_deSitter_iff.1 hσ
  set x := (σ : Causal.Minkowski d).2 with hx_def
  set t := (σ : Causal.Minkowski d).1 with ht_def
  obtain ⟨R, hR⟩ := exists_rot_axis hd ⟨x, mem_sphere_zero_iff_norm.2 h2⟩
  have htI : t ∈ Ioo (-1 : ℝ) 1 := abs_lt.1 h1
  set ζ := Real.artanh t
  refine ⟨rot R * boost ⟨0, by omega⟩ ζ, mul_mem (rot_mem_boostRot hd R)
    (boost_mem_boostRot hd ζ), ?_⟩
  rw [hs_smul_def, linRaySmul_eq_iff]
  refine ⟨Real.cosh ζ, Real.cosh_pos ζ, ?_⟩
  show (rot R : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d)
    ((boost (d := d) ⟨0, by omega⟩ ζ : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d)
      (Causal.Flat.spaceUnit ⟨0, by omega⟩)) = _
  rw [boost_apply_spaceUnit, rot_apply]
  refine Prod.ext ?_ ?_
  · show Real.sinh ζ = Real.cosh ζ * t
    rw [sinh_artanh_eq htI, mul_comm]
  · show (R : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] _) (Real.cosh ζ • EuclideanSpace.single _ 1) =
      Real.cosh ζ • x
    rw [map_smul, hR]

/-- `∂ℍᵈ₊` is the orbit of `(1, e₀)` under rotations. -/
theorem exists_smul_nullBase (hd : 2 ≤ d) {σ : HS d} (hσ : σ ∈ piece d .bdPlus) :
    ∃ A ∈ boostRot hd, A • nullPt (axisPt (by omega)) = σ := by
  obtain ⟨h1, h2⟩ := mem_bdPlus_iff.1 hσ
  obtain ⟨R, hR⟩ := exists_rot_axis hd ⟨(σ : Causal.Minkowski d).2, mem_sphere_zero_iff_norm.2 h2⟩
  refine ⟨rot R, rot_mem_boostRot hd R, ?_⟩
  rw [hs_smul_def, linRaySmul_eq_iff]
  refine ⟨1, one_pos, ?_⟩
  rw [one_smul, rot_apply]
  exact Prod.ext h1.symm hR

theorem exists_smul_base (hd : 2 ≤ d) {σ : HS d} {k : HSPiece} (hσ : σ ∈ piece d k) :
    ∃ A ∈ boostRot hd, A • base (by omega) k = σ := by
  rcases k with _ | _ | _ | _ | _
  · exact exists_smul_pole hd hσ
  · obtain ⟨A, hA, h⟩ := exists_smul_pole hd (neg_mem_hypMinus_iff.1 ((neg_neg σ).symm ▸ hσ))
    exact ⟨A, hA, by rw [base, hs_smul_neg, h, neg_neg]⟩
  · exact exists_smul_deSitterBase hd hσ
  · exact exists_smul_nullBase hd hσ
  · obtain ⟨A, hA, h⟩ := exists_smul_nullBase hd (neg_mem_bdMinus_iff.1 ((neg_neg σ).symm ▸ hσ))
    exact ⟨A, hA, by rw [base, hs_smul_neg, h, neg_neg]⟩

/-- **An element of `SO₀(1,d)` fixing the time axis is a spatial rotation.** -/
theorem exists_rot_eq_of_fix {C : Causal.Flat.lorentz d}
    (hC : (C : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) (Causal.Flat.timeUnit d) =
      Causal.Flat.timeUnit d) :
    ∃ R : SpecialOrth (EuclideanSpace ℝ (Fin d)), C = rot R := by
  set C' : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d := C.1
  have h0 : ∀ x : EuclideanSpace ℝ (Fin d), (C' ((0 : ℝ), x)).1 = 0 := fun x => by
    have := Causal.Flat.lorentz.minkB_apply C.2 ((0 : ℝ), x) (Causal.Flat.timeUnit d)
    change Causal.Flat.minkB (C' ((0 : ℝ), x)) (C' (Causal.Flat.timeUnit d)) = _ at this
    rw [hC] at this
    simpa [Causal.Flat.minkB, Causal.Flat.timeUnit] using this
  set f : EuclideanSpace ℝ (Fin d) →ₗ[ℝ] EuclideanSpace ℝ (Fin d) :=
    (LinearMap.snd ℝ ℝ (EuclideanSpace ℝ (Fin d))).comp
      ((C' : Causal.Minkowski d →ₗ[ℝ] Causal.Minkowski d).comp
        (LinearMap.inr ℝ ℝ (EuclideanSpace ℝ (Fin d))))
  have hf : ∀ x, f x = (C' ((0 : ℝ), x)).2 := fun x => rfl
  have hCv : ∀ v : Causal.Minkowski d, C' v = (v.1, f v.2) := fun v => by
    have hv : v = v.1 • Causal.Flat.timeUnit d + ((0 : ℝ), v.2) := by
      refine Prod.ext ?_ ?_ <;> simp [Causal.Flat.timeUnit]
    have e1 : C' v = v.1 • C' (Causal.Flat.timeUnit d) + C' ((0 : ℝ), v.2) := by
      conv_lhs => rw [hv]
      rw [map_add, map_smul]
    rw [e1, hC]
    refine Prod.ext ?_ ?_
    · simp [h0, Causal.Flat.timeUnit]
    · simp [hf, Causal.Flat.timeUnit]
  have hnorm : ∀ x, ‖f x‖ = ‖x‖ := fun x => by
    have := Causal.Flat.lorentz.minkQ_apply C.2 ((0 : ℝ), x)
    change Causal.Flat.minkQ (C' ((0 : ℝ), x)) = _ at this
    rw [hCv] at this
    simp only [Causal.Flat.minkQ] at this
    exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).1 (by linarith)
  set R' : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin d) :=
    LinearIsometry.toLinearIsometryEquiv ⟨f, hnorm⟩ rfl
  have hR'v : ∀ x, R' x = f x := fun x => rfl
  have hEq : C' = rotLin ⟨R', by
      have h1 : (C' : Causal.Minkowski d →ₗ[ℝ] Causal.Minkowski d) =
          LinearMap.prodMap (LinearMap.id : ℝ →ₗ[ℝ] ℝ)
            ((R'.toLinearEquiv : EuclideanSpace ℝ (Fin d) ≃ₗ[ℝ] EuclideanSpace ℝ (Fin d)) :
              EuclideanSpace ℝ (Fin d) →ₗ[ℝ] EuclideanSpace ℝ (Fin d)) := by
        refine LinearMap.ext fun v => ?_
        rw [LinearMap.prodMap_apply]
        exact hCv v
      have := Causal.Flat.lorentz.det_eq_one C.2
      change LinearMap.det (C' : Causal.Minkowski d →ₗ[ℝ] Causal.Minkowski d) = 1 at this
      rw [h1, LinearMap.det_prodMap, LinearMap.det_id, one_mul] at this
      exact this⟩ := LinearEquiv.ext fun v => hCv v
  exact ⟨_, Subtype.ext hEq⟩

/-- **`SO₀(1,d)` is generated by the spatial rotations and the boosts along the first axis**
(`d ≥ 2`; the Cartan decomposition `A = B R`, `B ∈ boostRot`, `R` a rotation). This is the
algebraic half of BBS-Q6: lean-causal's `lorentz d` (`minkQ`-preserving, orthochronous,
determinant `1`) is generated by one-parameter subgroups. -/
theorem boostRot_eq_top (hd : 2 ≤ d) : boostRot hd = ⊤ := by
  refine eq_top_iff.2 fun A _ => ?_
  obtain ⟨B, hB, hBA⟩ := exists_smul_pole hd ((smul_mem_piece_iff A).2 (pole_mem_hypPlus (d := d)))
  set C := B⁻¹ * A with hC_def
  have hC : C • pole d = pole d := by rw [hC_def, mul_smul, ← hBA, inv_smul_smul]
  obtain ⟨c, hc, hCe⟩ := linRaySmul_eq_iff.1 hC
  change (C : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) (Causal.Flat.timeUnit d) =
    c • Causal.Flat.timeUnit d at hCe
  have hc1 : c = 1 := by
    have := Causal.Flat.lorentz.minkQ_apply C.2 (Causal.Flat.timeUnit d)
    change Causal.Flat.minkQ ((C : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d)
      (Causal.Flat.timeUnit d)) = _ at this
    rw [hCe, Causal.Flat.minkQ_smul, Causal.Flat.minkQ_timeUnit] at this
    nlinarith
  rw [hc1, one_smul] at hCe
  obtain ⟨R, hR⟩ := exists_rot_eq_of_fix hCe
  have hA : A = B * rot R := by rw [← hR, hC_def, mul_inv_cancel_left]
  rw [hA]
  exact mul_mem hB (rot_mem_boostRot hd R)

/-- **Transitivity on each piece**, by rotations and boosts only: two rays in the same piece
differ by an element of `boostRot`. -/
theorem exists_boostRot_smul_eq (hd : 2 ≤ d) {σ τ : HS d} (h : region σ = region τ) :
    ∃ A ∈ boostRot hd, A • σ = τ := by
  obtain ⟨A, hA, hAσ⟩ := exists_smul_base hd (mem_piece_region σ)
  obtain ⟨B, hB, hBτ⟩ := exists_smul_base hd (h ▸ mem_piece_region τ : τ ∈ piece d (region σ))
  refine ⟨B * A⁻¹, mul_mem hB (inv_mem hA), ?_⟩
  rw [mul_smul, ← hAσ, inv_smul_smul, hBτ]

/-- **The orbits of any subgroup between `boostRot` and `SO₀(1,d)` are the five pieces**
(`d ≥ 2`). -/
theorem orbit_eq_piece_of_le (hd : 2 ≤ d) {H : Subgroup (Causal.Flat.lorentz d)}
    (hH : boostRot hd ≤ H) (σ : HS d) : MulAction.orbit H σ = piece d (region σ) := by
  ext τ
  rw [MulAction.mem_orbit_iff, mem_piece_iff_region]
  constructor
  · rintro ⟨A, rfl⟩
    exact region_smul (A : Causal.Flat.lorentz d) σ
  · intro h
    obtain ⟨A, hA, hAσ⟩ := exists_boostRot_smul_eq hd h.symm
    exact ⟨⟨A, hH hA⟩, hAσ⟩

/-- **The orbits of `SO₀(1,d)` on `HSᵈ` are the five pieces** (`d ≥ 2`; BBS l.586–596 for
`d = 2`). -/
theorem orbit_eq_piece (hd : 2 ≤ d) (σ : HS d) :
    MulAction.orbit (Causal.Flat.lorentz d) σ = piece d (region σ) := by
  ext τ
  rw [MulAction.mem_orbit_iff, mem_piece_iff_region]
  constructor
  · rintro ⟨A, rfl⟩
    exact region_smul A σ
  · intro h
    obtain ⟨A, -, hAσ⟩ := exists_boostRot_smul_eq hd h.symm
    exact ⟨A, hAσ⟩

theorem piece_nonempty (hd : 1 ≤ d) (k : HSPiece) : (piece d k).Nonempty := by
  exact ⟨base hd k, base_mem hd k⟩

/-- **`HSᵈ` has exactly five `SO₀(1,d)`-orbits**, one per piece (`d ≥ 2`). -/
def orbitEquiv (hd : 2 ≤ d) :
    MulAction.orbitRel.Quotient (Causal.Flat.lorentz d) (HS d) ≃ HSPiece :=
  Equiv.ofBijective
    (Quotient.lift region fun σ τ (h : σ ∈ MulAction.orbit _ τ) => by
      obtain ⟨A, rfl⟩ := h; exact region_smul A τ)
    ⟨by
      rintro ⟨σ⟩ ⟨τ⟩ h
      obtain ⟨A, -, hA⟩ := exists_boostRot_smul_eq hd (h.symm : region τ = region σ)
      exact Quotient.sound ⟨A, hA⟩
    ,
     fun k => by
      obtain ⟨σ, hσ⟩ := piece_nonempty (d := d) (by omega) k
      exact ⟨⟦σ⟧, region_eq_of_mem hσ⟩⟩

theorem card_orbitRel_quotient (hd : 2 ≤ d) :
    Nat.card (MulAction.orbitRel.Quotient (Causal.Flat.lorentz d) (HS d)) = 5 := by
  rw [Nat.card_congr (orbitEquiv hd), Nat.card_eq_fintype_card]; rfl

/-! #### A finding: the fixed points of a hyperbolic element (`colI_v1.tex:605–606`) -/

theorem boost_apply (i : Fin d) (ζ : ℝ) (v : Causal.Minkowski d) :
    (boost i ζ : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d) v =
      (Real.cosh ζ * v.1 + Real.sinh ζ * v.2 i,
        v.2 + ((Real.cosh ζ - 1) * v.2 i + Real.sinh ζ * v.1) • EuclideanSpace.single i (1 : ℝ)) := by
  refine Prod.ext ?_ ?_
  · simp [boost, Causal.Flat.stdBoost, Causal.Flat.boost_apply, Causal.Flat.boostLin_apply,
      Causal.Flat.minkB, Causal.Flat.timeUnit, Causal.Flat.spaceUnit,
      EuclideanSpace.inner_single_right]
    ring
  · simp [boost, Causal.Flat.stdBoost, Causal.Flat.boost_apply, Causal.Flat.boostLin_apply,
      Causal.Flat.minkB, Causal.Flat.timeUnit, Causal.Flat.spaceUnit,
      EuclideanSpace.inner_single_right]
    try module

/-- The fixed rays of the boost `B_ζ`, `ζ ≠ 0`, of `HS²`: off the plane `x₁ = 0` only the
horizontal axis; in that plane only the null lines. -/
theorem boost_fixed_cases {ζ : ℝ} (hζ : ζ ≠ 0) {σ : HS 2} (h : boost (d := 2) 0 ζ • σ = σ) :
    ((σ : Causal.Minkowski 2).2 1 ≠ 0 →
        (σ : Causal.Minkowski 2).1 = 0 ∧ (σ : Causal.Minkowski 2).2 0 = 0) ∧
      ((σ : Causal.Minkowski 2).2 1 = 0 →
        (σ : Causal.Minkowski 2).1 + (σ : Causal.Minkowski 2).2 0 = 0 ∨
          (σ : Causal.Minkowski 2).1 - (σ : Causal.Minkowski 2).2 0 = 0) := by
  obtain ⟨c, hc, hB⟩ := linRaySmul_eq_iff.1 h
  rw [boost_apply] at hB
  set t := (σ : Causal.Minkowski 2).1
  set p := (σ : Causal.Minkowski 2).2 0
  set q := (σ : Causal.Minkowski 2).2 1
  have e1 : Real.cosh ζ * t + Real.sinh ζ * p = c * t := congrArg Prod.fst hB
  have e2 : Real.cosh ζ * p + Real.sinh ζ * t = c * p := by
    have := congrArg (fun v : Causal.Minkowski 2 => v.2 0) hB
    simp at this
    linear_combination this
  have e3 : q = c * q := by
    have := congrArg (fun v : Causal.Minkowski 2 => v.2 1) hB
    simpa using this
  have hsh : Real.sinh ζ ≠ 0 := fun h0 => hζ (Real.sinh_eq_zero.1 h0)
  have hcs := Real.cosh_sq ζ
  refine ⟨fun hq => ?_, fun _ => ?_⟩
  · have hc1 : c = 1 := by
      have : (c - 1) * q = 0 := by linear_combination -e3
      exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_right hq)
    subst hc1
    have hch : Real.cosh ζ ≠ 1 := fun h1 => hsh (by nlinarith)
    have ht : t = 0 := by
      have : (2 - 2 * Real.cosh ζ) * t = 0 := by
        linear_combination (Real.cosh ζ - 1) * e1 - Real.sinh ζ * e2 - t * hcs
      exact (mul_eq_zero.1 this).resolve_left fun h2 => hch (by linarith)
    refine ⟨ht, ?_⟩
    rw [ht] at e1
    exact (mul_eq_zero.1 (by linarith : Real.sinh ζ * p = 0)).resolve_left hsh
  · have hp : (Real.cosh ζ + Real.sinh ζ - c) * (t + p) = 0 := by linear_combination e1 + e2
    have hm : (Real.cosh ζ - Real.sinh ζ - c) * (t - p) = 0 := by linear_combination e1 - e2
    by_contra hne
    push Not at hne
    have h1 := (mul_eq_zero.1 hp).resolve_right hne.1
    have h2 := (mul_eq_zero.1 hm).resolve_right hne.2
    exact hsh (by linarith)

/-- The horizontal spacelike axis `(0, e₁)` of `HS²`. -/
def dsAxis : HS 2 :=
  ⟨((0 : ℝ), EuclideanSpace.single 1 (1 : ℝ)), mem_sphere_zero_iff_norm.2 (by
    simp [Prod.norm_def])⟩

/-- **The fixed points in `dS²` of a hyperbolic element** (the boost `B_ζ`, `ζ ≠ 0`, hyperbolic by
`Causal.Flat.stdBoost_isHyperbolic`) are **one** pair of opposite points `±(0, e₁)`. -/
theorem boost_fixed_deSitter_iff {ζ : ℝ} (hζ : ζ ≠ 0) (σ : HS 2) :
    (σ ∈ piece 2 .deSitter ∧ boost (d := 2) 0 ζ • σ = σ) ↔ σ = dsAxis ∨ σ = -dsAxis := by
  constructor
  · rintro ⟨hσ, h⟩
    obtain ⟨h1, h2⟩ := mem_deSitter_iff.1 hσ
    have hn := EuclideanSpace.real_norm_sq_eq (σ : Causal.Minkowski 2).2
    rw [h2, Fin.sum_univ_two] at hn
    obtain ⟨hA, hB⟩ := boost_fixed_cases hζ h
    by_cases hq : (σ : Causal.Minkowski 2).2 1 = 0
    · exfalso
      rw [hq] at hn
      have hp : |(σ : Causal.Minkowski 2).2 0| = 1 := by
        have h := (sq_eq_sq_iff_abs_eq_abs ((σ : Causal.Minkowski 2).2 0) 1).1 (by linarith)
        rwa [abs_one] at h
      rcases hB hq with h3 | h3
      · have : |(σ : Causal.Minkowski 2).1| = 1 := by
          rw [show (σ : Causal.Minkowski 2).1 = -(σ : Causal.Minkowski 2).2 0 by linarith,
            abs_neg, hp]
        linarith
      · have : |(σ : Causal.Minkowski 2).1| = 1 := by
          rw [show (σ : Causal.Minkowski 2).1 = (σ : Causal.Minkowski 2).2 0 by linarith, hp]
        linarith
    · obtain ⟨ht, hp⟩ := hA hq
      rw [hp] at hn
      have hq1 : (σ : Causal.Minkowski 2).2 1 = 1 ∨ (σ : Causal.Minkowski 2).2 1 = -1 := by
        have : ((σ : Causal.Minkowski 2).2 1 - 1) * ((σ : Causal.Minkowski 2).2 1 + 1) = 0 := by
          linear_combination -hn
        rcases mul_eq_zero.1 this with h | h
        · exact Or.inl (by linarith)
        · exact Or.inr (by linarith)
      rcases hq1 with hq1 | hq1
      · left
        refine Subtype.ext (Prod.ext ht ?_)
        ext j; fin_cases j
        · simpa [dsAxis] using hp
        · simpa [dsAxis] using hq1
      · right
        refine Subtype.ext (Prod.ext (by simp [dsAxis, coe_neg_sphere, ht]) ?_)
        ext j; fin_cases j
        · simpa [dsAxis, coe_neg_sphere] using hp
        · simpa [dsAxis, coe_neg_sphere] using hq1
  · have hfix : boost (d := 2) 0 ζ • dsAxis = dsAxis := by
      rw [hs_smul_def, linRaySmul_eq_iff]
      refine ⟨1, one_pos, ?_⟩
      rw [boost_apply, one_smul]
      refine Prod.ext ?_ ?_
      · simp [dsAxis]
      · simp [dsAxis]
    have hmem : dsAxis ∈ piece 2 .deSitter :=
      mem_deSitter_iff.2 ⟨by simp [dsAxis], by simp [dsAxis]⟩
    rintro (rfl | rfl)
    · exact ⟨hmem, hfix⟩
    · refine ⟨?_, by rw [hs_smul_neg, hfix]⟩
      exact mem_deSitter_iff.2 ⟨by simp [dsAxis, coe_neg_sphere],
        by simp [dsAxis, coe_neg_sphere]⟩

/-- **The fixed points in `∂ℍ²₊` of the boost `B_ζ`**, `ζ ≠ 0`: the two null directions
`(1, ±e₀)` (so `∂ℍ²±` carries **two** opposite pairs, `±(1, ±e₀)`). -/
theorem boost_fixed_bdPlus_iff {ζ : ℝ} (hζ : ζ ≠ 0) (σ : HS 2) :
    (σ ∈ piece 2 .bdPlus ∧ boost (d := 2) 0 ζ • σ = σ) ↔
      σ = nullPt (axisPt (d := 2) (by norm_num)) ∨ σ = nullPt (-axisPt (d := 2) (by norm_num)) := by
  have hpos : ∀ s : ℝ, 0 < Real.cosh s + Real.sinh s := fun s => by
    rw [Real.cosh_add_sinh]; exact Real.exp_pos s
  have hneg : ∀ s : ℝ, 0 < Real.cosh s - Real.sinh s := fun s => by
    rw [Real.cosh_sub_sinh]; exact Real.exp_pos _
  constructor
  · rintro ⟨hσ, h⟩
    obtain ⟨h1, h2⟩ := mem_bdPlus_iff.1 hσ
    have hn := EuclideanSpace.real_norm_sq_eq (σ : Causal.Minkowski 2).2
    rw [h2, Fin.sum_univ_two] at hn
    obtain ⟨hA, hB⟩ := boost_fixed_cases hζ h
    have hq : (σ : Causal.Minkowski 2).2 1 = 0 := by
      by_contra hq; have := (hA hq).1; rw [h1] at this; exact one_ne_zero this
    rcases hB hq with h3 | h3
    · right
      have hp : (σ : Causal.Minkowski 2).2 0 = -1 := by linarith
      refine Subtype.ext (Prod.ext h1 ?_)
      ext j; fin_cases j
      · simpa [nullPt, Causal.Flat.nullVec, axisPt, coe_neg_sphere] using hp
      · simpa [nullPt, Causal.Flat.nullVec, axisPt, coe_neg_sphere] using hq
    · left
      have hp : (σ : Causal.Minkowski 2).2 0 = 1 := by linarith
      refine Subtype.ext (Prod.ext h1 ?_)
      ext j; fin_cases j
      · simpa [nullPt, Causal.Flat.nullVec, axisPt] using hp
      · simpa [nullPt, Causal.Flat.nullVec, axisPt] using hq
  · rintro (rfl | rfl)
    · refine ⟨nullPt_mem_bdPlus _, ?_⟩
      rw [hs_smul_def, linRaySmul_eq_iff]
      refine ⟨Real.cosh ζ + Real.sinh ζ, hpos ζ, ?_⟩
      rw [boost_apply]
      refine Prod.ext ?_ ?_
      · simp [nullPt, Causal.Flat.nullVec, axisPt]
      · simp [nullPt, Causal.Flat.nullVec, axisPt]
        rw [← Real.cosh_add_sinh]; module
    · refine ⟨nullPt_mem_bdPlus _, ?_⟩
      rw [hs_smul_def, linRaySmul_eq_iff]
      refine ⟨Real.cosh ζ - Real.sinh ζ, hneg ζ, ?_⟩
      rw [boost_apply]
      refine Prod.ext ?_ ?_
      · simp [nullPt, Causal.Flat.nullVec, axisPt, coe_neg_sphere]
        rw [← Real.cosh_sub_sinh]; ring
      · simp [nullPt, Causal.Flat.nullVec, axisPt, coe_neg_sphere]
        rw [← Real.cosh_sub_sinh]; module

/-- **Refutation of the printed hyperbolic clause** (`colI_v1.tex:605–606`: "`g` is hyperbolic if
and only it admits exactly 6 fixed points: a pair of opposite points in `∂ℍ²±`, and 2 pairs of
opposite points in `dS²`"): the hyperbolic boost `B_ζ`, `ζ ≠ 0`, has exactly **two** fixed points
in `dS²` (one pair), not four. The corrected clause swaps the counts: two pairs in `∂ℍ²±`
(`boost_fixed_bdPlus_iff` and the antipodal map), one pair in `dS²`. -/
theorem boost_fixed_deSitter_ncard {ζ : ℝ} (hζ : ζ ≠ 0) :
    Causal.Flat.IsHyperbolic (boost (d := 2) 0 ζ : Causal.Minkowski 2 ≃ₗ[ℝ] Causal.Minkowski 2) ∧
      {σ : HS 2 | σ ∈ piece 2 .deSitter ∧ boost (d := 2) 0 ζ • σ = σ}.ncard = 2 := by
  refine ⟨Causal.Flat.stdBoost_isHyperbolic 0 hζ, ?_⟩
  have : {σ : HS 2 | σ ∈ piece 2 .deSitter ∧ boost (d := 2) 0 ζ • σ = σ} = {dsAxis, -dsAxis} := by
    ext σ; rw [mem_setOf_eq, boost_fixed_deSitter_iff hζ]; rfl
  rw [this, Set.ncard_pair]
  intro h
  have := congrArg (fun σ : HS 2 => ((σ : Causal.Minkowski 2).2 1)) h
  simp [dsAxis, coe_neg_sphere] at this
  linarith

end HS

/-! ### The unit-sphere model is the space of rays (BBS-Q3) -/

section Rays

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]

variable (V) in
/-- Positive proportionality of nonzero vectors: `v ∼ w` iff `w = c v` for some `c > 0`. -/
def raySetoid : Setoid {v : V // v ≠ 0} where
  r v w := ∃ c : ℝ, 0 < c ∧ (w : V) = c • (v : V)
  iseqv := ⟨fun _ => ⟨1, one_pos, (one_smul ℝ _).symm⟩,
    fun ⟨c, hc, h⟩ => ⟨c⁻¹, inv_pos.2 hc, by rw [h, smul_smul, inv_mul_cancel₀ hc.ne', one_smul]⟩,
    fun ⟨c, hc, h⟩ ⟨c', hc', h'⟩ => ⟨c' * c, mul_pos hc' hc, by rw [h', h, smul_smul]⟩⟩

variable (V) in
/-- **The space of rays** `(V ∖ 0)/ℝ₊*` of `V`, with the quotient topology: BBS's "set of
geodesic rays into `ℝ^{1,2}`" (`colI_v1.tex:585`) for `V = ℝ^{1,2}`. -/
abbrev RaySpace : Type _ := Quotient (raySetoid V)

/-- The unit vector of a nonzero vector. -/
def unitOf (v : {v : V // v ≠ 0}) : RaySphere V :=
  ⟨‖(v : V)‖⁻¹ • (v : V), mem_sphere_zero_iff_norm.2 (norm_inv_smul_self v.2)⟩

theorem unitOf_eq_of_rel {v w : {v : V // v ≠ 0}} (h : (raySetoid V).r v w) :
    unitOf v = unitOf w := by
  obtain ⟨c, hc, h⟩ := h
  refine Subtype.ext ?_
  show ‖(v : V)‖⁻¹ • (v : V) = ‖(w : V)‖⁻¹ • (w : V)
  rw [h, norm_smul, Real.norm_eq_abs, abs_of_pos hc, smul_smul]
  congr 1
  field_simp

theorem continuous_unitOf : Continuous (unitOf : {v : V // v ≠ 0} → RaySphere V) :=
  ((continuous_subtype_val.norm.inv₀ fun v => norm_ne_zero_iff.2 v.2).smul
    continuous_subtype_val).subtype_mk _

/-- **The unit-sphere model of `S(V)` is the space of rays**: `σ ↦ [σ]` is a homeomorphism
`RaySphere V ≃ₜ (V ∖ 0)/ℝ₊*`, with inverse `[v] ↦ v/‖v‖` (BBS-Q3; for any norm). -/
def raySphereHomeomorphRaySpace : RaySphere V ≃ₜ RaySpace V where
  toFun σ := ⟦⟨σ, raySphere_ne_zero σ⟩⟧
  invFun := Quotient.lift unitOf fun _ _ h => unitOf_eq_of_rel h
  left_inv σ := by
    refine Subtype.ext ?_
    show ‖(σ : V)‖⁻¹ • (σ : V) = σ
    rw [norm_raySphere, inv_one, one_smul]
  right_inv := by
    refine Quotient.ind fun v => Quotient.sound ?_
    refine ⟨‖(v : V)‖, norm_pos_iff.2 v.2, ?_⟩
    show (v : V) = ‖(v : V)‖ • ‖(v : V)‖⁻¹ • (v : V)
    rw [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.2 v.2), one_smul]
  continuous_toFun := continuous_quotient_mk'.comp (continuous_subtype_val.subtype_mk _)
  continuous_invFun := continuous_unitOf.quotient_lift _

/-- The natural action of a linear automorphism on rays, `A [v] = [A v]`. -/
def raySpaceMap (A : V ≃ₗ[ℝ] V) : RaySpace V → RaySpace V :=
  Quotient.map (fun v => ⟨A v, (LinearEquiv.map_ne_zero_iff A).2 v.2⟩)
    fun _ _ ⟨c, hc, h⟩ => ⟨c, hc, by simp only [h, map_smul]⟩

/-- **The normalised action is the action on rays**, transported by
`raySphereHomeomorphRaySpace`. -/
theorem raySphereHomeomorphRaySpace_linRaySmul (A : V ≃ₗ[ℝ] V) (σ : RaySphere V) :
    raySphereHomeomorphRaySpace (linRaySmul A σ) =
      raySpaceMap A (raySphereHomeomorphRaySpace σ) := by
  refine Quotient.sound ⟨‖A σ‖, norm_pos_iff.2 ((LinearEquiv.map_ne_zero_iff A).2
    (raySphere_ne_zero σ)), ?_⟩
  show A σ = ‖A σ‖ • ‖A σ‖⁻¹ • A σ
  rw [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.2 ((LinearEquiv.map_ne_zero_iff A).2
    (raySphere_ne_zero σ))), one_smul]

/-- **`HSᵈ` is the space of rays of `ℝ^{1,d}`**, `SO₀(1,d)`-equivariantly. -/
theorem hs_homeomorph_raySpace_smul {d : ℕ} (A : Causal.Flat.lorentz d) (σ : HS d) :
    raySphereHomeomorphRaySpace (A • σ) =
      raySpaceMap (A : Causal.Minkowski d ≃ₗ[ℝ] Causal.Minkowski d)
        (raySphereHomeomorphRaySpace σ) :=
  raySphereHomeomorphRaySpace_linRaySmul _ σ

end Rays

/-! ### `HS²` is a topological 2-sphere -/

section Sphere

variable {V W : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]
  [NormedAddCommGroup W] [NormedSpace ℝ W] [FiniteDimensional ℝ W]

/-- **The ray spheres of two linearly isomorphic spaces are homeomorphic**, by `σ ↦ L σ / ‖L σ‖`:
the choice of norm in BBS-Q3's unit-sphere model is immaterial. -/
def raySphereHomeomorph (L : V ≃ₗ[ℝ] W) : RaySphere V ≃ₜ RaySphere W where
  toFun σ := ⟨‖L σ‖⁻¹ • L σ, mem_sphere_zero_iff_norm.2
    (norm_inv_smul_self ((LinearEquiv.map_ne_zero_iff L).2 (raySphere_ne_zero σ)))⟩
  invFun τ := ⟨‖L.symm τ‖⁻¹ • L.symm τ, mem_sphere_zero_iff_norm.2
    (norm_inv_smul_self ((LinearEquiv.map_ne_zero_iff L.symm).2 (raySphere_ne_zero τ)))⟩
  left_inv σ := by
    apply Subtype.ext
    have hn : ‖L σ‖ ≠ 0 :=
      norm_ne_zero_iff.2 ((LinearEquiv.map_ne_zero_iff L).2 (raySphere_ne_zero σ))
    show ‖L.symm (‖L σ‖⁻¹ • L σ)‖⁻¹ • L.symm (‖L σ‖⁻¹ • L σ) = σ
    rw [map_smul, LinearEquiv.symm_apply_apply, norm_smul, norm_inv, norm_norm, norm_raySphere,
      mul_one, inv_inv, smul_smul, mul_inv_cancel₀ hn, one_smul]
  right_inv τ := by
    apply Subtype.ext
    have hn : ‖L.symm τ‖ ≠ 0 :=
      norm_ne_zero_iff.2 ((LinearEquiv.map_ne_zero_iff L.symm).2 (raySphere_ne_zero τ))
    show ‖L (‖L.symm τ‖⁻¹ • L.symm τ)‖⁻¹ • L (‖L.symm τ‖⁻¹ • L.symm τ) = τ
    rw [map_smul, LinearEquiv.apply_symm_apply, norm_smul, norm_inv, norm_norm, norm_raySphere,
      mul_one, inv_inv, smul_smul, mul_inv_cancel₀ hn, one_smul]
  continuous_toFun := by
    have hL : Continuous fun σ : RaySphere V => L σ :=
      (LinearMap.continuous_of_finiteDimensional (L : V →ₗ[ℝ] W)).comp continuous_subtype_val
    exact ((hL.norm.inv₀ fun σ => norm_ne_zero_iff.2
      ((LinearEquiv.map_ne_zero_iff L).2 (raySphere_ne_zero σ))).smul hL).subtype_mk _
  continuous_invFun := by
    have hL : Continuous fun τ : RaySphere W => L.symm τ :=
      (LinearMap.continuous_of_finiteDimensional (L.symm : W →ₗ[ℝ] V)).comp continuous_subtype_val
    exact ((hL.norm.inv₀ fun τ => norm_ne_zero_iff.2
      ((LinearEquiv.map_ne_zero_iff L.symm).2 (raySphere_ne_zero τ))).smul hL).subtype_mk _

end Sphere

/-- Minkowski coordinates `(t, x)` on gx's Euclidean `ℝ³ = ℝ ⊕ ℂ` (`GX.Euc3`), `x ↦ x₀ + i x₁`. -/
def minkToEuc3 : Causal.Minkowski 2 ≃ₗ[ℝ] Euc3 :=
  ((LinearEquiv.refl ℝ ℝ).prodCongr Complex.orthonormalBasisOneI.repr.symm.toLinearEquiv).trans
    (WithLp.linearEquiv 2 ℝ (ℝ × ℂ)).symm

/-- **`HS²` is homeomorphic to the round sphere `𝕊² = GX.Sph2`.** -/
def hs2HomeomorphSph2 : HS 2 ≃ₜ Sph2 := raySphereHomeomorph minkToEuc3

/-- **`HS²` is a topological surface**: charts into `ℝ²` transported from the stereographic
charts of `𝕊²` (mathlib's `EuclideanSpace.instChartedSpaceSphere`). -/
instance hs2ChartedSpace : ChartedSpace (EuclideanSpace ℝ (Fin 2)) (HS 2) :=
  letI : ChartedSpace Sph2 (HS 2) :=
    (hs2HomeomorphSph2.toOpenPartialHomeomorph).singletonChartedSpace (by simp)
  ChartedSpace.comp (EuclideanSpace ℝ (Fin 2)) Sph2 (HS 2)

/-- `HS²` is locally unloopable (`def:topological_space_locally_unloopable`, `RamcovGX.tex:1650`),
the standing assumption on the model of gx's §2.5. -/
theorem isLocallyUnloopable_hs2 : IsLocallyUnloopable (HS 2) := by
  haveI : LocPathConnectedSpace (HS 2) :=
    ChartedSpace.locPathConnectedSpace (EuclideanSpace ℝ (Fin 2)) _
  refine ⟨inferInstance, fun x U hU => ?_⟩
  refine ⟨interior U, interior_subset, isOpen_interior, mem_interior_iff_mem_nhds.2 hU, ?_⟩
  refine (isLocallyUnloopable_of_normedSpace
    (EuclideanSpace ℝ (Fin 2))).semilocallySimplyConnected_of_charts
    fun y hy => ⟨(chartAt (EuclideanSpace ℝ (Fin 2)) y).restrOpen _ isOpen_interior,
      ⟨mem_chart_source _ y, hy⟩, fun z hz => hz.2⟩

instance locPathConnectedSpace_hs2 : LocPathConnectedSpace (HS 2) :=
  ChartedSpace.locPathConnectedSpace (EuclideanSpace ℝ (Fin 2)) _

theorem semilocallySimplyConnected_hs2 : SemilocallySimplyConnected (HS 2) :=
  isLocallyUnloopable_hs2.semilocallySimplyConnected

/-! ### HS-surfaces (`colI_v1.tex:615`) -/

/-- **A topological surface** (reading, SCOPE): a Hausdorff space locally homeomorphic to `ℝ²`.
No countability and no connectedness are asked. -/
structure IsTopologicalSurface (M : Type*) [TopologicalSpace M] : Prop where
  t2Space : T2Space M
  exists_chart : ∀ x : M, ∃ e : OpenPartialHomeomorph M (EuclideanSpace ℝ (Fin 2)), x ∈ e.source

theorem isTopologicalSurface_hs2 : IsTopologicalSurface (HS 2) := by
  exact ⟨inferInstance, fun x => ⟨chartAt _ x, mem_chart_source _ x⟩⟩

/-- **An HS-surface** (BBS, `bbsdef:hs_surface_topological_surface_endowed`, `colI_v1.tex:615`):
"a topological surface endowed with a `(SO₀(1,2), HS²)`-structure". The structure is gx's
(DEC-16): a charted space over `HS²` whose chart changes lie in the groupoid of
`SO₀(1,2) = Causal.Flat.lorentz 2` acting on `HS² = GX.HS 2`, read over its maximal atlas. -/
class IsHSSurface (M : Type*) [TopologicalSpace M] [ChartedSpace (HS 2) M] : Prop
    extends IsTopologicalSurface M, HasGroupoid M (gxGroupoid (Causal.Flat.lorentz 2) (HS 2))

/-- **The topological half of an HS-surface is only Hausdorffness**: an `(SO₀(1,2), HS²)`-structure
already makes the space locally homeomorphic to `ℝ²`. -/
theorem isHSSurface_iff {M : Type*} [TopologicalSpace M] [ChartedSpace (HS 2) M] :
    IsHSSurface M ↔ T2Space M ∧ HasGroupoid M (gxGroupoid (Causal.Flat.lorentz 2) (HS 2)) := by
  constructor
  · intro h
    exact ⟨h.t2Space, h.toHasGroupoid⟩
  · rintro ⟨h1, h2⟩
    refine { toIsTopologicalSurface := ⟨h1, fun x => ⟨(chartAt (HS 2) x).trans
      (chartAt (EuclideanSpace ℝ (Fin 2)) (chartAt (HS 2) x x)), ?_⟩⟩, toHasGroupoid := h2 }
    rw [OpenPartialHomeomorph.trans_source]
    exact ⟨mem_chart_source _ x, mem_chart_source (EuclideanSpace ℝ (Fin 2)) (chartAt (HS 2) x x)⟩

/-- **`HS²` itself is an HS-surface** (its identity chart). -/
instance isHSSurface_hs2 : IsHSSurface (HS 2) := by
  exact isHSSurface_iff.2 ⟨inferInstance, hasGroupoid_model_space _ _⟩

/-- **An open subset of an HS-surface is an HS-surface** (e.g. `ℍ²±`, `dS²` in `HS²`). -/
instance IsHSSurface.opens {M : Type*} [TopologicalSpace M] [ChartedSpace (HS 2) M]
    [IsHSSurface M] (U : TopologicalSpace.Opens M) : IsHSSurface U := by
  haveI : T2Space M := (isHSSurface_iff.1 ‹_›).1
  exact isHSSurface_iff.2 ⟨inferInstance, hasGroupoid_opens U⟩

end GX
