open Set Filter Topology Real ComplexConjugate
open scoped MatrixGroups

namespace GX

set_option linter.unusedSectionVars false

/-! ### `ℝP¹` and the action of `SL(2,ℝ)` and `PSL(2,ℝ)` -/

/-- **`ℝP¹`**, represented by the unit circle: the line `ℝ z` (`z ∈ ℂ ∖ 0 = ℝ² ∖ 0`) is the point
`z / z̄` (`GX.RP1.mk`, `GX.RP1.mk_eq_mk_iff`). -/
abbrev RP1 : Type := Circle

namespace RP1

open Complex in
/-- The point of `ℝP¹` of the line `ℝ z`: `z / z̄` (and `1` at `z = 0`, a junk value). -/
def mk (z : ℂ) : RP1 :=
  if hz : z = 0 then 1 else Circle.ofConjDivSelf (conj z) ((map_ne_zero _).2 hz)

theorem coe_mk {z : ℂ} (hz : z ≠ 0) : (mk z : ℂ) = z / conj z := by
  rw [mk, dif_neg hz, Circle.ofConjDivSelf_coe, Complex.conj_conj]

/-- On the unit circle, `mk` is the squaring map. -/
theorem mk_circle (z : Circle) : mk (z : ℂ) = z ^ 2 := by
  apply Circle.ext
  rw [coe_mk z.coe_ne_zero, ← Circle.coe_inv_eq_conj, Circle.coe_inv, div_inv_eq_mul,
    Circle.coe_pow, pow_two]

/-- `mk` is constant on lines: `mk (c z) = mk z` for real `c ≠ 0`. -/
theorem mk_ofReal_mul {c : ℝ} (hc : c ≠ 0) (z : ℂ) : mk ((c : ℂ) * z) = mk z := by
  by_cases hz : z = 0
  · rw [hz, mul_zero]
  have hcz : (c : ℂ) * z ≠ 0 := mul_ne_zero (Complex.ofReal_ne_zero.2 hc) hz
  apply Circle.ext
  rw [coe_mk hcz, coe_mk hz, map_mul, Complex.conj_ofReal]
  have : (c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.2 hc
  have : conj z ≠ 0 := (map_ne_zero _).2 hz
  field_simp

theorem mk_smul {c : ℝ} (hc : c ≠ 0) (z : ℂ) : mk (c • z) = mk z := by
  rw [Complex.real_smul, mk_ofReal_mul hc]

/-- **Two nonzero vectors give the same point of `ℝP¹` iff they span the same line.** -/
theorem mk_eq_mk_iff {z w : ℂ} (hz : z ≠ 0) (hw : w ≠ 0) :
    mk z = mk w ↔ ∃ c : ℝ, w = (c : ℂ) * z := by
  constructor
  · intro h
    have h' := congrArg (fun u : Circle => (u : ℂ)) h
    simp only [coe_mk hz, coe_mk hw] at h'
    have hz' : conj z ≠ 0 := (map_ne_zero _).2 hz
    have hw' : conj w ≠ 0 := (map_ne_zero _).2 hw
    -- `w z̄` is real
    have hreal : conj (w * conj z) = w * conj z := by
      rw [map_mul, Complex.conj_conj]
      field_simp at h'
      linear_combination h'
    obtain ⟨r, hr⟩ := Complex.conj_eq_iff_real.1 hreal
    have hn : (Complex.normSq z : ℂ) ≠ 0 := by exact_mod_cast (Complex.normSq_pos.2 hz).ne'
    refine ⟨r / Complex.normSq z, ?_⟩
    rw [Complex.ofReal_div, ← hr, Complex.normSq_eq_conj_mul_self]
    field_simp
  · rintro ⟨c, rfl⟩
    have hc : c ≠ 0 := by rintro rfl; simp at hw
    rw [mk_ofReal_mul hc]

/-- A representative of a point of `ℝP¹`: `exp(i arg(w)/2)`. -/
def rep (w : RP1) : ℂ := (Circle.exp (Complex.arg (w : ℂ) / 2) : ℂ)

theorem rep_ne_zero (w : RP1) : rep w ≠ 0 := Circle.coe_ne_zero _

theorem mk_rep (w : RP1) : mk (rep w) = w := by
  rw [rep, mk_circle, ← Circle.exp_nsmul, nsmul_eq_mul, Nat.cast_ofNat,
    mul_div_cancel₀ _ two_ne_zero, Circle.exp_arg]

theorem mk_surjective : Function.Surjective mk := fun w => ⟨rep w, mk_rep w⟩

/-- Every nonzero vector is a real multiple of the representative of its line. -/
theorem exists_rep_mk {z : ℂ} (hz : z ≠ 0) : ∃ c : ℝ, c ≠ 0 ∧ rep (mk z) = (c : ℂ) * z := by
  obtain ⟨c, hc⟩ := (mk_eq_mk_iff hz (rep_ne_zero (mk z))).1 (mk_rep (mk z)).symm
  refine ⟨c, ?_, hc⟩
  rintro rfl
  simp at hc
  exact rep_ne_zero _ hc

theorem isInducing_coe :
    @Topology.IsInducing Circle ℂ instTopologicalSpaceCircle _ fun z => (z : ℂ) :=
  Topology.IsInducing.subtypeVal

theorem continuous_coe : Continuous fun z : Circle => (z : ℂ) := isInducing_coe.continuous

theorem continuousAt_mk {z : ℂ} (hz : z ≠ 0) : ContinuousAt mk z := by
  rw [isInducing_coe.continuousAt_iff]
  have : (fun u : ℂ => ((mk u : Circle) : ℂ)) =ᶠ[𝓝 z] fun u => u / conj u := by
    filter_upwards [isOpen_ne.mem_nhds hz] with u hu
    exact coe_mk hu
  refine ContinuousAt.congr ?_ this.symm
  exact continuousAt_id.div (Complex.continuous_conj.continuousAt) ((map_ne_zero _).2 hz)

theorem continuous_mk_circle : Continuous fun z : Circle => mk (z : ℂ) := by
  simp_rw [mk_circle]; fun_prop

/-- The squaring map of the circle is a quotient map onto `ℝP¹`. -/
theorem isQuotientMap_sq : Topology.IsQuotientMap fun z : Circle => z ^ 2 := by
  have hc : Continuous fun z : Circle => z ^ 2 := by fun_prop
  refine IsClosedMap.isQuotientMap hc.isClosedMap hc fun w => ⟨Circle.exp (Complex.arg w / 2), ?_⟩
  rw [← Circle.exp_nsmul, nsmul_eq_mul, Nat.cast_ofNat, mul_div_cancel₀ _ two_ne_zero,
    Circle.exp_arg]

end RP1

/-! #### `SL(2,ℝ)` acting on `ℂ = ℝ²` and on `ℝP¹` -/

/-- `g ∈ SL(2,ℝ)` acting `ℝ`-linearly on `ℂ = ℝ²` (in the basis `1, i`). -/
def slLin (g : SL(2, ℝ)) : ℂ →ₗ[ℝ] ℂ :=
  Matrix.toLin Complex.basisOneI Complex.basisOneI (g : Matrix (Fin 2) (Fin 2) ℝ)

theorem slLin_apply (g : SL(2, ℝ)) (z : ℂ) :
    slLin g z = ⟨(g : Matrix (Fin 2) (Fin 2) ℝ) 0 0 * z.re + (g : Matrix (Fin 2) (Fin 2) ℝ) 0 1 * z.im,
      (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0 * z.re + (g : Matrix (Fin 2) (Fin 2) ℝ) 1 1 * z.im⟩ := by
  rw [slLin, Matrix.toLin_apply]
  simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_two, Complex.coe_basisOneI_repr,
    Complex.coe_basisOneI, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one]
  apply Complex.ext <;> simp

theorem slLin_mul (g h : SL(2, ℝ)) : slLin (g * h) = (slLin g).comp (slLin h) := by
  rw [slLin, slLin, slLin, Matrix.SpecialLinearGroup.coe_mul,
    Matrix.toLin_mul Complex.basisOneI Complex.basisOneI Complex.basisOneI]

theorem slLin_one : slLin 1 = LinearMap.id := by
  rw [slLin, Matrix.SpecialLinearGroup.coe_one, Matrix.toLin_one]

theorem slLin_inv_apply (g : SL(2, ℝ)) (z : ℂ) : slLin g⁻¹ (slLin g z) = z := by
  rw [← LinearMap.comp_apply, ← slLin_mul, inv_mul_cancel, slLin_one, LinearMap.id_apply]

theorem slLin_apply_inv (g : SL(2, ℝ)) (z : ℂ) : slLin g (slLin g⁻¹ z) = z := by
  simpa using slLin_inv_apply g⁻¹ z

theorem slLin_ne_zero (g : SL(2, ℝ)) {z : ℂ} (hz : z ≠ 0) : slLin g z ≠ 0 := by
  intro h
  apply hz
  rw [← slLin_inv_apply g z, h, map_zero]

theorem continuous_slLin (g : SL(2, ℝ)) : Continuous (slLin g) :=
  LinearMap.continuous_of_finiteDimensional _

namespace RP1

/-- The action of `SL(2,ℝ)` on `ℝP¹`, before it is an instance. -/
def slSmul (g : SL(2, ℝ)) (w : RP1) : RP1 := mk (slLin g (rep w))

theorem slSmul_mk (g : SL(2, ℝ)) {z : ℂ} (hz : z ≠ 0) : slSmul g (mk z) = mk (slLin g z) := by
  obtain ⟨c, hc, h⟩ := exists_rep_mk hz
  rw [slSmul, h, ← Complex.real_smul, map_smul, mk_smul hc]

end RP1

instance : MulAction SL(2, ℝ) RP1 where
  smul := RP1.slSmul
  one_smul w := by
    show RP1.mk (slLin 1 (RP1.rep w)) = w
    rw [slLin_one, LinearMap.id_apply, RP1.mk_rep]
  mul_smul g h w := by
    show RP1.mk (slLin (g * h) (RP1.rep w)) = RP1.slSmul g (RP1.mk (slLin h (RP1.rep w)))
    rw [RP1.slSmul_mk g (slLin_ne_zero h (RP1.rep_ne_zero w)), slLin_mul, LinearMap.comp_apply]

namespace RP1

theorem sl_smul_mk (g : SL(2, ℝ)) {z : ℂ} (hz : z ≠ 0) : g • mk z = mk (slLin g z) :=
  slSmul_mk g hz

theorem continuous_sl_smul (g : SL(2, ℝ)) : Continuous fun w : RP1 => g • w := by
  rw [isQuotientMap_sq.continuous_iff]
  have : ((fun w : RP1 => g • w) ∘ fun z : Circle => z ^ 2) =
      fun z : Circle => mk (slLin g (z : ℂ)) := by
    funext z
    rw [Function.comp_apply, ← mk_circle, sl_smul_mk g z.coe_ne_zero]
  rw [this, continuous_iff_continuousAt]
  intro z
  exact ContinuousAt.comp (f := fun z : Circle => slLin g (z : ℂ))
    (continuousAt_mk (slLin_ne_zero g z.coe_ne_zero))
    ((continuous_slLin g).comp continuous_coe).continuousAt

/-- `±1` acts trivially. -/
theorem center_smul {g : SL(2, ℝ)} (hg : g ∈ Subgroup.center SL(2, ℝ)) (w : RP1) : g • w = w := by
  obtain ⟨r, hr, hgr⟩ := Matrix.SpecialLinearGroup.mem_center_iff.1 hg
  have hr0 : r ≠ 0 := by rintro rfl; simp at hr
  have e : ∀ i j, (g : Matrix (Fin 2) (Fin 2) ℝ) i j = if i = j then r else 0 := by
    intro i j
    rw [← hgr, Matrix.scalar_apply, Matrix.diagonal_apply]
  have hlin : ∀ z, slLin g z = (r : ℂ) * z := by
    intro z
    rw [slLin_apply, e, e, e, e]
    apply Complex.ext <;> simp
  rw [← mk_rep w, sl_smul_mk g (rep_ne_zero w), hlin, mk_ofReal_mul hr0]

/-- An element of `SL(2,ℝ)` fixing every point of a nonempty open subset of `ℝP¹` is `±1`. -/
theorem mem_center_of_eqOn {k : SL(2, ℝ)} {U : Set RP1} (hU : IsOpen U) (hne : U.Nonempty)
    (h : ∀ w ∈ U, k • w = w) : k ∈ Subgroup.center SL(2, ℝ) := by
  obtain ⟨w₀, hw₀⟩ := hne
  have hv₀ := rep_ne_zero w₀
  have hev : ∀ᶠ v in 𝓝 (rep w₀), ∃ c : ℝ, slLin k v = c • v := by
    filter_upwards [(continuousAt_mk hv₀).preimage_mem_nhds (hU.mem_nhds (by rwa [mk_rep])),
      isOpen_ne.mem_nhds hv₀] with v hvU hv
    have h1 := h _ hvU
    rw [sl_smul_mk k hv, mk_eq_mk_iff (slLin_ne_zero k hv) hv] at h1
    obtain ⟨c, hc⟩ := h1
    have hc0 : c ≠ 0 := by
      rintro rfl
      simp only [Complex.ofReal_zero, zero_mul] at hc
      exact hv hc
    refine ⟨c⁻¹, ?_⟩
    rw [Complex.real_smul]
    conv_rhs => rw [hc]
    rw [← mul_assoc, ← Complex.ofReal_mul, inv_mul_cancel₀ hc0, Complex.ofReal_one, one_mul]
  obtain ⟨c₀, hc₀⟩ := hev.self_of_nhds
  have hall := eq_smul_of_eventually_eigen (T := slLin k) hv₀ hc₀ hev
  have h1 := hall 1
  have hI := hall Complex.I
  rw [slLin_apply] at h1 hI
  have e00 := congrArg Complex.re h1
  have e10 := congrArg Complex.im h1
  have e01 := congrArg Complex.re hI
  have e11 := congrArg Complex.im hI
  simp only [Complex.one_re, Complex.one_im, Complex.I_re, Complex.I_im, Complex.real_smul,
    Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, mul_one, mul_zero,
    add_zero, zero_add, sub_zero] at e00 e10 e01 e11
  have hdet := k.2
  rw [Matrix.det_fin_two] at hdet
  rw [Matrix.SpecialLinearGroup.mem_center_iff]
  refine ⟨c₀, ?_, ?_⟩
  · simp only [Fintype.card_fin]
    rw [e00, e11, e01, e10] at hdet
    linarith
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.scalar_apply, e00, e11, e01, e10]

/-! #### The universal covering `ℝP̃¹ = ℝ → ℝP¹` -/

/-- **The universal covering `ℝP̃¹ = ℝ → ℝP¹`**, `t ↦ [cos πt : sin πt]` (`GX.RP1.proj_eq_mk`),
of deck group `t ↦ t + n`; with BBS's fixed homeomorphism `ℝP̃¹ ≅ ℝ` (l.676–677) being the
identity, the order `<` of `ℝP̃¹` is that of `ℝ`. -/
def proj (t : ℝ) : RP1 := Circle.exp (2 * π * t)

theorem proj_eq_mk (t : ℝ) : proj t = mk (Circle.exp (π * t) : ℂ) := by
  rw [mk_circle, proj, ← Circle.exp_nsmul, nsmul_eq_mul, Nat.cast_ofNat, mul_assoc]

theorem continuous_proj : Continuous proj :=
  Circle.exp.continuous.comp (continuous_const.mul continuous_id)

theorem isCoveringMap_proj : IsCoveringMap proj := by
  have := Circle.isCoveringMap_exp.comp_homeomorph
    (Homeomorph.mulLeft₀ (2 * π) (by positivity : (2 * π : ℝ) ≠ 0))
  exact this

theorem isLocalHomeomorph_proj : IsLocalHomeomorph proj := isCoveringMap_proj.isLocalHomeomorph

theorem isOpenMap_proj : IsOpenMap proj := isLocalHomeomorph_proj.isOpenMap

theorem proj_eq_proj_iff {s t : ℝ} : proj s = proj t ↔ ∃ n : ℤ, s = t + n := by
  rw [proj, proj, Circle.exp_eq_exp]
  constructor
  · rintro ⟨m, hm⟩
    refine ⟨m, ?_⟩
    have : (2 * π) * s = (2 * π) * (t + m) := by linarith
    exact mul_left_cancel₀ (by positivity) this
  · rintro ⟨n, rfl⟩
    exact ⟨n, by ring⟩

theorem proj_add_int (t : ℝ) (n : ℤ) : proj (t + n) = proj t := proj_eq_proj_iff.2 ⟨n, rfl⟩

theorem proj_add_one (t : ℝ) : proj (t + 1) = proj t := by
  simpa using proj_add_int t 1

theorem proj_surjective : Function.Surjective proj := fun w => by
  obtain ⟨t, ht⟩ := Circle.exp_surjective w
  exact ⟨t / (2 * π), by rw [proj, mul_div_cancel₀ _ (by positivity), ht]⟩

/-- **The quotient of `ℝP̃¹` by its deck group `ℤ` is `ℝP¹`** (l.685–686). -/
def addCircleHomeomorph : AddCircle (1 : ℝ) ≃ₜ RP1 := AddCircle.homeomorphCircle one_ne_zero

theorem addCircleHomeomorph_coe (t : ℝ) : addCircleHomeomorph (t : AddCircle (1 : ℝ)) = proj t := by
  rw [addCircleHomeomorph, AddCircle.homeomorphCircle_apply, AddCircle.toCircle_apply_mk, proj,
    div_one]

/-- Continuous maps from `ℝ` to `ℝP¹` lift to `ℝP̃¹`. -/
theorem exists_lift (F : C(ℝ, RP1)) : ∃ f : C(ℝ, ℝ), ∀ t, proj (f t) = F t := by
  obtain ⟨e₀, he₀⟩ := proj_surjective (F 0)
  obtain ⟨f, ⟨-, hf⟩, -⟩ := isCoveringMap_proj.existsUnique_continuousMap_lifts F 0 e₀ he₀
  exact ⟨f, fun t => congrFun hf t⟩

end RP1

/-! #### `PSL(2,ℝ)` acting on `ℝP¹` -/

/-- The action of `SL(2,ℝ)` on `ℝP¹`, as a homomorphism. -/
def slEnd : SL(2, ℝ) →* Function.End RP1 := MulAction.toEndHom

theorem center_le_ker_slEnd : Subgroup.center SL(2, ℝ) ≤ slEnd.ker := fun _ hg =>
  MonoidHom.mem_ker.2 (funext fun w => RP1.center_smul hg w)

/-- The action of `PSL(2,ℝ)`, through the quotient. -/
def pslEnd : PSL(2, ℝ) →* Function.End RP1 := QuotientGroup.lift _ slEnd center_le_ker_slEnd

/-- **`G = PSL(2,ℝ)`, the group of projective transformations of `ℝP¹`** (l.679), acting on
`ℝP¹`. -/
instance : MulAction PSL(2, ℝ) RP1 := MulAction.compHom RP1 pslEnd

/-- The class of `g ∈ SL(2,ℝ)` in `PSL(2,ℝ)`. -/
abbrev pslMk (g : SL(2, ℝ)) : PSL(2, ℝ) := QuotientGroup.mk g

theorem pslMk_smul (g : SL(2, ℝ)) (w : RP1) : pslMk g • w = g • w := rfl

theorem pslMk_surjective : Function.Surjective pslMk := QuotientGroup.mk_surjective

theorem pslMk_eq_pslMk_iff {g h : SL(2, ℝ)} :
    pslMk g = pslMk h ↔ g⁻¹ * h ∈ Subgroup.center SL(2, ℝ) := QuotientGroup.eq

instance : ContinuousConstSMul PSL(2, ℝ) RP1 := ⟨fun g => by
  obtain ⟨g, rfl⟩ := pslMk_surjective g
  exact RP1.continuous_sl_smul g⟩

/-- **Rigidity of `PSL(2,ℝ)` on `ℝP¹`**: two elements agreeing on a nonempty open set are equal. -/
theorem psl_eq_of_eqOn {g h : PSL(2, ℝ)} {U : Set RP1} (hU : IsOpen U) (hne : U.Nonempty)
    (heq : EqOn (fun w : RP1 => g • w) (fun w => h • w) U) : g = h := by
  obtain ⟨g, rfl⟩ := pslMk_surjective g
  obtain ⟨h, rfl⟩ := pslMk_surjective h
  rw [pslMk_eq_pslMk_iff]
  refine RP1.mem_center_of_eqOn hU hne fun w hw => ?_
  have h1 : g • w = h • w := heq hw
  rw [mul_smul, ← h1, inv_smul_smul]

/-- **`(PSL(2,ℝ), ℝP¹)` is analytic** in gx's sense: faithful and rigid. -/
instance isAnalyticAction_rp1 : IsAnalyticAction PSL(2, ℝ) RP1 :=
  IsAnalyticAction.of_eq_of_eqOn psl_eq_of_eqOn

theorem psl_eq_of_forall_proj {g h : PSL(2, ℝ)} (heq : ∀ t, g • RP1.proj t = h • RP1.proj t) :
    g = h :=
  psl_eq_of_eqOn isOpen_univ univ_nonempty fun w _ => by
    obtain ⟨t, rfl⟩ := RP1.proj_surjective w
    exact heq t

/-! ### `G̃`: the lifts of `PSL(2,ℝ)` to `ℝP̃¹` -/

section Lifts

open RP1

/-- `f : ℝ → ℝ` **lifts** `g ∈ SL(2,ℝ)` to `ℝP̃¹`: it is continuous and `proj ∘ f = g • proj`. -/
structure IsSLLift (g : SL(2, ℝ)) (f : ℝ → ℝ) : Prop where
  continuous : Continuous f
  proj_apply : ∀ t, proj (f t) = g • proj t

theorem exists_isSLLift (g : SL(2, ℝ)) : ∃ f, IsSLLift g f := by
  obtain ⟨f, hf⟩ := RP1.exists_lift ⟨fun t => g • proj t,
    (continuous_sl_smul g).comp continuous_proj⟩
  exact ⟨f, f.continuous, hf⟩

theorem isSLLift_one : IsSLLift 1 id := ⟨continuous_id, fun _ => (one_smul _ _).symm⟩

theorem IsSLLift.comp {g h : SL(2, ℝ)} {f k : ℝ → ℝ} (hf : IsSLLift g f) (hk : IsSLLift h k) :
    IsSLLift (g * h) (f ∘ k) :=
  ⟨hf.continuous.comp hk.continuous, fun t => by
    rw [Function.comp_apply, hf.proj_apply, hk.proj_apply, mul_smul]⟩

theorem IsSLLift.add_int {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) (n : ℤ) :
    IsSLLift g fun t => f t + n :=
  ⟨hf.continuous.add continuous_const, fun t => by rw [proj_add_int, hf.proj_apply]⟩

theorem IsSLLift.comp_add_one {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) :
    IsSLLift g fun t => f (t + 1) :=
  ⟨hf.continuous.comp (continuous_id.add continuous_const), fun _ => by
    rw [hf.proj_apply, proj_add_one]⟩

/-- **Two lifts of the same element differ by a deck translation.** -/
theorem IsSLLift.eq_add_int {g : SL(2, ℝ)} {f f' : ℝ → ℝ} (hf : IsSLLift g f)
    (hf' : IsSLLift g f') : ∃ n : ℤ, ∀ t, f' t = f t + n := by
  obtain ⟨n, hn⟩ := proj_eq_proj_iff.1 ((hf'.proj_apply 0).trans (hf.proj_apply 0).symm)
  refine ⟨n, fun t => congrFun (isCoveringMap_proj.eq_of_comp_eq hf'.continuous
    (hf.add_int n).continuous ?_ 0 hn) t⟩
  funext t
  simp only [Function.comp_apply]
  rw [hf'.proj_apply, (hf.add_int n).proj_apply]

theorem IsSLLift.exists_deg {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) :
    ∃ k : ℤ, ∀ t, f (t + 1) = f t + k :=
  hf.eq_add_int hf.comp_add_one

theorem IsSLLift.map_add_int_mul {g : SL(2, ℝ)} {f : ℝ → ℝ} (_hf : IsSLLift g f) {k : ℤ}
    (hk : ∀ t, f (t + 1) = f t + k) (n : ℤ) (t : ℝ) : f (t + n) = f t + n * k := by
  induction n using Int.induction_on generalizing t with
  | zero => simp
  | succ m ih =>
    have h1 := hk (t + m)
    have h2 := ih t
    push_cast at h1 h2 ⊢
    rw [← add_assoc, h1, h2]; ring
  | pred m ih =>
    have h1 := hk (t + (-(m : ℝ) - 1))
    have h2 := ih t
    push_cast at h1 h2 ⊢
    rw [show t + (-(m : ℝ) - 1) + 1 = t + -(m : ℝ) by ring, h2] at h1
    linarith

/-- The **degree** of the action of `g` on `ℝP¹`: `f (t + 1) = f t + slDeg g` for every lift. -/
def slDeg (g : SL(2, ℝ)) : ℤ := (exists_isSLLift g).choose_spec.exists_deg.choose

theorem IsSLLift.add_one_eq_deg {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) (t : ℝ) :
    f (t + 1) = f t + slDeg g := by
  have h0 := (exists_isSLLift g).choose_spec
  obtain ⟨n, hn⟩ := h0.eq_add_int hf
  rw [hn, hn, slDeg, h0.exists_deg.choose_spec]
  ring

theorem slDeg_mul (g h : SL(2, ℝ)) : slDeg (g * h) = slDeg h * slDeg g := by
  obtain ⟨f, hf⟩ := exists_isSLLift g
  obtain ⟨k, hk⟩ := exists_isSLLift h
  have h1 := (hf.comp hk).add_one_eq_deg 0
  simp only [Function.comp_apply] at h1
  rw [hk.add_one_eq_deg, hf.map_add_int_mul hf.add_one_eq_deg] at h1
  have h2 := add_left_cancel h1
  exact_mod_cast h2.symm

theorem slDeg_one : slDeg 1 = 1 := by
  have := isSLLift_one.add_one_eq_deg 0
  simp only [id_eq, zero_add] at this
  exact_mod_cast this.symm

theorem slDeg_eq_one_or (g : SL(2, ℝ)) : slDeg g = 1 ∨ slDeg g = -1 := by
  have h := slDeg_mul g⁻¹ g
  rw [inv_mul_cancel, slDeg_one] at h
  exact Int.eq_one_or_neg_one_of_mul_eq_one' h.symm |>.elim (fun h => Or.inl h.1)
    (fun h => Or.inr h.1)

theorem slDeg_mul_self (h : SL(2, ℝ)) : slDeg (h * h) = 1 := by
  rw [slDeg_mul]
  rcases slDeg_eq_one_or h with e | e <;> rw [e] <;> norm_num

/-- The upper unipotent element `[[1, x], [0, 1]]`. -/
def slUpper (x : ℝ) : SL(2, ℝ) := ⟨!![1, x; 0, 1], by simp [Matrix.det_fin_two]⟩

/-- The lower unipotent element `[[1, 0], [x, 1]]`. -/
def slLower (x : ℝ) : SL(2, ℝ) := ⟨!![1, 0; x, 1], by simp [Matrix.det_fin_two]⟩

theorem slUpper_half (x : ℝ) : slUpper (x / 2) * slUpper (x / 2) = slUpper x := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [slUpper, Matrix.mul_apply, Fin.sum_univ_two]

theorem slLower_half (x : ℝ) : slLower (x / 2) * slLower (x / 2) = slLower x := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [slLower, Matrix.mul_apply, Fin.sum_univ_two]

/-- `g = U((a-1)/c) · L(c) · U((d-1)/c)` when `c ≠ 0`. -/
theorem sl_eq_upper_lower_upper (g : SL(2, ℝ)) (hc : (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0 ≠ 0) :
    g = slUpper (((g : Matrix (Fin 2) (Fin 2) ℝ) 0 0 - 1) / (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0) *
      slLower ((g : Matrix (Fin 2) (Fin 2) ℝ) 1 0) *
      slUpper (((g : Matrix (Fin 2) (Fin 2) ℝ) 1 1 - 1) / (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0) := by
  have hdet : (g : Matrix (Fin 2) (Fin 2) ℝ) 0 0 * (g : Matrix (Fin 2) (Fin 2) ℝ) 1 1 -
      (g : Matrix (Fin 2) (Fin 2) ℝ) 0 1 * (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = 1 := by
    have := g.2; rw [Matrix.det_fin_two] at this; exact this
  ext i j
  fin_cases i <;> fin_cases j <;> simp [slUpper, slLower, Matrix.mul_apply, Fin.sum_univ_two]
  all_goals field_simp
  all_goals (first | ring1 | linear_combination hdet | linear_combination -hdet)

/-- **Every element of `SL(2,ℝ)` acts on `ℝP¹` with degree `1`**: every element is a product of
unipotent elements, each of them a square. Hence every lift is an increasing map commuting
with `t ↦ t + 1`. -/
theorem slDeg_eq_one (g : SL(2, ℝ)) : slDeg g = 1 := by
  have hU : ∀ x, slDeg (slUpper x) = 1 := fun x => by rw [← slUpper_half, slDeg_mul_self]
  have hL : ∀ x, slDeg (slLower x) = 1 := fun x => by rw [← slLower_half, slDeg_mul_self]
  -- the case `c ≠ 0`: `g = U((a-1)/c) L(c) U((d-1)/c)`
  have key : ∀ g : SL(2, ℝ), (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0 ≠ 0 → slDeg g = 1 := by
    intro g hc
    rw [sl_eq_upper_lower_upper g hc, slDeg_mul, slDeg_mul, hU, hU, hL]; norm_num
  by_cases hc : (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = 0
  · have ha : (g : Matrix (Fin 2) (Fin 2) ℝ) 0 0 ≠ 0 := by
      intro ha
      have := g.2; rw [Matrix.det_fin_two, ha, hc] at this; simp at this
    have hl : slLower (-1) * slLower 1 = 1 := by
      ext i j
      fin_cases i <;> fin_cases j <;> simp [slLower, Matrix.mul_apply, Fin.sum_univ_two]
    have hg : g = slLower (-1) * (slLower 1 * g) := by rw [← mul_assoc, hl, one_mul]
    have h1 : ((slLower 1 * g : SL(2, ℝ)) : Matrix (Fin 2) (Fin 2) ℝ) 1 0 ≠ 0 := by
      simpa [slLower, Matrix.mul_apply, Fin.sum_univ_two, hc] using ha
    rw [hg, slDeg_mul, key _ h1, hL]; norm_num
  · exact key g hc

theorem IsSLLift.add_one {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) (t : ℝ) :
    f (t + 1) = f t + 1 := by
  rw [hf.add_one_eq_deg, slDeg_eq_one, Int.cast_one]

theorem IsSLLift.bijective {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) :
    Function.Bijective f := by
  obtain ⟨k, hk⟩ := exists_isSLLift g⁻¹
  have h1 : IsSLLift 1 (k ∘ f) := by simpa using hk.comp hf
  have h2 : IsSLLift 1 (f ∘ k) := by simpa using hf.comp hk
  obtain ⟨n, hn⟩ := isSLLift_one.eq_add_int h1
  obtain ⟨m, hm⟩ := isSLLift_one.eq_add_int h2
  refine ⟨fun s t hst => ?_, fun t => ⟨k (t - m), ?_⟩⟩
  · have := hn s; have := hn t
    simp only [Function.comp_apply, id_eq] at *
    linarith [congrArg k hst]
  · have := hm (t - m)
    simp only [Function.comp_apply, id_eq] at this
    rw [this]; ring

theorem IsSLLift.strictMono {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) : StrictMono f := by
  rcases hf.continuous.strictMono_of_inj hf.bijective.1 with h | h
  · exact h
  · have h1 := h (lt_add_one (0 : ℝ))
    rw [hf.add_one] at h1
    linarith

/-- A lift, as an element of mathlib's `CircleDeg1Lift`. -/
def IsSLLift.toLift {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) : CircleDeg1Lift where
  toFun := f
  monotone' := hf.strictMono.monotone
  map_add_one' := hf.add_one

theorem IsSLLift.isUnit_toLift {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) :
    IsUnit hf.toLift :=
  CircleDeg1Lift.isUnit_iff_bijective.2 hf.bijective

end Lifts

/-- **`G̃`, the universal covering of `PSL(2,ℝ)`, as the group of projective transformations of
`ℝP̃¹`** (l.678–680): the lifts to `ℝP̃¹ = ℝ` of the elements of `PSL(2,ℝ)`, a subgroup of the
units of mathlib's `CircleDeg1Lift` (increasing maps commuting with `t ↦ t + 1`). -/
def GTilde : Subgroup CircleDeg1Liftˣ where
  carrier := {f | ∃ g : PSL(2, ℝ), ∀ t, RP1.proj (f t) = g • RP1.proj t}
  one_mem' := ⟨1, fun t => by simp⟩
  mul_mem' := by
    rintro f f' ⟨g, hg⟩ ⟨g', hg'⟩
    refine ⟨g * g', fun t => ?_⟩
    show RP1.proj ((f : CircleDeg1Lift) ((f' : CircleDeg1Lift) t)) = _
    rw [hg, hg', mul_smul]
  inv_mem' := by
    rintro f ⟨g, hg⟩
    refine ⟨g⁻¹, fun t => ?_⟩
    rw [eq_inv_smul_iff, ← hg, CircleDeg1Lift.units_apply_inv_apply]

namespace GTilde

instance : CoeFun GTilde fun _ => ℝ → ℝ := ⟨fun f => ((f : CircleDeg1Liftˣ) : ℝ → ℝ)⟩

theorem coe_mul_apply (f f' : GTilde) (x : ℝ) : (f * f') x = f (f' x) := rfl

theorem one_apply (x : ℝ) : (1 : GTilde) x = x := rfl

theorem inv_apply_apply (f : GTilde) (x : ℝ) : f⁻¹ (f x) = x :=
  CircleDeg1Lift.units_inv_apply_apply _ x

theorem apply_inv_apply (f : GTilde) (x : ℝ) : f (f⁻¹ x) = x :=
  CircleDeg1Lift.units_apply_inv_apply _ x

theorem map_add_int (f : GTilde) (x : ℝ) (n : ℤ) : f (x + n) = f x + n :=
  CircleDeg1Lift.map_add_int _ x n

theorem strictMono (f : GTilde) : StrictMono f :=
  (CircleDeg1Lift.toOrderIso (f : CircleDeg1Liftˣ)).strictMono

theorem continuous (f : GTilde) : Continuous f :=
  (CircleDeg1Lift.toOrderIso (f : CircleDeg1Liftˣ)).continuous

theorem ext' {f f' : GTilde} (h : ∀ x, f x = f' x) : f = f' :=
  Subtype.ext (Units.ext (CircleDeg1Lift.ext h))

/-- **`G̃` acts on `ℝP̃¹`.** -/
instance : MulAction GTilde ℝ where
  smul f x := f x
  one_smul _ := rfl
  mul_smul _ _ _ := rfl

theorem smul_def (f : GTilde) (x : ℝ) : f • x = f x := rfl

instance : ContinuousConstSMul GTilde ℝ := ⟨fun f => GTilde.continuous f⟩

theorem existsUnique_psl (f : GTilde) :
    ∃! g : PSL(2, ℝ), ∀ t, RP1.proj (f t) = g • RP1.proj t := by
  obtain ⟨g, hg⟩ := f.2
  exact ⟨g, hg, fun g' hg' => psl_eq_of_forall_proj fun t => by rw [← hg, ← hg']⟩

/-- **The projection `G̃ → G = PSL(2,ℝ)`**: `proj ∘ f = π(f) • proj`. -/
def toPSL : GTilde →* PSL(2, ℝ) where
  toFun f := (existsUnique_psl f).exists.choose
  map_one' := ((existsUnique_psl 1).unique (existsUnique_psl 1).exists.choose_spec
    fun t => by rw [one_smul]; rfl)
  map_mul' f f' := ((existsUnique_psl (f * f')).unique
    (existsUnique_psl (f * f')).exists.choose_spec fun t => by
      rw [coe_mul_apply, (existsUnique_psl f).exists.choose_spec,
        (existsUnique_psl f').exists.choose_spec, mul_smul])

theorem proj_apply (f : GTilde) (t : ℝ) : RP1.proj (f t) = toPSL f • RP1.proj t :=
  (existsUnique_psl f).exists.choose_spec t

theorem proj_smul (f : GTilde) (t : ℝ) : RP1.proj (f • t) = toPSL f • RP1.proj t :=
  proj_apply f t

theorem toPSL_eq_iff {f : GTilde} {g : PSL(2, ℝ)} :
    toPSL f = g ↔ ∀ t, RP1.proj (f t) = g • RP1.proj t :=
  ⟨fun h => h ▸ proj_apply f, fun h => (existsUnique_psl f).unique (proj_apply f) h⟩

/-- The lift of `g ∈ SL(2,ℝ)` given by a continuous lift, as an element of `G̃`. -/
def ofLift {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) : GTilde :=
  ⟨hf.isUnit_toLift.unit, pslMk g, fun t => hf.proj_apply t⟩

theorem ofLift_apply {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) (t : ℝ) :
    ofLift hf t = f t := rfl

theorem toPSL_ofLift {g : SL(2, ℝ)} {f : ℝ → ℝ} (hf : IsSLLift g f) :
    toPSL (ofLift hf) = pslMk g :=
  toPSL_eq_iff.2 fun t => hf.proj_apply t

/-- **`G̃ → G` is onto.** -/
theorem toPSL_surjective : Function.Surjective toPSL := fun g => by
  obtain ⟨g, rfl⟩ := pslMk_surjective g
  obtain ⟨f, hf⟩ := exists_isSLLift g
  exact ⟨ofLift hf, toPSL_ofLift hf⟩

/-- **`δ`, the generator of the centre `ℤ` with `δ x > x`** (l.684–685): the deck
translation `x ↦ x + 1`. -/
def delta : GTilde :=
  ⟨CircleDeg1Lift.translate (Multiplicative.ofAdd 1), 1, fun t => by
    rw [one_smul]
    show RP1.proj (1 + t) = _
    rw [add_comm, RP1.proj_add_one]⟩

theorem delta_apply (x : ℝ) : delta x = x + 1 := by
  show (CircleDeg1Lift.translate (Multiplicative.ofAdd (1 : ℝ)) : CircleDeg1Lift) x = x + 1
  rw [CircleDeg1Lift.translate_apply, add_comm]

theorem lt_delta_apply (x : ℝ) : x < delta x := by rw [delta_apply]; linarith

theorem delta_zpow_apply (n : ℤ) (x : ℝ) : (delta ^ n) x = x + n := by
  show ((CircleDeg1Lift.translate (Multiplicative.ofAdd (1 : ℝ)) ^ n : CircleDeg1Liftˣ) :
    CircleDeg1Lift) x = x + n
  rw [← map_zpow, ← ofAdd_zsmul, CircleDeg1Lift.translate_apply, zsmul_one, add_comm]

/-- `δ` is central: every element of `G̃` commutes with the deck group. -/
theorem delta_mem_center : delta ∈ Subgroup.center GTilde :=
  Subgroup.mem_center_iff.2 fun f => ext' fun x => by
    rw [coe_mul_apply, coe_mul_apply, delta_apply, delta_apply]
    exact_mod_cast map_add_int f x 1

theorem toPSL_delta : toPSL delta = 1 :=
  toPSL_eq_iff.2 fun t => by rw [delta_apply, RP1.proj_add_one, one_smul]

/-- **The exact sequence `0 → ℤ → G̃ → G → 0`** (l.680–682), kernel: `ker(G̃ → G) = ⟨δ⟩`. -/
theorem ker_toPSL : toPSL.ker = Subgroup.zpowers delta := by
  ext f
  rw [MonoidHom.mem_ker, Subgroup.mem_zpowers_iff]
  constructor
  · intro hf
    have h1 : ∀ t, RP1.proj (f t) = RP1.proj t := fun t => by rw [proj_apply, hf, one_smul]
    -- `t ↦ f t` and `t ↦ t + n` are two lifts of the identity
    obtain ⟨n, hn⟩ := RP1.proj_eq_proj_iff.1 (h1 0)
    have := RP1.isCoveringMap_proj.eq_of_comp_eq (g₁ := fun t => f t)
      (g₂ := fun t : ℝ => t + (n : ℝ)) (GTilde.continuous f)
      (continuous_id.add continuous_const)
      (funext fun t => by simp only [Function.comp_apply, RP1.proj_add_int, h1]) 0
      (by rw [hn, zero_add])
    refine ⟨n, ext' fun x => ?_⟩
    rw [delta_zpow_apply, congrFun this x]
  · rintro ⟨n, rfl⟩
    rw [map_zpow, toPSL_delta, one_zpow]

/-- ... and `ℤ → G̃`, `n ↦ δⁿ`, is injective. -/
theorem zpow_delta_injective : Function.Injective fun n : ℤ => delta ^ n := fun m n h => by
  have := congrArg (fun f : GTilde => f 0) h
  simp only [delta_zpow_apply, zero_add] at this
  exact_mod_cast this

/-- **Two elements of `G̃` agreeing on a nonempty open set are equal.** -/
theorem eq_of_eqOn {f f' : GTilde} {U : Set ℝ} (hU : IsOpen U) (hne : U.Nonempty)
    (h : EqOn f f' U) : f = f' := by
  have hpsl : toPSL f = toPSL f' := by
    refine psl_eq_of_eqOn (RP1.isOpenMap_proj U hU) (hne.image _) ?_
    rintro _ ⟨x, hx, rfl⟩
    simp only
    rw [← proj_apply, ← proj_apply, h hx]
  have hk : f'⁻¹ * f ∈ toPSL.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hpsl, inv_mul_cancel]
  rw [ker_toPSL, Subgroup.mem_zpowers_iff] at hk
  obtain ⟨n, hn⟩ := hk
  obtain ⟨x, hx⟩ := hne
  have h1 : (f'⁻¹ * f) x = x := by rw [coe_mul_apply, h hx, inv_apply_apply]
  rw [← hn, delta_zpow_apply] at h1
  have hn0 : n = 0 := by exact_mod_cast (add_eq_left.1 h1)
  rw [hn0, zpow_zero] at hn
  exact (inv_mul_eq_one.1 hn.symm).symm

end GTilde

/-! ### The centre of `G̃` -/

/-- If `g` fixes the line `ℝ z`, then `z = c · g z` with `c ≠ 0`. -/
theorem RP1.exists_eq_mul_of_smul_mk {g : SL(2, ℝ)} {z : ℂ} (hz : z ≠ 0)
    (h : g • RP1.mk z = RP1.mk z) : ∃ c : ℝ, c ≠ 0 ∧ z = (c : ℂ) * slLin g z := by
  rw [RP1.sl_smul_mk g hz, RP1.mk_eq_mk_iff (slLin_ne_zero g hz) hz] at h
  obtain ⟨c, hc⟩ := h
  refine ⟨c, ?_, hc⟩
  rintro rfl
  rw [Complex.ofReal_zero, zero_mul] at hc
  exact hz hc

/-- The only line fixed by `[[1, 1], [0, 1]]` is `ℝ · 1`. -/
theorem RP1.eq_mk_one_of_slUpper_smul {w : RP1} (h : slUpper 1 • w = w) : w = RP1.mk 1 := by
  have hz := RP1.rep_ne_zero w
  rw [← RP1.mk_rep w] at h ⊢
  obtain ⟨c, -, hc⟩ := RP1.exists_eq_mul_of_smul_mk hz h
  have hre := congrArg Complex.re hc
  have him := congrArg Complex.im hc
  rw [slLin_apply] at hre him
  simp [slUpper] at hre him
  have hy : (RP1.rep w).im = 0 := by
    by_contra hy
    have hc1 : c = 1 := by
      have : (c - 1) * (RP1.rep w).im = 0 := by linear_combination -him
      exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_right hy)
    rw [hc1] at hre
    exact hy (by linarith)
  have hx : (RP1.rep w).re ≠ 0 := fun hx => hz (Complex.ext hx hy)
  have : RP1.rep w = ((RP1.rep w).re : ℂ) * 1 := by apply Complex.ext <;> simp [hy]
  rw [this, RP1.mk_ofReal_mul hx]

/-- The only line fixed by `[[1, 0], [1, 1]]` is `ℝ · i`. -/
theorem RP1.eq_mk_I_of_slLower_smul {w : RP1} (h : slLower 1 • w = w) :
    w = RP1.mk Complex.I := by
  have hz := RP1.rep_ne_zero w
  rw [← RP1.mk_rep w] at h ⊢
  obtain ⟨c, -, hc⟩ := RP1.exists_eq_mul_of_smul_mk hz h
  have hre := congrArg Complex.re hc
  have him := congrArg Complex.im hc
  rw [slLin_apply] at hre him
  simp [slLower] at hre him
  have hx : (RP1.rep w).re = 0 := by
    by_contra hx
    have hc1 : c = 1 := by
      have : (c - 1) * (RP1.rep w).re = 0 := by linear_combination -hre
      exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_right hx)
    rw [hc1] at him
    exact hx (by linarith)
  have hy : (RP1.rep w).im ≠ 0 := fun hy => hz (Complex.ext hx hy)
  have : RP1.rep w = ((RP1.rep w).im : ℂ) * Complex.I := by apply Complex.ext <;> simp [hx]
  rw [this, RP1.mk_ofReal_mul hy]

/-- **`PSL(2,ℝ)` has trivial centre**: a central element fixes the fixed lines `ℝ·1`, `ℝ·i` of
the two unipotents, and `ℝ·(1 + i)`, so it is `±1`. -/
theorem psl_center_eq_bot : Subgroup.center PSL(2, ℝ) = ⊥ := by
  rw [eq_bot_iff]
  intro g' hg'
  rw [Subgroup.mem_bot]
  obtain ⟨g, rfl⟩ := pslMk_surjective g'
  have hcomm : ∀ (h : SL(2, ℝ)) (w : RP1), g • h • w = h • g • w := fun h w => by
    have h1 := congrArg (· • w) (Subgroup.mem_center_iff.1 hg' (pslMk h))
    simp only [mul_smul, pslMk_smul] at h1
    exact h1.symm
  have hU1 : slUpper 1 • RP1.mk 1 = RP1.mk 1 := by
    rw [RP1.sl_smul_mk _ one_ne_zero]
    congr 1
    rw [slLin_apply]; apply Complex.ext <;> simp [slUpper]
  have hLI : slLower 1 • RP1.mk Complex.I = RP1.mk Complex.I := by
    rw [RP1.sl_smul_mk _ Complex.I_ne_zero]
    congr 1
    rw [slLin_apply]; apply Complex.ext <;> simp [slLower]
  have h1 : g • RP1.mk 1 = RP1.mk 1 :=
    RP1.eq_mk_one_of_slUpper_smul (by rw [← hcomm, hU1])
  have h2 : g • RP1.mk Complex.I = RP1.mk Complex.I :=
    RP1.eq_mk_I_of_slLower_smul (by rw [← hcomm, hLI])
  have hUI : RP1.mk (1 + Complex.I) = slUpper 1 • RP1.mk Complex.I := by
    rw [RP1.sl_smul_mk _ Complex.I_ne_zero]
    congr 1
    rw [slLin_apply]; apply Complex.ext <;> simp [slUpper]
  have h3 : g • RP1.mk (1 + Complex.I) = RP1.mk (1 + Complex.I) := by
    rw [hUI, hcomm, h2]
  obtain ⟨c₁, hc₁, e₁⟩ := RP1.exists_eq_mul_of_smul_mk one_ne_zero h1
  obtain ⟨c₂, hc₂, e₂⟩ := RP1.exists_eq_mul_of_smul_mk Complex.I_ne_zero h2
  have h1I : (1 + Complex.I) ≠ 0 := fun h => by simpa using congrArg Complex.re h
  obtain ⟨c₃, hc₃, e₃⟩ := RP1.exists_eq_mul_of_smul_mk h1I h3
  rw [slLin_apply] at e₁ e₂ e₃
  have f1 := congrArg Complex.im e₁
  have f2 := congrArg Complex.re e₂
  have f3 := congrArg Complex.re e₃
  have f4 := congrArg Complex.im e₃
  simp at f1 f2 f3 f4
  have hdet := g.2
  rw [Matrix.det_fin_two] at hdet
  have g10 : (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = 0 := f1.resolve_left hc₁
  have g01 : (g : Matrix (Fin 2) (Fin 2) ℝ) 0 1 = 0 := f2.resolve_left hc₂
  simp only [g10, g01, add_zero, zero_add, mul_zero, sub_zero] at f3 f4 hdet
  have g11 : (g : Matrix (Fin 2) (Fin 2) ℝ) 1 1 = (g : Matrix (Fin 2) (Fin 2) ℝ) 0 0 := by
    have : c₃ * ((g : Matrix (Fin 2) (Fin 2) ℝ) 1 1 - (g : Matrix (Fin 2) (Fin 2) ℝ) 0 0) = 0 := by
      linear_combination f3 - f4
    exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_left hc₃)
  rw [g11] at hdet
  have hcen : g ∈ Subgroup.center SL(2, ℝ) := by
    rw [Matrix.SpecialLinearGroup.mem_center_iff]
    refine ⟨(g : Matrix (Fin 2) (Fin 2) ℝ) 0 0, by simpa [pow_two] using hdet, ?_⟩
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.scalar_apply, g10, g01, g11]
  exact (QuotientGroup.eq_one_iff g).2 hcen

/-- **The centre of `G̃` is `⟨δ⟩ ≅ ℤ`** (l.682, l.684). -/
theorem GTilde.center_eq_zpowers : Subgroup.center GTilde = Subgroup.zpowers GTilde.delta := by
  apply le_antisymm
  · intro f hf
    have hc : GTilde.toPSL f ∈ Subgroup.center PSL(2, ℝ) := Subgroup.mem_center_iff.2 fun g => by
      obtain ⟨h, rfl⟩ := GTilde.toPSL_surjective g
      rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.1 hf h]
    rw [psl_center_eq_bot, Subgroup.mem_bot] at hc
    rw [← GTilde.ker_toPSL]
    exact hc
  · rw [Subgroup.zpowers_le]
    exact GTilde.delta_mem_center

/-! ### The elliptic–parabolic–hyperbolic classification and the real angle of an element -/

namespace PSL2

/-- The squared trace, well defined on `PSL(2,ℝ)`. -/
def trSq (g : PSL(2, ℝ)) : ℝ :=
  Quotient.liftOn' g (fun g : SL(2, ℝ) => (Matrix.trace (g : Matrix (Fin 2) (Fin 2) ℝ)) ^ 2)
    (fun a b hab => by
      rw [QuotientGroup.leftRel_apply] at hab
      obtain ⟨r, hr, hrab⟩ := Matrix.SpecialLinearGroup.mem_center_iff.1 hab
      have hr2 : r ^ 2 = 1 := by simpa using hr
      have hb : (b : Matrix (Fin 2) (Fin 2) ℝ) = (a : Matrix (Fin 2) (Fin 2) ℝ) *
          Matrix.scalar (Fin 2) r := by
        rw [hrab, ← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel_left]
      show (Matrix.trace (a : Matrix (Fin 2) (Fin 2) ℝ)) ^ 2 =
        (Matrix.trace (b : Matrix (Fin 2) (Fin 2) ℝ)) ^ 2
      rw [hb, Matrix.trace_fin_two, Matrix.trace_fin_two]
      simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.scalar_apply, Matrix.diagonal_apply]
      simp only [Fin.isValue, ↓reduceIte, mul_zero, add_zero, zero_add, one_ne_zero,
        zero_ne_one]
      linear_combination -((a : Matrix (Fin 2) (Fin 2) ℝ) 0 0 +
        (a : Matrix (Fin 2) (Fin 2) ℝ) 1 1) ^ 2 * hr2)

theorem trSq_mk (g : SL(2, ℝ)) :
    trSq (pslMk g) = (Matrix.trace (g : Matrix (Fin 2) (Fin 2) ℝ)) ^ 2 := rfl

/-- **Elliptic** elements of `G = PSL(2,ℝ)` (l.598–608, l.688): `|tr| < 2`. -/
def IsElliptic (g : PSL(2, ℝ)) : Prop := trSq g < 4

/-- **Parabolic** elements: `|tr| = 2`, `g ≠ 1`. -/
def IsParabolic (g : PSL(2, ℝ)) : Prop := trSq g = 4 ∧ g ≠ 1

/-- **Hyperbolic** elements: `|tr| > 2`. -/
def IsHyperbolic (g : PSL(2, ℝ)) : Prop := 4 < trSq g

theorem trichotomy (g : PSL(2, ℝ)) : g = 1 ∨ IsElliptic g ∨ IsParabolic g ∨ IsHyperbolic g := by
  rcases lt_trichotomy (trSq g) 4 with h | h | h
  · exact Or.inr (Or.inl h)
  · by_cases h1 : g = 1
    · exact Or.inl h1
    · exact Or.inr (Or.inr (Or.inl ⟨h, h1⟩))
  · exact Or.inr (Or.inr (Or.inr h))

/-- If `g` fixes the line `ℝ z`, then `tr(g)² ≥ 4` (a real eigenvalue). -/
theorem four_le_trSq_of_smul_eq (g : SL(2, ℝ)) {z : ℂ} (hz : z ≠ 0) (h : g • RP1.mk z = RP1.mk z) :
    4 ≤ (Matrix.trace (g : Matrix (Fin 2) (Fin 2) ℝ)) ^ 2 := by
  rw [RP1.sl_smul_mk g hz, RP1.mk_eq_mk_iff (slLin_ne_zero g hz) hz] at h
  obtain ⟨c, hc⟩ := h
  have hre := congrArg Complex.re hc
  have him := congrArg Complex.im hc
  rw [slLin_apply] at hre him
  simp only [Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul,
    sub_zero, add_zero] at hre him
  set a := (g : Matrix (Fin 2) (Fin 2) ℝ) 0 0
  set b := (g : Matrix (Fin 2) (Fin 2) ℝ) 0 1
  set c' := (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0
  set d := (g : Matrix (Fin 2) (Fin 2) ℝ) 1 1
  have hdet : a * d - b * c' = 1 := by
    have := g.2; rw [Matrix.det_fin_two] at this; exact this
  rw [Matrix.trace_fin_two]
  -- `z = c (g z)` : `c ≠ 0`, and `μ = c⁻¹` is an eigenvalue
  have hc0 : c ≠ 0 := by
    rintro rfl
    apply hz
    rw [hc, Complex.ofReal_zero, zero_mul]
  set x := z.re
  set y := z.im
  have hxy : x ≠ 0 ∨ y ≠ 0 := by
    by_contra hh
    push Not at hh
    exact hz (Complex.ext hh.1 hh.2)
  -- `(a - μ) x + b y = 0` and `c' x + (d - μ) y = 0`, with `μ = 1/c`
  have e1 : (c * a - 1) * x + c * b * y = 0 := by linear_combination -hre
  have e2 : c * c' * x + (c * d - 1) * y = 0 := by linear_combination -him
  have hP : (c * a - 1) * (c * d - 1) - c * b * (c * c') = 0 := by
    rcases hxy with hx | hy
    · have : ((c * a - 1) * (c * d - 1) - c * b * (c * c')) * x = 0 := by
        linear_combination (c * d - 1) * e1 - c * b * e2
      exact (mul_eq_zero.1 this).resolve_right hx
    · have : ((c * a - 1) * (c * d - 1) - c * b * (c * c')) * y = 0 := by
        linear_combination (c * a - 1) * e2 - c * c' * e1
      exact (mul_eq_zero.1 this).resolve_right hy
  -- `c² - (a + d) c + 1 = 0`
  have hq : c ^ 2 - (a + d) * c + 1 = 0 := by linear_combination hP - c ^ 2 * hdet
  nlinarith [sq_nonneg (2 * c - (a + d)), sq_nonneg c, hq, hdet]

/-- An elliptic element has no fixed point on `ℝP¹`. -/
theorem IsElliptic.smul_ne {g : PSL(2, ℝ)} (hg : IsElliptic g) (w : RP1) : g • w ≠ w := by
  obtain ⟨g, rfl⟩ := pslMk_surjective g
  intro h
  rw [← RP1.mk_rep w, pslMk_smul] at h
  have := four_le_trSq_of_smul_eq g (RP1.rep_ne_zero w) h
  exact absurd hg (not_lt.2 this)

/-- A non-elliptic element has a fixed point on `ℝP¹`. -/
theorem exists_smul_eq_of_not_isElliptic {g : PSL(2, ℝ)} (hg : ¬ IsElliptic g) :
    ∃ w : RP1, g • w = w := by
  obtain ⟨g, rfl⟩ := pslMk_surjective g
  have ht : 4 ≤ (Matrix.trace (g : Matrix (Fin 2) (Fin 2) ℝ)) ^ 2 := not_lt.1 hg
  rw [Matrix.trace_fin_two] at ht
  set a := (g : Matrix (Fin 2) (Fin 2) ℝ) 0 0 with ha
  set b := (g : Matrix (Fin 2) (Fin 2) ℝ) 0 1 with hb_def
  set c' := (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0 with hc_def
  set d := (g : Matrix (Fin 2) (Fin 2) ℝ) 1 1 with hd_def
  have hdet : a * d - b * c' = 1 := by
    have := g.2; rw [Matrix.det_fin_two] at this; exact this
  by_cases hb : b = 0
  · -- `(0, 1)` is an eigenvector
    have hd : d ≠ 0 := by rintro hd; rw [hb, hd] at hdet; simp at hdet
    refine ⟨RP1.mk Complex.I, ?_⟩
    rw [pslMk_smul, RP1.sl_smul_mk g Complex.I_ne_zero]
    have hb' : (g : Matrix (Fin 2) (Fin 2) ℝ) 0 1 = 0 := hb
    have : slLin g Complex.I = (d : ℂ) * Complex.I := by
      rw [slLin_apply]; apply Complex.ext <;> simp [hb', d]
    rw [this, RP1.mk_ofReal_mul hd]
  · -- `μ = (t + √(t² - 4))/2` is a real eigenvalue, of eigenvector `(b, μ - a)`
    set μ := ((a + d) + Real.sqrt ((a + d) ^ 2 - 4)) / 2
    have hs := Real.sq_sqrt (show (0 : ℝ) ≤ (a + d) ^ 2 - 4 by linarith)
    have hμ : μ ^ 2 - (a + d) * μ + 1 = 0 := by
      simp only [μ]; linear_combination hs / 4
    have hμ0 : μ ≠ 0 := by rintro h0; rw [h0] at hμ; simp at hμ
    set z : ℂ := ⟨b, μ - a⟩
    have hz : z ≠ 0 := fun h => hb (congrArg Complex.re h)
    refine ⟨RP1.mk z, ?_⟩
    rw [pslMk_smul, RP1.sl_smul_mk g hz]
    have : slLin g z = (μ : ℂ) * z := by
      rw [slLin_apply, ← ha, ← hb_def, ← hc_def, ← hd_def]
      apply Complex.ext
      · simp only [z, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
        ring
      · simp only [z, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero]
        linear_combination -hμ - hdet
    rw [this, RP1.mk_ofReal_mul hμ0]

end PSL2

namespace GTilde

/-- The classification of `G̃` "according to the nature of their projection in `G`" (l.688–689). -/
def IsElliptic (f : GTilde) : Prop := PSL2.IsElliptic (toPSL f)

def IsParabolic (f : GTilde) : Prop := PSL2.IsParabolic (toPSL f)

def IsHyperbolic (f : GTilde) : Prop := PSL2.IsHyperbolic (toPSL f)

/-- **The real angle of an element of `G̃`**: `2π` times its translation number (mathlib's
`CircleDeg1Lift.translationNumber`), so that `δ`, the rotation by one full turn, has angle `2π`. -/
def angle (f : GTilde) : ℝ :=
  2 * π * CircleDeg1Lift.translationNumber ((f : CircleDeg1Liftˣ) : CircleDeg1Lift)

theorem coe_delta_zpow (n : ℤ) :
    (((delta ^ n : GTilde) : CircleDeg1Liftˣ) : CircleDeg1Lift) =
      CircleDeg1Lift.translate (Multiplicative.ofAdd (n : ℝ)) := by
  refine CircleDeg1Lift.ext fun x => ?_
  rw [CircleDeg1Lift.translate_apply, add_comm]
  exact delta_zpow_apply n x

theorem angle_delta_zpow (n : ℤ) : angle (delta ^ n) = 2 * π * n := by
  rw [angle, coe_delta_zpow, CircleDeg1Lift.translationNumber_translate]

theorem angle_delta : angle delta = 2 * π := by
  simpa using angle_delta_zpow 1

/-- The real angle is a conjugacy invariant of `G̃`. -/
theorem angle_conj (f h : GTilde) : angle (h * f * h⁻¹) = angle f := by
  rw [angle, angle]
  congr 1
  have := CircleDeg1Lift.translationNumber_conj_eq (h : CircleDeg1Liftˣ)
    ((f : CircleDeg1Liftˣ) : CircleDeg1Lift)
  rw [← this]
  rfl

theorem angle_delta_zpow_mul (n : ℤ) (f : GTilde) : angle (delta ^ n * f) = 2 * π * n + angle f := by
  have hc : Commute (((delta ^ n : GTilde) : CircleDeg1Liftˣ) : CircleDeg1Lift)
      ((f : CircleDeg1Liftˣ) : CircleDeg1Lift) := by
    rw [CircleDeg1Lift.commute_iff_commute, coe_delta_zpow]
    intro x
    simp only [CircleDeg1Lift.translate_apply]
    rw [add_comm, CircleDeg1Lift.map_int_add, add_comm]
  rw [angle, show (((delta ^ n * f : GTilde) : CircleDeg1Liftˣ) : CircleDeg1Lift) =
    (((delta ^ n : GTilde) : CircleDeg1Liftˣ) : CircleDeg1Lift) *
      ((f : CircleDeg1Liftˣ) : CircleDeg1Lift) from rfl,
    CircleDeg1Lift.translationNumber_mul_of_commute hc, mul_add, ← angle, ← angle,
    angle_delta_zpow]

/-- **Elliptic elements act freely on `ℝP̃¹`** (l.690–691): no iterate `fⁿ`, `n ≠ 0`, has a
fixed point. -/
theorem IsElliptic.apply_ne {f : GTilde} (hf : IsElliptic f) (x : ℝ) : f x ≠ x := fun h =>
  PSL2.IsElliptic.smul_ne hf (RP1.proj x) (by rw [← proj_apply, h])

/-- A fixed-point-free element of `G̃` moving one point to the right moves every point to the
right. -/
theorem lt_apply_of_forall_ne {f : GTilde} (hfix : ∀ x, f x ≠ x) {x₀ : ℝ} (h : x₀ < f x₀)
    (x : ℝ) : x < f x := by
  by_contra hx
  have hx' := not_lt.1 hx
  have hc : Continuous fun y => f y - y := (GTilde.continuous f).sub continuous_id
  obtain ⟨z, hz⟩ := intermediate_value_univ x x₀ hc
    (show (0 : ℝ) ∈ Set.Icc (f x - x) (f x₀ - x₀) from ⟨by linarith, by linarith⟩)
  exact hfix z (by simp only at hz; linarith)

theorem lt_pow_apply {f : GTilde} (h : ∀ x, x < f x) {n : ℕ} (hn : 0 < n) (x : ℝ) :
    x < (f ^ n) x := by
  induction n with
  | zero => exact absurd hn (lt_irrefl 0)
  | succ m ih =>
    rcases Nat.eq_zero_or_pos m with rfl | hm
    · simpa using h x
    · rw [pow_succ', coe_mul_apply]
      exact (ih hm).trans (h _)

theorem zpow_apply_ne_of_forall_lt {f : GTilde} (h : ∀ x, x < f x) {n : ℤ} (hn : n ≠ 0)
    (x : ℝ) : (f ^ n) x ≠ x := by
  rcases Int.eq_nat_or_neg n with ⟨m, rfl | rfl⟩
  · have hm : 0 < m := by omega
    rw [zpow_natCast]
    exact (lt_pow_apply h hm x).ne'
  · have hm : 0 < m := by omega
    rw [zpow_neg, zpow_natCast]
    intro hx
    have := lt_pow_apply h hm ((f ^ m)⁻¹ x)
    rw [apply_inv_apply, hx] at this
    exact lt_irrefl _ this

theorem IsElliptic.zpow_apply_ne {f : GTilde} (hf : IsElliptic f) {n : ℤ} (hn : n ≠ 0) (x : ℝ) :
    (f ^ n) x ≠ x := by
  rcases lt_or_gt_of_ne (hf.apply_ne 0) with h0 | h0
  · -- `f` moves every point to the left: argue with `f⁻¹`
    have hinv : ∀ y, y < f⁻¹ y := by
      have hfix' : ∀ y, f⁻¹ y ≠ y := fun y hy => hf.apply_ne y (by
        have := apply_inv_apply f y
        rwa [hy] at this)
      refine lt_apply_of_forall_ne hfix' (x₀ := f 0) ?_
      rw [inv_apply_apply]; exact h0
    have := zpow_apply_ne_of_forall_lt hinv (neg_ne_zero.2 hn) x
    rwa [inv_zpow', neg_neg] at this
  · exact zpow_apply_ne_of_forall_lt (lt_apply_of_forall_ne hf.apply_ne h0) hn x

/-- A fixed-point-free element of `G̃` moving points to the right moves them by at least some
`c > 0` (the displacement is continuous and `1`-periodic). -/
theorem exists_add_le_of_forall_lt {f : GTilde} (h : ∀ x, x < f x) :
    ∃ c > 0, ∀ x, x + c ≤ f x := by
  have hc : Continuous fun y => f y - y := (GTilde.continuous f).sub continuous_id
  obtain ⟨m, -, hm⟩ := isCompact_Icc.exists_isMinOn (nonempty_Icc.2 (zero_le_one' ℝ))
    hc.continuousOn
  refine ⟨f m - m, by linarith [h m], fun x => ?_⟩
  have hper : f x - x = f (Int.fract x) - Int.fract x := by
    have := map_add_int f (Int.fract x) ⌊x⌋
    rw [Int.fract_add_floor] at this
    rw [this]
    have := Int.fract_add_floor x
    linarith
  have := hm ⟨Int.fract_nonneg x, (Int.fract_lt_one x).le⟩
  simp only [mem_setOf_eq] at this
  linarith

theorem add_mul_le_pow_apply {f : GTilde} {c : ℝ} (h : ∀ x, x + c ≤ f x) (m : ℕ) (x : ℝ) :
    x + m * c ≤ (f ^ m) x := by
  induction m generalizing x with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', coe_mul_apply, Nat.cast_succ]
    have := h ((f ^ k) x)
    linarith [ih x]

/-- The displacement of `fⁿ` is at least `|n| c`. -/
theorem abs_zpow_apply_sub_ge {f : GTilde} {c : ℝ} (h : ∀ x, x + c ≤ f x) (n : ℤ) (x : ℝ) :
    |n| * c ≤ |(f ^ n) x - x| := by
  rcases Int.eq_nat_or_neg n with ⟨m, rfl | rfl⟩
  · rw [zpow_natCast]
    have := add_mul_le_pow_apply h m x
    have hm : ((|(m : ℤ)| : ℤ) : ℝ) = m := by simp
    rw [hm]
    exact le_abs.2 (Or.inl (by linarith))
  · rw [zpow_neg, zpow_natCast]
    have := add_mul_le_pow_apply h m ((f ^ m)⁻¹ x)
    rw [apply_inv_apply] at this
    have hm : ((|-(m : ℤ)| : ℤ) : ℝ) = m := by simp
    rw [hm]
    exact le_abs.2 (Or.inr (by linarith))

/-- **Non-trivial elliptic elements act on `ℝP̃¹` freely and properly discontinuously**
(l.690–691): only finitely many powers move a compact set onto a compact set. -/
theorem IsElliptic.properlyDiscontinuousSMul {f : GTilde} (hf : IsElliptic f) :
    ProperlyDiscontinuousSMul (Subgroup.zpowers f) ℝ := by
  -- the displacement of `fⁿ` is at least `|n| c`, `c > 0`
  obtain ⟨c, hc, hdisp⟩ : ∃ c > 0, ∀ (n : ℤ) (x : ℝ), |n| * c ≤ |(f ^ n) x - x| := by
    rcases lt_or_gt_of_ne (hf.apply_ne 0) with h0 | h0
    · have hfix' : ∀ y, f⁻¹ y ≠ y := fun y hy => hf.apply_ne y (by
        have := apply_inv_apply f y
        rwa [hy] at this)
      have hinv : ∀ y, y < f⁻¹ y :=
        lt_apply_of_forall_ne hfix' (x₀ := f 0) (by rw [inv_apply_apply]; exact h0)
      obtain ⟨c, hc, hle⟩ := exists_add_le_of_forall_lt hinv
      refine ⟨c, hc, fun n x => ?_⟩
      have := abs_zpow_apply_sub_ge hle (-n) x
      rwa [inv_zpow', neg_neg, abs_neg] at this
    · obtain ⟨c, hc, hle⟩ := exists_add_le_of_forall_lt (lt_apply_of_forall_ne hf.apply_ne h0)
      exact ⟨c, hc, abs_zpow_apply_sub_ge hle⟩
  refine ⟨fun {K L} hK hL => ?_⟩
  obtain ⟨R, hR⟩ := (hK.isBounded.union hL.isBounded).subset_closedBall 0
  -- the integers `n` with `|n| ≤ 2R/c`
  set N : ℕ := ⌈2 * R / c⌉₊
  have hfin : (Set.Icc (-(N : ℤ)) N).Finite := Set.finite_Icc _ _
  refine (hfin.image fun n : ℤ => (⟨f ^ n, n, rfl⟩ : Subgroup.zpowers f)).subset ?_
  rintro ⟨γ, n, rfl⟩ ⟨_, ⟨x, hx, rfl⟩, hyL⟩
  refine ⟨n, ?_, rfl⟩
  have hxR : |x| ≤ R := by simpa [Real.dist_eq] using hR (Or.inl hx)
  have hyL' : (f ^ n) x ∈ L := hyL
  have hyR : |(f ^ n) x| ≤ R := by simpa [Real.dist_eq] using hR (Or.inr hyL')
  have h1 := hdisp n x
  have h2 : |(f ^ n) x - x| ≤ 2 * R := by
    calc |(f ^ n) x - x| ≤ |(f ^ n) x| + |x| := abs_sub _ _
      _ ≤ 2 * R := by linarith
  have h3 : ((|n| : ℤ) : ℝ) ≤ 2 * R / c := by
    rw [le_div_iff₀ hc]; linarith
  have h4 : ((|n| : ℤ) : ℝ) ≤ (N : ℝ) := h3.trans (Nat.le_ceil _)
  have h5 : |n| ≤ (N : ℤ) := by exact_mod_cast h4
  exact abs_le.1 h5

/-- An element of `G̃` without fixed point which moves one point to the right has positive real
angle; one with a fixed point has angle `0`. -/
theorem angle_pos_of_forall_ne {f : GTilde} (hfix : ∀ x, f x ≠ x) {x₀ : ℝ} (h : x₀ < f x₀) :
    0 < angle f := by
  have hlt : ∀ x, x < f x := by
    intro x
    by_contra hx
    have hx' := not_lt.1 hx
    have hc : Continuous fun y => f y - y := (GTilde.continuous f).sub continuous_id
    obtain ⟨z, hz⟩ := intermediate_value_univ x x₀ hc
      (show (0 : ℝ) ∈ Set.Icc (f x - x) (f x₀ - x₀) from ⟨by linarith, by linarith⟩)
    exact hfix z (by simp only at hz; linarith)
  have := CircleDeg1Lift.lt_translationNumber_of_forall_add_lt
    ((f : CircleDeg1Liftˣ) : CircleDeg1Lift) (GTilde.continuous f)
    (z := 0) fun x => by rw [add_zero]; exact hlt x
  rw [angle]
  positivity

theorem angle_eq_zero_of_fixed {f : GTilde} {x₀ : ℝ} (h : f x₀ = x₀) : angle f = 0 := by
  have := CircleDeg1Lift.translationNumber_of_eq_add_int (f := ((f : CircleDeg1Liftˣ) :
    CircleDeg1Lift)) (x := x₀) (m := 0) (by rw [Int.cast_zero, add_zero]; exact h)
  rw [angle, this, Int.cast_zero, mul_zero]

/-- **The decomposition `g̃ = δᵏ g`** (l.696–698): a non-elliptic element of `G̃` is `δᵏ f₀` with
`f₀` having a fixed point in `ℝP̃¹`; `k` is unique, and it is the translation number. -/
theorem exists_delta_zpow_mul_of_not_isElliptic {f : GTilde} (hf : ¬ IsElliptic f) :
    ∃ (k : ℤ) (f₀ : GTilde), (∃ x, f₀ x = x) ∧ f = delta ^ k * f₀ := by
  obtain ⟨w, hw⟩ := PSL2.exists_smul_eq_of_not_isElliptic hf
  obtain ⟨x, rfl⟩ := RP1.proj_surjective w
  obtain ⟨k, hk⟩ := RP1.proj_eq_proj_iff.1 ((proj_apply f x).trans hw)
  refine ⟨k, delta ^ (-k) * f, ⟨x, ?_⟩, by rw [← mul_assoc, ← zpow_add, add_neg_cancel,
    zpow_zero, one_mul]⟩
  rw [coe_mul_apply, delta_zpow_apply, hk]; push_cast; ring

theorem angle_eq_of_delta_zpow_mul {f f₀ : GTilde} {k : ℤ} (hf₀ : ∃ x, f₀ x = x)
    (h : f = delta ^ k * f₀) : angle f = 2 * π * k := by
  obtain ⟨x, hx⟩ := hf₀
  rw [h, angle_delta_zpow_mul, angle_eq_zero_of_fixed hx, add_zero]

theorem delta_zpow_mul_unique {f₀ f₀' : GTilde} {k k' : ℤ} (h₀ : ∃ x, f₀ x = x)
    (h₀' : ∃ x, f₀' x = x) (h : delta ^ k * f₀ = delta ^ k' * f₀') : k = k' := by
  have h1 := angle_eq_of_delta_zpow_mul (f := delta ^ k * f₀) (k := k) h₀ rfl
  have h2 := angle_eq_of_delta_zpow_mul (f := delta ^ k' * f₀') (k := k') h₀' rfl
  rw [h, h2] at h1
  have : (k' : ℝ) = k := mul_left_cancel₀ (by positivity) h1
  exact_mod_cast this.symm

end GTilde

/-! ### `ℝP¹`-circles, their lifted holonomy and the real angle -/

/-- A topological space **homeomorphic to the circle**. -/
def IsCircle (L : Type*) [TopologicalSpace L] : Prop := Nonempty (L ≃ₜ Circle)

/-- `E : ℝ → L` is a **periodic covering** of period `1`: a covering map with
`E s = E t ↔ t - s ∈ ℤ`. -/
structure IsPeriodicCover {L : Type*} [TopologicalSpace L] (E : ℝ → L) : Prop where
  isCoveringMap : IsCoveringMap E
  surjective : Function.Surjective E
  add_one : ∀ s, E (s + 1) = E s
  fiber : ∀ s t, E s = E t → ∃ n : ℤ, t = s + n

theorem isPeriodicCover_of_homeomorph {L : Type*} [TopologicalSpace L] (φ : L ≃ₜ Circle) :
    IsPeriodicCover (φ.symm ∘ RP1.proj) := by
  refine ⟨RP1.isCoveringMap_proj.homeomorph_comp φ.symm,
    φ.symm.surjective.comp RP1.proj_surjective, fun s => by
      simp only [Function.comp_apply, RP1.proj_add_one], fun s t h => ?_⟩
  obtain ⟨n, hn⟩ := RP1.proj_eq_proj_iff.1 (φ.symm.injective h)
  exact ⟨-n, by rw [hn]; push_cast; ring⟩

theorem exists_isPeriodicCover {L : Type*} [TopologicalSpace L] (hL : IsCircle L) :
    ∃ E : ℝ → L, IsPeriodicCover E := by
  obtain ⟨φ⟩ := hL
  exact ⟨_, isPeriodicCover_of_homeomorph φ⟩

theorem IsPeriodicCover.add_int {L : Type*} [TopologicalSpace L] {E : ℝ → L}
    (hE : IsPeriodicCover E) (s : ℝ) (n : ℤ) : E (s + n) = E s := by
  induction n using Int.induction_on generalizing s with
  | zero => simp
  | succ m ih =>
    have := hE.add_one (s + m)
    push_cast at this ih ⊢
    rw [← add_assoc, this, ih]
  | pred m ih =>
    have h1 := hE.add_one (s + (-(m : ℝ) - 1))
    have h2 := ih s
    push_cast at h1 h2 ⊢
    rw [show s + (-(m : ℝ) - 1) + 1 = s + -(m : ℝ) by ring, h2] at h1
    exact h1.symm

/-- **A continuous open map `ℝ → ℝ` is injective** (hence strictly monotone or antitone). -/
theorem injective_of_isOpenMap_real {f : ℝ → ℝ} (hc : Continuous f) (ho : IsOpenMap f) :
    Function.Injective f := by
  -- an open set contains points on both sides of each of its points
  have side : ∀ {U : Set ℝ}, IsOpen U → ∀ y ∈ U, (∃ ε > 0, y + ε ∈ U) ∧ ∃ ε > 0, y - ε ∈ U := by
    intro U hU y hy
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU y hy
    refine ⟨⟨ε / 2, by positivity, hball ?_⟩, ⟨ε / 2, by positivity, hball ?_⟩⟩ <;>
      rw [Metric.mem_ball, Real.dist_eq] <;> [rw [show y + ε / 2 - y = ε / 2 by ring];
        rw [show y - ε / 2 - y = -(ε / 2) by ring, abs_neg]] <;>
      rw [abs_of_pos (by positivity)] <;> linarith
  -- if `f a = f b` with `a < b`, `f` is constant on `[a, b]`
  have key : ∀ a b, a < b → f a = f b → False := by
    intro a b hab hfab
    have hcpt : IsCompact (Icc a b) := isCompact_Icc
    have hne : (Icc a b).Nonempty := nonempty_Icc.2 hab.le
    have hoI : IsOpen (f '' Ioo a b) := ho _ isOpen_Ioo
    obtain ⟨m, hm, hmax⟩ := hcpt.exists_isMaxOn hne hc.continuousOn
    obtain ⟨m', hm', hmin⟩ := hcpt.exists_isMinOn hne hc.continuousOn
    have hmax' : f m = f a := by
      by_cases hmI : m ∈ Ioo a b
      · obtain ⟨⟨ε, hε, hεU⟩, -⟩ := side hoI (f m) ⟨m, hmI, rfl⟩
        obtain ⟨x, hx, hxe⟩ := hεU
        have := hmax (Ioo_subset_Icc_self hx)
        simp only [mem_setOf_eq] at this
        linarith
      · rcases eq_or_lt_of_le hm.1 with h | h
        · rw [h]
        · rcases eq_or_lt_of_le hm.2 with h' | h'
          · rw [h', hfab]
          · exact absurd ⟨h, h'⟩ hmI
    have hmin' : f m' = f a := by
      by_cases hmI : m' ∈ Ioo a b
      · obtain ⟨-, ⟨ε, hε, hεU⟩⟩ := side hoI (f m') ⟨m', hmI, rfl⟩
        obtain ⟨x, hx, hxe⟩ := hεU
        have := hmin (Ioo_subset_Icc_self hx)
        simp only [mem_setOf_eq] at this
        linarith
      · rcases eq_or_lt_of_le hm'.1 with h | h
        · rw [h]
        · rcases eq_or_lt_of_le hm'.2 with h' | h'
          · rw [h', hfab]
          · exact absurd ⟨h, h'⟩ hmI
    have hconst : ∀ x ∈ Icc a b, f x = f a := fun x hx => le_antisymm
      (hmax' ▸ hmax hx) (hmin' ▸ hmin hx)
    have hmid : (a + b) / 2 ∈ Ioo a b := ⟨by linarith, by linarith⟩
    obtain ⟨⟨ε, hε, hεU⟩, -⟩ := side hoI (f ((a + b) / 2)) ⟨_, hmid, rfl⟩
    obtain ⟨x, hx, hxe⟩ := hεU
    rw [hconst x (Ioo_subset_Icc_self hx), hconst _ (Ioo_subset_Icc_self hmid)] at hxe
    linarith
  intro a b h
  rcases lt_trichotomy a b with hab | hab | hab
  · exact (key a b hab h).elim
  · exact hab
  · exact (key b a hab h.symm).elim

section RP1Circle

variable {L : Type*} [TopologicalSpace L] [ChartedSpace RP1 L]
  [HasGroupoid L (gxGroupoid PSL(2, ℝ) RP1)]

/-- `D : ℝ → ℝP¹` is **a developing map along** `E : ℝ → L`: near every `s`, `D` is a
`PSL(2,ℝ)`-translate of the chart of `L` at `E s`, read through `E`. (For a periodic covering this
is gx's developing map of the pulled-back structure on the universal cover `ℝ`,
`GX.isDevAlong_iff_isGXMorphism`.) -/
def IsDevAlong (E : ℝ → L) (D : ℝ → RP1) : Prop :=
  ∀ s, ∃ g : PSL(2, ℝ), ∀ᶠ s' in 𝓝 s, D s' = g • chartAt RP1 (E s) (E s')

/-- **The lifted holonomy of an `ℝP¹`-circle** (l.733–737): `f ∈ G̃` is the holonomy, lifted to
`ℝP̃¹`, of the generator `γ₀` of `π₁(L)` for the canonical orientation, i.e. there are a periodic
covering `E : ℝ → L` and a lift `D : ℝ → ℝP̃¹` of a developing map along `E`, **increasing** (the
canonical orientation, l.729–731), with `D (s + 1) = f (D s)`. Then `f x > x` at every point
`x = D s` of the image (`eq>`, `GX.lt_apply_of_strictMono`); `GX.HasLiftedHolonomy.lt_apply`
extracts one such point. -/
def HasLiftedHolonomy (L : Type*) [TopologicalSpace L] [ChartedSpace RP1 L] (f : GTilde) : Prop :=
  ∃ (E : ℝ → L) (D : ℝ → ℝ), IsPeriodicCover E ∧ Continuous D ∧ StrictMono D ∧
    IsDevAlong E (RP1.proj ∘ D) ∧ ∀ s, D (s + 1) = f (D s)

/-- Reading a developing map along `E` through a reparametrisation of `ℝ`. -/
theorem IsDevAlong.comp_continuous {E : ℝ → L} {D : ℝ → RP1} (hD : IsDevAlong E D) {ψ : ℝ → ℝ}
    (hψ : Continuous ψ) : IsDevAlong (E ∘ ψ) (D ∘ ψ) := fun s => by
  obtain ⟨g, hg⟩ := hD (ψ s)
  exact ⟨g, hψ.continuousAt.eventually hg⟩

/-- **Developing maps along `E` are gx's developing maps** of the structure pulled back to `ℝ`. -/
theorem isDevAlong_iff_isGXMorphism {E : ℝ → L} (hE : IsLocalHomeomorph E) {D : ℝ → RP1} :
    IsDevAlong E D ↔
      letI := pullbackChartedSpace (X := RP1) hE
      IsGXMorphism PSL(2, ℝ) RP1 D := by
  letI := pullbackChartedSpace (X := RP1) hE
  show _ ↔ IsGXMorphism PSL(2, ℝ) RP1 D
  have hch : ∀ s s', chartAt RP1 s s' = chartAt RP1 (E s) (E s') := pullback_chartAt_apply hE
  constructor
  · intro h
    refine isGXMorphism_of_eventually fun s => ?_
    obtain ⟨g, hg⟩ := h s
    exact ⟨g, by filter_upwards [hg] with s' hs' using by rw [hs', hch]⟩
  · intro h s
    obtain ⟨g, hg⟩ := (isGXMorphism_iff_model.1 h).2 s
    exact ⟨g, by filter_upwards [hg] with s' hs' using by rw [hs', hch]⟩

/-- Two developing maps along a local homeomorphism `E` differ by a unique element of `PSL(2,ℝ)`. -/
theorem IsDevAlong.exists_eq_smul {E : ℝ → L} (hE : IsLocalHomeomorph E) {D D' : ℝ → RP1}
    (hD : IsDevAlong E D) (hD' : IsDevAlong E D') : ∃ g : PSL(2, ℝ), ∀ s, D' s = g • D s := by
  letI := pullbackChartedSpace (X := RP1) hE
  haveI : HasGroupoid ℝ (gxGroupoid PSL(2, ℝ) RP1) := hasGroupoid_pullback hE
  exact (developing_unique_of_preconnected ((isDevAlong_iff_isGXMorphism hE).1 hD)
    ((isDevAlong_iff_isGXMorphism hE).1 hD')).exists

theorem IsDevAlong.isLocalHomeomorph {E : ℝ → L} (hE : IsLocalHomeomorph E) {D : ℝ → RP1}
    (hD : IsDevAlong E D) : IsLocalHomeomorph D := by
  letI := pullbackChartedSpace (X := RP1) hE
  exact ((isDevAlong_iff_isGXMorphism hE).1 hD).isLocalHomeomorph

/-- A lift to `ℝP̃¹` of a developing map along `E` is a local homeomorphism, hence injective. -/
theorem IsDevAlong.isLocalHomeomorph_lift {E : ℝ → L} (hE : IsLocalHomeomorph E) {D : ℝ → ℝ}
    (hDc : Continuous D) (hD : IsDevAlong E (RP1.proj ∘ D)) : IsLocalHomeomorph D :=
  IsLocalHomeomorph.of_comp (hD.isLocalHomeomorph hE) RP1.isLocalHomeomorph_proj hDc

/-- (`eq>`, l.735–737) along the image: for the witnesses `D` of `GX.HasLiftedHolonomy`,
`f x > x` at every `x = D s`. -/
theorem lt_apply_of_strictMono {f : GTilde} {D : ℝ → ℝ} (hD : StrictMono D)
    (hDf : ∀ s, D (s + 1) = f (D s)) (s : ℝ) : D s < f (D s) := by
  rw [← hDf]; exact hD (lt_add_one s)

theorem HasLiftedHolonomy.lt_apply {f : GTilde} (hf : HasLiftedHolonomy L f) :
    ∃ x, x < f x := by
  obtain ⟨E, D, -, -, hD, -, hDf⟩ := hf
  exact ⟨D 0, by rw [← hDf, zero_add]; exact hD zero_lt_one⟩

/-- **Existence of the lifted holonomy** for every `ℝP¹`-circle. -/
theorem exists_hasLiftedHolonomy (hL : IsCircle L) : ∃ f : GTilde, HasLiftedHolonomy L f := by
  obtain ⟨E, hE⟩ := exists_isPeriodicCover hL
  have hEl := hE.isCoveringMap.isLocalHomeomorph
  -- a developing map on the universal cover `ℝ`
  obtain ⟨D, hD⟩ : ∃ D : ℝ → RP1, IsDevAlong E D := by
    letI := pullbackChartedSpace (X := RP1) hEl
    haveI : HasGroupoid ℝ (gxGroupoid PSL(2, ℝ) RP1) := hasGroupoid_pullback hEl
    obtain ⟨D, hD⟩ := exists_developingMap (G := PSL(2, ℝ)) (X := RP1) (N := ℝ)
    exact ⟨D, (isDevAlong_iff_isGXMorphism hEl).2 hD⟩
  -- its holonomy
  have hD1 : IsDevAlong E fun s => D (s + 1) := by
    have := hD.comp_continuous (continuous_add_const (1 : ℝ))
    have hE1 : (E ∘ fun s : ℝ => s + 1) = E := funext fun s => hE.add_one s
    rw [hE1] at this
    exact this
  obtain ⟨ρ, hρ⟩ := hD.exists_eq_smul hEl hD1
  -- lift to `ℝP̃¹`
  obtain ⟨Dt, hDt0⟩ := RP1.exists_lift ⟨D, (hD.isLocalHomeomorph hEl).continuous⟩
  have hDt : ∀ t, RP1.proj (Dt t) = D t := fun t => hDt0 t
  have hDt' : RP1.proj ∘ Dt = D := funext hDt
  have hDtD : IsDevAlong E (RP1.proj ∘ Dt) := by rw [hDt']; exact hD
  have hinj : Function.Injective Dt := injective_of_isOpenMap_real Dt.continuous
    (hDtD.isLocalHomeomorph_lift hEl Dt.continuous).isOpenMap
  obtain ⟨ρt, hρt⟩ := GTilde.toPSL_surjective ρ
  -- `Dt (s + 1)` and `ρt (Dt s)` both lift `D (s + 1)`
  obtain ⟨n, hn⟩ := RP1.proj_eq_proj_iff.1 (show RP1.proj (Dt (0 + 1)) = RP1.proj (ρt (Dt 0)) by
    rw [hDt, hρ, GTilde.proj_apply, hρt, hDt])
  have hlift := RP1.isCoveringMap_proj.eq_of_comp_eq (g₁ := fun s => Dt (s + 1))
    (g₂ := fun s => ρt (Dt s) + n) (Dt.continuous.comp (continuous_id.add continuous_const))
    ((GTilde.continuous ρt).comp Dt.continuous |>.add continuous_const)
    (funext fun s => by
      simp only [Function.comp_apply, RP1.proj_add_int]
      rw [hDt, hρ, GTilde.proj_apply, hρt, hDt]) 0 hn
  set f : GTilde := GTilde.delta ^ n * ρt
  have hf : ∀ s, Dt (s + 1) = f (Dt s) := fun s => by
    rw [GTilde.coe_mul_apply, GTilde.delta_zpow_apply]
    exact congrFun hlift s
  rcases Dt.continuous.strictMono_of_inj hinj with hmono | hanti
  · exact ⟨f, E, Dt, hE, Dt.continuous, hmono, hDtD, hf⟩
  · -- reverse the orientation of the parameter
    refine ⟨f⁻¹, E ∘ Neg.neg, Dt ∘ Neg.neg, ⟨hE.isCoveringMap.comp_homeomorph (Homeomorph.neg ℝ),
      hE.surjective.comp neg_surjective, fun s => ?_, fun s t hst => ?_⟩,
      Dt.continuous.comp continuous_neg, hanti.comp (fun _ _ h => neg_lt_neg h),
      hDtD.comp_continuous continuous_neg, fun s => ?_⟩
    · simp only [Function.comp_apply]
      rw [← hE.add_one (-(s + 1)), show -(s + 1) + 1 = -s by ring]
    · obtain ⟨m, hm⟩ := hE.fiber _ _ hst
      exact ⟨-m, by push_cast; linarith⟩
    · simp only [Function.comp_apply]
      rw [show -s = -(s + 1) + 1 by ring, hf, GTilde.inv_apply_apply]

/-- **Uniqueness of the lifted holonomy up to conjugacy in `G̃`.** -/
theorem HasLiftedHolonomy.conj {f f' : GTilde} (hf : HasLiftedHolonomy L f)
    (hf' : HasLiftedHolonomy L f') : ∃ h : GTilde, f' = h * f * h⁻¹ := by
  obtain ⟨E₁, D₁, hE₁, hD₁c, hD₁m, hD₁, hf₁⟩ := hf
  obtain ⟨E₂, D₂, hE₂, hD₂c, hD₂m, hD₂, hf₂⟩ := hf'
  have hE₂l := hE₂.isCoveringMap.isLocalHomeomorph
  -- 1. `E₂ = E₁ ∘ ψ`
  obtain ⟨e₀, he₀⟩ := hE₁.surjective (E₂ 0)
  obtain ⟨ψ, ⟨-, hψ0⟩, -⟩ := hE₁.isCoveringMap.existsUnique_continuousMap_lifts
    ⟨E₂, hE₂.isCoveringMap.continuous⟩ 0 e₀ he₀
  have hψ : ∀ s, E₁ (ψ s) = E₂ s := fun s => congrFun hψ0 s
  -- 2. `ψ (s + 1) = ψ s + ε`
  obtain ⟨ε, hε⟩ := hE₁.fiber (ψ 0) (ψ (0 + 1)) (by rw [hψ, hψ, hE₂.add_one])
  have hψ1 : ∀ s, ψ (s + 1) = ψ s + ε := fun s => congrFun
    (hE₁.isCoveringMap.eq_of_comp_eq (g₁ := fun s => ψ (s + 1)) (g₂ := fun s => ψ s + ε)
      (ψ.continuous.comp (continuous_add_const 1)) (ψ.continuous.add continuous_const)
      (funext fun s => by
        simp only [Function.comp_apply]
        rw [hψ, hE₁.add_int, hψ, hE₂.add_one]) 0 hε) s
  -- 3. `D₁ ∘ ψ` is a developing map along `E₂`
  have hD₁ψ : IsDevAlong E₂ (RP1.proj ∘ (D₁ ∘ ψ)) := by
    have := hD₁.comp_continuous ψ.continuous
    have hE : E₁ ∘ ψ = E₂ := funext hψ
    rw [hE] at this
    exact this
  -- 4. `D₂ = h ∘ D₁ ∘ ψ` for some `h ∈ G̃`
  obtain ⟨g, hg⟩ := hD₁ψ.exists_eq_smul hE₂l hD₂
  obtain ⟨h₀, hh₀⟩ := GTilde.toPSL_surjective g
  have hg' : ∀ s, RP1.proj (D₂ s) = RP1.proj (h₀ (D₁ (ψ s))) := fun s => by
    rw [GTilde.proj_apply, hh₀]; exact hg s
  obtain ⟨n, hn⟩ := RP1.proj_eq_proj_iff.1 (hg' 0)
  have hD₂eq : ∀ s, D₂ s = h₀ (D₁ (ψ s)) + n := fun s => congrFun
    (RP1.isCoveringMap_proj.eq_of_comp_eq (g₁ := D₂) (g₂ := fun s => h₀ (D₁ (ψ s)) + n) hD₂c
      (((GTilde.continuous h₀).comp (hD₁c.comp ψ.continuous)).add continuous_const)
      (funext fun s => by
        simp only [Function.comp_apply, RP1.proj_add_int]
        exact hg' s) 0 hn) s
  set h : GTilde := GTilde.delta ^ n * h₀ with hh
  have hD₂h : ∀ s, D₂ s = h (D₁ (ψ s)) := fun s => by
    rw [hD₂eq, hh, GTilde.coe_mul_apply, GTilde.delta_zpow_apply]
  -- 5. `ψ` is increasing
  have hψm : StrictMono ψ := by
    intro s t hst
    by_contra hle
    have hle' := not_lt.1 hle
    have h1 := hD₂m hst
    rw [hD₂h, hD₂h] at h1
    exact absurd h1 (not_lt.2 ((GTilde.strictMono h).monotone (hD₁m.monotone hle')))
  -- 6. `ε = 1`
  have hε1 : ε = 1 := by
    have h01 : ψ 1 = ψ 0 + ε := by simpa using hψ1 0
    have hpos : (0 : ℝ) < ε := by have := hψm zero_lt_one; linarith
    have hge : (1 : ℤ) ≤ ε := by exact_mod_cast hpos
    by_contra hne
    have h2 : (2 : ℝ) ≤ ε := by exact_mod_cast (show (2 : ℤ) ≤ ε by omega)
    obtain ⟨t, ht, hψt⟩ := intermediate_value_Icc zero_le_one ψ.continuous.continuousOn
      (show ψ 0 + 1 ∈ Icc (ψ 0) (ψ 1) from ⟨by linarith, by linarith⟩)
    have hEt : E₂ 0 = E₂ t := by
      rw [← hψ, ← hψ, hψt, show ψ 0 + 1 = ψ 0 + ((1 : ℤ) : ℝ) by simp, hE₁.add_int]
    obtain ⟨m, hm⟩ := hE₂.fiber 0 t hEt
    rw [zero_add] at hm
    have hm0 : (0 : ℝ) ≤ m := hm ▸ ht.1
    have hm1 : (m : ℝ) ≤ 1 := hm ▸ ht.2
    have hm0' : (0 : ℤ) ≤ m := by exact_mod_cast hm0
    have hm1' : m ≤ (1 : ℤ) := by exact_mod_cast hm1
    rcases (show m = 0 ∨ m = 1 by omega) with rfl | rfl
    · rw [hm, Int.cast_zero] at hψt; linarith
    · rw [hm, Int.cast_one, h01] at hψt; linarith
  -- 7. `f' = h f h⁻¹` on the image of `D₂`, an open interval
  have hopen : IsOpen (range D₂) := (hD₂.isLocalHomeomorph_lift hE₂l hD₂c).isOpenMap.isOpen_range
  refine ⟨h, GTilde.eq_of_eqOn hopen (range_nonempty D₂) ?_⟩
  rintro _ ⟨s, rfl⟩
  show f' (D₂ s) = (h * f * h⁻¹) (D₂ s)
  rw [← hf₂, hD₂h, hψ1, hε1, Int.cast_one, hf₁, hD₂h, GTilde.coe_mul_apply,
    GTilde.coe_mul_apply, GTilde.inv_apply_apply]
  rfl

/-- `θ` is **the real angle** of the `ℝP¹`-circle `L` (l.742–744): the real angle
`2π τ(f)` of its lifted holonomy. For an elliptic circle it is the angle; for a parabolic or
hyperbolic circle of degree `k` it is `2πk` (`GX.GTilde.angle_eq_of_delta_zpow_mul`). -/
def HasRealAngle (L : Type*) [TopologicalSpace L] [ChartedSpace RP1 L] (θ : ℝ) : Prop :=
  ∃ f : GTilde, HasLiftedHolonomy L f ∧ θ = GTilde.angle f

theorem HasRealAngle.unique {θ θ' : ℝ} (h : HasRealAngle L θ) (h' : HasRealAngle L θ') :
    θ = θ' := by
  obtain ⟨f, hf, rfl⟩ := h
  obtain ⟨f', hf', rfl⟩ := h'
  obtain ⟨k, rfl⟩ := hf.conj hf'
  exact (GTilde.angle_conj f k).symm

/-- **The degree is non-negative** (l.739–740): if the lifted holonomy is `δᵏ f₀` with `f₀`
having a fixed point in `ℝP̃¹`, then `k ≥ 0`. -/
theorem HasLiftedHolonomy.deg_nonneg {f f₀ : GTilde} {k : ℤ} (hf : HasLiftedHolonomy L f)
    (hf₀ : ∃ x, f₀ x = x) (h : f = GTilde.delta ^ k * f₀) : 0 ≤ k := by
  obtain ⟨x₀, hx₀⟩ := hf.lt_apply
  by_contra hk
  have hk' : k ≤ -1 := by omega
  obtain ⟨x, hx⟩ := hf₀
  -- `f₀` has a fixed point, so `f₀ y < y + 1` and `f y < y + 1 + k ≤ y`
  have hτ : CircleDeg1Lift.translationNumber ((f₀ : CircleDeg1Liftˣ) : CircleDeg1Lift) = 0 := by
    have := CircleDeg1Lift.translationNumber_of_eq_add_int
      (f := ((f₀ : CircleDeg1Liftˣ) : CircleDeg1Lift)) (x := x) (m := 0)
      (by rw [Int.cast_zero, add_zero]; exact hx)
    rw [this, Int.cast_zero]
  have hlt : ∀ y, f₀ y < y + 1 := fun y => by
    have := CircleDeg1Lift.map_lt_of_translationNumber_lt_int
      ((f₀ : CircleDeg1Liftˣ) : CircleDeg1Lift) (n := 1) (by rw [hτ]; norm_num) y
    simpa using this
  have := hlt x₀
  rw [h, GTilde.coe_mul_apply, GTilde.delta_zpow_apply] at hx₀
  have hk'' : (k : ℝ) ≤ -1 := by exact_mod_cast hk'
  linarith

theorem exists_hasRealAngle (hL : IsCircle L) : ∃ θ, HasRealAngle L θ := by
  obtain ⟨f, hf⟩ := exists_hasLiftedHolonomy hL
  exact ⟨_, f, hf, rfl⟩

/-- The real angle is non-negative (as the degree is, l.740); it is positive when the holonomy
is elliptic or central (`GX.HasRealAngle.pos_of_isElliptic`). -/
theorem HasRealAngle.nonneg {θ : ℝ} (h : HasRealAngle L θ) : 0 ≤ θ := by
  obtain ⟨f, hf, rfl⟩ := h
  obtain ⟨x₀, hx₀⟩ := hf.lt_apply
  by_cases hfix : ∃ x, f x = x
  · obtain ⟨x, hx⟩ := hfix
    rw [GTilde.angle_eq_zero_of_fixed hx]
  · push Not at hfix
    exact (GTilde.angle_pos_of_forall_ne hfix hx₀).le

theorem HasRealAngle.pos_of_isElliptic {θ : ℝ} {f : GTilde} (hf : HasLiftedHolonomy L f)
    (he : GTilde.IsElliptic f ∨ GTilde.toPSL f = 1) (hθ : θ = GTilde.angle f) : 0 < θ := by
  obtain ⟨x₀, hx₀⟩ := hf.lt_apply
  rw [hθ]
  refine GTilde.angle_pos_of_forall_ne (fun x hx => ?_) hx₀
  rcases he with he | he
  · exact PSL2.IsElliptic.smul_ne he (RP1.proj x) (by rw [← GTilde.proj_apply, hx])
  · have hk : f ∈ GTilde.toPSL.ker := he
    rw [GTilde.ker_toPSL, Subgroup.mem_zpowers_iff] at hk
    obtain ⟨n, rfl⟩ := hk
    rw [GTilde.delta_zpow_apply] at hx hx₀
    have hn : (n : ℝ) = 0 := by linarith
    rw [hn] at hx₀
    linarith

end RP1Circle

/-- **`ℝP¹` itself is an `ℝP¹`-circle of real angle `2π`**, of lifted holonomy `δ` (l.693–694:
the elliptic circles include "the usual real projective structure on `ℝP¹`"). -/
theorem isPeriodicCover_proj : IsPeriodicCover RP1.proj :=
  ⟨RP1.isCoveringMap_proj, RP1.proj_surjective, RP1.proj_add_one, fun s t h => by
    obtain ⟨n, hn⟩ := RP1.proj_eq_proj_iff.1 h
    exact ⟨-n, by rw [hn]; push_cast; ring⟩⟩

theorem hasLiftedHolonomy_rp1 : HasLiftedHolonomy RP1 GTilde.delta := by
  refine ⟨RP1.proj, id, isPeriodicCover_proj, continuous_id, strictMono_id, fun s => ⟨1,
    Eventually.of_forall fun s' => ?_⟩, fun s => (GTilde.delta_apply s).symm⟩
  rw [chartAt_self_eq, OpenPartialHomeomorph.refl_apply, one_smul]
  rfl

theorem hasRealAngle_rp1 : HasRealAngle RP1 (2 * π) :=
  ⟨_, hasLiftedHolonomy_rp1, GTilde.angle_delta.symm⟩

/-! ### `(Γ_p, ℓ(p))`-circles -/

section GammaLink

variable (p : HS 2)

instance isClosed_span_hs (p : HS 2) :
    IsClosed ((ℝ ∙ (p : Causal.Minkowski 2) : Submodule ℝ (Causal.Minkowski 2)) :
      Set (Causal.Minkowski 2)) :=
  Submodule.closed_of_finiteDimensional _

/-- **`T_p HS² = ℝ^{1,2} / ℝ p`**, the tangent plane of `HS²` at the ray `p` (l.762). -/
abbrev TpHS : Type := Causal.Minkowski 2 ⧸ (ℝ ∙ (p : Causal.Minkowski 2))

/-- **`ℓ(p)`, the link of `p`**: the space of rays in `T_p HS²` (l.762). -/
abbrev Link : Type := RaySphere (TpHS p)

/-- **`Γ_p`, the pointwise stabiliser of `p`** in `SO₀(1,2)` (l.763–764): the elements fixing the
vector `p`, i.e. every point of the ray `p` (`GX.mem_gammaP_iff_ray`). -/
def GammaP : Subgroup (Causal.Flat.lorentz 2) where
  carrier := {A | (A : Causal.Minkowski 2 ≃ₗ[ℝ] Causal.Minkowski 2) p = p}
  one_mem' := rfl
  mul_mem' {A B} hA hB := by
    show (A : Causal.Minkowski 2 ≃ₗ[ℝ] Causal.Minkowski 2)
      ((B : Causal.Minkowski 2 ≃ₗ[ℝ] Causal.Minkowski 2) p) = p
    rw [show (B : Causal.Minkowski 2 ≃ₗ[ℝ] Causal.Minkowski 2) p = p from hB]
    exact hA
  inv_mem' {A} hA := by
    show (A : Causal.Minkowski 2 ≃ₗ[ℝ] Causal.Minkowski 2).symm p = p
    rw [LinearEquiv.symm_apply_eq]
    exact hA.symm

theorem mem_gammaP_iff_ray {A : Causal.Flat.lorentz 2} :
    A ∈ GammaP p ↔ ∀ c : ℝ, 0 < c →
      (A : Causal.Minkowski 2 ≃ₗ[ℝ] Causal.Minkowski 2) (c • (p : Causal.Minkowski 2)) =
        c • (p : Causal.Minkowski 2) := by
  constructor
  · intro hA c _
    rw [map_smul]
    exact congrArg (c • ·) hA
  · intro h
    have h1 := h 1 one_pos
    simp only [one_smul] at h1
    exact h1

/-- The tangent action of `A ∈ Γ_p` on `T_p HS² = ℝ^{1,2}/ℝp`. -/
def GammaP.tangent {p : HS 2} (A : GammaP p) : TpHS p ≃ₗ[ℝ] TpHS p :=
  Submodule.Quotient.equiv _ _ (A : Causal.Flat.lorentz 2).1 (by
    rw [Submodule.map_span, Set.image_singleton]
    congr 2
    exact A.2)

theorem GammaP.tangent_mk {p : HS 2} (A : GammaP p) (v : Causal.Minkowski 2) :
    GammaP.tangent A (Submodule.Quotient.mk v) =
      Submodule.Quotient.mk ((A : Causal.Flat.lorentz 2).1 v) := rfl

theorem GammaP.tangent_one {p : HS 2} : GammaP.tangent (1 : GammaP p) = 1 := by
  refine LinearEquiv.ext fun x => ?_
  induction x using Submodule.Quotient.induction_on with
  | H v => rfl

theorem GammaP.tangent_mul {p : HS 2} (A B : GammaP p) :
    GammaP.tangent (A * B) = GammaP.tangent A * GammaP.tangent B := by
  refine LinearEquiv.ext fun x => ?_
  induction x using Submodule.Quotient.induction_on with
  | H v => rfl

/-- **`Γ_p` acts on `ℓ(p)`.** -/
instance : MulAction (GammaP p) (Link p) where
  smul A σ := linRaySmul (GammaP.tangent A) σ
  one_smul σ := by
    show linRaySmul (GammaP.tangent 1) σ = σ
    rw [GammaP.tangent_one]; exact linRaySmul_one σ
  mul_smul A B σ := by
    show linRaySmul (GammaP.tangent (A * B)) σ = linRaySmul (GammaP.tangent A)
      (linRaySmul (GammaP.tangent B) σ)
    rw [GammaP.tangent_mul, linRaySmul_mul]

theorem gammaP_smul_def (A : GammaP p) (σ : Link p) : A • σ = linRaySmul (GammaP.tangent A) σ :=
  rfl

instance : ContinuousConstSMul (GammaP p) (Link p) :=
  ⟨fun A => continuous_linRaySmul (GammaP.tangent A)⟩

theorem finrank_tpHS : Module.finrank ℝ (TpHS p) = 2 := by
  have h := (ℝ ∙ (p : Causal.Minkowski 2)).finrank_quotient_add_finrank
  rw [finrank_span_singleton (raySphere_ne_zero p), Module.finrank_prod, Module.finrank_self,
    finrank_euclideanSpace_fin] at h
  show Module.finrank ℝ (Causal.Minkowski 2 ⧸ ℝ ∙ (p : Causal.Minkowski 2)) = 2
  omega

/-- An identification of `T_p HS²` with `ℂ = ℝ²`. -/
def tpHSEquiv : TpHS p ≃ₗ[ℝ] ℂ :=
  LinearEquiv.ofFinrankEq _ _ (by rw [finrank_tpHS, Complex.finrank_real_complex])

/-- The unit sphere of `ℂ` is the circle. -/
def raySphereComplexHomeomorph : RaySphere ℂ ≃ₜ Circle where
  toFun σ := ⟨σ.1, σ.2⟩
  invFun z := ⟨z.1, z.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  continuous_toFun := RP1.isInducing_coe.continuous_iff.2 continuous_subtype_val
  continuous_invFun := RP1.continuous_coe.subtype_mk _

/-- **`ℓ(p)` is a circle.** -/
theorem isCircle_link : IsCircle (Link p) :=
  ⟨(raySphereHomeomorph (tpHSEquiv p)).trans raySphereComplexHomeomorph⟩

/-- **`bbsdef:circle_data_point_structure`** (`colI_v1.tex:766`): **a `(Γ_p, ℓ(p))`-circle** is the
data of a point `p ∈ HS²` and of a `(Γ_p, ℓ(p))`-structure on the circle: a space `L` homeomorphic
to the circle with a `(Γ_p, ℓ(p))`-structure in gx's sense (an atlas of charts into `ℓ(p)` whose
changes are locally the action of elements of `Γ_p`, read through its maximal atlas, DEC-16). -/
structure GammaLinkCircle (L : Type*) [TopologicalSpace L] where
  /-- the point `p ∈ HS²` -/
  pt : HS 2
  /-- the charts, into `ℓ(p)` -/
  atlas : ChartedSpace (Link pt) L
  /-- the chart changes lie in the `(Γ_p, ℓ(p))`-groupoid -/
  hasGroupoid : @HasGroupoid (Link pt) _ L _ atlas (gxGroupoid (GammaP pt) (Link pt))
  /-- `L` is the circle -/
  isCircle : IsCircle L

/-- `ℓ(p)` itself is a `(Γ_p, ℓ(p))`-circle (the link of a regular point). -/
def GammaLinkCircle.regular : GammaLinkCircle (Link p) where
  pt := p
  atlas := chartedSpaceSelf (Link p)
  hasGroupoid := hasGroupoid_model_space _ _
  isCircle := isCircle_link p

end GammaLink

/-! ### The natural `ℝP¹`-structure of `ℓ(p)` and of every `(Γ_p, ℓ(p))`-circle -/

section ChangeOfModel

variable {G H X Y M : Type*} [Group G] [Group H] [TopologicalSpace X] [TopologicalSpace Y]
  [TopologicalSpace M] [MulAction G X] [MulAction H Y] [ContinuousConstSMul G X]
  [ContinuousConstSMul H Y]

/-- **Change of model along an equivariant map**: if the charts `c, c'` into `Y` are the maps
`q, q'`, and `q' (g • x) = φ g • q x`, then a `(G, X)`-chart change `e⁻¹ ≫ e'` gives an
`(H, Y)`-chart change `(e ≫ c)⁻¹ ≫ (e' ≫ c')`. -/
theorem trans_symm_trans_mem_gxGroupoid {e e' : OpenPartialHomeomorph M X}
    (he : e.symm.trans e' ∈ gxGroupoid G X) {c c' : OpenPartialHomeomorph X Y} {q q' : X → Y}
    (hc : ⇑c = q) (hc' : ⇑c' = q') (φ : G → H) (hq : ∀ (g : G) (x : X), q' (g • x) = φ g • q x) :
    (e.trans c).symm.trans (e'.trans c') ∈ gxGroupoid H Y := by
  refine symm_trans_mem_gxGroupoid fun x hx => ?_
  have hx1 : x ∈ e.source := hx.1.1
  have hx2 : x ∈ e'.source := hx.2.1
  obtain ⟨g, hg⟩ : ∃ g : G, ∀ᶠ z in 𝓝 x, e' z = g • e z :=
    (symm_trans_mem_gxGroupoid_iff.1 he) x ⟨hx1, hx2⟩
  refine ⟨φ g, ?_⟩
  filter_upwards [hg] with z hz
  rw [OpenPartialHomeomorph.coe_trans, OpenPartialHomeomorph.coe_trans, Function.comp_apply,
    Function.comp_apply, hz, hc', hc, hq]

/-- The `(H, Y)`-structure induced on a `(G, X)`-manifold by an equivariant map `q : X → Y` all of
whose charts are `q` (e.g. a pulled-back structure). -/
theorem hasGroupoid_comp_of_equivariant [ChartedSpace X M] [HasGroupoid M (gxGroupoid G X)]
    [ChartedSpace Y X] {q : X → Y} (hqc : ∀ c ∈ atlas Y X, ⇑c = q) (φ : G → H)
    (hq : ∀ (g : G) (x : X), q (g • x) = φ g • q x) :
    @HasGroupoid Y _ M _ (ChartedSpace.comp Y X M) (gxGroupoid H Y) := by
  refine @HasGroupoid.mk Y _ M _ (ChartedSpace.comp Y X M) (gxGroupoid H Y) ?_
  rintro _ _ ⟨e, he, c, hc, rfl⟩ ⟨e', he', c', hc', rfl⟩
  exact trans_symm_trans_mem_gxGroupoid (HasGroupoid.compatible he he') (hqc c hc) (hqc c' hc')
    φ hq

end ChangeOfModel

section NaturalRP1

variable (p : HS 2)

/-- The volume form of `ℝ^{1,2}` in the coordinates `(t, x₀, x₁)`. -/
def vol3 (u v w : Causal.Minkowski 2) : ℝ :=
  Matrix.det !![u.1, u.2 0, u.2 1; v.1, v.2 0, v.2 1; w.1, w.2 0, w.2 1]

/-- **An oriented identification `T_p HS² ≃ ℂ`** (l.770, "since `HS²` is oriented"): for lifts
`w₁, w₂ ∈ ℝ^{1,2}` of `θ⁻¹ 1, θ⁻¹ i`, the basis `(p, w₁, w₂)` is direct. (The orientation of `HS²`
is the one of the unit sphere of `ℝ^{1,2}`, outward normal first; the lifts are immaterial.) -/
def IsOrientedTangent (θ : TpHS p ≃ₗ[ℝ] ℂ) : Prop :=
  ∀ w₁ w₂ : Causal.Minkowski 2, (Submodule.Quotient.mk w₁ : TpHS p) = θ.symm 1 →
    (Submodule.Quotient.mk w₂ : TpHS p) = θ.symm Complex.I → 0 < vol3 p w₁ w₂

theorem vol3_lin (u v w : Causal.Minkowski 2) (α β γ δ : ℝ) :
    vol3 u (α • v + β • w) (γ • v + δ • w) = (α * δ - β * γ) * vol3 u v w := by
  simp only [vol3, Matrix.det_fin_three, Prod.fst_add, Prod.snd_add, Prod.smul_fst,
    Prod.smul_snd, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, Matrix.of_apply,
    Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.tail_cons,
    Matrix.head_fin_const]
  ring

theorem vol3_add_smul (u v w : Causal.Minkowski 2) (a b : ℝ) :
    vol3 u (v + a • u) (w + b • u) = vol3 u v w := by
  simp only [vol3, Matrix.det_fin_three, Prod.fst_add, Prod.snd_add, Prod.smul_fst,
    Prod.smul_snd, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, Matrix.of_apply,
    Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.tail_cons,
    Matrix.head_fin_const]
  ring

/-- `vol3 p w₁ w₂` depends only on the classes of `w₁, w₂` modulo `ℝ p`. -/
theorem vol3_eq_of_mk_eq {w₁ w₂ w₁' w₂' : Causal.Minkowski 2}
    (h₁ : (Submodule.Quotient.mk w₁' : TpHS p) = Submodule.Quotient.mk w₁)
    (h₂ : (Submodule.Quotient.mk w₂' : TpHS p) = Submodule.Quotient.mk w₂) :
    vol3 p w₁' w₂' = vol3 p w₁ w₂ := by
  rw [Submodule.Quotient.eq] at h₁ h₂
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.1 h₁
  obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.1 h₂
  rw [show w₁' = w₁ + a • (p : Causal.Minkowski 2) by rw [ha]; abel,
    show w₂' = w₂ + b • (p : Causal.Minkowski 2) by rw [hb]; abel, vol3_add_smul]

/-- `(p, w₁, w₂)` is a basis when `w₁, w₂` lift a basis of `T_p HS²`. -/
theorem vol3_ne_zero (θ : TpHS p ≃ₗ[ℝ] ℂ) {w₁ w₂ : Causal.Minkowski 2}
    (h₁ : (Submodule.Quotient.mk w₁ : TpHS p) = θ.symm 1)
    (h₂ : (Submodule.Quotient.mk w₂ : TpHS p) = θ.symm Complex.I) : vol3 p w₁ w₂ ≠ 0 := by
  intro h0
  obtain ⟨v, hv, hvM⟩ := Matrix.exists_vecMul_eq_zero_iff.2 h0
  have e0 := congrFun hvM 0
  have e1 := congrFun hvM 1
  have e2 := congrFun hvM 2
  simp [Matrix.vecMul, dotProduct, Fin.sum_univ_three] at e0 e1 e2
  -- the linear relation `v₀ p + v₁ w₁ + v₂ w₂ = 0`
  have hrel : v 0 • (p : Causal.Minkowski 2) + v 1 • w₁ + v 2 • w₂ = 0 := by
    refine Prod.ext ?_ ?_
    · simp only [Prod.fst_add, Prod.smul_fst, smul_eq_mul, Prod.fst_zero]; linarith
    · ext i
      fin_cases i
      · simp only [Fin.zero_eta, Fin.isValue, Prod.snd_add, Prod.smul_snd, PiLp.add_apply,
          PiLp.smul_apply, smul_eq_mul, Prod.snd_zero, PiLp.zero_apply]
        linarith
      · simp only [Fin.mk_one, Fin.isValue, Prod.snd_add, Prod.smul_snd, PiLp.add_apply,
          PiLp.smul_apply, smul_eq_mul, Prod.snd_zero, PiLp.zero_apply]
        linarith
  -- modulo `p`: `θ⁻¹ (v₁ + v₂ i) = 0`
  have hq := congrArg (fun x => θ (Submodule.Quotient.mk x : TpHS p)) hrel
  simp only [Submodule.Quotient.mk_add, Submodule.Quotient.mk_smul, map_add, map_smul, h₁, h₂,
    LinearEquiv.apply_symm_apply, Submodule.Quotient.mk_zero, map_zero] at hq
  have hp0 : (Submodule.Quotient.mk (p : Causal.Minkowski 2) : TpHS p) = 0 :=
    (Submodule.Quotient.mk_eq_zero _).2 (Submodule.mem_span_singleton_self _)
  rw [hp0, map_zero, smul_zero, zero_add] at hq
  have hv1 : v 1 = 0 := by simpa using congrArg Complex.re hq
  have hv2 : v 2 = 0 := by simpa using congrArg Complex.im hq
  rw [hv1, hv2, zero_smul, zero_smul, add_zero, add_zero, smul_eq_zero] at hrel
  have hv0 : v 0 = 0 := hrel.resolve_right (raySphere_ne_zero p)
  apply hv
  ext i
  fin_cases i <;> simp [hv0, hv1, hv2]

theorem exists_isOrientedTangent : ∃ θ : TpHS p ≃ₗ[ℝ] ℂ, IsOrientedTangent p θ := by
  set θ₀ := tpHSEquiv p
  obtain ⟨w₁, hw₁⟩ := Submodule.Quotient.mk_surjective _ (θ₀.symm 1)
  obtain ⟨w₂, hw₂⟩ := Submodule.Quotient.mk_surjective _ (θ₀.symm Complex.I)
  rcases lt_or_gt_of_ne (vol3_ne_zero p θ₀ hw₁ hw₂) with hneg | hpos
  · -- reverse the orientation by complex conjugation
    refine ⟨θ₀.trans Complex.conjAe.toLinearEquiv, fun w₁' w₂' h1 h2 => ?_⟩
    have hc1 : (θ₀.trans Complex.conjAe.toLinearEquiv).symm 1 = θ₀.symm 1 := by
      simp [LinearEquiv.trans_symm]
    have hcI : (θ₀.trans Complex.conjAe.toLinearEquiv).symm Complex.I = θ₀.symm (-Complex.I) := by
      have hI : Complex.conjAe.symm Complex.I = -Complex.I := by
        apply Complex.conjAe.injective
        rw [AlgEquiv.apply_symm_apply]
        simp
      simp [LinearEquiv.trans_symm, hI]
    rw [hc1] at h1
    rw [hcI, map_neg, ← hw₂, ← Submodule.Quotient.mk_neg] at h2
    rw [vol3_eq_of_mk_eq p (h1.trans hw₁.symm) h2]
    have := vol3_lin (p : Causal.Minkowski 2) w₁ w₂ 1 0 0 (-1)
    simp only [one_smul, zero_smul, add_zero, zero_add, neg_smul] at this
    rw [this]
    linarith
  · exact ⟨θ₀, fun w₁' w₂' h1 h2 => by
      rw [vol3_eq_of_mk_eq p (h1.trans hw₁.symm) (h2.trans hw₂.symm)]; exact hpos⟩

/-- `ℓ(p) → ℝP¹`: the double covering `S(T_p HS²) → P(T_p HS²)`, read through `θ`. -/
def linkToRP1 (θ : TpHS p ≃ₗ[ℝ] ℂ) (σ : Link p) : RP1 := RP1.mk (θ σ)

/-- The squaring map of the circle is a local homeomorphism. -/
theorem RP1.isLocalHomeomorph_sq : IsLocalHomeomorph fun z : Circle => z ^ 2 := by
  have h1 : IsLocalHomeomorph ((fun z : Circle => z ^ 2) ∘ Circle.exp) := by
    have : ((fun z : Circle => z ^ 2) ∘ Circle.exp) = Circle.exp ∘ fun t : ℝ => 2 * t :=
      funext fun t => by
        simp only [Function.comp_apply]
        rw [← Circle.exp_nsmul, nsmul_eq_mul, Nat.cast_ofNat]
    rw [this]
    exact isLocalHomeomorph_circleExp.comp
      (Homeomorph.mulLeft₀ (2 : ℝ) two_ne_zero).isLocalHomeomorph
  have := (h1.isLocalHomeomorphOn (s := univ)).of_comp_right
    (isLocalHomeomorph_circleExp.isLocalHomeomorphOn (s := univ))
  rw [Set.image_univ, Circle.exp_surjective.range_eq] at this
  exact isLocalHomeomorph_iff_isLocalHomeomorphOn_univ.2 this

/-- `ℓ(p) ≃ₜ 𝕊¹`, through `θ`. -/
def linkHomeomorph (θ : TpHS p ≃ₗ[ℝ] ℂ) : Link p ≃ₜ Circle :=
  (raySphereHomeomorph θ).trans raySphereComplexHomeomorph

theorem coe_linkHomeomorph (θ : TpHS p ≃ₗ[ℝ] ℂ) (σ : Link p) :
    ((linkHomeomorph p θ σ : Circle) : ℂ) = ‖θ σ‖⁻¹ • θ σ := rfl

/-- `ℓ(p) → ℝP¹` is the squaring map of the circle, read through `ℓ(p) ≃ₜ 𝕊¹`. -/
theorem linkToRP1_eq (θ : TpHS p ≃ₗ[ℝ] ℂ) :
    linkToRP1 p θ = (fun z : Circle => z ^ 2) ∘ linkHomeomorph p θ := by
  funext σ
  have hσ : θ σ ≠ 0 := (LinearEquiv.map_ne_zero_iff θ).2 (raySphere_ne_zero σ)
  rw [Function.comp_apply, ← RP1.mk_circle, coe_linkHomeomorph, linkToRP1,
    RP1.mk_smul (inv_ne_zero (norm_ne_zero_iff.2 hσ))]

theorem isLocalHomeomorph_linkToRP1 (θ : TpHS p ≃ₗ[ℝ] ℂ) : IsLocalHomeomorph (linkToRP1 p θ) := by
  rw [linkToRP1_eq]
  exact RP1.isLocalHomeomorph_sq.comp (linkHomeomorph p θ).isLocalHomeomorph

/-- The tangent action of `Γ_p`, read through `θ`: an element of `SL(2,ℝ)` (its determinant is
`det A = 1`, since `A` fixes `p`). -/
def gammaLin (θ : TpHS p ≃ₗ[ℝ] ℂ) (A : GammaP p) : ℂ →ₗ[ℝ] ℂ :=
  (θ : TpHS p →ₗ[ℝ] ℂ) ∘ₗ (GammaP.tangent A : TpHS p →ₗ[ℝ] TpHS p) ∘ₗ (θ.symm : ℂ →ₗ[ℝ] TpHS p)

/-- The tangent action of `A ∈ Γ_p` has determinant `1`: `A` is the identity on `ℝ p`. -/
theorem det_tangent {p : HS 2} (A : GammaP p) :
    LinearMap.det (GammaP.tangent A : TpHS p →ₗ[ℝ] TpHS p) = 1 := by
  set W := (ℝ ∙ (p : Causal.Minkowski 2))
  set A' : Causal.Minkowski 2 →ₗ[ℝ] Causal.Minkowski 2 :=
    (((A : Causal.Flat.lorentz 2) : Causal.Minkowski 2 ≃ₗ[ℝ] Causal.Minkowski 2) :
      Causal.Minkowski 2 →ₗ[ℝ] Causal.Minkowski 2)
  have hAp : A' p = p := A.2
  have he : W ≤ W.comap A' := by
    intro v hv
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hv
    rw [Submodule.mem_comap, map_smul, hAp]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
  have hres : A'.restrict he = LinearMap.id := by
    refine LinearMap.ext fun ⟨v, hv⟩ => Subtype.ext ?_
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hv
    show A' (c • (p : Causal.Minkowski 2)) = c • (p : Causal.Minkowski 2)
    rw [map_smul, hAp]
  have hdet := LinearMap.det_eq_det_mul_det W A' he
  rw [hres, LinearMap.det_id, one_mul, Causal.Flat.lorentz.det_eq_one A.1.2] at hdet
  have hq : (GammaP.tangent A : TpHS p →ₗ[ℝ] TpHS p) = W.mapQ W A' he := by
    refine LinearMap.ext fun x => ?_
    induction x using Submodule.Quotient.induction_on with
    | H v => rfl
  rw [hq, ← hdet]

theorem gammaLin_one (θ : TpHS p ≃ₗ[ℝ] ℂ) : gammaLin p θ 1 = LinearMap.id := by
  ext z
  simp [gammaLin, GammaP.tangent_one]

theorem gammaLin_mul (θ : TpHS p ≃ₗ[ℝ] ℂ) (A B : GammaP p) :
    gammaLin p θ (A * B) = gammaLin p θ A * gammaLin p θ B := by
  ext z
  simp [gammaLin, GammaP.tangent_mul]

/-- The tangent action of `Γ_p`, read through `θ`: an element of `SL(2,ℝ)` (its determinant is
`det A = 1`, since `A` fixes `p`). -/
def gammaToSL (θ : TpHS p ≃ₗ[ℝ] ℂ) : GammaP p →* SL(2, ℝ) where
  toFun A := ⟨LinearMap.toMatrix Complex.basisOneI Complex.basisOneI (gammaLin p θ A), by
    rw [LinearMap.det_toMatrix, gammaLin, LinearMap.det_conj, det_tangent]⟩
  map_one' := Subtype.ext (by
    simp only [gammaLin_one, LinearMap.toMatrix_id]; rfl)
  map_mul' A B := Subtype.ext (by
    simp only [gammaLin_mul, LinearMap.toMatrix_mul]; rfl)

theorem slLin_gammaToSL (θ : TpHS p ≃ₗ[ℝ] ℂ) (A : GammaP p) (z : ℂ) :
    slLin (gammaToSL p θ A) z = θ (GammaP.tangent A (θ.symm z)) := by
  show Matrix.toLin Complex.basisOneI Complex.basisOneI
    (LinearMap.toMatrix Complex.basisOneI Complex.basisOneI (gammaLin p θ A)) z = _
  rw [Matrix.toLin_toMatrix]
  rfl

/-- **Equivariance**: `ℓ(p) → ℝP¹` intertwines `Γ_p` and `PSL(2,ℝ)`. -/
theorem linkToRP1_smul (θ : TpHS p ≃ₗ[ℝ] ℂ) (A : GammaP p) (σ : Link p) :
    linkToRP1 p θ (A • σ) = pslMk (gammaToSL p θ A) • linkToRP1 p θ σ := by
  have hσ : θ σ ≠ 0 := (LinearEquiv.map_ne_zero_iff θ).2 (raySphere_ne_zero σ)
  have hT : GammaP.tangent A σ ≠ 0 :=
    (LinearEquiv.map_ne_zero_iff _).2 (raySphere_ne_zero σ)
  rw [pslMk_smul, linkToRP1, linkToRP1, RP1.sl_smul_mk _ hσ, slLin_gammaToSL,
    LinearEquiv.symm_apply_apply, gammaP_smul_def, coe_linRaySmul, map_smul,
    RP1.mk_smul (inv_ne_zero (norm_ne_zero_iff.2 hT))]

/-- **The natural `ℝP¹`-structure of `ℓ(p)`** (l.770–771): pulled back along `ℓ(p) → ℝP¹`. -/
@[reducible] def linkRP1ChartedSpace (θ : TpHS p ≃ₗ[ℝ] ℂ) : ChartedSpace RP1 (Link p) :=
  pullbackChartedSpace (isLocalHomeomorph_linkToRP1 p θ)

theorem linkRP1_hasGroupoid (θ : TpHS p ≃ₗ[ℝ] ℂ) :
    @HasGroupoid RP1 _ (Link p) _ (linkRP1ChartedSpace p θ) (gxGroupoid PSL(2, ℝ) RP1) :=
  hasGroupoid_pullback _

theorem linkRP1_chart_eq (θ : TpHS p ≃ₗ[ℝ] ℂ) :
    ∀ c ∈ @ChartedSpace.atlas RP1 _ (Link p) _ (linkRP1ChartedSpace p θ), ⇑c = linkToRP1 p θ := by
  rintro _ ⟨σ, rfl⟩
  funext τ
  show ((localHomeomorphAt _ σ).trans (chartAt RP1 (linkToRP1 p θ σ))) τ = _
  rw [OpenPartialHomeomorph.coe_trans, Function.comp_apply, chartAt_self_eq,
    OpenPartialHomeomorph.refl_apply, coe_localHomeomorphAt, id_eq]

/-- **The structure is natural**: two oriented identifications give maps `ℓ(p) → ℝP¹` which
differ by an element of `PSL(2,ℝ)`. -/
theorem linkToRP1_eq_smul {θ θ' : TpHS p ≃ₗ[ℝ] ℂ} (hθ : IsOrientedTangent p θ)
    (hθ' : IsOrientedTangent p θ') : ∃ g : PSL(2, ℝ), ∀ σ, linkToRP1 p θ' σ = g • linkToRP1 p θ σ := by
  -- `u, v`: the matrix of `θ ∘ θ'⁻¹` in the basis `1, i`
  set u := θ (θ'.symm 1)
  set v := θ (θ'.symm Complex.I)
  have hdecomp : ∀ z : ℂ, z = z.re • (1 : ℂ) + z.im • Complex.I := fun z => by
    apply Complex.ext <;> simp
  have hM : ∀ z : ℂ, θ (θ'.symm z) = z.re • u + z.im • v := fun z => by
    conv_lhs => rw [hdecomp z]
    rw [map_add, map_smul, map_smul, map_add, map_smul, map_smul]
  obtain ⟨w₁, hw₁⟩ := Submodule.Quotient.mk_surjective _ (θ.symm 1)
  obtain ⟨w₂, hw₂⟩ := Submodule.Quotient.mk_surjective _ (θ.symm Complex.I)
  have hpos := hθ w₁ w₂ hw₁ hw₂
  have hlift : ∀ z : ℂ,
      (Submodule.Quotient.mk (z.re • w₁ + z.im • w₂) : TpHS p) = θ.symm z := fun z => by
    rw [Submodule.Quotient.mk_add, Submodule.Quotient.mk_smul, Submodule.Quotient.mk_smul, hw₁,
      hw₂, ← map_smul, ← map_smul, ← map_add, ← hdecomp]
  have hpos' := hθ' (u.re • w₁ + u.im • w₂) (v.re • w₁ + v.im • w₂)
    (by rw [hlift, LinearEquiv.symm_apply_apply]) (by rw [hlift, LinearEquiv.symm_apply_apply])
  rw [vol3_lin] at hpos'
  have hD : 0 < u.re * v.im - u.im * v.re := pos_of_mul_pos_left hpos' hpos.le
  -- `N₀ = D^{-1/2} (θ ∘ θ'⁻¹)` lies in `SL(2,ℝ)`
  set c := (Real.sqrt (u.re * v.im - u.im * v.re))⁻¹
  have hc : c ^ 2 * (u.re * v.im - u.im * v.re) = 1 := by
    simp only [c, inv_pow, Real.sq_sqrt hD.le]
    exact inv_mul_cancel₀ hD.ne'
  have hc0 : c ≠ 0 := inv_ne_zero (Real.sqrt_pos.2 hD).ne'
  let N₀ : SL(2, ℝ) := ⟨!![c * u.re, c * v.re; c * u.im, c * v.im], by
    rw [Matrix.det_fin_two_of]; linear_combination hc⟩
  have hN₀ : ∀ z, slLin N₀ z = c • θ (θ'.symm z) := fun z => by
    rw [slLin_apply, hM]
    apply Complex.ext <;> simp [N₀] <;> ring
  refine ⟨pslMk N₀⁻¹, fun σ => ?_⟩
  rw [pslMk_smul, eq_inv_smul_iff]
  have hσ : θ' σ ≠ 0 := (LinearEquiv.map_ne_zero_iff θ').2 (raySphere_ne_zero σ)
  rw [linkToRP1, linkToRP1, RP1.sl_smul_mk _ hσ, hN₀, LinearEquiv.symm_apply_apply,
    RP1.mk_smul hc0]

/-- **The underlying `ℝP¹`-structure of a `(Γ_p, ℓ(p))`-circle** (l.770–771): its charts composed
with `ℓ(p) → ℝP¹`. -/
@[reducible] def GammaLinkCircle.rp1ChartedSpace {L : Type*} [TopologicalSpace L]
    (C : GammaLinkCircle L) (θ : TpHS C.pt ≃ₗ[ℝ] ℂ) : ChartedSpace RP1 L :=
  @ChartedSpace.comp RP1 _ (Link C.pt) _ L _ (linkRP1ChartedSpace C.pt θ) C.atlas

/-- **Every `(Γ_p, ℓ(p))`-circle admits a natural underlying `ℝP¹`-structure** (l.770–771). -/
theorem GammaLinkCircle.rp1_hasGroupoid {L : Type*} [TopologicalSpace L] (C : GammaLinkCircle L)
    (θ : TpHS C.pt ≃ₗ[ℝ] ℂ) :
    @HasGroupoid RP1 _ L _ (C.rp1ChartedSpace θ) (gxGroupoid PSL(2, ℝ) RP1) :=
  @hasGroupoid_comp_of_equivariant (GammaP C.pt) PSL(2, ℝ) (Link C.pt) RP1 L _ _ _ _ _ _ _ _ _
    C.atlas C.hasGroupoid (linkRP1ChartedSpace C.pt θ) (linkToRP1 C.pt θ)
    (linkRP1_chart_eq C.pt θ) (fun A => pslMk (gammaToSL C.pt θ A)) (linkToRP1_smul C.pt θ)

/-- **The underlying `ℝP¹`-structure does not depend on the oriented identification**: the
atlases given by two oriented `θ, θ'` are compatible (they have the same maximal atlas). -/
theorem GammaLinkCircle.rp1_compatible {L : Type*} [TopologicalSpace L] (C : GammaLinkCircle L)
    {θ θ' : TpHS C.pt ≃ₗ[ℝ] ℂ} (hθ : IsOrientedTangent C.pt θ) (hθ' : IsOrientedTangent C.pt θ')
    {e e' : OpenPartialHomeomorph L RP1} (he : e ∈ @ChartedSpace.atlas RP1 _ L _ (C.rp1ChartedSpace θ))
    (he' : e' ∈ @ChartedSpace.atlas RP1 _ L _ (C.rp1ChartedSpace θ')) :
    e.symm.trans e' ∈ gxGroupoid PSL(2, ℝ) RP1 := by
  obtain ⟨g₀, hg₀⟩ := linkToRP1_eq_smul C.pt hθ hθ'
  obtain ⟨e, he, c, hc, rfl⟩ := he
  obtain ⟨e', he', c', hc', rfl⟩ := he'
  exact trans_symm_trans_mem_gxGroupoid (@HasGroupoid.compatible (Link C.pt) _ L _ C.atlas _
    C.hasGroupoid _ _ he he') (linkRP1_chart_eq C.pt θ c hc) (linkRP1_chart_eq C.pt θ' c' hc')
    (fun A => g₀ * pslMk (gammaToSL C.pt θ A)) (fun A σ => by
      rw [hg₀, linkToRP1_smul, mul_smul])

/-- **The real angle of the link of a regular point is `4π`**: with its natural
`ℝP¹`-structure, `ℓ(p)` has lifted holonomy `δ²` (one turn of `ℓ(p)` covers `ℝP¹` twice, so
BBS's degrees are even, l.905). With `angle δ = 2π`, a cone point of cone angle `θ` has an
`ℝP¹`-angle `2θ` (a reading, see SCOPE). -/
theorem hasLiftedHolonomy_link (θ : TpHS p ≃ₗ[ℝ] ℂ) :
    @HasLiftedHolonomy (Link p) _ (linkRP1ChartedSpace p θ) (GTilde.delta ^ 2) := by
  letI := linkRP1ChartedSpace p θ
  set E : ℝ → Link p := (linkHomeomorph p θ).symm ∘ RP1.proj
  have hE : ∀ s, linkToRP1 p θ (E s) = RP1.proj (2 * s) := fun s => by
    rw [linkToRP1_eq, Function.comp_apply]
    simp only [E, Function.comp_apply, Homeomorph.apply_symm_apply]
    rw [RP1.proj, RP1.proj, ← Circle.exp_nsmul, nsmul_eq_mul, Nat.cast_ofNat]
    ring_nf
  refine ⟨E, fun s => 2 * s, isPeriodicCover_of_homeomorph _, continuous_const.mul continuous_id,
    fun a b h => by simp only; linarith, fun s => ⟨1, Eventually.of_forall fun s' => ?_⟩,
    fun s => ?_⟩
  · rw [one_smul, linkRP1_chart_eq p θ _ (chart_mem_atlas RP1 (E s)), hE]
    rfl
  · rw [pow_two, GTilde.coe_mul_apply, GTilde.delta_apply, GTilde.delta_apply]
    ring

theorem hasRealAngle_link (θ : TpHS p ≃ₗ[ℝ] ℂ) :
    @HasRealAngle (Link p) _ (linkRP1ChartedSpace p θ) (4 * π) := by
  refine ⟨_, hasLiftedHolonomy_link p θ, ?_⟩
  rw [← zpow_natCast, GTilde.angle_delta_zpow]; push_cast; ring

end NaturalRP1

