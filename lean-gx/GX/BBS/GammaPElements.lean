import GX.BBS.IPm

/-!
# BBS § 3.3.2: single elements of `Γ_p`, at a time-like and at a light-like `p`

Target `T-bbs-gammap-elements` (`roadmap/roadmap.toml`; kind research, split (3) of
`T-bbs-hs-singularities`). `papers/bbs/legacy/labeled/colI_v1.tex`, the time-like and the
light-like items of the list of l.785–800, which carry no `\label`: no ledger row is certified here.
The statements are about `Γ_p`, its tangent action, `GX.gammaToSL` and the trace classes of
`PSL(2,ℝ)` only; they are the single-element steps that `GX.BBS.HSSingularities` needs for
the time-like and light-like types of a `(Γ_p, ℓ(p))`-circle. 0 `sorry`.

> \item \textit{time-like singularities:} they correspond to the case where $p$ lies
> in $\HH_\pm^2$. Then, $\Gamma_p$ is a 1-parameter elliptic subgroup of $G$, and
> $L$ is an elliptic $\R\PP^1$-circle. (l.788–790)

> \item \textit{light-like singularities:} it is the case where $p$ lies in $\partial\HH^2_\pm$.
> The stabilizer $\Gamma_p$ is generated by a parabolic element of $\SO_0(1,2)$,
> and the link $L$ is a parabolic $\R\PP^1$-circle. (l.797–799)

## Main declarations (all proved)

* **Time-like `p`** (`Q(p) < 0`). `p^⊥` is Euclidean (lean-causal's `Causal.Flat.minkQ_pos_of_orth_timelike`), and
  `dsProj` maps `T_p HS²` onto it (`GX.GammaP.range_dsProj`); the tangent action of every
  `ρ ∈ Γ_p` is a rotation of it (`GX.GammaP.tangent_isRotation_of_timelike`: it preserves the
  positive definite form `Q ∘ dsProj` and has determinant `1`). An eigenvector forces `±id`
  (`GX.GammaP.tangent_eq_smul_of_timelike`), hence `ρ ∈ {1, the half-turn}`
  (`GX.GammaP.eq_one_or_eq_halfTurn_of_timelike`). Single-element form of
  `GX.fixedPoints_eq_empty_of_timelike`: `GX.GammaP.smul_ne_of_timelike`,
  `GX.GammaP.smul_ne_neg_of_timelike`. In `PSL(2,ℝ)`: `pslMk (gammaToSL θ ρ) = 1` iff `ρ` is `1` or
  the half-turn (`GX.GammaP.pslMk_gammaToSL_eq_one_iff_of_timelike`), elliptic otherwise
  (`GX.GammaP.isElliptic_of_timelike`); **elliptic or `1`**
  (`GX.GammaP.isElliptic_or_eq_one_of_timelike`); `tr² ≤ 4`
  (`GX.GammaP.trace_sq_le_of_timelike`).
* **Light-like `p`** (`Q(p) = 0`). `Γ_p` is the identity on the tangent line
  (`GX.GammaP.tangent_eq_self_of_null`), its tangent action is **unipotent**
  (`GX.GammaP.tangent_isUnipotent_of_null`; `(T − 1)² = 0` for every `ρ`, `T ≠ 1` for `ρ ≠ 1`), its
  only real eigenvalue is `1` (`GX.GammaP.eigen_eq_one_of_null`). Single-element form of
  `GX.fixedPoints_eq_of_null`: `ρ ≠ 1` fixes exactly the two tangent directions
  (`GX.GammaP.smul_eq_iff_of_null`, `GX.GammaP.fixedPoints_eq_of_null`), and no direction is
  reversed (`GX.GammaP.smul_ne_neg_of_null`). In `PSL(2,ℝ)`: `tr = 2`
  (`GX.GammaP.trace_gammaToSL_of_null`), `pslMk (gammaToSL θ ρ) = 1` iff `ρ = 1`, **parabolic** iff
  `ρ ≠ 1` (`GX.GammaP.isParabolic_iff_of_null`), and its fixed points on `ℝP¹` are the image of
  the tangent line (`GX.GammaP.smul_linkToRP1_eq_iff_of_null`).
* At every `p`: `pslMk (gammaToSL θ ρ) = 1` iff the tangent action is `±id`
  (`GX.GammaP.pslMk_gammaToSL_eq_one_iff`); a fixed point on `ℝP¹` is an eigen-ray
  (`GX.GammaP.exists_tangent_eq_smul_of_fixed`).

## Hypothesis checklist

| BBS | here |
|---|---|
| `p ∈ ℍ²±` (l.788–789) | ✓ `Q(p) < 0` (both sheets at once) |
| `p ∈ ∂ℍ²±` (l.797) | ✓ `Q(p) = 0` (both components at once) |
| `Γ_p` (l.763–764) | ✓ `GX.GammaP p`, its tangent action `GX.GammaP.tangent` |
| `G = PSL(2,ℝ)`, elliptic, parabolic (l.598–608) | ✓ `GX.PSL2.IsElliptic` (`tr² < 4`), `GX.PSL2.IsParabolic` (`tr² = 4`, `≠ 1`), read through `pslMk ∘ gammaToSL θ`, for every `θ : T_p HS² ≃ ℂ` (oriented or not) |

## SCOPE (disclosed)

* **(a)** Single elements only. That `Γ_p` is a one-parameter group (time-like), or is « generated
  by » a parabolic element (light-like; read: every element `≠ 1` is parabolic, `Γ_p` being the
  one-parameter group of null rotations, `≅ ℝ` and not cyclic, argued, not formalized), and the
  statements about the circle `L`, are not formalized here; the circle statements are
  `GX.GammaLinkCircle.IsLiftedDev.isElliptic_of_timelike` and `…isParabolic_of_null` of
  `GX.BBS.HSSingularities`, which these lemmas close.
* **(b)** OQ-113 (b)/(d). The `ℝP¹`-structure of `ℓ(p)` is the double cover `gammaToSL` reads
  (OQ-113 (b)). In it the half-turn about a time-like `p`, a non-trivial element of `Γ_p`, maps to
  `1 ∈ PSL(2,ℝ)` (its tangent action is `−id`): « elliptic or `1` » is exact, and « elliptic »
  alone needs OQ-113 (d) (central holonomy counted as elliptic). No reading of OQ-116 is used.

Provenance: mathlib `fabf563a` (tag `v4.31.0`), pinned via `lakefile.toml`; lean-causal `ca2ad78`
through `GX.BBS.IPm`.
-/

noncomputable section

open Set ComplexConjugate
open scoped MatrixGroups

namespace GX

set_option linter.unusedSectionVars false

/-- `ℝ^{1,2}`. -/
local notation "𝕄" => Causal.Minkowski 2

namespace GammaP

variable {p : HS 2}

/-! ## 1. At every `p` -/

/-- `Γ_p` preserves the Minkowski product of `T_p HS²` read through `dsProj`. -/
theorem minkB_dsProj_tangent (A : GammaP p) (u v : TpHS p) :
    Causal.Flat.minkB (dsProj p (GammaP.tangent A u)) (dsProj p (GammaP.tangent A v)) =
      Causal.Flat.minkB (dsProj p u) (dsProj p v) := by
  rw [dsProj_tangent, dsProj_tangent]
  exact Causal.Flat.lorentz.minkB_apply (A : Causal.Flat.lorentz 2).2 _ _

/-- `Γ_p` preserves the Minkowski form of `T_p HS²` read through `dsProj`. -/
theorem minkQ_dsProj_tangent (A : GammaP p) (z : TpHS p) :
    Causal.Flat.minkQ (dsProj p (GammaP.tangent A z)) = Causal.Flat.minkQ (dsProj p z) := by
  rw [dsProj_tangent]
  exact Causal.Flat.lorentz.minkQ_apply (A : Causal.Flat.lorentz 2).2 _

/-- At a non-null `p`, `dsProj` maps `T_p HS²` onto `p^⊥`. -/
theorem range_dsProj (hp : Causal.Flat.minkQ (p : 𝕄) ≠ 0) :
    Set.range (dsProj p) = {v : 𝕄 | Causal.Flat.minkB (p : 𝕄) v = 0} := by
  ext v
  constructor
  · rintro ⟨z, rfl⟩
    exact minkB_dsProj p z
  · intro hv
    refine ⟨tpMk p ((Causal.Flat.minkQ (p : 𝕄))⁻¹ • v), ?_⟩
    rw [dsProj_mk, map_smul, perpLin_apply, show Causal.Flat.minkB (p : 𝕄) v = 0 from hv,
      zero_smul, sub_zero, smul_smul, inv_mul_cancel₀ hp, one_smul]

/-- A vector not on the line `ℝ u` exists in `T_p HS²`. -/
theorem exists_linkArea_ne_zero {u : TpHS p} (hu : u ≠ 0) : ∃ v, linkArea p u v ≠ 0 := by
  set a := tpHSEquiv p u with ha_def
  have ha : a ≠ 0 := (LinearEquiv.map_ne_zero_iff _).2 hu
  refine ⟨(tpHSEquiv p).symm (Complex.I * a), ?_⟩
  rw [linkArea_eq, LinearEquiv.apply_symm_apply, ← ha_def]
  simp only [Complex.mul_re, Complex.mul_im, Complex.I_re, Complex.I_im, zero_mul, one_mul,
    zero_sub, zero_add]
  intro h
  apply ha
  have h1 : a.re = 0 := by nlinarith [sq_nonneg a.re, sq_nonneg a.im]
  have h2 : a.im = 0 := by nlinarith [sq_nonneg a.re, sq_nonneg a.im]
  exact Complex.ext h1 h2

/-- `T_p HS²` is not zero. -/
theorem exists_ne_zero (p : HS 2) : ∃ z : TpHS p, z ≠ 0 :=
  ⟨(tpHSEquiv p).symm 1, by simp⟩

/-- **A fixed point of `pslMk (gammaToSL θ ρ)` on `ℝP¹` is an eigen-ray of the tangent action.** -/
theorem exists_tangent_eq_smul_of_fixed (θ : TpHS p ≃ₗ[ℝ] ℂ) {A : GammaP p} {z : ℂ}
    (hz : z ≠ 0) (h : pslMk (gammaToSL p θ A) • RP1.mk z = RP1.mk z) :
    ∃ c : ℝ, GammaP.tangent A (θ.symm z) = c • θ.symm z := by
  rw [pslMk_smul, RP1.sl_smul_mk _ hz, RP1.mk_eq_mk_iff (slLin_ne_zero _ hz) hz] at h
  obtain ⟨c, hc⟩ := h
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [Complex.ofReal_zero, zero_mul] at hc
    exact hz hc
  refine ⟨c⁻¹, θ.injective ?_⟩
  rw [map_smul, LinearEquiv.apply_symm_apply, ← slLin_gammaToSL, Complex.real_smul,
    Complex.ofReal_inv]
  conv_rhs => rw [hc]
  rw [← mul_assoc, inv_mul_cancel₀ (Complex.ofReal_ne_zero.2 hc0), one_mul]

/-- A non-elliptic `pslMk (gammaToSL θ ρ)` has an eigenvector in `T_p HS²`. -/
theorem exists_eigen_of_not_isElliptic (θ : TpHS p ≃ₗ[ℝ] ℂ) {A : GammaP p}
    (h : ¬ PSL2.IsElliptic (pslMk (gammaToSL p θ A))) :
    ∃ τ : TpHS p, τ ≠ 0 ∧ ∃ c : ℝ, GammaP.tangent A τ = c • τ := by
  obtain ⟨w, hw⟩ := PSL2.exists_smul_eq_of_not_isElliptic h
  rw [← RP1.mk_rep w] at hw
  exact ⟨θ.symm (RP1.rep w), by simpa using RP1.rep_ne_zero w,
    exists_tangent_eq_smul_of_fixed θ (RP1.rep_ne_zero w) hw⟩

/-- **`pslMk (gammaToSL θ ρ) = 1` iff the tangent action of `ρ` is `±id`**, at every `p`. -/
theorem pslMk_gammaToSL_eq_one_iff (θ : TpHS p ≃ₗ[ℝ] ℂ) (A : GammaP p) :
    pslMk (gammaToSL p θ A) = 1 ↔ ∃ r : ℝ, r ^ 2 = 1 ∧ ∀ z, GammaP.tangent A z = r • z := by
  constructor
  · intro hone
    have hcen : gammaToSL p θ A ∈ Subgroup.center SL(2, ℝ) := (QuotientGroup.eq_one_iff _).1 hone
    obtain ⟨r, hr2, hr⟩ := Matrix.SpecialLinearGroup.mem_center_iff.1 hcen
    refine ⟨r, by simpa using hr2, fun z => ?_⟩
    apply θ.injective
    have := slLin_gammaToSL p θ A (θ z)
    rw [LinearEquiv.symm_apply_apply] at this
    rw [← this, map_smul, slLin_apply, ← hr]
    apply Complex.ext <;> simp [Matrix.scalar_apply]
  · rintro ⟨r, hr2, hT⟩
    apply (QuotientGroup.eq_one_iff _).2
    refine Matrix.SpecialLinearGroup.mem_center_iff.2 ⟨r, by simpa using hr2, ?_⟩
    have hL : gammaLin p θ A = r • LinearMap.id := LinearMap.ext fun z => by
      simp [gammaLin, hT]
    show Matrix.scalar (Fin 2) r =
      LinearMap.toMatrix Complex.basisOneI Complex.basisOneI (gammaLin p θ A)
    rw [hL, map_smul, LinearMap.toMatrix_id]
    ext i j
    simp [Matrix.scalar_apply, Matrix.diagonal_apply, Matrix.one_apply]

/-- An eigenvector of `g ∈ SL(2,ℝ)` with eigenvalue `c` gives `c · tr g = c² + 1`. -/
theorem sl_trace_of_eigen (g : SL(2, ℝ)) {z : ℂ} (hz : z ≠ 0) {c : ℝ}
    (h : slLin g z = (c : ℂ) * z) :
    c * Matrix.trace (g : Matrix (Fin 2) (Fin 2) ℝ) = c ^ 2 + 1 := by
  have hre := congrArg Complex.re h
  have him := congrArg Complex.im h
  rw [slLin_apply] at hre him
  simp only [Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul,
    sub_zero, add_zero] at hre him
  set a := (g : Matrix (Fin 2) (Fin 2) ℝ) 0 0
  set b := (g : Matrix (Fin 2) (Fin 2) ℝ) 0 1
  set c' := (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0
  set d := (g : Matrix (Fin 2) (Fin 2) ℝ) 1 1
  have hdet : a * d - b * c' = 1 := by
    have := g.2; rw [Matrix.det_fin_two] at this; exact this
  rw [Matrix.trace_fin_two]
  set x := z.re
  set y := z.im
  have hxy : x ≠ 0 ∨ y ≠ 0 := by
    by_contra hh
    push Not at hh
    exact hz (Complex.ext hh.1 hh.2)
  have e1 : (a - c) * x + b * y = 0 := by linear_combination hre
  have e2 : c' * x + (d - c) * y = 0 := by linear_combination him
  have hP : (a - c) * (d - c) - b * c' = 0 := by
    rcases hxy with hx | hy
    · have : ((a - c) * (d - c) - b * c') * x = 0 := by
        linear_combination (d - c) * e1 - b * e2
      exact (mul_eq_zero.1 this).resolve_right hx
    · have : ((a - c) * (d - c) - b * c') * y = 0 := by
        linear_combination (a - c) * e2 - c' * e1
      exact (mul_eq_zero.1 this).resolve_right hy
  linear_combination -hP + hdet

/-! ## 2. A time-like `p`: rotations of the Euclidean plane `p^⊥` (l.788–790) -/

/-- `Q ∘ dsProj` is positive definite on `T_p HS²`, at a time-like `p`. -/
theorem minkQ_dsProj_pos_of_timelike (hp : Causal.Flat.minkQ (p : 𝕄) < 0) {z : TpHS p}
    (hz : z ≠ 0) : 0 < Causal.Flat.minkQ (dsProj p z) :=
  Causal.Flat.minkQ_pos_of_orth_timelike hp (minkB_dsProj p z)
    (fun h => hz (dsProj_injective p hp.ne (h.trans (map_zero _).symm)))

/-- **At a time-like `p`, every `ρ ∈ Γ_p` acts on `T_p HS² ≅ p^⊥` as a rotation of a Euclidean
plane** (l.788–790): `Q ∘ dsProj` is positive definite, its polar form is preserved, and the
determinant is `1`. -/
theorem tangent_isRotation_of_timelike (hp : Causal.Flat.minkQ (p : 𝕄) < 0) (A : GammaP p) :
    (∀ z : TpHS p, z ≠ 0 → 0 < Causal.Flat.minkQ (dsProj p z)) ∧
    (∀ u v : TpHS p, Causal.Flat.minkB (dsProj p (GammaP.tangent A u))
        (dsProj p (GammaP.tangent A v)) = Causal.Flat.minkB (dsProj p u) (dsProj p v)) ∧
    LinearMap.det (GammaP.tangent A : TpHS p →ₗ[ℝ] TpHS p) = 1 :=
  ⟨fun _ hz => minkQ_dsProj_pos_of_timelike hp hz, minkB_dsProj_tangent A, det_tangent A⟩

/-- **A rotation with an eigen-ray is `±id`**, at a time-like `p`. -/
theorem tangent_eq_smul_of_timelike (hp : Causal.Flat.minkQ (p : 𝕄) < 0) {A : GammaP p}
    {σ : TpHS p} (hσ : σ ≠ 0) {c : ℝ} (hc : GammaP.tangent A σ = c • σ) :
    (c = 1 ∨ c = -1) ∧ ∀ z, GammaP.tangent A z = c • z := by
  set T := GammaP.tangent A
  set Q := Causal.Flat.minkQ (dsProj p σ) with hQ_def
  have hQ : 0 < Q := minkQ_dsProj_pos_of_timelike hp hσ
  have hc2 : c ^ 2 = 1 := by
    have h := minkQ_dsProj_tangent A σ
    rw [hc, map_smul, Causal.Flat.minkQ_smul, ← hQ_def] at h
    have : (c ^ 2 - 1) * Q = 0 := by linear_combination h
    linear_combination (mul_eq_zero.1 this).resolve_right hQ.ne'
  obtain ⟨e₀, he₀⟩ := exists_linkArea_ne_zero hσ
  set B₀ := Causal.Flat.minkB (dsProj p σ) (dsProj p e₀)
  set e := Q • e₀ + (-B₀) • σ with he_def
  have hBe : Causal.Flat.minkB (dsProj p σ) (dsProj p e) = 0 := by
    rw [he_def, map_add, map_smul, map_smul, Causal.Flat.minkB_add_right,
      Causal.Flat.minkB_smul_right, Causal.Flat.minkB_smul_right, ← Causal.Flat.minkQ_eq_minkB]
    ring
  have hLe : linkArea p σ e ≠ 0 := by
    rw [he_def, linkArea_add_smul, linkArea_self, mul_zero, add_zero]
    exact mul_ne_zero hQ.ne' he₀
  clear_value e
  have hTe := eq_add_of_linkArea_ne_zero p hLe (T e)
  set α := linkArea p (T e) e / linkArea p σ e
  set β := linkArea p σ (T e) / linkArea p σ e
  have harea := linkArea_tangent p A σ e
  change linkArea p (T σ) (T e) = _ at harea
  rw [hc, hTe, linkArea_smul_left, linkArea_add_smul, linkArea_self] at harea
  have hβ : c * β = 1 := by
    have : (c * β - 1) * linkArea p σ e = 0 := by linear_combination harea
    linear_combination (mul_eq_zero.1 this).resolve_right hLe
  have horth := minkB_dsProj_tangent A σ e
  change Causal.Flat.minkB (dsProj p (T σ)) (dsProj p (T e)) = _ at horth
  rw [hc, hTe, hBe, map_smul, map_add, map_smul, map_smul, Causal.Flat.minkB_smul_left,
    Causal.Flat.minkB_add_right, Causal.Flat.minkB_smul_right, Causal.Flat.minkB_smul_right,
    hBe, ← Causal.Flat.minkQ_eq_minkB, ← hQ_def] at horth
  have hc0 : c ≠ 0 := by rintro rfl; simp at hc2
  have hα : α = 0 := by
    have : (c * Q) * α = 0 := by linear_combination horth
    exact (mul_eq_zero.1 this).resolve_left (mul_ne_zero hc0 hQ.ne')
  have hβc : β = c := by linear_combination c * hβ - β * hc2
  have hTe' : T e = c • e := by rw [hTe, hα, hβc, zero_smul, zero_add]
  refine ⟨?_, fun z => ?_⟩
  · have : (c - 1) * (c + 1) = 0 := by linear_combination hc2
    rcases mul_eq_zero.1 this with h | h
    · left; linarith
    · right; linarith
  · have hz := eq_add_of_linkArea_ne_zero p hLe z
    set a := linkArea p z e / linkArea p σ e
    set b := linkArea p σ z / linkArea p σ e
    rw [hz, map_add, map_smul, map_smul, hc, hTe', smul_add, smul_comm a c, smul_comm b c]

/-- The tangent action of the half-turn about a time-like `p` is `−id`. -/
theorem tangent_gammaHalfTurn (hp : Causal.Flat.minkQ (p : 𝕄) < 0) (z : TpHS p) :
    GammaP.tangent (gammaHalfTurn hp) z = -z := by
  induction z using Submodule.Quotient.induction_on with
  | H v =>
    show tpMk p (halfTurnLin p v) = -tpMk p v
    rw [← Submodule.Quotient.mk_neg, tpMk_eq_tpMk_iff, halfTurnLin_apply]
    exact ⟨_, rfl⟩

theorem gammaHalfTurn_mul_self (hp : Causal.Flat.minkQ (p : 𝕄) < 0) :
    gammaHalfTurn hp * gammaHalfTurn hp = 1 :=
  gammaP_eq_one_of_tangent p fun z => by
    rw [GammaP.tangent_mul]
    show GammaP.tangent (gammaHalfTurn hp) (GammaP.tangent (gammaHalfTurn hp) z) = z
    rw [tangent_gammaHalfTurn, tangent_gammaHalfTurn, neg_neg]

/-- The half-turn is not `1`. -/
theorem gammaHalfTurn_ne_one (hp : Causal.Flat.minkQ (p : 𝕄) < 0) : gammaHalfTurn hp ≠ 1 := by
  intro h
  obtain ⟨z, hz⟩ := exists_ne_zero p
  have h1 := tangent_gammaHalfTurn hp z
  rw [h, GammaP.tangent_one] at h1
  have h1' : z = -z := h1
  have h2 : (2 : ℝ) • z = 0 := by
    rw [two_smul]; nth_rewrite 2 [h1']; exact add_neg_cancel z
  exact hz ((smul_eq_zero.1 h2).resolve_left two_ne_zero)

/-- **An element of `Γ_p` with an eigen-ray is `1` or the half-turn**, at a time-like `p`. -/
theorem eq_one_or_eq_halfTurn_of_timelike (hp : Causal.Flat.minkQ (p : 𝕄) < 0) {A : GammaP p}
    {σ : TpHS p} (hσ : σ ≠ 0) {c : ℝ} (hc : GammaP.tangent A σ = c • σ) :
    A = 1 ∨ A = gammaHalfTurn hp := by
  obtain ⟨hc1, hT⟩ := tangent_eq_smul_of_timelike hp hσ hc
  rcases hc1 with rfl | rfl
  · left; exact gammaP_eq_one_of_tangent p fun z => by rw [hT, one_smul]
  · right
    have hHA : gammaHalfTurn hp * A = 1 := gammaP_eq_one_of_tangent p fun z => by
      rw [GammaP.tangent_mul]
      show GammaP.tangent (gammaHalfTurn hp) (GammaP.tangent A z) = z
      rw [hT, tangent_gammaHalfTurn, neg_one_smul, neg_neg]
    calc A = gammaHalfTurn hp * (gammaHalfTurn hp * A) := by
            rw [← mul_assoc, gammaHalfTurn_mul_self, one_mul]
      _ = gammaHalfTurn hp := by rw [hHA, mul_one]

/-- **Single-element form of `GX.fixedPoints_eq_empty_of_timelike`**: at a time-like `p`, an
element `≠ 1` of `Γ_p` fixes no direction. -/
theorem smul_ne_of_timelike (hp : Causal.Flat.minkQ (p : 𝕄) < 0) {A : GammaP p} (hA : A ≠ 1)
    (σ : Link p) : A • σ ≠ σ := by
  intro h
  obtain ⟨c, hc, hT⟩ := (gammaP_smul_eq_iff A σ).1 h
  rcases eq_one_or_eq_halfTurn_of_timelike hp (raySphere_ne_zero σ) hT with h1 | h1
  · exact hA h1
  · rw [h1, tangent_gammaHalfTurn] at hT
    have h2 : (1 + c) • (σ : TpHS p) = 0 := by rw [add_smul, one_smul, ← hT, add_neg_cancel]
    exact raySphere_ne_zero σ ((smul_eq_zero.1 h2).resolve_left (by linarith))

/-- At a time-like `p`, an element of `Γ_p` other than the half-turn reverses no direction. -/
theorem smul_ne_neg_of_timelike (hp : Causal.Flat.minkQ (p : 𝕄) < 0) {A : GammaP p}
    (hA : A ≠ gammaHalfTurn hp) (σ : Link p) : A • σ ≠ -σ := by
  intro h
  rw [gammaP_smul_def, linRaySmul_eq_iff, coe_neg_sphere] at h
  obtain ⟨c, hc, hT⟩ := h
  rw [smul_neg, ← neg_smul] at hT
  rcases eq_one_or_eq_halfTurn_of_timelike hp (raySphere_ne_zero σ) hT with h1 | h1
  · rw [h1, GammaP.tangent_one] at hT
    have h2 : (1 + c) • (σ : TpHS p) = 0 := by
      rw [add_smul, one_smul]
      nth_rewrite 1 [show (σ : TpHS p) = (1 : TpHS p ≃ₗ[ℝ] TpHS p) σ from rfl]
      rw [hT, neg_smul, neg_add_cancel]
    exact raySphere_ne_zero σ ((smul_eq_zero.1 h2).resolve_left (by linarith))
  · exact hA h1

/-- At a time-like `p`, `pslMk (gammaToSL θ ρ) = 1` iff `ρ` is `1` or the half-turn. -/
theorem pslMk_gammaToSL_eq_one_iff_of_timelike (hp : Causal.Flat.minkQ (p : 𝕄) < 0)
    (θ : TpHS p ≃ₗ[ℝ] ℂ) (A : GammaP p) :
    pslMk (gammaToSL p θ A) = 1 ↔ A = 1 ∨ A = gammaHalfTurn hp := by
  rw [pslMk_gammaToSL_eq_one_iff]
  constructor
  · rintro ⟨r, -, hT⟩
    obtain ⟨z, hz⟩ := exists_ne_zero p
    exact eq_one_or_eq_halfTurn_of_timelike hp hz (hT z)
  · rintro (rfl | rfl)
    · exact ⟨1, one_pow 2, fun z => by rw [GammaP.tangent_one, one_smul]; rfl⟩
    · exact ⟨-1, by norm_num, fun z => by rw [tangent_gammaHalfTurn, neg_one_smul]⟩

/-- **At a time-like `p`, an element of `Γ_p` other than `1` and the half-turn is elliptic** in
`PSL(2,ℝ)`. -/
theorem isElliptic_of_timelike (hp : Causal.Flat.minkQ (p : 𝕄) < 0) (θ : TpHS p ≃ₗ[ℝ] ℂ)
    {A : GammaP p} (h1 : A ≠ 1) (h2 : A ≠ gammaHalfTurn hp) :
    PSL2.IsElliptic (pslMk (gammaToSL p θ A)) := by
  by_contra h
  obtain ⟨τ, hτ, c, hc⟩ := exists_eigen_of_not_isElliptic θ h
  rcases eq_one_or_eq_halfTurn_of_timelike hp hτ hc with h' | h'
  exacts [h1 h', h2 h']

/-- **Time-like** (l.788–790), single elements: at `p ∈ ℍ²±`, `pslMk (gammaToSL θ ρ)` is
elliptic or `1`, for every `ρ ∈ Γ_p` and every `θ`. -/
theorem isElliptic_or_eq_one_of_timelike (hp : Causal.Flat.minkQ (p : 𝕄) < 0)
    (θ : TpHS p ≃ₗ[ℝ] ℂ) (A : GammaP p) :
    PSL2.IsElliptic (pslMk (gammaToSL p θ A)) ∨ pslMk (gammaToSL p θ A) = 1 := by
  by_cases h : A = 1 ∨ A = gammaHalfTurn hp
  · exact Or.inr ((pslMk_gammaToSL_eq_one_iff_of_timelike hp θ A).2 h)
  · push Not at h
    exact Or.inl (isElliptic_of_timelike hp θ h.1 h.2)

/-- At a time-like `p`, `|tr (gammaToSL θ ρ)| ≤ 2`. -/
theorem trace_sq_le_of_timelike (hp : Causal.Flat.minkQ (p : 𝕄) < 0) (θ : TpHS p ≃ₗ[ℝ] ℂ)
    (A : GammaP p) : Matrix.trace (gammaToSL p θ A : Matrix (Fin 2) (Fin 2) ℝ) ^ 2 ≤ 4 := by
  rcases isElliptic_or_eq_one_of_timelike hp θ A with h | h
  · have h' : PSL2.trSq (pslMk (gammaToSL p θ A)) < 4 := h
    rw [PSL2.trSq_mk] at h'
    exact h'.le
  · have h' : PSL2.trSq (pslMk (gammaToSL p θ A)) = PSL2.trSq (pslMk 1) := by rw [h]; rfl
    rw [PSL2.trSq_mk, PSL2.trSq_mk] at h'
    rw [h']
    simp only [Matrix.SpecialLinearGroup.coe_one, Matrix.trace_one, Fintype.card_fin]
    norm_num

/-! ## 3. A light-like `p`: unipotent elements (l.797–799) -/

/-- The kernel of `B(p, ·)` on `T_p HS²` is a line, at a light-like `p`. -/
theorem eq_smul_of_nullPairing_eq_zero (hp : Causal.Flat.minkQ (p : 𝕄) = 0) {σ z : TpHS p}
    (hσ : σ ≠ 0) (hσ0 : nullPairing p σ = 0) (hz : nullPairing p z = 0) :
    ∃ r : ℝ, z = r • σ := by
  obtain ⟨w₀, -, hB₀⟩ := exists_minkB_neg hp
  set e := tpMk p w₀
  have hφe : nullPairing p e ≠ 0 := by rw [nullPairing_mk p hp]; exact hB₀.ne
  have harea : linkArea p σ e ≠ 0 := by
    intro h
    obtain ⟨r, hr⟩ := eq_smul_of_linkArea_eq_zero p hσ h
    apply hφe
    rw [hr, map_smul, hσ0, smul_zero]
  have hy := eq_add_of_linkArea_ne_zero p harea z
  set a := linkArea p z e / linkArea p σ e
  set b := linkArea p σ z / linkArea p σ e
  have hb : b = 0 := by
    have := congrArg (nullPairing p) hy
    rw [hz, map_add, map_smul, map_smul, hσ0, smul_eq_mul, smul_eq_mul, mul_zero, zero_add]
      at this
    exact (mul_eq_zero.1 this.symm).resolve_right hφe
  refine ⟨a, ?_⟩
  rw [hb, zero_smul, add_zero] at hy
  exact hy

/-- **`Γ_p` is the identity on the tangent line**, at a light-like `p` (not only a positive
multiple: `GX.smul_eq_of_null` is the ray form). -/
theorem tangent_eq_self_of_null (hp : Causal.Flat.minkQ (p : 𝕄) = 0) (A : GammaP p)
    {σ : TpHS p} (hσ0 : nullPairing p σ = 0) : GammaP.tangent A σ = σ := by
  by_cases hσ : σ = 0
  · rw [hσ, map_zero]
  set T := GammaP.tangent A
  obtain ⟨w₀, -, hB₀⟩ := exists_minkB_neg hp
  set e := tpMk p w₀
  have hφe : nullPairing p e ≠ 0 := by rw [nullPairing_mk p hp]; exact hB₀.ne
  have harea : linkArea p σ e ≠ 0 := by
    intro h
    obtain ⟨r, hr⟩ := eq_smul_of_linkArea_eq_zero p hσ h
    apply hφe
    rw [hr, map_smul, hσ0, smul_zero]
  obtain ⟨a, ha⟩ := eq_smul_of_nullPairing_eq_zero hp hσ hσ0 (z := T σ)
    (by rw [nullPairing_tangent]; exact hσ0)
  obtain ⟨c, hc⟩ := eq_smul_of_nullPairing_eq_zero hp hσ hσ0 (z := T e - e)
    (by rw [map_sub, nullPairing_tangent, sub_self])
  have hTe : T e = c • σ + (1 : ℝ) • e := by rw [one_smul, ← hc]; abel
  have h := linkArea_tangent p A σ e
  change linkArea p (T σ) (T e) = _ at h
  rw [ha, hTe, linkArea_smul_left, linkArea_add_smul, linkArea_self] at h
  have ha1 : a = 1 := by
    have : (a - 1) * linkArea p σ e = 0 := by linear_combination h
    linear_combination (mul_eq_zero.1 this).resolve_right harea
  rw [ha, ha1, one_smul]

/-- `(T − 1)² = 0`, pointwise: `T − 1` maps into the tangent line, where `T = 1`. -/
theorem tangent_sub_self_of_null (hp : Causal.Flat.minkQ (p : 𝕄) = 0) (A : GammaP p)
    (z : TpHS p) :
    GammaP.tangent A (GammaP.tangent A z - z) = GammaP.tangent A z - z :=
  tangent_eq_self_of_null hp A (by rw [map_sub, nullPairing_tangent, sub_self])

/-- **At a light-like `p`, every `ρ ≠ 1` of `Γ_p` is unipotent on `T_p HS²`** (l.797–799):
`T − 1 ≠ 0` and `(T − 1)² = 0`. -/
theorem tangent_isUnipotent_of_null (hp : Causal.Flat.minkQ (p : 𝕄) = 0) {A : GammaP p}
    (hA : A ≠ 1) :
    (GammaP.tangent A : TpHS p →ₗ[ℝ] TpHS p) - LinearMap.id ≠ 0 ∧
      ((GammaP.tangent A : TpHS p →ₗ[ℝ] TpHS p) - LinearMap.id) ∘ₗ
        ((GammaP.tangent A : TpHS p →ₗ[ℝ] TpHS p) - LinearMap.id) = 0 := by
  refine ⟨fun h => hA (gammaP_eq_one_of_tangent p fun z => ?_), LinearMap.ext fun z => ?_⟩
  · have := LinearMap.congr_fun h z
    simp only [LinearMap.sub_apply, LinearEquiv.coe_coe, LinearMap.id_apply,
      LinearMap.zero_apply, sub_eq_zero] at this
    exact this
  · simp only [LinearMap.comp_apply, LinearMap.sub_apply, LinearEquiv.coe_coe,
      LinearMap.id_apply, LinearMap.zero_apply]
    rw [tangent_sub_self_of_null hp A z, sub_self]

/-- At a light-like `p`, the only real eigenvalue of the tangent action is `1`. -/
theorem eigen_eq_one_of_null (hp : Causal.Flat.minkQ (p : 𝕄) = 0) {A : GammaP p}
    {σ : TpHS p} (hσ : σ ≠ 0) {c : ℝ} (hc : GammaP.tangent A σ = c • σ) : c = 1 := by
  have h := tangent_sub_self_of_null hp A σ
  rw [hc, map_sub, map_smul, hc, smul_smul] at h
  have h2 : ((c - 1) ^ 2) • σ = 0 := by
    have : (c * c) • σ - c • σ - (c • σ - σ) = 0 := by rw [h, sub_self]
    rw [← this]; module
  have := (smul_eq_zero.1 h2).resolve_right hσ
  have : c - 1 = 0 := pow_eq_zero_iff two_ne_zero |>.1 this
  linarith

/-- **Single-element form of `GX.fixedPoints_eq_of_null`**: at a light-like `p`, an element
`ρ ≠ 1` of `Γ_p` fixes a direction iff it is one of the two tangent directions. -/
theorem smul_eq_iff_of_null (hp : Causal.Flat.minkQ (p : 𝕄) = 0) {A : GammaP p} (hA : A ≠ 1)
    (σ : Link p) : A • σ = σ ↔ σ ∈ tangentDirs p := by
  refine ⟨fun h => ?_, fun h => smul_eq_of_null hp h A⟩
  obtain ⟨c, -, hT⟩ := (gammaP_smul_eq_iff A σ).1 h
  have hc1 := eigen_eq_one_of_null hp (raySphere_ne_zero σ) hT
  rw [hc1, one_smul] at hT
  by_contra hσt
  have hσt' : nullPairing p σ ≠ 0 := hσt
  apply hA
  apply gammaP_eq_one_of_tangent p
  set τ := dirOf p (jVec p)
  have hτ : τ ∈ tangentDirs p := by rw [tangentDirs_eq hp]; exact Or.inl rfl
  have hτ0 : nullPairing p τ = 0 := hτ
  have hτT := tangent_eq_self_of_null hp A hτ0
  have hL : linkArea p τ σ ≠ 0 := by
    intro h0
    obtain ⟨r, hr⟩ := eq_smul_of_linkArea_eq_zero p (raySphere_ne_zero τ) h0
    apply hσt'
    rw [hr, map_smul, hτ0, smul_zero]
  intro z
  have hz := eq_add_of_linkArea_ne_zero p hL z
  set a := linkArea p z σ / linkArea p τ σ
  set b := linkArea p τ z / linkArea p τ σ
  rw [hz, map_add, map_smul, map_smul, hτT, hT]

/-- The set form: the fixed directions of `ρ ≠ 1` are the two tangent directions. -/
theorem fixedPoints_eq_of_null (hp : Causal.Flat.minkQ (p : 𝕄) = 0) {A : GammaP p}
    (hA : A ≠ 1) : {σ : Link p | A • σ = σ} = tangentDirs p :=
  Set.ext fun σ => smul_eq_iff_of_null hp hA σ

/-- At a light-like `p`, no element of `Γ_p` reverses a direction. -/
theorem smul_ne_neg_of_null (hp : Causal.Flat.minkQ (p : 𝕄) = 0) (A : GammaP p) (σ : Link p) :
    A • σ ≠ -σ := by
  intro h
  rw [gammaP_smul_def, linRaySmul_eq_iff, coe_neg_sphere] at h
  obtain ⟨c, hc, hT⟩ := h
  rw [smul_neg, ← neg_smul] at hT
  have := eigen_eq_one_of_null hp (raySphere_ne_zero σ) hT
  linarith

/-- At a light-like `p`, `tr (gammaToSL θ ρ) = 2`. -/
theorem trace_gammaToSL_of_null (hp : Causal.Flat.minkQ (p : 𝕄) = 0) (θ : TpHS p ≃ₗ[ℝ] ℂ)
    (A : GammaP p) : Matrix.trace (gammaToSL p θ A : Matrix (Fin 2) (Fin 2) ℝ) = 2 := by
  set τ := dirOf p (jVec p)
  have hτ0 : nullPairing p τ = 0 := by
    show τ ∈ tangentDirs p
    rw [tangentDirs_eq hp]; exact Or.inl rfl
  have hz : θ τ ≠ 0 := (LinearEquiv.map_ne_zero_iff θ).2 (raySphere_ne_zero τ)
  have h : slLin (gammaToSL p θ A) (θ τ) = ((1 : ℝ) : ℂ) * θ τ := by
    rw [slLin_gammaToSL, LinearEquiv.symm_apply_apply, tangent_eq_self_of_null hp A hτ0,
      Complex.ofReal_one, one_mul]
  have := sl_trace_of_eigen _ hz h
  linarith

/-- At a light-like `p`, `pslMk (gammaToSL θ ρ) = 1` iff `ρ = 1`. -/
theorem pslMk_gammaToSL_eq_one_iff_of_null (hp : Causal.Flat.minkQ (p : 𝕄) = 0)
    (θ : TpHS p ≃ₗ[ℝ] ℂ) (A : GammaP p) : pslMk (gammaToSL p θ A) = 1 ↔ A = 1 := by
  rw [pslMk_gammaToSL_eq_one_iff]
  constructor
  · rintro ⟨r, -, hT⟩
    set τ := dirOf p (jVec p)
    have hτ0 : nullPairing p τ = 0 := by
      show τ ∈ tangentDirs p
      rw [tangentDirs_eq hp]; exact Or.inl rfl
    have h1 := tangent_eq_self_of_null hp A hτ0
    rw [hT] at h1
    have hr : r = 1 := by
      have h0 : (r - 1) • (τ : TpHS p) = 0 := by rw [sub_smul, h1, one_smul, sub_self]
      linarith [(smul_eq_zero.1 h0).resolve_right (raySphere_ne_zero τ)]
    exact gammaP_eq_one_of_tangent p fun z => by rw [hT, hr, one_smul]
  · rintro rfl
    exact ⟨1, one_pow 2, fun z => by rw [GammaP.tangent_one, one_smul]; rfl⟩

/-- **Light-like** (l.797–799), single elements: at `p ∈ ∂ℍ²±`, `pslMk (gammaToSL θ ρ)` is
parabolic iff `ρ ≠ 1`, for every `θ`. -/
theorem isParabolic_iff_of_null (hp : Causal.Flat.minkQ (p : 𝕄) = 0) (θ : TpHS p ≃ₗ[ℝ] ℂ)
    (A : GammaP p) : PSL2.IsParabolic (pslMk (gammaToSL p θ A)) ↔ A ≠ 1 := by
  rw [PSL2.IsParabolic, PSL2.trSq_mk, trace_gammaToSL_of_null hp θ A,
    Ne, pslMk_gammaToSL_eq_one_iff_of_null hp θ A]
  norm_num

/-- At a light-like `p`, the fixed points on `ℝP¹` of `pslMk (gammaToSL θ ρ)`, `ρ ≠ 1`, are the
image of the tangent line. -/
theorem smul_linkToRP1_eq_iff_of_null (hp : Causal.Flat.minkQ (p : 𝕄) = 0)
    (θ : TpHS p ≃ₗ[ℝ] ℂ) {A : GammaP p} (hA : A ≠ 1) (σ : Link p) :
    pslMk (gammaToSL p θ A) • linkToRP1 p θ σ = linkToRP1 p θ σ ↔ σ ∈ tangentDirs p := by
  refine ⟨fun h => ?_, fun h => by rw [← linkToRP1_smul, smul_eq_of_null hp h A]⟩
  have hz : θ σ ≠ 0 := (LinearEquiv.map_ne_zero_iff θ).2 (raySphere_ne_zero σ)
  obtain ⟨c, hc⟩ := exists_tangent_eq_smul_of_fixed θ hz h
  rw [LinearEquiv.symm_apply_apply] at hc
  have hc1 := eigen_eq_one_of_null hp (raySphere_ne_zero σ) hc
  rw [← smul_eq_iff_of_null hp hA, gammaP_smul_eq_iff]
  exact ⟨c, by rw [hc1]; exact one_pos, hc⟩

end GammaP

end GX
