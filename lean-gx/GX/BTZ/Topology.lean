namespace GX

open Set Filter Topology Function
open scoped Real

/-! ### Null coordinates: the causal and chronological cones -/

section NullCones

/-- The closed future cone of `𝐌³` read in null coordinates (`nullQ (a,b,c) = c² − ab`). -/
theorem btzJ_isFutureCausal_iff (w : ℝ × ℝ × ℝ) :
    Causal.Flat.IsFutureCausal (nullToMink w) ↔ 0 ≤ w.1 ∧ 0 ≤ w.2.1 ∧ w.2.2 ^ 2 ≤ w.1 * w.2.1 := by
  rw [Causal.Flat.IsFutureCausal, fst_nullToMink, minkQ_nullToMink]
  simp only [nullτ_apply, nullQ]
  constructor
  · rintro ⟨h1, h2⟩
    have hab : 0 ≤ w.1 * w.2.1 := by nlinarith [sq_nonneg w.2.2]
    refine ⟨?_, ?_, by linarith⟩
    · by_contra h
      push Not at h
      have : w.2.1 ≤ 0 := by
        by_contra h'; push Not at h'; nlinarith
      linarith
    · by_contra h
      push Not at h
      have : w.1 ≤ 0 := by
        by_contra h'; push Not at h'; nlinarith
      linarith
  · rintro ⟨h1, h2, h3⟩
    exact ⟨by linarith, by linarith⟩

/-- The open future cone of `𝐌³` read in null coordinates. -/
theorem btzJ_isFutureTimelike_iff (w : ℝ × ℝ × ℝ) :
    Causal.Flat.IsFutureTimelike (nullToMink w) ↔ 0 < w.1 ∧ 0 < w.2.1 ∧ w.2.2 ^ 2 < w.1 * w.2.1 := by
  rw [isFutureTimelike_nullToMink_iff]
  simp only [nullτ_apply, nullQ]
  constructor
  · rintro ⟨h1, h2⟩
    have hab : 0 < w.1 * w.2.1 := by nlinarith [sq_nonneg w.2.2]
    have ha : 0 < w.1 := by
      by_contra h; push Not at h
      have : w.2.1 < 0 := by
        by_contra h'; push Not at h'; nlinarith
      linarith
    have hb : 0 < w.2.1 := by
      by_contra h; push Not at h
      have : w.1 < 0 := by
        by_contra h'; push Not at h'; nlinarith
      linarith
    exact ⟨ha, hb, by linarith⟩
  · rintro ⟨h1, h2, h3⟩
    exact ⟨by linarith, by linarith⟩

/-- `≤` of `𝐌³` in null coordinates. -/
theorem btzJ_le_iff (a b : ℝ × ℝ × ℝ) :
    (Causal.minkowski 2).le ⊤ (nullToMink a) (nullToMink b) ↔
      0 ≤ (b - a).1 ∧ 0 ≤ (b - a).2.1 ∧ (b - a).2.2 ^ 2 ≤ (b - a).1 * (b - a).2.1 := by
  rw [Causal.Flat.le_top_iff_minkQ, ← map_sub, btzJ_isFutureCausal_iff]

/-- `≪` of `𝐌³` in null coordinates. -/
theorem btzJ_lt_iff (a b : ℝ × ℝ × ℝ) :
    (Causal.minkowski 2).lt ⊤ (nullToMink a) (nullToMink b) ↔
      0 < (b - a).1 ∧ 0 < (b - a).2.1 ∧ (b - a).2.2 ^ 2 < (b - a).1 * (b - a).2.1 := by
  rw [Causal.Flat.lt_top_iff_minkQ, ← map_sub, btzJ_isFutureTimelike_iff]

end NullCones

/-! ### `defi:BTZtop`: the BTZ topology on `J⁺(Δ)` -/

section BTZTop

variable (x₀ : ℝ × ℝ × ℝ)

/-- **The causal future `J⁺(Δ)` of the lightlike line `Δ = x₀ + ℝu`** in `𝐌³`
(`RamcovGX.tex:2249`; `lean-causal`'s causality of Minkowski space). -/
abbrev btzJplus : Set (Causal.Minkowski 2) := (Causal.minkowski 2).Jplus ⊤ (btzLine x₀)

/-- **The relatively open future half-ray** `]p, +∞[ = {p + s u : s > 0}` from `p`
(`RamcovGX.tex:2282`), `u` the future null direction of `Δ`. -/
def btzRay (p : Causal.Minkowski 2) : Set (Causal.Minkowski 2) :=
  {q | ∃ s : ℝ, 0 < s ∧ q = p + s • nullToMink nullU}

/-- The point of `Δ` at parameter `s`. -/
noncomputable abbrev btzPt (s : ℝ) : Causal.Minkowski 2 := nullToMink (x₀ + s • nullU)

theorem mem_btzLine_iff {p : Causal.Minkowski 2} : p ∈ btzLine x₀ ↔ ∃ s : ℝ, p = btzPt x₀ s := by
  simp only [btzLine, mem_range, eq_comm]

theorem btzRay_btzPt (s : ℝ) :
    btzRay (btzPt x₀ s) = {q | ∃ s' : ℝ, s < s' ∧ q = btzPt x₀ s'} := by
  ext q
  simp only [btzRay, mem_setOf_eq]
  constructor
  · rintro ⟨σ, hσ, rfl⟩
    refine ⟨s + σ, by linarith, ?_⟩
    rw [btzPt, btzPt, ← map_smul, ← map_add, add_assoc, add_smul]
  · rintro ⟨s', hs, rfl⟩
    refine ⟨s' - s, by linarith, ?_⟩
    rw [btzPt, btzPt, ← map_smul, ← map_add, add_assoc, ← add_smul, add_sub_cancel]

/-- The generating sets `I⁺(p) ∪ ]p, +∞[`, `p ∈ Δ`. -/
def btzJGenSet (p : Causal.Minkowski 2) : Set (Causal.Minkowski 2) :=
  (Causal.minkowski 2).Iplus ⊤ {p} ∪ btzRay p

/-- **`J⁺(Δ)` with the BTZ topology** (`defi:BTZtop`), as a type: the points of `J⁺(Δ)`. -/
def BTZJplus : Type := {q : Causal.Minkowski 2 // q ∈ btzJplus x₀}

variable {x₀}

/-- The inclusion `J⁺(Δ) → 𝐌³`. -/
def BTZJplus.val (q : BTZJplus x₀) : Causal.Minkowski 2 := Subtype.val q

theorem BTZJplus.mem (q : BTZJplus x₀) : q.val ∈ btzJplus x₀ := Subtype.property q

/-- A point of `J⁺(Δ)`. -/
def BTZJplus.mk (q : Causal.Minkowski 2) (hq : q ∈ btzJplus x₀) : BTZJplus x₀ := ⟨q, hq⟩

@[simp] theorem BTZJplus.val_mk (q : Causal.Minkowski 2) (hq : q ∈ btzJplus x₀) :
    (BTZJplus.mk q hq).val = q := rfl

@[ext] theorem BTZJplus.ext {q q' : BTZJplus x₀} (h : q.val = q'.val) : q = q' := Subtype.ext h

theorem BTZJplus.val_injective : Injective (BTZJplus.val : BTZJplus x₀ → _) :=
  fun _ _ h => BTZJplus.ext h

variable (x₀)

/-- The topology `J⁺(Δ)` inherits from `𝐌³`. -/
@[reducible] def btzJSubTop : TopologicalSpace (BTZJplus x₀) :=
  TopologicalSpace.induced BTZJplus.val inferInstance

/-- The generators of `defi:BTZtop`: the traces on `J⁺(Δ)` of `I⁺(p) ∪ ]p,+∞[`, `p ∈ Δ`. -/
def btzJGen : Set (Set (BTZJplus x₀)) :=
  {S | ∃ p ∈ btzLine x₀, S = BTZJplus.val ⁻¹' btzJGenSet p}

/-- `defi:BTZtop` (`RamcovGX.tex:2281`) **specialised to the singular line `Δ = btzLine x₀` of the
BTZ model**: the BTZ topology on `J⁺(Δ)`, generated by the topology induced by `𝐌³` and the sets
`I⁺(p) ∪ ]p, +∞[`, `p ∈ Δ`, the ray taken along `u` (the coarsest topology finer than both; in
mathlib's order, the infimum). It is the general `btzLineTop (btzLine x₀)`
(`btzJTop_eq_btzLineTop`). -/
instance btzJTop : TopologicalSpace (BTZJplus x₀) :=
  btzJSubTop x₀ ⊓ TopologicalSpace.generateFrom (btzJGen x₀)

end BTZTop

/-! ### `defi:BTZtop` for every lightlike line `Δ` of `𝐌³` -/

section BTZTopLine

/-- **A lightlike line of `𝐌³`** (`RamcovGX.tex:2281`): `Δ = p₀ + ℝw` with `w ≠ 0` null. -/
def IsBTZLightlikeLine (Δ : Set (Causal.Minkowski 2)) : Prop :=
  ∃ p₀ w : Causal.Minkowski 2, w ≠ 0 ∧ Causal.Flat.minkQ w = 0 ∧
    Δ = range fun s : ℝ => p₀ + s • w

/-- **The relatively open future half-ray** `]p, +∞[` of `Δ` from `p` (`RamcovGX.tex:2282`): the
points of `Δ` in the causal future of `p`, other than `p` (for a lightlike line,
`{p + σw : σ > 0}`, `w` its future null direction, `btzLineRay_eq`). -/
def btzLineRay (Δ : Set (Causal.Minkowski 2)) (p : Causal.Minkowski 2) : Set (Causal.Minkowski 2) :=
  {q | q ∈ Δ ∧ (Causal.minkowski 2).le ⊤ p q ∧ q ≠ p}

/-- The generating sets `I⁺(p) ∪ ]p, +∞[` of the BTZ topology of `J⁺(Δ)`. -/
def btzLineGenSet (Δ : Set (Causal.Minkowski 2)) (p : Causal.Minkowski 2) :
    Set (Causal.Minkowski 2) :=
  (Causal.minkowski 2).Iplus ⊤ {p} ∪ btzLineRay Δ p

/-- **`J⁺(Δ)`, as a type**, for a subset `Δ` of `𝐌³` (`defi:BTZtop`: `Δ` a lightlike line). -/
def BTZLineJplus (Δ : Set (Causal.Minkowski 2)) : Type :=
  {q : Causal.Minkowski 2 // q ∈ (Causal.minkowski 2).Jplus ⊤ Δ}

/-- The inclusion `J⁺(Δ) → 𝐌³`. -/
def BTZLineJplus.val {Δ : Set (Causal.Minkowski 2)} (q : BTZLineJplus Δ) : Causal.Minkowski 2 :=
  Subtype.val q

/-- The generators: the traces on `J⁺(Δ)` of `I⁺(p) ∪ ]p, +∞[`, `p ∈ Δ`. -/
def btzLineGen (Δ : Set (Causal.Minkowski 2)) : Set (Set (BTZLineJplus Δ)) :=
  {S | ∃ p ∈ Δ, S = BTZLineJplus.val ⁻¹' btzLineGenSet Δ p}

/-- **`defi:BTZtop`** (`RamcovGX.tex:2281`) **for every lightlike line `Δ`**: the BTZ topology on
`J⁺(Δ)`, generated by the topology induced by `𝐌³` and the sets `I⁺(p) ∪ ]p, +∞[`, `p ∈ Δ` (the
coarsest topology finer than both: in mathlib's order, the infimum). -/
instance btzLineTop (Δ : Set (Causal.Minkowski 2)) : TopologicalSpace (BTZLineJplus Δ) :=
  TopologicalSpace.induced BTZLineJplus.val inferInstance ⊓
    TopologicalSpace.generateFrom (btzLineGen Δ)

variable {Δ : Set (Causal.Minkowski 2)}

/-- A lightlike line has a **future** null direction: `Δ = p₀ + ℝw` with `w₀ > 0`, `w` null. -/
theorem IsBTZLightlikeLine.exists_future (hΔ : IsBTZLightlikeLine Δ) :
    ∃ p₀ w : Causal.Minkowski 2, 0 < w.1 ∧ Causal.Flat.minkQ w = 0 ∧
      Δ = range fun s : ℝ => p₀ + s • w := by
  obtain ⟨p₀, w, hw0, hwq, rfl⟩ := hΔ
  have h1 : w.1 ≠ 0 := fun h => hw0 (Causal.Flat.eq_zero_of_fst_eq_zero h hwq.le)
  rcases h1.lt_or_gt with h | h
  · refine ⟨p₀, -w, by simp only [Prod.fst_neg]; linarith, by rw [Causal.Flat.minkQ_neg, hwq], ?_⟩
    ext q
    simp only [mem_range]
    constructor
    · rintro ⟨s, rfl⟩; exact ⟨-s, by rw [smul_neg, neg_smul, neg_neg]⟩
    · rintro ⟨s, rfl⟩; exact ⟨-s, by rw [smul_neg, neg_smul]⟩
  · exact ⟨p₀, w, h, hwq, rfl⟩

/-- **The half-ray of a lightlike line, explicitly**: for `Δ = p₀ + ℝw`, `w` future null,
`]p, +∞[ = {p + σw : σ > 0}`. -/
theorem btzLineRay_eq {p₀ w : Causal.Minkowski 2} (hw : 0 < w.1) (hwq : Causal.Flat.minkQ w = 0)
    (hΔ : Δ = range fun s : ℝ => p₀ + s • w) {p : Causal.Minkowski 2} (hp : p ∈ Δ) :
    btzLineRay Δ p = {q | ∃ σ : ℝ, 0 < σ ∧ q = p + σ • w} := by
  subst hΔ
  obtain ⟨s, rfl⟩ := hp
  ext q
  simp only [btzLineRay, mem_setOf_eq, mem_range]
  constructor
  · rintro ⟨⟨s', rfl⟩, hle, hne⟩
    rw [Causal.Flat.le_top_iff_minkQ] at hle
    have hd : p₀ + s' • w - (p₀ + s • w) = (s' - s) • w := by rw [sub_smul]; abel
    rw [hd] at hle
    have h1 : 0 ≤ (s' - s) * w.1 := by
      have := hle.1; simpa only [Prod.smul_fst, smul_eq_mul] using this
    have hss : s ≤ s' := by
      by_contra hc; push Not at hc
      nlinarith
    have hne' : s ≠ s' := fun h => hne (by rw [h])
    refine ⟨s' - s, by
      rcases hss.lt_or_eq with h | h
      · linarith
      · exact absurd h hne', ?_⟩
    rw [add_assoc, ← add_smul, add_sub_cancel]
  · rintro ⟨σ, hσ, rfl⟩
    refine ⟨⟨s + σ, by rw [add_smul, add_assoc]⟩, ?_, ?_⟩
    · rw [Causal.Flat.le_top_iff_minkQ, add_sub_cancel_left]
      refine ⟨?_, by rw [Causal.Flat.minkQ_smul, hwq, mul_zero]⟩
      simp only [Prod.smul_fst, smul_eq_mul]
      positivity
    · intro h
      have h2 : σ • w = 0 := by
        have := congrArg (fun z => z - (p₀ + s • w)) h
        simpa only [add_sub_cancel_left, sub_self] using this
      have := congrArg Prod.fst h2
      simp only [Prod.smul_fst, smul_eq_mul, Prod.fst_zero] at this
      rcases mul_eq_zero.1 this with h | h
      · exact hσ.ne' h
      · exact hw.ne' h

/-- **`defi:BTZtop` for a lightlike line, explicitly**: the half-ray from every `p ∈ Δ` is
`{p + σw : σ > 0}` for the future null direction `w` of `Δ`. -/
theorem IsBTZLightlikeLine.btzLineRay_eq (hΔ : IsBTZLightlikeLine Δ) :
    ∃ w : Causal.Minkowski 2, 0 < w.1 ∧ Causal.Flat.minkQ w = 0 ∧
      ∀ p ∈ Δ, btzLineRay Δ p = {q | ∃ σ : ℝ, 0 < σ ∧ q = p + σ • w} := by
  obtain ⟨p₀, w, hw, hwq, hΔ'⟩ := hΔ.exists_future
  exact ⟨w, hw, hwq, fun p hp => GX.btzLineRay_eq hw hwq hΔ' hp⟩

theorem btzLineRay_subset (p : Causal.Minkowski 2) : btzLineRay Δ p ⊆ Δ := fun _ hq => hq.1

/-- **The generating sets lie in `J⁺(Δ)`** (`defi:BTZtop` presupposes it). -/
theorem btzLineGenSet_subset {p : Causal.Minkowski 2} (hp : p ∈ Δ) :
    btzLineGenSet Δ p ⊆ (Causal.minkowski 2).Jplus ⊤ Δ := by
  rintro q (hq | hq)
  · exact ⟨p, hp, (Causal.minkowski 2).le_of_lt (Causal.Precausality.mem_Iplus_singleton.1 hq)⟩
  · exact ⟨q, hq.1, (Causal.minkowski 2).le_refl (mem_univ q)⟩

/-- The BTZ topology of `J⁺(Δ)` is finer than the induced one. -/
theorem isOpen_btzLine_val_preimage {O : Set (Causal.Minkowski 2)} (hO : IsOpen O) :
    IsOpen (BTZLineJplus.val ⁻¹' O : Set (BTZLineJplus Δ)) :=
  (TopologicalSpace.le_def.1 (inf_le_left : btzLineTop Δ ≤ _)) _ ⟨O, hO, rfl⟩

/-- The generators `I⁺(p) ∪ ]p, +∞[`, `p ∈ Δ`, are open in the BTZ topology. -/
theorem isOpen_btzLine_gen {p : Causal.Minkowski 2} (hp : p ∈ Δ) :
    IsOpen (BTZLineJplus.val ⁻¹' btzLineGenSet Δ p : Set (BTZLineJplus Δ)) :=
  (TopologicalSpace.le_def.1 (inf_le_right : btzLineTop Δ ≤ _)) _
    (TopologicalSpace.isOpen_generateFrom_of_mem ⟨p, hp, rfl⟩)

/-- **`defi:BTZtop`, "generated by"**, for every `Δ`: a topology is finer than the BTZ topology
iff it is finer than the induced one and makes every `I⁺(p) ∪ ]p,+∞[`, `p ∈ Δ`, open. -/
theorem btzLineTop_le_iff (t : TopologicalSpace (BTZLineJplus Δ)) :
    t ≤ btzLineTop Δ ↔ t ≤ TopologicalSpace.induced BTZLineJplus.val inferInstance ∧
      ∀ p ∈ Δ, IsOpen[t] (BTZLineJplus.val ⁻¹' btzLineGenSet Δ p) := by
  rw [show btzLineTop Δ = TopologicalSpace.induced BTZLineJplus.val inferInstance ⊓
      TopologicalSpace.generateFrom (btzLineGen Δ) from rfl,
    le_inf_iff, TopologicalSpace.le_generateFrom_iff_subset_isOpen]
  refine and_congr_right fun _ => ⟨fun h p hp => h ⟨p, hp, rfl⟩, ?_⟩
  rintro h _ ⟨p, hp, rfl⟩
  exact h p hp

/-! #### The singular line of the BTZ model as a specialisation -/

/-- `Δ = x₀ + ℝu` is a lightlike line. -/
theorem isBTZLightlikeLine_btzLine (x₀ : ℝ × ℝ × ℝ) : IsBTZLightlikeLine (btzLine x₀) := by
  refine ⟨nullToMink x₀, nullToMink nullU, (linearPart_btzHol_nullU x₀ 1).2.2,
    (linearPart_btzHol_nullU x₀ 1).2.1, ?_⟩
  ext q
  simp only [btzLine, mem_range, map_add, map_smul]

theorem fst_nullToMink_nullU : (nullToMink nullU : Causal.Minkowski 2).1 = 1 / 2 := by
  simp [fst_nullToMink, nullU]

/-- **On `Δ = btzLine x₀` the half-ray of `defi:BTZtop` is the ray along `u`**:
`btzLineRay (btzLine x₀) p = btzRay p` for `p ∈ Δ`. -/
theorem btzLineRay_btzLine {x₀ : ℝ × ℝ × ℝ} {p : Causal.Minkowski 2} (hp : p ∈ btzLine x₀) :
    btzLineRay (btzLine x₀) p = btzRay p := by
  rw [GX.btzLineRay_eq (p₀ := nullToMink x₀) (w := nullToMink nullU)
    (by rw [fst_nullToMink_nullU]; norm_num) (linearPart_btzHol_nullU x₀ 1).2.1 ?_ hp]
  · ext q; simp only [btzRay, mem_setOf_eq]
  · ext q; simp only [btzLine, mem_range, map_add, map_smul]

/-- **The BTZ topology of `J⁺(btzLine x₀)` used throughout this file is `defi:BTZtop` for the
lightlike line `Δ = btzLine x₀`** (`BTZJplus x₀` is `BTZLineJplus (btzLine x₀)` by definition). -/
theorem btzJTop_eq_btzLineTop (x₀ : ℝ × ℝ × ℝ) :
    (btzJTop x₀ : TopologicalSpace (BTZJplus x₀)) = btzLineTop (btzLine x₀) := by
  show btzJSubTop x₀ ⊓ TopologicalSpace.generateFrom (btzJGen x₀) =
    TopologicalSpace.induced BTZLineJplus.val inferInstance ⊓
      TopologicalSpace.generateFrom (btzLineGen (btzLine x₀))
  congr 2
  ext S
  constructor
  · rintro ⟨p, hp, rfl⟩
    exact ⟨p, hp, by rw [btzLineGenSet, btzLineRay_btzLine hp]; rfl⟩
  · rintro ⟨p, hp, rfl⟩
    exact ⟨p, hp, by rw [btzLineGenSet, btzLineRay_btzLine hp]; rfl⟩

end BTZTopLine

/-! ### The cylinder in null coordinates -/

section Cyl

variable {x₀ v : ℝ × ℝ × ℝ}

theorem btzJ_continuous_r : Continuous DInfty.r := by
  refine DInfty.continuous_of_posEmb ?_ fun V hV => ?_
  · exact continuous_fst.comp continuous_subtype_val
  · obtain ⟨ε, hε, h⟩ := Metric.mem_nhds_iff.1 hV
    refine ⟨ε, hε, fun p hp => h ?_⟩
    rw [DInfty.apex_r, Metric.mem_ball, Real.dist_eq, sub_zero, abs_of_nonneg p.r_nonneg]
    exact hp

/-- The constant `κ = −nullQ(v)/⟨v|u⟩` of the developing map: `D(y) ∈ I⁺(p_s) ∪ ]p_s,+∞[` iff
`s < t + κ r` (`btzDevM_mem_genSet_iff`). -/
noncomputable def btzKappa (v : ℝ × ℝ × ℝ) : ℝ := (v.1 * v.2.1 - v.2.2 ^ 2) / v.2.1

theorem btzDev_sub_line (x₀ v : ℝ × ℝ × ℝ) (y : DInfty × ℝ) (s : ℝ) :
    btzDev x₀ v y - (x₀ + s • nullU) = (y.1.r * v.1 + 2 * (y.1.r * y.1.θ) * v.2.2 +
      y.1.r * y.1.θ ^ 2 * v.2.1 + y.2 - s, y.1.r * v.2.1, y.1.r * v.2.2 + y.1.r * y.1.θ * v.2.1) := by
  rw [btzDev_coords]
  ext <;> simp [nullU] <;> ring

theorem btzKappa_identity (hv : 0 < v.2.1) (r θ t s : ℝ) :
    (r * v.1 + 2 * (r * θ) * v.2.2 + r * θ ^ 2 * v.2.1 + t - s) * (r * v.2.1) -
      (r * v.2.2 + r * θ * v.2.1) ^ 2 = r * v.2.1 * (t - s + btzKappa v * r) := by
  unfold btzKappa
  field_simp
  ring

/-- **The generators pulled back to the cylinder**: `D(y) ∈ I⁺(p_s) ∪ ]p_s, +∞[` iff
`s < t + κ r`. -/
theorem btzDevM_mem_genSet_iff (hv : 0 < v.2.1) (y : DInfty × ℝ) (s : ℝ) :
    btzDevM x₀ v y ∈ btzJGenSet (btzPt x₀ s) ↔ s < y.2 + btzKappa v * y.1.r := by
  rw [btzJGenSet, btzRay_btzPt, mem_union, Causal.Precausality.mem_Iplus_singleton, btzDevM,
    btzJ_lt_iff, btzDev_sub_line]
  simp only [mem_setOf_eq]
  rcases y.1.pos_or_eq_apex with hr | hr
  · have hb : 0 < y.1.r * v.2.1 := mul_pos hr hv
    have hid := btzKappa_identity hv y.1.r y.1.θ y.2 s
    have hray : ¬ ∃ s', s < s' ∧ nullToMink (btzDev x₀ v y) = btzPt x₀ s' := by
      rintro ⟨s', -, h⟩
      have h2 := congrArg (fun z => z.2.1) (nullToMink.injective h)
      rw [btzDev_coords] at h2
      simp [nullU] at h2
      rcases h2 with h2 | h2
      · exact hr.ne' h2
      · exact hv.ne' h2
    simp only [hray, or_false]
    constructor
    · rintro ⟨-, -, h3⟩
      have : 0 < y.1.r * v.2.1 * (y.2 - s + btzKappa v * y.1.r) := by linarith
      have := pos_of_mul_pos_right this hb.le
      linarith
    · intro h
      have h3 : 0 < y.1.r * v.2.1 * (y.2 - s + btzKappa v * y.1.r) := mul_pos hb (by linarith)
      have hsq := sq_nonneg (y.1.r * v.2.2 + y.1.r * y.1.θ * v.2.1)
      refine ⟨?_, hb, by linarith⟩
      by_contra hc; push Not at hc
      nlinarith
  · obtain ⟨p, t⟩ := y
    simp only at hr
    subst hr
    simp only [DInfty.apex_r, DInfty.apex_θ, zero_mul, mul_zero, add_zero, zero_add,
      lt_self_iff_false, false_and, and_false, false_or]
    constructor
    · rintro ⟨s', hs, h⟩
      rw [btzDev_apex] at h
      have h1 := congrArg (fun z => z.1) (nullToMink.injective h)
      simp [nullU] at h1
      linarith
    · intro h
      exact ⟨t, by linarith, by rw [btzDev_apex]⟩

/-- **The causal future of a point of `Δ`, pulled back to the cylinder**: `D(y) ∈ J⁺(p_s)` iff
`s ≤ t + κ r`. -/
theorem btzDevM_mem_Jplus_iff (hv : 0 < v.2.1) (y : DInfty × ℝ) (s : ℝ) :
    btzDevM x₀ v y ∈ (Causal.minkowski 2).Jplus ⊤ {btzPt x₀ s} ↔ s ≤ y.2 + btzKappa v * y.1.r := by
  rw [Causal.Precausality.mem_Jplus_singleton, btzDevM, btzJ_le_iff, btzDev_sub_line]
  rcases y.1.pos_or_eq_apex with hr | hr
  · have hb : 0 < y.1.r * v.2.1 := mul_pos hr hv
    have hid := btzKappa_identity hv y.1.r y.1.θ y.2 s
    constructor
    · rintro ⟨-, -, h3⟩
      have : 0 ≤ y.1.r * v.2.1 * (y.2 - s + btzKappa v * y.1.r) := by linarith
      have := nonneg_of_mul_nonneg_right this hb
      linarith
    · intro h
      have h3 : 0 ≤ y.1.r * v.2.1 * (y.2 - s + btzKappa v * y.1.r) :=
        mul_nonneg hb.le (by linarith)
      have hsq := sq_nonneg (y.1.r * v.2.2 + y.1.r * y.1.θ * v.2.1)
      refine ⟨?_, hb.le, by linarith⟩
      by_contra hc; push Not at hc
      nlinarith
  · obtain ⟨p, t⟩ := y
    simp only at hr
    subst hr
    simp only [DInfty.apex_r, DInfty.apex_θ, zero_mul, mul_zero, add_zero, zero_add, le_refl,
      true_and]
    constructor
    · rintro ⟨h, -⟩; linarith
    · intro h; exact ⟨by linarith, by simp⟩

theorem isOpen_btz_kappa_lt (s : ℝ) :
    IsOpen {y : DInfty × ℝ | s < y.2 + btzKappa v * y.1.r} :=
  isOpen_lt continuous_const (continuous_snd.add
    (continuous_const.mul (btzJ_continuous_r.comp continuous_fst)))

/-- The upper vertex `P_η = x₀ + (t + η, η, 0)` (null coordinates) of the axis diamonds. -/
noncomputable def btzTopVertex (x₀ : ℝ × ℝ × ℝ) (t η : ℝ) : Causal.Minkowski 2 :=
  nullToMink (x₀ + (t + η, η, 0))

theorem btzPt_lt_btzTopVertex (x₀ : ℝ × ℝ × ℝ) (t : ℝ) {η : ℝ} (hη : 0 < η) :
    (Causal.minkowski 2).lt ⊤ (btzPt x₀ t) (btzTopVertex x₀ t η) := by
  rw [btzPt, btzTopVertex, btzJ_lt_iff]
  simp only [nullU, Prod.fst_sub, Prod.fst_add, Prod.smul_fst, smul_eq_mul, mul_one,
    Prod.snd_sub, Prod.snd_add, Prod.smul_snd, mul_zero]
  refine ⟨by linarith, by linarith, by nlinarith⟩

/-- **The axis estimate**: the diamond `J⁺(p_{t−η}) ∩ J⁻(P_η)`, pulled back to the cylinder, lies
in the horn neighbourhood `{r(1+θ²) < ε, |t'−t| < ε}` for `η` small. -/
theorem btz_axis_diamond (hv : 0 < v.2.1) (t : ℝ) {ε : ℝ} (hε : 0 < ε) :
    ∃ η > 0, ∀ y : DInfty × ℝ, (Causal.minkowski 2).le ⊤ (btzDevM x₀ v y) (btzTopVertex x₀ t η) →
      t - η ≤ y.2 + btzKappa v * y.1.r → y ∈ hornNhd t ε := by
  set b := v.2.1
  set c := v.2.2
  set κ := btzKappa v
  set K : ℝ := 2 + 5 / b + 2 * c ^ 2 / b ^ 3 + |κ| / b with hK
  have hKpos : 0 < K := by
    have : 0 ≤ 2 * c ^ 2 / b ^ 3 := by positivity
    have : 0 ≤ |κ| / b := by positivity
    have : 0 < 5 / b := by positivity
    linarith
  refine ⟨ε / K, by positivity, fun y hle hlow => ?_⟩
  set η := ε / K with hη
  have hηpos : 0 < η := by positivity
  rw [btzDevM, btzTopVertex, btzJ_le_iff] at hle
  obtain ⟨h1, h2, -⟩ := hle
  rw [btzDev_coords] at h1 h2
  simp only [Prod.fst_sub, Prod.fst_add, Prod.snd_sub, Prod.snd_add] at h1 h2
  set r := y.1.r
  set θ := y.1.θ
  set t' := y.2
  have hr : 0 ≤ r := y.1.r_nonneg
  -- `r b ≤ η`
  have hrb : r * b ≤ η := by linarith
  have hrle : r ≤ η / b := by rw [le_div_iff₀ hv]; linarith
  -- `κ b = a b − c²`
  have hκ : κ * b = v.1 * b - c ^ 2 := div_mul_cancel₀ _ hv.ne'
  -- the key inequality `r (c + θ b)² ≤ 2 η b`
  have hkey : r * (c + θ * b) ^ 2 ≤ 2 * η * b := by
    have e1 : b * (r * v.1 + 2 * (r * θ) * c + r * θ ^ 2 * b) =
        (v.1 * b - c ^ 2) * r + r * (c + θ * b) ^ 2 := by ring
    have h1' : r * v.1 + 2 * (r * θ) * c + r * θ ^ 2 * b ≤ t + η - t' := by linarith
    have h4 : (t - η) * b ≤ t' * b + κ * b * r := by nlinarith
    nlinarith
  -- `r θ² b² ≤ 4 η b + 2 c² η / b`
  have hθ : r * θ ^ 2 * b ^ 2 ≤ 4 * η * b + 2 * c ^ 2 * (η / b) := by
    have hsq : (θ * b) ^ 2 ≤ 2 * (c + θ * b) ^ 2 + 2 * c ^ 2 := by nlinarith [sq_nonneg (c + θ * b + c)]
    have := mul_le_mul_of_nonneg_left hsq hr
    have hc2 : 2 * r * c ^ 2 ≤ 2 * c ^ 2 * (η / b) := by nlinarith [sq_nonneg c]
    nlinarith
  have hθ' : r * θ ^ 2 ≤ η * (4 / b + 2 * c ^ 2 / b ^ 3) := by
    have hb2 : 0 < b ^ 2 := by positivity
    rw [← mul_le_mul_iff_of_pos_right hb2]
    have : η * (4 / b + 2 * c ^ 2 / b ^ 3) * b ^ 2 = 4 * η * b + 2 * c ^ 2 * (η / b) := by
      field_simp
    rw [this]; linarith
  have hκr : |κ * r| ≤ |κ| * (η / b) := by
    rw [abs_mul, abs_of_nonneg hr]; exact mul_le_mul_of_nonneg_left hrle (abs_nonneg _)
  -- the upper bound on `t'`
  have hup : t' - t ≤ η - κ * r := by
    have e1 : b * (r * v.1 + 2 * (r * θ) * c + r * θ ^ 2 * b) =
        (v.1 * b - c ^ 2) * r + r * (c + θ * b) ^ 2 := by ring
    have hpos : 0 ≤ r * (c + θ * b) ^ 2 := mul_nonneg hr (sq_nonneg _)
    have h1' : r * v.1 + 2 * (r * θ) * c + r * θ ^ 2 * b ≤ t + η - t' := by linarith
    have : κ * r ≤ r * v.1 + 2 * (r * θ) * c + r * θ ^ 2 * b := by
      have : κ * r * b ≤ (r * v.1 + 2 * (r * θ) * c + r * θ ^ 2 * b) * b := by nlinarith
      exact le_of_mul_le_mul_right this hv
    linarith
  have hab' := abs_le.1 hκr
  have hKη : η * K = ε := by rw [hη]; field_simp
  refine ⟨?_, ?_⟩
  · show r * (1 + θ ^ 2) < ε
    have : r * (1 + θ ^ 2) ≤ η * (1 / b + 4 / b + 2 * c ^ 2 / b ^ 3) := by
      have : r ≤ η * (1 / b) := by rw [mul_one_div]; exact hrle
      nlinarith
    have hlt : η * (1 / b + 4 / b + 2 * c ^ 2 / b ^ 3) < η * K := by
      refine mul_lt_mul_of_pos_left ?_ hηpos
      have : 0 ≤ |κ| / b := by positivity
      rw [hK]
      have : 1 / b + 4 / b = 5 / b := by ring
      linarith
    linarith
  · show |t' - t| < ε
    have hb1 : |κ| * (η / b) = η * (|κ| / b) := by ring
    have hlt : η + η * (|κ| / b) < η * K := by
      have : η * K = η * 2 + η * (5 / b) + η * (2 * c ^ 2 / b ^ 3) + η * (|κ| / b) := by
        rw [hK]; ring
      have : 0 < η * (5 / b) := by positivity
      have : 0 ≤ η * (2 * c ^ 2 / b ^ 3) := by positivity
      linarith
    rw [abs_lt]
    constructor <;> linarith

end Cyl

/-! ### `D : (\widetilde{𝔼₀}, T_BTZ) → (J⁺(Δ), BTZ)` is a homeomorphism -/

section Homeo

variable {x₀ v : ℝ × ℝ × ℝ}

theorem btzDevM_mem_btzJplus (hv : 0 < v.2.1) (y : DInfty × ℝ) : btzDevM x₀ v y ∈ btzJplus x₀ := by
  rw [btzJplus, ← range_btzDevM x₀ hv]; exact mem_range_self y

variable (x₀ v) in
/-- **The developing map as a map to `J⁺(Δ)`**, `D : 𝔻_∞ × ℝ → J⁺(Δ)`. -/
noncomputable def btzJDev (hv : 0 < v.2.1) (y : DInfty × ℝ) : BTZJplus x₀ :=
  BTZJplus.mk (btzDevM x₀ v y) (btzDevM_mem_btzJplus hv y)

@[simp] theorem btzJDev_val (hv : 0 < v.2.1) (y : DInfty × ℝ) :
    (btzJDev x₀ v hv y).val = btzDevM x₀ v y := rfl

theorem btzJDev_injective (hv : 0 < v.2.1) : Injective (btzJDev x₀ v hv) := fun _ _ h =>
  btzDevM_injective x₀ hv (congrArg BTZJplus.val h)

theorem btzJDev_surjective (hv : 0 < v.2.1) : Surjective (btzJDev x₀ v hv) := by
  intro q
  have hq : q.val ∈ range (btzDevM x₀ v) := by rw [range_btzDevM x₀ hv]; exact q.mem
  obtain ⟨y, hy⟩ := hq
  exact ⟨y, BTZJplus.ext hy⟩

theorem nhds_btzJ (q : BTZJplus x₀) :
    𝓝 q = comap BTZJplus.val (𝓝 q.val) ⊓
      @nhds _ (TopologicalSpace.generateFrom (btzJGen x₀)) q := by
  calc 𝓝 q = @nhds _ (btzJSubTop x₀ ⊓ TopologicalSpace.generateFrom (btzJGen x₀)) q := rfl
    _ = @nhds _ (btzJSubTop x₀) q ⊓ @nhds _ (TopologicalSpace.generateFrom (btzJGen x₀)) q :=
        @nhds_inf _ (btzJSubTop x₀) (TopologicalSpace.generateFrom (btzJGen x₀)) q
    _ = _ := by rw [nhds_induced]

/-- The BTZ topology is finer than the induced one. -/
theorem isOpen_btzJ_val_preimage {O : Set (Causal.Minkowski 2)} (hO : IsOpen O) :
    IsOpen (BTZJplus.val ⁻¹' O : Set (BTZJplus x₀)) :=
  (TopologicalSpace.le_def.1 (inf_le_left : btzJTop x₀ ≤ btzJSubTop x₀)) _ ⟨O, hO, rfl⟩

/-- The generators of `defi:BTZtop` are open. -/
theorem isOpen_btzJ_gen {p : Causal.Minkowski 2} (hp : p ∈ btzLine x₀) :
    IsOpen (BTZJplus.val ⁻¹' btzJGenSet p : Set (BTZJplus x₀)) :=
  (TopologicalSpace.le_def.1 (inf_le_right : btzJTop x₀ ≤ _)) _
    (TopologicalSpace.isOpen_generateFrom_of_mem ⟨p, hp, rfl⟩)

/-- `D` is continuous from `T_BTZ` to the BTZ topology. -/
theorem continuous_btzJDev (hv : 0 < v.2.1) :
    Continuous[hornTop, btzJTop x₀] (btzJDev x₀ v hv) := by
  have h1 : Continuous[hornTop, btzJSubTop x₀] (btzJDev x₀ v hv) :=
    continuous_induced_rng.2 (by exact continuous_btzDevM_hornTop x₀ hv)
  have key : btzJTop x₀ = btzJSubTop x₀ ⊓ TopologicalSpace.generateFrom (btzJGen x₀) := rfl
  rw [key]
  refine continuous_inf_rng.2 ⟨h1, continuous_generateFrom_iff.2 ?_⟩
  rintro _ ⟨p, hp, rfl⟩
  obtain ⟨s, rfl⟩ := (mem_btzLine_iff x₀).1 hp
  have : btzJDev x₀ v hv ⁻¹' (BTZJplus.val ⁻¹' btzJGenSet (btzPt x₀ s)) =
      {y | s < y.2 + btzKappa v * y.1.r} := by
    ext y; exact btzDevM_mem_genSet_iff hv y s
  rw [this]
  exact (TopologicalSpace.le_def.1 hornTop_le) _ (isOpen_btz_kappa_lt s)

/-- **`D` is open onto `J⁺(Δ)` with the BTZ topology**: every `T_BTZ`-neighbourhood `N` of `y`
contains `D⁻¹ W` for a BTZ-neighbourhood `W` of `D(y)`. -/
theorem btzJDev_nhds (hv : 0 < v.2.1) (y : DInfty × ℝ) {N : Set (DInfty × ℝ)}
    (hN : N ∈ @nhds _ hornTop y) :
    ∃ W ∈ 𝓝 (btzJDev x₀ v hv y), ∀ y', btzJDev x₀ v hv y' ∈ W → y' ∈ N := by
  rcases y.1.pos_or_eq_apex with hr | hr
  · rw [nhds_hornTop_of_pos hr] at hN
    have hD : btzDevM x₀ v '' N ∈ 𝓝 (btzDevM x₀ v y) := by
      rw [← (isLocalHomeomorphOn_btzDevM x₀ hv).map_nhds_eq hr]
      exact image_mem_map hN
    refine ⟨BTZJplus.val ⁻¹' (btzDevM x₀ v '' N), ?_, fun y' hy' => ?_⟩
    · rw [nhds_btzJ]
      exact mem_inf_of_left (preimage_mem_comap hD)
    · obtain ⟨z, hz, hzy⟩ := hy'
      rwa [← btzDevM_injective x₀ hv hzy]
  · obtain ⟨p, t⟩ := y
    simp only at hr
    subst hr
    obtain ⟨ε, hε, hεN⟩ := (hasBasis_nhds_hornTop_apex t).mem_iff.1 hN
    obtain ⟨η, hη, hdiam⟩ := btz_axis_diamond (x₀ := x₀) hv t hε
    have hDy : btzDevM x₀ v (DInfty.apex, t) = btzPt x₀ t := btzDevM_apex x₀ v t
    refine ⟨BTZJplus.val ⁻¹' ((Causal.minkowski 2).Iminus ⊤ {btzTopVertex x₀ t η}) ∩
      BTZJplus.val ⁻¹' btzJGenSet (btzPt x₀ (t - η)), inter_mem ?_ ?_, fun y' hy' => ?_⟩
    · refine (isOpen_btzJ_val_preimage
        (Causal.Causality.isOpen_Iminus (C := Causal.minkowski 2))).mem_nhds ?_
      rw [mem_preimage, btzJDev_val, hDy, Causal.Precausality.mem_Iminus_singleton]
      exact btzPt_lt_btzTopVertex x₀ t hη
    · refine (isOpen_btzJ_gen ((mem_btzLine_iff x₀).2 ⟨_, rfl⟩)).mem_nhds ?_
      rw [mem_preimage, btzJDev_val, btzDevM_mem_genSet_iff hv]
      simp only [DInfty.apex_r, mul_zero, add_zero]
      linarith
    · obtain ⟨h1, h2⟩ := hy'
      simp only [mem_preimage, btzJDev_val, Causal.Precausality.mem_Iminus_singleton] at h1 h2
      rw [btzDevM_mem_genSet_iff hv] at h2
      exact hεN (hdiam y' ((Causal.minkowski 2).le_of_lt h1) h2.le)

variable (x₀ v) in
/-- `D` as an equivalence `𝔻_∞ × ℝ ≃ J⁺(Δ)`. -/
noncomputable def btzJDevEquiv (hv : 0 < v.2.1) : (DInfty × ℝ) ≃ BTZJplus x₀ :=
  Equiv.ofBijective (btzJDev x₀ v hv) ⟨btzJDev_injective hv, btzJDev_surjective hv⟩

@[simp] theorem btzJDevEquiv_apply (hv : 0 < v.2.1) (y : DInfty × ℝ) :
    btzJDevEquiv x₀ v hv y = btzJDev x₀ v hv y := rfl

theorem continuous_btzJDevEquiv_symm (hv : 0 < v.2.1) :
    Continuous[btzJTop x₀, hornTop] (btzJDevEquiv x₀ v hv).symm := by
  refine @continuous_iff_continuousAt _ _ _ hornTop _ |>.2 fun q => ?_
  obtain ⟨y, rfl⟩ := btzJDev_surjective (x₀ := x₀) hv q
  show Tendsto _ (𝓝 _) (@nhds _ hornTop _)
  rw [← btzJDevEquiv_apply hv y, Equiv.symm_apply_apply]
  refine tendsto_def.2 fun N hN => ?_
  obtain ⟨W, hW, hWN⟩ := btzJDev_nhds (x₀ := x₀) hv y hN
  refine mem_of_superset hW fun q' hq' => ?_
  obtain ⟨y', rfl⟩ := btzJDev_surjective (x₀ := x₀) hv q'
  show (btzJDevEquiv x₀ v hv).symm (btzJDevEquiv x₀ v hv y') ∈ N
  rw [Equiv.symm_apply_apply]
  exact hWN y' hq'

variable (x₀ v) in
/-- **`D : (\widetilde{𝔼₀}, T_BTZ) ≃ₜ (J⁺(Δ), BTZ)`** (the motivation of `defi:BTZtop`,
`RamcovGX.tex:2279`: "to force this map to be a homeomorphism"), on the cylinder model
`𝔻_∞ × ℝ` of `\widetilde{𝔼₀}` with `T_BTZ = hornTop`. -/
noncomputable def btzJDevHomeomorph (hv : 0 < v.2.1) :
    @Homeomorph (DInfty × ℝ) (BTZJplus x₀) hornTop (btzJTop x₀) :=
  @Homeomorph.mk _ _ hornTop (btzJTop x₀) (btzJDevEquiv x₀ v hv) (continuous_btzJDev hv)
    (continuous_btzJDevEquiv_symm hv)

@[simp] theorem btzJDevHomeomorph_apply (hv : 0 < v.2.1) (y : DInfty × ℝ) :
    btzJDevHomeomorph x₀ v hv y = btzJDev x₀ v hv y := rfl

end Homeo

/-! ### `defi:BTZtop` characterised -/

section BTZTopChar

variable {x₀ v : ℝ × ℝ × ℝ}

/-- **`defi:BTZtop`, "generated by"**: a topology is finer than the BTZ topology iff it is finer
than the topology induced by `𝐌³` and makes every `I⁺(p) ∪ ]p,+∞[`, `p ∈ Δ`, open. -/
theorem btzJTop_le_iff (t : TopologicalSpace (BTZJplus x₀)) :
    t ≤ btzJTop x₀ ↔ t ≤ btzJSubTop x₀ ∧ ∀ p ∈ btzLine x₀, IsOpen[t] (BTZJplus.val ⁻¹' btzJGenSet p) := by
  rw [show btzJTop x₀ = btzJSubTop x₀ ⊓ TopologicalSpace.generateFrom (btzJGen x₀) from rfl,
    le_inf_iff, TopologicalSpace.le_generateFrom_iff_subset_isOpen]
  refine and_congr_right fun _ => ⟨fun h p hp => h ⟨p, hp, rfl⟩, ?_⟩
  rintro h _ ⟨p, hp, rfl⟩
  exact h p hp

/-- **The BTZ topology is the image by `D` of `T_BTZ`** (`RamcovGX.tex:2279`: "one has to add to
the topology of `J⁺(Δ)` the image by `D` of neighborhood basis of points in `{r = 0}`"). -/
theorem btzJTop_eq_coinduced (hv : 0 < v.2.1) :
    btzJTop x₀ = TopologicalSpace.coinduced (btzJDev x₀ v hv) hornTop :=
  (@Homeomorph.coinduced_eq _ _ hornTop (btzJTop x₀) (btzJDevHomeomorph x₀ v hv)).symm

end BTZTopChar

/-! ### `Γ` acts on `J⁺(Δ)` by the holonomy; the quotient map `D̄` -/

section Action

variable {x₀ v : ℝ × ℝ × ℝ} {α : ℝ}

theorem btzHolHom_smul_mem (x₀ : ℝ × ℝ × ℝ) (α : ℝ) (k : GammaA α) {q : Causal.Minkowski 2}
    (hq : q ∈ btzJplus x₀) : btzHolHom x₀ α k • q ∈ btzJplus x₀ := by
  have : q ∈ range (btzDevM x₀ btzV0) := by rw [range_btzDevM x₀ btzV0_pos]; exact hq
  obtain ⟨y, rfl⟩ := this
  rw [btzJplus, ← range_btzDevM x₀ btzV0_pos]
  exact ⟨k • y, btzDevM_smul x₀ btzV0 k y⟩

/-- **`Γ = Γ_α` acts on `J⁺(Δ)` through the holonomy** `ρ(k) = btzHol^k` (`RamcovGX.tex:2270`,
`Γ\J⁺(Δ)`). -/
noncomputable instance btzJAction (x₀ : ℝ × ℝ × ℝ) (α : ℝ) : MulAction (GammaA α) (BTZJplus x₀) where
  smul k q := BTZJplus.mk (btzHolHom x₀ α k • q.val) (btzHolHom_smul_mem x₀ α k q.mem)
  one_smul q := BTZJplus.ext (by
    show btzHolHom x₀ α 1 • q.val = q.val
    rw [map_one, one_smul])
  mul_smul a b q := BTZJplus.ext (by
    show btzHolHom x₀ α (a * b) • q.val = btzHolHom x₀ α a • (btzHolHom x₀ α b • q.val)
    rw [map_mul, mul_smul])

theorem btzJ_smul_val (k : GammaA α) (q : BTZJplus x₀) :
    (k • q).val = btzHolHom x₀ α k • q.val := rfl

/-- `D` is `Γ`-equivariant. -/
theorem btzJDev_smul (hv : 0 < v.2.1) (k : GammaA α) (y : DInfty × ℝ) :
    btzJDev x₀ v hv (k • y) = k • btzJDev x₀ v hv y :=
  BTZJplus.ext (btzDevM_smul x₀ v k y)

theorem btzJDevEquiv_symm_smul (hv : 0 < v.2.1) (k : GammaA α) (q : BTZJplus x₀) :
    (btzJDevEquiv x₀ v hv).symm (k • q) = k • (btzJDevEquiv x₀ v hv).symm q := by
  apply (btzJDevEquiv x₀ v hv).injective
  rw [Equiv.apply_symm_apply, btzJDevEquiv_apply, btzJDev_smul, ← btzJDevEquiv_apply,
    Equiv.apply_symm_apply]

/-- `Γ` acts on `J⁺(Δ)` by BTZ-homeomorphisms. -/
instance btzJ_continuousConstSMul : ContinuousConstSMul (GammaA α) (BTZJplus x₀) := by
  refine ⟨fun k => ?_⟩
  have he : (fun q : BTZJplus x₀ => k • q) = btzJDev x₀ btzV0 btzV0_pos ∘ (fun y => k • y) ∘
      (btzJDevEquiv x₀ btzV0 btzV0_pos).symm := by
    funext q
    show k • q = btzJDevEquiv x₀ btzV0 btzV0_pos (k • (btzJDevEquiv x₀ btzV0 btzV0_pos).symm q)
    rw [btzJDevEquiv_apply, btzJDev_smul, ← btzJDevEquiv_apply, Equiv.apply_symm_apply]
  rw [he]
  exact @Continuous.comp _ _ _ _ hornTop _ _ _ (continuous_btzJDev btzV0_pos)
    (@Continuous.comp _ _ _ _ hornTop hornTop _ _ (continuous_smul_hornTop k)
      (continuous_btzJDevEquiv_symm btzV0_pos))

/-- `T_BTZ` induces on `𝔼₀` its quotient topology (`prop:BTZ_virt_tame`, Model/SpreadTop). -/
theorem btz_coinduced_hornTop (hα : α ≠ 0) :
    TopologicalSpace.coinduced (orbitMk (GammaA α)) hornTop =
      (inferInstance : TopologicalSpace (BTZModel α)) := by
  have h := coinduced_orbitMk_tamTop (W := univ) hα isOpen_univ
  rwa [tamTop_univ] at h

variable (x₀ v) in
/-- **The map `D̄ : 𝔼₀ → Γ\J⁺(Δ)`** induced by the developing map (`RamcovGX.tex:2270`). -/
noncomputable def btzQuotDev (hv : 0 < v.2.1) (α : ℝ) :
    BTZModel α → Orbits (GammaA α) (BTZJplus x₀) :=
  Quotient.lift (fun y => orbitMk (GammaA α) (btzJDev x₀ v hv y)) fun a b h => by
    obtain ⟨k, rfl⟩ := MulAction.mem_orbit_iff.1 (MulAction.orbitRel_apply.1 h)
    show orbitMk (GammaA α) (btzJDev x₀ v hv (k • b)) = _
    rw [btzJDev_smul, orbitMk_smul]

variable (x₀ v) in
/-- The inverse of `D̄`. -/
noncomputable def btzQuotDevInv (hv : 0 < v.2.1) (α : ℝ) :
    Orbits (GammaA α) (BTZJplus x₀) → BTZModel α :=
  Quotient.lift (fun q => orbitMk (GammaA α) ((btzJDevEquiv x₀ v hv).symm q)) fun a b h => by
    obtain ⟨k, rfl⟩ := MulAction.mem_orbit_iff.1 (MulAction.orbitRel_apply.1 h)
    show orbitMk (GammaA α) ((btzJDevEquiv x₀ v hv).symm (k • b)) = _
    rw [btzJDevEquiv_symm_smul, orbitMk_smul]

@[simp] theorem btzQuotDev_mk (hv : 0 < v.2.1) (y : DInfty × ℝ) :
    btzQuotDev x₀ v hv α (orbitMk (GammaA α) y) = orbitMk (GammaA α) (btzJDev x₀ v hv y) := rfl

@[simp] theorem btzQuotDevInv_mk (hv : 0 < v.2.1) (q : BTZJplus x₀) :
    btzQuotDevInv x₀ v hv α (orbitMk (GammaA α) q) =
      orbitMk (GammaA α) ((btzJDevEquiv x₀ v hv).symm q) := rfl

variable (x₀ v) in
/-- **`D̄ : 𝔼₀ ≃ₜ Γ\J⁺(Δ)`**, `J⁺(Δ)` with the BTZ topology (`prop:quotient_chart`, its topological
half): `D̄` is a homeomorphism. -/
noncomputable def btzQuotDevHomeomorph (hv : 0 < v.2.1) (hα : α ≠ 0) :
    BTZModel α ≃ₜ Orbits (GammaA α) (BTZJplus x₀) where
  toFun := btzQuotDev x₀ v hv α
  invFun := btzQuotDevInv x₀ v hv α
  left_inv x := by
    induction x using Quotient.inductionOn with | h y => ?_
    show orbitMk (GammaA α) ((btzJDevEquiv x₀ v hv).symm (btzJDevEquiv x₀ v hv y)) = _
    rw [Equiv.symm_apply_apply]
  right_inv x := by
    induction x using Quotient.inductionOn with | h q => ?_
    show orbitMk (GammaA α) (btzJDevEquiv x₀ v hv ((btzJDevEquiv x₀ v hv).symm q)) = _
    rw [Equiv.apply_symm_apply]
  continuous_toFun := by
    have hc : Continuous[hornTop, inferInstance]
        (btzQuotDev x₀ v hv α ∘ orbitMk (GammaA α)) := by
      have : btzQuotDev x₀ v hv α ∘ orbitMk (GammaA α) =
          orbitMk (GammaA α) ∘ btzJDev x₀ v hv := rfl
      rw [this]
      exact @Continuous.comp _ _ _ hornTop _ _ _ _ continuous_quot_mk (continuous_btzJDev hv)
    have := (@continuous_coinduced_dom _ _ _ (orbitMk (GammaA α)) _ hornTop _).2 hc
    rwa [btz_coinduced_hornTop hα] at this
  continuous_invFun := by
    refine Continuous.quotient_lift ?_ _
    have hq : Continuous[hornTop, inferInstance] (orbitMk (GammaA α) : DInfty × ℝ → BTZModel α) := by
      have := @continuous_coinduced_rng _ _ (orbitMk (GammaA α)) hornTop
      rwa [btz_coinduced_hornTop hα] at this
    exact @Continuous.comp _ _ _ _ hornTop _ _ _ hq (continuous_btzJDevEquiv_symm hv)

@[simp] theorem btzQuotDevHomeomorph_mk (hv : 0 < v.2.1) (hα : α ≠ 0) (y : DInfty × ℝ) :
    btzQuotDevHomeomorph x₀ v hv hα (orbitMk (GammaA α) y) =
      orbitMk (GammaA α) (btzJDev x₀ v hv y) := rfl

end Action

/-! ### The regular part `J⁺(Δ) ∖ Δ` and the singular structure of `J⁺(Δ)` -/

section JStructure

variable {x₀ v : ℝ × ℝ × ℝ} {α : ℝ}

variable (x₀) in
/-- **The regular part `J⁺(Δ) ∖ Δ`**. -/
def btzJReg : Set (BTZJplus x₀) := {q | q.val ∉ btzLine x₀}

theorem btzRay_subset_btzLine {p : Causal.Minkowski 2} (hp : p ∈ btzLine x₀) :
    btzRay p ⊆ btzLine x₀ := by
  obtain ⟨s, rfl⟩ := (mem_btzLine_iff x₀).1 hp
  rw [btzRay_btzPt]
  rintro _ ⟨s', -, rfl⟩
  exact (mem_btzLine_iff x₀).2 ⟨s', rfl⟩

/-- **The generating sets lie in `J⁺(Δ)`** (`defi:BTZtop` presupposes it): `I⁺(p) ∪ ]p,+∞[ ⊆ J⁺(Δ)`
for `p ∈ Δ`. -/
theorem btzJGenSet_subset {p : Causal.Minkowski 2} (hp : p ∈ btzLine x₀) :
    btzJGenSet p ⊆ btzJplus x₀ := by
  rintro q (hq | hq)
  · exact ⟨p, hp, (Causal.minkowski 2).le_of_lt (Causal.Precausality.mem_Iplus_singleton.1 hq)⟩
  · exact ⟨q, btzRay_subset_btzLine hp hq, (Causal.minkowski 2).le_refl (mem_univ q)⟩

/-- `J⁺(Δ) ∖ Δ` is the open half-space above the null plane through `Δ`. -/
theorem btzJ_mem_reg_iff (q : Causal.Minkowski 2) :
    (q ∈ btzJplus x₀ ∧ q ∉ btzLine x₀) ↔ 0 < (nullToMink.symm q - x₀).2.1 := by
  obtain ⟨y, rfl⟩ := nullToMink.surjective q
  rw [LinearEquiv.symm_apply_apply, btzJplus, mem_jplus_btzLine_iff, mem_btzLine_iff]
  have hl : (∃ s : ℝ, nullToMink y = btzPt x₀ s) ↔ ∃ s : ℝ, y = x₀ + s • nullU :=
    exists_congr fun s => nullToMink.injective.eq_iff
  rw [hl]
  constructor
  · rintro ⟨h | h, h'⟩
    · exact h
    · exact absurd h h'
  · intro hb
    refine ⟨Or.inl hb, fun ⟨s, hs⟩ => ?_⟩
    subst hs
    simp [nullU] at hb

theorem isOpen_btzJ_halfSpace :
    IsOpen {q : Causal.Minkowski 2 | 0 < (nullToMink.symm q - x₀).2.1} :=
  isOpen_lt continuous_const ((continuous_fst.comp continuous_snd).comp
    (nullToMinkHomeomorph.symm.continuous.sub continuous_const))

theorem btzJReg_eq_preimage :
    btzJReg x₀ = BTZJplus.val ⁻¹' {q : Causal.Minkowski 2 | 0 < (nullToMink.symm q - x₀).2.1} := by
  ext q
  simp only [btzJReg, mem_setOf_eq, mem_preimage, ← btzJ_mem_reg_iff]
  exact ⟨fun h => ⟨q.mem, h⟩, fun h => h.2⟩

theorem isOpen_btzJReg : IsOpen (btzJReg x₀) := by
  rw [btzJReg_eq_preimage]; exact isOpen_btzJ_val_preimage isOpen_btzJ_halfSpace

theorem btzDevM_mem_btzLine_iff (hv : 0 < v.2.1) (y : DInfty × ℝ) :
    btzDevM x₀ v y ∈ btzLine x₀ ↔ y.1.r = 0 := by
  rw [mem_btzLine_iff]
  constructor
  · rintro ⟨s, hs⟩
    by_contra hr
    have h2 := congrArg (fun z => z.2.1) (nullToMink.injective hs)
    rw [btzDev_coords] at h2
    simp [nullU] at h2
    rcases h2 with h2 | h2
    · exact hr h2
    · exact hv.ne' h2
  · intro hr
    have h0 : y.1 = DInfty.apex := DInfty.eq_apex_of_not_pos (by rw [hr]; exact lt_irrefl 0)
    obtain ⟨p, t⟩ := y
    simp only at h0
    subst h0
    exact ⟨t, btzDevM_apex x₀ v t⟩

theorem btzJDev_mem_btzJReg_iff (hv : 0 < v.2.1) (y : DInfty × ℝ) :
    btzJDev x₀ v hv y ∈ btzJReg x₀ ↔ 0 < y.1.r := by
  simp only [btzJReg, mem_setOf_eq, btzJDev_val, btzDevM_mem_btzLine_iff hv]
  exact ⟨fun h => lt_of_le_of_ne y.1.r_nonneg (Ne.symm h), fun h => h.ne'⟩

/-- `J⁺(Δ) ∖ Δ = D({r > 0})`. -/
theorem btzJReg_eq_image (hv : 0 < v.2.1) : btzJReg x₀ = btzJDev x₀ v hv '' cylPos ℝ := by
  ext q
  obtain ⟨y, rfl⟩ := btzJDev_surjective (x₀ := x₀) hv q
  rw [btzJDev_mem_btzJReg_iff hv, (btzJDev_injective hv).mem_set_image]
  rfl

/-- **On `J⁺(Δ) ∖ Δ` the BTZ topology is the topology of `𝐌³`.** -/
theorem nhds_btzJ_of_mem_reg {q : BTZJplus x₀} (hq : q ∈ btzJReg x₀) :
    𝓝 q = comap BTZJplus.val (𝓝 q.val) := by
  rw [nhds_btzJ]
  refine inf_eq_left.2 ?_
  rw [TopologicalSpace.nhds_generateFrom]
  refine le_iInf₂ fun S hS => ?_
  obtain ⟨hqS, p, hp, rfl⟩ := hS
  rw [le_principal_iff]
  have hI : q.val ∈ (Causal.minkowski 2).Iplus ⊤ {p} := by
    rcases hqS with h | h
    · exact h
    · exact absurd (btzRay_subset_btzLine hp h) hq
  exact mem_comap.2 ⟨_, (Causal.Causality.isOpen_Iplus (C := Causal.minkowski 2)).mem_nhds hI,
    fun q' hq' => Or.inl hq'⟩

theorem hornTop_locallyConnected : @LocallyConnectedSpace (DInfty × ℝ) hornTop := by
  rw [← tamTop_univ]; exact locallyConnectedSpace_of_lpc_sptop (locPathConnected_tamTop isOpen_univ)

theorem hornTop_isPortly_cylPos : @IsPortly (DInfty × ℝ) hornTop (cylPos ℝ) := by
  have := isPortly_cylPos_tamTop isOpen_univ; rwa [tamTop_univ] at this

theorem isOpenMap_btzJDev (hv : 0 < v.2.1) :
    @IsOpenMap _ _ hornTop (btzJTop x₀) (btzJDev x₀ v hv) := by
  intro U hU
  have : btzJDev x₀ v hv '' U = (btzJDevEquiv x₀ v hv).symm ⁻¹' U := by
    rw [← Equiv.image_eq_preimage_symm]; rfl
  rw [this]
  exact @Continuous.isOpen_preimage _ _ (btzJTop x₀) hornTop _ (continuous_btzJDevEquiv_symm hv) U hU

/-- **`J⁺(Δ) ∖ Δ` is portly** in the BTZ topology. -/
theorem isPortly_btzJReg (x₀ : ℝ × ℝ × ℝ) : IsPortly (btzJReg x₀) := by
  rw [btzJReg_eq_image btzV0_pos]
  exact @IsPortly.image_of_isOpenMap _ _ hornTop _ hornTop_locallyConnected _
    (continuous_btzJDev btzV0_pos) (isOpenMap_btzJDev btzV0_pos) (btzJDev_surjective btzV0_pos) _
    hornTop_isPortly_cylPos

/-- **The inclusion is a local homeomorphism** on `J⁺(Δ) ∖ Δ` (into `𝐌³`). -/
theorem isLocalHomeomorphOn_btzJ_val (x₀ : ℝ × ℝ × ℝ) :
    IsLocalHomeomorphOn (BTZJplus.val : BTZJplus x₀ → Causal.Minkowski 2) (btzJReg x₀) := by
  refine (isLocalHomeomorphOn_iff_isOpenEmbedding_restrict _).2 fun q hq =>
    ⟨btzJReg x₀, isOpen_btzJReg.mem_nhds hq, ?_⟩
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · refine isInducing_iff_nhds.2 fun x => ?_
    rw [nhds_subtype, nhds_btzJ_of_mem_reg x.2, Filter.comap_comap]
    rfl
  · exact BTZJplus.val_injective.comp Subtype.val_injective
  · have : range ((btzJReg x₀).restrict BTZJplus.val) =
        {q : Causal.Minkowski 2 | 0 < (nullToMink.symm q - x₀).2.1} := by
      ext q
      rw [mem_setOf_eq, ← btzJ_mem_reg_iff]
      constructor
      · rintro ⟨⟨q', hq'⟩, rfl⟩; exact ⟨q'.mem, hq'⟩
      · rintro ⟨h1, h2⟩; exact ⟨⟨BTZJplus.mk q h1, h2⟩, rfl⟩
    rw [this]; exact isOpen_btzJ_halfSpace

instance btzJ_locPathConnected : LocPathConnectedSpace (BTZJplus x₀) := by
  have hlpc : @LocPathConnectedSpace _ hornTop := by
    rw [← tamTop_univ]; exact locPathConnected_tamTop isOpen_univ
  have hemb : @IsOpenEmbedding _ _ (btzJTop x₀) hornTop (btzJDevEquiv x₀ btzV0 btzV0_pos).symm :=
    @Homeomorph.isOpenEmbedding _ _ (btzJTop x₀) hornTop
      (@Homeomorph.symm _ _ hornTop (btzJTop x₀) (btzJDevHomeomorph x₀ btzV0 btzV0_pos))
  exact @IsOpenEmbedding.locPathConnectedSpace _ _ hornTop _ hlpc _ hemb

variable (x₀) in
/-- **The singular `(Isom(𝐌³), 𝐌³)`-structure of `J⁺(Δ)`** (BTZ topology): the one pulled back by
the inclusion `J⁺(Δ) ∖ Δ ↪ 𝐌³` (`devStructure`), i.e. the charts are the restrictions of the
identity of `𝐌³` to open subsets of `J⁺(Δ) ∖ Δ`. -/
@[reducible] noncomputable def btzJStructure :
    SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZJplus x₀) :=
  devStructure (isPortly_btzJReg x₀) (isLocalHomeomorphOn_btzJ_val x₀)

theorem btzJ_smul_mapsTo_reg (k : GammaA α) :
    MapsTo (fun q : BTZJplus x₀ => k • q) (btzJReg x₀) (btzJReg x₀) := by
  rw [btzJReg_eq_image btzV0_pos]
  rintro _ ⟨y, hy, rfl⟩
  refine ⟨k • y, ?_, (btzJDev_smul btzV0_pos k y)⟩
  show 0 < (k • y).1.r
  rw [gammaA_smul_r]; exact hy

/-- `Γ` acts on `J⁺(Δ)` by a.e. `(G,X)`-morphisms. -/
theorem btzJ_isAEMorphism_smul (k : GammaA α) :
    letI := btzJStructure x₀
    IsAEMorphism (Causal.Flat.isom 2) (Causal.Minkowski 2) fun q : BTZJplus x₀ => k • q :=
  isAEMorphismOf_devStructure (isPortly_btzJReg x₀) (isLocalHomeomorphOn_btzJ_val x₀)
    (continuous_const_smul k) (btzJ_smul_mapsTo_reg k)
    fun _ _ => ⟨btzHolHom x₀ α k, Eventually.of_forall fun _ => rfl⟩

theorem btzJ_disc (hα : α ≠ 0) :
    ∀ q : BTZJplus x₀, ∃ U ∈ 𝓝 q, ∀ k : GammaA α, ((k • ·) '' U ∩ U).Nonempty → k • q = q := by
  intro q
  obtain ⟨y, rfl⟩ := btzJDev_surjective (x₀ := x₀) btzV0_pos q
  obtain ⟨U, hU, hUk⟩ := DInfty.disc_prod (Z := ℝ) hα y
  have hU' : U ∈ @nhds _ hornTop y := nhds_mono hornTop_le hU
  refine ⟨btzJDev x₀ btzV0 btzV0_pos '' U, ?_, fun k ⟨_, ⟨_, ⟨z, hz, rfl⟩, rfl⟩, ⟨z', hz', hzz⟩⟩ => ?_⟩
  · obtain ⟨W, hW, hWU⟩ := btzJDev_nhds (x₀ := x₀) btzV0_pos y hU'
    refine mem_of_superset hW fun q hq => ?_
    obtain ⟨y', rfl⟩ := btzJDev_surjective (x₀ := x₀) btzV0_pos q
    exact ⟨y', hWU y' hq, rfl⟩
  · simp only at hzz
    rw [← btzJDev_smul] at hzz ⊢
    have := btzJDev_injective btzV0_pos hzz
    rw [hUk k ⟨k • z, ⟨z, hz, rfl⟩, this ▸ hz'⟩]

theorem btzJ_free (hα : α ≠ 0) :
    ∀ q ∈ btzJReg x₀, ∀ k : GammaA α, k • q = q → k = 1 := by
  rw [btzJReg_eq_image btzV0_pos]
  rintro _ ⟨y, hy, rfl⟩ k hk
  rw [← btzJDev_smul] at hk
  exact DInfty.free_pos (Z := ℝ) hα y hy k (btzJDev_injective btzV0_pos hk)

/-- **The singular structure of `Γ\J⁺(Δ)`** exists and is unique: there is a unique maximal a.e.
`(Isom(𝐌³), 𝐌³)`-atlas on `Γ\J⁺(Δ)` for which the projection `J⁺(Δ) → Γ\J⁺(Δ)` is an a.e.
morphism (`prop:aeGXquotient`). -/
theorem btzJQuot_existsUnique (x₀ : ℝ × ℝ × ℝ) (hα : α ≠ 0) :
    letI := btzJStructure x₀
    ∃! B : Set (OpenPartialHomeomorph (Orbits (GammaA α) (BTZJplus x₀)) (Causal.Minkowski 2)),
      IsMaximalAEAtlas (Causal.Flat.isom 2) B ∧
      IsAEMorphismOf (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2)
        (BTZJplus x₀)) B (orbitMk (GammaA α)) :=
  letI := btzJStructure x₀
  existsUnique_aeGXQuotient btzJ_isAEMorphism_smul (btzJ_disc hα) (isPortly_btzJReg x₀)
    (btzJ_free hα)

variable (x₀) in
/-- The singular `(Isom(𝐌³), 𝐌³)`-structure of `Γ\J⁺(Δ)`: the quotient one. -/
@[reducible] noncomputable def btzJQuotStructure (hα : α ≠ 0) :
    SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) (Orbits (GammaA α) (BTZJplus x₀)) :=
  ⟨_, (btzJQuot_existsUnique x₀ hα).exists.choose_spec.1⟩

theorem btzJQuotStructure_spec (hα : α ≠ 0) :
    letI := btzJStructure x₀
    letI := btzJQuotStructure x₀ hα
    IsAEMorphismOf (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2)
      (BTZJplus x₀)) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2)
        (Orbits (GammaA α) (BTZJplus x₀))) (orbitMk (GammaA α)) :=
  (btzJQuot_existsUnique x₀ hα).exists.choose_spec.2

end JStructure

/-! ### `prop:quotient_chart`: `D̄ : 𝔼₀ → Γ\J⁺(Δ)` is an isomorphism of singular manifolds -/

section QuotientChart

variable {x₀ v : ℝ × ℝ × ℝ} {α : ℝ}

/-- Near a point of `J⁺(Δ) ∖ Δ`, a chart of `Γ\J⁺(Δ)` read through the projection is a translate
of the inclusion `J⁺(Δ) ↪ 𝐌³`. -/
theorem btzJ_eventually_chart (hα : α ≠ 0) {q : BTZJplus x₀} (hq : q ∈ btzJReg x₀)
    {c : OpenPartialHomeomorph (Orbits (GammaA α) (BTZJplus x₀)) (Causal.Minkowski 2)}
    (hc : c ∈ (btzJQuot_existsUnique x₀ hα).exists.choose)
    (hqc : orbitMk (GammaA α) q ∈ c.source) :
    ∃ g : Causal.Flat.isom 2, ∀ᶠ q' in 𝓝 q, q'.val = g • c (orbitMk (GammaA α) q') := by
  have hP := isPortly_btzJReg x₀
  have hD := isLocalHomeomorphOn_btzJ_val x₀
  have hspec := (btzJQuot_existsUnique x₀ hα).exists.choose_spec
  have hB := hspec.1
  have hdev := isAEAtlas_devAtlas (G := Causal.Flat.isom 2) hP hD
  have hπ : IsAEMorphismOf (Causal.Flat.isom 2)
      (maximalAEAtlas (Causal.Flat.isom 2) (devAtlas (Causal.Flat.isom 2) BTZJplus.val (btzJReg x₀)))
      (btzJQuot_existsUnique x₀ hα).exists.choose (orbitMk (GammaA α)) := hspec.2
  have hreg := hπ.regLocusOf_eq hdev.maximalAEAtlas hB.1
  have hqR : q ∈ regLocusOf (Causal.Flat.isom 2)
      (maximalAEAtlas (Causal.Flat.isom 2) (devAtlas (Causal.Flat.isom 2) BTZJplus.val (btzJReg x₀)))
      (btzJQuot_existsUnique x₀ hα).exists.choose (orbitMk (GammaA α)) := by
    rw [hreg]
    exact ⟨subset_support_devStructure hP hD hq, mem_support.2 ⟨c, hc, hqc⟩⟩
  have hqs : q ∈ support (devAtlas (Causal.Flat.isom 2) BTZJplus.val (btzJReg x₀)) := by
    rw [support_devAtlas hP.isOpen hD]; exact hq
  obtain ⟨e, he, hqe⟩ := mem_support.1 hqs
  obtain ⟨g, hg⟩ := (isRegularOn_regLocusOf (G := Causal.Flat.isom 2) _ _ _).exists_smul_eq q hqR e
    (hdev.subset_maximalAEAtlas he) c hc hqe hqc
  obtain ⟨h, hh⟩ := he.2 q hqe
  refine ⟨h * g⁻¹, ?_⟩
  filter_upwards [hg, hh] with q' h1 h2
  rw [h2, h1, mul_smul, inv_smul_smul]

/-- **`prop:quotient_chart`** (`RamcovGX.tex:2286`): with `J⁺(Δ)` endowed with the BTZ topology
(`defi:BTZtop`), the map `D̄ : 𝔼₀ → Γ\J⁺(Δ)` induced by the developing map is an isomorphism of
singular `𝐄^{1,2}`-manifolds: a homeomorphism (`btzQuotDevHomeomorph`) which is, with its inverse,
an a.e. `(Isom(𝐌³), 𝐌³)`-morphism, `𝔼₀` carrying the BTZ structure (`IsBTZStructure`) and
`Γ\J⁺(Δ)` the quotient structure of `J⁺(Δ)`'s (`btzJQuotStructure`: the unique one making the
projection an a.e. morphism, `btzJQuot_existsUnique`; on `J⁺(Δ)` the charts are the restrictions
of the identity of `𝐌³`, `btzJStructure`). For every `x₀`, every `v` with `⟨v|u⟩ < 0`, every
`α ≠ 0`; the paper's `𝔼₀` is `btzE0_quotient_chart`. -/
theorem btz_quotient_chart [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)]
    (hv : 0 < v.2.1) (hα : α ≠ 0) (hπ : IsBTZStructure x₀ v α) :
    letI := btzJQuotStructure x₀ hα
    (∀ y, btzQuotDevHomeomorph x₀ v hv hα (orbitMk (GammaA α) y) =
      orbitMk (GammaA α) (btzJDev x₀ v hv y)) ∧
    IsAEMorphism (Causal.Flat.isom 2) (Causal.Minkowski 2) (btzQuotDevHomeomorph x₀ v hv hα) ∧
    IsAEMorphism (Causal.Flat.isom 2) (Causal.Minkowski 2) (btzQuotDevHomeomorph x₀ v hv hα).symm := by
  letI := btzJQuotStructure x₀ hα
  set Φ := btzQuotDevHomeomorph x₀ v hv hα
  have hA := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)
  have hB := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2)
    (Orbits (GammaA α) (BTZJplus x₀))
  have hRegE := btz_reg hv hα hπ
  have hP := isPortly_btzJReg x₀
  have hD := isLocalHomeomorphOn_btzJ_val x₀
  have hdev := isAEAtlas_devAtlas (G := Causal.Flat.isom 2) hP hD
  have hπJ : IsAEMorphismOf (Causal.Flat.isom 2)
      (maximalAEAtlas (Causal.Flat.isom 2) (devAtlas (Causal.Flat.isom 2) BTZJplus.val (btzJReg x₀)))
      (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) (Orbits (GammaA α) (BTZJplus x₀)))
      (orbitMk (GammaA α)) := (btzJQuot_existsUnique x₀ hα).exists.choose_spec.2
  have hloc := isLocalHomeomorphOn_orbitMk (btzJ_disc (x₀ := x₀) hα) (btzJ_free hα)
  have hmaps : MapsTo Φ (Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α))
      (support (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) (Orbits (GammaA α) (BTZJplus x₀)))) := by
    intro x hx
    rw [hRegE] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    have hr : btzJDev x₀ v hv y ∈ btzJReg x₀ := (btzJDev_mem_btzJReg_iff hv y).2 hy
    exact hπJ.mem_support_of_isLocalHomeomorphOn hdev.maximalAEAtlas hB
      (subset_support_devStructure hP hD hr) (hloc.mono (singleton_subset_iff.2 hr))
  have hfwd : IsAEMorphism (Causal.Flat.isom 2) (Causal.Minkowski 2) Φ := by
    refine (isAEMorphismOf_iff hB.1).2 ⟨Φ.continuous, _, isPortly_reg _ _ _,
      IsRegularOn.of_exists hA.1.1 hB.1.1 (isOpen_reg _ _ _) subset_rfl hmaps
        Φ.continuous.continuousOn fun x hx => ?_⟩
    have hx' := hx
    rw [hRegE] at hx'
    obtain ⟨y, hy, rfl⟩ := hx'
    obtain ⟨e, he, hxe⟩ := mem_support.1 hx
    obtain ⟨e', he', hxe'⟩ := mem_support.1 (hmaps hx)
    have hr : btzJDev x₀ v hv y ∈ btzJReg x₀ := (btzJDev_mem_btzJReg_iff hv y).2 hy
    obtain ⟨g₁, hg₁⟩ := btz_eventually_chart hv hπ hy he hxe
    obtain ⟨g₂, hg₂⟩ := btzJ_eventually_chart hα hr he' hxe'
    refine ⟨e, he, e', he', hxe, hxe', g₂⁻¹ * g₁, ?_⟩
    have hψc : Tendsto (btzJDev x₀ v hv) (𝓝 y) (𝓝 (btzJDev x₀ v hv y)) := by
      rw [← nhds_hornTop_of_pos hy]
      exact @Continuous.continuousAt _ _ hornTop _ _ _ (continuous_btzJDev hv)
    have hev : ∀ᶠ y' in 𝓝 y, e' (Φ (orbitMk (GammaA α) y')) =
        (g₂⁻¹ * g₁) • e (orbitMk (GammaA α) y') := by
      filter_upwards [hg₁, hψc.eventually hg₂] with y' h1 h2
      rw [btzJDev_val] at h2
      rw [btzQuotDevHomeomorph_mk, mul_smul, ← h1, h2, inv_smul_smul]
    exact (isOpenMap_quotient_mk'_mul (Γ := GammaA α) (T := DInfty × ℝ)).nhds_le y hev
  exact ⟨fun y => rfl, hfwd, hfwd.symm_of_homeomorph⟩

/-- **`prop:quotient_chart`** (`RamcovGX.tex:2286`) for the paper's `𝔼₀` itself (`α = 2π`,
`x₀ = 0`, `v = (−1, 1, 0)`, `GX.btzE0Structure`). -/
theorem btzE0_quotient_chart :
    letI := btzE0Structure
    letI := btzJQuotStructure 0 btz_two_pi_ne_zero
    (∀ y, btzQuotDevHomeomorph 0 btzV0 btzV0_pos btz_two_pi_ne_zero (orbitMk (GammaA (2 * π)) y) =
      orbitMk (GammaA (2 * π)) (btzJDev 0 btzV0 btzV0_pos y)) ∧
    IsAEMorphism (Causal.Flat.isom 2) (Causal.Minkowski 2)
      (btzQuotDevHomeomorph 0 btzV0 btzV0_pos btz_two_pi_ne_zero) ∧
    IsAEMorphism (Causal.Flat.isom 2) (Causal.Minkowski 2)
      (btzQuotDevHomeomorph 0 btzV0 btzV0_pos btz_two_pi_ne_zero).symm :=
  letI := btzE0Structure
  btz_quotient_chart btzV0_pos btz_two_pi_ne_zero isBTZStructure_btzE0

/-- `𝔼₀ = Γ_α\(𝔻_∞ × ℝ)` is second countable (`quotientBase_topology`). -/
theorem btzModel_secondCountable (hα : α ≠ 0) : SecondCountableTopology (BTZModel α) :=
  (quotientBase_topology (Z := ℝ) hα).2.2 inferInstance

/-- **`Γ\J⁺(Δ)` with the BTZ topology is Hausdorff, locally path-connected and second countable**
— a singular manifold in the sense of `SingGXCat` (contrast `RamcovGX.tex:2273`: with the quotient
of the usual topology of `J⁺(Δ)` it is not even Hausdorff), being homeomorphic to `𝔼₀`
(`btzQuotDevHomeomorph`). -/
theorem btzJQuot_instances (x₀ : ℝ × ℝ × ℝ) (hα : α ≠ 0) :
    T2Space (Orbits (GammaA α) (BTZJplus x₀)) ∧
      LocPathConnectedSpace (Orbits (GammaA α) (BTZJplus x₀)) ∧
      SecondCountableTopology (Orbits (GammaA α) (BTZJplus x₀)) := by
  obtain ⟨h1, h2, -, -⟩ := btz_instances (α := α) hα
  have h3 := btzModel_secondCountable hα
  set Φ := btzQuotDevHomeomorph x₀ btzV0 btzV0_pos hα
  exact ⟨Φ.symm.isEmbedding.t2Space, Φ.symm.isOpenEmbedding.locPathConnectedSpace,
    Φ.symm.isEmbedding.secondCountableTopology⟩

/-- `𝔼₀` (with a singular structure) as an object of the category `SingGXCat` of singular
`(Isom(𝐌³), 𝐌³)`-manifolds. -/
noncomputable def btzModelObj (α : ℝ)
    [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)]
    (hα : α ≠ 0) : SingGXCat (Causal.Flat.isom 2) (Causal.Minkowski 2) :=
  haveI := (btz_instances (α := α) hα).1
  haveI := (btz_instances (α := α) hα).2.1
  haveI := btzModel_secondCountable hα
  SingGXCat.mk (BTZModel α)

variable (x₀) in
/-- `Γ\J⁺(Δ)` (BTZ topology, quotient structure `btzJQuotStructure`) as an object of
`SingGXCat`. -/
noncomputable def btzJQuotObj (hα : α ≠ 0) : SingGXCat (Causal.Flat.isom 2) (Causal.Minkowski 2) :=
  letI := btzJQuotStructure x₀ hα
  haveI := (btzJQuot_instances x₀ hα).1
  haveI := (btzJQuot_instances x₀ hα).2.1
  haveI := (btzJQuot_instances x₀ hα).2.2
  SingGXCat.mk (Orbits (GammaA α) (BTZJplus x₀))

variable (x₀ v) in
/-- **`prop:quotient_chart` in the category `SingGXCat`**: `D̄` is an isomorphism
`𝔼₀ ≅ Γ\J⁺(Δ)` of singular `(Isom(𝐌³), 𝐌³)`-manifolds (`SingGXCat.isoOfHomeomorph`). -/
noncomputable def btzQuotChartIso
    [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)]
    (hv : 0 < v.2.1) (hα : α ≠ 0) (hπ : IsBTZStructure x₀ v α) :
    btzModelObj α hα ≅ btzJQuotObj x₀ hα :=
  letI := btzJQuotStructure x₀ hα
  SingGXCat.isoOfHomeomorph (M := btzModelObj α hα) (N := btzJQuotObj x₀ hα)
    (btzQuotDevHomeomorph x₀ v hv hα) (btz_quotient_chart hv hα hπ).2.1

theorem btzQuotChartIso_hom_apply
    [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)]
    (hv : 0 < v.2.1) (hα : α ≠ 0) (hπ : IsBTZStructure x₀ v α) (y : DInfty × ℝ) :
    (btzQuotChartIso x₀ v hv hα hπ).hom.1 (orbitMk (GammaA α) y) =
      orbitMk (GammaA α) (btzJDev x₀ v hv y) := rfl

end QuotientChart

/-! ### `rem:tamifying_topology_generated_open`: `T_BTZ` is generated by open diamonds -/

section Diamonds

variable {x₀ v : ℝ × ℝ × ℝ}

variable (x₀ v) in
/-- **The causal order of `\widetilde{𝔼₀}`** (cylinder model), read through its developing map
`D`, which is injective onto `J⁺(Δ)`: `y ≤ y'` iff `D(y) ≤ D(y')` in `𝐌³`. It is the global
order of the ETT causality `btzCylCausality` of DEC-33 (`btzCylCausality_le_top_iff`). -/
def btzCylLe (y y' : DInfty × ℝ) : Prop :=
  (Causal.minkowski 2).le ⊤ (btzDevM x₀ v y) (btzDevM x₀ v y')

variable (x₀ v) in
/-- **The diamond** `J⁻(p) ∩ J⁺(q)` of `\widetilde{𝔼₀}`. -/
def btzCylDiamond (p q : DInfty × ℝ) : Set (DInfty × ℝ) :=
  {y | btzCylLe x₀ v y p ∧ btzCylLe x₀ v q y}

theorem isOpen_hornTop_preimage_btzDevM (hv : 0 < v.2.1) {O : Set (Causal.Minkowski 2)}
    (hO : IsOpen O) : IsOpen[hornTop] (btzDevM x₀ v ⁻¹' O) :=
  @IsOpen.preimage _ _ hornTop _ _ (continuous_btzDevM_hornTop x₀ hv) _ hO

/-- **Diamonds shrink at every point**: every `T_BTZ`-neighbourhood `N` of `y` contains a diamond
`J⁻(p) ∩ J⁺(q)` whose `T_BTZ`-interior contains `y`. -/
theorem btz_exists_diamond (hv : 0 < v.2.1) (y : DInfty × ℝ) {N : Set (DInfty × ℝ)}
    (hN : N ∈ @nhds _ hornTop y) :
    ∃ p q : DInfty × ℝ, y ∈ @interior _ hornTop (btzCylDiamond x₀ v p q) ∧
      btzCylDiamond x₀ v p q ⊆ N := by
  rcases y.1.pos_or_eq_apex with hr | hr
  · rw [nhds_hornTop_of_pos hr] at hN
    have hD : btzDevM x₀ v '' N ∈ 𝓝 (btzDevM x₀ v y) := by
      rw [← (isLocalHomeomorphOn_btzDevM x₀ hv).map_nhds_eq hr]
      exact image_mem_map hN
    set w₀ := btzDev x₀ v y
    have hD' : nullToMink ⁻¹' (btzDevM x₀ v '' N) ∈ 𝓝 w₀ :=
      nullToMinkHomeomorph.continuous.continuousAt.preimage_mem_nhds hD
    obtain ⟨δ, hδ, hball⟩ := Metric.mem_nhds_iff.1 hD'
    set η := δ / 3 with hη
    have hηpos : 0 < η := by positivity
    set e : ℝ × ℝ × ℝ := (η, η, 0)
    have hmem : ∀ w, dist w w₀ < δ → ∃ z ∈ N, btzDevM x₀ v z = nullToMink w := fun w hw =>
      hball (Metric.mem_ball.2 hw)
    have hdP : dist (w₀ + e) w₀ < δ := by
      rw [dist_eq_norm, add_sub_cancel_left]
      simp only [e, Prod.norm_def, Real.norm_eq_abs, norm_zero, abs_of_pos hηpos]
      simp only [max_self, max_eq_left hηpos.le]; linarith
    have hdQ : dist (w₀ - e) w₀ < δ := by
      rw [dist_eq_norm, sub_sub_cancel_left, norm_neg]
      simp only [e, Prod.norm_def, Real.norm_eq_abs, norm_zero, abs_of_pos hηpos]
      simp only [max_self, max_eq_left hηpos.le]; linarith
    obtain ⟨p, hpN, hp⟩ := hmem _ hdP
    obtain ⟨q, hqN, hq⟩ := hmem _ hdQ
    have hDy : btzDevM x₀ v y = nullToMink w₀ := rfl
    refine ⟨p, q, ?_, ?_⟩
    · rw [@mem_interior _ hornTop]
      refine ⟨btzDevM x₀ v ⁻¹' ((Causal.minkowski 2).Iminus ⊤ {btzDevM x₀ v p} ∩
        (Causal.minkowski 2).Iplus ⊤ {btzDevM x₀ v q}), fun y' hy' => ⟨?_, ?_⟩,
        isOpen_hornTop_preimage_btzDevM hv ((Causal.Causality.isOpen_Iminus
          (C := Causal.minkowski 2)).inter (Causal.Causality.isOpen_Iplus (C := Causal.minkowski 2))),
        ⟨?_, ?_⟩⟩
      · exact (Causal.minkowski 2).le_of_lt (Causal.Precausality.mem_Iminus_singleton.1 hy'.1)
      · exact (Causal.minkowski 2).le_of_lt (Causal.Precausality.mem_Iplus_singleton.1 hy'.2)
      · rw [Causal.Precausality.mem_Iminus_singleton, hp, hDy, btzJ_lt_iff]
        simp only [e, add_sub_cancel_left]
        exact ⟨hηpos, hηpos, by nlinarith⟩
      · rw [Causal.Precausality.mem_Iplus_singleton, hq, hDy, btzJ_lt_iff]
        simp only [e, sub_sub_cancel]
        exact ⟨hηpos, hηpos, by nlinarith⟩
    · rintro y' ⟨h1, h2⟩
      simp only [btzCylLe] at h1 h2
      obtain ⟨w', hw'⟩ := nullToMink.surjective (btzDevM x₀ v y')
      rw [← hw', hp, btzJ_le_iff] at h1
      rw [← hw', hq, btzJ_le_iff] at h2
      obtain ⟨a1, b1, -⟩ := h1
      obtain ⟨a2, b2, c2⟩ := h2
      simp only [e, Prod.fst_sub, Prod.fst_add, Prod.snd_sub, Prod.snd_add] at a1 b1 a2 b2 c2
      obtain ⟨z, hzN, hz⟩ := hmem w' (by
        rw [dist_eq_norm, Prod.norm_def, Prod.norm_def, Real.norm_eq_abs, Real.norm_eq_abs,
          Real.norm_eq_abs]
        simp only [Prod.fst_sub, Prod.snd_sub]
        refine max_lt (abs_lt.2 ⟨by linarith, by linarith⟩) (max_lt (abs_lt.2 ⟨by linarith,
          by linarith⟩) (abs_lt.2 ⟨?_, ?_⟩))
        · by_contra hc; push Not at hc; nlinarith
        · by_contra hc; push Not at hc; nlinarith)
      rw [hw'] at hz
      rwa [← btzDevM_injective x₀ hv hz]
  · obtain ⟨p₀, t⟩ := y
    simp only at hr
    subst hr
    obtain ⟨ε, hε, hεN⟩ := (hasBasis_nhds_hornTop_apex t).mem_iff.1 hN
    obtain ⟨η, hη, hdiam⟩ := btz_axis_diamond (x₀ := x₀) hv t hε
    have hPJ : btzTopVertex x₀ t η ∈ btzJplus x₀ := by
      refine ((btzJ_mem_reg_iff (x₀ := x₀) _).2 ?_).1
      simp only [btzTopVertex, LinearEquiv.symm_apply_apply, add_sub_cancel_left]
      exact hη
    obtain ⟨p, hp⟩ := btzJDev_surjective (x₀ := x₀) hv (BTZJplus.mk _ hPJ)
    have hp' : btzDevM x₀ v p = btzTopVertex x₀ t η := congrArg BTZJplus.val hp
    have hq' : btzDevM x₀ v (DInfty.apex, t - η) = btzPt x₀ (t - η) := btzDevM_apex x₀ v _
    refine ⟨p, (DInfty.apex, t - η), ?_, ?_⟩
    · rw [@mem_interior _ hornTop]
      refine ⟨btzDevM x₀ v ⁻¹' ((Causal.minkowski 2).Iminus ⊤ {btzTopVertex x₀ t η}) ∩
        {y' | t - η < y'.2 + btzKappa v * y'.1.r}, fun y' hy' => ⟨?_, ?_⟩,
        @IsOpen.inter _ hornTop _ _ (isOpen_hornTop_preimage_btzDevM hv
          (Causal.Causality.isOpen_Iminus (C := Causal.minkowski 2)))
          ((TopologicalSpace.le_def.1 hornTop_le) _ (isOpen_btz_kappa_lt _)), ⟨?_, ?_⟩⟩
      · show (Causal.minkowski 2).le ⊤ _ _
        rw [hp']
        exact (Causal.minkowski 2).le_of_lt (Causal.Precausality.mem_Iminus_singleton.1 hy'.1)
      · show (Causal.minkowski 2).le ⊤ _ _
        rw [hq', ← Causal.Precausality.mem_Jplus_singleton, btzDevM_mem_Jplus_iff hv]
        exact hy'.2.le
      · rw [mem_preimage, btzDevM_apex, Causal.Precausality.mem_Iminus_singleton]
        exact btzPt_lt_btzTopVertex x₀ t hη
      · show t - η < t + btzKappa v * DInfty.apex.r
        rw [DInfty.apex_r, mul_zero, add_zero]; linarith
    · rintro y' ⟨h1, h2⟩
      simp only [btzCylLe] at h1 h2
      rw [hp'] at h1
      rw [hq', ← Causal.Precausality.mem_Jplus_singleton, btzDevM_mem_Jplus_iff hv] at h2
      exact hεN (hdiam y' h1 h2)

/-- **`rem:tamifying_topology_generated_open`** (`RamcovGX.tex:2293`): the tamifying topology `T_BTZ`
of `\widetilde{𝔼₀}` (cylinder model, `hornTop`) is generated by the `T_BTZ`-open diamonds
`Int_{T_BTZ}(J⁻(p) ∩ J⁺(q))`, `p, q ∈ \widetilde{𝔼₀}` (the causal order read through `D`,
`btzCylLe`). -/
theorem btz_tamifying_topology_generated_open (hv : 0 < v.2.1) :
    hornTop = TopologicalSpace.generateFrom
      {S | ∃ p q : DInfty × ℝ, S = @interior _ hornTop (btzCylDiamond x₀ v p q)} := by
  refine le_antisymm (le_generateFrom ?_) (le_of_nhds_le_nhds fun y => ?_)
  · rintro _ ⟨p, q, rfl⟩
    exact @isOpen_interior _ hornTop _
  · intro N hN
    obtain ⟨p, q, hy, hsub⟩ := btz_exists_diamond (x₀ := x₀) hv y hN
    exact mem_of_superset (@IsOpen.mem_nhds _ (TopologicalSpace.generateFrom _) _ _
      (TopologicalSpace.isOpen_generateFrom_of_mem ⟨p, q, rfl⟩) hy)
      ((@interior_subset _ hornTop _).trans hsub)

/-- **`rem:tamifying_topology_generated_open`**, the form used: the `T_BTZ`-open diamonds form a
neighbourhood basis of `T_BTZ` at every point. -/
theorem btz_hasBasis_nhds_diamond (hv : 0 < v.2.1) (y : DInfty × ℝ) :
    (@nhds _ hornTop y).HasBasis
      (fun pq : (DInfty × ℝ) × (DInfty × ℝ) => y ∈ @interior _ hornTop (btzCylDiamond x₀ v pq.1 pq.2))
      (fun pq => @interior _ hornTop (btzCylDiamond x₀ v pq.1 pq.2)) := by
  refine ⟨fun N => ⟨fun hN => ?_, fun ⟨pq, hy, hsub⟩ => ?_⟩⟩
  · obtain ⟨p, q, hy, hsub⟩ := btz_exists_diamond (x₀ := x₀) hv y hN
    exact ⟨(p, q), hy, (@interior_subset _ hornTop _).trans hsub⟩
  · exact mem_of_superset (@IsOpen.mem_nhds _ hornTop _ _ (@isOpen_interior _ hornTop _) hy) hsub

/-- **Transport lemma** for `rem:tamifying_topology_generated_open`: for ANY homeomorphism `Φ` of
the maximal branched covering of `𝔼₀` onto the cylinder, the pulled-back topology `Φ^* hornTop`
is generated by the interiors of the diamonds of the order pulled back by `Φ` from `btzCylLe`.
Nothing here ties `Φ` to the cover; that is `btz_tamifying_topology_generated_open_cover`. -/
theorem btz_tamifying_topology_generated_open_transport {α : ℝ}
    [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)]
    {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α))ᶜ : Set (BTZModel α))}
    (Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)) y₀ ≃ₜ
      DInfty × ℝ) (hv : 0 < v.2.1) :
    TopologicalSpace.induced Φ hornTop = TopologicalSpace.generateFrom
      {S | ∃ p q, S = @interior _ (TopologicalSpace.induced Φ hornTop)
        {e | btzCylLe x₀ v (Φ e) (Φ p) ∧ btzCylLe x₀ v (Φ q) (Φ e)}} := by
  have hcont : Continuous[TopologicalSpace.induced Φ hornTop, hornTop] Φ := continuous_induced_dom
  have hopen : @IsOpenMap _ _ (TopologicalSpace.induced Φ hornTop) hornTop Φ := by
    rintro _ ⟨V, hV, rfl⟩
    rw [Φ.surjective.image_preimage]; exact hV
  have hint : ∀ D : Set (DInfty × ℝ), @interior _ (TopologicalSpace.induced Φ hornTop) (Φ ⁻¹' D) = Φ ⁻¹' (@interior _ hornTop D) :=
    fun D => (@IsOpenMap.preimage_interior_eq_interior_preimage _ _ Φ (TopologicalSpace.induced Φ hornTop) hornTop hopen hcont D).symm
  have h1 : TopologicalSpace.induced Φ hornTop = TopologicalSpace.induced Φ (TopologicalSpace.generateFrom
      {S | ∃ p q : DInfty × ℝ, S = @interior _ hornTop (btzCylDiamond x₀ v p q)}) :=
    congrArg (TopologicalSpace.induced Φ) (btz_tamifying_topology_generated_open (x₀ := x₀) hv)
  refine h1.trans ?_
  rw [induced_generateFrom_eq]
  congr 1
  ext S
  simp only [mem_image, mem_setOf_eq]
  constructor
  · rintro ⟨_, ⟨p, q, rfl⟩, rfl⟩
    refine ⟨Φ.symm p, Φ.symm q, ?_⟩
    rw [← hint]
    congr 1
    ext e
    simp only [btzCylDiamond, mem_preimage, mem_setOf_eq, Homeomorph.apply_symm_apply]
  · rintro ⟨p, q, rfl⟩
    exact ⟨_, ⟨Φ p, Φ q, rfl⟩, (hint _).symm⟩

/-- **`rem:tamifying_topology_generated_open`** (`RamcovGX.tex:2293`) on `\widetilde{𝔼₀}` itself,
the maximal branched covering of `𝔼₀` over its singular locus, for a homeomorphism `Φ` onto the
cylinder lifting the projection (`orbitMk ∘ Φ = base`): `Φ^* hornTop` is the tamifying topology
`T_BTZ` (`btz_isTamifyingTopology`), `D ∘ Φ` is a developing map of the cover over its regular
part (`btz_isRegDevelopingOnReg`), and, the causal order of the cover being read through this
developing map (`e ≤ e'` iff `D(Φ e) ≤ D(Φ e')` in `𝐌³`), `T_BTZ` is generated by the
`T_BTZ`-interiors of the diamonds `J⁻(p) ∩ J⁺(q)`, `p, q ∈ \widetilde{𝔼₀}`. -/
theorem btz_tamifying_topology_generated_open_cover {α : ℝ}
    [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)]
    {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α))ᶜ : Set (BTZModel α))}
    (Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)) y₀ ≃ₜ
      DInfty × ℝ) (hv : 0 < v.2.1) (hα : α ≠ 0) (hπ : IsBTZStructure x₀ v α)
    (hΦ : ∀ e, orbitMk (GammaA α) (Φ e) = e.base) :
    IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α) y₀
      (TopologicalSpace.induced Φ hornTop) ∧
    IsRegDevelopingOnReg (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α) y₀
      (btzDevM x₀ v ∘ Φ) ∧
    TopologicalSpace.induced Φ hornTop = TopologicalSpace.generateFrom
      {S | ∃ p q, S = @interior _ (TopologicalSpace.induced Φ hornTop)
        {e | (Causal.minkowski 2).le ⊤ ((btzDevM x₀ v ∘ Φ) e) ((btzDevM x₀ v ∘ Φ) p) ∧
          (Causal.minkowski 2).le ⊤ ((btzDevM x₀ v ∘ Φ) q) ((btzDevM x₀ v ∘ Φ) e)}} :=
  ⟨btz_isTamifyingTopology hv hα hπ hΦ, btz_isRegDevelopingOnReg hv hα hπ hΦ,
    btz_tamifying_topology_generated_open_transport Φ hv⟩

end Diamonds


/-! ### The ETT causality of `J⁺(Δ)` and of `\widetilde{𝔼₀}`, from causal curves (DEC-33)

DEC-33: the causal structure of a singular flat (BTZ) manifold is ETT's, generated by the local
causality, curves as in DEC-6/DEC-13; DEC-77 (b): `\widetilde{BTZ}` carries `T_BTZ` and causality is
read in it. On `J⁺(Δ)` with the BTZ topology, `x ≤_U y` iff a future causal curve of `U` joins
them, a curve being BTZ-continuous and locally non-decreasing for the order of `𝐌³` (the chart of
`J⁺(Δ) ∖ Δ` is the identity of `𝐌³`; at a point of `Δ` the ambient order, as `GX.E0.causality`
does at BTZ points). Transported to the cylinder `(\widetilde{𝔼₀}, T_BTZ)` by the homeomorphism
`D` (`GX.btzJDevHomeomorph`), and to the maximal branched covering itself. -/

section ETTCausality

open TopologicalSpace

variable {x₀ : ℝ × ℝ × ℝ}

/-- The order of `𝐌³` on `J⁺(Δ)`. -/
def btzJLe (q q' : BTZJplus x₀) : Prop := (Causal.minkowski 2).le ⊤ q.val q'.val

/-- The chronology of `𝐌³` on `J⁺(Δ)`. -/
def btzJLt (q q' : BTZJplus x₀) : Prop := (Causal.minkowski 2).lt ⊤ q.val q'.val

theorem btzJLe.trans {q q' q'' : BTZJplus x₀} (h₁ : btzJLe q q') (h₂ : btzJLe q' q'') :
    btzJLe q q'' := (Causal.minkowski 2).le_trans h₁ h₂

theorem btzJLt.trans {q q' q'' : BTZJplus x₀} (h₁ : btzJLt q q') (h₂ : btzJLt q' q'') :
    btzJLt q q'' := (Causal.minkowski 2).lt_trans h₁ h₂

theorem btzJLt.le {q q' : BTZJplus x₀} (h : btzJLt q q') : btzJLe q q' :=
  (Causal.minkowski 2).le_of_lt h

theorem btzJLe.refl (q : BTZJplus x₀) : btzJLe q q := (Causal.minkowski 2).le_refl (mem_univ _)

/-- The relation `R` restricted to the open set `N`. -/
def btzJRelOn (R : BTZJplus x₀ → BTZJplus x₀ → Prop) (N : Opens (BTZJplus x₀))
    (q q' : BTZJplus x₀) : Prop :=
  q ∈ N ∧ q' ∈ N ∧ R q q'

theorem btzJ_isRelFamily_relOn {R : BTZJplus x₀ → BTZJplus x₀ → Prop}
    (hR : ∀ {x y z}, R x y → R y z → R x z) : Causal.IsRelFamily (btzJRelOn R) where
  mem_left h := h.1
  mem_right h := h.2.1
  trans h₁ h₂ := ⟨h₁.1, h₂.2.1, hR h₁.2.2 h₂.2.2⟩
  mono hN _ _ h := ⟨hN h.1, hN h.2.1, h.2.2⟩

theorem btzJ_isRelFamily_le : Causal.IsRelFamily (btzJRelOn (btzJLe (x₀ := x₀))) :=
  btzJ_isRelFamily_relOn btzJLe.trans

theorem btzJ_isRelFamily_lt : Causal.IsRelFamily (btzJRelOn (btzJLt (x₀ := x₀))) :=
  btzJ_isRelFamily_relOn btzJLt.trans

/-- A continuous curve, `R`-increasing on `[a, b]`, is a curve of every open set containing it. -/
theorem btzJ_curveOn_of_continuousOn {R : BTZJplus x₀ → BTZJplus x₀ → Prop}
    {W : Opens (BTZJplus x₀)} {c : ℝ → BTZJplus x₀} {a b : ℝ} (hc : ContinuousOn c (Icc a b))
    (hmem : ∀ t ∈ Icc a b, c t ∈ W)
    (hR : ∀ s ∈ Icc a b, ∀ s' ∈ Icc a b, s < s' → R (c s) (c s')) :
    Causal.CurveOn (btzJRelOn R) W c a b where
  mem := hmem
  rel t ht N _ htN := by
    have hN : c ⁻¹' N ∈ 𝓝[Icc a b] t := hc t ht (N.isOpen.mem_nhds htN)
    obtain ⟨ε, hε, hball⟩ := Metric.mem_nhdsWithin_iff.1 hN
    refine ⟨t - ε, t + ε, by linarith, by linarith, fun s hs s' hs' h1 h2 h3 => ?_⟩
    have hsb : s ∈ Metric.ball t ε := by
      rw [Metric.mem_ball, Real.dist_eq, abs_lt]; constructor <;> linarith
    have hs'b : s' ∈ Metric.ball t ε := by
      rw [Metric.mem_ball, Real.dist_eq, abs_lt]; constructor <;> linarith
    exact ⟨hball ⟨hsb, hs⟩, hball ⟨hs'b, hs'⟩, hR s hs s' hs' h2⟩

section Curves

variable {r r' : Opens (BTZJplus x₀) → BTZJplus x₀ → BTZJplus x₀ → Prop} {U W : Opens (BTZJplus x₀)}
  {c c' : ℝ → BTZJplus x₀} {a b a' b' : ℝ}

theorem btzJ_curveOn_const {q : BTZJplus x₀} (hq : q ∈ U) : Causal.CurveOn r U (fun _ => q) 0 0 where
  mem _ _ := hq
  rel t _ _ _ _ := ⟨t - 1, t + 1, by linarith, by linarith, fun s hs s' hs' _ h _ => by
    have : s = s' := by rw [hs.1.antisymm' hs.2, hs'.1.antisymm' hs'.2]
    exact absurd this h.ne⟩

theorem btzJ_curveOn_mono_rel (h : ∀ N x y, r N x y → r' N x y) (hc : Causal.CurveOn r W c a b) :
    Causal.CurveOn r' W c a b where
  mem := hc.mem
  rel t ht N hN htN := by
    obtain ⟨l, u, hl, hu, h'⟩ := hc.rel t ht N hN htN
    exact ⟨l, u, hl, hu, fun s hs s' hs' h1 h2 h3 => h _ _ _ (h' s hs s' hs' h1 h2 h3)⟩

/-- Concatenation of two curves, the second translated to start where the first ends. -/
theorem btzJ_curve_append (hr : Causal.IsRelFamily r) (hc : Causal.CurveOn r U c a b)
    (hc' : Causal.CurveOn r U c' a' b') (hab : a ≤ b) (hab' : a' ≤ b') (h : c b = c' a') :
    ∃ d : ℝ → BTZJplus x₀, Causal.CurveOn r U d a (b + (b' - a')) ∧ d a = c a ∧
      d (b + (b' - a')) = c' b' := by
  have e1 : 1 * b + (a' - b) = a' := by ring
  have e2 : 1 * (b + (b' - a')) + (a' - b) = b' := by ring
  have hc'' : Causal.CurveOn r U (fun t => c' (1 * t + (a' - b))) b (b + (b' - a')) :=
    Causal.CurveOn.comp_affine (k := 1) (m := a' - b) one_pos (by rw [e1, e2]; exact hc')
  have hj : c b = (fun t => c' (1 * t + (a' - b))) b := by simp only; rw [e1]; exact h
  refine ⟨_, Causal.CurveOn.concat hr hc hc'' hab (by linarith) hj, by simp [hab], ?_⟩
  by_cases hb : b + (b' - a') ≤ b
  · have : b' = a' := le_antisymm (by linarith) hab'
    subst this
    simp only [sub_self, add_zero, le_refl, if_true]
    exact h
  · simp only [hb, if_false]; rw [e2]

end Curves

/-! #### Straight segments of `J⁺(Δ)` -/

theorem btz_isFutureCausal_smul {k : ℝ} (hk : 0 ≤ k) {w : Causal.Minkowski 2}
    (hw : Causal.Flat.IsFutureCausal w) : Causal.Flat.IsFutureCausal (k • w) := by
  refine ⟨?_, ?_⟩
  · simp only [Prod.smul_fst, smul_eq_mul]; exact mul_nonneg hk hw.1
  · rw [Causal.Flat.minkQ_smul]; exact mul_nonpos_of_nonneg_of_nonpos (sq_nonneg k) hw.2

theorem btz_isFutureTimelike_smul {k : ℝ} (hk : 0 < k) {w : Causal.Minkowski 2}
    (hw : Causal.Flat.IsFutureTimelike w) : Causal.Flat.IsFutureTimelike (k • w) := by
  refine ⟨?_, ?_⟩
  · simp only [Prod.smul_fst, smul_eq_mul]; exact mul_pos hk hw.1
  · rw [Causal.Flat.minkQ_smul]; exact mul_neg_of_pos_of_neg (pow_pos hk 2) hw.2

/-- The point `q + max(0,s) (q' − q)` of `𝐌³`. -/
noncomputable def btzJSegPt (q q' : BTZJplus x₀) (s : ℝ) : Causal.Minkowski 2 :=
  q.val + max 0 s • (q'.val - q.val)

theorem btzJSegPt_sub (q q' : BTZJplus x₀) (s s' : ℝ) :
    btzJSegPt q q' s' - btzJSegPt q q' s = (max 0 s' - max 0 s) • (q'.val - q.val) := by
  rw [btzJSegPt, btzJSegPt, add_sub_add_left_eq_sub, ← sub_smul]

theorem btzJ_le_segPt {q q' : BTZJplus x₀} (h : btzJLe q q') {s s' : ℝ} (hss' : s ≤ s') :
    (Causal.minkowski 2).le ⊤ (btzJSegPt q q' s) (btzJSegPt q q' s') := by
  rw [Causal.Flat.le_top_iff_minkQ, btzJSegPt_sub]
  refine btz_isFutureCausal_smul (sub_nonneg.2 (max_le_max le_rfl hss')) ?_
  exact Causal.Flat.le_top_iff_minkQ.1 h

theorem btzJ_lt_segPt {q q' : BTZJplus x₀} (h : btzJLt q q') {s s' : ℝ} (hs : 0 ≤ s)
    (hss' : s < s') :
    (Causal.minkowski 2).lt ⊤ (btzJSegPt q q' s) (btzJSegPt q q' s') := by
  rw [Causal.Flat.lt_top_iff_minkQ, btzJSegPt_sub, max_eq_right hs,
    max_eq_right (hs.trans hss'.le)]
  exact btz_isFutureTimelike_smul (sub_pos.2 hss') (Causal.Flat.lt_top_iff_minkQ.1 h)

theorem btzJSegPt_zero (q q' : BTZJplus x₀) : btzJSegPt q q' 0 = q.val := by
  simp [btzJSegPt]

theorem btzJSegPt_one (q q' : BTZJplus x₀) : btzJSegPt q q' 1 = q'.val := by
  simp [btzJSegPt]

theorem btzJ_val_le_segPt {q q' : BTZJplus x₀} (h : btzJLe q q') (s : ℝ) :
    (Causal.minkowski 2).le ⊤ q.val (btzJSegPt q q' s) := by
  rw [Causal.Flat.le_top_iff_minkQ, btzJSegPt, add_sub_cancel_left]
  exact btz_isFutureCausal_smul (le_max_left 0 s) (Causal.Flat.le_top_iff_minkQ.1 h)

theorem btzJSegPt_mem {q q' : BTZJplus x₀} (h : btzJLe q q') (s : ℝ) :
    btzJSegPt q q' s ∈ btzJplus x₀ := by
  obtain ⟨p, hp, hpq⟩ := q.mem
  exact ⟨p, hp, (Causal.minkowski 2).le_trans hpq (btzJ_val_le_segPt h s)⟩

/-- **The straight segment** from `q` to `q'` in `J⁺(Δ)`, `q ≤ q'`. -/
noncomputable def btzJSeg {q q' : BTZJplus x₀} (h : btzJLe q q') (s : ℝ) : BTZJplus x₀ :=
  BTZJplus.mk (btzJSegPt q q' s) (btzJSegPt_mem h s)

@[simp] theorem btzJSeg_val {q q' : BTZJplus x₀} (h : btzJLe q q') (s : ℝ) :
    (btzJSeg h s).val = btzJSegPt q q' s := rfl

theorem btzJSeg_zero {q q' : BTZJplus x₀} (h : btzJLe q q') : btzJSeg h 0 = q :=
  BTZJplus.ext (btzJSegPt_zero q q')

theorem btzJSeg_one {q q' : BTZJplus x₀} (h : btzJLe q q') : btzJSeg h 1 = q' :=
  BTZJplus.ext (btzJSegPt_one q q')

theorem continuous_btzJSegPt (q q' : BTZJplus x₀) : Continuous (btzJSegPt q q') := by
  unfold btzJSegPt; fun_prop

theorem btzJSegPt_eq_of_mem {q q' : BTZJplus x₀} {s : ℝ} (hs : s ∈ Icc (0 : ℝ) 1) :
    btzJSegPt q q' s = q.val + s • (q'.val - q.val) := by
  rw [btzJSegPt, max_eq_right hs.1]

/-! #### A monotone path of `𝐌³` in `J⁺(Δ)` is BTZ-continuous -/

theorem continuous_btzJ_val : Continuous (BTZJplus.val : BTZJplus x₀ → Causal.Minkowski 2) :=
  continuous_iff_le_induced.2 inf_le_left

theorem btzJ_exists_coords (m : Causal.Minkowski 2) : ∃ y, m = nullToMink (x₀ + y) :=
  ⟨nullToMink.symm m - x₀, by simp⟩

theorem btzJ_mem_jplus_coords (y : ℝ × ℝ × ℝ) :
    nullToMink (x₀ + y) ∈ btzJplus x₀ ↔ 0 < y.2.1 ∨ ∃ s : ℝ, y = s • nullU := by
  rw [btzJplus, mem_jplus_btzLine_iff, add_sub_cancel_left]
  simp only [add_right_inj]

/-- After a point of the half-ray `]p, +∞[`, one is in `I⁺(p) ∪ ]p, +∞[`. -/
theorem btzJ_mem_genSet_of_ray_le {p r m : Causal.Minkowski 2} (hp : p ∈ btzLine x₀)
    (hr : r ∈ btzRay p) (h : (Causal.minkowski 2).le ⊤ r m) : m ∈ btzJGenSet p := by
  obtain ⟨σ, rfl⟩ := (mem_btzLine_iff x₀).1 hp
  rw [btzRay_btzPt] at hr
  obtain ⟨σ', hσ', rfl⟩ := hr
  obtain ⟨y, rfl⟩ := btzJ_exists_coords (x₀ := x₀) m
  rw [btzPt, btzJ_le_iff] at h
  simp only [nullU, Prod.fst_sub, Prod.snd_sub, Prod.smul_fst,
    Prod.smul_snd, smul_eq_mul, mul_one, mul_zero, add_sub_add_left_eq_sub, sub_zero] at h
  obtain ⟨h1, h2, h3⟩ := h
  rcases h2.lt_or_eq with hb | hb
  · left
    rw [Causal.Precausality.mem_Iplus_singleton, btzPt, btzJ_lt_iff]
    simp only [nullU, Prod.fst_sub, Prod.snd_sub, Prod.smul_fst,
      Prod.smul_snd, smul_eq_mul, mul_one, mul_zero, add_sub_add_left_eq_sub, sub_zero]
    refine ⟨by linarith, hb, by nlinarith⟩
  · right
    have hc : y.2.2 = 0 := by
      rw [← hb, mul_zero] at h3
      exact pow_eq_zero_iff (n := 2) two_ne_zero |>.1 (le_antisymm h3 (sq_nonneg _))
    rw [btzRay_btzPt]
    refine ⟨y.1, by linarith, ?_⟩
    rw [btzPt]
    congr 2
    ext <;> simp [nullU, ← hb, hc]

/-- A point of `J⁺(Δ)` before a point of `Δ` is on `Δ`; past `p` along `Δ` it is in `]p, +∞[`. -/
theorem btzJ_mem_ray_of_le_line {m r : Causal.Minkowski 2} (hm : m ∈ btzJplus x₀)
    (hr : r ∈ btzLine x₀) (h : (Causal.minkowski 2).le ⊤ m r) {σ : ℝ}
    (hσ : σ < (nullToMink.symm m - x₀).1) : m ∈ btzRay (btzPt x₀ σ) := by
  obtain ⟨ρ, rfl⟩ := (mem_btzLine_iff x₀).1 hr
  obtain ⟨y, rfl⟩ := btzJ_exists_coords (x₀ := x₀) m
  rw [btzJ_mem_jplus_coords] at hm
  simp only [LinearEquiv.symm_apply_apply, add_sub_cancel_left] at hσ
  rw [btzPt, btzJ_le_iff] at h
  simp only [nullU, Prod.fst_sub, Prod.snd_sub, Prod.smul_fst,
    Prod.smul_snd, smul_eq_mul, mul_one, mul_zero, add_sub_add_left_eq_sub] at h
  rcases hm with hb | ⟨s, rfl⟩
  · exfalso; linarith [h.2.1]
  · rw [btzRay_btzPt]
    simp only [nullU, Prod.smul_fst, smul_eq_mul, mul_one] at hσ
    exact ⟨s, hσ, rfl⟩

/-- **A Minkowski-continuous causally monotone path of `J⁺(Δ)` is continuous for the BTZ
topology.** -/
theorem btzJ_continuousOn_of_mono {γ : ℝ → BTZJplus x₀} {a b : ℝ}
    (hc : ContinuousOn (fun s => (γ s).val) (Icc a b))
    (hm : ∀ s ∈ Icc a b, ∀ s' ∈ Icc a b, s ≤ s' → btzJLe (γ s) (γ s')) :
    ContinuousOn γ (Icc a b) := by
  intro t ht
  show Filter.Tendsto γ (𝓝[Icc a b] t) (𝓝 (γ t))
  rw [nhds_btzJ, Filter.tendsto_inf]
  refine ⟨Filter.tendsto_comap_iff.2 (hc t ht), ?_⟩
  rw [TopologicalSpace.nhds_generateFrom]
  refine Filter.tendsto_iInf.2 fun S => Filter.tendsto_iInf.2 fun hS => ?_
  obtain ⟨hmem, p, hp, rfl⟩ := hS
  rw [Filter.tendsto_principal]
  rcases hmem with hI | hR
  · filter_upwards [hc t ht ((Causal.Causality.isOpen_Iplus (C := Causal.minkowski 2)).mem_nhds hI)]
      with s hs
    exact Or.inl hs
  · obtain ⟨σ, rfl⟩ := (mem_btzLine_iff x₀).1 hp
    have hline : (γ t).val ∈ btzLine x₀ := btzRay_subset_btzLine hp hR
    have hO : IsOpen {m : Causal.Minkowski 2 | σ < (nullToMink.symm m - x₀).1} :=
      isOpen_lt continuous_const (continuous_fst.comp
        (nullToMinkHomeomorph.symm.continuous.sub continuous_const))
    have htO : (γ t).val ∈ {m : Causal.Minkowski 2 | σ < (nullToMink.symm m - x₀).1} := by
      have hR' := hR
      rw [btzRay_btzPt] at hR'
      obtain ⟨σ', hσ', he⟩ := hR'
      simp only [mem_setOf_eq, he, btzPt, LinearEquiv.symm_apply_apply, add_sub_cancel_left,
        nullU, Prod.smul_fst, smul_eq_mul, mul_one]
      exact hσ'
    filter_upwards [hc t ht (hO.mem_nhds htO), self_mem_nhdsWithin] with s hsO hs
    rcases le_total t s with hts | hst
    · exact btzJ_mem_genSet_of_ray_le hp hR (hm t ht s hs hts)
    · exact Or.inr (btzJ_mem_ray_of_le_line (γ s).mem hline (hm s hs t ht hst) hsO)

theorem btzJ_continuousOn_seg {q q' : BTZJplus x₀} (h : btzJLe q q') :
    ContinuousOn (btzJSeg h) (Icc 0 1) :=
  btzJ_continuousOn_of_mono (continuous_btzJSegPt q q').continuousOn
    fun _ _ _ _ hss' => btzJ_le_segPt h hss'

/-- **A straight causal segment of `J⁺(Δ)` is a future causal curve.** -/
theorem btzJ_curveOn_seg {q q' : BTZJplus x₀} (h : btzJLe q q') {U : Opens (BTZJplus x₀)}
    (hU : ∀ s ∈ Icc (0 : ℝ) 1, btzJSeg h s ∈ U) :
    Causal.CurveOn (btzJRelOn btzJLe) U (btzJSeg h) 0 1 :=
  btzJ_curveOn_of_continuousOn (btzJ_continuousOn_seg h) hU
    fun _ _ _ _ hss' => btzJ_le_segPt h hss'.le

/-- **A straight chronological segment of `J⁺(Δ)` is a future chronological curve.** -/
theorem btzJ_curveOn_seg_lt {q q' : BTZJplus x₀} (h : btzJLt q q') {U : Opens (BTZJplus x₀)}
    (hU : ∀ s ∈ Icc (0 : ℝ) 1, btzJSeg h.le s ∈ U) :
    Causal.CurveOn (btzJRelOn btzJLt) U (btzJSeg h.le) 0 1 :=
  btzJ_curveOn_of_continuousOn (btzJ_continuousOn_seg h.le) hU
    fun _ hs _ _ hss' => btzJ_lt_segPt h hs.1 hss'

/-! #### The causality -/

/-- `q ≤_U q'`: a future causal curve of `U` from `q` to `q'` (DEC-33, curves as in DEC-6/13). -/
def btzJCLe (U : Opens (BTZJplus x₀)) (q q' : BTZJplus x₀) : Prop :=
  ∃ a b : ℝ, a ≤ b ∧ ∃ c : ℝ → BTZJplus x₀, Causal.CurveOn (btzJRelOn btzJLe) U c a b ∧
    c a = q ∧ c b = q'

/-- `q ≪_U q'`: a future chronological curve of `U` over a non-trivial segment. -/
def btzJCLt (U : Opens (BTZJplus x₀)) (q q' : BTZJplus x₀) : Prop :=
  ∃ a b : ℝ, a < b ∧ ∃ c : ℝ → BTZJplus x₀, Causal.CurveOn (btzJRelOn btzJLt) U c a b ∧
    c a = q ∧ c b = q'

variable {U V : Opens (BTZJplus x₀)} {q q' q'' : BTZJplus x₀}

theorem btzJCLe.le (h : btzJCLe U q q') : btzJLe q q' := by
  obtain ⟨a, b, hab, c, hc, rfl, rfl⟩ := h
  rcases hab.lt_or_eq with hab | hab
  · exact (hc.rel_of_lt btzJ_isRelFamily_le le_rfl hab le_rfl).2.2
  · rw [hab]; exact btzJLe.refl _

theorem btzJCLt.lt (h : btzJCLt U q q') : btzJLt q q' := by
  obtain ⟨a, b, hab, c, hc, rfl, rfl⟩ := h
  exact (hc.rel_of_lt btzJ_isRelFamily_lt le_rfl hab le_rfl).2.2

theorem btzJCLe.mem_left (h : btzJCLe U q q') : q ∈ U := by
  obtain ⟨a, b, hab, c, hc, rfl, -⟩ := h; exact hc.mem a ⟨le_rfl, hab⟩

theorem btzJCLe.mem_right (h : btzJCLe U q q') : q' ∈ U := by
  obtain ⟨a, b, hab, c, hc, -, rfl⟩ := h; exact hc.mem b ⟨hab, le_rfl⟩

theorem btzJCLt.cle (h : btzJCLt U q q') : btzJCLe U q q' := by
  obtain ⟨a, b, hab, c, hc, h1, h2⟩ := h
  exact ⟨a, b, hab.le, c, btzJ_curveOn_mono_rel (fun _ _ _ h => ⟨h.1, h.2.1, h.2.2.le⟩) hc, h1, h2⟩

theorem btzJCLe.refl (hq : q ∈ U) : btzJCLe U q q := ⟨0, 0, le_rfl, _, btzJ_curveOn_const hq, rfl, rfl⟩

theorem btzJCLe.trans (h₁ : btzJCLe U q q') (h₂ : btzJCLe U q' q'') : btzJCLe U q q'' := by
  obtain ⟨a, b, hab, c, hc, rfl, rfl⟩ := h₁
  obtain ⟨a', b', hab', c', hc', h1, rfl⟩ := h₂
  obtain ⟨d, hd, hda, hdb⟩ := btzJ_curve_append btzJ_isRelFamily_le hc hc' hab hab' h1.symm
  exact ⟨a, _, by linarith, d, hd, hda, hdb⟩

theorem btzJCLt.trans (h₁ : btzJCLt U q q') (h₂ : btzJCLt U q' q'') : btzJCLt U q q'' := by
  obtain ⟨a, b, hab, c, hc, rfl, rfl⟩ := h₁
  obtain ⟨a', b', hab', c', hc', h1, rfl⟩ := h₂
  obtain ⟨d, hd, hda, hdb⟩ := btzJ_curve_append btzJ_isRelFamily_lt hc hc' hab.le hab'.le h1.symm
  exact ⟨a, _, by linarith, d, hd, hda, hdb⟩

theorem btzJCLe.mono (hVU : V ≤ U) (h : btzJCLe V q q') : btzJCLe U q q' := by
  obtain ⟨a, b, hab, c, hc, h1, h2⟩ := h
  exact ⟨a, b, hab, c, hc.mono_opens btzJ_isRelFamily_le hVU, h1, h2⟩

theorem btzJCLt.mono (hVU : V ≤ U) (h : btzJCLt V q q') : btzJCLt U q q' := by
  obtain ⟨a, b, hab, c, hc, h1, h2⟩ := h
  exact ⟨a, b, hab, c, hc.mono_opens btzJ_isRelFamily_lt hVU, h1, h2⟩

/-- **Globally, `q ≤ q'` iff `q ≤ q'` in `𝐌³`**: realised by the straight segment. -/
theorem btzJCLe_top_iff : btzJCLe ⊤ q q' ↔ btzJLe q q' :=
  ⟨btzJCLe.le, fun h => ⟨0, 1, zero_le_one, _, btzJ_curveOn_seg h fun _ _ => trivial,
    btzJSeg_zero h, btzJSeg_one h⟩⟩

theorem btzJCLt_top_iff : btzJCLt ⊤ q q' ↔ btzJLt q q' :=
  ⟨btzJCLt.lt, fun h => ⟨0, 1, zero_lt_one, _, btzJ_curveOn_seg_lt h fun _ _ => trivial,
    btzJSeg_zero h.le, btzJSeg_one h.le⟩⟩

/-! #### Openness of the chronological relation -/

/-- Chronologically after a point of `J⁺(Δ)` is off `Δ`. -/
theorem btzJ_mem_reg_of_lt (h : btzJLt q q') : q' ∈ btzJReg x₀ := by
  show q'.val ∉ btzLine x₀
  intro hl
  have hq := q.mem
  obtain ⟨y, hy⟩ := btzJ_exists_coords (x₀ := x₀) q.val
  obtain ⟨ρ, hρ⟩ := (mem_btzLine_iff x₀).1 hl
  have h' : (Causal.minkowski 2).lt ⊤ q.val q'.val := h
  rw [hy, hρ, btzPt, btzJ_lt_iff] at h'
  rw [hy, btzJ_mem_jplus_coords] at hq
  simp only [nullU, Prod.fst_sub, Prod.snd_sub, Prod.smul_fst, Prod.smul_snd, smul_eq_mul, mul_one,
    mul_zero, add_sub_add_left_eq_sub] at h'
  rcases hq with hb | ⟨s, rfl⟩
  · linarith [h'.2.1]
  · simp [nullU] at h'

/-- **The axis estimate in `J⁺(Δ)`**: an open set containing a point `x` of `Δ` contains every
`q` with `p ≤ q ≤ P`, for some `P ≫ x` and `p ∈ Δ` before `x` (`x ∈ ]p, +∞[`). -/
theorem btzJ_axis_convex {O : Set (BTZJplus x₀)} (hO : IsOpen O) {x : BTZJplus x₀} (hx : x ∈ O)
    (hax : x.val ∈ btzLine x₀) :
    ∃ P p : Causal.Minkowski 2, (Causal.minkowski 2).lt ⊤ x.val P ∧ p ∈ btzLine x₀ ∧
      x.val ∈ btzJGenSet p ∧ ∀ q : BTZJplus x₀, (Causal.minkowski 2).le ⊤ q.val P →
        (Causal.minkowski 2).le ⊤ p q.val → q ∈ O := by
  have hv := btzV0_pos
  obtain ⟨t, ht⟩ := (mem_btzLine_iff x₀).1 hax
  have hxD : x = btzJDev x₀ btzV0 hv (DInfty.apex, t) :=
    BTZJplus.ext (by rw [btzJDev_val, btzDevM_apex]; exact ht)
  have hN : btzJDev x₀ btzV0 hv ⁻¹' O ∈ @nhds _ hornTop (DInfty.apex, t) :=
    @IsOpen.mem_nhds _ hornTop _ _ ((@continuous_def _ _ hornTop _ _).1 (continuous_btzJDev hv) O hO)
      (by rw [mem_preimage, ← hxD]; exact hx)
  obtain ⟨ε, hε, hεN⟩ := (hasBasis_nhds_hornTop_apex t).mem_iff.1 hN
  obtain ⟨η, hη, hdiam⟩ := btz_axis_diamond (x₀ := x₀) hv t hε
  refine ⟨btzTopVertex x₀ t η, btzPt x₀ (t - η), ?_, (mem_btzLine_iff x₀).2 ⟨_, rfl⟩, ?_,
    fun q h1 h2 => ?_⟩
  · rw [ht]; exact btzPt_lt_btzTopVertex x₀ t hη
  · right; rw [ht, btzRay_btzPt]; exact ⟨t, by linarith, rfl⟩
  · obtain ⟨y', rfl⟩ := btzJDev_surjective (x₀ := x₀) hv q
    rw [btzJDev_val] at h1 h2
    rw [← Causal.Precausality.mem_Jplus_singleton, btzDevM_mem_Jplus_iff hv] at h2
    exact hεN (hdiam y' h1 h2)

/-- A small ball around a regular point is in every neighbourhood. -/
theorem btzJ_exists_ball_of_reg {O : Set (BTZJplus x₀)} (hO : IsOpen O) {x : BTZJplus x₀}
    (hx : x ∈ O) (hreg : x ∈ btzJReg x₀) :
    ∃ ε > 0, ∀ q : BTZJplus x₀, q.val ∈ Metric.ball x.val ε → q ∈ O := by
  have hn : O ∈ 𝓝 x := hO.mem_nhds hx
  rw [nhds_btzJ_of_mem_reg hreg] at hn
  obtain ⟨T, hT, hTO⟩ := Filter.mem_comap.1 hn
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.1 hT
  exact ⟨ε, hε, fun q hq => hTO (hball hq)⟩

theorem btzJSegPt_mem_ball {q q' : BTZJplus x₀} {m : Causal.Minkowski 2} {ε : ℝ}
    (hq : q.val ∈ Metric.ball m ε) (hq' : q'.val ∈ Metric.ball m ε) {s : ℝ}
    (hs : s ∈ Icc (0 : ℝ) 1) : btzJSegPt q q' s ∈ Metric.ball m ε := by
  rw [btzJSegPt_eq_of_mem hs]
  exact (convex_ball m ε).add_smul_sub_mem hq hq' hs

/-- **`I⁺_U(x)` is open.** -/
theorem btzJ_isOpen_CLt_right (U : Opens (BTZJplus x₀)) (x : BTZJplus x₀) :
    IsOpen {y | btzJCLt U x y} := by
  rw [isOpen_iff_mem_nhds]
  rintro y ⟨a, b, hab, c, hc, rfl, rfl⟩
  have hbU : c b ∈ U := hc.mem b ⟨hab.le, le_rfl⟩
  obtain ⟨l, u, hl, hu, hrel⟩ := hc.rel b ⟨hab.le, le_rfl⟩ U le_rfl hbU
  have hm : max a l < b := max_lt hab hl
  have hreg : c b ∈ btzJReg x₀ := by
    have h1 : (max a l + b) / 2 ∈ Icc a b :=
      ⟨by linarith [le_max_left a l], by linarith⟩
    exact btzJ_mem_reg_of_lt (hrel _ h1 b ⟨hab.le, le_rfl⟩
      (by linarith [le_max_right a l]) (by linarith) hu).2.2
  obtain ⟨ε, hε, hball⟩ := btzJ_exists_ball_of_reg U.isOpen hbU hreg
  have hcont : ContinuousWithinAt (fun s => (c s).val) (Icc a b) b :=
    continuous_btzJ_val.continuousAt.comp_continuousWithinAt
      ((hc.continuousOn btzJ_isRelFamily_lt) b ⟨hab.le, le_rfl⟩)
  have hpre : (fun s => (c s).val) ⁻¹' Metric.ball (c b).val (ε / 2) ∈ 𝓝[Icc a b] b :=
    hcont (Metric.ball_mem_nhds _ (by linarith))
  obtain ⟨δ₁, hδ₁, hδball⟩ := Metric.mem_nhdsWithin_iff.1 hpre
  set s₀ := (max (max a l) (b - δ₁) + b) / 2 with hs₀
  have hm' : max (max a l) (b - δ₁) < b := max_lt hm (by linarith)
  have hs₀b : s₀ < b := by rw [hs₀]; linarith
  have hs₀a : a ≤ s₀ := by
    have : a ≤ max (max a l) (b - δ₁) := (le_max_left _ _).trans (le_max_left _ _)
    rw [hs₀]; linarith
  have hs₀l : l < s₀ := by
    have : l ≤ max (max a l) (b - δ₁) := (le_max_right _ _).trans (le_max_left _ _)
    rw [hs₀]; linarith
  have hs₀δ : b - δ₁ < s₀ := by
    have : b - δ₁ ≤ max (max a l) (b - δ₁) := le_max_right _ _
    rw [hs₀]; linarith
  have hs₀mem : s₀ ∈ Icc a b := ⟨hs₀a, hs₀b.le⟩
  have hzy : btzJLt (c s₀) (c b) := (hrel s₀ hs₀mem b ⟨hab.le, le_rfl⟩ hs₀l hs₀b hu).2.2
  have hzball : (c s₀).val ∈ Metric.ball (c b).val (ε / 2) := by
    refine hδball ⟨?_, hs₀mem⟩
    rw [Metric.mem_ball, Real.dist_eq, abs_lt]; constructor <;> linarith
  have hW : IsOpen (BTZJplus.val ⁻¹' (Metric.ball (c b).val (ε / 2) ∩
      (Causal.minkowski 2).Iplus ⊤ {(c s₀).val}) : Set (BTZJplus x₀)) :=
    isOpen_btzJ_val_preimage (Metric.isOpen_ball.inter
      (Causal.Causality.isOpen_Iplus (C := Causal.minkowski 2)))
  refine Filter.mem_of_superset (hW.mem_nhds ⟨Metric.mem_ball_self (by linarith), ?_⟩) ?_
  · exact Causal.Precausality.mem_Iplus_singleton.2 hzy
  · rintro y' ⟨hy'b, hy'c⟩
    have hzy' : btzJLt (c s₀) y' := Causal.Precausality.mem_Iplus_singleton.1 hy'c
    have hsegU : ∀ s ∈ Icc (0 : ℝ) 1, btzJSeg hzy'.le s ∈ U := fun s hs =>
      hball _ (Metric.ball_subset_ball (by linarith) (btzJSegPt_mem_ball hzball hy'b hs))
    have hseg := btzJ_curveOn_seg_lt hzy' hsegU
    have hres : Causal.CurveOn (btzJRelOn btzJLt) U c a s₀ :=
      hc.restrict le_rfl hs₀b.le le_rfl fun t ht => hc.mem t ⟨ht.1, ht.2.trans hs₀b.le⟩
    obtain ⟨d, hd, hda, hdb⟩ := btzJ_curve_append btzJ_isRelFamily_lt hres hseg hs₀a zero_le_one
      (btzJSeg_zero hzy'.le).symm
    exact ⟨a, _, by linarith, d, hd, hda, hdb.trans (btzJSeg_one hzy'.le)⟩

/-- **`I⁻_U(y)` is open**, points of `Δ` included. -/
theorem btzJ_isOpen_CLt_left (U : Opens (BTZJplus x₀)) (y : BTZJplus x₀) :
    IsOpen {x | btzJCLt U x y} := by
  rw [isOpen_iff_mem_nhds]
  rintro x ⟨a, b, hab, c, hc, rfl, hcb⟩
  have haU : c a ∈ U := hc.mem a ⟨le_rfl, hab.le⟩
  obtain ⟨l, u, hl, hu, hrel⟩ := hc.rel a ⟨le_rfl, hab.le⟩ U le_rfl haU
  have htail : ∀ s₀ ∈ Ioo a b, ∀ x' : BTZJplus x₀, ∀ d : ℝ → BTZJplus x₀,
      Causal.CurveOn (btzJRelOn btzJLt) U d 0 1 → d 0 = x' → d 1 = c s₀ → btzJCLt U x' y := by
    intro s₀ hs₀ x' d hd hd0 hd1
    have hres : Causal.CurveOn (btzJRelOn btzJLt) U c s₀ b :=
      hc.restrict hs₀.1.le le_rfl le_rfl fun t ht => hc.mem t ⟨hs₀.1.le.trans ht.1, ht.2⟩
    obtain ⟨e, he, hea, heb⟩ := btzJ_curve_append btzJ_isRelFamily_lt hd hres zero_le_one hs₀.2.le hd1
    exact ⟨0, _, by linarith [hs₀.2], e, he, hea.trans hd0, heb.trans hcb⟩
  have hcont : ContinuousWithinAt (fun s => (c s).val) (Icc a b) a :=
    continuous_btzJ_val.continuousAt.comp_continuousWithinAt
      ((hc.continuousOn btzJ_isRelFamily_lt) a ⟨le_rfl, hab.le⟩)
  -- a parameter `s₀ ∈ (a, min b u)` close to `a`, given a neighbourhood of `c a` in `𝐌³`
  have hpick : ∀ T ∈ 𝓝 (c a).val, ∃ s₀ ∈ Ioo a b, (c s₀).val ∈ T ∧ btzJLt (c a) (c s₀) := by
    intro T hT
    obtain ⟨δ₁, hδ₁, hδball⟩ := Metric.mem_nhdsWithin_iff.1 (hcont hT)
    set s₀ := (a + min (min b u) (a + δ₁)) / 2 with hs₀
    have hm : a < min (min b u) (a + δ₁) := lt_min (lt_min hab hu) (by linarith)
    have hs₀a : a < s₀ := by rw [hs₀]; linarith
    have hs₀b : s₀ < b := by
      have : min (min b u) (a + δ₁) ≤ b := (min_le_left _ _).trans (min_le_left _ _)
      rw [hs₀]; linarith
    have hs₀u : s₀ < u := by
      have : min (min b u) (a + δ₁) ≤ u := (min_le_left _ _).trans (min_le_right _ _)
      rw [hs₀]; linarith
    have hs₀δ : s₀ < a + δ₁ := by
      have : min (min b u) (a + δ₁) ≤ a + δ₁ := min_le_right _ _
      rw [hs₀]; linarith
    have hs₀mem : s₀ ∈ Icc a b := ⟨hs₀a.le, hs₀b.le⟩
    refine ⟨s₀, ⟨hs₀a, hs₀b⟩, hδball ⟨?_, hs₀mem⟩,
      (hrel a ⟨le_rfl, hab.le⟩ s₀ hs₀mem hl hs₀a hs₀u).2.2⟩
    rw [Metric.mem_ball, Real.dist_eq, abs_lt]; constructor <;> linarith
  by_cases hreg : c a ∈ btzJReg x₀
  · -- off `Δ`: a ball
    obtain ⟨ε, hε, hball⟩ := btzJ_exists_ball_of_reg U.isOpen haU hreg
    obtain ⟨s₀, hs₀, hzball, hxz⟩ := hpick _ (Metric.ball_mem_nhds (c a).val (half_pos hε))
    have hW : IsOpen (BTZJplus.val ⁻¹' (Metric.ball (c a).val (ε / 2) ∩
        (Causal.minkowski 2).Iminus ⊤ {(c s₀).val}) : Set (BTZJplus x₀)) :=
      isOpen_btzJ_val_preimage (Metric.isOpen_ball.inter
        (Causal.Causality.isOpen_Iminus (C := Causal.minkowski 2)))
    refine Filter.mem_of_superset (hW.mem_nhds ⟨Metric.mem_ball_self (by linarith),
      Causal.Precausality.mem_Iminus_singleton.2 hxz⟩) ?_
    rintro x' ⟨hx'b, hx'c⟩
    have hx'z : btzJLt x' (c s₀) := Causal.Precausality.mem_Iminus_singleton.1 hx'c
    have hsegU : ∀ s ∈ Icc (0 : ℝ) 1, btzJSeg hx'z.le s ∈ U := fun s hs =>
      hball _ (Metric.ball_subset_ball (by linarith) (btzJSegPt_mem_ball hx'b hzball hs))
    exact htail s₀ hs₀ x' _ (btzJ_curveOn_seg_lt hx'z hsegU) (btzJSeg_zero _) (btzJSeg_one _)
  · -- on `Δ`: the axis estimate
    have hax : (c a).val ∈ btzLine x₀ := by
      by_contra h; exact hreg h
    obtain ⟨P, p, hxP, hp, hxp, hconv⟩ := btzJ_axis_convex U.isOpen haU hax
    obtain ⟨s₀, hs₀, hzP, hxz⟩ := hpick _ ((Causal.Causality.isOpen_Iminus
      (C := Causal.minkowski 2) (U := ⊤) (A := {P})).mem_nhds
      (Causal.Precausality.mem_Iminus_singleton.2 hxP))
    have hzP' : (Causal.minkowski 2).lt ⊤ (c s₀).val P :=
      Causal.Precausality.mem_Iminus_singleton.1 hzP
    have hW : IsOpen (BTZJplus.val ⁻¹' (Causal.minkowski 2).Iminus ⊤ {(c s₀).val} ∩
        BTZJplus.val ⁻¹' btzJGenSet p : Set (BTZJplus x₀)) :=
      (isOpen_btzJ_val_preimage (Causal.Causality.isOpen_Iminus (C := Causal.minkowski 2))).inter
        (isOpen_btzJ_gen hp)
    refine Filter.mem_of_superset (hW.mem_nhds ⟨Causal.Precausality.mem_Iminus_singleton.2 hxz,
      hxp⟩) ?_
    rintro x' ⟨hx'c, hx'g⟩
    have hx'z : btzJLt x' (c s₀) := Causal.Precausality.mem_Iminus_singleton.1 hx'c
    have hpx' : (Causal.minkowski 2).le ⊤ p x'.val := by
      rcases hx'g with h | h
      · exact (Causal.minkowski 2).le_of_lt (Causal.Precausality.mem_Iplus_singleton.1 h)
      · obtain ⟨σ, hσ, he⟩ := h
        rw [he, Causal.Flat.le_top_iff_minkQ, add_sub_cancel_left]
        refine btz_isFutureCausal_smul hσ.le ⟨?_, ?_⟩
        · rw [fst_nullToMink_nullU]; norm_num
        · rw [minkQ_nullToMink]; simp [nullQ, nullU]
    have hsegU : ∀ s ∈ Icc (0 : ℝ) 1, btzJSeg hx'z.le s ∈ U := fun s hs => by
      refine hconv _ ?_ ?_
      · have h1 := btzJ_le_segPt hx'z.le hs.2
        rw [btzJSegPt_one] at h1
        exact (Causal.minkowski 2).le_trans h1 ((Causal.minkowski 2).le_of_lt hzP')
      · exact (Causal.minkowski 2).le_trans hpx' (btzJ_val_le_segPt hx'z.le s)
    exact htail s₀ hs₀ x' _ (btzJ_curveOn_seg_lt hx'z hsegU) (btzJSeg_zero _) (btzJSeg_one _)

variable (x₀) in
/-- **The ETT causality of `J⁺(Δ)` with the BTZ topology** (DEC-33): `q ≤_U q'` (resp.
`q ≪_U q'`) iff a future causal (resp. chronological) curve of `U` joins them, the curves being
BTZ-continuous and locally increasing for the order of `𝐌³`. -/
noncomputable def btzJCausality : Causal.Causality (BTZJplus x₀) where
  le := btzJCLe
  lt := btzJCLt
  le_mem_left h := h.mem_left
  le_mem_right h := h.mem_right
  lt_mem_left h := h.cle.mem_left
  lt_mem_right h := h.cle.mem_right
  le_refl hx := btzJCLe.refl hx
  le_trans := btzJCLe.trans
  lt_trans := btzJCLt.trans
  le_mono hVU _ _ h := h.mono hVU
  lt_mono hVU _ _ h := h.mono hVU
  le_of_lt h := h.cle
  isOpen_lt_right := btzJ_isOpen_CLt_right
  isOpen_lt_left := btzJ_isOpen_CLt_left

/-- **Globally, the causal order of `J⁺(Δ)` is that of `𝐌³`.** -/
theorem btzJCausality_le_top_iff : (btzJCausality x₀).le ⊤ q q' ↔
    (Causal.minkowski 2).le ⊤ q.val q'.val := btzJCLe_top_iff

theorem btzJCausality_lt_top_iff : (btzJCausality x₀).lt ⊤ q q' ↔
    (Causal.minkowski 2).lt ⊤ q.val q'.val := btzJCLt_top_iff

/-! #### Transport to `\widetilde{𝔼₀}` -/

/-- The image of an open set by a homeomorphism. -/
def btzOpensImage {X Z : Type*} [TopologicalSpace X] [TopologicalSpace Z] (e : X ≃ₜ Z)
    (U : Opens X) : Opens Z :=
  ⟨e '' U, e.isOpenMap U U.isOpen⟩

theorem btzOpensImage_top {X Z : Type*} [TopologicalSpace X] [TopologicalSpace Z] (e : X ≃ₜ Z) :
    btzOpensImage e ⊤ = ⊤ :=
  Opens.ext (by simp [btzOpensImage])

theorem btzOpensImage_mono {X Z : Type*} [TopologicalSpace X] [TopologicalSpace Z] (e : X ≃ₜ Z)
    {V U : Opens X} (h : V ≤ U) : btzOpensImage e V ≤ btzOpensImage e U := by
  rintro _ ⟨x, hx, rfl⟩
  exact ⟨x, h hx, rfl⟩

theorem btz_mem_opensImage {X Z : Type*} [TopologicalSpace X] [TopologicalSpace Z] (e : X ≃ₜ Z)
    {U : Opens X} {x : X} (h : e x ∈ btzOpensImage e U) : x ∈ U :=
  e.injective.mem_set_image.1 h

/-- **A causality transported along a homeomorphism** `e : X ≃ₜ Z`: `x ≤_U y` iff
`e x ≤_{e(U)} e y`. -/
def btzTransportCausality {X Z : Type*} [TopologicalSpace X] [TopologicalSpace Z] (e : X ≃ₜ Z)
    (C : Causal.Causality Z) : Causal.Causality X where
  le U x y := C.le (btzOpensImage e U) (e x) (e y)
  lt U x y := C.lt (btzOpensImage e U) (e x) (e y)
  le_mem_left h := btz_mem_opensImage e (C.le_mem_left h)
  le_mem_right h := btz_mem_opensImage e (C.le_mem_right h)
  lt_mem_left h := btz_mem_opensImage e (C.lt_mem_left h)
  lt_mem_right h := btz_mem_opensImage e (C.lt_mem_right h)
  le_refl hx := C.le_refl ⟨_, hx, rfl⟩
  le_trans h₁ h₂ := C.le_trans h₁ h₂
  lt_trans h₁ h₂ := C.lt_trans h₁ h₂
  le_mono hVU _ _ h := C.le_mono (btzOpensImage_mono e hVU) h
  lt_mono hVU _ _ h := C.lt_mono (btzOpensImage_mono e hVU) h
  le_of_lt h := C.le_of_lt h
  isOpen_lt_right U x := (C.isOpen_lt_right (btzOpensImage e U) (e x)).preimage e.continuous
  isOpen_lt_left U x := (C.isOpen_lt_left (btzOpensImage e U) (e x)).preimage e.continuous

theorem btzTransportCausality_le_top_iff {X Z : Type*} [TopologicalSpace X] [TopologicalSpace Z]
    (e : X ≃ₜ Z) (C : Causal.Causality Z) {x y : X} :
    (btzTransportCausality e C).le ⊤ x y ↔ C.le ⊤ (e x) (e y) := by
  show C.le (btzOpensImage e ⊤) (e x) (e y) ↔ _
  rw [btzOpensImage_top]

theorem btzTransportCausality_lt_top_iff {X Z : Type*} [TopologicalSpace X] [TopologicalSpace Z]
    (e : X ≃ₜ Z) (C : Causal.Causality Z) {x y : X} :
    (btzTransportCausality e C).lt ⊤ x y ↔ C.lt ⊤ (e x) (e y) := by
  show C.lt (btzOpensImage e ⊤) (e x) (e y) ↔ _
  rw [btzOpensImage_top]

/-- **`\widetilde{𝔼₀}`** (cylinder model `𝔻_∞ × ℝ`) as a type whose topology is `T_BTZ = hornTop`
(DEC-77 (b)). -/
def BTZTildeCyl : Type := DInfty × ℝ

/-- `T_BTZ`, the topology of `\widetilde{𝔼₀}`. -/
instance btzTildeCylTop : TopologicalSpace BTZTildeCyl := hornTop

variable {v : ℝ × ℝ × ℝ}

variable (x₀ v) in
/-- `D : \widetilde{𝔼₀} ≃ₜ (J⁺(Δ), BTZ)` on the type `BTZTildeCyl`. -/
noncomputable def btzTildeDev (hv : 0 < v.2.1) : BTZTildeCyl ≃ₜ BTZJplus x₀ :=
  btzJDevHomeomorph x₀ v hv

variable (x₀ v) in
/-- **The ETT causality of `\widetilde{𝔼₀}`** (DEC-33, DEC-77 (b)): `btzJCausality` transported along
`D : (\widetilde{𝔼₀}, T_BTZ) ≃ₜ (J⁺(Δ), BTZ)`. Its curves are the `T_BTZ`-continuous curves along
which the developments are locally increasing in `𝐌³`. -/
noncomputable def btzCylCausality (hv : 0 < v.2.1) : Causal.Causality BTZTildeCyl :=
  btzTransportCausality (btzTildeDev x₀ v hv) (btzJCausality x₀)

/-- **Globally, the ETT causal order of `\widetilde{𝔼₀}` is the order of the developments**
(`btzCylLe`): the reading of the previous round is a theorem. -/
theorem btzCylCausality_le_top_iff (hv : 0 < v.2.1) {y y' : BTZTildeCyl} :
    (btzCylCausality x₀ v hv).le ⊤ y y' ↔ btzCylLe x₀ v y y' :=
  (btzTransportCausality_le_top_iff _ _).trans btzJCausality_le_top_iff

theorem btzCylCausality_lt_top_iff (hv : 0 < v.2.1) {y y' : BTZTildeCyl} :
    (btzCylCausality x₀ v hv).lt ⊤ y y' ↔
      (Causal.minkowski 2).lt ⊤ (btzDevM x₀ v y) (btzDevM x₀ v y') :=
  (btzTransportCausality_lt_top_iff _ _).trans btzJCausality_lt_top_iff

theorem btzCylCausality_diamond (hv : 0 < v.2.1) (p q : BTZTildeCyl) :
    (btzCylCausality x₀ v hv).Jminus ⊤ {p} ∩ (btzCylCausality x₀ v hv).Jplus ⊤ {q} =
      (btzCylDiamond x₀ v p q : Set BTZTildeCyl) := by
  ext y
  simp only [mem_inter_iff, Causal.Precausality.mem_Jminus_singleton,
    Causal.Precausality.mem_Jplus_singleton, btzCylCausality_le_top_iff]
  rfl

/-- **`rem:tamifying_topology_generated_open`** (`RamcovGX.tex:2293`), with the ETT causality of
`\widetilde{𝔼₀}` (DEC-33, DEC-77 (b)): `T_BTZ` is generated by the `T_BTZ`-open diamonds
`Int_{T_BTZ}(J⁻(p) ∩ J⁺(q))`, `p, q ∈ \widetilde{𝔼₀}`, `J^±` those of `btzCylCausality`. -/
theorem btz_tamifying_topology_generated_open_ett (hv : 0 < v.2.1) :
    btzTildeCylTop = TopologicalSpace.generateFrom
      {S | ∃ p q : BTZTildeCyl, S = interior
        ((btzCylCausality x₀ v hv).Jminus ⊤ {p} ∩ (btzCylCausality x₀ v hv).Jplus ⊤ {q})} := by
  simp_rw [btzCylCausality_diamond]
  exact btz_tamifying_topology_generated_open hv

/-- The basis form, with the ETT causality. -/
theorem btz_hasBasis_nhds_diamond_ett (hv : 0 < v.2.1) (y : BTZTildeCyl) :
    (𝓝 y).HasBasis
      (fun pq : BTZTildeCyl × BTZTildeCyl => y ∈ interior
        ((btzCylCausality x₀ v hv).Jminus ⊤ {pq.1} ∩ (btzCylCausality x₀ v hv).Jplus ⊤ {pq.2}))
      (fun pq => interior
        ((btzCylCausality x₀ v hv).Jminus ⊤ {pq.1} ∩ (btzCylCausality x₀ v hv).Jplus ⊤ {pq.2})) := by
  simp_rw [btzCylCausality_diamond]
  exact btz_hasBasis_nhds_diamond hv y

/-- An equivalence is a homeomorphism from the induced topology. -/
def btzInducedHomeomorph {X Y : Type*} (e : X ≃ Y) (t : TopologicalSpace Y) :
    @Homeomorph X Y (TopologicalSpace.induced e t) t :=
  @Homeomorph.mk X Y (TopologicalSpace.induced e t) t e continuous_induced_dom
    (continuous_induced_rng.2 (by
      have : (⇑e ∘ e.invFun) = id := funext fun y => e.apply_symm_apply y
      rw [this]; exact @continuous_id _ t))

section Cover

variable {α : ℝ} [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)]
  {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α))ᶜ : Set (BTZModel α))}

/-- **The maximal branched covering `\widetilde{𝔼₀}` with the topology `Φ^* T_BTZ`** (DEC-77 (b)),
for a homeomorphism `Φ` onto the cylinder. -/
def BTZTildeCover (_Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)) y₀ ≃ₜ
      DInfty × ℝ) : Type :=
  MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)) y₀

noncomputable instance btzTildeCoverTop (Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2)
    (BTZModel α)) y₀ ≃ₜ DInfty × ℝ) : TopologicalSpace (BTZTildeCover Φ) :=
  TopologicalSpace.induced Φ hornTop

/-- `Φ : (\widetilde{𝔼₀}, Φ^* T_BTZ) ≃ₜ (cylinder, T_BTZ)`. -/
noncomputable def btzTildeCoverHomeomorph (Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2)
    (BTZModel α)) y₀ ≃ₜ DInfty × ℝ) : BTZTildeCover Φ ≃ₜ BTZTildeCyl :=
  btzInducedHomeomorph Φ.toEquiv hornTop

variable (x₀ v) in
/-- **The ETT causality of the maximal branched covering `\widetilde{𝔼₀}`**, transported along `Φ`. -/
noncomputable def btzCoverCausality (Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2)
    (Causal.Minkowski 2) (BTZModel α)) y₀ ≃ₜ DInfty × ℝ) (hv : 0 < v.2.1) :
    Causal.Causality (BTZTildeCover Φ) :=
  btzTransportCausality (btzTildeCoverHomeomorph Φ) (btzCylCausality x₀ v hv)

/-- **`rem:tamifying_topology_generated_open`** (`RamcovGX.tex:2293`) **on `\widetilde{𝔼₀}` itself**,
the maximal branched covering of `𝔼₀` over its singular locus, with its ETT causality: for `Φ`
onto the cylinder lifting the projection, `Φ^* hornTop` is the tamifying topology `T_BTZ`, `D ∘ Φ`
a developing map of the cover over its regular part, the global order of the ETT causality is the
order of the developments `D ∘ Φ`, and `T_BTZ` is generated by the `T_BTZ`-interiors of the
diamonds `J⁻(p) ∩ J⁺(q)`. -/
theorem btz_tamifying_topology_generated_open_cover_ett
    (Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α)) y₀ ≃ₜ
      DInfty × ℝ) (hv : 0 < v.2.1) (hα : α ≠ 0) (hπ : IsBTZStructure x₀ v α)
    (hΦ : ∀ e, orbitMk (GammaA α) (Φ e) = e.base) :
    IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α) y₀
      (btzTildeCoverTop Φ) ∧
    IsRegDevelopingOnReg (Causal.Flat.isom 2) (Causal.Minkowski 2) (BTZModel α) y₀
      (btzDevM x₀ v ∘ Φ) ∧
    (∀ e e' : BTZTildeCover Φ, (btzCoverCausality x₀ v Φ hv).le ⊤ e e' ↔
      (Causal.minkowski 2).le ⊤ (btzDevM x₀ v (Φ e)) (btzDevM x₀ v (Φ e'))) ∧
    btzTildeCoverTop Φ = TopologicalSpace.generateFrom
      {S | ∃ p q : BTZTildeCover Φ, S = interior
        ((btzCoverCausality x₀ v Φ hv).Jminus ⊤ {p} ∩ (btzCoverCausality x₀ v Φ hv).Jplus ⊤ {q})} := by
  have hle : ∀ e e' : BTZTildeCover Φ, (btzCoverCausality x₀ v Φ hv).le ⊤ e e' ↔
      (Causal.minkowski 2).le ⊤ (btzDevM x₀ v (Φ e)) (btzDevM x₀ v (Φ e')) := fun e e' =>
    (btzTransportCausality_le_top_iff _ _).trans (btzCylCausality_le_top_iff hv)
  refine ⟨btz_isTamifyingTopology hv hα hπ hΦ, btz_isRegDevelopingOnReg hv hα hπ hΦ, hle, ?_⟩
  have hD : ∀ p q : BTZTildeCover Φ, (btzCoverCausality x₀ v Φ hv).Jminus ⊤ {p} ∩
      (btzCoverCausality x₀ v Φ hv).Jplus ⊤ {q} =
      {e | btzCylLe x₀ v (Φ e) (Φ p) ∧ btzCylLe x₀ v (Φ q) (Φ e)} := by
    intro p q
    ext e
    simp only [mem_inter_iff, Causal.Precausality.mem_Jminus_singleton,
      Causal.Precausality.mem_Jplus_singleton, hle]
    rfl
  simp_rw [hD]
  exact btz_tamifying_topology_generated_open_transport Φ hv

end Cover

end ETTCausality

end GX
