namespace GX

open Set Filter Topology Function TopologicalSpace

attribute [local instance] btzE0Structure

set_option linter.unusedSectionVars false

namespace E0Bridge

/-! ### §1 The a.e. atlas of an `𝔼₀`-manifold from its `𝕄 ⊕ 𝔼₀`-atlas -/

section Atlas

variable (M : Type) [TopologicalSpace M] [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid]

/-- **The flat charts** of an `𝔼₀`-manifold: a chart of `M` into `Y = 𝕄 ⊕ 𝔼₀` followed by a
regular chart of `Y` (the identity of `𝕄`, or a chart of the maximal a.e. atlas of `𝔼₀`). -/
def flatCharts : Set (OpenPartialHomeomorph M (Causal.Minkowski 2)) :=
  {e | ∃ x : M, ∃ c ∈ e0Atlas, e = (chartAt E0Y x).trans c}

variable {M}

theorem trans_mem_flatCharts (x : M) {c : OpenPartialHomeomorph E0Y (Causal.Minkowski 2)}
    (hc : c ∈ e0Atlas) : (chartAt E0Y x).trans c ∈ flatCharts M :=
  ⟨x, c, hc, rfl⟩

/-- Two flat charts differ, near every point of their overlap, by an element of `Isom(𝐌³)`. -/
theorem flatCharts_eventually {x₁ x₂ : M} {c₁ c₂ : OpenPartialHomeomorph E0Y (Causal.Minkowski 2)}
    (hc₁ : c₁ ∈ e0Atlas) (hc₂ : c₂ ∈ e0Atlas) {y : M}
    (hy₁ : y ∈ ((chartAt E0Y x₁).trans c₁).source) (hy₂ : y ∈ ((chartAt E0Y x₂).trans c₂).source) :
    ∃ g : Causal.Flat.isom 2, ∀ᶠ z in 𝓝 y,
      ((chartAt E0Y x₂).trans c₂) z = g • ((chartAt E0Y x₁).trans c₁) z := by
  set κ₁ := chartAt E0Y x₁
  set κ₂ := chartAt E0Y x₂
  have ht : κ₁.symm.trans κ₂ ∈ e0Groupoid :=
    HasGroupoid.compatible (chart_mem_atlas E0Y x₁) (chart_mem_atlas E0Y x₂)
  have hy₁s : y ∈ κ₁.source := hy₁.1
  have hy₂s : y ∈ κ₂.source := hy₂.1
  have hy₁c : κ₁ y ∈ c₁.source := hy₁.2
  have hy₂c : κ₂ y ∈ c₂.source := hy₂.2
  have hmem : κ₁ y ∈ (κ₁.symm.trans κ₂).source := by
    refine ⟨κ₁.map_source hy₁s, ?_⟩
    show κ₁.symm (κ₁ y) ∈ κ₂.source
    rw [κ₁.left_inv hy₁s]; exact hy₂s
  obtain ⟨-, hch⟩ := ((mem_e0Groupoid_iff.1 ht).1 (κ₁ y) hmem).2
    (E0LM.source_subset_e0Reg hc₁ hy₁c)
  have hτ : (κ₁.symm.trans κ₂) (κ₁ y) = κ₂ y := by
    show κ₂ (κ₁.symm (κ₁ y)) = κ₂ y
    rw [κ₁.left_inv hy₁s]
  obtain ⟨g, hg⟩ := hch c₁ hc₁ c₂ hc₂ hy₁c (by rw [hτ]; exact hy₂c)
  refine ⟨g, ?_⟩
  filter_upwards [(κ₁.continuousAt hy₁s).eventually hg, κ₁.open_source.mem_nhds hy₁s]
    with z hz hzs
  have h1 : (κ₁.symm.trans κ₂) (κ₁ z) = κ₂ z := by
    show κ₂ (κ₁.symm (κ₁ z)) = κ₂ z
    rw [κ₁.left_inv hzs]
  rw [h1] at hz
  exact hz

theorem isGXAtlas_flatCharts : IsGXAtlas (Causal.Flat.isom 2) (flatCharts M) := by
  refine isGXAtlas_of_eventually fun e he e' he' y hy => ?_
  obtain ⟨x₁, c₁, hc₁, rfl⟩ := he
  obtain ⟨x₂, c₂, hc₂, rfl⟩ := he'
  exact flatCharts_eventually hc₁ hc₂ hy.1 hy.2

/-- The support of the flat charts is `Reg M = M ∖ sing₀(M)`. -/
theorem support_flatCharts : support (flatCharts M) = (E0LM.e0RegM M : Set M) := by
  ext y
  rw [mem_support]
  constructor
  · rintro ⟨_, ⟨x, c, hc, rfl⟩, hy⟩
    exact (E0LM.mem_e0RegM_iff hy.1).2 (E0LM.source_subset_e0Reg hc hy.2)
  · intro hy
    have hr := (E0LM.mem_e0RegM_iff (mem_chart_source E0Y y)).1 hy
    obtain ⟨c, hc, hyc⟩ := mem_support.1 hr
    exact ⟨_, trans_mem_flatCharts y hc, mem_chart_source E0Y y, hyc⟩

/-- **`Reg M` is portly**: open, dense, and locally connected in `M` (the singular part of an
`𝔼₀`-manifold disconnects no connected open set; the model fact `isPreconnected_inter_e0Reg`). -/
theorem isPortly_e0RegM : IsPortly (E0LM.e0RegM M : Set M) := by
  set R : Set M := (E0LM.e0RegM M : Set M)
  have hRd : Dense R := E0LM.dense_e0RegM
  refine ⟨(E0LM.e0RegM M).isOpen, hRd, fun W hW hWc => ?_⟩
  have hcl : W ⊆ closure (W ∩ R) := fun x hx => hW.inter_closure ⟨hx, hRd x⟩
  refine isPreconnected_of_local hWc inter_subset_left hcl fun x hx => ?_
  set e := chartAt E0Y x
  set T := e.target ∩ e.symm ⁻¹' W
  have hTo : IsOpen T := e.isOpen_inter_preimage_symm hW
  have hxT : e x ∈ T := ⟨e.map_source (mem_chart_source E0Y x), by
    show e.symm (e x) ∈ W; rw [e.left_inv (mem_chart_source E0Y x)]; exact hx⟩
  set C := connectedComponentIn T (e x)
  have hCo : IsOpen C := hTo.connectedComponentIn
  have hCT : C ⊆ T := connectedComponentIn_subset _ _
  refine ⟨e.source ∩ e ⁻¹' C, e.isOpen_inter_preimage hCo,
    ⟨mem_chart_source E0Y x, mem_connectedComponentIn hxT⟩, ?_⟩
  have heq : e.source ∩ e ⁻¹' C ∩ (W ∩ R) = e.symm '' (C ∩ e0Reg) := by
    ext z
    constructor
    · rintro ⟨⟨hz, hzC⟩, -, hzR⟩
      exact ⟨e z, ⟨hzC, (E0LM.mem_e0RegM_iff hz).1 hzR⟩, e.left_inv hz⟩
    · rintro ⟨w, ⟨hwC, hwR⟩, rfl⟩
      have hwt : w ∈ e.target := (hCT hwC).1
      have hzs : e.symm w ∈ e.source := e.map_target hwt
      refine ⟨⟨hzs, ?_⟩, (hCT hwC).2, (E0LM.mem_e0RegM_iff hzs).2 ?_⟩
      · show e (e.symm w) ∈ C; rw [e.right_inv hwt]; exact hwC
      · rw [e.right_inv hwt]; exact hwR
  rw [heq]
  exact (isPreconnected_inter_e0Reg hCo isPreconnected_connectedComponentIn).image _
    (e.continuousOn_symm.mono fun w hw => (hCT hw.1).1)

theorem isAEAtlas_flatCharts : IsAEAtlas (Causal.Flat.isom 2) (flatCharts M) :=
  ⟨isGXAtlas_flatCharts, by rw [support_flatCharts]; exact isPortly_e0RegM⟩

end Atlas

/-! ### §1b The singular `(Isom 𝐌³, 𝐌³)`-structure, its regular and singular loci -/

section Structure

variable (M : Type) [TopologicalSpace M] [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid]

/-- **(DEC-119, bridge (1)) The singular `(Isom 𝐌³, 𝐌³)`-structure of an `𝔼₀`-manifold** (DEC-25):
the maximal a.e. atlas generated by the flat charts (`cor:maximal_atlas`). -/
@[reducible] noncomputable def e0SingularGXStructure :
    SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) M :=
  ⟨maximalAEAtlas (Causal.Flat.isom 2) (flatCharts M),
    isAEAtlas_flatCharts.isMaximalAEAtlas_maximalAEAtlas⟩

variable {M}

theorem flatCharts_subset_aeAtlas :
    letI := e0SingularGXStructure M
    flatCharts M ⊆ aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M :=
  isAEAtlas_flatCharts.subset_maximalAEAtlas

/-- A chart of the maximal a.e. atlas cannot reach a singular point of the `𝕄 ⊕ 𝔼₀`-atlas: read
through the `𝔼₀`-chart, it would be a chart of `𝔼₀`'s maximal a.e. atlas at a point of the
singular line, which `𝔼₀` does not have (`GX.btz_sing`). -/
theorem source_subset_e0RegM {ψ : OpenPartialHomeomorph M (Causal.Minkowski 2)}
    (hψ : ψ ∈ (letI := e0SingularGXStructure M
      aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)) :
    ψ.source ⊆ (E0LM.e0RegM M : Set M) := by
  letI := e0SingularGXStructure M
  intro x hx
  by_contra hxR
  set κ := chartAt E0Y x
  have hxκ : x ∈ κ.source := mem_chart_source E0Y x
  have hκx : κ x ∉ e0Reg := fun h => hxR ((E0LM.mem_e0RegM_iff hxκ).2 h)
  obtain ⟨s, hs⟩ : ∃ s : BTZE0, κ x = Sum.inr s := by
    rcases hk : κ x with m | s
    · exact absurd (hk ▸ inl_mem_e0Reg m) hκx
    · exact ⟨s, rfl⟩
  have hsR : s ∉ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 := fun h =>
    hκx (hs ▸ inr_mem_e0Reg_iff.2 h)
  set χ : OpenPartialHomeomorph BTZE0 (Causal.Minkowski 2) := (e0Inr.trans κ.symm).trans ψ
  have hχs : ∀ w, w ∈ χ.source ↔ Sum.inr w ∈ κ.target ∧ κ.symm (Sum.inr w) ∈ ψ.source := by
    intro w
    simp only [χ, OpenPartialHomeomorph.trans_source, e0Inr_source, univ_inter, mem_inter_iff,
      mem_preimage, OpenPartialHomeomorph.symm_source, e0Inr_apply, OpenPartialHomeomorph.coe_trans,
      comp_apply]
  have hsχ : s ∈ χ.source := by
    rw [hχs, ← hs, κ.left_inv hxκ]
    exact ⟨κ.map_source hxκ, hx⟩
  have hB := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0
  have hA := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M
  have hχ : χ ∈ aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 := by
    refine hB.mem_of_compatible fun c hc z hz => ?_
    obtain ⟨hzt, hzψ⟩ := (hχs z).1 hz.1
    set m := κ.symm (Sum.inr z)
    set a := κ.trans (e0Inr.symm.trans c)
    have ha : a ∈ aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M :=
      flatCharts_subset_aeAtlas (trans_mem_flatCharts x (e0InrChart_mem_e0Atlas hc))
    have hma : m ∈ a.source := by
      refine ⟨κ.map_target hzt, ?_⟩
      show κ m ∈ (e0Inr.symm.trans c).source
      rw [κ.right_inv hzt]
      exact mem_e0InrChart_source.2 ⟨z, hz.2, rfl⟩
    obtain ⟨g, hg⟩ := hA.1.1.eventually_smul_eq hψ ha hzψ hma
    have hf : ContinuousAt (e0Inr.trans κ.symm) z :=
      (e0Inr.trans κ.symm).continuousAt (by
        simp only [OpenPartialHomeomorph.trans_source, e0Inr_source, univ_inter, mem_preimage,
          OpenPartialHomeomorph.symm_source, e0Inr_apply]; exact hzt)
    have hfz : (e0Inr.trans κ.symm) z = m := rfl
    have hT : IsOpen (Sum.inr ⁻¹' κ.target : Set BTZE0) :=
      κ.open_target.preimage continuous_inr
    refine ⟨g, ?_⟩
    filter_upwards [hf.eventually (hfz ▸ hg), hT.mem_nhds hzt] with w hw hwt
    have h1 : a ((e0Inr.trans κ.symm) w) = c w := by
      show (e0Inr.symm.trans c) (κ (κ.symm (Sum.inr w))) = c w
      rw [κ.right_inv hwt, e0InrChart_inr]
    rw [h1] at hw
    exact hw
  exact hsR (mem_support.2 ⟨χ, hχ, hsχ⟩)

/-- **The regular locus of the bridge structure is `Reg M`** (DEC-119 (1)). -/
theorem reg_e0SingularGXStructure :
    (letI := e0SingularGXStructure M; Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M) =
      (E0LM.e0RegM M : Set M) := by
  letI := e0SingularGXStructure M
  refine Subset.antisymm (fun x hx => ?_) ?_
  · obtain ⟨ψ, hψ, hxψ⟩ := mem_support.1 hx
    exact source_subset_e0RegM hψ hxψ
  · rw [← support_flatCharts]
    exact support_mono flatCharts_subset_aeAtlas

/-- **The singular locus of the bridge structure is `sing₀(M)`** of the `𝕄 ⊕ 𝔼₀`-atlas. -/
theorem sing_e0SingularGXStructure :
    (letI := e0SingularGXStructure M; Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) =
      Causal.CBG.chartedSing e0SingY M 0 := by
  show (letI := e0SingularGXStructure M; Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ = _
  rw [reg_e0SingularGXStructure]
  exact compl_compl _

end Structure

/-! ### §1c Every singular point is the centre of an `𝔼₀`-chart (`def:atlas`) -/

section XAChart

variable {M : Type} [TopologicalSpace M] [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid]

/-- The component of `s` in the `𝔼₀`-part of the target of the chart at `y`. -/
def xaV (y : M) (s : BTZE0) : Set BTZE0 :=
  connectedComponentIn (Sum.inr ⁻¹' (chartAt E0Y y).target) s

theorem isOpen_xaV (y : M) (s : BTZE0) : IsOpen (xaV y s) :=
  ((chartAt E0Y y).open_target.preimage continuous_inr).connectedComponentIn

theorem xaV_subset (y : M) (s : BTZE0) : xaV y s ⊆ Sum.inr ⁻¹' (chartAt E0Y y).target :=
  connectedComponentIn_subset _ _

/-- The domain of the `𝔼₀`-chart at `y`. -/
def xaU (y : M) (s : BTZE0) : Opens M :=
  ⟨(chartAt E0Y y).source ∩ chartAt E0Y y ⁻¹' (Sum.inr '' xaV y s),
    (chartAt E0Y y).isOpen_inter_preimage (isOpenMap_inr _ (isOpen_xaV y s))⟩

theorem exists_inr_of_mem_xaU {y : M} {s : BTZE0} {u : M} (hu : u ∈ xaU y s) :
    ∃ v ∈ xaV y s, chartAt E0Y y u = Sum.inr v := by
  obtain ⟨v, hv, he⟩ := hu.2
  exact ⟨v, hv, he.symm⟩

/-- The `𝔼₀`-chart at `y`, as a homeomorphism `xaU ≃ₜ xaV` (the chart followed by `inr⁻¹`). -/
noncomputable def xaHomeo (y : M) (s : BTZE0) : xaU y s ≃ₜ (⟨xaV y s, isOpen_xaV y s⟩ : Opens BTZE0) where
  toFun u := ⟨e0Inr.symm (chartAt E0Y y u), by
    obtain ⟨v, hv, he⟩ := exists_inr_of_mem_xaU u.2
    rw [he, e0Inr_symm_inr]; exact hv⟩
  invFun v := ⟨(chartAt E0Y y).symm (Sum.inr v), by
    have ht : Sum.inr (v : BTZE0) ∈ (chartAt E0Y y).target := xaV_subset y s v.2
    exact ⟨(chartAt E0Y y).map_target ht, ⟨v, v.2, ((chartAt E0Y y).right_inv ht).symm⟩⟩⟩
  left_inv u := by
    obtain ⟨v, -, he⟩ := exists_inr_of_mem_xaU u.2
    apply Subtype.ext
    show (chartAt E0Y y).symm (Sum.inr (e0Inr.symm (chartAt E0Y y u))) = u
    rw [he, e0Inr_symm_inr, ← he, (chartAt E0Y y).left_inv u.2.1]
  right_inv v := by
    have ht : Sum.inr (v : BTZE0) ∈ (chartAt E0Y y).target := xaV_subset y s v.2
    apply Subtype.ext
    show e0Inr.symm (chartAt E0Y y ((chartAt E0Y y).symm (Sum.inr v))) = v
    rw [(chartAt E0Y y).right_inv ht, e0Inr_symm_inr]
  continuous_toFun := by
    refine Continuous.subtype_mk ?_ _
    refine e0Inr.continuousOn_symm.comp_continuous
      ((chartAt E0Y y).continuousOn.comp_continuous continuous_subtype_val fun u => u.2.1)
      fun u => ?_
    obtain ⟨v, -, he⟩ := exists_inr_of_mem_xaU u.2
    rw [e0Inr_target, he]; exact ⟨v, rfl⟩
  continuous_invFun := by
    refine Continuous.subtype_mk ?_ _
    exact (chartAt E0Y y).continuousOn_symm.comp_continuous
      (continuous_inr.comp continuous_subtype_val) fun v => xaV_subset y s v.2

theorem xaHomeo_apply (y : M) (s : BTZE0) (u : xaU y s) :
    ((xaHomeo y s u : BTZE0)) = e0Inr.symm (chartAt E0Y y u) := rfl

/-- The `𝔼₀`-chart at a singular point is an a.e. `(Isom 𝐌³, 𝐌³)`-morphism (for the induced
structures on the open sets). -/
theorem isAEMorphism_xaHomeo (y : M) (s : BTZE0) :
    letI := e0SingularGXStructure M
    IsAEMorphism (Causal.Flat.isom 2) (Causal.Minkowski 2) (xaHomeo y s : xaU y s → _) := by
  letI := e0SingularGXStructure M
  set U := xaU y s
  set V : Opens BTZE0 := ⟨xaV y s, isOpen_xaV y s⟩
  set κ := chartAt E0Y y
  set f : U → BTZE0 := Subtype.val ∘ (xaHomeo y s : U → V)
  refine isAEMorphism_of_val_comp V ?_
  have hBN := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0
  have hBU := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) U
  have hBM := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M
  have hfc : Continuous f := continuous_subtype_val.comp (xaHomeo y s).continuous
  have hval := isAEMorphism_opensSingular_val (G := Causal.Flat.isom 2)
    (X := Causal.Minkowski 2) U
  have hvaleq := IsAEMorphismOf.regLocusOf_eq hBU.1 hBM.1 hval
  have hvalreg := isRegularOn_regLocusOf (G := Causal.Flat.isom 2)
    (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) U)
    (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) (Subtype.val : U → M)
  have hRU : ∀ u : U, u ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) U →
      (u : M) ∈ (E0LM.e0RegM M : Set M) := fun u hu => by
    rw [reg_opensSingular, mem_preimage, reg_e0SingularGXStructure] at hu
    exact hu
  have hmaps : ∀ u : U, u ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) U →
      f u ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 := fun u hu => by
    have h1 := (E0LM.mem_e0RegM_iff u.2.1).1 (hRU u hu)
    obtain ⟨v, -, he⟩ := exists_inr_of_mem_xaU u.2
    have hfu : f u = v := by
      show e0Inr.symm (κ u) = v
      rw [he, e0Inr_symm_inr]
    rw [hfu]
    rw [he] at h1
    exact inr_mem_e0Reg_iff.1 h1
  refine (isAEMorphismOf_iff hBN.1).2 ⟨hfc, _, isPortly_reg _ _ _, IsRegularOn.of_exists hBU.1.1
    hBN.1.1 (isOpen_reg _ _ _) subset_rfl (fun u hu => hmaps u hu) hfc.continuousOn
    fun u hu => ?_⟩
  obtain ⟨e, he, hue⟩ := mem_support.1 hu
  obtain ⟨c, hc, hfuc⟩ := mem_support.1 (hmaps u hu)
  set a := κ.trans (e0Inr.symm.trans c)
  have ha : a ∈ aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M :=
    flatCharts_subset_aeAtlas (trans_mem_flatCharts y (e0InrChart_mem_e0Atlas hc))
  obtain ⟨v, -, hev⟩ := exists_inr_of_mem_xaU u.2
  have hfu : f u = v := by
    show e0Inr.symm (κ u) = v
    rw [hev, e0Inr_symm_inr]
  have hua : (u : M) ∈ a.source := by
    refine ⟨u.2.1, ?_⟩
    show κ u ∈ (e0Inr.symm.trans c).source
    rw [hev]; exact mem_e0InrChart_source.2 ⟨v, hfu ▸ hfuc, rfl⟩
  have huR : u ∈ regLocusOf (Causal.Flat.isom 2)
      (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) U)
      (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) Subtype.val := by
    rw [hvaleq]; exact ⟨hu, mem_support.2 ⟨a, ha, hua⟩⟩
  obtain ⟨g, hg⟩ := hvalreg.exists_smul_eq u huR e he a ha hue hua
  exact ⟨e, he, c, hc, hue, hfuc, g, hg⟩

/-- **(DEC-119, bridge (1)) An `𝔼₀`-manifold is `𝔼₀`-modelled** for the bridge structure: every
singular point is the centre of an `𝔼₀`-chart of `def:atlas` (the chart of the `𝕄 ⊕ 𝔼₀`-atlas,
restricted to the component of the singular line it meets). -/
theorem isBTZSingModelled_e0 :
    letI := e0SingularGXStructure M
    IsBTZSingModelled M := by
  letI := e0SingularGXStructure M
  intro y hy'
  have hy : y ∉ (E0LM.e0RegM M : Set M) := by
    rw [← reg_e0SingularGXStructure]; exact hy'
  set κ := chartAt E0Y y
  have hyκ : y ∈ κ.source := mem_chart_source E0Y y
  have hκy : κ y ∉ e0Reg := fun h => hy ((E0LM.mem_e0RegM_iff hyκ).2 h)
  obtain ⟨s, hs⟩ : ∃ s : BTZE0, κ y = Sum.inr s := by
    rcases hk : κ y with m | s
    · exact absurd (hk ▸ inl_mem_e0Reg m) hκy
    · exact ⟨s, rfl⟩
  have hsO : s ∈ (Sum.inr ⁻¹' κ.target : Set BTZE0) := by
    show Sum.inr s ∈ κ.target; rw [← hs]; exact κ.map_source hyκ
  have hyU : y ∈ xaU y s := ⟨hyκ, ⟨s, mem_connectedComponentIn hsO, hs.symm⟩⟩
  refine ⟨(), ⟨{
    U := xaU y s
    V := ⟨xaV y s, isOpen_xaV y s⟩
    φ := xaHomeo y s
    mem := hyU
    isConnected_V := isConnected_connectedComponentIn_iff.2 hsO
    isAEMorphism := isAEMorphism_xaHomeo y s
    mem_S := ?_ }⟩⟩
  show e0Inr.symm (κ y) ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0
  rw [hs, e0Inr_symm_inr]
  exact fun h => hκy (hs ▸ inr_mem_e0Reg_iff.2 h)

end XAChart


/-! ### §2 `reg M̃ ≃ₜ` the universal cover of `Reg M` -/

section SetCongr

variable {Y : Type*} [TopologicalSpace Y]

/-- The universal covers of two equal subsets (based at the same point) are homeomorphic, over
the identity of the ambient space. -/
noncomputable def univCoverCongr {s t : Set Y} (h : s = t) (y₀ : s) :
    UniversalCover s y₀ ≃ₜ UniversalCover t (Set.inclusion h.le y₀) := by
  subst h; exact Homeomorph.refl _

theorem proj_univCoverCongr {s t : Set Y} (h : s = t) (y₀ : s) (c : UniversalCover s y₀) :
    ((UniversalCover.proj t _ (univCoverCongr h y₀ c) : t) : Y) =
      (UniversalCover.proj s y₀ c : Y) := by
  subst h; rfl

theorem univCoverCongr_base {s t : Set Y} (h : s = t) (y₀ : s) :
    univCoverCongr h y₀ (UniversalCover.base y₀) = UniversalCover.base _ := by
  subst h; rfl

end SetCongr

section Cover

variable {M : Type} [TopologicalSpace M] [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid]

/-- The singular locus of the bridge structure, named. -/
abbrev sing (M : Type) [TopologicalSpace M] [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid] :
    Set M :=
  letI := e0SingularGXStructure M
  Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M

theorem compl_sing_eq : (sing M)ᶜ = (E0LM.e0RegM M : Set M) := by
  show (letI := e0SingularGXStructure M; Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜᶜ = _
  rw [compl_compl, reg_e0SingularGXStructure]

theorem isSkeletal_singE0 : IsSkeletal (sing M) := by
  letI := e0SingularGXStructure M
  exact isSkeletal_sing _ _ _

/-- The base point of `Reg M` (as `Causal.Flat`'s flat spacetime `e0RegMFlat M`) under a base point
of `M ∖ sing M`. -/
def regPt (y₀ : ((sing M)ᶜ : Set M)) : (E0LM.e0RegM M : Set M) :=
  Set.inclusion compl_sing_eq.le y₀

theorem semilocallySimplyConnected_compl_sing :
    SemilocallySimplyConnected ((sing M)ᶜ : Set M) := by
  rw [compl_sing_eq]
  exact (semilocallySimplyConnected_iff_causal).2
    (Causal.Flat.semilocallySimplyConnected_of_flat 2 (E0LM.e0RegM M))

variable [T2Space M] [FirstCountableTopology M] [ConnectedSpace M]

/-- **The regular part of `M̃`** (the preimage of `Reg M` in the maximal covering branched over
`sing M`). -/
abbrev regTilde (y₀ : ((sing M)ᶜ : Set M)) : Set (MaxBranchedCover (sing M) y₀) :=
  (SpreadEnd.base ⁻¹' (sing M)ᶜ : Set (MaxBranchedCover (sing M) y₀))

theorem maxBranched_basic_e0 (y₀ : ((sing M)ᶜ : Set M)) :
    letI := e0SingularGXStructure M
    IsSpreadCompletion (univCoverProj (sing M) y₀) SpreadEnd.base
        (SpreadEnd.ofPoint (univCoverProj (sing M) y₀)) ∧
      IsBranchedCovering (SpreadEnd.base : MaxBranchedCover (sing M) y₀ → M) ∧
      IsPossiblyBranchedOver (SpreadEnd.base : MaxBranchedCover (sing M) y₀ → M) (sing M) ∧
      (SpreadEnd.base : MaxBranchedCover (sing M) y₀ → M) ⁻¹' (sing M)ᶜ =
        range (SpreadEnd.ofPoint (univCoverProj (sing M) y₀)) ∧
      LocPathConnectedSpace (MaxBranchedCover (sing M) y₀) ∧
      IsSpread (univCoverProj (sing M) y₀) := by
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  exact maxBranched_basic isSkeletal_singE0 semilocallySimplyConnected_compl_sing y₀

/-- **(DEC-119, bridge (2), gx's universal cover)** `reg M̃ ≃ₜ \widetilde{M ∖ sing M}`, the
inverse of the inclusion of the universal cover of the regular part into its Fox completion. -/
noncomputable def regTildeHomeoGX (y₀ : ((sing M)ᶜ : Set M)) :
    UniversalCover ((sing M)ᶜ : Set M) y₀ ≃ₜ regTilde y₀ := by
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  haveI : LocPathConnectedSpace ((sing M)ᶜ : Set M) :=
    (isSkeletal_singE0 (M := M)).isOpen.locPathConnectedSpace
  haveI : T2Space (UniversalCover ((sing M)ᶜ : Set M) y₀) :=
    t2Space_of_isCoveringMap (UniversalCover.isCoveringMap_proj (y₀ := y₀)
      semilocallySimplyConnected_compl_sing)
  have h := maxBranched_basic_e0 (M := M) y₀
  exact (SpreadEnd.isEmbedding_ofPoint h.2.2.2.2.2).toHomeomorph.trans
    (Homeomorph.setCongr h.2.2.2.1.symm)

theorem regTildeHomeoGX_apply (y₀ : ((sing M)ᶜ : Set M))
    (c : UniversalCover ((sing M)ᶜ : Set M) y₀) :
    (regTildeHomeoGX y₀ c : MaxBranchedCover (sing M) y₀) =
      SpreadEnd.ofPoint (univCoverProj (sing M) y₀) c := rfl

theorem base_regTildeHomeoGX (y₀ : ((sing M)ᶜ : Set M))
    (c : UniversalCover ((sing M)ᶜ : Set M) y₀) :
    (regTildeHomeoGX y₀ c : MaxBranchedCover (sing M) y₀).base =
      (UniversalCover.proj ((sing M)ᶜ : Set M) y₀ c : M) := rfl

/-- **(DEC-119, bridge (2))** `reg M̃ ≃ₜ` the universal cover of `Reg M`, in `lean-causal`'s
presentation (`Causal.UniversalCover` of the flat spacetime `e0RegMFlat M`, the one the headline
`GX.btz_uniformization_C1` quantifies its developing pairs over). -/
noncomputable def regTildeHomeo (y₀ : ((sing M)ᶜ : Set M)) :
    regTilde y₀ ≃ₜ Causal.UniversalCover (e0RegMFlat M) (regPt y₀) :=
  (regTildeHomeoGX y₀).symm.trans
    ((univCoverCongr compl_sing_eq y₀).trans (UniversalCover.toCausal _ (regPt y₀)))

theorem regTildeHomeo_apply (y₀ : ((sing M)ᶜ : Set M))
    (c : UniversalCover ((sing M)ᶜ : Set M) y₀) :
    regTildeHomeo y₀ (regTildeHomeoGX y₀ c) =
      UniversalCover.toCausal _ (regPt y₀) (univCoverCongr compl_sing_eq y₀ c) := by
  simp only [regTildeHomeo, Homeomorph.trans_apply, Homeomorph.symm_apply_apply]
  rfl

/-- The point of `M` under a point of `Reg M`, read in `e0RegMFlat M`. -/
abbrev flatVal (x : e0RegMFlat M) : M :=
  (show E0LM.e0RegM M from x).1

/-- The base point of `e0RegMFlat M`. -/
abbrev regPtF (y₀ : ((sing M)ᶜ : Set M)) : e0RegMFlat M := regPt y₀

/-- Every base point of `e0RegMFlat M` (the headline's `x₀`) comes from a base point of
`M ∖ sing M`. -/
def basePt (x₀ : e0RegMFlat M) : ((sing M)ᶜ : Set M) :=
  ⟨flatVal x₀, by rw [compl_sing_eq]; exact (show E0LM.e0RegM M from x₀).2⟩

theorem regPtF_basePt (x₀ : e0RegMFlat M) : regPtF (basePt x₀) = x₀ := rfl

/-- `regTildeHomeo` lies over `M`: it commutes with the projections. -/
theorem proj_regTildeHomeo (y₀ : ((sing M)ᶜ : Set M)) (z : regTilde y₀) :
    flatVal (Causal.UniversalCover.proj (e0RegMFlat M) (regPt y₀) (regTildeHomeo y₀ z)) =
      (z : MaxBranchedCover (sing M) y₀).base := by
  obtain ⟨c, rfl⟩ := (regTildeHomeoGX y₀).surjective z
  rw [regTildeHomeo_apply]
  exact proj_univCoverCongr compl_sing_eq y₀ c

theorem regTildeHomeo_symm_base (y₀ : ((sing M)ᶜ : Set M)) :
    ((regTildeHomeo y₀).symm (Causal.UniversalCover.base (regPt y₀)) :
      MaxBranchedCover (sing M) y₀) =
      SpreadEnd.ofPoint (univCoverProj (sing M) y₀) (UniversalCover.base y₀) := by
  rw [← regTildeHomeoGX_apply]
  congr 1
  rw [Homeomorph.symm_apply_eq]
  simp only [regTildeHomeo, Homeomorph.trans_apply, Homeomorph.symm_apply_apply]
  rw [univCoverCongr_base]
  rfl

end Cover

/-! ### §3 The developing map of `Reg M̃`, extended to the BTZ points -/

section Develop

variable {M : Type} [TopologicalSpace M] [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid]
  [T2Space M] [FirstCountableTopology M] [ConnectedSpace M]

/-- The a.e. structure `p^*B` of `M̃` exists, and `p : M̃ → M` is an a.e. morphism for it. -/
theorem pullback_spec (y₀ : ((sing M)ᶜ : Set M)) :
    letI := e0SingularGXStructure M
    IsMaximalAEAtlas (Causal.Flat.isom 2) (aePullback (Causal.Flat.isom 2)
        (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
        (SpreadEnd.base : MaxBranchedCover (sing M) y₀ → M)) ∧
      IsAEMorphismOf (Causal.Flat.isom 2) (aePullback (Causal.Flat.isom 2)
        (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
        (SpreadEnd.base : MaxBranchedCover (sing M) y₀ → M))
        (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) SpreadEnd.base := by
  letI := e0SingularGXStructure M
  have hbc := (maxBranched_basic_e0 (M := M) y₀).2.1
  have hB := (isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M).1
  exact aePullback_spec_of_isAELocalHomeomorph hB hbc.isSpread.continuous
    (hbc.isAELocalHomeomorph hB)

/-- **The local form of a regular developing map of `M̃`**: near a regular point `w`, it is a
translate, by an element of `Isom(𝐌³)`, of any flat chart at `p(w)` read through `p`. -/
theorem eventually_dev_eq_smul (y₀ : ((sing M)ᶜ : Set M))
    {D : MaxBranchedCover (sing M) y₀ → Causal.Minkowski 2}
    (hD : letI := e0SingularGXStructure M
      IsRegDevelopingOnReg (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ D)
    {w : MaxBranchedCover (sing M) y₀} (hw : w.base ∈ (sing M)ᶜ)
    {a : OpenPartialHomeomorph M (Causal.Minkowski 2)} (ha : a ∈ flatCharts M)
    (hwa : w.base ∈ a.source) :
    ∃ g : Causal.Flat.isom 2, ∀ᶠ y in 𝓝 w, D y = g • a y.base := by
  letI := e0SingularGXStructure M
  set P := aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
    (SpreadEnd.base : MaxBranchedCover (sing M) y₀ → M)
  set B := aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M
  have hA := pullback_spec (M := M) y₀
  have hBm := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M
  have hreg := hA.2.regLocusOf_eq hA.1.1 hBm.1
  have hwR : w ∈ (SpreadEnd.base : MaxBranchedCover (sing M) y₀ → M) ⁻¹'
      Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M := by
    show w.base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M
    have : w.base ∈ (Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜᶜ := hw
    rwa [compl_compl] at this
  obtain ⟨e, he, hwe⟩ := mem_support.1 (hD.subset_support hwR)
  have hrefl : OpenPartialHomeomorph.refl (Causal.Minkowski 2) ∈
      gxModelAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) :=
    StructureGroupoid.id_mem_maximalAtlas _
  obtain ⟨g, hg⟩ := hD.exists_smul_eq w hwR e he _ hrefl hwe (mem_univ _)
  have hwL : w ∈ regLocusOf (Causal.Flat.isom 2) P B SpreadEnd.base := by
    rw [hreg]; exact ⟨mem_support.2 ⟨e, he, hwe⟩, mem_support.2 ⟨a, flatCharts_subset_aeAtlas ha, hwa⟩⟩
  obtain ⟨h, hh⟩ := (isRegularOn_regLocusOf (G := Causal.Flat.isom 2) P B SpreadEnd.base).exists_smul_eq
    w hwL e he a (flatCharts_subset_aeAtlas ha) hwe hwa
  refine ⟨g * h⁻¹, ?_⟩
  filter_upwards [hg, hh] with y h1 h2
  rw [OpenPartialHomeomorph.refl_apply, id_eq] at h1
  rw [h1, mul_smul, h2, inv_smul_smul]

/-- A regular developing map of `M̃` is continuous, for the natural topology, at the regular
points. -/
theorem continuousAt_dev (y₀ : ((sing M)ᶜ : Set M))
    {D : MaxBranchedCover (sing M) y₀ → Causal.Minkowski 2}
    (hD : letI := e0SingularGXStructure M
      IsRegDevelopingOnReg (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ D)
    {w : MaxBranchedCover (sing M) y₀} (hw : w.base ∈ (sing M)ᶜ) : ContinuousAt D w := by
  have hw' : w.base ∈ support (flatCharts M) := by rw [support_flatCharts, ← compl_sing_eq]; exact hw
  obtain ⟨a, ha, hwa⟩ := mem_support.1 hw'
  obtain ⟨g, hg⟩ := eventually_dev_eq_smul y₀ hD hw ha hwa
  haveI := ChartedSpace.locallyConnectedSpace E0Y M
  have hc : ContinuousAt (fun y : MaxBranchedCover (sing M) y₀ => g • a y.base) w :=
    (continuous_const_smul g).continuousAt.comp
      ((a.continuousAt hwa).comp SpreadEnd.continuous_base.continuousAt)
  exact hc.congr (hg.mono fun y hy => hy.symm)

/-- The developing map of `M̃`, read on the universal cover of `Reg M` through `regTildeHomeo`. -/
noncomputable def devOnCover (y₀ : ((sing M)ᶜ : Set M)) (D : MaxBranchedCover (sing M) y₀ → Causal.Minkowski 2) :
    Causal.UniversalCover (e0RegMFlat M) (regPtF y₀) → Causal.Minkowski 2 :=
  fun c => D ((regTildeHomeo y₀).symm c)

/-- **A regular developing map of `M̃` is a developing map of `Reg M`**: read through
`regTildeHomeo`, it is an `(Isom 𝐌³, 𝐌³)`-morphism of the universal cover of `Reg M` (with its
pulled-back flat structure, the one of `Causal.Flat.IsDevelopingPair`). -/
theorem isGXMorphism_devOnCover (y₀ : ((sing M)ᶜ : Set M))
    {D : MaxBranchedCover (sing M) y₀ → Causal.Minkowski 2}
    (hD : letI := e0SingularGXStructure M
      IsRegDevelopingOnReg (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ D) :
    letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) (regPtF y₀)
    Causal.IsGXMorphism (Causal.Flat.isom 2) (Causal.Minkowski 2) (devOnCover y₀ D) := by
  haveI := Causal.Flat.locPathConnectedSpace_of_flat 2 (e0RegMFlat M)
  have hcrit := isGXMorphism_causalCover_iff (G := Causal.Flat.isom 2) (X := Causal.Minkowski 2)
    (M := e0RegMFlat M) (Causal.Flat.semilocallySimplyConnected_of_flat 2 (e0RegMFlat M))
    (regPtF y₀) (D := devOnCover y₀ D)
  refine hcrit.2 ⟨?_, fun z => ?_⟩
  · refine continuous_iff_continuousAt.2 fun c => ?_
    have hw := ((regTildeHomeo y₀).symm c).2
    have hf : Continuous (fun c => ((regTildeHomeo y₀).symm c : MaxBranchedCover (sing M) y₀)) :=
      continuous_subtype_val.comp (regTildeHomeo y₀).symm.continuous
    exact ContinuousAt.comp (g := D)
      (f := fun c => ((regTildeHomeo y₀).symm c : MaxBranchedCover (sing M) y₀)) (x := c)
      (continuousAt_dev y₀ hD hw) hf.continuousAt
  · set w := (regTildeHomeo y₀).symm z
    set p : E0LM.e0RegM M := show E0LM.e0RegM M from z.pt
    have hpt : (w : MaxBranchedCover (sing M) y₀).base = (p : M) := by
      rw [← proj_regTildeHomeo y₀ w, Homeomorph.apply_symm_apply]
    have ha : E0LM.regChartM p ∈ flatCharts M :=
      ⟨(p : M), E0LM.regAtlasChart p, E0LM.regAtlasChart_mem p, rfl⟩
    have hpa : (p : M) ∈ (E0LM.regChartM p).source :=
      ⟨mem_chart_source E0Y (p : M), E0LM.mem_regAtlasChart_source p⟩
    obtain ⟨g, hg⟩ := eventually_dev_eq_smul y₀ hD w.2 ha (hpt ▸ hpa)
    refine ⟨g, ?_⟩
    have hcont : ContinuousAt (fun c => ((regTildeHomeo y₀).symm c : MaxBranchedCover (sing M) y₀)) z :=
      (continuous_subtype_val.comp (regTildeHomeo y₀).symm.continuous).continuousAt
    filter_upwards [hcont.eventually hg] with y hy
    have hy' : ((regTildeHomeo y₀).symm y : MaxBranchedCover (sing M) y₀).base =
        flatVal (show e0RegMFlat M from y.pt) := by
      rw [← proj_regTildeHomeo y₀ ((regTildeHomeo y₀).symm y), Homeomorph.apply_symm_apply]
    show D ((regTildeHomeo y₀).symm y) = _
    rw [hy] at *
    rw [hy']
    rfl

/-- **(DEC-119, bridge (3)) The developing map of `Reg M̃`, extended continuously to the BTZ
points.** For every `\widetilde M` with the BTZ topology and its developing map
(`GX.BTZTildeData`, built over the bridge structure), and every developing pair `(𝒟, ρ)` of
`Reg M` (the headline's), `𝒟` — read on `reg M̃` through `regTildeHomeo` — extends to a map
`M̃ → 𝐌³` continuous for `T_BTZ`: an `Isom(𝐌³)`-translate of the data's developing map. -/
theorem exists_dev_extension (y₀ : ((sing M)ᶜ : Set M))
    {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
    {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ DInfty × ℝ}
    (d : letI := e0SingularGXStructure M; BTZTildeData M y₀ Φ)
    {D : Causal.UniversalCover (e0RegMFlat M) (regPtF y₀) → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) (regPtF y₀)) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair (regPtF y₀) D ρ) :
    letI := e0SingularGXStructure M
    ∃ g : Causal.Flat.isom 2,
      Continuous[d.T'.top, _] (fun x => g • d.D x) ∧
      ∀ z : regTilde y₀, g • d.D (z : MaxBranchedCover (sing M) y₀) = D (regTildeHomeo y₀ z) := by
  letI := e0SingularGXStructure M
  letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) (regPtF y₀)
  haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) (regPtF y₀)
  haveI : Nonempty (Causal.UniversalCover (e0RegMFlat M) (regPtF y₀)) :=
    ⟨Causal.UniversalCover.base _⟩
  have hD₀ := isGXMorphism_devOnCover y₀ d.isRegDeveloping
  obtain ⟨g, hg, -⟩ := Causal.developing_unique_of_preconnected hD₀ hpair.gx
  refine ⟨g, @Continuous.comp _ _ _ d.T'.top _ _ _ _ (continuous_const_smul g) d.continuous_D,
    fun z => ?_⟩
  have := hg (regTildeHomeo y₀ z)
  rw [this]
  simp only [devOnCover, Homeomorph.symm_apply_apply]

end Develop

/-! ### §3b The developing map of a `\widetilde M`-datum may be translated -/

section Translate

universe v

variable {M : Type v} [TopologicalSpace M] [ConnectedSpace M]
  [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) M]

/-- A translate `g · D` of a regular developing map of `M̃` is one. -/
theorem isRegDevelopingOnReg_smul
    {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M)}
    {D : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀ →
      Causal.Minkowski 2}
    (hD : IsRegDevelopingOnReg (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ D)
    (g : Causal.Flat.isom 2) :
    IsRegDevelopingOnReg (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ (fun x => g • D x) := by
  have hB := (isMaximalAEAtlas_gxModelAtlas (G := Causal.Flat.isom 2)
    (X := Causal.Minkowski 2)).1.1
  have hrefl : OpenPartialHomeomorph.refl (Causal.Minkowski 2) ∈
      gxModelAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) :=
    StructureGroupoid.id_mem_maximalAtlas _
  refine ⟨hD.isOpen, hD.subset_support, fun x _ => by
    rw [support_gxModelAtlas]; exact mem_univ _,
    (continuous_const_smul g).comp_continuousOn hD.continuousOn,
    fun x hx e he e' he' hxe hgx => ?_⟩
  obtain ⟨h, hh⟩ := hD.exists_smul_eq x hx e he _ hrefl hxe (mem_univ _)
  obtain ⟨k, hk⟩ := hB.eventually_smul_eq hrefl he' (mem_univ (g • D x)) hgx
  have hc : ContinuousAt (fun y => g • D y) x :=
    (continuous_const_smul g).continuousAt.comp
      (hD.continuousOn.continuousAt (hD.isOpen.mem_nhds hx))
  refine ⟨k * g * h, ?_⟩
  filter_upwards [hc.eventually hk, hh] with y h1 h2
  rw [OpenPartialHomeomorph.refl_apply, id_eq] at h1 h2
  rw [h1, h2, mul_smul, mul_smul]

/-- A `\widetilde M`-datum whose developing map is translated by `g ∈ Isom(𝐌³)`. -/
noncomputable def btzTildeDataSmul
    {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M)}
    {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
    {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ DInfty × ℝ}
    (d : BTZTildeData M y₀ Φ) (g : Causal.Flat.isom 2) : BTZTildeData M y₀ Φ where
  T' := d.T'
  le_natural := d.le_natural
  nhds_reg := d.nhds_reg
  D := fun x => g • d.D x
  continuous_D := @Continuous.comp _ _ _ d.T'.top _ _ _ _ (continuous_const_smul g) d.continuous_D
  isRegDeveloping := isRegDevelopingOnReg_smul d.isRegDeveloping g
  isLocallyBTZTilde := by
    intro e he
    obtain ⟨c, f, Ψ, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, k, hk⟩ :=
      d.isLocallyBTZTilde e he
    exact ⟨c, f, Ψ, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, g * k, fun v hv => by
      show g • d.D (Ψ v) = _
      rw [hk v hv, mul_smul]⟩
  isPresentation := d.isPresentation

theorem btzTildeDataSmul_D
    {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M)}
    {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
    {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ DInfty × ℝ}
    (d : BTZTildeData M y₀ Φ) (g : Causal.Flat.isom 2) (x) :
    (btzTildeDataSmul d g).D x = g • d.D x := rfl

theorem btzTildeDataSmul_T'
    {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M)}
    {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
    {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ DInfty × ℝ}
    (d : BTZTildeData M y₀ Φ) (g : Causal.Flat.isom 2) : (btzTildeDataSmul d g).T' = d.T' := rfl

end Translate

/-! ### §3c The headline's developing pair is the developing map of a `\widetilde M`-datum -/

section Headline

variable {M : Type} [TopologicalSpace M] [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid]
  [T2Space M] [FirstCountableTopology M] [ConnectedSpace M]

/-- **(DEC-119, bridge (3), datum form)** For every `\widetilde M`-datum `d` (`T_BTZ` and a
developing map, over the bridge structure) and every developing pair `(𝒟, ρ)` of `Reg M`, the
translate of `d` by the unique isometry matching the developing maps is a datum, with the same
topology `T_BTZ`, whose developing map **is** `𝒟` on `reg M̃` (through `regTildeHomeo`): `𝒟`
extended `T_BTZ`-continuously to the BTZ points. -/
theorem exists_btzTildeData_extending (y₀ : ((sing M)ᶜ : Set M))
    {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
    {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ DInfty × ℝ}
    (d : letI := e0SingularGXStructure M; BTZTildeData M y₀ Φ)
    {D : Causal.UniversalCover (e0RegMFlat M) (regPtF y₀) → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) (regPtF y₀)) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair (regPtF y₀) D ρ) :
    letI := e0SingularGXStructure M
    ∃ d' : BTZTildeData M y₀ Φ, d'.T' = d.T' ∧
      ∀ z : regTilde y₀, d'.D (z : MaxBranchedCover (sing M) y₀) = D (regTildeHomeo y₀ z) := by
  letI := e0SingularGXStructure M
  obtain ⟨g, -, hg⟩ := exists_dev_extension y₀ d hpair
  exact ⟨btzTildeDataSmul d g, rfl, hg⟩

/-- **(DEC-119, bridge (3), existence form)** For every developing pair `(𝒟, ρ)` of `Reg M` and
every presentation `Φ` of `\widetilde{𝔼₀}`, there is a `\widetilde M`-datum (`T_BTZ` and a
`T_BTZ`-continuous developing map of `M̃`) whose developing map extends `𝒟` from `reg M̃` to the
BTZ points. -/
theorem exists_btzTildeData_of_isDevelopingPair (y₀ : ((sing M)ᶜ : Set M))
    {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
    {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ DInfty × ℝ}
    (hΦ : ∀ e, orbitMk (GammaA (2 * Real.pi)) (Φ e) = e.base)
    {D : Causal.UniversalCover (e0RegMFlat M) (regPtF y₀) → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) (regPtF y₀)) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair (regPtF y₀) D ρ) :
    letI := e0SingularGXStructure M
    ∃ d : BTZTildeData M y₀ Φ,
      ∀ z : regTilde y₀, d.D (z : MaxBranchedCover (sing M) y₀) = D (regTildeHomeo y₀ z) := by
  letI := e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  obtain ⟨d⟩ := BTZTildeData.nonempty (M := M) (y₀ := y₀) (Φ := Φ) isBTZSingModelled_e0 hΦ
  obtain ⟨d', -, hd'⟩ := exists_btzTildeData_extending y₀ d hpair
  exact ⟨d', hd'⟩

/-- **The developing map of a `\widetilde M`-datum is a developing map of `Reg M`**: read through
`regTildeHomeo`, it is, with a holonomy, a developing pair of `Reg M` in `Causal.Flat`'s sense
(the conjugate of any developing pair's holonomy). -/
theorem exists_isDevelopingPair_devOnCover (y₀ : ((sing M)ᶜ : Set M))
    {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
    {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ DInfty × ℝ}
    (d : letI := e0SingularGXStructure M; BTZTildeData M y₀ Φ) :
    letI := e0SingularGXStructure M
    ∃ ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) (regPtF y₀)) →* Causal.Flat.isom 2,
      Causal.Flat.IsDevelopingPair (regPtF y₀) (devOnCover y₀ d.D) ρ := by
  letI := e0SingularGXStructure M
  obtain ⟨D, ρ, hpair⟩ := Causal.Flat.exists_isDevelopingPair (d := 2) (M := e0RegMFlat M)
    (regPtF y₀)
  obtain ⟨g, -, hg⟩ := exists_dev_extension y₀ d hpair
  have hD : ∀ c, devOnCover y₀ d.D c = g⁻¹ • D c := fun c => by
    obtain ⟨z, rfl⟩ := (regTildeHomeo y₀).surjective c
    rw [← hg z, inv_smul_smul]
    simp only [devOnCover, Homeomorph.symm_apply_apply]
  refine ⟨(MulAut.conj g⁻¹).toMonoidHom.comp ρ, isGXMorphism_devOnCover y₀ d.isRegDeveloping,
    fun γ z => ?_⟩
  rw [hD, hD, hpair.equiv]
  simp only [MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom, comp_apply, MulAut.conj_apply, inv_inv,
    mul_smul, smul_inv_smul]

end Headline

/-! ### §4 The causality of the bridge structure is the charted causality -/

section GeneratedCompat

variable {Y : Type} [TopologicalSpace Y] {G : StructureGroupoid Y} {D : Causal.Causality Y}
  {N : Type} [TopologicalSpace N] [ChartedSpace Y N] [HasGroupoid N G]

/-- **A chart compatible with the atlas is an isomorphism of the charted causality**: if every
transition from `κ` to a preferred chart is in `G`, the charted causality agrees on `κ`'s source
with the transport of the model along `κ`. -/
theorem agreeOn_chartedCausality_of_compatible (hGD : ∀ e ∈ G, Causal.ChartIso D D e)
    (hA : ∀ W : Opens Y, D.AbsolutelyMinimalOn W) {κ : OpenPartialHomeomorph N Y}
    (hκ : ∀ x : N, κ.symm.trans (chartAt Y x) ∈ G) :
    Causal.AgreeOn (Causal.CBG.chartedCausality D N) (D.chartTransport κ) (Causal.chartSource κ) := by
  set C := Causal.CBG.chartedCausality D N
  have hloc : ∀ z ∈ Causal.chartSource κ, ∃ O : Opens N, z ∈ O ∧
      Causal.AgreeOn (D.chartTransport κ) C O := by
    intro z hz
    refine ⟨Causal.chartSource κ ⊓ Causal.chartSource (chartAt Y z), ⟨hz, mem_chart_source Y z⟩, ?_⟩
    refine Causal.ChartIso.agreeOn_of_localIso (D.chartTransport_chartIso κ)
      (Causal.CBG.chartedCausality_chartIso hGD hA z) (ψ := κ.symm.trans (chartAt Y z))
      (hGD _ (hκ z)) le_rfl ?_
    intro w hw
    refine ⟨⟨κ.map_source hw.1, ?_⟩, ?_⟩
    · show κ.symm (κ w) ∈ (chartAt Y z).source
      rw [κ.left_inv hw.1]; exact hw.2
    · show (chartAt Y z) (κ.symm (κ w)) = (chartAt Y z) w
      rw [κ.left_inv hw.1]
  have hA₁ : (D.chartTransport κ).AbsolutelyMinimalOn (Causal.chartSource κ) :=
    (D.chartTransport_chartIso κ).absolutelyMinimalOn le_rfl (hA _)
  have hA₂ : C.AbsolutelyMinimalOn (Causal.chartSource κ) :=
    Causal.CBG.chartedCausality_absolutelyMinimalOn hGD hA _
  intro V hV x y
  have i1 := Causal.imp_of_agree_locally hA₁ hloc hV (x := x) (y := y)
  have i2 := Causal.imp_of_agree_locally hA₂ (fun z hz => by
    obtain ⟨O, hzO, hO⟩ := hloc z hz
    exact ⟨O, hzO, hO.symm⟩) hV (x := x) (y := y)
  exact ⟨⟨i2.1, i1.1⟩, ⟨i2.2, i1.2⟩⟩

/-- **The causality generated by an atlas compatible with the preferred one is the charted
causality.** -/
theorem chartAtlasCausality_eq_chartedCausality (hGD : ∀ e ∈ G, Causal.ChartIso D D e)
    (hA : ∀ W : Opens Y, D.AbsolutelyMinimalOn W) {A : Set (OpenPartialHomeomorph N Y)}
    (hAc : ∀ e : N, ∃ κ ∈ A, e ∈ κ.source)
    (hκ : ∀ κ ∈ A, ∀ x : N, κ.symm.trans (chartAt Y x) ∈ G) :
    chartAtlasCausality D A hAc = Causal.CBG.chartedCausality D N := by
  set C := Causal.CBG.chartedCausality D N
  set CA := chartAtlasCausality D A hAc
  have hag : ∀ κ : A, Causal.AgreeOn C (D.chartTransport κ.1) (Causal.chartSource κ.1) :=
    fun κ => agreeOn_chartedCausality_of_compatible hGD hA (hκ κ.1 κ.2)
  have hB : Causal.Precausality.Compatible (fun κ : A => Causal.chartSource κ.1)
      (fun κ => (D.chartTransport κ.1).toPrecausality) := by
    refine Causal.compatible_of_agree_locally (fun κ W hW =>
      (D.chartTransport_chartIso κ.1).absolutelyMinimalOn hW (hA _)) ?_
    intro κ κ' z hz
    refine ⟨Causal.chartSource κ.1 ⊓ Causal.chartSource κ'.1, hz, fun V hV a b => ?_⟩
    have h1 := hag κ V (hV.trans inf_le_left) a b
    have h2 := hag κ' V (hV.trans inf_le_right) a b
    exact ⟨h1.1.symm.trans h2.1, h1.2.symm.trans h2.2⟩
  have hU : ∀ e : N, ∃ κ : A, e ∈ Causal.chartSource κ.1 := fun e =>
    ⟨⟨(hAc e).choose, (hAc e).choose_spec.1⟩, (hAc e).choose_spec.2⟩
  have hagA : ∀ κ : A, Causal.AgreeOn CA (D.chartTransport κ.1) (Causal.chartSource κ.1) :=
    fun κ V hV a b =>
      ⟨Causal.Precausality.generated_le_iff (hU := hU) hB hV,
        Causal.Precausality.generated_lt_iff (hU := hU) hB hV⟩
  have hAC : ∀ κ : A, Causal.AgreeOn C CA (Causal.chartSource κ.1) := fun κ V hV a b => by
    have h1 := hag κ V hV a b
    have h2 := hagA κ V hV a b
    exact ⟨h1.1.trans h2.1.symm, h1.2.trans h2.2.symm⟩
  have hmin : C.AbsolutelyMinimalOn ⊤ :=
    Causal.CBG.chartedCausality_absolutelyMinimalOn hGD hA ⊤
  have hlocC : ∀ z ∈ (⊤ : Opens N), ∃ O : Opens N, z ∈ O ∧ Causal.AgreeOn C CA O := fun z _ => by
    obtain ⟨κ, hz⟩ := hU z
    exact ⟨_, hz, hAC κ⟩
  have key : ∀ V : Opens N, ∀ x y : N, (CA.le V x y ↔ C.le V x y) ∧ (CA.lt V x y ↔ C.lt V x y) := by
    intro V x y
    have i1 := Causal.imp_of_agree_locally hmin hlocC (le_top : V ≤ ⊤) (x := x) (y := y)
    have j1 : CA.le V x y → C.le V x y := fun h =>
      Causal.Precausality.generated_le_imp (hU := hU) C.toPrecausality
        (fun κ V' hV' a b hab => ((hag κ V' hV' a b).1).2 hab) h
    have j2 : CA.lt V x y → C.lt V x y := fun h =>
      Causal.Precausality.generated_lt_imp (hU := hU) C.toPrecausality
        (fun κ V' hV' a b hab => ((hag κ V' hV' a b).2).2 hab) h
    exact ⟨⟨j1, i1.1⟩, ⟨j2, i1.2⟩⟩
  apply Causal.Causality.ext_toPrecausality
  ext V x y
  · exact (key V x y).1
  · exact (key V x y).2

end GeneratedCompat

section E0CausalityBridge

variable {M : Type} [TopologicalSpace M] [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid]

/-- A chart of `M` into `𝕄 ⊕ 𝔼₀` is *flat-compatible* with the bridge structure: it sees the
regular locus, and followed by any regular chart of the model it is a chart of the maximal a.e.
atlas. -/
def IsFlatCompat (κ : OpenPartialHomeomorph M E0Y) : Prop :=
  (∀ m ∈ κ.source, (κ m ∈ e0Reg ↔ m ∈ (E0LM.e0RegM M : Set M))) ∧
    ∀ c ∈ e0Atlas, κ.trans c ∈
      (letI := e0SingularGXStructure M; aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)

theorem isFlatCompat_chartAt (x : M) : IsFlatCompat (chartAt E0Y x) :=
  ⟨fun _ hm => (E0LM.mem_e0RegM_iff hm).symm,
    fun _ hc => flatCharts_subset_aeAtlas (trans_mem_flatCharts x hc)⟩

theorem e0RegAt_symm_trans_of_isFlatCompat {κ κ' : OpenPartialHomeomorph M E0Y}
    (hκ : IsFlatCompat κ) (hκ' : IsFlatCompat κ') :
    ∀ y ∈ (κ.symm.trans κ').source, E0RegAt (κ.symm.trans κ') y := by
  letI := e0SingularGXStructure M
  intro y hy
  have hyt : y ∈ κ.target := hy.1
  have hm' : κ.symm y ∈ κ'.source := hy.2
  have hm : κ.symm y ∈ κ.source := κ.map_target hyt
  refine ⟨(κ.symm.trans κ').continuousAt hy, fun hyR => ?_⟩
  have hκm : κ (κ.symm y) = y := κ.right_inv hyt
  have hmR : κ.symm y ∈ (E0LM.e0RegM M : Set M) := (hκ.1 _ hm).1 (by rw [hκm]; exact hyR)
  have hτR : κ' (κ.symm y) ∈ e0Reg := (hκ'.1 _ hm').2 hmR
  refine ⟨hτR, fun c hc c' hc' hyc hτc => ?_⟩
  have hA := (isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M).1.1
  have h1 : κ.symm y ∈ (κ.trans c).source := ⟨hm, by
    show κ (κ.symm y) ∈ c.source; rw [hκm]; exact hyc⟩
  have h2 : κ.symm y ∈ (κ'.trans c').source := ⟨hm', hτc⟩
  obtain ⟨g, hg⟩ := hA.eventually_smul_eq (hκ.2 c hc) (hκ'.2 c' hc') h1 h2
  refine ⟨g, ?_⟩
  filter_upwards [(κ.continuousAt_symm hyt).eventually hg, κ.open_target.mem_nhds hyt]
    with w hw hwt
  simp only [OpenPartialHomeomorph.coe_trans, comp_apply] at hw ⊢
  rw [κ.right_inv hwt] at hw
  exact hw

/-- **Two flat-compatible charts differ by an element of `G = e0Groupoid`.** -/
theorem symm_trans_mem_e0Groupoid_of_isFlatCompat {κ κ' : OpenPartialHomeomorph M E0Y}
    (hκ : IsFlatCompat κ) (hκ' : IsFlatCompat κ') : κ.symm.trans κ' ∈ e0Groupoid := by
  refine mem_e0Groupoid_iff.2 ⟨e0RegAt_symm_trans_of_isFlatCompat hκ hκ', fun y hy => ?_⟩
  have heq : (κ.symm.trans κ').symm = κ'.symm.trans κ := by
    rw [OpenPartialHomeomorph.trans_symm_eq_symm_trans_symm, OpenPartialHomeomorph.symm_symm]
  have hy' : y ∈ (κ'.symm.trans κ).source := by
    rw [← heq, OpenPartialHomeomorph.symm_source]; exact hy
  rw [heq]
  exact e0RegAt_symm_trans_of_isFlatCompat hκ' hκ y hy'

/-- A regular chart of the bridge structure, read into `𝕄 ⊕ 𝔼₀`, is flat-compatible. -/
theorem isFlatCompat_regChartToE0Y {ψ : OpenPartialHomeomorph M (Causal.Minkowski 2)}
    (hψ : ψ ∈ (letI := e0SingularGXStructure M
      aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)) :
    IsFlatCompat (letI := e0SingularGXStructure M; regChartToE0Y ψ) := by
  letI := e0SingularGXStructure M
  have hsrc : ∀ m ∈ (regChartToE0Y ψ).source, m ∈ ψ.source := fun m hm => hm.1
  refine ⟨fun m hm => ⟨fun _ => source_subset_e0RegM hψ (hsrc m hm), fun _ => by
    rw [regChartToE0Y_apply]; exact inl_mem_e0Reg _⟩, fun c hc => ?_⟩
  have hB := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M
  refine hB.isComplete ψ hψ _ ⟨fun m hm => hsrc m hm.1, fun m hm => ?_⟩
  have hmc : Sum.inl (ψ m) ∈ c.source := by
    have h := hm.2
    change regChartToE0Y ψ m ∈ c.source at h
    rwa [regChartToE0Y_apply] at h
  have hceq := eq_of_mem_e0Atlas_inl hc hmc
  show c (regChartToE0Y ψ m) = ψ m
  rw [regChartToE0Y_apply, hceq, e0Inl_symm_inl]

theorem xaChartToE0Y_source_subset {x₀ : M}
    (c₀ : letI := e0SingularGXStructure M
      XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS () x₀) :
    letI := e0SingularGXStructure M
    (xaChartToE0Y c₀).source ⊆ (c₀.U : Set M) := by
  letI := e0SingularGXStructure M
  intro m hm
  have h := hm.1.1.1
  simpa using h

/-- The `𝔼₀`-chart read into `𝕄 ⊕ 𝔼₀`, on its domain (`GX.xaChartToE0Y_apply` without its
section's hypotheses). -/
theorem xaChartToE0Y_apply_mk {x₀ : M}
    (c₀ : letI := e0SingularGXStructure M
      XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS () x₀) {m : M}
    (hm : m ∈ (letI := e0SingularGXStructure M; (c₀.U : Set M))) :
    letI := e0SingularGXStructure M
    xaChartToE0Y c₀ m = Sum.inr ((c₀.φ ⟨m, hm⟩ : c₀.V) : BTZE0) := by
  letI := e0SingularGXStructure M
  have he : (c₀.U.openPartialHomeomorphSubtypeCoe ⟨⟨x₀, c₀.mem⟩⟩).symm m = ⟨m, hm⟩ :=
    Subtype.ext ((c₀.U.openPartialHomeomorphSubtypeCoe ⟨⟨x₀, c₀.mem⟩⟩).right_inv
      (by simpa using hm))
  simp [xaChartToE0Y, he]

/-- An `𝔼₀`-chart of `def:atlas` of the bridge structure, read into `𝕄 ⊕ 𝔼₀`, is
flat-compatible. -/
theorem isFlatCompat_xaChartToE0Y {x₀ : M}
    (c₀ : letI := e0SingularGXStructure M
      XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS () x₀) :
    IsFlatCompat (letI := e0SingularGXStructure M; xaChartToE0Y c₀) := by
  letI := e0SingularGXStructure M
  set U := c₀.U
  set V := c₀.V
  set κ := xaChartToE0Y c₀
  have hBM := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M
  have hBU := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) U
  have hBV := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) V
  have hBN := isMaximalAEAtlas_aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0
  have hpre := (IsAEMorphism.preimage_reg_sing c₀.isAEMorphism c₀.φ.isLocalHomeomorph).1
  -- regularity transported by `φ`
  have hregU : ∀ u : U, (u : M) ∈ (E0LM.e0RegM M : Set M) ↔
      ((c₀.φ u : V) : BTZE0) ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 := by
    intro u
    rw [← reg_e0SingularGXStructure]
    have h1 : u ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) U ↔
        (u : M) ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M := by
      rw [reg_opensSingular]; rfl
    have h2 : c₀.φ u ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) V ↔
        ((c₀.φ u : V) : BTZE0) ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 := by
      rw [reg_opensSingular]; rfl
    rw [← h1, ← h2, ← hpre]; rfl
  refine ⟨fun m hm => ?_, fun c hc => ?_⟩
  · have hmU := xaChartToE0Y_source_subset c₀ hm
    rw [show κ m = _ from xaChartToE0Y_apply_mk c₀ hmU, inr_mem_e0Reg_iff]
    exact (hregU ⟨m, hmU⟩).symm
  · refine hBM.mem_of_compatible fun a ha m hm => ?_
    obtain ⟨⟨hmκ, hmc⟩, hma⟩ := hm
    have hmU : m ∈ (U : Set M) := xaChartToE0Y_source_subset c₀ hmκ
    set u : U := ⟨m, hmU⟩
    have hκm : κ m = Sum.inr ((c₀.φ u : V) : BTZE0) := xaChartToE0Y_apply_mk c₀ hmU
    change κ m ∈ c.source at hmc
    rw [hκm] at hmc
    obtain ⟨b, hb, rfl, hvb⟩ := exists_of_mem_e0Atlas_inr hc hmc
    have hvR : ((c₀.φ u : V) : BTZE0) ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 :=
      mem_support.2 ⟨b, hb, hvb⟩
    have hmR : m ∈ (E0LM.e0RegM M : Set M) := (hregU u).2 hvR
    have huR : u ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) U := by
      rw [reg_opensSingular, mem_preimage, reg_e0SingularGXStructure]; exact hmR
    have hφuR : c₀.φ u ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) V := by
      rw [reg_opensSingular]; exact hvR
    obtain ⟨aU, haU, huaU⟩ := mem_support.1 huR
    obtain ⟨bV, hbV, hφbV⟩ := mem_support.1 hφuR
    -- `φ` is regular at `u`
    have hφeq := IsAEMorphismOf.regLocusOf_eq hBU.1 hBV.1 c₀.isAEMorphism
    have huφ : u ∈ regLocusOf (Causal.Flat.isom 2)
        (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) U)
        (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) V) c₀.φ := by
      rw [hφeq]; exact ⟨huR, hφuR⟩
    obtain ⟨h₁, hh₁⟩ := (isRegularOn_regLocusOf (G := Causal.Flat.isom 2) _ _ _).exists_smul_eq
      u huφ aU haU bV hbV huaU hφbV
    -- `val : V → 𝔼₀` is regular at `φ u`
    have hvalV := isAEMorphism_opensSingular_val (G := Causal.Flat.isom 2)
      (X := Causal.Minkowski 2) V
    have hVeq := IsAEMorphismOf.regLocusOf_eq hBV.1 hBN.1 hvalV
    have hφval : c₀.φ u ∈ regLocusOf (Causal.Flat.isom 2)
        (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) V)
        (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) Subtype.val := by
      rw [hVeq]; exact ⟨hφuR, hvR⟩
    obtain ⟨h₂, hh₂⟩ := (isRegularOn_regLocusOf (G := Causal.Flat.isom 2) _ _ _).exists_smul_eq
      _ hφval bV hbV b hb hφbV hvb
    -- `val : U → M` is regular at `u`
    have hvalU := isAEMorphism_opensSingular_val (G := Causal.Flat.isom 2)
      (X := Causal.Minkowski 2) U
    have hUeq := IsAEMorphismOf.regLocusOf_eq hBU.1 hBM.1 hvalU
    have huval : u ∈ regLocusOf (Causal.Flat.isom 2)
        (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) U)
        (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) Subtype.val := by
      rw [hUeq]; exact ⟨huR, mem_support.2 ⟨a, ha, hma⟩⟩
    obtain ⟨h₃, hh₃⟩ := (isRegularOn_regLocusOf (G := Causal.Flat.isom 2) _ _ _).exists_smul_eq
      u huval aU haU a ha huaU hma
    refine ⟨h₃ * h₁⁻¹ * h₂⁻¹, ?_⟩
    have hev : ∀ᶠ (w : U) in 𝓝 u,
        a w.1 = (h₃ * h₁⁻¹ * h₂⁻¹) • (κ.trans (e0Inr.symm.trans b)) w.1 := by
      filter_upwards [hh₁, hh₃, c₀.φ.continuous.continuousAt.eventually hh₂] with w hw1 hw3 hw2
      have hκw : (κ.trans (e0Inr.symm.trans b)) (w : M) = b ((c₀.φ w : V) : BTZE0) := by
        show (e0Inr.symm.trans b) (κ w) = _
        rw [show κ w = _ from xaChartToE0Y_apply_mk c₀ w.2, e0InrChart_inr]
      rw [hκw, hw3, hw2, hw1, mul_smul, mul_smul, inv_smul_smul, inv_smul_smul]
    have hmap := U.isOpen.isOpenEmbedding_subtypeVal.map_nhds_eq u
    have : ∀ᶠ q in Filter.map Subtype.val (𝓝 u),
        a q = (h₃ * h₁⁻¹ * h₂⁻¹) • (κ.trans (e0Inr.symm.trans b)) q := Filter.eventually_map.2 hev
    exact Filter.Eventually.filter_mono hmap.ge this

/-- **The causality of the bridge structure is the charted causality** (the charted causality
`Causal.CBG.chartedCausality E0LM.D M` is the one the headline's global hyperbolicity is read for;
`GX.e0ManifoldCausality` is the one of `GX.BTZ.Manifolds`, generated by the a.e. atlas and the
`𝔼₀`-charts): the two atlases are compatible through `e0Groupoid`, whose elements are
isomorphisms of the model causality (`GX.E0.chartIso_mem_e0Groupoid`). -/
theorem e0ManifoldCausality_eq_chartedCausality :
    (letI := e0SingularGXStructure M; e0ManifoldCausality M isBTZSingModelled_e0) =
      Causal.CBG.chartedCausality E0LM.D M := by
  letI := e0SingularGXStructure M
  refine chartAtlasCausality_eq_chartedCausality E0.chartIso_mem_e0Groupoid
    E0.absolutelyMinimalOn_YBTZ _ fun κ hκ x => ?_
  refine symm_trans_mem_e0Groupoid_of_isFlatCompat ?_ (isFlatCompat_chartAt x)
  rcases hκ with ⟨ψ, hψ, rfl⟩ | ⟨x₀, c₀, rfl⟩
  · exact isFlatCompat_regChartToE0Y hψ
  · exact isFlatCompat_xaChartToE0Y c₀

/-- The headline's global hyperbolicity (charted) is the global hyperbolicity of the bridge
structure's causality, the hypothesis of `GX.BTZTildeData.isFutureDistinguishing_of_base` and
`GX.BTZTildeData.injective_D_of_isBTZFutureComplete`. -/
theorem globallyHyperbolic_e0ManifoldCausality_iff :
    (letI := e0SingularGXStructure M;
      (e0ManifoldCausality M isBTZSingModelled_e0).GloballyHyperbolic) ↔
      (Causal.CBG.chartedCausality E0LM.D M).GloballyHyperbolic := by
  rw [e0ManifoldCausality_eq_chartedCausality]

