/-!
# Topological suspensions, their portly subsets, and the infinite angle disc

`papers/gx`, §2.4.2 "Suspensions" (`RamcovGX.tex:701`–`786`).

* **`def:topological_suspension`** — `RamcovGX.tex:710`: `GX.Susp` (the quotient set),
  `GX.Susp.instTopologicalSpace` (the paper's topology, `GX.Susp.gens`), `GX.Susp.O`; its local
  structure `GX.Susp.hasBasis_nhds_O`, `GX.Susp.nhds_mk_of_pos`, `GX.Susp.continuous_mk`.
* **`rem:one_may_check_suspension`** — `RamcovGX.tex:716`: `GX.Susp.instT2Space`,
  `GX.Susp.instFirstCountableTopology`, `GX.Susp.instSecondCountableTopology` (and
  `GX.Susp.instLocallyConnectedSpace`).
* **`rem:infinite_angle_disc_suspension`** — `RamcovGX.tex:718`: `GX.Susp.dInftyHomeomorphSusp`
  (`𝔻_∞ ≃ₜ susp(ℝ)`, `𝔻_∞` = `GX.DInfty` of `GX.Singular.Quotient`).
* **`cex:topology_chose_same_quotient`** — `RamcovGX.tex:722`: `GX.Susp.quotTop`, `GX.SuspQ`;
  `GX.Susp.eq_quotTop_of_compactSpace` (same topology for `Σ` compact),
  `GX.SuspQ.not_firstCountableTopology_real` (`susp(ℝ)` with the quotient topology is not first
  countable); `GX.SuspQ.instTopologicalSpace_ne_quotTop_real`.
* **`rem:topological_suspension_fact_functor`** — `RamcovGX.tex:729`: `GX.Susp.functor`
  (`Top ⥤ Top`), `GX.Susp.map`, `GX.Susp.cmap`, `GX.Susp.map_id`, `GX.Susp.map_comp`,
  `GX.Susp.map_injective`, `GX.Susp.map_surjective`, `GX.Susp.isEmbedding_map`.
* **`prop:susp_portly`** — `RamcovGX.tex:745`: `GX.Susp.susp_portly`; the necessity of
  connectedness `GX.Susp.susp_portly_needs_connected`.
* **`lem:connected_union`** — `RamcovGX.tex:749`: `GX.connected_union`, `GX.connected_union_quot`.
* **`rem:proof_above_works_quotient`** — `RamcovGX.tex:784`: `GX.SuspQ.susp_portly`.

> Let $\Sigma$ be a topological space, the topological suspension of $\Sigma$ is
> $$ \susp(\Sigma):= (\Sigma \times \RR_+)/{\sim}$$ where $(\sigma,r) \sim (\sigma',r')$ if
> $r=r'=0$; endowed with the topology generated by the quotient topology on $\{r>0\}$ and the
> image of $\Sigma\times [0,\varepsilon[$ for $\varepsilon>0$. We also define $O:= \{r=0\}$.
> (l.710)
>
> One may check the suspension preserves Hausdorff as well as first and second countable
> properties. (l.716) The infinite angle disc $\DD_\infty$ is the suspension of $\RR$. (l.718)
>
> The topology we chose is the same as the quotient topology if $\Sigma$ is compact, however the
> suspension $\susp(\RR)$ endowed with the quotient topology is not first countable. (l.722)
>
> The topological suspension is in fact a functor from the category of topological space to
> itself as continuous maps can be extended radially in a natural way. Suspension preserves
> injectivity, surjectivity and embeddings. (l.729)
>
> Let $\Sigma$ be a Hausdorff, connected, locally connected topological space and let
> $\U\subset \Sigma$ be a portly subset. Then $\susp(\U)\setminus \{O\}$ is a portly subset of
> $\susp(\Sigma)$. (l.745)
>
> Let $M$ be a topological space and let $(\U_i)_{i\in I}$ be a non-empty family of non-empty
> connected open subset. Define on $I$ the equivalence relation $\sim$ generated by $i\sim j$ if
> $\U_i\cap \U_j \neq \emptyset$. The $\bigcup_{i\in I} \U_i$ is connected if and only if
> $I/\sim$ is a singleton. (l.749)
>
> The proof above works for the quotient topology. (l.784)

## Hypothesis checklist

| paper hypothesis | here |
|---|---|
| `prop:susp_portly`: `Σ` Hausdorff | ⚠ weakened: not used (it makes `susp(Σ)` Hausdorff, `instT2Space`) |
| `prop:susp_portly`: `Σ` connected | ⚠ weakened to `PreconnectedSpace`; necessary (`susp_portly_needs_connected`) |
| `prop:susp_portly`: `Σ` locally connected | ✓ carried |
| `prop:susp_portly` proof: "`Σ` first countable" (l.774) | ⚠ weakened: not a hypothesis of the statement, and not used — the proof here avoids the lower semicontinuity argument |
| `lem:connected_union`: open, connected, nonempty family | ✓ carried (`IsOpen`, `IsConnected`, `Nonempty ι`) |
| `cex`: `Σ` compact | ✓ carried |

## SCOPE (disclosed)

* `ℝ₊` is `ℝ≥0`; `susp(Σ)` is the quotient type `Quotient (suspSetoid Σ)`, so `susp(∅) = ∅` and
  `O` is the set `{r = 0}` (a point iff `Σ ≠ ∅`), as in the paper.
* `susp(U) ∖ {O}` for `U ⊆ Σ` is read as `range (susp(U ↪ Σ)) ∖ O` (the functor applied to the
  inclusion; `range_map_val_diff_O` identifies it with the image of `U × ℝ₊*`).
* "`I/∼` is a singleton" is `Subsingleton (Quot ∼)` (with `I` nonempty), equivalently every two
  indices are `EqvGen`-related.
* The quotient topology lives on the type synonym `GX.SuspQ` (`instance := quotTop`).
* `cex:topology_chose_same_quotient`: the claim is proved by a locally finite closed set
  `⋃ₙ {n} × [tₙ, ∞[` rather than the paper's continuous `g` (the paper's basis `U_f` is not
  needed).

Provenance: mathlib `fabf563a` (tag `v4.31.0`), pinned via `lakefile.toml`.
-/

noncomputable section

universe u

open Set Filter Topology NNReal Relation

namespace GX

/-! ### The underlying set -/

/-- The relation of `def:topological_suspension`: `(σ,r) ∼ (σ',r')` iff they are equal or
`r = r' = 0`. -/
def suspSetoid (S : Type*) : Setoid (S × ℝ≥0) where
  r a b := a = b ∨ (a.2 = 0 ∧ b.2 = 0)
  iseqv := by
    refine ⟨fun _ => Or.inl rfl, fun h => h.elim (fun h => Or.inl h.symm)
      fun h => Or.inr ⟨h.2, h.1⟩, fun h1 h2 => ?_⟩
    rcases h1 with rfl | ⟨h1, h1'⟩
    · exact h2
    · rcases h2 with rfl | ⟨_, h2'⟩
      · exact Or.inr ⟨h1, h1'⟩
      · exact Or.inr ⟨h1, h2'⟩

/-- **The topological suspension** `susp(Σ) = (Σ × ℝ₊)/∼` (`def:topological_suspension`,
`RamcovGX.tex:710`), as a set; its topology is `Susp.instTopologicalSpace`. -/
def Susp (S : Type*) : Type _ := Quotient (suspSetoid S)

namespace Susp

variable {S T : Type*}

/-- The projection `π : Σ × ℝ₊ → susp(Σ)`. -/
def mk (p : S × ℝ≥0) : Susp S := Quotient.mk (suspSetoid S) p

theorem mk_eq_mk {p q : S × ℝ≥0} : mk p = mk q ↔ p = q ∨ (p.2 = 0 ∧ q.2 = 0) :=
  Quotient.eq

theorem mk_surjective : Function.Surjective (mk : S × ℝ≥0 → Susp S) :=
  fun x => Quotient.inductionOn x fun p => ⟨p, rfl⟩

theorem mk_zero_eq (σ τ : S) : mk (σ, 0) = mk (τ, 0) := mk_eq_mk.2 (Or.inr ⟨rfl, rfl⟩)

/-- The radial coordinate `r`. -/
def r : Susp S → ℝ≥0 :=
  Quotient.lift (fun p => p.2) fun _ _ h => h.elim (fun h => h ▸ rfl) fun h => h.1.trans h.2.symm

@[simp] theorem r_mk (p : S × ℝ≥0) : (mk p).r = p.2 := rfl

/-- `O := {r = 0}` (`RamcovGX.tex:714`); a single point when `Σ` is nonempty, empty otherwise. -/
def O : Set (Susp S) := {x | x.r = 0}

theorem mk_mem_O {p : S × ℝ≥0} : mk p ∈ (O : Set (Susp S)) ↔ p.2 = 0 := Iff.rfl

theorem eq_of_mem_O {x y : Susp S} (hx : x ∈ O) (hy : y ∈ O) : x = y := by
  obtain ⟨p, rfl⟩ := mk_surjective x
  obtain ⟨q, rfl⟩ := mk_surjective y
  exact mk_eq_mk.2 (Or.inr ⟨hx, hy⟩)

theorem eq_of_mk_eq_of_pos {p q : S × ℝ≥0} (h : mk p = mk q) (hp : 0 < p.2) : p = q :=
  (mk_eq_mk.1 h).resolve_right fun h' => hp.ne' h'.1

/-- The positive part `{r > 0}` of `Σ × ℝ₊`. -/
def posPart (S : Type*) : Set (S × ℝ≥0) := {p | 0 < p.2}

theorem preimage_image_mk {W : Set (S × ℝ≥0)} (hW : W ⊆ posPart S) : mk ⁻¹' (mk '' W) = W := by
  ext p
  refine ⟨?_, fun hp => ⟨p, hp, rfl⟩⟩
  rintro ⟨q, hq, hqp⟩
  rwa [← eq_of_mk_eq_of_pos hqp (hW hq)]

/-- The ball `{r < ε}` around `O`. -/
def ball (ε : ℝ≥0) : Set (Susp S) := {x | x.r < ε}

theorem image_univ_prod_Iio (ε : ℝ≥0) : mk '' (univ ×ˢ Iio ε) = (ball ε : Set (Susp S)) := by
  ext x
  obtain ⟨p, rfl⟩ := mk_surjective x
  constructor
  · rintro ⟨q, hq, hqp⟩
    rw [← hqp]
    exact hq.2
  · intro hp
    exact ⟨p, ⟨mem_univ _, hp⟩, rfl⟩

theorem O_subset_ball {ε : ℝ≥0} (hε : 0 < ε) : (O : Set (Susp S)) ⊆ ball ε := fun x hx => by
  show x.r < ε
  rw [show x.r = 0 from hx]
  exact hε

theorem ball_mono {ε δ : ℝ≥0} (h : ε ≤ δ) : (ball ε : Set (Susp S)) ⊆ ball δ :=
  fun _ hx => lt_of_lt_of_le hx h

/-! ### The topology -/

variable [TopologicalSpace S] [TopologicalSpace T]

/-- The generators of the topology of `def:topological_suspension`: the images of the open
subsets of `{r > 0}` (the quotient topology on `{r > 0}`) and the images of `Σ × [0, ε[`. -/
def gens (S : Type*) [TopologicalSpace S] : Set (Set (Susp S)) :=
  {s | ∃ W : Set (S × ℝ≥0), IsOpen W ∧ W ⊆ posPart S ∧ s = mk '' W} ∪
    {s | ∃ ε : ℝ≥0, 0 < ε ∧ s = mk '' (univ ×ˢ Iio ε)}

/-- **The topology of `susp(Σ)`** (`def:topological_suspension`, `RamcovGX.tex:713`): generated
by the quotient topology on `{r > 0}` and the images of `Σ × [0, ε[` for `ε > 0`. -/
instance instTopologicalSpace : TopologicalSpace (Susp S) := TopologicalSpace.generateFrom (gens S)

theorem isOpen_posPart : IsOpen (posPart S) := isOpen_lt continuous_const continuous_snd

theorem isOpen_image_mk {W : Set (S × ℝ≥0)} (hW : IsOpen W) (hWp : W ⊆ posPart S) :
    IsOpen (mk '' W) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inl ⟨W, hW, hWp, rfl⟩)

theorem isOpen_ball (ε : ℝ≥0) : IsOpen (ball ε : Set (Susp S)) := by
  rcases eq_zero_or_pos ε with h | h
  · convert isOpen_empty
    ext x
    simp [ball, h]
  · rw [← image_univ_prod_Iio]
    exact TopologicalSpace.isOpen_generateFrom_of_mem (Or.inr ⟨ε, h, rfl⟩)

theorem continuous_mk : Continuous (mk : S × ℝ≥0 → Susp S) := by
  refine continuous_generateFrom_iff.2 ?_
  rintro s (⟨W, hW, hWp, rfl⟩ | ⟨ε, -, rfl⟩)
  · rwa [preimage_image_mk hWp]
  · rw [image_univ_prod_Iio]
    exact isOpen_lt continuous_snd continuous_const

/-- A subset of `{r > 0}` is open as soon as its preimage is. -/
theorem isOpen_of_subset_pos {s : Set (Susp S)} (hs : s ⊆ {x | 0 < x.r})
    (ho : IsOpen (mk ⁻¹' s)) : IsOpen s := by
  rw [← image_preimage_eq s mk_surjective]
  exact isOpen_image_mk ho fun p hp => hs hp

theorem exists_ball_subset_of_isOpen {t : Set (Susp S)} (ht : IsOpen t) {x : Susp S}
    (hx : x ∈ O) (hxt : x ∈ t) : ∃ ε > 0, ball ε ⊆ t := by
  have key : ∀ t, TopologicalSpace.GenerateOpen (gens S) t → x ∈ t → ∃ ε > 0, ball ε ⊆ t := by
    intro t ht
    induction ht with
    | basic s hs =>
      intro hxs
      rcases hs with ⟨W, -, hWp, rfl⟩ | ⟨ε, hε, rfl⟩
      · obtain ⟨w, hw, rfl⟩ := hxs
        exact absurd hx (hWp hw).ne'
      · exact ⟨ε, hε, (image_univ_prod_Iio ε).symm.subset⟩
    | univ => exact fun _ => ⟨1, one_pos, subset_univ _⟩
    | inter s t _ _ ihs iht =>
      intro hxst
      obtain ⟨a, ha, hs⟩ := ihs hxst.1
      obtain ⟨b, hb, ht'⟩ := iht hxst.2
      exact ⟨min a b, lt_min ha hb, fun y hy =>
        ⟨hs (ball_mono (min_le_left _ _) hy), ht' (ball_mono (min_le_right _ _) hy)⟩⟩
    | sUnion F _ ih =>
      rintro ⟨s, hsF, hxs⟩
      obtain ⟨ε, hε, h⟩ := ih s hsF hxs
      exact ⟨ε, hε, h.trans (subset_sUnion_of_mem hsF)⟩
  exact key t ht hxt

/-- The balls `{r < ε}` form a basis of neighbourhoods of `O`. -/
theorem hasBasis_nhds_O {x : Susp S} (hx : x ∈ O) :
    (𝓝 x).HasBasis (fun ε : ℝ≥0 => 0 < ε) ball := by
  refine ⟨fun t => ⟨fun ht => ?_, fun ⟨ε, hε, h⟩ =>
    mem_of_superset ((isOpen_ball ε).mem_nhds (O_subset_ball hε hx)) h⟩⟩
  obtain ⟨u, hut, huo, hxu⟩ := mem_nhds_iff.1 ht
  obtain ⟨ε, hε, h⟩ := exists_ball_subset_of_isOpen huo hx hxu
  exact ⟨ε, hε, h.trans hut⟩

/-- Away from `O`, the projection is a local homeomorphism. -/
theorem nhds_mk_of_pos {p : S × ℝ≥0} (hp : 0 < p.2) : 𝓝 (mk p) = map mk (𝓝 p) := by
  refine le_antisymm (fun s hs => ?_) continuous_mk.continuousAt
  obtain ⟨W, hWs, hWo, hpW⟩ :=
    mem_nhds_iff.1 (inter_mem (mem_map.1 hs) (isOpen_posPart.mem_nhds hp))
  exact mem_of_superset ((isOpen_image_mk hWo fun q hq => (hWs hq).2).mem_nhds ⟨p, hpW, rfl⟩)
    (image_subset_iff.2 fun q hq => (hWs hq).1)

/-- Continuity out of `susp(Σ)`: away from `O` through `π`, and at `O` along `r → 0`. -/
theorem continuous_of {Y : Type*} [TopologicalSpace Y] {g : Susp S → Y}
    (h1 : ∀ p : S × ℝ≥0, 0 < p.2 → ContinuousAt (g ∘ mk) p)
    (h2 : ∀ x ∈ (O : Set (Susp S)), ∀ V ∈ 𝓝 (g x), ∃ ε > 0, ball ε ⊆ g ⁻¹' V) :
    Continuous g := by
  refine continuous_iff_continuousAt.2 fun x => ?_
  obtain ⟨p, rfl⟩ := mk_surjective x
  rcases eq_zero_or_pos p.2 with h | h
  · exact (hasBasis_nhds_O (x := mk p) h).tendsto_left_iff.2 fun V hV =>
      h2 _ h V hV
  · unfold ContinuousAt
    rw [nhds_mk_of_pos h, tendsto_map'_iff]
    exact h1 p h

theorem continuous_r : Continuous (r : Susp S → ℝ≥0) := by
  refine continuous_of (fun p _ => continuous_snd.continuousAt) fun x hx V hV => ?_
  rw [show x.r = 0 from hx] at hV
  obtain ⟨δ, hδ, h⟩ := NNReal.nhds_zero_basis.mem_iff.1 hV
  exact ⟨δ, hδ, fun y hy => h hy⟩

theorem isOpen_lt_r (a : ℝ≥0) : IsOpen {x : Susp S | a < x.r} :=
  isOpen_lt continuous_const continuous_r

/-! ### `rem:one_may_check_suspension`: Hausdorff, first and second countable -/

/-- `rem:one_may_check_suspension`: the suspension of a Hausdorff space is Hausdorff. -/
instance instT2Space [T2Space S] : T2Space (Susp S) := by
  refine ⟨fun x y hxy => ?_⟩
  have hsep : ∀ x y : Susp S, 0 < x.r → y ∈ O → ∃ u v : Set (Susp S), IsOpen u ∧ IsOpen v ∧
      x ∈ u ∧ y ∈ v ∧ Disjoint u v := fun x y hx hy =>
    ⟨{z | x.r / 2 < z.r}, ball (x.r / 2), isOpen_lt_r _, isOpen_ball _,
      show x.r / 2 < x.r from half_lt_self hx.ne', O_subset_ball (half_pos hx) hy,
      Set.disjoint_left.2 fun z (hz : x.r / 2 < z.r) (hz' : z.r < x.r / 2) => lt_asymm hz hz'⟩
  rcases eq_zero_or_pos x.r with hx | hx <;> rcases eq_zero_or_pos y.r with hy | hy
  · exact absurd (eq_of_mem_O hx hy) hxy
  · obtain ⟨u, v, hu, hv, h1, h2, h3⟩ := hsep y x hy hx
    exact ⟨v, u, hv, hu, h2, h1, h3.symm⟩
  · exact hsep x y hx hy
  · obtain ⟨p, rfl⟩ := mk_surjective x
    obtain ⟨q, rfl⟩ := mk_surjective y
    have hpq : p ≠ q := fun h => hxy (h ▸ rfl)
    obtain ⟨u, v, hu, hv, hpu, hqv, huv⟩ := t2_separation hpq
    refine ⟨mk '' (u ∩ posPart S), mk '' (v ∩ posPart S),
      isOpen_image_mk (hu.inter isOpen_posPart) inter_subset_right,
      isOpen_image_mk (hv.inter isOpen_posPart) inter_subset_right,
      ⟨p, ⟨hpu, hx⟩, rfl⟩, ⟨q, ⟨hqv, hy⟩, rfl⟩, ?_⟩
    rw [Set.disjoint_left]
    rintro _ ⟨a, ha, rfl⟩ ⟨b, hb, hab⟩
    rw [eq_of_mk_eq_of_pos hab hb.2] at hb
    exact Set.disjoint_left.1 huv ha.1 hb.1

/-- A countable basis of neighbourhoods of `O`. -/
theorem hasBasis_nhds_O_nat {x : Susp S} (hx : x ∈ O) :
    (𝓝 x).HasBasis (fun _ : ℕ => True) fun n => ball (1 / ((n : ℝ≥0) + 1)) :=
  (hasBasis_nhds_O hx).to_hasBasis
    (fun ε hε => let ⟨n, hn⟩ := exists_nat_one_div_lt hε; ⟨n, trivial, ball_mono hn.le⟩)
    fun n _ => ⟨_, by positivity, subset_rfl⟩

/-- `rem:one_may_check_suspension`: the suspension of a first countable space is first
countable. -/
instance instFirstCountableTopology [FirstCountableTopology S] :
    FirstCountableTopology (Susp S) := by
  refine ⟨fun x => ?_⟩
  obtain ⟨p, rfl⟩ := mk_surjective x
  rcases eq_zero_or_pos p.2 with h | h
  · exact (hasBasis_nhds_O_nat (x := mk p) h).isCountablyGenerated
  · rw [nhds_mk_of_pos h]
    infer_instance

/-- `rem:one_may_check_suspension`: the suspension of a second countable space is second
countable. -/
instance instSecondCountableTopology [SecondCountableTopology S] :
    SecondCountableTopology (Susp S) := by
  set B := TopologicalSpace.countableBasis (S × ℝ≥0)
  have hB := TopologicalSpace.isBasis_countableBasis (S × ℝ≥0)
  set F : Set (Set (Susp S)) := ((fun b => mk '' (b ∩ posPart S)) '' B) ∪
    range fun n : ℕ => ball (1 / ((n : ℝ≥0) + 1))
  have hF : TopologicalSpace.IsTopologicalBasis F := by
    refine TopologicalSpace.isTopologicalBasis_of_isOpen_of_nhds ?_ fun a u hau hu => ?_
    · rintro s (⟨b, hb, rfl⟩ | ⟨n, rfl⟩)
      · exact isOpen_image_mk ((hB.isOpen hb).inter isOpen_posPart) inter_subset_right
      · exact isOpen_ball _
    · obtain ⟨p, rfl⟩ := mk_surjective a
      rcases eq_zero_or_pos p.2 with h | h
      · obtain ⟨n, -, hn⟩ := (hasBasis_nhds_O_nat (x := mk p) h).mem_iff.1 (hu.mem_nhds hau)
        exact ⟨_, Or.inr ⟨n, rfl⟩, O_subset_ball (by positivity) h, hn⟩
      · obtain ⟨v, hvB, hpv, hvu⟩ := hB.exists_subset_of_mem_open (a := p)
          (u := mk ⁻¹' u ∩ posPart S) ⟨hau, h⟩ ((hu.preimage continuous_mk).inter isOpen_posPart)
        exact ⟨_, Or.inl ⟨v, hvB, rfl⟩, ⟨p, ⟨hpv, h⟩, rfl⟩,
          image_subset_iff.2 fun q hq => (hvu hq.1).1⟩
  exact hF.secondCountableTopology
    (((TopologicalSpace.countable_countableBasis _).image _).union (countable_range _))

/-! ### Local connectedness -/

/-- A box `Ŵ × ]l, u[` with `Ŵ` open connected inside any neighbourhood of a point of `{r > 0}`. -/
theorem exists_box [LocallyConnectedSpace S] {p : S × ℝ≥0} (hp : 0 < p.2) {A : Set (S × ℝ≥0)}
    (hA : A ∈ 𝓝 p) : ∃ (W : Set S) (l u : ℝ≥0), IsOpen W ∧ IsConnected W ∧ p.1 ∈ W ∧
      p.2 ∈ Ioo l u ∧ W ×ˢ Ioo l u ⊆ A ∧ W ×ˢ Ioo l u ⊆ posPart S := by
  obtain ⟨a, ha, b, hb, hab⟩ := mem_nhds_prod_iff.1 hA
  obtain ⟨W, hWa, hWo, hpW, hWc⟩ :=
    locallyConnectedSpace_iff_subsets_isOpen_isConnected.1 inferInstance p.1 a ha
  obtain ⟨l, u, ⟨hl, hu⟩, hlu⟩ :=
    (mem_nhds_iff_exists_Ioo_subset' ⟨0, hp⟩ ⟨p.2 + 1, lt_add_one _⟩).1 hb
  refine ⟨W, max l 0, u, hWo, hWc, hpW, ⟨max_lt hl hp, hu⟩, fun q hq => hab ⟨hWa hq.1,
    hlu ⟨(le_max_left _ _).trans_lt hq.2.1, hq.2.2⟩⟩, fun q hq => ?_⟩
  exact (le_max_right l 0).trans_lt hq.2.1

/-- The suspension of a locally connected space is locally connected (the ambient hypothesis of
`def:portly_skeletal_subset`, for `prop:susp_portly`). -/
instance instLocallyConnectedSpace [LocallyConnectedSpace S] : LocallyConnectedSpace (Susp S) := by
  refine locallyConnectedSpace_iff_subsets_isOpen_isConnected.2 fun x V hV => ?_
  obtain ⟨p, rfl⟩ := mk_surjective x
  rcases eq_zero_or_pos p.2 with h | h
  · obtain ⟨ε, hε, hεV⟩ := (hasBasis_nhds_O (x := mk p) h).mem_iff.1 hV
    refine ⟨ball ε, hεV, isOpen_ball ε, O_subset_ball hε h, ⟨mk p, O_subset_ball hε h⟩, ?_⟩
    have : (ball ε : Set (Susp S)) = ⋃ σ : S, mk '' ({σ} ×ˢ Iio ε) := by
      rw [← image_univ_prod_Iio, ← image_iUnion]
      congr 1
      ext q
      simp
    rw [this]
    refine isPreconnected_iUnion ⟨mk p, mem_iInter.2 fun σ => ⟨(σ, 0), ⟨rfl, hε⟩, ?_⟩⟩
      fun σ => (isPreconnected_singleton.prod isPreconnected_Iio).image _
        continuous_mk.continuousOn
    exact mk_eq_mk.2 (Or.inr ⟨rfl, h⟩)
  · obtain ⟨W, l, u, hWo, hWc, hpW, hpI, hsub, hpos⟩ := exists_box h (mem_map.1
      (nhds_mk_of_pos h ▸ hV))
    exact ⟨mk '' (W ×ˢ Ioo l u), image_subset_iff.2 hsub,
      isOpen_image_mk (hWo.prod isOpen_Ioo) hpos, ⟨p, ⟨hpW, hpI⟩, rfl⟩,
      (hWc.prod (isConnected_Ioo (hpI.1.trans hpI.2))).image _ continuous_mk.continuousOn⟩

/-! ### `rem:topological_suspension_fact_functor`: the radial extension of maps -/

omit [TopologicalSpace S] [TopologicalSpace T] in
/-- The radial extension `susp(f)(σ, r) = (f σ, r)` of a map `f : Σ → Σ'`
(`rem:topological_suspension_fact_functor`). -/
def map (f : S → T) : Susp S → Susp T :=
  Quotient.lift (fun p => mk (f p.1, p.2)) fun _ _ h =>
    mk_eq_mk.2 (h.elim (fun h => Or.inl (h ▸ rfl)) fun h => Or.inr h)

omit [TopologicalSpace S] [TopologicalSpace T] in
@[simp] theorem map_mk (f : S → T) (p : S × ℝ≥0) : map f (mk p) = mk (f p.1, p.2) := rfl

omit [TopologicalSpace S] [TopologicalSpace T] in
@[simp] theorem r_map (f : S → T) (x : Susp S) : (map f x).r = x.r :=
  Quotient.inductionOn x fun _ => rfl

omit [TopologicalSpace S] in
theorem map_id : map (id : S → S) = id := funext fun x => Quotient.inductionOn x fun _ => rfl

omit [TopologicalSpace S] [TopologicalSpace T] in
theorem map_comp {R : Type*} (g : T → R) (f : S → T) :
    map (g ∘ f) = map g ∘ map f :=
  funext fun x => Quotient.inductionOn x fun _ => rfl

theorem continuous_map {f : S → T} (hf : Continuous f) : Continuous (map f) := by
  refine continuous_of (fun p _ => (continuous_mk.comp
    ((hf.comp continuous_fst).prodMk continuous_snd)).continuousAt) fun x hx V hV => ?_
  obtain ⟨ε, hε, h⟩ := (hasBasis_nhds_O (show map f x ∈ O by
    show (map f x).r = 0; rw [r_map]; exact hx)).mem_iff.1 hV
  exact ⟨ε, hε, fun y hy => h (show (map f y).r < ε by rw [r_map]; exact hy)⟩

omit [TopologicalSpace S] [TopologicalSpace T] in
/-- `rem:topological_suspension_fact_functor`: suspension preserves injectivity. -/
theorem map_injective {f : S → T} (hf : Function.Injective f) : Function.Injective (map f) := by
  intro x y h
  obtain ⟨p, rfl⟩ := mk_surjective x
  obtain ⟨q, rfl⟩ := mk_surjective y
  rw [map_mk, map_mk, mk_eq_mk] at h
  refine mk_eq_mk.2 (h.elim (fun h => Or.inl ?_) Or.inr)
  exact Prod.ext (hf (Prod.ext_iff.1 h).1) (Prod.ext_iff.1 h).2

omit [TopologicalSpace S] [TopologicalSpace T] in
/-- `rem:topological_suspension_fact_functor`: suspension preserves surjectivity. -/
theorem map_surjective {f : S → T} (hf : Function.Surjective f) : Function.Surjective (map f) := by
  intro y
  obtain ⟨q, rfl⟩ := mk_surjective y
  obtain ⟨σ, hσ⟩ := hf q.1
  exact ⟨mk (σ, q.2), by rw [map_mk, hσ]⟩

/-- `rem:topological_suspension_fact_functor`: suspension preserves inducing maps. -/
theorem isInducing_map {f : S → T} (hf : IsInducing f) : IsInducing (map f) := by
  refine Topology.isInducing_iff_nhds.2 fun x => le_antisymm
    ((continuous_map hf.continuous).tendsto x).le_comap fun s hs => ?_
  obtain ⟨p, rfl⟩ := mk_surjective x
  rcases eq_zero_or_pos p.2 with h | h
  · obtain ⟨ε, hε, hεs⟩ := (hasBasis_nhds_O (x := mk p) h).mem_iff.1 hs
    refine mem_comap.2 ⟨ball ε, (isOpen_ball ε).mem_nhds (O_subset_ball hε ?_), fun y hy => hεs ?_⟩
    · show (map f (mk p)).r = 0; rw [r_map]; exact h
    · show y.r < ε; rw [← r_map f]; exact hy
  · rw [nhds_mk_of_pos h, mem_map] at hs
    rw [(hf.prodMap IsInducing.id).nhds_eq_comap p] at hs
    obtain ⟨t, ht, hts⟩ := mem_comap.1 hs
    refine mem_comap.2 ⟨mk '' (t ∩ posPart T), ?_, fun y hy => ?_⟩
    · rw [map_mk, nhds_mk_of_pos (p := (f p.1, p.2)) h, mem_map,
        preimage_image_mk inter_subset_right]
      exact inter_mem ht (isOpen_posPart.mem_nhds h)
    · obtain ⟨a, rfl⟩ := mk_surjective y
      rw [mem_preimage, map_mk, ← mem_preimage, preimage_image_mk inter_subset_right] at hy
      exact hts hy.1

/-- `rem:topological_suspension_fact_functor`: suspension preserves embeddings. -/
theorem isEmbedding_map {f : S → T} (hf : IsEmbedding f) : IsEmbedding (map f) :=
  ⟨isInducing_map hf.isInducing, map_injective hf.injective⟩

/-- The radial extension of a continuous map, as a continuous map. -/
def cmap (f : C(S, T)) : C(Susp S, Susp T) := ⟨map f, continuous_map f.continuous⟩

omit [TopologicalSpace S] in
/-- `susp(U) ∖ O`, for `U ⊆ Σ`, is the image of `U × ℝ₊*`. -/
theorem range_map_val_diff_O (U : Set S) :
    range (map ((↑) : U → S)) \ O = mk '' (U ×ˢ Ioi 0) := by
  ext y
  obtain ⟨q, rfl⟩ := mk_surjective y
  constructor
  · rintro ⟨⟨x, hx⟩, hq⟩
    obtain ⟨a, rfl⟩ := mk_surjective x
    have hpos : 0 < q.2 := pos_iff_ne_zero.2 hq
    have hqa := eq_of_mk_eq_of_pos hx.symm hpos
    refine ⟨q, ⟨?_, hpos⟩, rfl⟩
    rw [hqa]
    exact a.1.2
  · rintro ⟨b, hb, hbq⟩
    refine ⟨⟨mk (⟨b.1, hb.1⟩, b.2), hbq⟩, ?_⟩
    rw [← hbq]
    exact hb.2.ne'

/-! ### `prop:susp_portly` -/

/-- The common core of `prop:susp_portly` and `rem:proof_above_works_quotient`: for any space
`Y` receiving `Σ × ℝ₊` by a continuous surjection `q` which identifies exactly the points of
`{r = 0}`, is open on `{r > 0}`, and satisfies the local condition at `O`, the image of
`U × ℝ₊*` is portly. -/
theorem isPortly_image_of_suspLike {Y : Type*} [TopologicalSpace Y] [LocallyConnectedSpace S]
    (q : S × ℝ≥0 → Y) (hq : Continuous q) (hsurj : Function.Surjective q)
    (hrel : ∀ a b, q a = q b → 0 < a.2 → a = b)
    (hopen : ∀ W : Set (S × ℝ≥0), IsOpen W → W ⊆ posPart S → IsOpen (q '' W))
    {U : Set S} (hU : IsPortly U)
    (hapex : ∀ σ : S, ∀ W : Set Y, IsOpen W → q (σ, 0) ∈ W →
      ∃ N, IsOpen N ∧ q (σ, 0) ∈ N ∧ N ⊆ W ∧ IsPreconnected (N ∩ q '' (U ×ˢ Ioi 0))) :
    IsPortly (q '' (U ×ˢ Ioi 0)) := by
  have hdense : Dense (U ×ˢ Ioi (0 : ℝ≥0)) := hU.dense.prod (by
    rw [dense_iff_closure_eq, closure_Ioi]
    ext; simp)
  have hVd := hsurj.denseRange.dense_image hq hdense
  refine ⟨hopen _ (hU.isOpen.prod isOpen_Ioi) fun p hp => hp.2, hVd, fun W hW hWc => ?_⟩
  refine isPreconnected_of_local hWc inter_subset_left
    (fun x hx => hW.inter_closure ⟨hx, hVd x⟩) fun x hx => ?_
  obtain ⟨p, rfl⟩ := hsurj x
  have key : ∀ N ⊆ W, N ∩ (W ∩ q '' (U ×ˢ Ioi 0)) = N ∩ q '' (U ×ˢ Ioi 0) := fun N hN => by
    rw [← inter_assoc, inter_eq_left.2 hN]
  rcases eq_zero_or_pos p.2 with h | h
  · have hp : (p.1, (0 : ℝ≥0)) = p := Prod.ext rfl h.symm
    obtain ⟨N, hNo, hpN, hNW, hNc⟩ := hapex p.1 W hW (by rw [hp]; exact hx)
    exact ⟨N, hNo, hp ▸ hpN, by rwa [key N hNW]⟩
  · obtain ⟨B, l, u, hBo, hBc, hpB, hpI, hsub, hpos⟩ :=
      exists_box h ((hW.preimage hq).mem_nhds hx)
    have hNW : q '' (B ×ˢ Ioo l u) ⊆ W := image_subset_iff.2 hsub
    refine ⟨q '' (B ×ˢ Ioo l u), hopen _ (hBo.prod isOpen_Ioo) hpos, ⟨p, ⟨hpB, hpI⟩, rfl⟩, ?_⟩
    rw [key _ hNW]
    have heq : q '' (B ×ˢ Ioo l u) ∩ q '' (U ×ˢ Ioi 0) = q '' ((B ∩ U) ×ˢ Ioo l u) := by
      ext y
      constructor
      · rintro ⟨⟨a, ha, rfl⟩, ⟨b, hb, hab⟩⟩
        obtain rfl := hrel b a hab hb.2
        exact ⟨b, ⟨⟨ha.1, hb.1⟩, ha.2⟩, rfl⟩
      · rintro ⟨a, ⟨⟨h1, h2⟩, h3⟩, rfl⟩
        exact ⟨⟨a, ⟨h1, h3⟩, rfl⟩, ⟨a, ⟨h2, hpos ⟨h1, h3⟩⟩, rfl⟩⟩
    rw [heq]
    exact ((hU.locallyConnectedIn B hBo hBc.isPreconnected).prod isPreconnected_Ioo).image _
      hq.continuousOn

/-- `prop:susp_portly` with the set `susp(U) ∖ O` written as the image of `U × ℝ₊*`. -/
theorem isPortly_image_mk [PreconnectedSpace S] [LocallyConnectedSpace S] {U : Set S}
    (hU : IsPortly U) : IsPortly (mk '' (U ×ˢ Ioi 0) : Set (Susp S)) := by
  refine isPortly_image_of_suspLike mk continuous_mk mk_surjective
    (fun a b h ha => eq_of_mk_eq_of_pos h ha) (fun W hW hWp => isOpen_image_mk hW hWp) hU
    fun σ W hW hσ => ?_
  obtain ⟨ε, hε, hεW⟩ := exists_ball_subset_of_isOpen hW (x := mk (σ, 0)) rfl hσ
  refine ⟨ball ε, isOpen_ball ε, hε, hεW, ?_⟩
  have heq : ball ε ∩ mk '' (U ×ˢ Ioi 0) = mk '' (U ×ˢ Ioo 0 ε) := by
    ext y
    constructor
    · rintro ⟨hy, ⟨b, hb, rfl⟩⟩
      exact ⟨b, ⟨hb.1, hb.2, hy⟩, rfl⟩
    · rintro ⟨b, ⟨h1, h2, h3⟩, rfl⟩
      exact ⟨h3, b, ⟨h1, h2⟩, rfl⟩
  rw [heq]
  exact (hU.isPreconnected.prod isPreconnected_Ioo).image _ continuous_mk.continuousOn

/-- **`prop:susp_portly`** (`RamcovGX.tex:745`): if `Σ` is connected and locally connected and
`U ⊆ Σ` is portly, then `susp(U) ∖ O` is a portly subset of `susp(Σ)`. -/
theorem susp_portly [PreconnectedSpace S] [LocallyConnectedSpace S] {U : Set S}
    (hU : IsPortly U) : IsPortly (range (map ((↑) : U → S)) \ O) := by
  rw [range_map_val_diff_O]
  exact isPortly_image_mk hU

/-- The balls `{r < ε}` are preconnected (every ray meets `O`). -/
theorem isPreconnected_ball (ε : ℝ≥0) : IsPreconnected (ball ε : Set (Susp S)) := by
  rcases isEmpty_or_nonempty S with hS | ⟨⟨σ₀⟩⟩
  · convert isPreconnected_empty
    ext x
    obtain ⟨p, -⟩ := mk_surjective x
    exact (hS.false p.1).elim
  rcases eq_zero_or_pos ε with h | h
  · convert isPreconnected_empty
    ext x
    simp [ball, h]
  have heq : (ball ε : Set (Susp S)) = ⋃ σ : S, mk '' ({σ} ×ˢ Iio ε) := by
    rw [← image_univ_prod_Iio, ← image_iUnion]
    congr 1
    ext q
    simp
  rw [heq]
  exact isPreconnected_iUnion ⟨mk (σ₀, 0), mem_iInter.2 fun σ => ⟨(σ, 0), ⟨rfl, h⟩,
    mk_zero_eq _ _⟩⟩ fun σ => (isPreconnected_singleton.prod isPreconnected_Iio).image _
      continuous_mk.continuousOn

/-- `prop:susp_portly` needs `Σ` connected: `U = Σ = Bool` is portly in the (disconnected,
locally connected, Hausdorff) space `Bool`, but `susp(U) ∖ O` is not portly in `susp(Bool)` — it
cuts the connected ball `{r < 1}` in two. -/
theorem susp_portly_needs_connected :
    IsPortly (univ : Set Bool) ∧
      ¬ IsPortly (range (map ((↑) : ↥(univ : Set Bool) → Bool)) \ O) := by
  refine ⟨isPortly_univ, fun h => ?_⟩
  rw [range_map_val_diff_O] at h
  have hc := h.locallyConnectedIn _ (isOpen_ball 1) (isPreconnected_ball 1)
  have hu : ∀ b : Bool, IsOpen (mk '' ({b} ×ˢ Ioi 0) : Set (Susp Bool)) := fun b =>
    isOpen_image_mk ((isOpen_discrete _).prod isOpen_Ioi) fun p hp => hp.2
  have hcover : ball 1 ∩ mk '' ((univ : Set Bool) ×ˢ Ioi 0) ⊆
      mk '' ({true} ×ˢ Ioi 0) ∪ mk '' ({false} ×ˢ Ioi 0) := by
    rintro _ ⟨-, ⟨⟨b, t⟩, hp, rfl⟩⟩
    cases b
    · exact Or.inr ⟨(false, t), ⟨rfl, hp.2⟩, rfl⟩
    · exact Or.inl ⟨(true, t), ⟨rfl, hp.2⟩, rfl⟩
  have hmem : ∀ b : Bool, (ball 1 ∩ mk '' ((univ : Set Bool) ×ˢ Ioi 0) ∩
      mk '' ({b} ×ˢ Ioi 0)).Nonempty := fun b =>
    ⟨mk (b, 1 / 2), ⟨show (1 / 2 : ℝ≥0) < 1 by norm_num, (b, 1 / 2),
      ⟨mem_univ _, show (0 : ℝ≥0) < 1 / 2 by norm_num⟩, rfl⟩,
      (b, 1 / 2), ⟨rfl, show (0 : ℝ≥0) < 1 / 2 by norm_num⟩, rfl⟩
  obtain ⟨x, -, ⟨a, ha, rfl⟩, ⟨b, hb, hab⟩⟩ :=
    hc _ _ (hu true) (hu false) hcover (hmem true) (hmem false)
  obtain rfl := eq_of_mk_eq_of_pos hab hb.2
  have h1 : b.1 = true := ha.1
  have h2 : b.1 = false := hb.1
  rw [h1] at h2
  exact Bool.noConfusion h2

/-! ### `cex:topology_chose_same_quotient`: the quotient topology -/

/-- The quotient topology on `susp(Σ)`, coinduced by `π` (`cex:topology_chose_same_quotient`). -/
@[reducible] def quotTop (S : Type*) [TopologicalSpace S] : TopologicalSpace (Susp S) :=
  TopologicalSpace.coinduced mk inferInstance

/-- The paper's topology is coarser than the quotient topology. -/
theorem quotTop_le : quotTop S ≤ instTopologicalSpace :=
  continuous_iff_coinduced_le.1 continuous_mk

/-- **`cex:topology_chose_same_quotient`, first half** (`RamcovGX.tex:722`): for `Σ` compact, the
topology of `def:topological_suspension` is the quotient topology. -/
theorem eq_quotTop_of_compactSpace [CompactSpace S] :
    (instTopologicalSpace : TopologicalSpace (Susp S)) = quotTop S := by
  refine le_antisymm (TopologicalSpace.le_def.2 fun s hs => ?_) quotTop_le
  have hpre : IsOpen (mk ⁻¹' s) := isOpen_coinduced.1 hs
  have hpos : IsOpen (s ∩ {x | 0 < x.r}) :=
    isOpen_of_subset_pos inter_subset_right (hpre.inter isOpen_posPart)
  by_cases hO : ∃ σ : S, mk (σ, 0) ∈ s
  · obtain ⟨σ, hσ⟩ := hO
    have hall : (univ : Set S) ×ˢ {(0 : ℝ≥0)} ⊆ mk ⁻¹' s := fun q hq => by
      rw [mem_preimage, show q = (q.1, 0) from Prod.ext rfl hq.2, mk_zero_eq q.1 σ]
      exact hσ
    obtain ⟨u, v, -, hv, hu, h0v, huv⟩ :=
      generalized_tube_lemma isCompact_univ isCompact_singleton hpre hall
    obtain ⟨ε, hε, hεv⟩ := NNReal.nhds_zero_basis.mem_iff.1 (hv.mem_nhds (h0v rfl))
    have heq : s = (s ∩ {x | 0 < x.r}) ∪ ball ε := by
      ext y
      obtain ⟨q, rfl⟩ := mk_surjective y
      constructor
      · intro hy
        rcases eq_zero_or_pos q.2 with h | h
        · exact Or.inr (O_subset_ball hε h)
        · exact Or.inl ⟨hy, h⟩
      · rintro (hy | hy)
        · exact hy.1
        · exact huv ⟨hu (mem_univ _), hεv hy⟩
    rw [heq]
    exact hpos.union (isOpen_ball ε)
  · simp only [not_exists] at hO
    have heq : s = s ∩ {x | 0 < x.r} := by
      refine (inter_eq_left.2 fun y hy => ?_).symm
      obtain ⟨q, rfl⟩ := mk_surjective y
      show 0 < q.2
      refine pos_iff_ne_zero.2 fun h => hO q.1 ?_
      rwa [show (q.1, (0 : ℝ≥0)) = q from Prod.ext rfl h.symm]
    rw [heq]
    exact hpos

end Susp

/-- `susp(Σ)` endowed with the quotient topology (`cex:topology_chose_same_quotient`,
`rem:proof_above_works_quotient`). -/
def SuspQ (S : Type*) [TopologicalSpace S] : Type _ := Susp S

namespace SuspQ

open Susp

variable {S : Type*} [TopologicalSpace S]

instance instTopologicalSpace : TopologicalSpace (SuspQ S) := quotTop S

/-- The projection `Σ × ℝ₊ → susp(Σ)` for the quotient topology. -/
def mkQ (p : S × ℝ≥0) : SuspQ S := Susp.mk p

theorem continuous_mkQ : Continuous (mkQ : S × ℝ≥0 → SuspQ S) := continuous_coinduced_rng

theorem isOpen_iff {s : Set (SuspQ S)} : IsOpen s ↔ IsOpen (mkQ ⁻¹' s) := isOpen_coinduced

/-- **`cex:topology_chose_same_quotient`, second half** (`RamcovGX.tex:723`): `susp(ℝ)` with the
quotient topology is not first countable. -/
theorem not_firstCountableTopology_real : ¬ FirstCountableTopology (SuspQ ℝ) := by
  intro hfc
  set o : SuspQ ℝ := mkQ (0, 0)
  obtain ⟨s, hs⟩ := (𝓝 o).exists_antitone_basis
  have ht : ∀ n : ℕ, ∃ t : ℝ≥0, 0 < t ∧ mkQ ((n : ℝ), t) ∈ s n := by
    intro n
    have h1 : mkQ ⁻¹' s n ∈ 𝓝 ((n : ℝ), (0 : ℝ≥0)) :=
      continuous_mkQ.continuousAt.preimage_mem_nhds (by
        rw [show mkQ ((n : ℝ), (0 : ℝ≥0)) = o from mk_zero_eq _ _]
        exact hs.toHasBasis.mem_of_mem trivial)
    have h2 : {t : ℝ≥0 | ((n : ℝ), t) ∈ mkQ ⁻¹' s n} ∈ 𝓝 (0 : ℝ≥0) :=
      (continuous_const.prodMk continuous_id).continuousAt.preimage_mem_nhds h1
    obtain ⟨δ, hδ, hδs⟩ := NNReal.nhds_zero_basis.mem_iff.1 h2
    exact ⟨δ / 2, half_pos hδ, hδs (half_lt_self hδ.ne')⟩
  choose t ht0 hts using ht
  set F : Set (ℝ × ℝ≥0) := ⋃ n : ℕ, {(n : ℝ)} ×ˢ Ici (t n)
  have hF : IsClosed F := by
    refine LocallyFinite.isClosed_iUnion ?_ fun n => isClosed_singleton.prod isClosed_Ici
    refine (locallyFinite_Icc_nat.preimage_continuous continuous_fst).subset fun n q hq => ?_
    have hq1 : q.1 = n := hq.1
    rw [mem_preimage, hq1]
    exact ⟨le_rfl, by linarith⟩
  have hnF : ∀ q : ℝ × ℝ≥0, q.2 = 0 → q ∉ F := fun q hq hqF => by
    obtain ⟨n, hn⟩ := mem_iUnion.1 hqF
    exact (ht0 n).not_ge (hq ▸ hn.2)
  have hsat : mkQ ⁻¹' (mkQ '' Fᶜ) = Fᶜ := by
    ext q
    refine ⟨?_, fun hq => ⟨q, hq, rfl⟩⟩
    rintro ⟨a, ha, haq⟩
    rcases mk_eq_mk.1 haq with rfl | ⟨-, h2⟩
    · exact ha
    · exact hnF q h2
  have hU : (mkQ '' Fᶜ : Set (SuspQ ℝ)) ∈ 𝓝 o :=
    (isOpen_iff.2 (by rw [hsat]; exact hF.isOpen_compl)).mem_nhds ⟨(0, 0), hnF _ rfl, rfl⟩
  obtain ⟨n, -, hn⟩ := hs.toHasBasis.mem_iff.1 hU
  have : ((n : ℝ), t n) ∈ Fᶜ := by
    rw [← hsat]
    exact hn (hts n)
  exact this (mem_iUnion.2 ⟨n, rfl, mem_Ici.2 le_rfl⟩)

/-- The two topologies of `cex:topology_chose_same_quotient` differ on `susp(ℝ)`. -/
theorem instTopologicalSpace_ne_quotTop_real :
    (Susp.instTopologicalSpace : TopologicalSpace (Susp ℝ)) ≠ quotTop ℝ := by
  intro h
  have h1 : @FirstCountableTopology (Susp ℝ) (quotTop ℝ) := h ▸ inferInstance
  exact not_firstCountableTopology_real h1

/-- **`rem:proof_above_works_quotient`** (`RamcovGX.tex:784`): `prop:susp_portly` holds for the
quotient topology. -/
theorem susp_portly [PreconnectedSpace S] [LocallyConnectedSpace S] {U : Set S}
    (hU : IsPortly U) :
    IsPortly (range (Susp.map ((↑) : U → S)) \ Susp.O : Set (SuspQ S)) := by
  suffices h : IsPortly (mkQ '' (U ×ˢ Ioi 0) : Set (SuspQ S)) by
    convert h using 1
    exact range_map_val_diff_O U
  refine isPortly_image_of_suspLike (Y := SuspQ S) mkQ continuous_mkQ mk_surjective
    (fun a b h ha => eq_of_mk_eq_of_pos h ha)
    (fun W hW hWp => isOpen_iff.2 (by
      show IsOpen (mk ⁻¹' (mk '' W)); rwa [preimage_image_mk hWp])) hU
    fun σ₀ W hW hσ₀ => ?_
  have hA : ∀ σ : S, ∃ (B : Set S) (δ : ℝ≥0), IsOpen B ∧ IsConnected B ∧ σ ∈ B ∧ 0 < δ ∧
      B ×ˢ Iio δ ⊆ mkQ ⁻¹' W := by
    intro σ
    have hσ : (σ, (0 : ℝ≥0)) ∈ mkQ ⁻¹' W := by
      rw [mem_preimage, show mkQ (σ, (0 : ℝ≥0)) = mkQ (σ₀, 0) from mk_zero_eq _ _]
      exact hσ₀
    obtain ⟨a, ha, b, hb, hab⟩ :=
      mem_nhds_prod_iff.1 ((isOpen_iff.1 hW).mem_nhds hσ)
    obtain ⟨B, hBa, hBo, hσB, hBc⟩ :=
      locallyConnectedSpace_iff_subsets_isOpen_isConnected.1 inferInstance σ a ha
    obtain ⟨δ, hδ, hδb⟩ := NNReal.nhds_zero_basis.mem_iff.1 hb
    exact ⟨B, δ, hBo, hBc, hσB, hδ, fun q hq => hab ⟨hBa hq.1, hδb hq.2⟩⟩
  choose B δ hBo hBc hσB hδ hsub using hA
  set C : Set (S × ℝ≥0) := ⋃ σ, B σ ×ˢ Iio (δ σ)
  have hsat : mkQ ⁻¹' (mkQ '' C) = C := by
    ext q
    refine ⟨?_, fun hq => ⟨q, hq, rfl⟩⟩
    rintro ⟨a, ha, haq⟩
    rcases mk_eq_mk.1 haq with rfl | ⟨-, h2⟩
    · exact ha
    · exact mem_iUnion.2 ⟨q.1, hσB q.1, show q.2 < δ q.1 by rw [h2]; exact hδ q.1⟩
  have hCo : IsOpen C := isOpen_iUnion fun σ => (hBo σ).prod isOpen_Iio
  refine ⟨mkQ '' C, isOpen_iff.2 (by rw [hsat]; exact hCo), ⟨(σ₀, 0), mem_iUnion.2 ⟨σ₀, hσB σ₀, hδ σ₀⟩, rfl⟩,
    image_subset_iff.2 (iUnion_subset hsub), ?_⟩
  set P : S → Set (SuspQ S) := fun σ => mkQ '' ((B σ ∩ U) ×ˢ Ioo 0 (δ σ))
  have heq : mkQ '' C ∩ mkQ '' (U ×ˢ Ioi 0) = ⋃ σ, P σ := by
    ext y
    constructor
    · rintro ⟨⟨a, ha, rfl⟩, ⟨b, hb, hab⟩⟩
      obtain rfl := eq_of_mk_eq_of_pos hab hb.2
      obtain ⟨σ, h1, h2⟩ := mem_iUnion.1 ha
      exact mem_iUnion.2 ⟨σ, b, ⟨⟨h1, hb.1⟩, hb.2, h2⟩, rfl⟩
    · intro hy
      obtain ⟨σ, a, ⟨⟨h1, h2⟩, h3, h4⟩, rfl⟩ := mem_iUnion.1 hy
      exact ⟨⟨a, mem_iUnion.2 ⟨σ, h1, h4⟩, rfl⟩, ⟨a, ⟨h2, h3⟩, rfl⟩⟩
  rw [heq]
  refine IsPreconnected.iUnion_of_reflTransGen (fun σ =>
    ((hU.locallyConnectedIn _ (hBo σ) (hBc σ).isPreconnected).prod isPreconnected_Ioo).image _
      continuous_mkQ.continuousOn) fun i j => ?_
  refine PreconnectedSpace.induction₂' _ (fun σ => ?_) ⟨fun _ _ _ => ReflTransGen.trans⟩ i j
  filter_upwards [(hBo σ).mem_nhds (hσB σ)] with τ hτ
  obtain ⟨u, ⟨hu1, hu2⟩, huU⟩ :=
    hU.dense.inter_open_nonempty _ ((hBo σ).inter (hBo τ)) ⟨τ, hτ, hσB τ⟩
  have hm : 0 < min (δ σ) (δ τ) := lt_min (hδ σ) (hδ τ)
  have hne : (P σ ∩ P τ).Nonempty :=
    ⟨mkQ (u, min (δ σ) (δ τ) / 2),
      ⟨_, ⟨⟨hu1, huU⟩, half_pos hm, (half_lt_self hm.ne').trans_le (min_le_left _ _)⟩, rfl⟩,
      ⟨_, ⟨⟨hu2, huU⟩, half_pos hm, (half_lt_self hm.ne').trans_le (min_le_right _ _)⟩, rfl⟩⟩
  exact ⟨ReflTransGen.single hne, ReflTransGen.single (by rwa [inter_comm] at hne)⟩

end SuspQ

/-! ### `rem:infinite_angle_disc_suspension`: `𝔻_∞ = susp(ℝ)` -/

namespace Susp

/-- `susp(ℝ) → 𝔻_∞`, `(θ, r) ↦ (r, θ)` and `O ↦ (0,0)`. -/
def toDInfty : Susp ℝ → DInfty :=
  Quotient.lift (fun p : ℝ × ℝ≥0 => if h : 0 < p.2 then (⟨p.2, p.1, Or.inl h⟩ : DInfty)
    else DInfty.apex) (by
    rintro a b (rfl | ⟨ha, hb⟩)
    · rfl
    · simp [ha, hb])

theorem toDInfty_mk (p : ℝ × ℝ≥0) : toDInfty (mk p) =
    if h : 0 < p.2 then (⟨p.2, p.1, Or.inl h⟩ : DInfty) else DInfty.apex := rfl

theorem r_toDInfty (x : Susp ℝ) : (toDInfty x).r = x.r := by
  obtain ⟨p, rfl⟩ := mk_surjective x
  by_cases h : 0 < p.2
  · simp [toDInfty_mk, h]
  · simp [toDInfty_mk, nonpos_iff_eq_zero.1 (not_lt.1 h)]

/-- `𝔻_∞ → susp(ℝ)`, `(r, θ) ↦ (θ, r)`. -/
def ofDInfty (d : DInfty) : Susp ℝ := mk (d.θ, d.r.toNNReal)

theorem continuous_toDInfty : Continuous toDInfty := by
  refine continuous_generateFrom_iff.2 ?_
  rintro s (⟨O', hO', hO'p, rfl⟩ | ⟨r₀, -, rfl⟩)
  · refine isOpen_of_subset_pos (fun x hx => ?_) ?_
    · have h1 : 0 < (toDInfty x).r := hO'p hx
      rw [r_toDInfty] at h1
      exact_mod_cast h1
    · have heq : mk ⁻¹' (toDInfty ⁻¹' {p | (p.r, p.θ) ∈ O'}) =
          posPart ℝ ∩ (fun p : ℝ × ℝ≥0 => ((p.2 : ℝ), p.1)) ⁻¹' O' := by
        ext p
        by_cases h : 0 < p.2
        · simp [toDInfty_mk, h, posPart]
        · have h0 : ((0 : ℝ), (0 : ℝ)) ∉ O' := fun h' => absurd (hO'p h') (lt_irrefl (0 : ℝ))
          simp [toDInfty_mk, h, posPart, h0]
      rw [heq]
      exact isOpen_posPart.inter (hO'.preimage
        ((NNReal.continuous_coe.comp continuous_snd).prodMk continuous_fst))
  · show IsOpen {x | (toDInfty x).r < r₀}
    simp_rw [r_toDInfty]
    exact isOpen_lt (NNReal.continuous_coe.comp continuous_r) continuous_const

theorem continuous_ofDInfty : Continuous ofDInfty := by
  refine DInfty.continuous_of_posEmb (continuous_mk.comp
    ((continuous_snd.comp continuous_subtype_val).prodMk
      (continuous_real_toNNReal.comp (continuous_fst.comp continuous_subtype_val)))) ?_
  intro V hV
  have hO : ofDInfty DInfty.apex ∈ (O : Set (Susp ℝ)) := by
    show (0 : ℝ).toNNReal = 0
    simp
  obtain ⟨δ, hδ, hδV⟩ := (hasBasis_nhds_O hO).mem_iff.1 hV
  refine ⟨δ, by exact_mod_cast hδ, fun p hp => hδV ?_⟩
  show p.r.toNNReal < δ
  exact (Real.toNNReal_lt_iff_lt_coe p.r_nonneg).2 hp

/-- `rem:infinite_angle_disc_suspension` (`RamcovGX.tex:718`): `susp(ℝ) ≃ₜ 𝔻_∞`. -/
def homeomorphDInfty : Susp ℝ ≃ₜ DInfty where
  toFun := toDInfty
  invFun := ofDInfty
  left_inv x := by
    obtain ⟨p, rfl⟩ := mk_surjective x
    by_cases h : 0 < p.2
    · simp [toDInfty_mk, h, ofDInfty]
    · rw [toDInfty_mk, dif_neg h]
      exact mk_eq_mk.2 (Or.inr ⟨by simp, nonpos_iff_eq_zero.1 (not_lt.1 h)⟩)
  right_inv d := by
    rcases d.pos_or_eq_apex with h | rfl
    · have h' : 0 < d.r.toNNReal := Real.toNNReal_pos.2 h
      simp only [ofDInfty, toDInfty_mk, dif_pos h']
      ext <;> simp [Real.coe_toNNReal _ h.le]
    · simp [ofDInfty, toDInfty_mk]
  continuous_toFun := continuous_toDInfty
  continuous_invFun := continuous_ofDInfty

/-- **`rem:infinite_angle_disc_suspension`** (`RamcovGX.tex:718`): the infinite angle disc `𝔻_∞`
(with the topology of `ex:quotient_base`, `GX.DInfty`) is the suspension of `ℝ`. -/
def dInftyHomeomorphSusp : DInfty ≃ₜ Susp ℝ := homeomorphDInfty.symm

/-! ### The functor `Top ⥤ Top` -/

/-- **`rem:topological_suspension_fact_functor`**: the topological suspension as a functor
`Top ⥤ Top`, continuous maps being extended radially. -/
def functor : CategoryTheory.Functor TopCat.{u} TopCat.{u} where
  obj X := TopCat.of (Susp X)
  map f := TopCat.ofHom (cmap f.hom)
  map_id X := by
    ext x
    exact congrFun map_id x
  map_comp f g := by
    ext x
    exact congrFun (map_comp g.hom f.hom) x

end Susp

/-! ### `lem:connected_union` -/

/-- **`lem:connected_union`** (`RamcovGX.tex:749`): for a nonempty family of nonempty connected
open subsets, the union is connected iff the equivalence relation generated by
`i ∼ j ⇔ Uᵢ ∩ Uⱼ ≠ ∅` has a single class. -/
theorem connected_union {M ι : Type*} [TopologicalSpace M] [Nonempty ι] {U : ι → Set M}
    (hUo : ∀ i, IsOpen (U i)) (hUc : ∀ i, IsConnected (U i)) :
    IsConnected (⋃ i, U i) ↔ ∀ i j, EqvGen (fun i j => (U i ∩ U j).Nonempty) i j := by
  constructor
  · intro h i j
    have := h.isPreconnected.transGen_of_iUnion hUo i j (hUc i).nonempty (hUc j).nonempty
    induction this with
    | single h => exact .rel _ _ h
    | tail _ h ih => exact ih.trans _ _ _ (.rel _ _ h)
  · intro h
    refine IsConnected.iUnion_of_reflTransGen hUc fun i j => ?_
    induction h i j with
    | rel _ _ h => exact .single h
    | refl => exact .refl
    | symm _ _ _ ih =>
      haveI : Std.Symm fun i j => (U i ∩ U j).Nonempty :=
        ⟨fun a b hab => by rwa [inter_comm] at hab⟩
      exact Std.Symm.symm _ _ ih
    | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

/-- `lem:connected_union`, in the paper's words: `I/∼` is a singleton. -/
theorem connected_union_quot {M ι : Type*} [TopologicalSpace M] [Nonempty ι] {U : ι → Set M}
    (hUo : ∀ i, IsOpen (U i)) (hUc : ∀ i, IsConnected (U i)) :
    IsConnected (⋃ i, U i) ↔ Subsingleton (Quot fun i j => (U i ∩ U j).Nonempty) := by
  rw [connected_union hUo hUc]
  refine ⟨fun h => ⟨fun a b => ?_⟩, fun h i j => Quot.eqvGen_exact (Subsingleton.elim _ _)⟩
  induction a using Quot.ind
  induction b using Quot.ind
  exact Quot.eqvGen_sound (h _ _)

end GX
