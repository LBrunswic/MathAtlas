noncomputable section
open Set Filter Topology Function TopologicalSpace unitInterval
open scoped GX
namespace GX

attribute [local instance] Classical.propDecidable

set_option linter.unusedSectionVars false

universe u v

/-- The unit interval is locally path-connected (a convex subset of `ℝ`). -/
instance locPathConnectedSpace_unitInterval_sptop : LocPathConnectedSpace I :=
  (convex_Icc (0 : ℝ) 1).locPathConnectedSpace

/-! ### The generators of `p^*T` -/

section Generators

variable {E : Type*} {N : Type*} {T : TopologicalSpace N} [tE : TopologicalSpace E]
  [tN : TopologicalSpace N]

/-- The generators of `p^*T` besides the topology of `E`: the components (for the topology of `E`)
of the `p⁻¹(O)`, `O` open for `T`. -/
def strongPullGen (p : E → N) (T : TopologicalSpace N) : Set (Set E) :=
  {s | ∃ O : Set N, IsOpen[T] O ∧ ∃ x ∈ p ⁻¹' O, s = connectedComponentIn (p ⁻¹' O) x}

theorem strongPullTop_eq_inf_generateFrom (p : E → N) :
    strongPullTop p T = tE ⊓ generateFrom (strongPullGen p T) := rfl

/-- A topology `T` finer than the topology of `N` (`T ≤ tN`) has more open sets. -/
theorem isOpen_of_le_sptop (hT : T ≤ tN) {U : Set N} (hU : IsOpen U) :
    IsOpen[T] U :=
  (TopologicalSpace.le_def.1 hT) U hU

/-- If `p` is a spread and `T` is finer than the topology of `N`, the topology of `E` is redundant:
`p^*T` is generated by the components alone. -/
theorem strongPullTop_eq_generateFrom {p : E → N} (hp : IsSpread p)
    (hT : T ≤ tN) : strongPullTop p T = generateFrom (strongPullGen p T) := by
  refine le_antisymm inf_le_right (le_inf (le_of_le_of_eq (TopologicalSpace.generateFrom_anti ?_)
    hp.eq_generateFrom.symm) le_rfl)
  rintro s ⟨U, hU, x, hx, rfl⟩
  exact ⟨U, isOpen_of_le_sptop hT hU, x, hx, rfl⟩

/-- The generators form a basis of `p^*T`. -/
theorem isTopologicalBasis_strongPullGen {p : E → N} (hp : IsSpread p)
    (hT : T ≤ tN) : @IsTopologicalBasis E (strongPullTop p T) (strongPullGen p T) := by
  refine @IsTopologicalBasis.mk E (strongPullTop p T) _ ?_ ?_ (strongPullTop_eq_generateFrom hp hT)
  · rintro _ ⟨O₁, hO₁, x₁, hx₁, rfl⟩ _ ⟨O₂, hO₂, x₂, hx₂, rfl⟩ x ⟨h₁, h₂⟩
    have hx1 : p x ∈ O₁ := connectedComponentIn_subset (p ⁻¹' O₁) x₁ h₁
    have hx2 : p x ∈ O₂ := connectedComponentIn_subset (p ⁻¹' O₂) x₂ h₂
    refine ⟨connectedComponentIn (p ⁻¹' (O₁ ∩ O₂)) x,
      ⟨O₁ ∩ O₂, @IsOpen.inter N T _ _ hO₁ hO₂, x, ⟨hx1, hx2⟩, rfl⟩, mem_connectedComponentIn ⟨hx1, hx2⟩,
      subset_inter ?_ ?_⟩
    · rw [connectedComponentIn_eq h₁]
      exact connectedComponentIn_mono _ (preimage_mono inter_subset_left)
    · rw [connectedComponentIn_eq h₂]
      exact connectedComponentIn_mono _ (preimage_mono inter_subset_right)
  · refine eq_univ_of_forall fun x => mem_sUnion.2 ⟨connectedComponentIn (p ⁻¹' univ) x,
      ⟨univ, @isOpen_univ N T, x, mem_univ _, rfl⟩, mem_connectedComponentIn (mem_univ _)⟩

/-- The neighbourhoods of `x` for `p^*T`: the components of `x` in the `p⁻¹(O)`, `O` a
`T`-open neighbourhood of `p x`. -/
theorem hasBasis_nhds_strongPullTop {p : E → N} (hp : IsSpread p)
    (hT : T ≤ tN) (x : E) :
    (@nhds E (strongPullTop p T) x).HasBasis (fun O : Set N => IsOpen[T] O ∧ p x ∈ O)
      (fun O => connectedComponentIn (p ⁻¹' O) x) := by
  have hb := @IsTopologicalBasis.nhds_hasBasis E (strongPullTop p T) _
    (isTopologicalBasis_strongPullGen hp hT) x
  refine hb.to_hasBasis ?_ ?_
  · rintro _ ⟨⟨O, hO, x', hx', rfl⟩, hxs⟩
    have hxO : p x ∈ O := connectedComponentIn_subset (p ⁻¹' O) x' hxs
    exact ⟨O, ⟨hO, hxO⟩, by rw [connectedComponentIn_eq hxs]⟩
  · rintro O ⟨hO, hxO⟩
    exact ⟨_, ⟨⟨O, hO, x, hxO, rfl⟩, mem_connectedComponentIn hxO⟩, le_rfl⟩

/-- A generator is open for `p^*T`. -/
theorem isOpen_strongPullGen {p : E → N} {s : Set E}
    (hs : s ∈ strongPullGen p T) : IsOpen[strongPullTop p T] s := by
  obtain ⟨O, hO, x, hx, rfl⟩ := hs
  exact isOpen_strongPullTop_connectedComponentIn p T hO hx

/-- Preconnectedness passes from a finer to a coarser topology. -/
theorem isPreconnected_of_le_sptop {X : Type*} {t₁ t₂ : TopologicalSpace X} (h : t₁ ≤ t₂)
    {s : Set X} (hs : @IsPreconnected X t₁ s) : @IsPreconnected X t₂ s := by
  have := @IsPreconnected.image X X t₁ t₂ s hs id
    (@Continuous.continuousOn X X t₁ t₂ id s (@continuous_id_of_le X t₁ t₂ h))
  rwa [image_id] at this

/-- **Continuity into `p^*T`** (the paper's "all such paths are strongly continuous",
l.2031–2033): a map `f` from a locally connected space is `p^*T`-continuous iff it is continuous
for the topology of `E` and `p ∘ f` is `T`-continuous. -/
theorem continuous_strongPullTop_iff {Z : Type*} [TopologicalSpace Z] [LocallyConnectedSpace Z]
    {p : E → N} {f : Z → E} :
    Continuous[_, strongPullTop p T] f ↔ Continuous f ∧ Continuous[_, T] (p ∘ f) := by
  constructor
  · intro h
    exact ⟨@continuous_le_rng Z E f _ (strongPullTop p T) tE (strongPullTop_le p T) h,
      @Continuous.comp Z E N _ (strongPullTop p T) T f p (continuous_strongPullTop p T) h⟩
  · rintro ⟨hf, hpf⟩
    refine continuous_inf_rng.2 ⟨hf, continuous_generateFrom_iff.2 ?_⟩
    rintro _ ⟨O, hO, x, hx, rfl⟩
    rw [isOpen_iff_forall_mem_open]
    intro z hz
    have hzO : IsOpen ((p ∘ f) ⁻¹' O) := @Continuous.isOpen_preimage Z N _ T (p ∘ f) hpf O hO
    have hzm : z ∈ (p ∘ f) ⁻¹' O := connectedComponentIn_subset (p ⁻¹' O) x hz
    refine ⟨connectedComponentIn ((p ∘ f) ⁻¹' O) z, fun w hw => ?_, hzO.connectedComponentIn,
      mem_connectedComponentIn hzm⟩
    have hsub : f '' connectedComponentIn ((p ∘ f) ⁻¹' O) z ⊆ connectedComponentIn (p ⁻¹' O) x := by
      rw [connectedComponentIn_eq hz]
      refine (isPreconnected_connectedComponentIn.image f hf.continuousOn).subset_connectedComponentIn
        ⟨z, mem_connectedComponentIn hzm, rfl⟩ ?_
      rintro _ ⟨w', hw', rfl⟩
      exact connectedComponentIn_subset ((p ∘ f) ⁻¹' O) z hw'
    exact hsub ⟨w, hw, rfl⟩

end Generators

/-! ### `rem:intuitively_spread_thinner_than` -/

section Remark

variable {E : Type*} {N : Type*} {T : TopologicalSpace N} {σ' : TopologicalSpace E}
  [tE : TopologicalSpace E] [tN : TopologicalSpace N] {p : E → N}

/-- `rem:intuitively_spread_thinner_than` (`RamcovGX.tex:2006`), the coarsest-topology half: every
locally connected topology `σ'` finer than that of `E` for which `p : (E, σ') → (N, T)` is
continuous is finer than `p^*T`. (A `σ'`-component of `p⁻¹(O)` is connected for the coarser
topology of `E`, hence lies in an `E`-component, which is therefore a union of `σ'`-open sets.) -/
theorem le_strongPullTop_of_continuous (hle : σ' ≤ tE)
    (hlc : @LocallyConnectedSpace E σ') (hc : Continuous[σ', T] p) : σ' ≤ strongPullTop p T := by
  refine le_inf hle (le_generateFrom ?_)
  rintro _ ⟨O, hO, x, hx, rfl⟩
  rw [@isOpen_iff_forall_mem_open E σ']
  intro z hz
  have hzO : z ∈ p ⁻¹' O := connectedComponentIn_subset (p ⁻¹' O) x hz
  have hpO : IsOpen[σ'] (p ⁻¹' O) := @Continuous.isOpen_preimage E N σ' T p hc O hO
  refine ⟨@connectedComponentIn E σ' (p ⁻¹' O) z, ?_,
    @IsOpen.connectedComponentIn E σ' hlc _ _ hpO, @mem_connectedComponentIn E σ' _ _ hzO⟩
  rw [connectedComponentIn_eq hz]
  exact (isPreconnected_of_le_sptop hle
    (@isPreconnected_connectedComponentIn E σ' z (p ⁻¹' O))).subset_connectedComponentIn
    (@mem_connectedComponentIn E σ' _ _ hzO) (@connectedComponentIn_subset E σ' _ _)

/-- `rem:intuitively_spread_thinner_than`: every spread topology `σ'` finer than that of `E`
(`p : (E, σ') → (N, T)` a spread) is finer than `p^*T`. -/
theorem le_strongPullTop_of_isSpread (hle : σ' ≤ tE)
    (hsp : @IsSpread E N σ' T p) : σ' ≤ strongPullTop p T :=
  le_strongPullTop_of_continuous (tE := tE) hle (@IsSpread.locallyConnectedSpace E N σ' T p hsp)
    (@IsSpread.continuous E N σ' T p hsp)

/-- `rem:intuitively_spread_thinner_than` and the spread half of `lem:spread_top` (e) (l.2052–2054):
if `p` is a spread and `T` is finer than the topology of `N`, `p : (E, p^*T) → (N, T)` is a spread
as soon as `p^*T` is locally connected. (A `p^*T`-component of `p⁻¹(O)` lies in the
`E`-component, so the `p^*T`-components refine the generators.) -/
theorem isSpread_strongPullTop (hp : IsSpread p) (hT : T ≤ tN)
    (hlc : @LocallyConnectedSpace E (strongPullTop p T)) :
    @IsSpread E N (strongPullTop p T) T p := by
  refine (@isSpread_iff_of_locallyConnectedSpace E N (strongPullTop p T) T hlc p).2
    ⟨continuous_strongPullTop p T, ?_⟩
  intro x O hO hxO
  obtain ⟨U, ⟨hU, hxU⟩, hsub⟩ := (hasBasis_nhds_strongPullTop hp hT x).mem_iff.1
    (@IsOpen.mem_nhds E (strongPullTop p T) _ _ hO hxO)
  refine ⟨U, hU, hxU, subset_trans ?_ hsub⟩
  exact (isPreconnected_of_le_sptop (strongPullTop_le p T)
    (@isPreconnected_connectedComponentIn E (strongPullTop p T) x (p ⁻¹' U))).subset_connectedComponentIn
    (@mem_connectedComponentIn E (strongPullTop p T) _ _ hxU)
    (@connectedComponentIn_subset E (strongPullTop p T) _ _)

/-- `rem:intuitively_spread_thinner_than`: `p : (E, p^*T) → (N, T)` is a spread iff `p^*T` is
locally connected (`p` a spread, `T` finer than the topology of `N`). -/
theorem isSpread_strongPullTop_iff (hp : IsSpread p) (hT : T ≤ tN) :
    @IsSpread E N (strongPullTop p T) T p ↔ @LocallyConnectedSpace E (strongPullTop p T) :=
  ⟨fun h => @IsSpread.locallyConnectedSpace E N (strongPullTop p T) T p h,
    isSpread_strongPullTop hp hT⟩

/-- `rem:intuitively_spread_thinner_than` (`RamcovGX.tex:2006`), the precise form of
"intuitively, `p^*T` is the coarsest topology on `M` such that `(M, p^*T) → (N, T)` is a spread":
whenever `p^*T` makes `p` a spread, it is the coarsest (greatest, in mathlib's order) of the
topologies finer than that of `E` making `p` a spread. -/
theorem isGreatest_strongPullTop_of_isSpread (h : @IsSpread E N (strongPullTop p T) T p) :
    IsGreatest {σ' : TopologicalSpace E | σ' ≤ tE ∧ @IsSpread E N σ' T p} (strongPullTop p T) :=
  ⟨⟨strongPullTop_le p T, h⟩, fun σ'' hσ => le_strongPullTop_of_isSpread (σ' := σ'') (tE := tE)
    hσ.1 hσ.2⟩

/-- `rem:intuitively_spread_thinner_than`: under `p` a spread and `T` finer than the topology of
`N`, `p^*T` is the coarsest spread topology finer than that of `E` as soon as it is locally
connected. -/
theorem isGreatest_strongPullTop (hp : IsSpread p) (hT : T ≤ tN)
    (hlc : @LocallyConnectedSpace E (strongPullTop p T)) :
    IsGreatest {σ' : TopologicalSpace E | σ' ≤ tE ∧ @IsSpread E N σ' T p} (strongPullTop p T) :=
  isGreatest_strongPullTop_of_isSpread (isSpread_strongPullTop hp hT hlc)

end Remark

/-- The topology on `ℝ` generated by the usual one and `[0, ∞)`: `ℝ` cut at `0`. -/
@[reducible] def cutTopReal : TopologicalSpace ℝ :=
  (inferInstance : TopologicalSpace ℝ) ⊓ generateFrom {Ici 0}

/-- `rem:intuitively_spread_thinner_than`, "the definition does not guarantee that `T_M`-connected
components are `p^*T`-connected components": for `p = id : ℝ → ℝ` and `T` the usual topology cut
at `0` (finer than the usual one), `ℝ`, the usual component of `p⁻¹(ℝ)`, is not `p^*T`-connected. -/
theorem cex_component_not_strongPull_connected :
    cutTopReal ≤ (inferInstance : TopologicalSpace ℝ) ∧
      connectedComponentIn ((id : ℝ → ℝ) ⁻¹' univ) 0 = univ ∧
      ¬ @IsPreconnected ℝ (strongPullTop (id : ℝ → ℝ) cutTopReal) univ := by
  refine ⟨inf_le_left, ?_, ?_⟩
  · rw [preimage_univ]
    exact isPreconnected_univ.connectedComponentIn (mem_univ _)
  · intro h
    have hT : IsOpen[cutTopReal] (Ici (0 : ℝ)) :=
      (TopologicalSpace.le_def.1 (inf_le_right : cutTopReal ≤ _)) _
        (TopologicalSpace.GenerateOpen.basic _ rfl)
    have h1 : IsOpen[strongPullTop (id : ℝ → ℝ) cutTopReal] (Ici (0 : ℝ)) := by
      have := isOpen_strongPullTop_connectedComponentIn (id : ℝ → ℝ) cutTopReal hT
        (x := 0) (show (0 : ℝ) ∈ Ici 0 from mem_Ici.2 le_rfl)
      rwa [preimage_id, isPreconnected_Ici.connectedComponentIn
        (show (0 : ℝ) ∈ Ici 0 from mem_Ici.2 le_rfl)]
        at this
    have h2 : IsOpen[strongPullTop (id : ℝ → ℝ) cutTopReal] (Iio (0 : ℝ)) :=
      (TopologicalSpace.le_def.1 (strongPullTop_le (id : ℝ → ℝ) cutTopReal)) _ isOpen_Iio
    obtain ⟨z, -, hz1, hz2⟩ := h _ _ h1 h2 (fun x _ => (le_or_gt 0 x).imp id id)
      ⟨0, mem_univ _, mem_Ici.2 le_rfl⟩ ⟨-1, mem_univ _, by norm_num⟩
    exact absurd (lt_of_lt_of_le (mem_Iio.1 hz2) (mem_Ici.1 hz1)) (lt_irrefl _)

/-- The topology on `ℝ` generated by the usual one and `ℚ`. -/
@[reducible] def ratTopReal : TopologicalSpace ℝ :=
  (inferInstance : TopologicalSpace ℝ) ⊓ generateFrom {range ((↑) : ℚ → ℝ)}

/-- The components of `ℚ` in `ℝ` are points. -/
theorem connectedComponentIn_range_rat (q : ℚ) :
    connectedComponentIn (range ((↑) : ℚ → ℝ)) (q : ℝ) = {(q : ℝ)} := by
  refine Subset.antisymm (fun z hz => ?_)
    (singleton_subset_iff.2 (mem_connectedComponentIn ⟨q, rfl⟩))
  by_contra hne
  have hpc := isPreconnected_connectedComponentIn (F := range ((↑) : ℚ → ℝ)) (x := (q : ℝ))
  have hq : (q : ℝ) ∈ connectedComponentIn (range ((↑) : ℚ → ℝ)) (q : ℝ) :=
    mem_connectedComponentIn ⟨q, rfl⟩
  have key : ∀ a b : ℝ, a < b → a ∈ connectedComponentIn (range ((↑) : ℚ → ℝ)) (q : ℝ) →
      b ∈ connectedComponentIn (range ((↑) : ℚ → ℝ)) (q : ℝ) → False := by
    intro a b hab ha hb
    obtain ⟨r, hr, h1, h2⟩ := exists_irrational_btwn hab
    obtain ⟨q', hq'⟩ := connectedComponentIn_subset _ _ (hpc.Icc_subset ha hb ⟨h1.le, h2.le⟩)
    exact hr.ne_rat q' hq'.symm
  rcases lt_or_gt_of_ne (show z ≠ (q : ℝ) from hne) with h | h
  · exact key _ _ h hz hq
  · exact key _ _ h hq hz

theorem nhds_ratTopReal_of_irrational {x : ℝ} (hx : Irrational x) :
    @nhds ℝ ratTopReal x = 𝓝 x := by
  rw [nhds_inf, TopologicalSpace.nhds_generateFrom]
  have : {s | x ∈ s ∧ s ∈ ({range ((↑) : ℚ → ℝ)} : Set (Set ℝ))} = ∅ := by
    ext s
    simp only [mem_setOf_eq, mem_singleton_iff, mem_empty_iff_false, iff_false, not_and]
    rintro hxs rfl
    obtain ⟨q, hq⟩ := hxs
    exact hx.ne_rat q hq.symm
  rw [this]
  simp only [mem_empty_iff_false, iInf_of_empty, iInf_top, inf_top_eq]

/-- `rem:intuitively_spread_thinner_than`, "Point (e) above is thus non-trivial": `p^*T` need not
make `p` a spread. For `p = id : ℝ → ℝ` and `T` generated by the usual topology and `ℚ`, the
rationals are `p^*T`-isolated (their usual components in `ℚ` are points) while an irrational point
keeps its usual neighbourhoods, so `p^*T` is not locally connected at `√2`. -/
theorem not_isSpread_strongPullTop_ratTop :
    ratTopReal ≤ (inferInstance : TopologicalSpace ℝ) ∧
      ¬ @IsSpread ℝ ℝ (strongPullTop (id : ℝ → ℝ) ratTopReal) ratTopReal id := by
  refine ⟨inf_le_left, fun hsp => ?_⟩
  have hlc := @IsSpread.locallyConnectedSpace ℝ ℝ (strongPullTop id ratTopReal) ratTopReal id hsp
  have hx : Irrational (√2) := irrational_sqrt_two
  obtain ⟨V, ⟨hVo, hxV, hVc⟩, -⟩ := (@LocallyConnectedSpace.open_connected_basis ℝ
    (strongPullTop id ratTopReal) hlc (√2)).mem_iff.1 (@univ_mem _ (@nhds ℝ (strongPullTop id
      ratTopReal) (√2)))
  -- `V` is a usual neighbourhood of `√2`
  have hVn : V ∈ 𝓝 (√2) := by
    obtain ⟨O, ⟨hO, hxO⟩, hsub⟩ := (hasBasis_nhds_strongPullTop (p := (id : ℝ → ℝ))
      (IsSpread.of_isInducing Topology.IsInducing.id) (inf_le_left : ratTopReal ≤ _) (√2)).mem_iff.1
      (@IsOpen.mem_nhds ℝ (strongPullTop id ratTopReal) _ _ hVo hxV)
    have hOn : O ∈ 𝓝 (√2) := by
      rw [← nhds_ratTopReal_of_irrational hx]; exact @IsOpen.mem_nhds ℝ ratTopReal _ _ hO hxO
    exact Filter.mem_of_superset (connectedComponentIn_mem_nhds (by rwa [preimage_id])) hsub
  obtain ⟨ε, hε, hεV⟩ := Metric.mem_nhds_iff.1 hVn
  obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn (show √2 < √2 + ε by linarith)
  have hqV : (q : ℝ) ∈ V := hεV (by
    rw [Metric.mem_ball, Real.dist_eq, abs_lt]; constructor <;> linarith)
  have hQ : IsOpen[ratTopReal] (range ((↑) : ℚ → ℝ)) :=
    (TopologicalSpace.le_def.1 (inf_le_right : ratTopReal ≤ _)) _
      (TopologicalSpace.GenerateOpen.basic _ rfl)
  have h1 : IsOpen[strongPullTop id ratTopReal] {(q : ℝ)} := by
    have := isOpen_strongPullTop_connectedComponentIn (id : ℝ → ℝ) ratTopReal hQ
      (x := (q : ℝ)) ⟨q, rfl⟩
    rwa [preimage_id, connectedComponentIn_range_rat] at this
  have h2 : IsOpen[strongPullTop id ratTopReal] ({(q : ℝ)}ᶜ) :=
    (TopologicalSpace.le_def.1 (strongPullTop_le (id : ℝ → ℝ) ratTopReal)) _ isOpen_compl_singleton
  have hVp : @IsPreconnected ℝ (strongPullTop id ratTopReal) V :=
    @IsConnected.isPreconnected ℝ (strongPullTop id ratTopReal) V hVc
  obtain ⟨z, -, hz1, hz2⟩ := hVp _ _ h1 h2 (fun z _ => (em (z = q)).imp id id)
    ⟨q, hqV, rfl⟩ ⟨√2, hxV, hx.ne_rat q⟩
  exact hz2 hz1

/-- Every subset of an indiscrete space is preconnected. -/
theorem isPreconnected_top_sptop {X : Type*} (s : Set X) : @IsPreconnected X ⊤ s := by
  intro u v hu hv _ ⟨x, hxs, hxu⟩ ⟨y, hys, hyv⟩
  rcases (TopologicalSpace.isOpen_top_iff u).1 hu with rfl | rfl
  · exact absurd hxu (notMem_empty x)
  rcases (TopologicalSpace.isOpen_top_iff v).1 hv with rfl | rfl
  · exact absurd hyv (notMem_empty y)
  exact ⟨x, hxs, mem_univ _, mem_univ _⟩

/-- `rem:intuitively_spread_thinner_than`: in "the coarsest topology on `M` such that
`(M, p^*T) → (N, T)` is a spread", the topologies compared must be finer than `T_M` (as in
`GX.isGreatest_strongPullTop_of_isSpread`): for `p : ℝ → Unit` (a spread, `T` the topology of
the point), `p^*T` is the usual topology of `ℝ` and the indiscrete topology also makes `p` a
spread, so `p^*T` is not the coarsest among all spread topologies. -/
theorem not_isGreatest_strongPullTop_unrestricted :
    ¬ IsGreatest {σ' : TopologicalSpace ℝ | @IsSpread ℝ Unit σ' inferInstance (fun _ => ())}
      (strongPullTop (fun _ : ℝ => ()) inferInstance) := by
  rintro ⟨-, hmax⟩
  have hpre : ∀ (U : Set Unit) (x : ℝ), x ∈ (fun _ : ℝ => ()) ⁻¹' U →
      (fun _ : ℝ => ()) ⁻¹' U = univ := fun U x hx => eq_univ_of_forall fun _ => hx
  have hcc : ∀ x : ℝ, @connectedComponentIn ℝ ⊤ univ x = univ := fun x =>
    eq_univ_of_univ_subset (@IsPreconnected.subset_connectedComponentIn ℝ ⊤ _ _ _
      (isPreconnected_top_sptop univ) (mem_univ x) subset_rfl)
  have hsp : @IsSpread ℝ Unit ⊤ inferInstance (fun _ => ()) := by
    refine (@isSpread_iff ℝ Unit ⊤ _ _).2 ⟨@continuous_const ℝ Unit ⊤ _ (), ?_, ?_⟩
    · rintro _ ⟨U, -, x, hx, rfl⟩
      rw [hpre U x hx, hcc x]
      exact @isOpen_univ ℝ ⊤
    · intro x O hO hxO
      rcases (TopologicalSpace.isOpen_top_iff O).1 hO with rfl | rfl
      · exact absurd hxO (notMem_empty x)
      · exact ⟨univ, isOpen_univ, mem_univ _, subset_univ _⟩
  have h := (hmax hsp).trans (strongPullTop_le (fun _ : ℝ => ()) inferInstance)
  have h0 : IsOpen[⊤] (Ioi (0 : ℝ)) := (TopologicalSpace.le_def.1 h) _ isOpen_Ioi
  rcases (TopologicalSpace.isOpen_top_iff _).1 h0 with h1 | h1
  · exact absurd (h1 ▸ (mem_Ioi.2 (one_pos : (0 : ℝ) < 1))) (notMem_empty _)
  · have : (-1 : ℝ) ∈ Ioi 0 := h1 ▸ mem_univ _
    exact absurd (mem_Ioi.1 this) (by norm_num)

/-! ### The sub-covering `\widetilde M^S → N` is Galoisian -/

section SubCovering

variable {M : Type u} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
  [FirstCountableTopology M] [ConnectedSpace M] {S : Set M} {y₀ : (Sᶜ : Set M)}
  {N : Type v} [tN : TopologicalSpace N] [T2Space N] [LocPathConnectedSpace N]
  [FirstCountableTopology N] {p : MaxBranchedCover S y₀ → N} {q : N → M}

/-- In a sub-covering `\widetilde M^S → N → M`, `N → M` is ordinary over `M ∖ S`: a component `C`
of `q⁻¹(U)`, `U` evenly covered by `\widetilde M^S → M`, is the image of a sheet `K` over `U`
(`p` maps a component of `p⁻¹(C)` onto `C`), so `q : C → U` is bijective with inverse
`p ∘ (base|_K)⁻¹`. -/
theorem compl_subset_ordY_of_comp (hS : IsSkeletal S)
    (hSc : SemilocallySimplyConnected (Sᶜ : Set M)) (hp : IsBranchedCovering p)
    (hq : IsBranchedCovering q) (hqp : ∀ e, q (p e) = e.base) : (Sᶜ : Set M) ⊆ ordY q := by
  intro y hy
  obtain ⟨-, hβbc, hβS, -, hl, -⟩ := maxBranched_basic hS hSc y₀
  haveI := hl
  have hyo : y ∈ ordY (SpreadEnd.base : MaxBranchedCover S y₀ → M) := by
    by_contra h; exact hy (hβS h)
  obtain ⟨U, hU, hyU, ⟨e₀, he₀⟩, hev⟩ := hyo
  refine ⟨U, hU, hyU, ⟨p e₀, by show q (p e₀) ∈ U; rw [hqp]; exact he₀⟩, ?_⟩
  intro n hn
  obtain ⟨ê, rfl⟩ := hp.surjective n
  have hêU : ê ∈ (SpreadEnd.base : MaxBranchedCover S y₀ → M) ⁻¹' U := by
    show ê.base ∈ U; rw [← hqp]; exact hn
  set K := connectedComponentIn ((SpreadEnd.base : MaxBranchedCover S y₀ → M) ⁻¹' U) ê with hKdef
  set C := connectedComponentIn (q ⁻¹' U) (p ê) with hCdef
  obtain ⟨h, hh⟩ := hev ê hêU
  have hpc := hp.isSpread.continuous
  have hCo : IsOpen C := (hU.preimage hq.isSpread.continuous).connectedComponentIn
  have hK_sub : K ⊆ p ⁻¹' C := by
    refine image_subset_iff.1 ((isPreconnected_connectedComponentIn.image p
      hpc.continuousOn).subset_connectedComponentIn ⟨ê, mem_connectedComponentIn hêU, rfl⟩ ?_)
    rintro _ ⟨k, hk, rfl⟩
    show q (p k) ∈ U
    rw [hqp]; exact connectedComponentIn_subset ((SpreadEnd.base : MaxBranchedCover S y₀ → M) ⁻¹' U) ê hk
  have hKeq : connectedComponentIn (p ⁻¹' C) ê = K := by
    apply Subset.antisymm
    · refine connectedComponentIn_mono _ fun z hz => ?_
      show z.base ∈ U
      rw [← hqp]; exact connectedComponentIn_subset (q ⁻¹' U) (p ê) hz
    · exact isPreconnected_connectedComponentIn.subset_connectedComponentIn
        (mem_connectedComponentIn hêU) hK_sub
  have hKC : p '' K = C := by
    rw [← hKeq]
    exact hp.image_connectedComponentIn hCo isPreconnected_connectedComponentIn
      (mem_connectedComponentIn hn)
  have hinv : ∀ u : U, p (h.symm u) ∈ C := fun u => by
    rw [← hKC]; exact ⟨_, (h.symm u).2, rfl⟩
  have hCU : ∀ c : C, q c ∈ U := fun c => connectedComponentIn_subset (q ⁻¹' U) (p ê) c.2
  refine ⟨{ toFun := fun c => ⟨q c, hCU c⟩
            invFun := fun u => ⟨p (h.symm u), hinv u⟩
            left_inv := fun c => ?_
            right_inv := fun u => ?_
            continuous_toFun := (hq.isSpread.continuous.comp continuous_subtype_val).subtype_mk _
            continuous_invFun :=
              ((hpc.comp continuous_subtype_val).comp h.symm.continuous).subtype_mk _ }, fun z => rfl⟩
  · obtain ⟨k, hk, hkc⟩ : (c : N) ∈ p '' K := by rw [hKC]; exact c.2
    apply Subtype.ext
    show p (h.symm ⟨q c, _⟩) = c
    have : (⟨q c, hCU c⟩ : U) = h ⟨k, hk⟩ := by
      apply Subtype.ext
      rw [hh]
      show q c = k.base
      rw [← hkc, hqp]
    rw [this, Homeomorph.symm_apply_apply, hkc]
  · apply Subtype.ext
    show q (p (h.symm u)) = u
    rw [hqp, ← hh, Homeomorph.apply_symm_apply]

/-- **The sub-covering `\widetilde M^S → N` is Galoisian** (`RamcovGX.tex:2025`, "`\widetilde M^S →
M` is Galoisian and thus so is `\widetilde M^S → N`", asserted without argument). Over
`q⁻¹(M ∖ S)` the automorphisms of `\widetilde M^S → M` moving a point of a `p`-fibre to another
lie over `N` (two lifts through `q` agreeing at an ordinary point); the orbits are then dense in
every fibre of `p`, which is discrete (it lies in a fibre of `\widetilde M^S → M`, discrete since
`M ∖ S` is semi-locally simply connected in `M`), hence transitive. `N` Hausdorff, locally
path-connected and first countable (§3's standing hypotheses, l.812). -/
theorem isGaloisian_of_comp (hS : IsSkeletal S)
    (hSc : SemilocallySimplyConnected (Sᶜ : Set M)) (hrel : IsSLSCInCC (Sᶜ : Set M))
    (hp : IsBranchedCovering p) (hq : IsBranchedCovering q) (hqp : ∀ e, q (p e) = e.base) :
    IsGaloisian p := by
  refine ⟨hp, fun z z' hzz => ?_⟩
  obtain ⟨hl, -, -⟩ := maxBranched_instances hS hSc y₀
  haveI := hl
  obtain ⟨hbc, -⟩ := maxBranched_isBranchedCovering hS hSc y₀
  have hO : IsPortly (Sᶜ : Set M) := isSkeletal_iff.1 hS
  have hOq := compl_subset_ordY_of_comp hS hSc hp hq hqp
  have htr : ∀ z z', p z = p z' → p z ∈ q ⁻¹' Sᶜ → ∃ g ∈ deckGroup p, g z = z' := by
    intro z z' hzz hz
    have hb : z.base = z'.base := by rw [← hqp, ← hqp z', hzz]
    have hzS : z.base ∈ Sᶜ := by rw [← hqp]; exact hz
    obtain ⟨φ, hφ, hφz⟩ := maxBranched_transitive hS hSc y₀ z z' hb hzS
    refine ⟨φ, ?_, hφz⟩
    exact eq_of_comp_eq_of_mem_portly hbc hq hO hOq (hp.isSpread.continuous.comp φ.continuous)
      hp.isSpread.continuous (fun e => by simp only [comp_apply, hqp, deck_apply _ hφ]) hqp hzS
      (by simp only [comp_apply, hφz, hzz])
  have hD : Dense (q ⁻¹' Sᶜ) := (hq.isPortly_preimage hO).dense
  have hdense : ∀ z z', p z = p z' → ∀ V ∈ 𝓝 z', ∃ g ∈ deckGroup p, g z ∈ V :=
    fun z z' hzz V hV => exists_mem_nhds_of_transitive hp le_rfl hD htr hzz hV
  have hsl : IsSLSCIn (Sᶜ : Set M) := (isSLSCInCC_iff hO.isOpen hSc).1 hrel
  have hdisc : DiscreteTopology (p ⁻¹' {p z'}) := by
    haveI := discreteTopology_fiber_maxBranched_of_isSLSCIn hS hSc y₀ hsl (q (p z'))
    have hsub : p ⁻¹' {p z'} ⊆
        (SpreadEnd.base : MaxBranchedCover S y₀ → M) ⁻¹' {q (p z')} := fun w hw => by
      show w.base = q (p z')
      rw [← hqp, show p w = p z' from hw]
    exact (Topology.IsEmbedding.inclusion hsub).discreteTopology
  exact exists_eq_of_discreteTopology_fiber le_rfl hdisc hdense hzz rfl

/-- The fibres of the sub-covering `\widetilde M^S → N` are discrete (`M ∖ S` semi-locally simply
connected in `M`). -/
theorem discreteTopology_fiber_of_comp (hS : IsSkeletal S)
    (hSc : SemilocallySimplyConnected (Sᶜ : Set M)) (hrel : IsSLSCInCC (Sᶜ : Set M))
    (hqp : ∀ e, q (p e) = e.base) (n : N) : DiscreteTopology (p ⁻¹' {n}) := by
  have hO : IsPortly (Sᶜ : Set M) := isSkeletal_iff.1 hS
  have hsl : IsSLSCIn (Sᶜ : Set M) := (isSLSCInCC_iff hO.isOpen hSc).1 hrel
  haveI := discreteTopology_fiber_maxBranched_of_isSLSCIn hS hSc y₀ hsl (q n)
  have hsub : p ⁻¹' {n} ⊆ (SpreadEnd.base : MaxBranchedCover S y₀ → M) ⁻¹' {q n} :=
    fun w hw => by
      show w.base = q n
      rw [← hqp, show p w = n from hw]
  exact (Topology.IsEmbedding.inclusion hsub).discreteTopology

end SubCovering

/-! ### Lifting paths through a branched covering -/

section Lift

variable {X : Type*} {Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] [T1Space Y]
  [LocallyConnectedSpace Y] {p : X → Y}

/-- A path which lies in an ordinary set `R ⊆ ord_p(Y)` before time `1` lifts through a branched
covering from any point over its origin (lift on `[0,1)` through the covering over `ord_p(Y)`,
then Fox's extension property at `1`). -/
theorem exists_lift_path_of_subset_ordY (hp : IsBranchedCovering p) {R : Set Y}
    (hR : R ⊆ ordY p) (γ : C(I, Y)) (hγ : ∀ t : I, t < 1 → γ t ∈ R) {e : X} (he : p e = γ 0) :
    ∃ g : C(I, X), (∀ t, p (g t) = γ t) ∧ g 0 = e := by
  haveI := hp.isSpread.locallyConnectedSpace
  have he' : p e ∈ ordY p := by rw [he]; exact hR (hγ 0 zero_lt_one)
  obtain ⟨f, hf, hf0, hfs⟩ := exists_partial_lift (isCoveringMap_restrict_ordX hp.isSpread.continuous)
    γ (fun t ht => hR (hγ t ht)) he' he
  obtain ⟨g, hg, hgf⟩ := exists_extend_path_of_isCompleteSpread hp.isSpread hp.isComplete γ f hf
    (fun t ht => (hfs t ht).2)
  exact ⟨g, hg, by rw [hgf 0 zero_lt_one, hf0]⟩

/-- Through a Galoisian branched covering, a path which lies in `R ⊆ ord_p(Y)` before time `1`
lifts to a path ending at any prescribed point over its end (the paper's "There thus exists some
weakly continuous lift `γ̂` of `γ` such that `γ̂(1) = ŷ`", l.2019). -/
theorem exists_lift_path_end_of_isGaloisian (hp : IsGaloisian p) {R : Set Y} (hR : R ⊆ ordY p)
    (γ : C(I, Y)) (hγ : ∀ t : I, t < 1 → γ t ∈ R) {e : X} (he : p e = γ 1) :
    ∃ g : C(I, X), (∀ t, p (g t) = γ t) ∧ g 1 = e := by
  obtain ⟨e₀, he₀⟩ := hp.1.surjective (γ 0)
  obtain ⟨g, hg, -⟩ := exists_lift_path_of_subset_ordY hp.1 hR γ hγ he₀
  obtain ⟨φ, hφ, hφe⟩ := hp.2 (g 1) e (by rw [hg, he])
  refine ⟨⟨fun t => φ (g t), φ.continuous.comp g.continuous⟩, fun t => ?_, hφe⟩
  show p (φ (g t)) = γ t
  rw [deck_apply p hφ, hg]

end Lift

/-! ### `lem:spread_top`, the two-topology argument -/

/-- A locally path-connected topology is locally connected (explicit topology). -/
theorem locallyConnectedSpace_of_lpc_sptop {X : Type*} {t : TopologicalSpace X}
    (h : @LocPathConnectedSpace X t) : @LocallyConnectedSpace X t := by
  letI := t; exact inferInstance

section TwoTop

variable {X : Type*} {N : Type*} {T : TopologicalSpace N} [tX : TopologicalSpace X]
  [tN : TopologicalSpace N] [T1Space N] [LocallyConnectedSpace N] {p : X → N} {R : Set N}

/-- A `T`-path is a path for the coarser topology of `N`. -/
def Path.weakOfLe_sptop (hT : T ≤ tN) {a b : N} (γ : @Path N T a b) : C(I, N) :=
  ⟨γ, @continuous_le_rng I N γ _ T tN hT (@Path.continuous N T a b γ)⟩

@[simp] theorem Path.weakOfLe_sptop_apply (hT : T ≤ tN) {a b : N} (γ : @Path N T a b) (t : I) :
    Path.weakOfLe_sptop hT γ t = γ t := rfl

theorem lt_one_coe_sptop {t : I} (ht : t < 1) : (t : ℝ) < 1 := by
  have : (t : ℝ) < ((1 : I) : ℝ) := ht
  simpa using this

/-- The Claim of `lem:spread_top`, first part (`RamcovGX.tex:2016–2021`, `R` portly for `T`,
`p` Galoisian): every point `x` of a component `Ô` of `p⁻¹(O)`, `O` `T`-open, is the end of a path
in `Ô` which starts in `p⁻¹(R)`, continuous for the topology of `X` and with `T`-continuous
projection (hence `p^*T`-continuous, `continuous_strongPullTop_iff`). -/
theorem exists_path_in_component_sptop (hpg : IsGaloisian p) (hR : R ⊆ ordY p) (hT : T ≤ tN)
    (hT1 : @FirstCountableTopology N T) (hT2 : @LocPathConnectedSpace N T)
    (hRT : @IsPortly N T R) {O : Set N} (hO : IsOpen[T] O) {x : X} (hx : p x ∈ O) :
    ∃ g : C(I, X), Continuous[_, T] (p ∘ g) ∧ g 1 = x ∧ p (g 0) ∈ R ∧
      ∀ t, g t ∈ connectedComponentIn (p ⁻¹' O) x := by
  have hO₂o : IsOpen[T] (@pathComponentIn N T O (p x)) :=
    @IsOpen.pathComponentIn N T O hT2 hO (p x)
  have hO₂c : @IsPathConnected N T (@pathComponentIn N T O (p x)) :=
    @isPathConnected_pathComponentIn N T _ _ hx
  have hxO₂ : p x ∈ @pathComponentIn N T O (p x) := @mem_pathComponentIn_self N T _ _ hx
  have hO₂O : @pathComponentIn N T O (p x) ⊆ O := @pathComponentIn_subset N T _ _
  obtain ⟨a, haO₂, haR⟩ := @Dense.inter_open_nonempty N T R (@IsPortly.dense N T R hRT) _ hO₂o ⟨p x, hxO₂⟩
  obtain ⟨γ, hγO, hγR⟩ := @exists_path_of_isPortly_of_isOpen N T hT1 hT2 R _ hRT hO₂o
    (@IsConnected.isPreconnected N T _ (@IsPathConnected.isConnected N T _ hO₂c)) a (p x) haR
    haO₂ hxO₂
  obtain ⟨g, hg, hg1⟩ := exists_lift_path_end_of_isGaloisian hpg hR (Path.weakOfLe_sptop hT γ)
    (fun t ht => hγR t (lt_one_coe_sptop ht)) (e := x)
    (by rw [Path.weakOfLe_sptop_apply, @Path.target N T a (p x) γ])
  have hpg' : p ∘ g = γ := funext hg
  refine ⟨g, ?_, hg1, ?_, fun t => ?_⟩
  · rw [hpg']; exact @Path.continuous N T a (p x) γ
  · rw [hg, Path.weakOfLe_sptop_apply, @Path.source N T a (p x) γ]; exact haR
  · refine (isPreconnected_range g.continuous).subset_connectedComponentIn ⟨1, hg1⟩ ?_ ⟨t, rfl⟩
    rintro _ ⟨s, rfl⟩
    show p (g s) ∈ O
    rw [hg]; exact hO₂O (hγO s)

/-- `lem:spread_top` (proof, "the first part of the claim shows that `R̂` is strongly dense",
l.2036): `p⁻¹(R)` is dense for `p^*T`. -/
theorem dense_strongPullTop_preimage (hpg : IsGaloisian p) (hR : R ⊆ ordY p) (hT : T ≤ tN)
    (hT1 : @FirstCountableTopology N T) (hT2 : @LocPathConnectedSpace N T)
    (hRT : @IsPortly N T R) : @Dense X (strongPullTop p T) (p ⁻¹' R) := by
  refine (@dense_iff_inter_open X (strongPullTop p T) _).2 fun U hU ⟨x, hxU⟩ => ?_
  obtain ⟨O, ⟨hO, hxO⟩, hsub⟩ := (hasBasis_nhds_strongPullTop hpg.1.isSpread hT x).mem_iff.1
    (@IsOpen.mem_nhds X (strongPullTop p T) _ _ hU hxU)
  obtain ⟨g, -, -, hg0, hgc⟩ :=
    exists_path_in_component_sptop hpg hR hT hT1 hT2 hRT hO hxO
  exact ⟨g 0, hsub (hgc 0), hg0⟩

/-- A path for `p^*T` built from a path of `X` with `T`-continuous projection. -/
def Path.strongOf_sptop {x y : X} (g : C(I, X)) (hg : Continuous[_, T] (p ∘ g)) (h0 : g 0 = x)
    (h1 : g 1 = y) : @Path X (strongPullTop p T) x y :=
  @Path.mk X (strongPullTop p T) x y
    (@ContinuousMap.mk I X _ (strongPullTop p T) g
      (continuous_strongPullTop_iff.2 ⟨g.continuous, hg⟩)) h0 h1

theorem Path.strongOf_sptop_apply {x y : X} (g : C(I, X)) (hg : Continuous[_, T] (p ∘ g))
    (h0 : g 0 = x) (h1 : g 1 = y) (t : I) : Path.strongOf_sptop (T := T) g hg h0 h1 t = g t := rfl

/-- `lem:spread_top` (a), local path-connectedness (proof l.2042–2046, the second part of the
Claim, l.2022–2029): the components `Ô` of `p⁻¹(O)`, `O` `T`-open and `T`-path-connected, small
enough that `Ô` meets the fibre of `x` only at `x` (fibres discrete), form a basis of
`p^*T`-path-connected neighbourhoods of `x`: every point of `Ô` is joined in `Ô` to a point of
`p⁻¹(R)` (Claim, first part), and the lift from that point of a path to `p x` through `R` ends in
`Ô` over `p x`, i.e. at `x`. `p` Galoisian with discrete fibres. -/
theorem locPathConnectedSpace_strongPullTop (hpg : IsGaloisian p)
    (hdisc : ∀ n, DiscreteTopology (p ⁻¹' {n})) (hR : R ⊆ ordY p) (hT : T ≤ tN)
    (hT1 : @FirstCountableTopology N T) (hT2 : @LocPathConnectedSpace N T)
    (hRT : @IsPortly N T R) : @LocPathConnectedSpace X (strongPullTop p T) := by
  have hsp := hpg.1.isSpread
  refine @LocPathConnectedSpace.of_bases X (strongPullTop p T) (Set N)
    (fun x O => IsOpen[T] O ∧ p x ∈ O ∧ @IsPathConnected N T O ∧
      ∀ z ∈ connectedComponentIn (p ⁻¹' O) x, p z = p x → z = x)
    (fun x O => connectedComponentIn (p ⁻¹' O) x) (fun x => ?_) (fun x O hPO => ?_)
  · refine (hasBasis_nhds_strongPullTop hsp hT x).to_hasBasis (fun O ⟨hO, hxO⟩ => ?_)
      (fun O hPO => ⟨O, ⟨hPO.1, hPO.2.1⟩, le_rfl⟩)
    haveI := hdisc (p x)
    have hop : IsOpen ({⟨x, rfl⟩} : Set (p ⁻¹' {p x})) := isOpen_discrete _
    obtain ⟨V₀, hV₀, hV₀e⟩ := isOpen_induced_iff.1 hop
    have hxV₀ : x ∈ V₀ := by
      have : (⟨x, rfl⟩ : p ⁻¹' {p x}) ∈ Subtype.val ⁻¹' V₀ := by rw [hV₀e]; rfl
      exact this
    have hfib : ∀ z ∈ V₀, p z = p x → z = x := fun z hz hzx => by
      have : (⟨z, hzx⟩ : p ⁻¹' {p x}) ∈ Subtype.val ⁻¹' V₀ := hz
      rw [hV₀e] at this
      exact congrArg Subtype.val this
    have hV₀σ : IsOpen[strongPullTop p T] V₀ :=
      (TopologicalSpace.le_def.1 (strongPullTop_le p T)) _ hV₀
    have hmem : connectedComponentIn (p ⁻¹' O) x ∩ V₀ ∈ @nhds X (strongPullTop p T) x :=
      @inter_mem _ (@nhds X (strongPullTop p T) x) _ _
        (@IsOpen.mem_nhds X (strongPullTop p T) _ _
          (isOpen_strongPullTop_connectedComponentIn p T hO hxO) (mem_connectedComponentIn hxO))
        (@IsOpen.mem_nhds X (strongPullTop p T) _ _ hV₀σ hxV₀)
    obtain ⟨O₁, ⟨hO₁, hxO₁⟩, hsub⟩ := (hasBasis_nhds_strongPullTop hsp hT x).mem_iff.1 hmem
    have hsub' : connectedComponentIn (p ⁻¹' (@pathComponentIn N T O₁ (p x))) x ⊆
        connectedComponentIn (p ⁻¹' O) x ∩ V₀ :=
      (connectedComponentIn_mono _ (preimage_mono (@pathComponentIn_subset N T _ _))).trans hsub
    exact ⟨@pathComponentIn N T O₁ (p x), ⟨@IsOpen.pathComponentIn N T O₁ hT2 hO₁ (p x),
      @mem_pathComponentIn_self N T _ _ hxO₁, @isPathConnected_pathComponentIn N T _ _ hxO₁,
      fun z hz hzx => hfib z (hsub' hz).2 hzx⟩, hsub'.trans inter_subset_left⟩
  · obtain ⟨hO, hxO, hOc, hfib⟩ := hPO
    have hOpc : @IsPreconnected N T O :=
      @IsConnected.isPreconnected N T _ (@IsPathConnected.isConnected N T _ hOc)
    refine ⟨x, mem_connectedComponentIn hxO, fun z hz => ?_⟩
    have hzO : p z ∈ O := connectedComponentIn_subset (p ⁻¹' O) x hz
    have hFz : connectedComponentIn (p ⁻¹' O) z = connectedComponentIn (p ⁻¹' O) x :=
      (connectedComponentIn_eq hz).symm
    obtain ⟨g, hgc, hg1, hg0R, hgF⟩ :=
      exists_path_in_component_sptop hpg hR hT hT1 hT2 hRT hO hzO
    have hg0O : p (g 0) ∈ O := connectedComponentIn_subset (p ⁻¹' O) z (hgF 0)
    obtain ⟨γ', hγ'O, hγ'R⟩ := @exists_path_of_isPortly_of_isOpen N T hT1 hT2 R O hRT hO hOpc
      _ _ hg0R hg0O hxO
    obtain ⟨g', hg', hg'0⟩ := exists_lift_path_of_subset_ordY hpg.1 hR (Path.weakOfLe_sptop hT γ')
      (fun t ht => hγ'R t (lt_one_coe_sptop ht)) (e := g 0)
      (by rw [Path.weakOfLe_sptop_apply, @Path.source N T _ _ γ'])
    have hg'F : ∀ t, g' t ∈ connectedComponentIn (p ⁻¹' O) x := by
      intro t
      rw [← hFz, connectedComponentIn_eq (hgF 0)]
      refine (isPreconnected_range g'.continuous).subset_connectedComponentIn ⟨0, hg'0⟩ ?_ ⟨t, rfl⟩
      rintro _ ⟨s, rfl⟩
      show p (g' s) ∈ O
      rw [hg']; exact hγ'O s
    have hg'1 : g' 1 = x := hfib (g' 1) (hg'F 1)
      (by rw [hg', Path.weakOfLe_sptop_apply, @Path.target N T _ _ γ'])
    have hg'c : Continuous[_, T] (p ∘ g') := by
      have : p ∘ g' = γ' := funext hg'
      rw [this]; exact @Path.continuous N T _ _ γ'
    have J1 : @JoinedIn X (strongPullTop p T) (connectedComponentIn (p ⁻¹' O) x) (g 0) z :=
      ⟨Path.strongOf_sptop g hgc rfl hg1, fun t => by
        rw [Path.strongOf_sptop_apply, ← hFz]; exact hgF t⟩
    have J2 : @JoinedIn X (strongPullTop p T) (connectedComponentIn (p ⁻¹' O) x) (g 0) x :=
      ⟨Path.strongOf_sptop g' hg'c hg'0 hg'1, fun t => by
        rw [Path.strongOf_sptop_apply]; exact hg'F t⟩
    exact @JoinedIn.trans X (strongPullTop p T) _ _ _ _
      (@JoinedIn.symm X (strongPullTop p T) _ _ _ J2) J1

/-- `lem:spread_top` (a), first countability (proof l.2037–2040): the components of `x` in the
`p⁻¹(O_n)`, `(O_n)` a countable basis of `T`-neighbourhoods of `p x`, form a basis at `x`. -/
theorem firstCountableTopology_strongPullTop (hsp : IsSpread p) (hT : T ≤ tN)
    (hT1 : @FirstCountableTopology N T) : @FirstCountableTopology X (strongPullTop p T) := by
  refine @FirstCountableTopology.mk X (strongPullTop p T) fun x => ?_
  haveI := @FirstCountableTopology.nhds_generated_countable N T hT1 (p x)
  obtain ⟨u, hu⟩ := (@nhds N T (p x)).exists_antitone_basis
  refine Filter.HasBasis.isCountablyGenerated (p := fun _ : ℕ => True)
    (s := fun n => connectedComponentIn (p ⁻¹' (@interior N T (u n))) x) ?_
  refine (hasBasis_nhds_strongPullTop hsp hT x).to_hasBasis (fun O ⟨hO, hxO⟩ => ?_)
    (fun n _ => ⟨@interior N T (u n), ⟨@isOpen_interior N T _,
      (@mem_interior_iff_mem_nhds N T _ _).2 (hu.mem n)⟩, le_rfl⟩)
  obtain ⟨n, -, hn⟩ := hu.toHasBasis.mem_iff.1 (@IsOpen.mem_nhds N T _ _ hO hxO)
  exact ⟨n, trivial, connectedComponentIn_mono _
    (preimage_mono ((@interior_subset N T _).trans hn))⟩

/-- `lem:spread_top` (b) (proof l.2011, "it is not difficult to see"): `p^*T` and the topology
of `X` agree on `p⁻¹(R)`. Near `e ∈ p⁻¹(R)`, a `T`-connected `T`-open `O₂ ∋ p e` inside an evenly
covered neighbourhood and inside `R` is also open in `R` for the topology of `N` (the two agree on
`R`) and connected for it; its lift through the sheet of `e` is connected, so it lies in the
component of `e` in `p⁻¹(O)`. -/
theorem induced_strongPullTop_eq (hsp : IsSpread p) (hT : T ≤ tN)
    (hT2 : @LocallyConnectedSpace N T) (hR : R ⊆ ordY p) (hRT : IsOpen[T] R)
    (hRagree : TopologicalSpace.induced (Subtype.val : R → N) T =
      TopologicalSpace.induced (Subtype.val : R → N) tN) :
    TopologicalSpace.induced (Subtype.val : (p ⁻¹' R) → X) (strongPullTop p T) =
      TopologicalSpace.induced (Subtype.val : (p ⁻¹' R) → X) tX := by
  haveI := hsp.locallyConnectedSpace
  refine TopologicalSpace.ext_nhds fun e => ?_
  rw [@nhds_induced X _ (strongPullTop p T), @nhds_induced X _ tX]
  refine le_antisymm (Filter.comap_mono (nhds_mono (strongPullTop_le p T))) ?_
  refine ((hasBasis_nhds_strongPullTop hsp hT (e : X)).comap Subtype.val).ge_iff.2 ?_
  rintro O ⟨hO, heO⟩
  have heR : p e ∈ R := e.2
  obtain ⟨U, hU, heU, -, hev⟩ := hR heR
  have heU' : (e : X) ∈ p ⁻¹' U := heU
  obtain ⟨h, hh⟩ := hev (e : X) heU'
  have hO₁ : IsOpen[T] (O ∩ R ∩ U) :=
    @IsOpen.inter N T _ _ (@IsOpen.inter N T _ _ hO hRT) (isOpen_of_le_sptop hT hU)
  have heO₁ : p e ∈ O ∩ R ∩ U := ⟨⟨heO, heR⟩, heU⟩
  have hO₂o : IsOpen[T] (@connectedComponentIn N T (O ∩ R ∩ U) (p e)) :=
    @IsOpen.connectedComponentIn N T hT2 _ _ hO₁
  have hO₂sub : @connectedComponentIn N T (O ∩ R ∩ U) (p e) ⊆ O ∩ R ∩ U :=
    @connectedComponentIn_subset N T _ _
  have hO₂c : IsPreconnected (@connectedComponentIn N T (O ∩ R ∩ U) (p e)) :=
    isPreconnected_of_le_sptop hT (@isPreconnected_connectedComponentIn N T _ _)
  have heO₂ : p e ∈ @connectedComponentIn N T (O ∩ R ∩ U) (p e) :=
    @mem_connectedComponentIn N T _ _ heO₁
  set O₂ := @connectedComponentIn N T (O ∩ R ∩ U) (p e) with hO₂def
  -- `O₂` is open in `R` for the topology of `N`
  have hO₂R : IsOpen[TopologicalSpace.induced (Subtype.val : R → N) tN]
      ((Subtype.val : R → N) ⁻¹' O₂) := by
    rw [← hRagree]; exact @isOpen_induced R N T Subtype.val O₂ hO₂o
  obtain ⟨W, hW, hWe⟩ := isOpen_induced_iff.1 hO₂R
  have hWR : ∀ y ∈ R, y ∈ W ↔ y ∈ O₂ := fun y hy => by
    have := congrArg (fun s : Set R => (⟨y, hy⟩ : R) ∈ s) hWe
    simpa using this
  -- the sheet `K` of `e` over `U`
  have hKo : IsOpen (connectedComponentIn (p ⁻¹' U) (e : X)) :=
    (hU.preimage hsp.continuous).connectedComponentIn
  refine Filter.mem_comap.2 ⟨connectedComponentIn (p ⁻¹' U) (e : X) ∩ p ⁻¹' W,
    (hKo.inter (hW.preimage hsp.continuous)).mem_nhds
      ⟨mem_connectedComponentIn heU', (hWR _ heR).2 heO₂⟩, ?_⟩
  rintro v ⟨hvK, hvW⟩
  have hvO₂ : p v ∈ O₂ := (hWR _ v.2).1 hvW
  -- the lift of `O₂` through the sheet
  set A' : Set U := (Subtype.val : U → N) ⁻¹' O₂ with hA'
  have hA'c : IsPreconnected A' := by
    refine (Topology.IsInducing.subtypeVal.isPreconnected_image).1 ?_
    rw [Subtype.image_preimage_coe, inter_eq_right.2 fun y hy => (hO₂sub hy).2]
    exact hO₂c
  have hLc : IsPreconnected ((fun u => ((h.symm u : connectedComponentIn (p ⁻¹' U) (e : X)) : X))
      '' A') :=
    hA'c.image _ (continuous_subtype_val.comp h.symm.continuous).continuousOn
  have hmemL : ∀ w (hw : w ∈ connectedComponentIn (p ⁻¹' U) (e : X)), p w ∈ O₂ →
      w ∈ (fun u => ((h.symm u : connectedComponentIn (p ⁻¹' U) (e : X)) : X)) '' A' := by
    intro w hw hwO
    refine ⟨h ⟨w, hw⟩, ?_, by simp⟩
    show ((h ⟨w, hw⟩ : U) : N) ∈ O₂
    rw [hh]; exact hwO
  have hLsub : (fun u => ((h.symm u : connectedComponentIn (p ⁻¹' U) (e : X)) : X)) '' A' ⊆
      p ⁻¹' O := by
    rintro _ ⟨u, hu, rfl⟩
    show p (h.symm u : X) ∈ O
    rw [← hh, Homeomorph.apply_symm_apply]
    exact (hO₂sub hu).1.1
  exact hLc.subset_connectedComponentIn (hmemL _ (mem_connectedComponentIn heU') heO₂) hLsub
    (hmemL _ hvK hvO₂)

/-- `lem:spread_top` (a), connectedness (proof l.2047–2048), under the hypothesis its proof
uses: `p⁻¹(R)` connected for the topology of `X` (the paper's "`R̂` is weakly connected", asserted
without argument; it holds when `R` is portly for the topology of `N`,
`isPreconnected_preimage_of_isPortly`; without it `p^*T` can be disconnected,
`cex_spread_top_halfCut`, and the variant with `T` connected is an informal finding, not
formalized). `p⁻¹(R)`
is then `p^*T`-connected (b) and `p^*T`-dense. -/
theorem connectedSpace_strongPullTop [Nonempty X] (hpg : IsGaloisian p) (hR : R ⊆ ordY p)
    (hT : T ≤ tN) (hT1 : @FirstCountableTopology N T) (hT2 : @LocPathConnectedSpace N T)
    (hRT : @IsPortly N T R)
    (hRagree : TopologicalSpace.induced (Subtype.val : R → N) T =
      TopologicalSpace.induced (Subtype.val : R → N) tN)
    (hRc : IsPreconnected (p ⁻¹' R)) : @ConnectedSpace X (strongPullTop p T) := by
  have hb := induced_strongPullTop_eq hpg.1.isSpread hT
    (locallyConnectedSpace_of_lpc_sptop hT2) hR (@IsPortly.isOpen N T R hRT)
    hRagree
  have h1 : PreconnectedSpace (p ⁻¹' R) := isPreconnected_iff_preconnectedSpace.1 hRc
  have h2 : @PreconnectedSpace (p ⁻¹' R)
      (TopologicalSpace.induced (Subtype.val : (p ⁻¹' R) → X) (strongPullTop p T)) := by
    rw [hb]; exact h1
  have h3 : @IsPreconnected X (strongPullTop p T) (p ⁻¹' R) :=
    (@isPreconnected_iff_preconnectedSpace X (strongPullTop p T) _).2 h2
  have hd := dense_strongPullTop_preimage hpg hR hT hT1 hT2 hRT
  have h4 := @IsPreconnected.closure X (strongPullTop p T) _ h3
  rw [@Dense.closure_eq X (strongPullTop p T) _ hd] at h4
  exact @ConnectedSpace.mk X (strongPullTop p T) (@PreconnectedSpace.mk X (strongPullTop p T) h4)
    inferInstance

variable (p T R) in
/-- The local hypothesis under which `lem:spread_top` (c) holds (the last sentence of the Claim,
l.2029: "We may assume that `Ô ∩ R̂` is connected"): every point has arbitrarily small `p^*T`-open
neighbourhoods meeting `p⁻¹(R)` in a `p^*T`-connected set. (On `p⁻¹(R)` the two topologies agree,
`induced_strongPullTop_eq`, so connectedness there may be read in either.) It is NOT implied by the
lemma's hypotheses, even with `p⁻¹(R)` connected (`cex_spread_top_sector`: a sector topology at
the branch point of the logarithmic covering of `ℂ` branched at `0`), and it is equivalent to (c)
(`isPortly_strongPullTop_iff_local`). -/
def StrongLocallyConnectedOrd : Prop :=
  ∀ x : X, ∀ U ∈ @nhds X (strongPullTop p T) x, ∃ V : Set X, IsOpen[strongPullTop p T] V ∧
    x ∈ V ∧ V ⊆ U ∧ @IsPreconnected X (strongPullTop p T) (V ∩ p ⁻¹' R)

/-- `lem:spread_top` (c) (proof l.2049–2058) from the local hypothesis
`StrongLocallyConnectedOrd`: `p⁻¹(R)` is `p^*T`-portly. Open (`p` is strongly continuous), dense
(the Claim), and locally connected in `X` by the local criterion `GX.isPreconnected_of_local`. -/
theorem isPortly_strongPullTop_of_local (hpg : IsGaloisian p) (hR : R ⊆ ordY p) (hT : T ≤ tN)
    (hT1 : @FirstCountableTopology N T) (hT2 : @LocPathConnectedSpace N T)
    (hRT : @IsPortly N T R) (hH : StrongLocallyConnectedOrd T p R) :
    @IsPortly X (strongPullTop p T) (p ⁻¹' R) := by
  have hd := dense_strongPullTop_preimage hpg hR hT hT1 hT2 hRT
  have ho : IsOpen[strongPullTop p T] (p ⁻¹' R) :=
    @Continuous.isOpen_preimage X N (strongPullTop p T) T p (continuous_strongPullTop p T) R
      (@IsPortly.isOpen N T R hRT)
  refine @IsPortly.mk X (strongPullTop p T) _ ho hd fun W hW hWc => ?_
  refine @isPreconnected_of_local X (strongPullTop p T) W (W ∩ p ⁻¹' R) hWc inter_subset_left
    (@Dense.open_subset_closure_inter X (strongPullTop p T) _ _ hd hW) fun x hx => ?_
  obtain ⟨V, hV, hxV, hVW, hVc⟩ := hH x W (@IsOpen.mem_nhds X (strongPullTop p T) _ _ hW hx)
  refine ⟨V, hV, hxV, ?_⟩
  have : V ∩ (W ∩ p ⁻¹' R) = V ∩ p ⁻¹' R := by
    rw [← inter_assoc, inter_eq_left.2 hVW]
  rw [this]; exact hVc

/-- Conversely, (c) gives the local hypothesis as soon as `p^*T` is locally path-connected
(`lem:spread_top` (a)): path components of interiors are open and connected. -/
theorem local_of_isPortly_strongPullTop (hlpc : @LocPathConnectedSpace X (strongPullTop p T))
    (hc : @IsPortly X (strongPullTop p T) (p ⁻¹' R)) : StrongLocallyConnectedOrd T p R := by
  intro x U hU
  have hx : x ∈ @interior X (strongPullTop p T) U :=
    (@mem_interior_iff_mem_nhds X (strongPullTop p T) _ _).2 hU
  have hVo := @IsOpen.pathComponentIn X (strongPullTop p T) _ hlpc
    (@isOpen_interior X (strongPullTop p T) U) x
  have hVc := @isPathConnected_pathComponentIn X (strongPullTop p T) _ _ hx
  have hVpc := @IsConnected.isPreconnected X (strongPullTop p T) _
    (@IsPathConnected.isConnected X (strongPullTop p T) _ hVc)
  exact ⟨_, hVo, @mem_pathComponentIn_self X (strongPullTop p T) _ _ hx,
    (@pathComponentIn_subset X (strongPullTop p T) _ _).trans (@interior_subset X (strongPullTop p T) _),
    @IsPortly.locallyConnectedIn X (strongPullTop p T) _ hc _ hVo hVpc⟩

/-- `lem:spread_top`: (c) holds iff the local hypothesis `StrongLocallyConnectedOrd` does
(the Claim's "we may assume `Ô ∩ R̂` connected" is exactly what (c) needs, and no more). -/
theorem isPortly_strongPullTop_iff_local (hpg : IsGaloisian p)
    (hdisc : ∀ n, DiscreteTopology (p ⁻¹' {n})) (hR : R ⊆ ordY p) (hT : T ≤ tN)
    (hT1 : @FirstCountableTopology N T) (hT2 : @LocPathConnectedSpace N T)
    (hRT : @IsPortly N T R) :
    @IsPortly X (strongPullTop p T) (p ⁻¹' R) ↔ StrongLocallyConnectedOrd T p R :=
  ⟨local_of_isPortly_strongPullTop
      (locPathConnectedSpace_strongPullTop hpg hdisc hR hT hT1 hT2 hRT),
    isPortly_strongPullTop_of_local hpg hR hT hT1 hT2 hRT⟩

/-- `ContinuousOn` into `p^*T` gives `ContinuousOn` for the topology of `X`. -/
theorem continuousOn_of_strongPullTop {Z : Type*} [TopologicalSpace Z] {f : Z → X} {s : Set Z}
    (hf : @ContinuousOn Z X _ (strongPullTop p T) f s) : ContinuousOn f s := by
  rw [continuousOn_iff_continuous_restrict]
  exact @continuous_le_rng s X (s.restrict f) _ (strongPullTop p T) tX (strongPullTop_le p T)
    ((@continuousOn_iff_continuous_restrict Z X _ (strongPullTop p T) f s).1 hf)

/-- `lem:spread_top` (e) (proof l.2050–2058), from (c): `p : (X, p^*T) → (N, T)` is a branched
covering. By `GX.complete_path_carac` (iv) ⇒ (i) for the strong topologies, with `X₁ = p⁻¹(R)`,
`Y₁ = R` (on which the strong and weak topologies agree, so `p⁻¹(R) → R` is still a covering): a
partial lift on `[0,1)` of a `T`-path extends weakly (Fox), and the extension is strongly continuous
(`continuous_strongPullTop_iff`). -/
theorem isBranchedCovering_strongPullTop [T2Space X] [T2Space N] (hpg : IsGaloisian p)
    (hdisc : ∀ n, DiscreteTopology (p ⁻¹' {n})) (hR : R ⊆ ordY p) (hT : T ≤ tN)
    (hT1 : @FirstCountableTopology N T) (hT2 : @LocPathConnectedSpace N T)
    (hRT : @IsPortly N T R)
    (hRagree : TopologicalSpace.induced (Subtype.val : R → N) T =
      TopologicalSpace.induced (Subtype.val : R → N) tN)
    (hconn : @ConnectedSpace X (strongPullTop p T))
    (hc : @IsPortly X (strongPullTop p T) (p ⁻¹' R)) :
    @IsBranchedCovering X N (strongPullTop p T) T p := by
  have hsp := hpg.1.isSpread
  haveI := hsp.locallyConnectedSpace
  have hlpc := locPathConnectedSpace_strongPullTop hpg hdisc hR hT hT1 hT2 hRT
  have hspσ := isSpread_strongPullTop hsp hT (locallyConnectedSpace_of_lpc_sptop hlpc)
  have hT2σ : @T2Space X (strongPullTop p T) := t2Space_antitone (strongPullTop_le p T) ‹_›
  have hT2T : @T2Space N T := t2Space_antitone hT ‹_›
  have hb := induced_strongPullTop_eq hsp hT (locallyConnectedSpace_of_lpc_sptop hT2) hR
    (@IsPortly.isOpen N T R hRT) hRagree
  have hmaps : MapsTo p (p ⁻¹' R) R := mapsTo_preimage p R
  have hcovw : IsCoveringMap (hmaps.restrict p (p ⁻¹' R) R) :=
    ((isCoveringMapOn_ordY hsp.continuous).mono hR).isCoveringMap_restrictPreimage
  have hcovσ : @IsCoveringMap (p ⁻¹' R) R
      (TopologicalSpace.induced Subtype.val (strongPullTop p T))
      (TopologicalSpace.induced Subtype.val T) (hmaps.restrict p (p ⁻¹' R) R) := by
    rw [hb, hRagree]; exact hcovw
  have hsurj : Surjective (hmaps.restrict p (p ⁻¹' R) R) := fun r => by
    obtain ⟨x, hx⟩ := hpg.1.surjective r
    exact ⟨⟨x, by show p x ∈ R; rw [hx]; exact r.2⟩, Subtype.ext hx⟩
  have hPLE : @PathLiftExtends X N (strongPullTop p T) T p (p ⁻¹' R) R := by
    intro γ hγ f hf hfX hfγ
    have hγc : Continuous[_, T] γ := @ContinuousMap.continuous I N _ T γ
    let γw : C(I, N) := ⟨γ, @continuous_le_rng I N γ _ T tN hT hγc⟩
    obtain ⟨g, hg, hgf⟩ := exists_extend_path_of_isCompleteSpread hsp hpg.1.isComplete γw f
      (continuousOn_of_strongPullTop hf) hfγ
    have hpg' : p ∘ g = γ := funext hg
    refine ⟨@ContinuousMap.mk I X _ (strongPullTop p T) g
      (continuous_strongPullTop_iff.2 ⟨g.continuous, by rw [hpg']; exact hγc⟩), hg, hgf⟩
  have tfae := @complete_path_carac.{0} X N (strongPullTop p T) T hT2σ hlpc hconn hT2T hT2 hT1 p hspσ
    (p ⁻¹' R) R hc hRT hmaps hcovσ hsurj
  exact (tfae.out 0 3).2 hPLE

end TwoTop

/-- When `R` is portly for the topology of `N` (as in the paper's one application, l.2096, where
`R = q⁻¹(reg V)`), `p⁻¹(R)` is connected: it is portly in the connected `X`. -/
theorem isPreconnected_preimage_of_isPortly {X : Type*} {N : Type*} [TopologicalSpace X]
    [TopologicalSpace N] {p : X → N} (hp : IsBranchedCovering p) {R : Set N} (hR : IsPortly R) :
    IsPreconnected (p ⁻¹' R) := by
  haveI := hp.connectedSpace_source
  exact (hp.isPortly_preimage hR).isPreconnected

/-! ### `lem:spread_top`, corrected -/

section Corrected

variable {M : Type u} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
  [FirstCountableTopology M] [ConnectedSpace M] {S : Set M}
  {N : Type v} {T : TopologicalSpace N} [tN : TopologicalSpace N] [T2Space N]
  [LocPathConnectedSpace N] [FirstCountableTopology N]

/-- `lem:spread_top` (`RamcovGX.tex:1990`, proof l.2010–2061), in its strongest true form
(DEC-27; the printed statement is false, `not_spreadTopPrinted` on `cex_spread_top_halfCut`, and
remains false for (c) and (e) when `p⁻¹(R)` is assumed connected, `not_spreadTopConnCE` on
`cex_spread_top_sector`). `M` first countable, connected, locally path-connected, Hausdorff; `S`
skeletal, `M ∖ S` semi-locally simply connected in `M` (`hrel`) and as a space (`hSc`, under which
the library builds `\widetilde M^S`); a sub-covering `\widetilde M^S → N → M` (`p`, `q` branched
coverings, `q ∘ p` the projection; `N` Hausdorff, locally path-connected, first countable, the
standing hypotheses of DEC-66(a)); `T` finer than the topology of `N`, first countable, locally
path-connected, `Γ(N/M)` acting `T`-continuously; `R ⊆ ord_p(N)` `T`-portly, on which `T` and the
topology of `N` agree. Then, for `p^*T`:
* (a) first countable and locally path-connected;
* (b) `p^*T` agrees with the natural topology on `p⁻¹(R)`;
* (c) `p⁻¹(R)` is `p^*T`-portly IFF the local hypothesis `StrongLocallyConnectedOrd` holds (the
  Claim's unproved "we may assume `Ô ∩ R̂` connected", which can fail, `cex_spread_top_sector`);
* under the ADDED hypothesis `p⁻¹(R)` connected for the natural topology (the proof's "`R̂` weakly
  connected", l.2047; it follows from `R` portly in `N`, `isPreconnected_preimage_of_isPortly`;
  without it (a) fails, `cex_spread_top_halfCut`): (a) connected, and (e) if (c) holds,
  `p : (\widetilde M^S, p^*T) → (N, T)` is a branched covering;
* (d) if `N → M` is Galoisian, `Γ(\widetilde M^S/M)` acts `p^*T`-continuously (`spread_top_deck`).
The proof's `\widetilde M^S → N` Galoisian (l.2025, unproved) is `isGaloisian_of_comp`. -/
theorem spread_top_corrected (hS : IsSkeletal S) (hSc : SemilocallySimplyConnected (Sᶜ : Set M))
    (hrel : IsSLSCInCC (Sᶜ : Set M)) (y₀ : (Sᶜ : Set M)) {p : MaxBranchedCover S y₀ → N}
    {q : N → M} (hp : IsBranchedCovering p) (hq : IsBranchedCovering q)
    (hqp : ∀ e, q (p e) = e.base) {R : Set N} (hR : R ⊆ ordY p) (hTle : T ≤ tN)
    (hT1 : @FirstCountableTopology N T) (hT2 : @LocPathConnectedSpace N T)
    (hTdeck : ∀ f ∈ @deckMapsOf N M tN q, Continuous[T, T] f) (hRT : @IsPortly N T R)
    (hRagree : TopologicalSpace.induced (Subtype.val : R → N) T =
      TopologicalSpace.induced (Subtype.val : R → N) tN) :
    (@FirstCountableTopology _ (strongPullTop p T) ∧ @LocPathConnectedSpace _ (strongPullTop p T)) ∧
      TopologicalSpace.induced (Subtype.val : (p ⁻¹' R) → MaxBranchedCover S y₀)
          (strongPullTop p T) =
        TopologicalSpace.induced (Subtype.val : (p ⁻¹' R) → MaxBranchedCover S y₀)
          (inferInstance : TopologicalSpace (MaxBranchedCover S y₀)) ∧
      (@IsPortly _ (strongPullTop p T) (p ⁻¹' R) ↔ StrongLocallyConnectedOrd T p R) ∧
      (IsPreconnected (p ⁻¹' R) → @ConnectedSpace _ (strongPullTop p T) ∧
        (@IsPortly _ (strongPullTop p T) (p ⁻¹' R) →
          @IsBranchedCovering _ _ (strongPullTop p T) T p)) ∧
      (IsGaloisian q → ∀ γ ∈ deckGroup (SpreadEnd.base : MaxBranchedCover S y₀ → M),
        Continuous[strongPullTop p T, strongPullTop p T] γ) := by
  obtain ⟨-, -, hT2E⟩ := maxBranched_instances hS hSc y₀
  haveI := hT2E
  have hpg : IsGaloisian p := isGaloisian_of_comp hS hSc hrel hp hq hqp
  have hdisc : ∀ n, DiscreteTopology (p ⁻¹' {n}) :=
    discreteTopology_fiber_of_comp hS hSc hrel hqp
  haveI : Nonempty (MaxBranchedCover S y₀) := hp.connectedSpace_source.toNonempty
  refine ⟨⟨firstCountableTopology_strongPullTop hp.isSpread hTle hT1,
      locPathConnectedSpace_strongPullTop hpg hdisc hR hTle hT1 hT2 hRT⟩,
    induced_strongPullTop_eq hp.isSpread hTle (locallyConnectedSpace_of_lpc_sptop hT2) hR
      (@IsPortly.isOpen N T R hRT) hRagree,
    isPortly_strongPullTop_iff_local hpg hdisc hR hTle hT1 hT2 hRT,
    fun hRc => ?_, fun hqg => spread_top_deck hS hSc y₀ hp hqg hqp T hTdeck⟩
  have hconn := connectedSpace_strongPullTop hpg hR hTle hT1 hT2 hRT hRagree hRc
  exact ⟨hconn, fun hc =>
    isBranchedCovering_strongPullTop hpg hdisc hR hTle hT1 hT2 hRT hRagree hconn hc⟩

end Corrected

/-! ### WP-35g: the definition verbatim, and `lem:spread_top` with all five clauses -/

section DefCert
variable {E : Type*} {N : Type*} [tE : TopologicalSpace E]

/-- `def:topological_spaces_continuous_map` (`RamcovGX.tex:1984`), verbatim: `p^*T` is the
topology GENERATED by the open sets of `M` and the components of the `p⁻¹(O)`, `O ∈ T`. -/
theorem strongPullTop_eq_generateFrom_union (p : E → N) (T : TopologicalSpace N) :
    strongPullTop p T = generateFrom ({s | IsOpen s} ∪ strongPullGen p T) := by
  rw [generateFrom_union, generateFrom_setOf_isOpen]; rfl

end DefCert

section CorrectedFull

variable {M : Type u} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
  [FirstCountableTopology M] [ConnectedSpace M] {S : Set M}
  {N : Type v} {T : TopologicalSpace N} [tN : TopologicalSpace N] [T2Space N]
  [LocPathConnectedSpace N] [FirstCountableTopology N]

/-- **`lem:spread_top`** (`RamcovGX.tex:1990`, proof l.2010–2061) with ALL FIVE clauses (a)–(e),
in the corrected form (DEC-27) which **DEC-80(c)** accepts as the lemma: the printed hypotheses (with "sub-covering" read as two branched
coverings `\widetilde M^S → N → M` composing to the projection, `N` Hausdorff, locally
path-connected, first countable, DEC-66(a)), plus
* `N → M` Galoisian (`hq`, used by (d): the proof's `γ̄ ∈ Γ(N/M)` with `p ∘ γ = γ̄ ∘ p`, l.2015;
  DEC-71's Galoisian reading of a sub-covering);
* `p⁻¹(R)` connected (`hRc`, the proof's "`R̂` weakly connected", l.2047) — necessary even with the
  other two: `not_spreadTopGalLocalCE`;
* the local hypothesis `StrongLocallyConnectedOrd` (`hH`, the Claim's "we may assume `Ô ∩ R̂`
  connected", l.2029) — necessary even with the other two: `not_spreadTopGalConnCE`.
Conclusion, for `p^*T`: (a) first countable, connected, locally path-connected; (b) agreement with
the natural topology on `p⁻¹(R)`; (c) `p⁻¹(R)` portly; (d) `Γ(\widetilde M^S/M)` continuous;
(e) `p : (\widetilde M^S, p^*T) → (N, T)` a branched covering. -/
theorem spread_top_of_local (hS : IsSkeletal S) (hSc : SemilocallySimplyConnected (Sᶜ : Set M))
    (hrel : IsSLSCInCC (Sᶜ : Set M)) (y₀ : (Sᶜ : Set M)) {p : MaxBranchedCover S y₀ → N}
    {q : N → M} (hp : IsBranchedCovering p) (hq : IsGaloisian q)
    (hqp : ∀ e, q (p e) = e.base) {R : Set N} (hR : R ⊆ ordY p) (hTle : T ≤ tN)
    (hT1 : @FirstCountableTopology N T) (hT2 : @LocPathConnectedSpace N T)
    (hTdeck : ∀ f ∈ @deckMapsOf N M tN q, Continuous[T, T] f) (hRT : @IsPortly N T R)
    (hRagree : TopologicalSpace.induced (Subtype.val : R → N) T =
      TopologicalSpace.induced (Subtype.val : R → N) tN)
    (hRc : IsPreconnected (p ⁻¹' R)) (hH : StrongLocallyConnectedOrd T p R) :
    (@FirstCountableTopology _ (strongPullTop p T) ∧ @ConnectedSpace _ (strongPullTop p T) ∧
        @LocPathConnectedSpace _ (strongPullTop p T)) ∧
      TopologicalSpace.induced (Subtype.val : (p ⁻¹' R) → MaxBranchedCover S y₀)
          (strongPullTop p T) =
        TopologicalSpace.induced (Subtype.val : (p ⁻¹' R) → MaxBranchedCover S y₀)
          (inferInstance : TopologicalSpace (MaxBranchedCover S y₀)) ∧
      @IsPortly _ (strongPullTop p T) (p ⁻¹' R) ∧
      (∀ γ ∈ deckGroup (SpreadEnd.base : MaxBranchedCover S y₀ → M),
        Continuous[strongPullTop p T, strongPullTop p T] γ) ∧
      @IsBranchedCovering _ _ (strongPullTop p T) T p := by
  obtain ⟨⟨hfc, hlpc⟩, hb, hc, hconn, hd⟩ :=
    spread_top_corrected hS hSc hrel y₀ hp hq.1 hqp hR hTle hT1 hT2 hTdeck hRT hRagree
  have hcR := hc.2 hH
  obtain ⟨hcs, he⟩ := hconn hRc
  exact ⟨⟨hfc, hcs, hlpc⟩, hb, hcR, hd hq, he hcR⟩

/-- `spread_top_of_local` with "`p⁻¹(R)` connected" replaced by "`R` portly in `N` for the natural
topology" (`isPreconnected_preimage_of_isPortly`), the form the paper's one application takes
(l.2096: `R = q⁻¹(reg V)`, naturally portly as the preimage by a branched covering of the portly
`reg V`, `IsBranchedCovering.isPortly_preimage`). -/
theorem spread_top_of_isPortly (hS : IsSkeletal S) (hSc : SemilocallySimplyConnected (Sᶜ : Set M))
    (hrel : IsSLSCInCC (Sᶜ : Set M)) (y₀ : (Sᶜ : Set M)) {p : MaxBranchedCover S y₀ → N}
    {q : N → M} (hp : IsBranchedCovering p) (hq : IsGaloisian q)
    (hqp : ∀ e, q (p e) = e.base) {R : Set N} (hR : R ⊆ ordY p) (hTle : T ≤ tN)
    (hT1 : @FirstCountableTopology N T) (hT2 : @LocPathConnectedSpace N T)
    (hTdeck : ∀ f ∈ @deckMapsOf N M tN q, Continuous[T, T] f) (hRT : @IsPortly N T R)
    (hRagree : TopologicalSpace.induced (Subtype.val : R → N) T =
      TopologicalSpace.induced (Subtype.val : R → N) tN)
    (hRw : IsPortly R) (hH : StrongLocallyConnectedOrd T p R) :
    (@FirstCountableTopology _ (strongPullTop p T) ∧ @ConnectedSpace _ (strongPullTop p T) ∧
        @LocPathConnectedSpace _ (strongPullTop p T)) ∧
      TopologicalSpace.induced (Subtype.val : (p ⁻¹' R) → MaxBranchedCover S y₀)
          (strongPullTop p T) =
        TopologicalSpace.induced (Subtype.val : (p ⁻¹' R) → MaxBranchedCover S y₀)
          (inferInstance : TopologicalSpace (MaxBranchedCover S y₀)) ∧
      @IsPortly _ (strongPullTop p T) (p ⁻¹' R) ∧
      (∀ γ ∈ deckGroup (SpreadEnd.base : MaxBranchedCover S y₀ → M),
        Continuous[strongPullTop p T, strongPullTop p T] γ) ∧
      @IsBranchedCovering _ _ (strongPullTop p T) T p :=
  spread_top_of_local hS hSc hrel y₀ hp hq hqp hR hTle hT1 hT2 hTdeck hRT hRagree
    (isPreconnected_preimage_of_isPortly hp hRw) hH

/-- **`rem:intuitively_spread_thinner_than`** (`RamcovGX.tex:2006`), closed under DEC-87(d), in
the lemma it accompanies: in the setting of `lem:spread_top` (its corrected form, DEC-80(c), `GX.spread_top_of_local`), the
remark's intuition holds — `p^*T` IS the coarsest topology on `\widetilde M^S`, among those finer
than the natural one, making `p : (\widetilde M^S, ·) → (N, T)` a spread: (e) makes `p` a
`p^*T`-branched covering, hence a spread (`GX.isGreatest_strongPullTop_of_isSpread`). This is
"Point (e) above is thus non-trivial" read forwards. -/
theorem intuitively_spread_thinner_of_local (hS : IsSkeletal S)
    (hSc : SemilocallySimplyConnected (Sᶜ : Set M))
    (hrel : IsSLSCInCC (Sᶜ : Set M)) (y₀ : (Sᶜ : Set M)) {p : MaxBranchedCover S y₀ → N}
    {q : N → M} (hp : IsBranchedCovering p) (hq : IsGaloisian q)
    (hqp : ∀ e, q (p e) = e.base) {R : Set N} (hR : R ⊆ ordY p) (hTle : T ≤ tN)
    (hT1 : @FirstCountableTopology N T) (hT2 : @LocPathConnectedSpace N T)
    (hTdeck : ∀ f ∈ @deckMapsOf N M tN q, Continuous[T, T] f) (hRT : @IsPortly N T R)
    (hRagree : TopologicalSpace.induced (Subtype.val : R → N) T =
      TopologicalSpace.induced (Subtype.val : R → N) tN)
    (hRc : IsPreconnected (p ⁻¹' R)) (hH : StrongLocallyConnectedOrd T p R) :
    IsGreatest {σ' : TopologicalSpace (MaxBranchedCover S y₀) |
        σ' ≤ SpreadEnd.instTopologicalSpace ∧ @IsSpread _ N σ' T p}
      (strongPullTop p T) :=
  isGreatest_strongPullTop_of_isSpread (@IsBranchedCovering.isSpread _ _ (strongPullTop p T) T p
    (spread_top_of_local hS hSc hrel y₀ hp hq hqp hR hTle hT1 hT2 hTdeck hRT hRagree hRc hH).2.2.2.2)

end CorrectedFull


/-! ### `rem:quotient_virtually_tame` -/

section QuotientDev

variable {N : Type*} {X : Type*} [tN : TopologicalSpace N] [TopologicalSpace X]

/-- `rem:quotient_virtually_tame` (`RamcovGX.tex:2154`), third item: the topology of `D(N)`
generated by that of `X` and the images by `D` of the open sets of `N`. -/
@[reducible] def devImageTop (D : N → X) : TopologicalSpace (range D) :=
  TopologicalSpace.induced Subtype.val ‹_› ⊓
    generateFrom {s | ∃ O : Set N, IsOpen O ∧ s = rangeFactorization D '' O}

/-- An injective continuous `D` is a homeomorphism `N ≃ D(N)` for `devImageTop`. -/
theorem exists_homeomorph_devImageTop {D : N → X} (hD : Injective D) (hDc : Continuous D) :
    ∃ h : @Homeomorph N (range D) tN (devImageTop D), ∀ n, (h n : X) = D n := by
  let e : N ≃ range D := Equiv.ofInjective D hD
  have he : ∀ n, e n = rangeFactorization D n := fun n => rfl
  have hinj : Injective (rangeFactorization D) := fun a b h => hD (congrArg Subtype.val h)
  refine ⟨@Homeomorph.mk N (range D) tN (devImageTop D) e ?_ ?_, fun n => rfl⟩
  · refine continuous_inf_rng.2 ⟨continuous_induced_rng.2 hDc, continuous_generateFrom_iff.2 ?_⟩
    rintro _ ⟨O, hO, rfl⟩
    have : e.toFun ⁻¹' (rangeFactorization D '' O) = O := by
      ext n; exact hinj.mem_set_image
    rw [this]; exact hO
  · refine @continuous_def (range D) N (devImageTop D) tN _ |>.2 fun O hO => ?_
    have : e.invFun ⁻¹' O = rangeFactorization D '' O := by
      ext x
      constructor
      · intro hx; exact ⟨e.symm x, hx, by rw [← he, Equiv.apply_symm_apply]⟩
      · rintro ⟨n, hn, rfl⟩
        show e.symm (rangeFactorization D n) ∈ O
        rw [← he, Equiv.symm_apply_apply]; exact hn
    rw [this]
    exact (TopologicalSpace.le_def.1 (inf_le_right : devImageTop D ≤ _)) _
      (TopologicalSpace.GenerateOpen.basic _ ⟨O, hO, rfl⟩)

/-- `rem:quotient_virtually_tame`, the topological core: let `π : N → M` be a continuous open
surjection whose fibres are the orbits of a set `Γ` of maps of `N`, and `D : N → X` continuous,
injective and `Γ`-equivariant through `ρ : Γ → G` (`D ∘ γ = ρ(γ) • D`, "`Γ` acts on `X` via the
holonomy of `D`"). Then `π ∘ D⁻¹ : D(N) → M` (`D(N)` with `devImageTop`) is a continuous open
surjection — a quotient map — whose fibres are the `ρ(Γ)`-orbits: `M ≅ Γ\D(N)`. -/
theorem quotient_dev {G : Type*} [Group G] [MulAction G X] {M : Type*} [TopologicalSpace M]
    {π : N → M} (hπc : Continuous π) (hπo : IsOpenMap π) (hπs : Surjective π)
    {Γ : Set (N → N)} (hfib : ∀ n n', π n = π n' ↔ ∃ γ ∈ Γ, γ n = n') {D : N → X}
    (hD : Injective D) (hDc : Continuous D) (ρ : (N → N) → G)
    (hρ : ∀ γ ∈ Γ, ∀ n, D (γ n) = ρ γ • D n) :
    ∃ f : range D → M, Continuous[devImageTop D, _] f ∧ @IsOpenMap _ M (devImageTop D) _ f ∧
      Surjective f ∧ (∀ n, f (rangeFactorization D n) = π n) ∧
      ∀ x x' : range D, f x = f x' ↔ ∃ γ ∈ Γ, ρ γ • (x : X) = x' := by
  obtain ⟨h, hh⟩ := exists_homeomorph_devImageTop hD hDc
  set hs := @Homeomorph.symm N (range D) tN (devImageTop D) h with hsdef
  have hhx : ∀ x : range D, D (hs x) = x := fun x => by
    rw [← hh, hsdef, @Homeomorph.apply_symm_apply N (range D) tN (devImageTop D) h x]
  have hsn : ∀ n, hs (rangeFactorization D n) = n := fun n => hD (by rw [hhx]; rfl)
  refine ⟨π ∘ hs, @Continuous.comp _ _ _ (devImageTop D) tN _ hs π hπc
      (@Homeomorph.continuous _ _ (devImageTop D) tN hs),
    @IsOpenMap.comp _ _ _ hs π (devImageTop D) tN _ hπo
      (@Homeomorph.isOpenMap _ _ (devImageTop D) tN hs),
    hπs.comp (@Homeomorph.surjective _ _ (devImageTop D) tN hs), fun n => ?_,
    fun x x' => ?_⟩
  · simp only [comp_apply, hsn]
  · simp only [comp_apply]
    rw [hfib]
    constructor
    · rintro ⟨γ, hγ, hγe⟩
      exact ⟨γ, hγ, by rw [← hhx x, ← hρ γ hγ, hγe, hhx]⟩
    · rintro ⟨γ, hγ, hγe⟩
      exact ⟨γ, hγ, hD (by rw [hρ γ hγ, hhx, hhx, hγe])⟩

end QuotientDev

section QuotientVirtTame

variable {G : Type*} {X : Type*} [TopologicalSpace X] [Group G] [MulAction G X]
  [ContinuousConstSMul G X] [LocallyConnectedSpace X] [T2Space X] [IsRigidAction G X]
  {M : Type u} [TopologicalSpace M] [SingularGXStructure G X M]

/-- The elements of `Γ(\widetilde M/M)` lie over `M`. -/
theorem deckMapsMax_base {y₀ : ((Sing G X M)ᶜ : Set M)} {γ : MaxBranchedCover (Sing G X M) y₀ →
    MaxBranchedCover (Sing G X M) y₀} (hγ : γ ∈ deckMapsMax G X M y₀) (e) : (γ e).base = e.base := by
  obtain ⟨φ, hφ, rfl⟩ := hγ
  exact deck_apply _ hφ e

/-- The inverse of an element of `Γ(\widetilde M/M)` is one. -/
theorem deckMapsMax_inv {y₀ : ((Sing G X M)ᶜ : Set M)} {γ : MaxBranchedCover (Sing G X M) y₀ →
    MaxBranchedCover (Sing G X M) y₀} (hγ : γ ∈ deckMapsMax G X M y₀) :
    ∃ γ' ∈ deckMapsMax G X M y₀, ∀ e, γ' (γ e) = e := by
  obtain ⟨φ, hφ, rfl⟩ := hγ
  exact ⟨_, ⟨φ⁻¹, inv_mem hφ, rfl⟩, fun e => φ.symm_apply_apply e⟩

/-- Galoisian, on maps: the fibres of `\widetilde M → M` are the `Γ(\widetilde M/M)`-orbits. -/
theorem deckMapsMax_transitive {y₀ : ((Sing G X M)ᶜ : Set M)}
    (hgal : IsGaloisian (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M))
    (e e' : MaxBranchedCover (Sing G X M) y₀) (h : e.base = e'.base) :
    ∃ γ ∈ deckMapsMax G X M y₀, γ e = e' := by
  obtain ⟨φ, hφ, hφe⟩ := hgal.2 e e' h
  exact ⟨φ, ⟨φ, hφ, rfl⟩, hφe⟩

/-- `rem:quotient_virtually_tame` (`RamcovGX.tex:2154`), for the maximal covering
`N = \widetilde M` with a tamifying topology `T` (`IsTamifyingTopology`): if `\widetilde M → M` is
Galoisian (its fibres are the `Γ`-orbits — ADDED, used; a narrowing, no counterexample is known;
the general `N` is `quotient_virtually_tame_cover`) and the `T`-continuous extension `D` of the developing map ((B)) is injective and
equivariant under `Γ(\widetilde M/M)` through its holonomy `ρ`, then `M ≅ Γ\D(\widetilde M)`: the
map `D(\widetilde M) → M`, `D(e) ↦ e.base`, is a continuous open surjection for the topology
generated by `X` and the `D`-images of `T` (`devImageTop`), with the `ρ(Γ)`-orbits as fibres.
`π` is `T`-open: a `T`-open `O` has `π⁻¹(π O) = ⋃ γ⁻¹(O)`, `T`-open by (C), and `T` induces the
topology of `M` (A). -/
theorem quotient_virtually_tame (y₀ : ((Sing G X M)ᶜ : Set M))
    (hgal : IsGaloisian (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M))
    {T : TopologicalSpace (MaxBranchedCover (Sing G X M) y₀)} (hT : IsTamifyingTopology G X M y₀ T)
    {D : MaxBranchedCover (Sing G X M) y₀ → X} (hDc : Continuous[T, _] D) (hD : Injective D)
    (ρ : (MaxBranchedCover (Sing G X M) y₀ → MaxBranchedCover (Sing G X M) y₀) → G)
    (hρ : ∀ γ ∈ deckMapsMax G X M y₀, ∀ e, D (γ e) = ρ γ • D e) :
    ∃ f : range D → M, Continuous[@devImageTop _ X T _ D, _] f ∧
      @IsOpenMap _ M (@devImageTop _ X T _ D) _ f ∧ Surjective f ∧
      (∀ e, f (rangeFactorization D e) = e.base) ∧
      ∀ x x' : range D, f x = f x' ↔ ∃ γ ∈ deckMapsMax G X M y₀, ρ γ • (x : X) = x' := by
  have hπs : Surjective (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M) :=
    @IsBranchedCovering.surjective _ _ (weakTopMax G X M y₀) _ _ hgal.1
  have hπc : Continuous[T, _] (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M) :=
    continuous_le_dom hT.le_natural (@IsSpread.continuous _ _ (weakTopMax G X M y₀) _ _
      (@IsBranchedCovering.isSpread _ _ (weakTopMax G X M y₀) _ _ hgal.1))
  have hfib : ∀ e e' : MaxBranchedCover (Sing G X M) y₀, e.base = e'.base ↔
      ∃ γ ∈ deckMapsMax G X M y₀, γ e = e' := by
    intro e e'
    refine ⟨deckMapsMax_transitive hgal e e', ?_⟩
    rintro ⟨γ, hγ, hγe⟩
    rw [← hγe, deckMapsMax_base hγ]
  have hopenM : ∀ U : Set M, IsOpen[T] ((SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M)
      ⁻¹' U) → IsOpen U := fun U hU => by
    have h : IsOpen[TopologicalSpace.coinduced (SpreadEnd.base :
        MaxBranchedCover (Sing G X M) y₀ → M) T] U := hU
    rwa [hT.coinduced_eq] at h
  have hπo : @IsOpenMap _ M T _ (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M) := by
    intro O hO
    refine hopenM _ ?_
    have : (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M) ⁻¹'
        (SpreadEnd.base '' O) = ⋃ γ ∈ deckMapsMax G X M y₀, γ ⁻¹' O := by
      ext e
      constructor
      · rintro ⟨e', he', hb⟩
        obtain ⟨γ, hγ, hγe⟩ := deckMapsMax_transitive hgal e' e hb
        obtain ⟨γ', hγ', hγ'γ⟩ := deckMapsMax_inv hγ
        refine mem_iUnion₂.2 ⟨γ', hγ', ?_⟩
        show γ' e ∈ O
        rw [← hγe, hγ'γ]; exact he'
      · intro he
        obtain ⟨γ, hγ, he⟩ := mem_iUnion₂.1 he
        exact ⟨γ e, he, deckMapsMax_base hγ e⟩
    rw [this]
    exact @isOpen_biUnion _ _ T _ _ fun γ hγ =>
      @Continuous.isOpen_preimage _ _ T T _ (hT.continuous_deck γ hγ) O hO
  exact @quotient_dev _ X T _ G _ _ M _ _ hπc hπo hπs _ hfib D hD hDc ρ hρ

end QuotientVirtTame

section QuotientVirtTameCover

variable {G : Type*} {X : Type*} [TopologicalSpace X] [Group G] [MulAction G X]
  [ContinuousConstSMul G X] [LocallyConnectedSpace X] [T2Space X] [IsRigidAction G X]
  {M : Type u} [TopologicalSpace M] [SingularGXStructure G X M]

/-- The projection `\widetilde M → M` is open for a tamifying topology `T`, when `\widetilde M → M`
is Galoisian: `π⁻¹(π O) = ⋃ γ⁻¹(O)`, `T`-open by (C), and `T` induces the topology of `M` (A). -/
theorem isOpenMap_base_of_isTamifying (y₀ : ((Sing G X M)ᶜ : Set M))
    (hgal : IsGaloisian (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M))
    {T : TopologicalSpace (MaxBranchedCover (Sing G X M) y₀)} (hT : IsTamifyingTopology G X M y₀ T) :
    @IsOpenMap _ M T _ (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M) := by
  have hopenM : ∀ U : Set M, IsOpen[T] ((SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M)
      ⁻¹' U) → IsOpen U := fun U hU => by
    have h : IsOpen[TopologicalSpace.coinduced (SpreadEnd.base :
        MaxBranchedCover (Sing G X M) y₀ → M) T] U := hU
    rwa [hT.coinduced_eq] at h
  intro O hO
  refine hopenM _ ?_
  have : (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M) ⁻¹'
      (SpreadEnd.base '' O) = ⋃ γ ∈ deckMapsMax G X M y₀, γ ⁻¹' O := by
    ext e
    constructor
    · rintro ⟨e', he', hb⟩
      obtain ⟨γ, hγ, hγe⟩ := deckMapsMax_transitive hgal e' e hb
      obtain ⟨γ', hγ', hγ'γ⟩ := deckMapsMax_inv hγ
      refine mem_iUnion₂.2 ⟨γ', hγ', ?_⟩
      show γ' e ∈ O
      rw [← hγe, hγ'γ]; exact he'
    · intro he
      obtain ⟨γ, hγ, he⟩ := mem_iUnion₂.1 he
      exact ⟨γ e, he, deckMapsMax_base hγ e⟩
  rw [this]
  exact @isOpen_biUnion _ _ T _ _ fun γ hγ =>
    @Continuous.isOpen_preimage _ _ T T _ (hT.continuous_deck γ hγ) O hO

variable {N : Type*} {y₀ : ((Sing G X M)ᶜ : Set M)}
  {Pj : MaxBranchedCover (Sing G X M) y₀ → N}

/-- The descent of `γ ∈ Γ(\widetilde M/M)` to `N` (`rem:quotient_virtually_tame`, the step the
remark leaves implicit): if `D : N → X` is injective and `D ∘ Π` is `Γ`-equivariant through `ρ`,
then `γ` descends through the surjection `Π : \widetilde M → N`: two points with the same image
have images by `γ` with the same `D`-value, hence the same image. -/
theorem exists_descend_of_injective (hPs : Surjective Pj) {D : N → X} (hD : Injective D)
    {ρ : (MaxBranchedCover (Sing G X M) y₀ → MaxBranchedCover (Sing G X M) y₀) → G}
    (hρ : ∀ γ ∈ deckMapsMax G X M y₀, ∀ e, D (Pj (γ e)) = ρ γ • D (Pj e))
    {γ : MaxBranchedCover (Sing G X M) y₀ → MaxBranchedCover (Sing G X M) y₀}
    (hγ : γ ∈ deckMapsMax G X M y₀) : ∃ f : N → N, ∀ e, f (Pj e) = Pj (γ e) := by
  choose s hs using hPs
  refine ⟨fun n => Pj (γ (s n)), fun e => hD ?_⟩
  show D (Pj (γ (s (Pj e)))) = D (Pj (γ e))
  rw [hρ γ hγ, hρ γ hγ, hs]

/-- The descents of `Γ(\widetilde M/M)` to `N` are deck transformations of `N → M` (for the
topology of `N`) as soon as `Π : \widetilde M → N` is a continuous open surjection over `M`
(e.g. a branched covering): so `N → M` is Galoisian when `\widetilde M → M` is. -/
theorem descend_mem_deckMapsOf [tN : TopologicalSpace N] {πN : N → M}
    (hPs : Surjective Pj) (hPc : Continuous[weakTopMax G X M y₀, tN] Pj)
    (hPo : @IsOpenMap _ N (weakTopMax G X M y₀) tN Pj) (hpP : ∀ e, πN (Pj e) = e.base)
    {D : N → X} (hD : Injective D)
    {ρ : (MaxBranchedCover (Sing G X M) y₀ → MaxBranchedCover (Sing G X M) y₀) → G}
    (hρ : ∀ γ ∈ deckMapsMax G X M y₀, ∀ e, D (Pj (γ e)) = ρ γ • D (Pj e))
    {γ : MaxBranchedCover (Sing G X M) y₀ → MaxBranchedCover (Sing G X M) y₀}
    (hγ : γ ∈ deckMapsMax G X M y₀) {f : N → N} (hf : ∀ e, f (Pj e) = Pj (γ e)) :
    f ∈ deckMapsOf πN := by
  have hq : @IsOpenQuotientMap _ N (weakTopMax G X M y₀) tN Pj := ⟨hPs, hPc, hPo⟩
  obtain ⟨φ, hφ, rfl⟩ := hγ
  have hφ' : ⇑φ.symm ∈ deckMapsMax G X M y₀ := ⟨φ⁻¹, inv_mem hφ, rfl⟩
  obtain ⟨f', hf'⟩ := exists_descend_of_injective hPs hD hρ hφ'
  have h1 : ∀ n, f (f' n) = n := fun n => by
    obtain ⟨e, rfl⟩ := hPs n
    rw [hf', hf, Homeomorph.apply_symm_apply]
  have h2 : ∀ n, f' (f n) = n := fun n => by
    obtain ⟨e, rfl⟩ := hPs n
    rw [hf, hf', Homeomorph.symm_apply_apply]
  have hfc : Continuous f := by
    refine (@IsOpenQuotientMap.continuous_comp_iff _ N N (weakTopMax G X M y₀) tN tN Pj hq f).1 ?_
    have : f ∘ Pj = Pj ∘ φ := funext hf
    rw [this]
    exact @Continuous.comp _ _ _ (weakTopMax G X M y₀) (weakTopMax G X M y₀) tN _ _ hPc
      (@Homeomorph.continuous _ _ (weakTopMax G X M y₀) (weakTopMax G X M y₀) φ)
  have hf'c : Continuous f' := by
    refine (@IsOpenQuotientMap.continuous_comp_iff _ N N (weakTopMax G X M y₀) tN tN Pj hq f').1 ?_
    have : f' ∘ Pj = Pj ∘ φ.symm := funext hf'
    rw [this]
    exact @Continuous.comp _ _ _ (weakTopMax G X M y₀) (weakTopMax G X M y₀) tN _ _ hPc
      (@Homeomorph.continuous _ _ (weakTopMax G X M y₀) (weakTopMax G X M y₀) φ.symm)
  refine ⟨⟨⟨f, f', h2, h1⟩, hfc, hf'c⟩, ?_, rfl⟩
  show πN ∘ f = πN
  funext n
  obtain ⟨e, rfl⟩ := hPs n
  show πN (f (Pj e)) = πN (Pj e)
  rw [hf, hpP, hpP]
  exact deckMapsMax_base ⟨φ, hφ, rfl⟩ e

/-- The descents to `N` of the elements of `Γ(\widetilde M/M)`. -/
def descendSet (Pj : MaxBranchedCover (Sing G X M) y₀ → N) : Set (N → N) :=
  {f | ∃ γ ∈ deckMapsMax G X M y₀, ∀ e, f (Pj e) = Pj (γ e)}

open Classical in
/-- The holonomy of a descent: `ρ` of a chosen lift. -/
def descendHol (Pj : MaxBranchedCover (Sing G X M) y₀ → N)
    (ρ : (MaxBranchedCover (Sing G X M) y₀ → MaxBranchedCover (Sing G X M) y₀) → G)
    (f : N → N) : G :=
  if h : ∃ γ ∈ deckMapsMax G X M y₀, ∀ e, f (Pj e) = Pj (γ e) then ρ h.choose else 1

/-- `rem:quotient_virtually_tame` (`RamcovGX.tex:2154`), for a general branched covering
`N → M` dominated by `\widetilde M` (`Pj : \widetilde M → N` onto, over `M`), with `N` endowed
with the quotient `Pj_* T` of a tamifying topology `T` (the remark's second item): if
`\widetilde M → M` is Galoisian (ADDED, used: it is what makes the fibres of `N → M` orbits) and
`D : N → X` is `Pj_* T`-continuous, injective, and `D ∘ Pj` is `Γ(\widetilde M/M)`-equivariant
through its holonomy `ρ` (the remark's first item), then the elements of `Γ(\widetilde M/M)`
descend to `N` (the set `Γ_N = descendSet`, with holonomy `descendHol`), the fibres of `N → M`
are the `Γ_N`-orbits, and `D(N) → M`, `D(n) ↦ π_N(n)`, is a continuous open surjection for the
topology generated by `X` and the `D`-images of `Pj_* T` (the third item), with the
`ρ(Γ_N)`-orbits as fibres: `M ≅ Γ_N\D(N)`. That `Γ_N ⊆ Γ(N/M)` is `descend_mem_deckMapsOf`. -/
theorem quotient_virtually_tame_cover (y₀ : ((Sing G X M)ᶜ : Set M))
    (hgal : IsGaloisian (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M))
    {T : TopologicalSpace (MaxBranchedCover (Sing G X M) y₀)} (hT : IsTamifyingTopology G X M y₀ T)
    {N : Type*} {Pj : MaxBranchedCover (Sing G X M) y₀ → N} (hPs : Surjective Pj) {πN : N → M}
    (hpP : ∀ e, πN (Pj e) = e.base) {D : N → X}
    (hDc : Continuous[TopologicalSpace.coinduced Pj T, _] D) (hD : Injective D)
    (ρ : (MaxBranchedCover (Sing G X M) y₀ → MaxBranchedCover (Sing G X M) y₀) → G)
    (hρ : ∀ γ ∈ deckMapsMax G X M y₀, ∀ e, D (Pj (γ e)) = ρ γ • D (Pj e)) :
    (∀ γ ∈ deckMapsMax G X M y₀, ∃ f ∈ descendSet Pj, ∀ e, f (Pj e) = Pj (γ e)) ∧
    (∀ f ∈ descendSet Pj, ∀ n, D (f n) = descendHol Pj ρ f • D n) ∧
    (∀ n n', πN n = πN n' ↔ ∃ f ∈ descendSet Pj, f n = n') ∧
    ∃ f : range D → M, Continuous[@devImageTop _ X (TopologicalSpace.coinduced Pj T) _ D, _] f ∧
      @IsOpenMap _ M (@devImageTop _ X (TopologicalSpace.coinduced Pj T) _ D) _ f ∧ Surjective f ∧
      (∀ n, f (rangeFactorization D n) = πN n) ∧
      ∀ x x' : range D, f x = f x' ↔
        ∃ g ∈ descendSet Pj, descendHol Pj ρ g • (x : X) = x' := by
  have hdesc : ∀ γ ∈ deckMapsMax G X M y₀, ∃ f ∈ descendSet Pj, ∀ e, f (Pj e) = Pj (γ e) :=
    fun γ hγ => by
      obtain ⟨f, hf⟩ := exists_descend_of_injective hPs hD hρ hγ
      exact ⟨f, ⟨γ, hγ, hf⟩, hf⟩
  have hhol : ∀ f ∈ descendSet Pj, ∀ n, D (f n) = descendHol Pj ρ f • D n := by
    intro f hf n
    obtain ⟨e, rfl⟩ := hPs n
    have hex : ∃ γ ∈ deckMapsMax G X M y₀, ∀ e, f (Pj e) = Pj (γ e) := hf
    rw [descendHol, dif_pos hex, hex.choose_spec.2 e, hρ _ hex.choose_spec.1]
  have hfib : ∀ n n', πN n = πN n' ↔ ∃ f ∈ descendSet Pj, f n = n' := by
    intro n n'
    obtain ⟨e, rfl⟩ := hPs n
    obtain ⟨e', rfl⟩ := hPs n'
    rw [hpP, hpP]
    constructor
    · intro hb
      obtain ⟨γ, hγ, hγe⟩ := deckMapsMax_transitive hgal e e' hb
      obtain ⟨f, hf, hfe⟩ := hdesc γ hγ
      exact ⟨f, hf, by rw [hfe, hγe]⟩
    · rintro ⟨f, ⟨γ, hγ, hfγ⟩, hfe⟩
      have h1 := congrArg πN hfe
      rw [hfγ, hpP, hpP, deckMapsMax_base hγ e] at h1
      exact h1
  have hπs : Surjective πN := fun m => by
    obtain ⟨e, he⟩ := @IsBranchedCovering.surjective _ _ (weakTopMax G X M y₀) _ _ hgal.1 m
    exact ⟨Pj e, by rw [hpP, he]⟩
  have hbc : Continuous[T, _] (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M) :=
    continuous_le_dom hT.le_natural (@IsSpread.continuous _ _ (weakTopMax G X M y₀) _ _
      (@IsBranchedCovering.isSpread _ _ (weakTopMax G X M y₀) _ _ hgal.1))
  have hπc : Continuous[TopologicalSpace.coinduced Pj T, _] πN := by
    rw [continuous_coinduced_dom]
    have : πN ∘ Pj = SpreadEnd.base := funext hpP
    rw [this]; exact hbc
  have hbo := isOpenMap_base_of_isTamifying y₀ hgal hT
  have hπo : @IsOpenMap N M (TopologicalSpace.coinduced Pj T) _ πN := by
    intro O hO
    have hO' : IsOpen[T] (Pj ⁻¹' O) := hO
    have : πN '' O = SpreadEnd.base '' (Pj ⁻¹' O) := by
      conv_lhs => rw [← image_preimage_eq O hPs, ← image_comp]
      rw [show πN ∘ Pj = SpreadEnd.base from funext hpP]
    rw [this]; exact hbo _ hO'
  exact ⟨hdesc, hhol, hfib, @quotient_dev N X (TopologicalSpace.coinduced Pj T) _ G _ _ M _ _ hπc
    hπo hπs _ hfib D hD hDc (descendHol Pj ρ) hhol⟩

/-- `rem:quotient_virtually_tame` with the added hypothesis of `quotient_virtually_tame_cover`
discharged from a checkable condition on `M` (WP-35g): `\widetilde M → M` is Galoisian as soon as
`reg M` is semi-locally simply connected in `M` (`prop:Galoisian_semilocal`,
`GX.maxBranched_isGaloisian_cc`) — the case `U = M` of `def:singular_manifold_locally_galoisian`
(`GX.IsLocallyGaloisian`) — and as a space (`hSc`, under which the library builds `\widetilde M`).
`M` Hausdorff, locally path-connected, first countable, connected: the standing hypotheses of
DEC-66. -/
theorem quotient_virtually_tame_cover_of_slsc [T2Space M] [LocPathConnectedSpace M]
    [FirstCountableTopology M] [ConnectedSpace M] (y₀ : ((Sing G X M)ᶜ : Set M))
    (hSc : SemilocallySimplyConnected ((Sing G X M)ᶜ : Set M))
    (hrel : IsSLSCInCC ((Sing G X M)ᶜ : Set M))
    {T : TopologicalSpace (MaxBranchedCover (Sing G X M) y₀)} (hT : IsTamifyingTopology G X M y₀ T)
    {N : Type*} {Pj : MaxBranchedCover (Sing G X M) y₀ → N} (hPs : Surjective Pj) {πN : N → M}
    (hpP : ∀ e, πN (Pj e) = e.base) {D : N → X}
    (hDc : Continuous[TopologicalSpace.coinduced Pj T, _] D) (hD : Injective D)
    (ρ : (MaxBranchedCover (Sing G X M) y₀ → MaxBranchedCover (Sing G X M) y₀) → G)
    (hρ : ∀ γ ∈ deckMapsMax G X M y₀, ∀ e, D (Pj (γ e)) = ρ γ • D (Pj e)) :
    (∀ γ ∈ deckMapsMax G X M y₀, ∃ f ∈ descendSet Pj, ∀ e, f (Pj e) = Pj (γ e)) ∧
    (∀ f ∈ descendSet Pj, ∀ n, D (f n) = descendHol Pj ρ f • D n) ∧
    (∀ n n', πN n = πN n' ↔ ∃ f ∈ descendSet Pj, f n = n') ∧
    ∃ f : range D → M, Continuous[@devImageTop _ X (TopologicalSpace.coinduced Pj T) _ D, _] f ∧
      @IsOpenMap _ M (@devImageTop _ X (TopologicalSpace.coinduced Pj T) _ D) _ f ∧ Surjective f ∧
      (∀ n, f (rangeFactorization D n) = πN n) ∧
      ∀ x x' : range D, f x = f x' ↔
        ∃ g ∈ descendSet Pj, descendHol Pj ρ g • (x : X) = x' :=
  quotient_virtually_tame_cover y₀
    (maxBranched_isGaloisian_cc (isSkeletal_sing G X M) hSc y₀ hrel) hT hPs hpP hDc hD ρ hρ

end QuotientVirtTameCover

/-! ### `rem:quotient_virtually_tame` for a Galoisian `N → M` (WP-40d, the DEC-71 reading) -/

section QuotientVirtTameGal

/-- Every element of `Γ(N/M)` lifts to `Γ(\widetilde M^S/M)` through any continuous surjection
`Pj : \widetilde M^S → N` over `M` (`N → M` a branched covering, `N` Hausdorff): `Γ` is
transitive on the regular fibres of `\widetilde M^S` (`GX.maxBranched_transitive`) and two lifts
of the projection agreeing at one point over `ord(N → M)` agree (`GX.eq_of_comp_eq_of_mem_portly`). -/
theorem exists_deck_lift_maxBranched {M : Type u} [TopologicalSpace M] [T2Space M]
    [LocPathConnectedSpace M] [FirstCountableTopology M] [ConnectedSpace M] {S : Set M}
    (hS : IsSkeletal S) (hSc : SemilocallySimplyConnected (Sᶜ : Set M)) (y₀ : (Sᶜ : Set M))
    {N : Type v} [TopologicalSpace N] [T2Space N] {Pj : MaxBranchedCover S y₀ → N}
    (hPc : Continuous Pj) (hPs : Surjective Pj) {πN : N → M} (hπN : IsBranchedCovering πN)
    (hpP : ∀ e, πN (Pj e) = e.base) {f : N ≃ₜ N} (hf : f ∈ deckGroup πN) :
    ∃ γ ∈ deckGroup (SpreadEnd.base : MaxBranchedCover S y₀ → M), ∀ e, Pj (γ e) = f (Pj e) := by
  obtain ⟨-, hβbc, -, -, -, -⟩ := maxBranched_basic hS hSc y₀
  have hO : IsPortly (ordY πN ∩ Sᶜ) := hπN.isPortly_ordY.inter (isSkeletal_iff.1 hS)
  haveI : Nonempty M := ⟨y₀.1⟩
  obtain ⟨y, hy⟩ := hO.dense.nonempty
  obtain ⟨e₀, he₀⟩ := hβbc.surjective y
  obtain ⟨e₁, he₁⟩ := hPs (f (Pj e₀))
  have hfib : e₀.base = e₁.base := by
    rw [← hpP e₁, he₁, deck_apply _ hf, hpP]
  obtain ⟨γ, hγ, hγe⟩ := maxBranched_transitive hS hSc y₀ e₀ e₁ hfib
    (by show e₀.base ∈ Sᶜ; rw [show e₀.base = y from he₀]; exact hy.2)
  refine ⟨γ, hγ, fun e => ?_⟩
  have := eq_of_comp_eq_of_mem_portly hβbc hπN hO inter_subset_left
    (hPc.comp γ.continuous) (f.continuous.comp hPc)
    (fun z => by simp only [comp_apply]; rw [hpP, deck_apply _ hγ])
    (fun z => by simp only [comp_apply]; rw [deck_apply _ hf, hpP]) (z₀ := e₀)
    (by show e₀.base ∈ _; rw [show e₀.base = y from he₀]; exact hy)
    (by simp only [comp_apply]; rw [hγe, he₁])
  exact congrFun this e

variable {G : Type*} {X : Type*} [TopologicalSpace X] [Group G] [MulAction G X]
  [ContinuousConstSMul G X] [LocallyConnectedSpace X] [T2Space X] [IsRigidAction G X]
  {M : Type u} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
  [FirstCountableTopology M] [ConnectedSpace M] [SingularGXStructure G X M]

/-- For `N → M` Galoisian and `Pj : \widetilde M → N` a continuous surjection over `M`:
`π⁻¹(π_N(O)) = ⋃_{γ ∈ Γ(\widetilde M/M)} γ⁻¹(Pj⁻¹ O)` (the lifts of `Γ(N/M)`,
`exists_deck_lift_maxBranched`, reach every point of the fibre). -/
theorem base_preimage_image_galoisian (y₀ : ((Sing G X M)ᶜ : Set M))
    (hSc : SemilocallySimplyConnected ((Sing G X M)ᶜ : Set M))
    {N : Type v} [TopologicalSpace N] [T2Space N] {Pj : MaxBranchedCover (Sing G X M) y₀ → N}
    (hPc : Continuous Pj) (hPs : Surjective Pj) {πN : N → M} (hπN : IsGaloisian πN)
    (hpP : ∀ e, πN (Pj e) = e.base) (O : Set N) :
    (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M) ⁻¹' (πN '' O) =
      ⋃ g ∈ deckMapsMax G X M y₀, g ⁻¹' (Pj ⁻¹' O) := by
  ext e
  simp only [mem_preimage, mem_image, mem_iUnion]
  constructor
  · rintro ⟨n, hn, hne⟩
    obtain ⟨f, hf, hfn⟩ := hπN.2 n (Pj e) (by rw [hne, hpP])
    obtain ⟨f', hf', hf'n⟩ := hπN.2 (Pj e) n (by rw [hne, hpP])
    obtain ⟨γ, hγ, hγe⟩ := exists_deck_lift_maxBranched (isSkeletal_sing G X M) hSc y₀ hPc hPs
      hπN.1 hpP hf'
    exact ⟨γ, ⟨γ, hγ, rfl⟩, by rw [hγe, hf'n]; exact hn⟩
  · rintro ⟨g, hg, he⟩
    exact ⟨_, he, by rw [hpP, deckMapsMax_base hg]⟩

/-- `rem:quotient_virtually_tame` (`RamcovGX.tex:2154`) for a **Galoisian** branched covering
`N → M` (the reading DEC-71 rules for its twin `rem:tamely_singular_manifold_admits`, l.1869;
DEC-66 for `M`): let `T` be a tamifying topology on `\widetilde M`, `Pj : \widetilde M → N` a
continuous surjection over `M` (the universal map, `quotient_virtually_tame_galoisian'`), `N`
endowed with the quotient `Pj_* T` of `T` (second item), `D : N → X` injective and
`Pj_* T`-continuous with holonomy `ρ : Γ(N/M) → G` (first item, `D ∘ γ = ρ(γ) D`). Then `M` is
homeomorphic to `Γ(N/M)\D(N)`, `D(N)` with the topology generated by that of `X` and the
`D`-images of the open sets of `Pj_* T` (third item, `devImageTop`), by `[D n] ↦ π_N(n)`.
`π_N` is open for `Pj_* T`: `π⁻¹ π_N(O) = ⋃_f L_f(Pj⁻¹ O)` over lifts `L_f ∈ Γ(\widetilde M/M)`
of the `f ∈ Γ(N/M)` (`exists_deck_lift_maxBranched`), `T`-open by (C), and (A) concludes. No
Galoisian hypothesis on `\widetilde M → M`. -/
theorem quotient_virtually_tame_galoisian (y₀ : ((Sing G X M)ᶜ : Set M))
    (hSc : SemilocallySimplyConnected ((Sing G X M)ᶜ : Set M))
    {N : Type v} [tN : TopologicalSpace N] [T2Space N] {Pj : MaxBranchedCover (Sing G X M) y₀ → N}
    (hPc : Continuous Pj) (hPs : Surjective Pj) {πN : N → M} (hπN : IsGaloisian πN)
    (hpP : ∀ e, πN (Pj e) = e.base)
    {T : TopologicalSpace (MaxBranchedCover (Sing G X M) y₀)} (hT : IsTamifyingTopology G X M y₀ T)
    {D : N → X}
    (hDc : Continuous[TopologicalSpace.coinduced Pj T, _] D) (hD : Injective D)
    {ρ : Deck πN →* G} (hρ : IsHolonomyOf πN D ρ) :
    letI : TopologicalSpace (range D) := @devImageTop N X (TopologicalSpace.coinduced Pj T) _ D
    ∃ h : Quotient (tameHolonomyOrbitSetoid πN D ρ) ≃ₜ M,
      ∀ n, h (Quotient.mk _ ⟨D n, n, rfl⟩) = πN n := by
  have hS : IsSkeletal (Sing G X M) := isSkeletal_sing G X M
  -- `π_N` is continuous and open for `Pj_* T`
  have hbc : Continuous[T, _] (SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M) :=
    continuous_le_dom hT.le_natural (@IsSpread.continuous _ _ (weakTopMax G X M y₀) _ _
      (@IsBranchedCovering.isSpread _ _ (weakTopMax G X M y₀) _ _
        (maxBranched_basic hS hSc y₀).2.1))
  have hπc : Continuous[TopologicalSpace.coinduced Pj T, _] πN := by
    rw [continuous_coinduced_dom]
    have : πN ∘ Pj = SpreadEnd.base := funext hpP
    rw [this]; exact hbc
  have hopenM : ∀ U : Set M, IsOpen[T] ((SpreadEnd.base : MaxBranchedCover (Sing G X M) y₀ → M) ⁻¹' U) →
      IsOpen U := fun U hU => by
    have h : IsOpen[TopologicalSpace.coinduced (SpreadEnd.base :
        MaxBranchedCover (Sing G X M) y₀ → M) T] U := hU
    rwa [hT.coinduced_eq] at h
  have hπo : @IsOpenMap N M (TopologicalSpace.coinduced Pj T) _ πN := by
    intro O hO
    have hO' : IsOpen[T] (Pj ⁻¹' O) := hO
    refine hopenM _ ?_
    rw [base_preimage_image_galoisian y₀ hSc hPc hPs hπN hpP O]
    exact @isOpen_biUnion _ _ T _ _ fun g hg =>
      @Continuous.isOpen_preimage _ _ T T _ (hT.continuous_deck g hg) _ hO'
  have hfib : ∀ n n', πN n = πN n' ↔ ∃ g ∈ deckMapsOf πN, g n = n' := by
    intro n n'
    constructor
    · intro h
      obtain ⟨φ, hφ, hφn⟩ := hπN.2 n n' h
      exact ⟨φ, ⟨φ, hφ, rfl⟩, hφn⟩
    · rintro ⟨_, ⟨φ, hφ, rfl⟩, hφn⟩
      rw [← hφn, deck_apply _ hφ]
  -- the holonomy, on maps
  set ρ' : (N → N) → G := fun g => if h : ∃ γ : Deck πN, ⇑(γ : N ≃ₜ N) = g then ρ h.choose else 1
  have hρ'eq : ∀ γ : Deck πN, ρ' ⇑(γ : N ≃ₜ N) = ρ γ := by
    intro γ
    have hex : ∃ γ' : Deck πN, ⇑(γ' : N ≃ₜ N) = ⇑(γ : N ≃ₜ N) := ⟨γ, rfl⟩
    simp only [ρ', dif_pos hex]
    congr 1
    exact Subtype.ext (Homeomorph.ext fun x => congrFun hex.choose_spec x)
  have hρ' : ∀ g ∈ deckMapsOf πN, ∀ n, D (g n) = ρ' g • D n := by
    rintro _ ⟨φ, hφ, rfl⟩ n
    rw [show (φ : N → N) = ⇑((⟨φ, hφ⟩ : Deck πN) : N ≃ₜ N) from rfl, hρ'eq]
    exact hρ ⟨φ, hφ⟩ n
  obtain ⟨f, hfc, hfo, hfs, hfD, hff⟩ := @quotient_dev N X (TopologicalSpace.coinduced Pj T) _ G _ _
    M _ _ hπc hπo hπN.1.surjective _ hfib D hD hDc ρ' hρ'
  letI : TopologicalSpace (range D) := @devImageTop N X (TopologicalSpace.coinduced Pj T) _ D
  letI := tameHolonomyOrbitSetoid πN D ρ
  have hresp : ∀ a b : range D, a ≈ b → f a = f b := by
    rintro a b ⟨γ, hγ⟩
    refine (hff a b).2 ⟨_, ⟨γ, γ.2, rfl⟩, ?_⟩
    rw [hρ'eq, hγ]
  set F : Quotient (tameHolonomyOrbitSetoid πN D ρ) → M := Quotient.lift f hresp
  have hFc : Continuous F := hfc.quotient_lift hresp
  have hFinj : Injective F := by
    rintro ⟨a⟩ ⟨b⟩ hab
    obtain ⟨_, ⟨φ, hφ, rfl⟩, hφe⟩ := (hff a b).1 hab
    refine Quotient.sound ⟨⟨φ, hφ⟩, ?_⟩
    rw [← hφe, ← hρ'eq]
  have hFs : Surjective F := fun m => by
    obtain ⟨a, ha⟩ := hfs m
    exact ⟨Quotient.mk _ a, ha⟩
  have hFo : IsOpenMap F := fun O hO => by
    have : F '' O = f '' (Quotient.mk _ ⁻¹' O) := by
      ext m
      constructor
      · rintro ⟨q, hq, rfl⟩
        induction q using Quotient.inductionOn with
        | h a => exact ⟨a, hq, rfl⟩
      · rintro ⟨a, ha, rfl⟩
        exact ⟨Quotient.mk _ a, ha, rfl⟩
    rw [this]
    exact hfo _ (hO.preimage continuous_quotient_mk')
  exact ⟨(Equiv.ofBijective F ⟨hFinj, hFs⟩).toHomeomorphOfContinuousOpen hFc hFo, fun n => hfD n⟩

/-- **`rem:quotient_virtually_tame`** (`RamcovGX.tex:2154`), closed under DEC-87(c) (`N → M`
Galoisian, DEC-71 extended; "isomorphic" = homeomorphic): `quotient_virtually_tame_galoisian` with
`Pj` the universal map: for every Galoisian branched covering `N → M` possibly branched over `sing M` (`N` Hausdorff, locally path-connected, first countable),
`\widetilde M` maps onto `N` over `M` (`prop:universality`, `GX.maxBranched_universal`), and the
conclusion holds for `N` with the quotient of `T` by that map. -/
theorem quotient_virtually_tame_galoisian' (y₀ : ((Sing G X M)ᶜ : Set M))
    (hSc : SemilocallySimplyConnected ((Sing G X M)ᶜ : Set M))
    {T : TopologicalSpace (MaxBranchedCover (Sing G X M) y₀)} (hT : IsTamifyingTopology G X M y₀ T)
    {N : Type v} [TopologicalSpace N] [T2Space N] [LocPathConnectedSpace N]
    [FirstCountableTopology N] {πN : N → M} (hπN : IsGaloisian πN)
    (hπS : IsPossiblyBranchedOver πN (Sing G X M)) :
    ∃ Pj : MaxBranchedCover (Sing G X M) y₀ → N, Continuous[weakTopMax G X M y₀, _] Pj ∧
      (∀ e, πN (Pj e) = e.base) ∧ @IsBranchedCovering _ _ (weakTopMax G X M y₀) _ Pj ∧
      ∀ {D : N → X}, Continuous[TopologicalSpace.coinduced Pj T, _] D →
        Injective D → ∀ {ρ : Deck πN →* G}, IsHolonomyOf πN D ρ →
        letI : TopologicalSpace (range D) :=
          @devImageTop N X (TopologicalSpace.coinduced Pj T) _ D
        ∃ h : Quotient (tameHolonomyOrbitSetoid πN D ρ) ≃ₜ M,
          ∀ n, h (Quotient.mk _ ⟨D n, n, rfl⟩) = πN n := by
  obtain ⟨Pj, hPc, hpP, hPbc, -⟩ :=
    maxBranched_universal (isSkeletal_sing G X M) hSc y₀ hπN.1 hπS
  exact ⟨Pj, hPc, hpP, hPbc, fun hDc hD _ hρ =>
    quotient_virtually_tame_galoisian y₀ hSc hPc
      (@IsBranchedCovering.surjective _ _ (weakTopMax G X M y₀) _ _ hPbc) hπN hpP hT hDc hD hρ⟩

end QuotientVirtTameGal

/-! ### `rem:hypothesis_model_spaces_necessary`: the "messed up" topology -/

section Mixed

variable {Y : Type*} {T : TopologicalSpace Y} [τ : TopologicalSpace Y]

variable (T) in
/-- `rem:hypothesis_model_spaces_necessary` (`RamcovGX.tex:2141`): the topology generated by the
natural one and the restriction of `T` to `V` (the paper's `V = {t > 0}`). -/
@[reducible] def mixedTop (V : Set Y) : TopologicalSpace Y :=
  τ ⊓ generateFrom {s | ∃ O : Set Y, IsOpen[T] O ∧ s = O ∩ V}

/-- `T ≤ T' ≤ τ`: the mixed topology lies between `T` and the natural one. -/
theorem le_mixedTop (hT : T ≤ τ) {V : Set Y} (hV : IsOpen V) :
    T ≤ mixedTop T V ∧ mixedTop T V ≤ τ := by
  refine ⟨le_inf hT (le_generateFrom ?_), inf_le_left⟩
  rintro _ ⟨O, hO, rfl⟩
  exact @IsOpen.inter Y T _ _ hO (isOpen_of_le_sptop hT hV)

/-- Over `V`, `T'` is `T`. -/
theorem nhds_mixedTop_of_mem (hT : T ≤ τ) {V : Set Y} (hV : IsOpen V) {y : Y} (hy : y ∈ V) :
    @nhds Y (mixedTop T V) y = @nhds Y T y := by
  refine le_antisymm ?_ (nhds_mono (le_mixedTop hT hV).1)
  refine (@le_nhds_iff Y T y _).2 fun O hyO hO => ?_
  have hOV : IsOpen[mixedTop T V] (O ∩ V) :=
    (TopologicalSpace.le_def.1 (inf_le_right : mixedTop T V ≤ _)) _
      (TopologicalSpace.GenerateOpen.basic _ ⟨O, hO, rfl⟩)
  exact Filter.mem_of_superset (@IsOpen.mem_nhds Y (mixedTop T V) _ _ hOV ⟨hyO, hy⟩)
    inter_subset_left

/-- Off `V`, `T'` is the natural topology. -/
theorem nhds_mixedTop_of_notMem {V : Set Y} {y : Y} (hy : y ∉ V) :
    @nhds Y (mixedTop T V) y = @nhds Y τ y := by
  rw [nhds_inf, TopologicalSpace.nhds_generateFrom]
  have : {s | y ∈ s ∧ s ∈ {s | ∃ O : Set Y, IsOpen[T] O ∧ s = O ∩ V}} = ∅ := by
    ext s
    simp only [mem_setOf_eq, mem_empty_iff_false, iff_false, not_and]
    rintro hys ⟨O, -, rfl⟩
    exact hy hys.2
  rw [this]
  simp only [mem_empty_iff_false, iInf_of_empty, iInf_top, inf_top_eq]

/-- "Since the Galois group acts by 'rotation' around the 'axis' it preserves `T'`": a
homeomorphism which is `T`-continuous and preserves `V` is `T'`-continuous. -/
theorem continuous_mixedTop_of_preimage_eq (γ : Y ≃ₜ Y) (hγT : Continuous[T, T] γ) {V : Set Y}
    (hγV : γ ⁻¹' V = V) : Continuous[mixedTop T V, mixedTop T V] γ := by
  refine continuous_inf_rng.2 ⟨continuous_le_dom inf_le_left γ.continuous,
    continuous_generateFrom_iff.2 ?_⟩
  rintro _ ⟨O, hO, rfl⟩
  rw [preimage_inter, hγV]
  exact (TopologicalSpace.le_def.1 (inf_le_right : mixedTop T V ≤ _)) _
    (TopologicalSpace.GenerateOpen.basic _ ⟨_, @Continuous.isOpen_preimage Y Y T T γ hγT O hO, rfl⟩)

/-- "The automorphism group also contains translations … which send points from `t < 0` to
`t > 0`": a homeomorphism `ψ` sending a point `y ∉ V` to a point of `V` at which `T` is strictly
finer than the natural topology is not `T'`-continuous. -/
theorem not_continuous_mixedTop (hT : T ≤ τ) {V : Set Y} (hV : IsOpen V) (ψ : Y ≃ₜ Y) {y : Y}
    (hy : y ∉ V) (hψy : ψ y ∈ V) (hne : @nhds Y T (ψ y) ≠ @nhds Y τ (ψ y)) :
    ¬ Continuous[mixedTop T V, mixedTop T V] ψ := by
  intro hc
  have h1 := @Continuous.tendsto Y Y (mixedTop T V) (mixedTop T V) ψ hc y
  rw [nhds_mixedTop_of_notMem hy, nhds_mixedTop_of_mem hT hV hψy] at h1
  have h2 : @nhds Y τ (ψ y) ≤ @nhds Y T (ψ y) := by
    rw [← Homeomorph.map_nhds_eq]; exact h1
  exact hne (le_antisymm (nhds_mono hT) h2)

/-- `rem:hypothesis_model_spaces_necessary` (`RamcovGX.tex:2137`), the mechanism, abstractly:
for `T` finer than the natural topology and `V` open, the topology `T'` generated by the natural
one and `T` restricted to `V` lies between them, is `T` on `V` and natural off `V`, is preserved
by every `T`-continuous homeomorphism preserving `V` (the Galois group, acting by rotations), and
is NOT preserved by a homeomorphism moving a point off `V` to a point of `V` at which `T` is
strictly finer (the time translations). So `Γ`-invariance of a tamifying topology does not give
`Aut`-invariance, which is what `theo:local_virt_tame`'s proof uses (independence of
`T_{U,V,φ}` from the chart, l.2104–2107). -/
theorem hypothesis_model_spaces_mechanism (hT : T ≤ τ) {V : Set Y} (hV : IsOpen V) :
    (T ≤ mixedTop T V ∧ mixedTop T V ≤ τ) ∧
      (∀ y ∈ V, @nhds Y (mixedTop T V) y = @nhds Y T y) ∧
      (∀ y ∉ V, @nhds Y (mixedTop T V) y = @nhds Y τ y) ∧
      (∀ γ : Y ≃ₜ Y, Continuous[T, T] γ → γ ⁻¹' V = V →
        Continuous[mixedTop T V, mixedTop T V] γ) ∧
      (∀ (ψ : Y ≃ₜ Y) (y : Y), y ∉ V → ψ y ∈ V → @nhds Y T (ψ y) ≠ @nhds Y τ (ψ y) →
        ¬ Continuous[mixedTop T V, mixedTop T V] ψ) :=
  ⟨le_mixedTop hT hV, fun _ hy => nhds_mixedTop_of_mem hT hV hy,
    fun _ hy => nhds_mixedTop_of_notMem hy,
    fun γ hγ hγV => continuous_mixedTop_of_preimage_eq γ hγ hγV,
    fun ψ _ hy hψy hne => not_continuous_mixedTop hT hV ψ hy hψy hne⟩

/-- `rem:hypothesis_model_spaces_necessary`, a toy instance showing that the last clause of
`hypothesis_model_spaces_mechanism` is not vacuous: on `ℝ` with `T = cutTopReal` (strictly finer
than the usual topology at `0`) and `V = (-1, ∞)`, the translation `t ↦ t + 2`, a homeomorphism
moving `-2 ∉ V` to `0 ∈ V`, is not continuous for the mixed topology. (The paper's own instance,
on `\widetilde{𝔼_θ^{1,2}}` with the BTZ tamifying topology, is
`GX.hypothesis_model_spaces_necessary`, WP-40d.) -/
theorem hypothesis_model_spaces_toy :
    ¬ Continuous[mixedTop cutTopReal (Ioi (-1 : ℝ)), mixedTop cutTopReal (Ioi (-1 : ℝ))]
      (Homeomorph.addRight (2 : ℝ)) := by
  have h0 : (Homeomorph.addRight (2 : ℝ)) (-2) = 0 := by norm_num
  refine not_continuous_mixedTop (T := cutTopReal) inf_le_left isOpen_Ioi _ (y := -2)
    (by norm_num) (by rw [h0]; norm_num) ?_
  rw [h0]
  intro h
  have hT : IsOpen[cutTopReal] (Ici (0 : ℝ)) :=
    (TopologicalSpace.le_def.1 (inf_le_right : cutTopReal ≤ _)) _
      (TopologicalSpace.GenerateOpen.basic _ rfl)
  have h1 : Ici (0 : ℝ) ∈ @nhds ℝ cutTopReal 0 :=
    @IsOpen.mem_nhds ℝ cutTopReal _ _ hT (mem_Ici.2 le_rfl)
  rw [h] at h1
  have h2 := mem_interior_iff_mem_nhds.2 h1
  rw [interior_Ici] at h2
  exact lt_irrefl _ (mem_Ioi.1 h2)

end Mixed

/-! ### The counterexample to `lem:spread_top` as printed -/

section CexHalfCut

def halfUp : Set ℂ := {z | 0 ≤ z.im}

@[reducible] def halfCutTop : TopologicalSpace ℂ :=
  (inferInstance : TopologicalSpace ℂ) ⊓ generateFrom {halfUp}

open Classical in
def halfSide (z : ℂ) : Set ℂ := if 0 ≤ z.im then halfUp else halfUpᶜ

theorem isOpen_halfUp_compl : IsOpen halfUpᶜ := by
  have : halfUpᶜ = {z : ℂ | z.im < 0} := by ext z; simp [halfUp]
  rw [this]; exact isOpen_lt Complex.continuous_im continuous_const

theorem nhds_halfCutTop (z : ℂ) : @nhds ℂ halfCutTop z = 𝓝 z ⊓ 𝓟 (halfSide z) := by
  rw [nhds_inf, TopologicalSpace.nhds_generateFrom]
  by_cases h : 0 ≤ z.im
  · have hz : z ∈ halfUp := h
    have : {s | z ∈ s ∧ s ∈ ({halfUp} : Set (Set ℂ))} = {halfUp} := by
      ext s; simp only [mem_setOf_eq, mem_singleton_iff]
      exact ⟨fun h => h.2, fun h => ⟨h ▸ hz, h⟩⟩
    rw [this, iInf_singleton]
    simp [halfSide, h]
  · have hz : z ∉ halfUp := h
    have : {s | z ∈ s ∧ s ∈ ({halfUp} : Set (Set ℂ))} = ∅ := by
      ext s; simp only [mem_setOf_eq, mem_singleton_iff, mem_empty_iff_false, iff_false]
      rintro ⟨h1, rfl⟩; exact hz h1
    rw [this]
    simp only [mem_empty_iff_false, iInf_of_empty, iInf_top, inf_top_eq]
    simp only [halfSide, h, if_false]
    exact (inf_eq_left.2 (le_principal_iff.2 (isOpen_halfUp_compl.mem_nhds hz))).symm

theorem mem_halfSide_self (z : ℂ) : z ∈ halfSide z := by
  by_cases h : 0 ≤ z.im
  · simp only [halfSide, h, if_true]; exact h
  · simp only [halfSide, h, if_false]; exact h

theorem convex_halfSide (z : ℂ) : Convex ℝ (halfSide z) := by
  by_cases h : 0 ≤ z.im
  · simp only [halfSide, h, if_true]
    exact (convex_Ici (0 : ℝ)).linear_preimage Complex.imLm
  · simp only [halfSide, h, if_false]
    have : halfUpᶜ = Complex.imLm ⁻¹' Iio (0 : ℝ) := by ext w; simp [halfUp]
    rw [this]; exact (convex_Iio (0 : ℝ)).linear_preimage Complex.imLm

theorem halfSide_mem_nhds {z : ℂ} (hz : z.im ≠ 0) : halfSide z ∈ 𝓝 z := by
  rcases lt_or_gt_of_ne hz with h | h
  · have h' : ¬ 0 ≤ z.im := not_le.2 h
    simp only [halfSide, h', if_false]
    exact isOpen_halfUp_compl.mem_nhds h'
  · simp only [halfSide, h.le, if_true]
    refine mem_of_superset ((isOpen_lt continuous_const Complex.continuous_im).mem_nhds h) ?_
    intro w hw; exact le_of_lt (show 0 < w.im from hw)

/-- A continuous map into one side of the cut is continuous for the cut topology. -/
theorem continuous_halfCutTop_of_mapsTo {Z : Type*} [TopologicalSpace Z] {f : Z → ℂ}
    (hf : Continuous f) {z : ℂ} (h : ∀ x, f x ∈ halfSide z) : Continuous[_, halfCutTop] f := by
  refine continuous_inf_rng.2 ⟨hf, continuous_generateFrom_iff.2 fun s hs => ?_⟩
  rw [mem_singleton_iff.1 hs]
  by_cases hz : 0 ≤ z.im
  · have : f ⁻¹' halfUp = univ := eq_univ_of_forall fun x => by
      have := h x; simp only [halfSide, hz, if_true] at this; exact this
    rw [this]; exact isOpen_univ
  · have : f ⁻¹' halfUp = ∅ := eq_empty_of_forall_notMem fun x => by
      have := h x; simp only [halfSide, hz, if_false] at this; exact this
    rw [this]; exact isOpen_empty

theorem isPathConnected_halfCutTop {z : ℂ} {A : Set ℂ} (hA : A ⊆ halfSide z)
    (h : IsPathConnected A) : @IsPathConnected ℂ halfCutTop A := by
  obtain ⟨x, hx, hj⟩ := h
  refine ⟨x, hx, fun y hy => ?_⟩
  obtain ⟨γ, hγ⟩ := hj hy
  exact ⟨@Path.mk ℂ halfCutTop x y (@ContinuousMap.mk _ ℂ _ halfCutTop γ
    (continuous_halfCutTop_of_mapsTo γ.continuous fun t => hA (hγ t))) γ.source γ.target, hγ⟩

theorem hasBasis_nhds_halfCutTop (z : ℂ) :
    (@nhds ℂ halfCutTop z).HasBasis (fun ε : ℝ => 0 < ε) fun ε => Metric.ball z ε ∩ halfSide z := by
  rw [nhds_halfCutTop]; exact Metric.nhds_basis_ball.inf_principal _

theorem firstCountable_halfCutTop : @FirstCountableTopology ℂ halfCutTop :=
  @FirstCountableTopology.mk ℂ halfCutTop fun z => by rw [nhds_halfCutTop]; infer_instance

theorem locPathConnected_halfCutTop : @LocPathConnectedSpace ℂ halfCutTop :=
  @LocPathConnectedSpace.of_bases ℂ halfCutTop _ _ _ hasBasis_nhds_halfCutTop fun z ε hε =>
    isPathConnected_halfCutTop inter_subset_right
      (((convex_ball z ε).inter (convex_halfSide z)).isPathConnected
        ⟨z, Metric.mem_ball_self hε, mem_halfSide_self z⟩)

theorem isOpen_halfUp_halfCutTop : IsOpen[halfCutTop] halfUp :=
  (TopologicalSpace.le_def.1 (inf_le_right : halfCutTop ≤ _)) _
    (TopologicalSpace.GenerateOpen.basic _ rfl)

theorem isOpen_halfCutTop_of_isOpen {U : Set ℂ} (hU : IsOpen U) : IsOpen[halfCutTop] U :=
  (TopologicalSpace.le_def.1 (inf_le_left : halfCutTop ≤ _)) _ hU

/-- The off-axis set `{im ≠ 0}`. -/
def offAxis : Set ℂ := {z | z.im ≠ 0}

theorem isOpen_offAxis : IsOpen offAxis := isOpen_ne_fun Complex.continuous_im continuous_const

theorem nhds_halfCutTop_offAxis {z : ℂ} (hz : z ∈ offAxis) : @nhds ℂ halfCutTop z = 𝓝 z := by
  rw [nhds_halfCutTop]; exact inf_eq_left.2 (le_principal_iff.2 (halfSide_mem_nhds hz))

theorem dense_offAxis_halfCutTop : @Dense ℂ halfCutTop offAxis := by
  intro z
  refine (@mem_closure_iff_nhds_basis ℂ halfCutTop _ _ _ _ _ (hasBasis_nhds_halfCutTop z)).2
    fun ε hε => ?_
  by_cases hz : z.im = 0
  · refine ⟨z + (ε / 2) * Complex.I, ?_, ?_, ?_⟩
    · show (z + (ε / 2) * Complex.I).im ≠ 0
      simp [hz]; exact hε.ne'
    · rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_mul, Complex.norm_I, mul_one]
      have : ‖((ε : ℂ) / 2)‖ = ε / 2 := by
        rw [norm_div, Complex.norm_real, Real.norm_of_nonneg hε.le]; norm_num
      rw [this]; linarith
    · have h0 : 0 ≤ z.im := hz.ge
      simp only [halfSide, h0, if_true]
      show 0 ≤ (z + (ε / 2) * Complex.I).im
      simp [hz]; linarith
  · exact ⟨z, hz, Metric.mem_ball_self hε, mem_halfSide_self z⟩

theorem isClopen_halfUp_halfCutTop : @IsClopen ℂ halfCutTop halfUp :=
  ⟨@IsClosed.mk ℂ halfCutTop halfUp (isOpen_halfCutTop_of_isOpen isOpen_halfUp_compl),
    isOpen_halfUp_halfCutTop⟩

theorem isPortly_offAxis_halfCutTop : @IsPortly ℂ halfCutTop offAxis := by
  refine @IsPortly.mk ℂ halfCutTop _ (isOpen_halfCutTop_of_isOpen isOpen_offAxis)
    dense_offAxis_halfCutTop fun W hW hWc => ?_
  by_cases hne : (W ∩ halfUp).Nonempty
  · have hWH : W ⊆ halfUp :=
      @IsPreconnected.subset_isClopen ℂ halfCutTop W halfUp hWc isClopen_halfUp_halfCutTop hne
    refine @isPreconnected_of_local ℂ halfCutTop W (W ∩ offAxis) hWc inter_subset_left
      (@Dense.open_subset_closure_inter ℂ halfCutTop _ _ dense_offAxis_halfCutTop hW)
      fun x hx => ?_
    obtain ⟨ε, hε, hεW⟩ := (hasBasis_nhds_halfCutTop x).mem_iff.1
      (@IsOpen.mem_nhds ℂ halfCutTop _ _ hW hx)
    have hxH : 0 ≤ x.im := hWH hx
    have hside : halfSide x = halfUp := by simp only [halfSide, hxH, if_true]
    rw [hside] at hεW
    refine ⟨Metric.ball x ε ∩ halfUp, @IsOpen.inter ℂ halfCutTop _ _
      (isOpen_halfCutTop_of_isOpen Metric.isOpen_ball) isOpen_halfUp_halfCutTop,
      ⟨Metric.mem_ball_self hε, hxH⟩, ?_⟩
    have heq : Metric.ball x ε ∩ halfUp ∩ (W ∩ offAxis) =
        Metric.ball x ε ∩ Complex.imLm ⁻¹' Ioi (0 : ℝ) := by
      ext w
      constructor
      · rintro ⟨⟨hb, hH⟩, -, hoff⟩
        exact ⟨hb, show 0 < w.im from lt_of_le_of_ne (show 0 ≤ w.im from hH) (Ne.symm hoff)⟩
      · rintro ⟨hb, hpos⟩
        have hpos' : 0 < w.im := hpos
        have hH : w ∈ halfUp := show 0 ≤ w.im from hpos'.le
        exact ⟨⟨hb, hH⟩, hεW ⟨hb, hH⟩, show w.im ≠ 0 from hpos'.ne'⟩
    rw [heq]
    rcases (Metric.ball x ε ∩ Complex.imLm ⁻¹' Ioi (0 : ℝ)).eq_empty_or_nonempty with he | he
    · rw [he]; exact @isPreconnected_empty ℂ halfCutTop
    · refine @IsConnected.isPreconnected ℂ halfCutTop _ (@IsPathConnected.isConnected ℂ halfCutTop _
        (isPathConnected_halfCutTop (z := x) ?_
          (((convex_ball x ε).inter ((convex_Ioi (0 : ℝ)).linear_preimage Complex.imLm)).isPathConnected
            he)))
      rw [hside]
      rintro w ⟨-, hw⟩
      exact show 0 ≤ w.im from (show 0 < w.im from hw).le
  · have hWo : W ⊆ offAxis := fun w hw => by
      have : w ∉ halfUp := fun h => hne ⟨w, hw, h⟩
      exact show w.im ≠ 0 from fun h0 => this (show 0 ≤ w.im from h0.ge)
    rwa [inter_eq_left.2 hWo]

theorem induced_offAxis_halfCutTop :
    TopologicalSpace.induced (Subtype.val : offAxis → ℂ) halfCutTop =
      TopologicalSpace.induced (Subtype.val : offAxis → ℂ) inferInstance :=
  induced_eq_of_nhds_eq fun _ he => nhds_halfCutTop_offAxis he


/-- The printed statement of `lem:spread_top` (`RamcovGX.tex:1990`), as formalized (with a tagged
`sorry`) by the former `GX.spread_top` of `GXScaffold.SingularII.Models` (removed by WP-35f). It
is FALSE
(`not_spreadTopPrinted`). -/
def SpreadTopPrinted : Prop :=
  ∀ {M : Type u} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
    [FirstCountableTopology M] [ConnectedSpace M] {S : Set M} (_hS : IsSkeletal S)
    (_hSc : SemilocallySimplyConnected (Sᶜ : Set M)) (_hrel : IsSLSCInCC (Sᶜ : Set M))
    (y₀ : (Sᶜ : Set M)) {N : Type v} [tN : TopologicalSpace N] {p : MaxBranchedCover S y₀ → N}
    {q : N → M} (_hp : IsBranchedCovering p) (_hq : IsBranchedCovering q)
    (_hqp : ∀ e, q (p e) = e.base) {R : Set N} (_hR : R ⊆ ordY p) (T : TopologicalSpace N)
    (_hTle : T ≤ tN) (_hT1 : @FirstCountableTopology N T) (_hT2 : @LocPathConnectedSpace N T)
    (_hTdeck : ∀ f ∈ @deckMapsOf N M tN q, Continuous[T, T] f) (_hRT : @IsPortly N T R)
    (_hRagree : TopologicalSpace.induced (Subtype.val : R → N) T =
      TopologicalSpace.induced (Subtype.val : R → N) tN),
    (@FirstCountableTopology _ (strongPullTop p T) ∧ @ConnectedSpace _ (strongPullTop p T) ∧
        @LocPathConnectedSpace _ (strongPullTop p T)) ∧
      TopologicalSpace.induced (Subtype.val : (p ⁻¹' R) → MaxBranchedCover S y₀)
          (strongPullTop p T) =
        TopologicalSpace.induced (Subtype.val : (p ⁻¹' R) → MaxBranchedCover S y₀)
          (inferInstance : TopologicalSpace (MaxBranchedCover S y₀)) ∧
      @IsPortly _ (strongPullTop p T) (p ⁻¹' R) ∧
      @IsBranchedCovering _ _ (strongPullTop p T) T p

theorem isSkeletal_empty_complex : IsSkeletal (∅ : Set ℂ) := isSkeletal_empty

theorem slsc_compl_empty_complex : SemilocallySimplyConnected ((∅ : Set ℂ)ᶜ : Set ℂ) :=
  semilocallySimplyConnected_of_isOpen isClosed_empty.isOpen_compl

theorem isSLSCInCC_compl_empty_complex : IsSLSCInCC ((∅ : Set ℂ)ᶜ : Set ℂ) := by
  rw [compl_empty]; exact isSLSCInCC_univ_of_normedSpace

/-- The counterexample to `lem:spread_top` (a) and (e) as printed: `M = N = ℂ`, `S = ∅`
(`\widetilde M^S` the universal covering), `q = id`, `p` the projection, `R = {Im ≠ 0}` and `T` the
topology of `ℂ` cut along the real axis, the axis attached to the upper half-plane
(`halfCutTop`). All the hypotheses hold (`not_spreadTopPrinted`), and `p^*T` is not connected
(`p⁻¹{Im ≥ 0}` and `p⁻¹{Im < 0}` are `p^*T`-open), so (a) and (e) fail. The proof's "`N` strongly
connected" (l.2018) is not among the hypotheses. -/
theorem cex_spread_top_halfCut (y₀ : ((∅ : Set ℂ)ᶜ : Set ℂ)) :
    ¬ @ConnectedSpace _ (strongPullTop (SpreadEnd.base : MaxBranchedCover (∅ : Set ℂ) y₀ → ℂ)
      halfCutTop) ∧
    ¬ @IsBranchedCovering _ _ (strongPullTop (SpreadEnd.base : MaxBranchedCover (∅ : Set ℂ) y₀ → ℂ)
      halfCutTop) halfCutTop SpreadEnd.base := by
  obtain ⟨-, hβbc, -, -, -, -⟩ :=
    maxBranched_basic isSkeletal_empty_complex slsc_compl_empty_complex y₀
  have hnc : ¬ @ConnectedSpace _ (strongPullTop (SpreadEnd.base :
      MaxBranchedCover (∅ : Set ℂ) y₀ → ℂ) halfCutTop) := by
    intro hconn
    have hc := continuous_strongPullTop (SpreadEnd.base : MaxBranchedCover (∅ : Set ℂ) y₀ → ℂ)
      halfCutTop
    have h1 := @Continuous.isOpen_preimage _ _ (strongPullTop _ halfCutTop) halfCutTop _ hc _
      isOpen_halfUp_halfCutTop
    have h2 := @Continuous.isOpen_preimage _ _ (strongPullTop _ halfCutTop) halfCutTop _ hc _
      (isOpen_halfCutTop_of_isOpen isOpen_halfUp_compl)
    obtain ⟨e₁, he₁⟩ := hβbc.surjective 0
    obtain ⟨e₂, he₂⟩ := hβbc.surjective (-Complex.I)
    have hpre := @isPreconnected_univ _ (strongPullTop _ halfCutTop) hconn.toPreconnectedSpace
    obtain ⟨z, -, hz1, hz2⟩ := hpre _ _ h1 h2 (fun z _ => em (z ∈ _ ⁻¹' halfUp))
      ⟨e₁, mem_univ _, show 0 ≤ e₁.base.im by rw [he₁]; simp⟩
      ⟨e₂, mem_univ _, show ¬ 0 ≤ e₂.base.im by rw [he₂]; simp⟩
    exact hz2 hz1
  exact ⟨hnc, fun h => hnc (@IsBranchedCovering.connectedSpace_source _ _
    (strongPullTop _ halfCutTop) halfCutTop _ h)⟩

/-- `lem:spread_top` as printed is false (DEC-27): the counterexample `cex_spread_top_halfCut`
satisfies every hypothesis of `SpreadTopPrinted` (the printed statement). -/
theorem not_spreadTopPrinted : ¬ SpreadTopPrinted.{0, 0} := by
  intro H
  let y₀ : ((∅ : Set ℂ)ᶜ : Set ℂ) := ⟨0, by simp⟩
  obtain ⟨-, hβbc, hβS, -, -, -⟩ :=
    maxBranched_basic isSkeletal_empty_complex slsc_compl_empty_complex y₀
  have hR : offAxis ⊆ ordY (SpreadEnd.base : MaxBranchedCover (∅ : Set ℂ) y₀ → ℂ) :=
    fun y _ => by
      by_contra h
      exact (hβS h : y ∈ (∅ : Set ℂ))
  have hTdeck : ∀ f ∈ @deckMapsOf ℂ ℂ _ id, Continuous[halfCutTop, halfCutTop] f := by
    rintro f ⟨γ, hγ, rfl⟩
    have : (γ : ℂ → ℂ) = id := hγ
    rw [this]; exact @continuous_id ℂ halfCutTop
  obtain ⟨⟨-, hconn, -⟩, -⟩ := H isSkeletal_empty_complex slsc_compl_empty_complex
    isSLSCInCC_compl_empty_complex y₀ (p := SpreadEnd.base) (q := id) hβbc isBranchedCovering_id
    (fun _ => rfl) hR halfCutTop inf_le_left firstCountable_halfCutTop locPathConnected_halfCutTop
    hTdeck isPortly_offAxis_halfCutTop induced_offAxis_halfCutTop
  exact (cex_spread_top_halfCut y₀).1 hconn

/-! #### The half-cut counterexample satisfies the local hypothesis (WP-35g) -/

/-- `\widetilde{ℂ}^∅ → ℂ` is a homeomorphism: it is a covering (no branching), and `ℂ` is simply
connected, so the lift of `id` through it is an inverse (uniqueness of lifts). -/
theorem exists_homeomorph_maxBranched_empty (y₀ : ((∅ : Set ℂ)ᶜ : Set ℂ)) :
    ∃ Φ : MaxBranchedCover (∅ : Set ℂ) y₀ ≃ₜ ℂ, ∀ e, Φ e = e.base := by
  obtain ⟨-, hβbc, hβS, -, hl, -⟩ :=
    maxBranched_basic isSkeletal_empty_complex slsc_compl_empty_complex y₀
  haveI := hl
  haveI := hβbc.connectedSpace_source
  set p := (SpreadEnd.base : MaxBranchedCover (∅ : Set ℂ) y₀ → ℂ) with hpdef
  have hord : ordY p = univ := eq_univ_of_forall fun y => by
    by_contra h; exact (hβS h : y ∈ (∅ : Set ℂ))
  have hcov : IsCoveringMap p := by
    have h := isCoveringMapOn_ordY (p := p) hβbc.isSpread.continuous
    rw [hord] at h
    exact isCoveringMap_iff_isCoveringMapOn_univ.2 h
  obtain ⟨e₀⟩ := (inferInstance : Nonempty (MaxBranchedCover (∅ : Set ℂ) y₀))
  obtain ⟨s, ⟨hs0, hs⟩, -⟩ :=
    hcov.existsUnique_continuousMap_lifts (ContinuousMap.id ℂ) (p e₀) e₀ rfl
  have hsp : ∀ z, p (s z) = z := fun z => congrFun hs z
  have hps : s ∘ p = id := hcov.eq_of_comp_eq (s.continuous.comp hβbc.isSpread.continuous)
    continuous_id (by funext e; simp [hsp]) e₀ (by simp [hs0])
  exact ⟨⟨⟨p, s, fun e => congrFun hps e, hsp⟩, hβbc.isSpread.continuous, s.continuous⟩,
    fun _ => rfl⟩

theorem isOpen_halfSide_halfCutTop (z : ℂ) : IsOpen[halfCutTop] (halfSide z) := by
  by_cases h : 0 ≤ z.im
  · simp only [halfSide, h, if_true]; exact isOpen_halfUp_halfCutTop
  · simp only [halfSide, h, if_false]; exact isOpen_halfCutTop_of_isOpen isOpen_halfUp_compl

theorem convex_halfSide_inter_offAxis (z : ℂ) : Convex ℝ (halfSide z ∩ offAxis) := by
  by_cases h : 0 ≤ z.im
  · have : halfSide z ∩ offAxis = Complex.imLm ⁻¹' Ioi (0 : ℝ) := by
      ext w; simp only [halfSide, h, if_true, halfUp, offAxis, mem_inter_iff, mem_setOf_eq,
        mem_preimage, Complex.imLm_coe, mem_Ioi]
      constructor
      · rintro ⟨h1, h2⟩; exact lt_of_le_of_ne h1 (Ne.symm h2)
      · intro h1; exact ⟨h1.le, h1.ne'⟩
    rw [this]; exact (convex_Ioi (0 : ℝ)).linear_preimage Complex.imLm
  · have : halfSide z ∩ offAxis = halfSide z := by
      refine inter_eq_left.2 fun w hw => ?_
      simp only [halfSide, h, if_false, halfUp, mem_compl_iff, mem_setOf_eq, not_le] at hw
      exact hw.ne
    rw [this]; exact convex_halfSide z

/-- In the half-cut counterexample the local hypothesis `StrongLocallyConnectedOrd` HOLDS: the
preimages of `B(z,ε) ∩ halfSide(z)` are `p^*T`-open, inside any given neighbourhood for `ε`
small, and meet `p⁻¹(offAxis)` in the `p^*T`-path-connected preimage of a convex subset of
`halfSide z`. So `cex_spread_top_halfCut` refutes connectedness (a) WITH the local hypothesis. -/
theorem strongLocallyConnectedOrd_halfCut (y₀ : ((∅ : Set ℂ)ᶜ : Set ℂ)) :
    StrongLocallyConnectedOrd halfCutTop
      (SpreadEnd.base : MaxBranchedCover (∅ : Set ℂ) y₀ → ℂ) offAxis := by
  obtain ⟨-, hβbc, -, -, hl, -⟩ :=
    maxBranched_basic isSkeletal_empty_complex slsc_compl_empty_complex y₀
  haveI := hl
  obtain ⟨Φ, hΦ⟩ := exists_homeomorph_maxBranched_empty y₀
  set p := (SpreadEnd.base : MaxBranchedCover (∅ : Set ℂ) y₀ → ℂ) with hpdef
  have hpΦ : ∀ e, p e = Φ e := fun e => (hΦ e).symm
  have hpre : ∀ A : Set ℂ, p ⁻¹' A = Φ.symm '' A := fun A => by
    ext e; simp only [mem_preimage, hpΦ]
    exact ⟨fun h => ⟨Φ e, h, Φ.symm_apply_apply e⟩,
      fun ⟨z, hz, he⟩ => by rw [← he, Φ.apply_symm_apply]; exact hz⟩
  have hTle : halfCutTop ≤ (inferInstance : TopologicalSpace ℂ) := inf_le_left
  -- preimages of path-connected subsets of a half side are `p^*T`-path-connected
  have hAp : ∀ {A : Set ℂ} (z : ℂ), A ⊆ halfSide z → IsPathConnected A →
      @IsPathConnected _ (strongPullTop p halfCutTop) (p ⁻¹' A) := by
    intro A z hA hpc
    obtain ⟨a, ha, hj⟩ := isPathConnected_halfCutTop hA hpc
    refine ⟨Φ.symm a, by rw [hpre]; exact mem_image_of_mem _ ha, fun {y} hy => ?_⟩
    have hy' : Φ y ∈ A := by rw [← hpΦ]; exact hy
    obtain ⟨γ, hγ⟩ := hj hy'
    let g : C(I, MaxBranchedCover (∅ : Set ℂ) y₀) :=
      ⟨fun t => Φ.symm (γ t), Φ.symm.continuous.comp (Path.weakOfLe_sptop hTle γ).continuous⟩
    have hgγ : p ∘ g = γ := funext fun t => by
      show p (Φ.symm (γ t)) = γ t
      rw [hpΦ, Φ.apply_symm_apply]
    have hgp : Continuous[_, halfCutTop] (p ∘ g) := by
      rw [hgγ]; exact @Path.continuous ℂ halfCutTop _ _ γ
    have hg0 : g 0 = Φ.symm a := by
      show Φ.symm (γ 0) = _; rw [@Path.source ℂ halfCutTop _ _ γ]
    have hg1 : g 1 = y := by
      show Φ.symm (γ 1) = _; rw [@Path.target ℂ halfCutTop _ _ γ, Φ.symm_apply_apply]
    refine ⟨Path.strongOf_sptop g hgp hg0 hg1, fun t => ?_⟩
    rw [Path.strongOf_sptop_apply]
    show p (g t) ∈ A
    rw [← comp_apply (f := p), hgγ]; exact hγ t
  intro x U hU
  obtain ⟨O, ⟨hO, hxO⟩, hsub⟩ :=
    (hasBasis_nhds_strongPullTop hβbc.isSpread hTle x).mem_iff.1 hU
  obtain ⟨ε, hε, hεO⟩ := (hasBasis_nhds_halfCutTop (p x)).mem_iff.1
    (@IsOpen.mem_nhds ℂ halfCutTop _ _ hO hxO)
  set O' := Metric.ball (p x) ε ∩ halfSide (p x) with hO'def
  have hO'o : IsOpen[halfCutTop] O' := @IsOpen.inter ℂ halfCutTop _ _
    (isOpen_halfCutTop_of_isOpen Metric.isOpen_ball) (isOpen_halfSide_halfCutTop _)
  have hxO' : p x ∈ O' := ⟨Metric.mem_ball_self hε, mem_halfSide_self _⟩
  have hO'c : Convex ℝ O' := (convex_ball _ _).inter (convex_halfSide _)
  refine ⟨p ⁻¹' O', @Continuous.isOpen_preimage _ _ (strongPullTop p halfCutTop) halfCutTop p
    (continuous_strongPullTop p halfCutTop) _ hO'o, hxO', ?_, ?_⟩
  · refine Subset.trans ?_ hsub
    have hpc : IsPreconnected (p ⁻¹' O') := by
      rw [hpre]; exact hO'c.isPreconnected.image _ Φ.symm.continuous.continuousOn
    exact hpc.subset_connectedComponentIn hxO' (preimage_mono hεO)
  · rw [← preimage_inter]
    by_cases hne : (O' ∩ offAxis).Nonempty
    · have hc : Convex ℝ (O' ∩ offAxis) := by
        rw [hO'def, inter_assoc]
        exact (convex_ball _ _).inter (convex_halfSide_inter_offAxis (p x))
      exact @IsConnected.isPreconnected _ (strongPullTop p halfCutTop) _
        (@IsPathConnected.isConnected _ (strongPullTop p halfCutTop) _
          (hAp (p x) (inter_subset_left.trans inter_subset_right) (hc.isPathConnected hne)))
    · rw [not_nonempty_iff_eq_empty.1 hne, preimage_empty]
      exact @isPreconnected_empty _ (strongPullTop p halfCutTop)

/-- `id` is Galoisian (its deck group is trivial and so are its fibres). -/
theorem isGaloisian_id_sptop {Y : Type*} [TopologicalSpace Y] [ConnectedSpace Y]
    [LocallyConnectedSpace Y] : IsGaloisian (id : Y → Y) :=
  ⟨isBranchedCovering_id, fun _ _ h => ⟨1, one_mem _, h⟩⟩

/-- The statement of `lem:spread_top` (a)-connectedness under EVERY hypothesis of
`spread_top_of_local` except "`p⁻¹(R)` connected": the printed hypotheses, `N → M` Galoisian
(`_hq`), `N` Hausdorff, locally path-connected, first countable, and the local hypothesis
`StrongLocallyConnectedOrd` (`_hH`). It is FALSE (`not_spreadTopGalLocalCE`): the hypothesis
`hRc` of `spread_top_of_local` cannot be dropped. -/
def SpreadTopGalLocalCE : Prop :=
  ∀ {M : Type u} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
    [FirstCountableTopology M] [ConnectedSpace M] {S : Set M} (_hS : IsSkeletal S)
    (_hSc : SemilocallySimplyConnected (Sᶜ : Set M)) (_hrel : IsSLSCInCC (Sᶜ : Set M))
    (y₀ : (Sᶜ : Set M)) {N : Type v} [tN : TopologicalSpace N] [T2Space N]
    [LocPathConnectedSpace N] [FirstCountableTopology N] {p : MaxBranchedCover S y₀ → N}
    {q : N → M} (_hp : IsBranchedCovering p) (_hq : IsGaloisian q)
    (_hqp : ∀ e, q (p e) = e.base) {R : Set N} (_hR : R ⊆ ordY p) (T : TopologicalSpace N)
    (_hTle : T ≤ tN) (_hT1 : @FirstCountableTopology N T) (_hT2 : @LocPathConnectedSpace N T)
    (_hTdeck : ∀ f ∈ @deckMapsOf N M tN q, Continuous[T, T] f) (_hRT : @IsPortly N T R)
    (_hRagree : TopologicalSpace.induced (Subtype.val : R → N) T =
      TopologicalSpace.induced (Subtype.val : R → N) tN)
    (_hH : StrongLocallyConnectedOrd T p R),
    @ConnectedSpace _ (strongPullTop p T)

/-- **The connectedness hypothesis of `spread_top_of_local` is necessary** (DEC-27): the half-cut
counterexample (`q = id`, Galoisian) satisfies the local hypothesis
(`strongLocallyConnectedOrd_halfCut`) and every other hypothesis of `SpreadTopGalLocalCE`, and
`p^*T` is disconnected. -/
theorem not_spreadTopGalLocalCE : ¬ SpreadTopGalLocalCE.{0, 0} := by
  intro H
  let y₀ : ((∅ : Set ℂ)ᶜ : Set ℂ) := ⟨0, by simp⟩
  obtain ⟨-, hβbc, hβS, -, -, -⟩ :=
    maxBranched_basic isSkeletal_empty_complex slsc_compl_empty_complex y₀
  have hR : offAxis ⊆ ordY (SpreadEnd.base : MaxBranchedCover (∅ : Set ℂ) y₀ → ℂ) :=
    fun y _ => by
      by_contra h
      exact (hβS h : y ∈ (∅ : Set ℂ))
  have hTdeck : ∀ f ∈ @deckMapsOf ℂ ℂ _ id, Continuous[halfCutTop, halfCutTop] f := by
    rintro f ⟨γ, hγ, rfl⟩
    have : (γ : ℂ → ℂ) = id := hγ
    rw [this]; exact @continuous_id ℂ halfCutTop
  exact (cex_spread_top_halfCut y₀).1 (H isSkeletal_empty_complex slsc_compl_empty_complex
    isSLSCInCC_compl_empty_complex y₀ (p := SpreadEnd.base) (q := id) hβbc isGaloisian_id_sptop
    (fun _ => rfl) hR halfCutTop inf_le_left firstCountable_halfCutTop locPathConnected_halfCutTop
    hTdeck isPortly_offAxis_halfCutTop induced_offAxis_halfCutTop
    (strongLocallyConnectedOrd_halfCut y₀))

end CexHalfCut

/-! ### The sector counterexample -/

section CexSector

/-- The closed sector `{0} ∪ {Re > 0}`. -/
def sectorSet : Set ℂ := insert 0 {z | 0 < z.re}

/-- The topology on `ℂ` generated by the usual one and `{0} ∪ {Re > 0}`. -/
@[reducible] def sectorTop : TopologicalSpace ℂ :=
  (inferInstance : TopologicalSpace ℂ) ⊓ generateFrom {sectorSet}

open Classical in
/-- The side of `z`: the sector at `0`, the punctured plane elsewhere. -/
def sectorSide (z : ℂ) : Set ℂ := if z = 0 then sectorSet else {0}ᶜ

theorem convex_sectorSet : Convex ℝ sectorSet := by
  intro a ha b hb s t hs ht hst
  rcases ha with rfl | ha <;> rcases hb with rfl | hb
  · left; simp
  · rcases ht.lt_or_eq with ht' | rfl
    · right; show 0 < (s • (0:ℂ) + t • b).re; simp; exact mul_pos ht' hb
    · left; simp
  · rcases hs.lt_or_eq with hs' | rfl
    · right; show 0 < (s • a + t • (0:ℂ)).re; simp; exact mul_pos hs' ha
    · left; simp
  · right
    show 0 < (s • a + t • b).re
    simp only [Complex.add_re, Complex.real_smul, Complex.re_ofReal_mul]
    rcases hs.lt_or_eq with hs' | rfl
    · exact add_pos_of_pos_of_nonneg (mul_pos hs' ha) (mul_nonneg ht hb.le)
    · simp at hst; subst hst; simpa using hb

theorem isOpen_re_pos : IsOpen {z : ℂ | 0 < z.re} := isOpen_lt continuous_const Complex.continuous_re

theorem sectorSet_mem_nhds_of_ne {z : ℂ} (hz : z ∈ sectorSet) (h0 : z ≠ 0) : sectorSet ∈ 𝓝 z := by
  rcases hz with rfl | hz
  · exact absurd rfl h0
  · exact mem_of_superset (isOpen_re_pos.mem_nhds hz) (subset_insert _ _)

theorem nhds_sectorTop (z : ℂ) : @nhds ℂ sectorTop z = 𝓝 z ⊓ 𝓟 (sectorSide z) := by
  rw [nhds_inf, TopologicalSpace.nhds_generateFrom]
  by_cases hz0 : z = 0
  · subst hz0
    have hz : (0 : ℂ) ∈ sectorSet := mem_insert _ _
    have : {s | (0 : ℂ) ∈ s ∧ s ∈ ({sectorSet} : Set (Set ℂ))} = {sectorSet} := by
      ext s; simp only [mem_setOf_eq, mem_singleton_iff]
      exact ⟨fun h => h.2, fun h => ⟨h ▸ hz, h⟩⟩
    rw [this, iInf_singleton]
    simp [sectorSide]
  · have hside : sectorSide z = {0}ᶜ := by simp [sectorSide, hz0]
    rw [hside, inf_eq_left.2 (le_principal_iff.2 (isOpen_compl_singleton.mem_nhds hz0))]
    by_cases hz : z ∈ sectorSet
    · have : {s | z ∈ s ∧ s ∈ ({sectorSet} : Set (Set ℂ))} = {sectorSet} := by
        ext s; simp only [mem_setOf_eq, mem_singleton_iff]
        exact ⟨fun h => h.2, fun h => ⟨h ▸ hz, h⟩⟩
      rw [this, iInf_singleton]
      exact inf_eq_left.2 (le_principal_iff.2 (sectorSet_mem_nhds_of_ne hz hz0))
    · have : {s | z ∈ s ∧ s ∈ ({sectorSet} : Set (Set ℂ))} = ∅ := by
        ext s; simp only [mem_setOf_eq, mem_singleton_iff, mem_empty_iff_false, iff_false]
        rintro ⟨h1, rfl⟩; exact hz h1
      rw [this]
      simp only [mem_empty_iff_false, iInf_of_empty, iInf_top, inf_top_eq]

theorem nhds_sectorTop_of_ne {z : ℂ} (hz : z ≠ 0) : @nhds ℂ sectorTop z = 𝓝 z := by
  rw [nhds_sectorTop]
  have hside : sectorSide z = {0}ᶜ := by simp [sectorSide, hz]
  rw [hside]; exact inf_eq_left.2 (le_principal_iff.2 (isOpen_compl_singleton.mem_nhds hz))

theorem mem_sectorSide_self (z : ℂ) : z ∈ sectorSide z := by
  by_cases h : z = 0
  · subst h; simp [sectorSide, sectorSet]
  · simp [sectorSide, h]

/-- A continuous map whose preimage of the sector is open is `sectorTop`-continuous. -/
theorem continuous_sectorTop_of {Z : Type*} [TopologicalSpace Z] {f : Z → ℂ}
    (hf : Continuous f) (h : IsOpen (f ⁻¹' sectorSet)) : Continuous[_, sectorTop] f :=
  continuous_inf_rng.2 ⟨hf, continuous_generateFrom_iff.2 fun s hs => by
    rw [mem_singleton_iff.1 hs]; exact h⟩

theorem continuous_sectorTop_of_mapsTo {Z : Type*} [TopologicalSpace Z] {f : Z → ℂ}
    (hf : Continuous f) {z : ℂ} (h : ∀ x, f x ∈ sectorSide z) : Continuous[_, sectorTop] f := by
  refine continuous_sectorTop_of hf ?_
  by_cases hz : z = 0
  · have : f ⁻¹' sectorSet = univ := eq_univ_of_forall fun x => by
      have := h x; simp only [sectorSide, hz, if_true] at this; exact this
    rw [this]; exact isOpen_univ
  · have : f ⁻¹' sectorSet = f ⁻¹' {w | 0 < w.re} := by
      ext x
      have hx := h x
      simp only [sectorSide, hz, if_false, mem_compl_iff, mem_singleton_iff] at hx
      simp only [mem_preimage, sectorSet, mem_insert_iff, hx, false_or, mem_setOf_eq]
    rw [this]; exact isOpen_re_pos.preimage hf

theorem isPathConnected_sectorTop {z : ℂ} {A : Set ℂ} (hA : A ⊆ sectorSide z)
    (h : IsPathConnected A) : @IsPathConnected ℂ sectorTop A := by
  obtain ⟨x, hx, hj⟩ := h
  refine ⟨x, hx, fun y hy => ?_⟩
  obtain ⟨γ, hγ⟩ := hj hy
  exact ⟨@Path.mk ℂ sectorTop x y (@ContinuousMap.mk _ ℂ _ sectorTop γ
    (continuous_sectorTop_of_mapsTo γ.continuous fun t => hA (hγ t))) γ.source γ.target, hγ⟩

theorem hasBasis_nhds_sectorTop (z : ℂ) :
    (@nhds ℂ sectorTop z).HasBasis (fun ε : ℝ => 0 < ε) fun ε => Metric.ball z ε ∩ sectorSide z := by
  rw [nhds_sectorTop]; exact Metric.nhds_basis_ball.inf_principal _

theorem firstCountable_sectorTop : @FirstCountableTopology ℂ sectorTop :=
  @FirstCountableTopology.mk ℂ sectorTop fun z => by rw [nhds_sectorTop]; infer_instance

theorem hasBasis_nhds_sectorTop' (z : ℂ) :
    (@nhds ℂ sectorTop z).HasBasis (fun ε : ℝ => 0 < ε ∧ (z ≠ 0 → ε ≤ ‖z‖))
      fun ε => Metric.ball z ε ∩ sectorSide z := by
  refine (hasBasis_nhds_sectorTop z).restrict fun ε hε => ?_
  by_cases hz : z = 0
  · exact ⟨ε, hε, fun h => absurd hz h, subset_rfl⟩
  · refine ⟨min ε ‖z‖, lt_min hε (norm_pos_iff.2 hz), fun _ => min_le_right _ _, ?_⟩
    exact inter_subset_inter_left _ (Metric.ball_subset_ball (min_le_left _ _))

theorem isPathConnected_ball_inter_sectorSide (z : ℂ) {ε : ℝ} (hε : 0 < ε ∧ (z ≠ 0 → ε ≤ ‖z‖)) :
    IsPathConnected (Metric.ball z ε ∩ sectorSide z) := by
  by_cases hz : z = 0
  · subst hz
    simp only [sectorSide, if_true]
    exact ((convex_ball 0 ε).inter convex_sectorSet).isPathConnected
      ⟨0, Metric.mem_ball_self hε.1, mem_insert _ _⟩
  · simp only [sectorSide, hz, if_false]
    have : Metric.ball z ε ∩ {0}ᶜ = Metric.ball z ε := by
      refine inter_eq_left.2 fun w hw h0 => ?_
      rw [mem_singleton_iff.1 h0, Metric.mem_ball, dist_zero_left] at hw
      exact absurd (hε.2 hz) (not_le.2 hw)
    rw [this]
    exact (convex_ball z ε).isPathConnected (Metric.nonempty_ball.2 hε.1)

theorem locPathConnected_sectorTop : @LocPathConnectedSpace ℂ sectorTop :=
  @LocPathConnectedSpace.of_bases ℂ sectorTop _ _ _ hasBasis_nhds_sectorTop' fun z _ hε =>
    isPathConnected_sectorTop inter_subset_right (isPathConnected_ball_inter_sectorSide z hε)

theorem isOpen_sectorTop_of_isOpen {U : Set ℂ} (hU : IsOpen U) : IsOpen[sectorTop] U :=
  (TopologicalSpace.le_def.1 (inf_le_left : sectorTop ≤ _)) _ hU

theorem isOpen_sectorSet_sectorTop : IsOpen[sectorTop] sectorSet :=
  (TopologicalSpace.le_def.1 (inf_le_right : sectorTop ≤ _)) _
    (TopologicalSpace.GenerateOpen.basic _ rfl)

theorem dense_compl_zero_sectorTop : @Dense ℂ sectorTop ({0}ᶜ : Set ℂ) := by
  intro z
  refine (@mem_closure_iff_nhds_basis ℂ sectorTop _ _ _ _ _ (hasBasis_nhds_sectorTop z)).2
    fun ε hε => ?_
  by_cases hz : z = 0
  · subst hz
    refine ⟨((ε / 2 : ℝ) : ℂ), ?_, ?_, ?_⟩
    · show ((ε / 2 : ℝ) : ℂ) ≠ 0
      exact Complex.ofReal_ne_zero.2 (by positivity)
    · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      linarith
    · simp only [sectorSide, if_true]
      right; show 0 < ((ε / 2 : ℝ) : ℂ).re
      rw [Complex.ofReal_re]; positivity
  · exact ⟨z, hz, Metric.mem_ball_self hε, mem_sectorSide_self z⟩

theorem isPathConnected_ball_inter_sectorSide_diff (z : ℂ) {ε : ℝ}
    (hε : 0 < ε ∧ (z ≠ 0 → ε ≤ ‖z‖)) :
    @IsPathConnected ℂ sectorTop (Metric.ball z ε ∩ sectorSide z ∩ {0}ᶜ) := by
  refine isPathConnected_sectorTop (z := z) (fun w hw => hw.1.2) ?_
  by_cases hz : z = 0
  · subst hz
    have : Metric.ball (0 : ℂ) ε ∩ sectorSide 0 ∩ {0}ᶜ =
        Metric.ball (0 : ℂ) ε ∩ {w : ℂ | 0 < w.re} := by
      ext w
      simp only [sectorSide, if_true, sectorSet, mem_inter_iff, mem_insert_iff, mem_setOf_eq,
        mem_compl_iff, mem_singleton_iff]
      constructor
      · rintro ⟨⟨hb, h | h⟩, h0⟩
        · exact absurd h h0
        · exact ⟨hb, h⟩
      · rintro ⟨hb, h⟩
        exact ⟨⟨hb, Or.inr h⟩, fun h0 => by rw [h0] at h; simp at h⟩
    rw [this]
    refine ((convex_ball 0 ε).inter ((convex_Ioi (0 : ℝ)).linear_preimage Complex.reLm)).isPathConnected
      ⟨((ε / 2 : ℝ) : ℂ), ?_, ?_⟩
    · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_of_nonneg (by linarith)]
      linarith
    · show (0 : ℝ) < ((ε / 2 : ℝ) : ℂ).re
      rw [Complex.ofReal_re]; linarith
  · have h := isPathConnected_ball_inter_sectorSide z hε
    have hside : sectorSide z = {0}ᶜ := by simp [sectorSide, hz]
    rw [hside] at h ⊢
    rwa [inter_assoc, inter_self]

theorem isPortly_compl_zero_sectorTop : @IsPortly ℂ sectorTop ({0}ᶜ : Set ℂ) := by
  refine @IsPortly.mk ℂ sectorTop _ (isOpen_sectorTop_of_isOpen isOpen_compl_singleton)
    dense_compl_zero_sectorTop fun W hW hWc => ?_
  refine @isPreconnected_of_local ℂ sectorTop W (W ∩ {0}ᶜ) hWc inter_subset_left
    (@Dense.open_subset_closure_inter ℂ sectorTop _ _ dense_compl_zero_sectorTop hW) fun x hx => ?_
  obtain ⟨ε, hε, hεW⟩ := (hasBasis_nhds_sectorTop' x).mem_iff.1
    (@IsOpen.mem_nhds ℂ sectorTop _ _ hW hx)
  have hside_open : IsOpen[sectorTop] (sectorSide x) := by
    by_cases hx0 : x = 0
    · simp only [sectorSide, hx0, if_true]; exact isOpen_sectorSet_sectorTop
    · simp only [sectorSide, hx0, if_false]
      exact isOpen_sectorTop_of_isOpen isOpen_compl_singleton
  refine ⟨Metric.ball x ε ∩ sectorSide x, @IsOpen.inter ℂ sectorTop _ _
    (isOpen_sectorTop_of_isOpen Metric.isOpen_ball) hside_open,
    ⟨Metric.mem_ball_self hε.1, mem_sectorSide_self x⟩, ?_⟩
  have : Metric.ball x ε ∩ sectorSide x ∩ (W ∩ {0}ᶜ) = Metric.ball x ε ∩ sectorSide x ∩ {0}ᶜ := by
    rw [← inter_assoc, inter_eq_left.2 hεW]
  rw [this]
  exact @IsConnected.isPreconnected ℂ sectorTop _ (@IsPathConnected.isConnected ℂ sectorTop _
    (isPathConnected_ball_inter_sectorSide_diff x hε))

theorem induced_compl_zero_sectorTop :
    TopologicalSpace.induced (Subtype.val : ({0}ᶜ : Set ℂ) → ℂ) sectorTop =
      TopologicalSpace.induced (Subtype.val : ({0}ᶜ : Set ℂ) → ℂ) inferInstance :=
  induced_eq_of_nhds_eq fun _ he => nhds_sectorTop_of_ne he

/-! #### The geometry of `𝔻_∞` over the sector -/

theorem qDisc_radial (d : DInfty) (t : I) : qDisc (DInfty.radial d t) = (t : ℂ) * qDisc d := by
  unfold DInfty.radial
  split_ifs with h
  · simp only [qDisc, DInfty.cplx]
    push_cast
    ring
  · have h0 : (t : ℝ) * d.r = 0 :=
      le_antisymm (not_lt.1 h) (mul_nonneg t.2.1 d.r_nonneg)
    rw [show qDisc DInfty.apex = 0 from DInfty.cplx_apex 1]
    refine (norm_eq_zero.1 ?_).symm
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg t.2.1, DInfty.norm_cplx, h0]

theorem smul_mem_sectorSet {z : ℂ} (hz : z ∈ sectorSet) {t : ℝ} (ht : 0 ≤ t) :
    (t : ℂ) * z ∈ sectorSet := by
  rcases ht.lt_or_eq with ht' | rfl
  · rcases hz with rfl | hz
    · left; simp
    · right; show 0 < ((t : ℂ) * z).re
      rw [Complex.re_ofReal_mul]; exact mul_pos ht' hz
  · left; simp

theorem logChart_im_ne_pi {w : ℂ} (h : 0 < (qDisc (DInfty.logChart w)).re) : w.im ≠ Real.pi := by
  intro hw
  rw [qDisc_logChart, Complex.exp_re, hw, Real.cos_pi] at h
  have := Real.exp_pos w.re
  linarith

/-- In `𝔻_∞`, the preimage of the open half-plane is not connected: it contains the two points
`ψ(0)` and `ψ(2πi)` over `1`, separated by `ψ{Im < π}` and `ψ{Im > π}`. -/
theorem not_isPreconnected_qDisc_preimage_re_pos :
    ¬ IsPreconnected (qDisc ⁻¹' {z : ℂ | 0 < z.re}) := by
  intro h
  have hemb := DInfty.isOpenEmbedding_logChart
  have hU₁ : IsOpen (DInfty.logChart '' {w : ℂ | w.im < Real.pi}) :=
    hemb.isOpenMap _ (isOpen_lt Complex.continuous_im continuous_const)
  have hU₂ : IsOpen (DInfty.logChart '' {w : ℂ | Real.pi < w.im}) :=
    hemb.isOpenMap _ (isOpen_lt continuous_const Complex.continuous_im)
  have hcov : qDisc ⁻¹' {z : ℂ | 0 < z.re} ⊆ DInfty.logChart '' {w : ℂ | w.im < Real.pi} ∪
      DInfty.logChart '' {w : ℂ | Real.pi < w.im} := by
    intro d hd
    have hdr : 0 < d.r := by
      rcases d.pos_or_eq_apex with h' | rfl
      · exact h'
      · exfalso
        have : qDisc DInfty.apex = 0 := DInfty.cplx_apex 1
        have hd' : 0 < (qDisc DInfty.apex).re := hd
        rw [this] at hd'; simp at hd'
    obtain ⟨w, rfl⟩ : d ∈ range DInfty.logChart := by rw [DInfty.range_logChart]; exact hdr
    rcases lt_or_gt_of_ne (logChart_im_ne_pi hd) with hlt | hgt
    · exact Or.inl ⟨w, hlt, rfl⟩
    · exact Or.inr ⟨w, hgt, rfl⟩
  have h1 : DInfty.logChart 0 ∈ qDisc ⁻¹' {z : ℂ | 0 < z.re} := by
    show 0 < (qDisc (DInfty.logChart 0)).re
    rw [qDisc_logChart, Complex.exp_zero]; norm_num
  have h2 : DInfty.logChart (2 * Real.pi * Complex.I) ∈ qDisc ⁻¹' {z : ℂ | 0 < z.re} := by
    show 0 < (qDisc (DInfty.logChart (2 * Real.pi * Complex.I))).re
    rw [qDisc_logChart, Complex.exp_two_pi_mul_I]; norm_num
  obtain ⟨d, -, ⟨w₁, hw₁, rfl⟩, ⟨w₂, hw₂, hw⟩⟩ := h _ _ hU₁ hU₂ hcov
    ⟨_, h1, ⟨0, by simp [Real.pi_pos], rfl⟩⟩
    ⟨_, h2, ⟨2 * Real.pi * Complex.I, by simp; linarith [Real.pi_pos], rfl⟩⟩
  have := hemb.injective hw
  subst this
  exact lt_irrefl _ (lt_trans (show Real.pi < w₂.im from hw₂) (show w₂.im < Real.pi from hw₁))

/-- **The sector counterexample, core**: for any spread `p : X → ℂ` isomorphic over `ℂ` to
`q : 𝔻_∞ → ℂ`, `p⁻¹(ℂ ∖ {0})` is not portly for `p^*T`, `T = sectorTop`. The preimage `W` of the
sector `{0} ∪ {Re > 0}` is `p^*T`-open (a component, being connected) and `p^*T`-connected
(radial paths through the branch point), while `W ∖ p⁻¹(0) = p⁻¹{Re > 0}` is not even connected
for the topology of `X` (it falls into infinitely many sheets). -/
theorem not_isPortly_of_homeomorph_qDisc {X : Type*} [TopologicalSpace X] {p : X → ℂ}
    (Φ : X ≃ₜ DInfty) (hΦ : ∀ e, qDisc (Φ e) = p e) :
    ¬ @IsPortly X (strongPullTop p sectorTop) (p ⁻¹' ({0}ᶜ : Set ℂ)) := by
  intro hP
  set W := p ⁻¹' sectorSet with hWdef
  set x₀ := Φ.symm DInfty.apex with hx₀
  have hpx₀ : p x₀ = 0 := by rw [← hΦ, hx₀, Φ.apply_symm_apply]; exact DInfty.cplx_apex 1
  have hx₀W : x₀ ∈ W := by show p x₀ ∈ sectorSet; rw [hpx₀]; exact mem_insert _ _
  -- the radial path from `x₀` to `w ∈ W`
  have hjoin : ∀ w ∈ W, @JoinedIn X (strongPullTop p sectorTop) W x₀ w := by
    intro w hw
    let g : C(I, X) := ⟨fun t => Φ.symm (DInfty.radial (Φ w) t),
      Φ.symm.continuous.comp (DInfty.continuous_radial (Φ w))⟩
    have hpg : ∀ t, p (g t) = (t : ℂ) * p w := fun t => by
      show p (Φ.symm (DInfty.radial (Φ w) t)) = _
      rw [← hΦ, Φ.apply_symm_apply, qDisc_radial, hΦ]
    have hgW : ∀ t, g t ∈ W := fun t => by
      show p (g t) ∈ sectorSet
      rw [hpg]; exact smul_mem_sectorSet hw t.2.1
    have hgc : Continuous[_, sectorTop] (p ∘ g) := by
      refine continuous_sectorTop_of_mapsTo (z := 0) ?_ fun t => ?_
      · have : p ∘ g = fun t : I => (t : ℂ) * p w := funext hpg
        rw [this]; fun_prop
      · simp only [sectorSide, if_true, comp_apply]; exact hgW t
    have hg0 : g 0 = x₀ := by
      show Φ.symm (DInfty.radial (Φ w) 0) = x₀; rw [DInfty.radial_zero]
    have hg1 : g 1 = w := by
      show Φ.symm (DInfty.radial (Φ w) 1) = w; rw [DInfty.radial_one, Φ.symm_apply_apply]
    exact ⟨Path.strongOf_sptop g hgc hg0 hg1, fun t => hgW t⟩
  have hWpc : @IsPathConnected X (strongPullTop p sectorTop) W := ⟨x₀, hx₀W, hjoin⟩
  have hWc : @IsPreconnected X (strongPullTop p sectorTop) W :=
    @IsConnected.isPreconnected X (strongPullTop p sectorTop) _
      (@IsPathConnected.isConnected X (strongPullTop p sectorTop) _ hWpc)
  have hWo : IsOpen[strongPullTop p sectorTop] W := by
    have h := isOpen_strongPullTop_connectedComponentIn p sectorTop isOpen_sectorSet_sectorTop hx₀W
    rwa [(isPreconnected_of_le_sptop (strongPullTop_le p sectorTop) hWc).connectedComponentIn
      hx₀W] at h
  have hI := @IsPortly.locallyConnectedIn X (strongPullTop p sectorTop) _ hP W hWo hWc
  have hI' : IsPreconnected (W ∩ p ⁻¹' ({0}ᶜ : Set ℂ)) :=
    isPreconnected_of_le_sptop (strongPullTop_le p sectorTop) hI
  have heq : W ∩ p ⁻¹' ({0}ᶜ : Set ℂ) = Φ ⁻¹' (qDisc ⁻¹' {z : ℂ | 0 < z.re}) := by
    ext w
    simp only [hWdef, sectorSet, mem_inter_iff, mem_preimage, mem_insert_iff, mem_setOf_eq,
      mem_compl_iff, mem_singleton_iff, hΦ]
    constructor
    · rintro ⟨h | h, h0⟩
      · exact absurd h h0
      · exact h
    · intro h; exact ⟨Or.inr h, fun h0 => by rw [h0] at h; simp at h⟩
  rw [heq] at hI'
  have := hI'.image _ Φ.continuous.continuousOn
  rw [Φ.image_preimage] at this
  exact not_isPreconnected_qDisc_preimage_re_pos this

/-! #### `\widetilde ℂ^{0}` is `𝔻_∞` -/

theorem isSkeletal_zero_complex : IsSkeletal ({0} : Set ℂ) :=
  isSkeletal_iff.2 isPortly_compl_zero_complex

theorem slsc_compl_zero_complex : SemilocallySimplyConnected (({0} : Set ℂ)ᶜ : Set ℂ) :=
  semilocallySimplyConnected_of_isOpen isOpen_compl_singleton

theorem isSLSCInCC_compl_zero_complex : IsSLSCInCC (({0} : Set ℂ)ᶜ : Set ℂ) := by
  have h := isSLSCInCC_compl_submodule (⊥ : Submodule ℝ ℂ) (by simp) bot_ne_top
  simpa using h

/-- **`\widetilde ℂ^{0} ≅ 𝔻_∞`**: the maximal covering of `ℂ` possibly branched over `{0}` is
isomorphic over `ℂ` to `q : 𝔻_∞ → ℂ` (`q⁻¹(ℂ ∖ {0}) ≅ ℂ` through the log-polar chart, simply
connected, so it is the universal covering of `ℂ ∖ {0}`; its completion is `𝔻_∞`;
`maxBranched_unique`). -/
theorem exists_homeomorph_maxBranched_qDisc (y₀ : (({0} : Set ℂ)ᶜ : Set ℂ)) :
    ∃ Φ : MaxBranchedCover ({0} : Set ℂ) y₀ ≃ₜ DInfty, ∀ e, qDisc (Φ e) = e.base := by
  have hO : IsPortly (({0} : Set ℂ)ᶜ : Set ℂ) := isPortly_compl_zero_complex
  have hS := isSkeletal_zero_complex
  have hSc := slsc_compl_zero_complex
  haveI : LocPathConnectedSpace (({0} : Set ℂ)ᶜ : Set ℂ) := hO.isOpen.locPathConnectedSpace
  obtain ⟨hbc, hpb⟩ := isBranchedCovering_qDisc
  have hEo : IsOpen (qDisc ⁻¹' ({0}ᶜ : Set ℂ)) :=
    isOpen_compl_singleton.preimage hbc.isSpread.continuous
  haveI : LocPathConnectedSpace (qDisc ⁻¹' ({0}ᶜ : Set ℂ)) := hEo.locPathConnectedSpace
  have hrange : range DInfty.logChart = qDisc ⁻¹' ({0}ᶜ : Set ℂ) := by
    rw [DInfty.range_logChart, preimage_qDisc_compl_zero]
  let ψ : ℂ ≃ₜ (qDisc ⁻¹' ({0}ᶜ : Set ℂ)) :=
    DInfty.isOpenEmbedding_logChart.isEmbedding.toHomeomorph.trans (Homeomorph.setCongr hrange)
  haveI : ContractibleSpace (qDisc ⁻¹' ({0}ᶜ : Set ℂ)) := ψ.symm.contractibleSpace
  have hcov : IsCoveringMap (({0}ᶜ : Set ℂ).restrictPreimage qDisc) :=
    isCoveringMapOn_qDisc.isCoveringMap_restrictPreimage
  obtain ⟨w, hw⟩ := y₀
  have hq1 : qDisc (DInfty.ofCplx 1 w) = w := DInfty.cplx_ofCplx one_ne_zero w
  have hd : qDisc (DInfty.ofCplx 1 w) ∈ ({0}ᶜ : Set ℂ) := by
    rw [hq1]; exact hw
  have hd₀ : ({0}ᶜ : Set ℂ).restrictPreimage qDisc ⟨DInfty.ofCplx 1 w, hd⟩ = ⟨w, hw⟩ :=
    Subtype.ext hq1
  obtain ⟨Φu, -, hΦu⟩ := UniversalCover.exists_homeomorph_of_simplyConnected
    (y₀ := (⟨w, hw⟩ : (({0} : Set ℂ)ᶜ : Set ℂ))) hSc hcov hd₀
  have h₁ := hbc.isSpreadCompletion_preimage hO
  have h₂ := (maxBranched_basic hS hSc ⟨w, hw⟩).1
  have hcomm : ∀ a, univCoverProj ({0} : Set ℂ) ⟨w, hw⟩ (Φu.symm a) =
      id ((qDisc ∘ ((↑) : qDisc ⁻¹' ({0}ᶜ : Set ℂ) → DInfty)) a) := fun a => by
    have := congrFun hΦu (Φu.symm a)
    simp only [comp_apply, Homeomorph.apply_symm_apply] at this
    show ((UniversalCover.proj (({0} : Set ℂ)ᶜ : Set ℂ) ⟨w, hw⟩ (Φu.symm a) : ℂ)) = qDisc a
    rw [← this]; rfl
  obtain ⟨Ψ, ⟨hΨc, hΨp, -⟩, -⟩ := h₁.toIsFoxCompletion.existsUnique_extend
    h₂.toIsFoxCompletion continuous_id Φu.symm.continuous hcomm
  exact maxBranched_unique hS hSc ⟨w, hw⟩ hbc hpb hΨc hΨp

/-- The printed statement of `lem:spread_top` (`RamcovGX.tex:1990`) WITH the hypothesis the
corrected form adds (`p⁻¹(R)` connected, `_hRc`), and with the conclusion weakened to "(c) or
(e)". It is FALSE (`not_spreadTopConnCE`): (c) and (e) need more than the printed hypotheses
plus connectedness — exactly `StrongLocallyConnectedOrd` (`isPortly_strongPullTop_iff_local`). -/
def SpreadTopConnCE : Prop :=
  ∀ {M : Type u} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
    [FirstCountableTopology M] [ConnectedSpace M] {S : Set M} (_hS : IsSkeletal S)
    (_hSc : SemilocallySimplyConnected (Sᶜ : Set M)) (_hrel : IsSLSCInCC (Sᶜ : Set M))
    (y₀ : (Sᶜ : Set M)) {N : Type v} [tN : TopologicalSpace N] {p : MaxBranchedCover S y₀ → N}
    {q : N → M} (_hp : IsBranchedCovering p) (_hq : IsBranchedCovering q)
    (_hqp : ∀ e, q (p e) = e.base) {R : Set N} (_hR : R ⊆ ordY p) (T : TopologicalSpace N)
    (_hTle : T ≤ tN) (_hT1 : @FirstCountableTopology N T) (_hT2 : @LocPathConnectedSpace N T)
    (_hTdeck : ∀ f ∈ @deckMapsOf N M tN q, Continuous[T, T] f) (_hRT : @IsPortly N T R)
    (_hRagree : TopologicalSpace.induced (Subtype.val : R → N) T =
      TopologicalSpace.induced (Subtype.val : R → N) tN) (_hRc : IsPreconnected (p ⁻¹' R)),
    @IsPortly _ (strongPullTop p T) (p ⁻¹' R) ∨ @IsBranchedCovering _ _ (strongPullTop p T) T p

/-- The base point `1` of `ℂ ∖ {0}`. -/
def oneCompl : (({0} : Set ℂ)ᶜ : Set ℂ) := ⟨1, one_ne_zero⟩

theorem ordY_maxBranched_zero (y₀ : (({0} : Set ℂ)ᶜ : Set ℂ)) :
    ({0}ᶜ : Set ℂ) ⊆ ordY (SpreadEnd.base : MaxBranchedCover ({0} : Set ℂ) y₀ → ℂ) := by
  obtain ⟨-, -, hβS, -, -, -⟩ :=
    maxBranched_basic isSkeletal_zero_complex slsc_compl_zero_complex y₀
  intro y hy
  by_contra h
  exact hy (hβS h)

theorem continuous_deck_id_sectorTop :
    ∀ f ∈ @deckMapsOf ℂ ℂ _ id, Continuous[sectorTop, sectorTop] f := by
  rintro f ⟨γ, hγ, rfl⟩
  have : (γ : ℂ → ℂ) = id := hγ
  rw [this]; exact @continuous_id ℂ sectorTop

/-- **The sector counterexample to `lem:spread_top` (c) and (e)** (DEC-27; it formalizes the
finding on the Claim's l.2029): `M = N = ℂ`, `S = {0}`, `\widetilde M^S → ℂ` the logarithmic
covering completed at `0` (`≅ 𝔻_∞`, `exists_homeomorph_maxBranched_qDisc`), `q = id`,
`R = ℂ ∖ {0}`, and `T = sectorTop`, whose neighbourhoods of `0` are `{0} ∪ (disc ∩ {Re > 0})`.
Every hypothesis of `spread_top_corrected` holds, the added `p⁻¹(R)` connected included, and
* (c) fails: `p⁻¹(R)` is not `p^*T`-portly;
* (e) fails: `p` is not a branched covering for `p^*T` and `T`;
* the Claim's local hypothesis `StrongLocallyConnectedOrd` fails.
The preimage of the sector is `p^*T`-open and `p^*T`-connected through the branch point, and its
regular part `p⁻¹{Re > 0}` falls into infinitely many sheets. -/
theorem cex_spread_top_sector :
    let p := (SpreadEnd.base : MaxBranchedCover ({0} : Set ℂ) oneCompl → ℂ)
    sectorTop ≤ (inferInstance : TopologicalSpace ℂ) ∧ @FirstCountableTopology ℂ sectorTop ∧
      @LocPathConnectedSpace ℂ sectorTop ∧ @IsPortly ℂ sectorTop ({0}ᶜ : Set ℂ) ∧
      TopologicalSpace.induced (Subtype.val : ({0}ᶜ : Set ℂ) → ℂ) sectorTop =
        TopologicalSpace.induced (Subtype.val : ({0}ᶜ : Set ℂ) → ℂ) inferInstance ∧
      IsPreconnected (p ⁻¹' ({0}ᶜ : Set ℂ)) ∧
      ¬ @IsPortly _ (strongPullTop p sectorTop) (p ⁻¹' ({0}ᶜ : Set ℂ)) ∧
      ¬ @IsBranchedCovering _ _ (strongPullTop p sectorTop) sectorTop p ∧
      ¬ StrongLocallyConnectedOrd sectorTop p ({0}ᶜ : Set ℂ) := by
  intro p
  obtain ⟨-, hβbc, -, -, -, -⟩ :=
    maxBranched_basic isSkeletal_zero_complex slsc_compl_zero_complex oneCompl
  obtain ⟨Φ, hΦ⟩ := exists_homeomorph_maxBranched_qDisc oneCompl
  have hnc := not_isPortly_of_homeomorph_qDisc Φ hΦ
  have hc := (spread_top_corrected isSkeletal_zero_complex slsc_compl_zero_complex
    isSLSCInCC_compl_zero_complex oneCompl (p := p) (q := id) hβbc isBranchedCovering_id
    (fun _ => rfl) (ordY_maxBranched_zero oneCompl) (inf_le_left : sectorTop ≤ _)
    firstCountable_sectorTop locPathConnected_sectorTop continuous_deck_id_sectorTop
    isPortly_compl_zero_sectorTop induced_compl_zero_sectorTop).2.2.1
  refine ⟨inf_le_left, firstCountable_sectorTop, locPathConnected_sectorTop,
    isPortly_compl_zero_sectorTop, induced_compl_zero_sectorTop,
    isPreconnected_preimage_of_isPortly hβbc isPortly_compl_zero_complex, hnc, fun h => hnc ?_,
    fun h => hnc (hc.2 h)⟩
  exact @IsBranchedCovering.isPortly_preimage _ _ (strongPullTop p sectorTop) sectorTop p h _
    isPortly_compl_zero_sectorTop

/-- **`lem:spread_top` (c), (e) are false even with `p⁻¹(R)` connected** (DEC-27):
`cex_spread_top_sector` satisfies every hypothesis of `SpreadTopConnCE`. -/
theorem not_spreadTopConnCE : ¬ SpreadTopConnCE.{0, 0} := by
  intro H
  obtain ⟨-, hβbc, -, -, -, -⟩ :=
    maxBranched_basic isSkeletal_zero_complex slsc_compl_zero_complex oneCompl
  obtain ⟨-, -, -, -, -, hRc, hnc, hne, -⟩ := cex_spread_top_sector
  rcases H isSkeletal_zero_complex slsc_compl_zero_complex isSLSCInCC_compl_zero_complex oneCompl
    (p := SpreadEnd.base) (q := id) hβbc isBranchedCovering_id (fun _ => rfl)
    (ordY_maxBranched_zero oneCompl) sectorTop inf_le_left firstCountable_sectorTop
    locPathConnected_sectorTop continuous_deck_id_sectorTop isPortly_compl_zero_sectorTop
    induced_compl_zero_sectorTop hRc with h | h
  · exact hnc h
  · exact hne h

/-- The statement of `lem:spread_top` (c) ∨ (e) under EVERY hypothesis of `spread_top_of_local`
except the local one `StrongLocallyConnectedOrd`: the printed hypotheses, `N → M` Galoisian
(`_hq`), `N` Hausdorff, locally path-connected, first countable, and `p⁻¹(R)` connected. It is
FALSE (`not_spreadTopGalConnCE`): the hypothesis `StrongLocallyConnectedOrd` of
`spread_top_of_local` cannot be dropped, and Galoisianity of `N → M` does not supply it. -/
def SpreadTopGalConnCE : Prop :=
  ∀ {M : Type u} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
    [FirstCountableTopology M] [ConnectedSpace M] {S : Set M} (_hS : IsSkeletal S)
    (_hSc : SemilocallySimplyConnected (Sᶜ : Set M)) (_hrel : IsSLSCInCC (Sᶜ : Set M))
    (y₀ : (Sᶜ : Set M)) {N : Type v} [tN : TopologicalSpace N] [T2Space N]
    [LocPathConnectedSpace N] [FirstCountableTopology N] {p : MaxBranchedCover S y₀ → N}
    {q : N → M} (_hp : IsBranchedCovering p) (_hq : IsGaloisian q)
    (_hqp : ∀ e, q (p e) = e.base) {R : Set N} (_hR : R ⊆ ordY p) (T : TopologicalSpace N)
    (_hTle : T ≤ tN) (_hT1 : @FirstCountableTopology N T) (_hT2 : @LocPathConnectedSpace N T)
    (_hTdeck : ∀ f ∈ @deckMapsOf N M tN q, Continuous[T, T] f) (_hRT : @IsPortly N T R)
    (_hRagree : TopologicalSpace.induced (Subtype.val : R → N) T =
      TopologicalSpace.induced (Subtype.val : R → N) tN) (_hRc : IsPreconnected (p ⁻¹' R)),
    @IsPortly _ (strongPullTop p T) (p ⁻¹' R) ∨ @IsBranchedCovering _ _ (strongPullTop p T) T p

/-- **The local hypothesis of `spread_top_of_local` is necessary** (DEC-27): the sector
counterexample (`cex_spread_top_sector`, `q = id`, which is Galoisian) satisfies every hypothesis
of `SpreadTopGalConnCE`. -/
theorem not_spreadTopGalConnCE : ¬ SpreadTopGalConnCE.{0, 0} := by
  intro H
  obtain ⟨-, hβbc, -, -, -, -⟩ :=
    maxBranched_basic isSkeletal_zero_complex slsc_compl_zero_complex oneCompl
  obtain ⟨-, -, -, -, -, hRc, hnc, hne, -⟩ := cex_spread_top_sector
  rcases H isSkeletal_zero_complex slsc_compl_zero_complex isSLSCInCC_compl_zero_complex oneCompl
    (p := SpreadEnd.base) (q := id) hβbc isGaloisian_id_sptop (fun _ => rfl)
    (ordY_maxBranched_zero oneCompl) sectorTop inf_le_left firstCountable_sectorTop
    locPathConnected_sectorTop continuous_deck_id_sectorTop isPortly_compl_zero_sectorTop
    induced_compl_zero_sectorTop hRc with h | h
  · exact hnc h
  · exact hne h

end CexSector

/-! ### `rem:hypothesis_model_spaces_necessary`: the counterexample on the massive particle (WP-40d)

The remark's own instance (`RamcovGX.tex:2137–2146`), built: the spinless massive particle
`𝔼^{1,2}_α = Γ_α\(𝔻_∞ × ℝ)` (`ex:quotient_base`, `GX.massive_particle_isom0`, DEC-47's
developing map, DEC-74's family), `α ∈ ℝ₊ ∖ {0, 2π}`, its singular locus (the axis), its maximal
covering (the cylinder), the BTZ tamifying topology `T` of `sec:mot_BTZ` (`hornTop`, equal to the
printed `btzGenTop`) and the messed-up `T'` (`tamTop (0, ∞)`), all transported to
`\widetilde{𝔼_α}`. -/

section MassiveCounterexample

open scoped Real

section HornTop

/-- The function `rθ²` on the cylinder `𝔻_∞ × ℝ` (`0` on the axis). -/
def hornFn (x : DInfty × ℝ) : ℝ := x.1.r * x.1.θ ^ 2

theorem hornFn_nonneg (x : DInfty × ℝ) : 0 ≤ hornFn x := mul_nonneg x.1.r_nonneg (sq_nonneg _)

@[simp] theorem hornFn_apex (t : ℝ) : hornFn (DInfty.apex, t) = 0 := by simp [hornFn]

theorem hornFn_of_eq_apex {x : DInfty × ℝ} (hx : x.1 = DInfty.apex) : hornFn x = 0 := by
  simp [hornFn, hx]

/-- On `{r > 0}`, `rθ²` is continuous for the natural topology. -/
theorem continuousAt_hornFn_of_pos {x : DInfty × ℝ} (hx : 0 < x.1.r) : ContinuousAt hornFn x := by
  obtain ⟨p, t⟩ := x
  obtain ⟨q, rfl⟩ : p ∈ range DInfty.posEmb := by rw [DInfty.range_posEmb]; exact hx
  have he : IsOpenEmbedding (Prod.map DInfty.posEmb (id : ℝ → ℝ)) :=
    DInfty.isOpenEmbedding_posEmb.prodMap IsOpenEmbedding.id
  have hc : Continuous (hornFn ∘ Prod.map DInfty.posEmb (id : ℝ → ℝ)) := by
    have : hornFn ∘ Prod.map DInfty.posEmb (id : ℝ → ℝ) =
        fun w : {q : ℝ × ℝ // 0 < q.1} × ℝ => w.1.1.1 * w.1.1.2 ^ 2 := by
      funext w; rfl
    rw [this]
    exact (continuous_fst.comp (continuous_subtype_val.comp continuous_fst)).mul
      ((continuous_snd.comp (continuous_subtype_val.comp continuous_fst)).pow 2)
  exact (he.continuousAt_iff (g := hornFn) (x := (q, t))).1 hc.continuousAt

theorem continuousOn_hornFn : ContinuousOn hornFn (cylPos ℝ) := fun _ hx =>
  (continuousAt_hornFn_of_pos hx).continuousWithinAt

/-- **The BTZ tamifying topology** of `sec:mot_BTZ` (`RamcovGX.tex:1949`) on the cylinder
`𝔻_∞ × ℝ`: the topology generated by the natural one and the sets `U_λ = {rθ² < λ}`, `λ > 0` —
here, equivalently, by the natural one and the topology induced by `rθ²` (`hornTop_eq`). -/
@[reducible] def hornTop : TopologicalSpace (DInfty × ℝ) :=
  (inferInstance : TopologicalSpace (DInfty × ℝ)) ⊓ TopologicalSpace.induced hornFn inferInstance

theorem hornTop_le : hornTop ≤ (inferInstance : TopologicalSpace (DInfty × ℝ)) := inf_le_left

theorem nhds_hornTop (x : DInfty × ℝ) :
    @nhds _ hornTop x = 𝓝 x ⊓ comap hornFn (𝓝 (hornFn x)) := by
  rw [nhds_inf, nhds_induced]

theorem nhds_hornTop_of_pos {x : DInfty × ℝ} (hx : 0 < x.1.r) : @nhds _ hornTop x = 𝓝 x := by
  rw [nhds_hornTop]
  exact inf_eq_left.2 (continuousAt_hornFn_of_pos hx).tendsto.le_comap

/-- The BTZ tamifying topology `T` of `sec:mot_BTZ` (`RamcovGX.tex:1953`) as printed, in the
cylinder coordinates: generated by the natural topology and the sets `U_λ = {rθ² < λ}`,
`λ > 0`. -/
@[reducible] def btzGenTop : TopologicalSpace (DInfty × ℝ) :=
  (inferInstance : TopologicalSpace (DInfty × ℝ)) ⊓
    TopologicalSpace.generateFrom {s | ∃ l : ℝ, 0 < l ∧ s = {y | hornFn y < l}}

/-- **`hornTop` is the BTZ tamifying topology `T` of `sec:mot_BTZ`** (`RamcovGX.tex:1953`). -/
theorem hornTop_eq_btzGenTop : hornTop = btzGenTop := by
  refine le_antisymm (le_inf hornTop_le (le_generateFrom ?_)) ?_
  · rintro _ ⟨l, -, rfl⟩
    exact (TopologicalSpace.le_def.1 (inf_le_right : hornTop ≤ _)) _ ⟨Iio l, isOpen_Iio, rfl⟩
  · refine le_of_nhds_le_nhds fun y => ?_
    rw [nhds_hornTop]
    refine le_inf (nhds_mono inf_le_left) (Filter.Tendsto.le_comap ?_)
    rcases y.1.pos_or_eq_apex with hr | hr
    · exact (continuousAt_hornFn_of_pos hr).tendsto.mono_left (nhds_mono inf_le_left)
    · rw [hornFn_of_eq_apex hr]
      refine Metric.nhds_basis_ball.tendsto_right_iff.2 fun ε hε => ?_
      have hU : IsOpen[btzGenTop] {z | hornFn z < ε} :=
        (TopologicalSpace.le_def.1 inf_le_right) _
          (TopologicalSpace.GenerateOpen.basic _ ⟨ε, hε, rfl⟩)
      filter_upwards [@IsOpen.mem_nhds _ btzGenTop _ _ hU (show hornFn y < ε by
        rw [hornFn_of_eq_apex hr]; exact hε)] with z hz
      rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_of_nonneg (hornFn_nonneg z)]
      exact hz

/-- The horn neighbourhoods of an axis point: `{r(1 + θ²) < ε, |t' - t| < ε}`. -/
def hornNhd (t ε : ℝ) : Set (DInfty × ℝ) := {y | y.1.r * (1 + y.1.θ ^ 2) < ε ∧ |y.2 - t| < ε}

theorem hasBasis_nhds_hornTop_apex (t : ℝ) :
    (@nhds _ hornTop (DInfty.apex, t)).HasBasis (fun ε : ℝ => 0 < ε) (hornNhd t) := by
  rw [nhds_hornTop, hornFn_apex, nhds_prod_eq]
  have h1 := (DInfty.hasBasis_nhds_apex.prod (Metric.nhds_basis_ball (x := t))).inf
    ((Metric.nhds_basis_ball (x := (0 : ℝ))).comap hornFn)
  refine h1.to_hasBasis (fun i hi => ?_) (fun ε hε => ?_)
  · refine ⟨min (min i.1.1 i.1.2) i.2, lt_min (lt_min hi.1.1 hi.1.2) hi.2, ?_⟩
    rintro y ⟨hy1, hy2⟩
    have hr := y.1.r_nonneg
    have hθ := sq_nonneg y.1.θ
    have hm1 : min (min i.1.1 i.1.2) i.2 ≤ i.1.1 := (min_le_left _ _).trans (min_le_left _ _)
    have hm2 : min (min i.1.1 i.1.2) i.2 ≤ i.1.2 := (min_le_left _ _).trans (min_le_right _ _)
    have hm3 : min (min i.1.1 i.1.2) i.2 ≤ i.2 := min_le_right _ _
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · show y.1.r < i.1.1
      nlinarith
    · show y.2 ∈ Metric.ball t i.1.2
      rw [Metric.mem_ball, Real.dist_eq]; linarith
    · show hornFn y ∈ Metric.ball 0 i.2
      rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_of_nonneg (hornFn_nonneg y)]
      unfold hornFn; nlinarith
  · refine ⟨((ε / 2, ε), ε / 2), ⟨⟨by positivity, hε⟩, by positivity⟩, ?_⟩
    rintro y ⟨⟨hy1, hy2⟩, hy3⟩
    have hy1' : y.1.r < ε / 2 := hy1
    have hy2' : dist y.2 t < ε := hy2
    have hy3' : dist (hornFn y) 0 < ε / 2 := hy3
    rw [Real.dist_eq, sub_zero, abs_of_nonneg (hornFn_nonneg y)] at hy3'
    rw [Real.dist_eq] at hy2'
    refine ⟨?_, hy2'⟩
    unfold hornFn at hy3'
    nlinarith


/-- The natural boxes around an axis point: `{r < ε, |t' - t| < ε}`. -/
def axisBox (t ε : ℝ) : Set (DInfty × ℝ) := {y | y.1.r < ε ∧ |y.2 - t| < ε}

theorem hasBasis_nhds_apex_prod (t : ℝ) :
    (𝓝 (DInfty.apex, t)).HasBasis (fun ε : ℝ => 0 < ε) (axisBox t) := by
  rw [nhds_prod_eq]
  refine (DInfty.hasBasis_nhds_apex.prod (Metric.nhds_basis_ball (x := t))).to_hasBasis
    (fun i hi => ⟨min i.1 i.2, lt_min hi.1 hi.2, fun y hy => ⟨?_, ?_⟩⟩) fun ε hε =>
      ⟨(ε, ε), ⟨hε, hε⟩, fun y hy => ⟨hy.1, ?_⟩⟩
  · exact lt_of_lt_of_le hy.1 (min_le_left _ _)
  · show dist y.2 t < i.2
    rw [Real.dist_eq]; exact lt_of_lt_of_le hy.2 (min_le_right _ _)
  · have : dist y.2 t < ε := hy.2
    rwa [Real.dist_eq] at this

theorem isOpen_axisBox (t ε : ℝ) : IsOpen (axisBox t ε) :=
  ((DInfty.isOpen_r_lt ε).preimage continuous_fst).inter
    (isOpen_lt ((continuous_abs.comp (continuous_snd.sub continuous_const))) continuous_const)

/-- The radial retraction, at fixed height. -/
theorem radial_r_mul_le (p : DInfty) (s : I) :
    (DInfty.radial p s).r * (1 + (DInfty.radial p s).θ ^ 2) ≤ p.r * (1 + p.θ ^ 2) := by
  unfold DInfty.radial
  split_ifs with h
  · show (s : ℝ) * p.r * (1 + p.θ ^ 2) ≤ p.r * (1 + p.θ ^ 2)
    have h1 : (s : ℝ) ≤ 1 := s.2.2
    have h2 : 0 ≤ p.r * (1 + p.θ ^ 2) := mul_nonneg p.r_nonneg (by positivity)
    nlinarith
  · simp only [DInfty.apex_r, zero_mul]
    exact mul_nonneg p.r_nonneg (by positivity)

theorem hornFn_radial (p : DInfty) (s : I) (t : ℝ) :
    hornFn (DInfty.radial p s, t) = s * hornFn (p, t) := by
  unfold hornFn DInfty.radial
  split_ifs with h
  · simp only; ring
  · simp only [DInfty.apex_r, DInfty.apex_θ, zero_mul]
    rcases p.pos_or_eq_apex with hp | hp
    · have : (s : ℝ) = 0 := by
        by_contra hs
        exact h (mul_pos (lt_of_le_of_ne s.2.1 (Ne.symm hs)) hp)
      rw [this, zero_mul]
    · rw [hp]; simp

theorem radial_r_le (p : DInfty) (s : I) : (DInfty.radial p s).r ≤ p.r := by
  rw [DInfty.radial_r]
  have h1 : (s : ℝ) ≤ 1 := s.2.2
  nlinarith [p.r_nonneg]

end HornTop

/-! #### The tamifying topology over `t ∈ W` -/

section TamTop

variable {W : Set ℝ}

/-- `{t ∈ W}`. -/
def tSet (W : Set ℝ) : Set (DInfty × ℝ) := {y | y.2 ∈ W}

theorem isOpen_tSet (hW : IsOpen W) : IsOpen (tSet W) := hW.preimage continuous_snd

/-- The topology generated by the natural one and the restriction of `hornTop` to `{t ∈ W}`
(`rem:hypothesis_model_spaces_necessary`'s `T'` for `W = (0, ∞)`; `hornTop` itself, in effect,
for `W = ℝ`). -/
@[reducible] def tamTop (W : Set ℝ) : TopologicalSpace (DInfty × ℝ) := mixedTop hornTop (tSet W)

theorem tamTop_le (hW : IsOpen W) : tamTop W ≤ (inferInstance : TopologicalSpace (DInfty × ℝ)) :=
  (le_mixedTop hornTop_le (isOpen_tSet hW)).2

theorem hornTop_le_tamTop (hW : IsOpen W) : hornTop ≤ tamTop W :=
  (le_mixedTop hornTop_le (isOpen_tSet hW)).1

theorem nhds_tamTop_of_mem (hW : IsOpen W) {y : DInfty × ℝ} (hy : y.2 ∈ W) :
    @nhds _ (tamTop W) y = @nhds _ hornTop y :=
  nhds_mixedTop_of_mem hornTop_le (isOpen_tSet hW) hy

theorem nhds_tamTop_of_notMem {y : DInfty × ℝ} (hy : y.2 ∉ W) :
    @nhds _ (tamTop W) y = 𝓝 y :=
  nhds_mixedTop_of_notMem (T := hornTop) (V := tSet W) hy

theorem nhds_tamTop_of_pos (hW : IsOpen W) {y : DInfty × ℝ} (hy : 0 < y.1.r) :
    @nhds _ (tamTop W) y = 𝓝 y := by
  by_cases h : y.2 ∈ W
  · rw [nhds_tamTop_of_mem hW h, nhds_hornTop_of_pos hy]
  · exact nhds_tamTop_of_notMem h

theorem isOpen_tamTop_of_isOpen (hW : IsOpen W) {U : Set (DInfty × ℝ)} (hU : IsOpen U) :
    IsOpen[tamTop W] U :=
  (TopologicalSpace.le_def.1 (tamTop_le hW)) U hU

/-- Continuity into `tamTop W`: natural continuity and continuity of `rθ²`. -/
theorem continuous_tamTop_of (hW : IsOpen W) {Z : Type*} [TopologicalSpace Z]
    {f : Z → DInfty × ℝ} (hf : Continuous f) (hh : Continuous (hornFn ∘ f)) :
    Continuous[_, tamTop W] f :=
  continuous_le_rng (hornTop_le_tamTop hW) (continuous_inf_rng.2 ⟨hf, continuous_induced_rng.2 hh⟩)

theorem continuous_tamTop_of_mapsTo (hW : IsOpen W) {Z : Type*} [TopologicalSpace Z]
    {f : Z → DInfty × ℝ} (hf : Continuous f) (hP : ∀ z, f z ∈ cylPos ℝ) :
    Continuous[_, tamTop W] f :=
  continuous_tamTop_of hW hf (continuousOn_hornFn.comp_continuous hf hP)

/-- A natural path-connected subset of `{r > 0}` is `tamTop`-path-connected. -/
theorem isPathConnected_tamTop_of_subset (hW : IsOpen W) {A : Set (DInfty × ℝ)}
    (hA : A ⊆ cylPos ℝ) (h : IsPathConnected A) : @IsPathConnected _ (tamTop W) A := by
  obtain ⟨x, hx, hj⟩ := h
  refine ⟨x, hx, fun y hy => ?_⟩
  obtain ⟨γ, hγ⟩ := hj hy
  exact ⟨@Path.mk _ (tamTop W) x y (@ContinuousMap.mk _ _ _ (tamTop W) γ
    (continuous_tamTop_of_mapsTo hW γ.continuous fun t => hA (hγ t))) γ.source γ.target, hγ⟩

/-- The vertical path along the axis. -/
def axisPath (t t' : ℝ) : C(I, DInfty × ℝ) :=
  ⟨fun s => (DInfty.apex, t + s * (t' - t)), continuous_const.prodMk
    (continuous_const.add (continuous_subtype_val.mul continuous_const))⟩

/-- The radial path at height `t`. -/
def radPath (p : DInfty) (t : ℝ) : C(I, DInfty × ℝ) :=
  ⟨fun s => (DInfty.radial p s, t), (DInfty.continuous_radial p).prodMk continuous_const⟩

/-- A set containing `(apex, t)`, closed under the radial retraction at fixed height and under
the vertical segments from `(apex, t)`, is `tamTop`-path-connected. -/
theorem isPathConnected_tamTop_of_star (hW : IsOpen W) {S : Set (DInfty × ℝ)} {t : ℝ}
    (h0 : (DInfty.apex, t) ∈ S) (hrad : ∀ z ∈ S, ∀ s : I, (DInfty.radial z.1 s, z.2) ∈ S)
    (hvert : ∀ z ∈ S, ∀ s : I, (DInfty.apex, t + s * (z.2 - t)) ∈ S) :
    @IsPathConnected _ (tamTop W) S := by
  refine ⟨(DInfty.apex, t), h0, fun z hz => ?_⟩
  have hc1 : Continuous[_, tamTop W] (axisPath t z.2) :=
    continuous_tamTop_of hW (axisPath t z.2).continuous (by
      have : hornFn ∘ (axisPath t z.2) = fun _ => 0 := funext fun s => hornFn_apex _
      rw [this]; exact continuous_const)
  have hc2 : Continuous[_, tamTop W] (radPath z.1 z.2) :=
    continuous_tamTop_of hW (radPath z.1 z.2).continuous (by
      have : hornFn ∘ (radPath z.1 z.2) = fun s : I => (s : ℝ) * hornFn (z.1, z.2) :=
        funext fun s => hornFn_radial z.1 s z.2
      rw [this]; exact continuous_subtype_val.mul continuous_const)
  have j1 : @JoinedIn _ (tamTop W) S (DInfty.apex, t) (DInfty.apex, z.2) :=
    ⟨@Path.mk _ (tamTop W) _ _ (@ContinuousMap.mk _ _ _ (tamTop W) (axisPath t z.2) hc1)
      (by simp [axisPath]) (by simp [axisPath]), fun s => hvert z hz s⟩
  have j2 : @JoinedIn _ (tamTop W) S (DInfty.apex, z.2) z :=
    ⟨@Path.mk _ (tamTop W) _ _ (@ContinuousMap.mk _ _ _ (tamTop W) (radPath z.1 z.2) hc2)
      (by simp [radPath, DInfty.radial_zero]) (by simp [radPath, DInfty.radial_one]),
      fun s => hrad z hz s⟩
  exact @JoinedIn.trans _ (tamTop W) _ _ _ _ j1 j2

theorem isPathConnected_hornNhd (hW : IsOpen W) (t : ℝ) {ε : ℝ} (hε : 0 < ε) :
    @IsPathConnected _ (tamTop W) (hornNhd t ε) := by
  refine isPathConnected_tamTop_of_star hW (t := t) ⟨by simpa using hε, by simpa using hε⟩
    (fun z hz s => ⟨lt_of_le_of_lt (radial_r_mul_le z.1 s) hz.1, hz.2⟩) fun z hz s => ⟨?_, ?_⟩
  · simpa using hε
  · show |t + s * (z.2 - t) - t| < ε
    have h1 : (s : ℝ) ≤ 1 := s.2.2
    have h0 : (0 : ℝ) ≤ s := s.2.1
    rw [add_sub_cancel_left, abs_mul, abs_of_nonneg h0]
    have := hz.2
    nlinarith [abs_nonneg (z.2 - t)]

theorem isPathConnected_axisBox (hW : IsOpen W) (t : ℝ) {ε : ℝ} (hε : 0 < ε) :
    @IsPathConnected _ (tamTop W) (axisBox t ε) := by
  refine isPathConnected_tamTop_of_star hW (t := t) ⟨by simpa using hε, by simpa using hε⟩
    (fun z hz s => ⟨lt_of_le_of_lt (radial_r_le z.1 s) hz.1, hz.2⟩) fun z hz s => ⟨?_, ?_⟩
  · simpa using hε
  · show |t + s * (z.2 - t) - t| < ε
    have h1 : (s : ℝ) ≤ 1 := s.2.2
    have h0 : (0 : ℝ) ≤ s := s.2.1
    rw [add_sub_cancel_left, abs_mul, abs_of_nonneg h0]
    have := hz.2
    nlinarith [abs_nonneg (z.2 - t)]

theorem locPathConnected_tamTop (hW : IsOpen W) : @LocPathConnectedSpace _ (tamTop W) := by
  haveI : LocPathConnectedSpace (DInfty × ℝ) := locPathConnectedSpace_prod_of
  refine @LocPathConnectedSpace.mk _ (tamTop W) fun y => Filter.hasBasis_self.2 fun s hs => ?_
  rcases y.1.pos_or_eq_apex with hy | hy
  · rw [nhds_tamTop_of_pos hW hy] at hs ⊢
    have hP : s ∩ cylPos ℝ ∈ 𝓝 y :=
      inter_mem hs ((DInfty.isOpen_pos.preimage continuous_fst).mem_nhds hy)
    obtain ⟨V, ⟨hV, hVp⟩, hVs⟩ := (path_connected_basis y).mem_iff.1 hP
    exact ⟨V, hV, isPathConnected_tamTop_of_subset hW (hVs.trans inter_subset_right) hVp,
      hVs.trans inter_subset_left⟩
  · obtain ⟨p, t⟩ := y
    simp only at hy
    subst hy
    by_cases ht : t ∈ W
    · rw [nhds_tamTop_of_mem hW ht] at hs ⊢
      obtain ⟨ε, hε, hεs⟩ := (hasBasis_nhds_hornTop_apex t).mem_iff.1 hs
      exact ⟨hornNhd t ε, (hasBasis_nhds_hornTop_apex t).mem_of_mem hε,
        isPathConnected_hornNhd hW t hε, hεs⟩
    · rw [nhds_tamTop_of_notMem ht] at hs ⊢
      obtain ⟨ε, hε, hεs⟩ := (hasBasis_nhds_apex_prod t).mem_iff.1 hs
      exact ⟨axisBox t ε, (hasBasis_nhds_apex_prod t).mem_of_mem hε,
        isPathConnected_axisBox hW t hε, hεs⟩

theorem firstCountable_tamTop (hW : IsOpen W) : @FirstCountableTopology _ (tamTop W) := by
  refine @FirstCountableTopology.mk _ (tamTop W) fun y => ?_
  by_cases h : y.2 ∈ W
  · rw [nhds_tamTop_of_mem hW h, nhds_hornTop]; infer_instance
  · rw [nhds_tamTop_of_notMem h]; infer_instance


/-- `r(1 + θ²) = r + rθ²`, continuous on `{r > 0}`. -/
theorem continuousAt_r_mul_of_pos {x : DInfty × ℝ} (hx : 0 < x.1.r) :
    ContinuousAt (fun y : DInfty × ℝ => y.1.r * (1 + y.1.θ ^ 2)) x := by
  obtain ⟨p, t⟩ := x
  obtain ⟨q, rfl⟩ : p ∈ range DInfty.posEmb := by rw [DInfty.range_posEmb]; exact hx
  have he : IsOpenEmbedding (Prod.map DInfty.posEmb (id : ℝ → ℝ)) :=
    DInfty.isOpenEmbedding_posEmb.prodMap IsOpenEmbedding.id
  have hc : Continuous ((fun y : DInfty × ℝ => y.1.r * (1 + y.1.θ ^ 2)) ∘
      Prod.map DInfty.posEmb (id : ℝ → ℝ)) := by
    have : (fun y : DInfty × ℝ => y.1.r * (1 + y.1.θ ^ 2)) ∘ Prod.map DInfty.posEmb (id : ℝ → ℝ) =
        fun w : {q : ℝ × ℝ // 0 < q.1} × ℝ => w.1.1.1 * (1 + w.1.1.2 ^ 2) := by
      funext w; rfl
    rw [this]
    exact (continuous_fst.comp (continuous_subtype_val.comp continuous_fst)).mul
      (continuous_const.add ((continuous_snd.comp (continuous_subtype_val.comp continuous_fst)).pow 2))
  exact (he.continuousAt_iff (x := (q, t))).1 hc.continuousAt

theorem hornNhd_subset {t t' ε : ℝ} :
    hornNhd t' (ε - |t' - t|) ⊆ hornNhd t ε := fun z hz => by
  refine ⟨lt_of_lt_of_le hz.1 (by linarith [abs_nonneg (t' - t)]), ?_⟩
  calc |z.2 - t| = |(z.2 - t') + (t' - t)| := by ring_nf
    _ ≤ |z.2 - t'| + |t' - t| := abs_add_le _ _
    _ < ε := by linarith [hz.2]

theorem isOpen_hornNhd_tamTop (hW : IsOpen W) {t ε : ℝ} (hsub : ∀ t', |t' - t| < ε → t' ∈ W) :
    IsOpen[tamTop W] (hornNhd t ε) := by
  refine @isOpen_iff_mem_nhds _ (tamTop W) _ |>.2 fun y hy => ?_
  rcases y.1.pos_or_eq_apex with hr | hr
  · rw [nhds_tamTop_of_pos hW hr]
    have h1 := (continuousAt_r_mul_of_pos hr).preimage_mem_nhds (Iio_mem_nhds hy.1)
    have h2 : {z : DInfty × ℝ | |z.2 - t| < ε} ∈ 𝓝 y :=
      (isOpen_lt (continuous_abs.comp (continuous_snd.sub continuous_const))
        continuous_const).mem_nhds hy.2
    exact inter_mem h1 h2
  · obtain ⟨p, t'⟩ := y
    simp only at hr
    subst hr
    rw [nhds_tamTop_of_mem hW (hsub t' hy.2)]
    exact Filter.mem_of_superset ((hasBasis_nhds_hornTop_apex t').mem_of_mem
      (by linarith [hy.2] : 0 < ε - |t' - t|)) hornNhd_subset

/-- `{0 < r < g(θ), |t' - t| < ε}` is `tamTop`-preconnected, `g` continuous and positive. -/
theorem isPreconnected_tamTop_graph (hW : IsOpen W) (t ε : ℝ) {g : ℝ → ℝ} (hg : Continuous g)
    (hgp : ∀ θ, 0 < g θ) :
    @IsPreconnected _ (tamTop W) {y : DInfty × ℝ | 0 < y.1.r ∧ y.1.r < g y.1.θ ∧ |y.2 - t| < ε} := by
  haveI : PreconnectedSpace (Ioo (0 : ℝ) 1) := Subtype.preconnectedSpace isPreconnected_Ioo
  haveI : PreconnectedSpace (Ioo (t - ε) (t + ε)) := Subtype.preconnectedSpace isPreconnected_Ioo
  set F : Ioo (0 : ℝ) 1 × ℝ × Ioo (t - ε) (t + ε) → DInfty × ℝ := fun w =>
    (DInfty.posEmb ⟨((w.1 : ℝ) * g w.2.1, w.2.1), mul_pos w.1.2.1 (hgp _)⟩, (w.2.2 : ℝ))
  have hFc : Continuous F := by
    refine (DInfty.continuous_posEmb.comp (Continuous.subtype_mk ?_ _)).prodMk
      (continuous_subtype_val.comp (continuous_snd.comp continuous_snd))
    exact ((continuous_subtype_val.comp continuous_fst).mul
      (hg.comp (continuous_fst.comp continuous_snd))).prodMk (continuous_fst.comp continuous_snd)
  have hFt : Continuous[_, tamTop W] F :=
    continuous_tamTop_of_mapsTo hW hFc fun w => mul_pos w.1.2.1 (hgp _)
  have hrange : range F = {y : DInfty × ℝ | 0 < y.1.r ∧ y.1.r < g y.1.θ ∧ |y.2 - t| < ε} := by
    ext y
    constructor
    · rintro ⟨w, rfl⟩
      refine ⟨mul_pos w.1.2.1 (hgp _), ?_, ?_⟩
      · show (w.1 : ℝ) * g w.2.1 < g w.2.1
        have := hgp w.2.1
        nlinarith [w.1.2.2]
      · show |(w.2.2 : ℝ) - t| < ε
        rw [abs_sub_lt_iff]; constructor <;> linarith [w.2.2.2.1, w.2.2.2.2]
    · rintro ⟨h1, h2, h3⟩
      have hg0 := hgp y.1.θ
      refine ⟨(⟨y.1.r / g y.1.θ, div_pos h1 hg0, (div_lt_one hg0).2 h2⟩, y.1.θ,
        ⟨y.2, by rw [abs_sub_lt_iff] at h3; constructor <;> linarith [h3.1, h3.2]⟩), ?_⟩
      refine Prod.ext ?_ rfl
      ext
      · show y.1.r / g y.1.θ * g y.1.θ = y.1.r
        field_simp
      · rfl
  rw [← hrange]
  exact @isPreconnected_range _ _ _ (tamTop W) _ F hFt

theorem dense_cylPos_tamTop (hW : IsOpen W) : @Dense _ (tamTop W) (cylPos ℝ) := by
  have key : ∀ y : DInfty × ℝ, ∀ s ∈ @nhds _ (tamTop W) y, (s ∩ cylPos ℝ).Nonempty := by
    intro y s hs
    rcases y.1.pos_or_eq_apex with hr | hr
    · exact ⟨y, @mem_of_mem_nhds _ (tamTop W) _ _ hs, hr⟩
    · obtain ⟨p, t⟩ := y
      simp only at hr
      subst hr
      have hpt : ∀ ε (hε : 0 < ε), (DInfty.posEmb ⟨(ε / 2, 0), half_pos hε⟩, t) ∈ hornNhd t ε ∩
          axisBox t ε := fun ε hε => by
        refine ⟨⟨?_, by simpa using hε⟩, ?_, by simpa using hε⟩
        · show ε / 2 * (1 + (0 : ℝ) ^ 2) < ε
          linarith
        · show ε / 2 < ε
          linarith
      by_cases ht : t ∈ W
      · rw [nhds_tamTop_of_mem hW ht] at hs
        obtain ⟨ε, hε, hεs⟩ := (hasBasis_nhds_hornTop_apex t).mem_iff.1 hs
        exact ⟨_, hεs (hpt ε hε).1, show (0 : ℝ) < ε / 2 by positivity⟩
      · rw [nhds_tamTop_of_notMem ht] at hs
        obtain ⟨ε, hε, hεs⟩ := (hasBasis_nhds_apex_prod t).mem_iff.1 hs
        exact ⟨_, hεs (hpt ε hε).2, show (0 : ℝ) < ε / 2 by positivity⟩
  intro y
  exact (@mem_closure_iff_nhds _ (tamTop W) _ _).2 fun s hs => by
    obtain ⟨z, hz1, hz2⟩ := key y s hs
    exact ⟨z, hz1, hz2⟩

/-- `(D)` on the cylinder: `{r > 0}` is `tamTop`-portly. -/
theorem isPortly_cylPos_tamTop (hW : IsOpen W) : @IsPortly _ (tamTop W) (cylPos ℝ) := by
  have hd := dense_cylPos_tamTop hW
  have hPo : IsOpen (cylPos ℝ) := DInfty.isOpen_pos.preimage continuous_fst
  refine @IsPortly.mk _ (tamTop W) _ (isOpen_tamTop_of_isOpen hW hPo) hd fun V hV hVc => ?_
  refine @isPreconnected_of_local _ (tamTop W) V (V ∩ cylPos ℝ) hVc inter_subset_left
    (@Dense.open_subset_closure_inter _ (tamTop W) _ _ hd hV) fun x hx => ?_
  rcases x.1.pos_or_eq_apex with hr | hr
  · have hVn : V ∩ cylPos ℝ ∈ 𝓝 x := by
      rw [← nhds_tamTop_of_pos hW hr]
      exact @inter_mem _ _ _ _ (@IsOpen.mem_nhds _ (tamTop W) _ _ hV hx)
        (@IsOpen.mem_nhds _ (tamTop W) _ _ (isOpen_tamTop_of_isOpen hW hPo) hr)
    haveI : LocPathConnectedSpace (DInfty × ℝ) := locPathConnectedSpace_prod_of
    obtain ⟨N, ⟨hNo, hxN, hNp⟩, hNs⟩ := (isOpen_isPathConnected_basis x).mem_iff.1 hVn
    have hNs' : N ⊆ V ∩ cylPos ℝ := hNs
    refine ⟨N, isOpen_tamTop_of_isOpen hW hNo, hxN, ?_⟩
    rw [inter_eq_left.2 hNs']
    exact @IsConnected.isPreconnected _ (tamTop W) _ (@IsPathConnected.isConnected _ (tamTop W) _
      (isPathConnected_tamTop_of_subset hW (hNs'.trans inter_subset_right) hNp))
  · obtain ⟨p, t⟩ := x
    simp only at hr
    subst hr
    by_cases ht : t ∈ W
    · have hVn := @IsOpen.mem_nhds _ (tamTop W) _ _ hV hx
      rw [nhds_tamTop_of_mem hW ht] at hVn
      obtain ⟨ε, hε, hεV⟩ := (hasBasis_nhds_hornTop_apex t).mem_iff.1 hVn
      obtain ⟨δ, hδ, hδW⟩ := Metric.isOpen_iff.1 hW t ht
      set ε' := min ε δ
      have hε' : 0 < ε' := lt_min hε hδ
      have hsub : hornNhd t ε' ⊆ V := fun z hz =>
        hεV ⟨lt_of_lt_of_le hz.1 (min_le_left _ _), lt_of_lt_of_le hz.2 (min_le_left _ _)⟩
      refine ⟨hornNhd t ε', isOpen_hornNhd_tamTop hW fun t' ht' => hδW ?_,
        ⟨by simpa using hε', by simpa using hε'⟩, ?_⟩
      · rw [Metric.mem_ball, Real.dist_eq]; exact lt_of_lt_of_le ht' (min_le_right _ _)
      have heq : hornNhd t ε' ∩ (V ∩ cylPos ℝ) =
          {y : DInfty × ℝ | 0 < y.1.r ∧ y.1.r < ε' / (1 + y.1.θ ^ 2) ∧ |y.2 - t| < ε'} := by
        ext y
        simp only [hornNhd, mem_inter_iff, mem_setOf_eq, cylPos]
        rw [lt_div_iff₀ (by positivity : (0 : ℝ) < 1 + y.1.θ ^ 2)]
        constructor
        · rintro ⟨⟨h1, h2⟩, -, h3⟩; exact ⟨h3, h1, h2⟩
        · rintro ⟨h3, h1, h2⟩; exact ⟨⟨h1, h2⟩, hsub ⟨h1, h2⟩, h3⟩
      rw [heq]
      exact isPreconnected_tamTop_graph hW t ε' (continuous_const.div (continuous_const.add
        (continuous_id.pow 2)) fun θ => (by positivity : (0 : ℝ) < 1 + θ ^ 2).ne')
        fun θ => div_pos hε' (by positivity : (0 : ℝ) < 1 + θ ^ 2)
    · have hVn := @IsOpen.mem_nhds _ (tamTop W) _ _ hV hx
      rw [nhds_tamTop_of_notMem ht] at hVn
      obtain ⟨ε, hε, hεV⟩ := (hasBasis_nhds_apex_prod t).mem_iff.1 hVn
      refine ⟨axisBox t ε, isOpen_tamTop_of_isOpen hW (isOpen_axisBox t ε),
        ⟨by simpa using hε, by simpa using hε⟩, ?_⟩
      have heq : axisBox t ε ∩ (V ∩ cylPos ℝ) =
          {y : DInfty × ℝ | 0 < y.1.r ∧ y.1.r < (fun _ => ε) y.1.θ ∧ |y.2 - t| < ε} := by
        ext y
        simp only [axisBox, mem_inter_iff, mem_setOf_eq, cylPos]
        constructor
        · rintro ⟨⟨h1, h2⟩, -, h3⟩; exact ⟨h3, h1, h2⟩
        · rintro ⟨h3, h1, h2⟩; exact ⟨⟨h1, h2⟩, hεV ⟨h1, h2⟩, h3⟩
      rw [heq]
      exact isPreconnected_tamTop_graph hW t ε continuous_const fun _ => hε


/-! #### `Γ` acts continuously; time translations -/

theorem hornFn_smul {α : ℝ} (k : GammaA α) (y : DInfty × ℝ) :
    hornFn (k • y) = y.1.r * (y.1.θ + k.toInt * α) ^ 2 := by
  rw [DInfty.smul_prod_def, DInfty.smul_def]
  rcases y.1.pos_or_eq_apex with h | h
  · rw [hornFn, DInfty.rot_of_pos h]
  · simp [hornFn, h]

/-- The deck group `Γ_α` acts `hornTop`-continuously. -/
theorem continuous_smul_hornTop {α : ℝ} (k : GammaA α) :
    Continuous[hornTop, hornTop] (fun y : DInfty × ℝ => k • y) := by
  refine continuous_inf_rng.2 ⟨continuous_le_dom hornTop_le (DInfty.continuous_smul_prod k),
    continuous_induced_rng.2 ?_⟩
  refine @continuous_iff_continuousAt _ _ hornTop _ _ |>.2 fun y => ?_
  rcases y.1.pos_or_eq_apex with hr | hr
  · show Tendsto _ (@nhds _ hornTop y) _
    rw [nhds_hornTop_of_pos hr]
    have hr' : 0 < (k • y).1.r := by
      rw [DInfty.smul_prod_def, DInfty.smul_def, DInfty.rot_r]; exact hr
    exact ((continuousAt_hornFn_of_pos hr').comp
      (DInfty.continuous_smul_prod k).continuousAt).tendsto
  · obtain ⟨p, t⟩ := y
    simp only at hr
    subst hr
    show Tendsto _ (@nhds _ hornTop (DInfty.apex, t)) _
    have h0 : (hornFn ∘ fun y : DInfty × ℝ => k • y) (DInfty.apex, t) = 0 := by
      simp only [comp_apply, hornFn_smul, DInfty.apex_r, zero_mul]
    rw [h0]
    set c : ℝ := k.toInt * α
    refine (hasBasis_nhds_hornTop_apex t).tendsto_iff Metric.nhds_basis_ball |>.2 fun ε hε => ?_
    refine ⟨ε / (2 + 2 * c ^ 2), by positivity, fun z hz => ?_⟩
    rw [Metric.mem_ball, Real.dist_eq, sub_zero, comp_apply, hornFn_smul,
      abs_of_nonneg (mul_nonneg z.1.r_nonneg (sq_nonneg _))]
    have h1 := hz.1
    have hr := z.1.r_nonneg
    have hpos : (0 : ℝ) < 2 + 2 * c ^ 2 := by positivity
    rw [lt_div_iff₀ hpos] at h1
    have h2 : (z.1.θ + c) ^ 2 ≤ 2 * z.1.θ ^ 2 + 2 * c ^ 2 := by nlinarith [sq_nonneg (z.1.θ - c)]
    have h3 : z.1.r * (z.1.θ + c) ^ 2 ≤ z.1.r * (2 * z.1.θ ^ 2 + 2 * c ^ 2) :=
      mul_le_mul_of_nonneg_left h2 hr
    nlinarith [sq_nonneg z.1.θ, sq_nonneg c, mul_nonneg hr (sq_nonneg z.1.θ),
      mul_nonneg hr (sq_nonneg c)]

/-- "Since the Galois group acts by 'rotation' around the 'axis' it preserves `T'`". -/
theorem continuous_smul_tamTop {α : ℝ} (k : GammaA α) :
    Continuous[tamTop W, tamTop W] (fun y : DInfty × ℝ => k • y) :=
  continuous_mixedTop_of_preimage_eq (Homeomorph.smul k) (continuous_smul_hornTop k) (by rfl)

/-- The time translation `(p, t) ↦ (p, t + s)` of the cylinder. -/
def timeShift (s : ℝ) : DInfty × ℝ ≃ₜ DInfty × ℝ :=
  (Homeomorph.refl DInfty).prodCongr (Homeomorph.addRight s)

@[simp] theorem timeShift_apply (s : ℝ) (y : DInfty × ℝ) : timeShift s y = (y.1, y.2 + s) := rfl

/-- The time translations are `hornTop`-continuous (the BTZ tamifying topology is invariant under
them). -/
theorem continuous_timeShift_hornTop (s : ℝ) : Continuous[hornTop, hornTop] (timeShift s) :=
  continuous_inf_rng.2 ⟨continuous_le_dom hornTop_le (timeShift s).continuous,
    continuous_induced_rng.2 (by
      have : hornFn ∘ timeShift s = hornFn := funext fun y => rfl
      rw [this]
      exact continuous_le_dom inf_le_right continuous_induced_dom)⟩

/-- At the axis the horn topology is strictly finer than the natural one. -/
theorem nhds_hornTop_apex_ne (t : ℝ) : @nhds _ hornTop (DInfty.apex, t) ≠ 𝓝 (DInfty.apex, t) := by
  intro h
  have h1 : hornNhd t 1 ∈ 𝓝 (DInfty.apex, t) := by
    rw [← h]; exact (hasBasis_nhds_hornTop_apex t).mem_of_mem one_pos
  obtain ⟨ε, hε, hεs⟩ := (hasBasis_nhds_apex_prod t).mem_iff.1 h1
  set e : ℝ := min ε 1 / 2
  have he : 0 < e := by positivity
  have he1 : e ≤ 1 / 2 := by
    have := min_le_right ε 1; simp only [e]; linarith
  have hz : (DInfty.posEmb ⟨(e, 2 / e), he⟩, t) ∈ axisBox t ε :=
    ⟨show e < ε by have := min_le_left ε 1; simp only [e]; linarith, by simpa using hε⟩
  have h2 := (hεs hz).1
  change e * (1 + (2 / e) ^ 2) < 1 at h2
  have h3 : e * (1 + (2 / e) ^ 2) = e + 4 / e := by field_simp; ring
  rw [h3] at h2
  have h4 : 4 / e ≥ 8 := by rw [ge_iff_le, le_div_iff₀ he]; linarith
  linarith

/-- "However, the automorphism group also contains translations along the `t`-axis which send
points from `t < 0` to `t > 0`": the time translation by `2` is not continuous for
`T' = tamTop (0, ∞)`. -/
theorem not_continuous_timeShift_tamTop :
    ¬ Continuous[tamTop (Ioi 0), tamTop (Ioi 0)] (timeShift 2) := by
  refine not_continuous_mixedTop hornTop_le (isOpen_tSet isOpen_Ioi) (timeShift 2)
    (y := (DInfty.apex, -1)) (by norm_num [tSet]) (by norm_num [tSet]) ?_
  have : timeShift 2 (DInfty.apex, -1) = (DInfty.apex, 1) := by
    rw [timeShift_apply]; norm_num
  rw [this]
  exact nhds_hornTop_apex_ne 1

/-! #### `(A)`: the quotient topology -/

/-- A `Γ_α`-invariant `tamTop`-open set is open. -/
theorem isOpen_of_isOpen_tamTop_of_invariant {α : ℝ} (hα : α ≠ 0) (hW : IsOpen W)
    {S : Set (DInfty × ℝ)} (hS : IsOpen[tamTop W] S)
    (hinv : ∀ (k : GammaA α) (y : DInfty × ℝ), y ∈ S → k • y ∈ S) : IsOpen S := by
  refine isOpen_iff_mem_nhds.2 fun y hy => ?_
  have hSn := @IsOpen.mem_nhds _ (tamTop W) _ _ hS hy
  rcases y.1.pos_or_eq_apex with hr | hr
  · rwa [nhds_tamTop_of_pos hW hr] at hSn
  · obtain ⟨p, t⟩ := y
    simp only at hr
    subst hr
    by_cases ht : t ∈ W
    · rw [nhds_tamTop_of_mem hW ht] at hSn
      obtain ⟨ε, hε, hεS⟩ := (hasBasis_nhds_hornTop_apex t).mem_iff.1 hSn
      have hpos : (0 : ℝ) < 1 + α ^ 2 := by positivity
      refine (hasBasis_nhds_apex_prod t).mem_iff.2 ⟨ε / (1 + α ^ 2), div_pos hε hpos,
        fun z hz => ?_⟩
      have hδ : ε / (1 + α ^ 2) ≤ ε := div_le_self hε.le (by nlinarith [sq_nonneg α])
      rcases z.1.pos_or_eq_apex with hzr | hz1
      · set n : ℤ := round (z.1.θ / α)
        set k : GammaA α := GammaA.ofInt n
        have hkz : k • (k⁻¹ • z) = z := smul_inv_smul k z
        rw [← hkz]
        refine hinv k _ (hεS ⟨?_, ?_⟩)
        · have hθ : (k⁻¹ • z).1 = ⟨z.1.r, z.1.θ + (k⁻¹).toInt * α, Or.inl hzr⟩ := by
            rw [DInfty.smul_prod_def, DInfty.smul_def, DInfty.rot_of_pos hzr]
          rw [hθ]
          show z.1.r * (1 + (z.1.θ + (k⁻¹).toInt * α) ^ 2) < ε
          have hki : ((k⁻¹).toInt : ℝ) = -n := by
            show ((-n : ℤ) : ℝ) = -n
            push_cast; ring
          rw [hki]
          have hround := abs_sub_round (z.1.θ / α)
          have hb : (z.1.θ + -n * α) ^ 2 ≤ α ^ 2 / 4 := by
            have : z.1.θ + -n * α = α * (z.1.θ / α - n) := by field_simp; ring
            rw [this, mul_pow]
            have h2 : (z.1.θ / α - n) ^ 2 ≤ (1 / 2) ^ 2 := by
              rw [← sq_abs]
              exact pow_le_pow_left₀ (abs_nonneg _) hround 2
            nlinarith [sq_nonneg α]
          have h1 := hz.1
          rw [lt_div_iff₀ hpos] at h1
          nlinarith [z.1.r_nonneg, sq_nonneg α]
        · show |(k⁻¹ • z).2 - t| < ε
          rw [DInfty.smul_prod_def]
          exact lt_of_lt_of_le hz.2 hδ
      · refine hεS ⟨?_, lt_of_lt_of_le hz.2 hδ⟩
        rw [hz1]; simpa using hε
    · rwa [nhds_tamTop_of_notMem ht] at hSn

/-- `(A)` on the cylinder: `tamTop W` induces on `Γ_α\(𝔻_∞ × ℝ)` its quotient topology. -/
theorem coinduced_orbitMk_tamTop {α : ℝ} (hα : α ≠ 0) (hW : IsOpen W) :
    TopologicalSpace.coinduced (orbitMk (GammaA α)) (tamTop W) =
      (inferInstance : TopologicalSpace (Orbits (GammaA α) (DInfty × ℝ))) := by
  refine le_antisymm (coinduced_mono (tamTop_le hW)) ?_
  refine TopologicalSpace.le_def.2 fun U hU => ?_
  have hU' : IsOpen[tamTop W] (orbitMk (GammaA α) ⁻¹' U) := hU
  exact isOpen_of_isOpen_tamTop_of_invariant hα hW hU' fun k y hy => by
    show orbitMk (GammaA α) (k • y) ∈ U
    rw [orbitMk_smul]; exact hy

end TamTop

/-! #### The massive particle `𝔼^{1,2}_α` and its singular locus -/

section MassiveSing

/-- On the cylinder, a point of the axis is singular for the quotient structure as soon as, near
it, the developing map either separates two points of one orbit or identifies two points of
different orbits (a variant of `GX.apex_notMem_support_of_smul_ne`, covering the angles
`α ∈ 2πℤ`). -/
theorem apex_notMem_support_of_sep {G X Z : Type*} [TopologicalSpace X] [Group G]
    [MulAction G X] [ContinuousConstSMul G X] [LocallyConnectedSpace X] [T2Space X]
    [IsRigidAction G X] [TopologicalSpace Z] [LocallyConnectedSpace Z] {α : ℝ}
    {D : DInfty × Z → X} (hD : IsLocalHomeomorphOn D (cylPos Z))
    {B : Set (OpenPartialHomeomorph (Orbits (GammaA α) (DInfty × Z)) X)}
    (hB : IsMaximalAEAtlas G B)
    (hπ : IsAEMorphismOf G (maximalAEAtlas G (devAtlas G D (cylPos Z))) B (orbitMk (GammaA α)))
    (z₀ : Z)
    (hsep : ∀ ε > 0, ∃ y y' : DInfty × Z, 0 < y.1.r ∧ y.1.r < ε ∧ 0 < y'.1.r ∧ y'.1.r < ε ∧
      y.2 = z₀ ∧ y'.2 = z₀ ∧
      ((orbitMk (GammaA α) y = orbitMk (GammaA α) y' ∧ D y ≠ D y') ∨
        (orbitMk (GammaA α) y ≠ orbitMk (GammaA α) y' ∧ D y = D y'))) :
    orbitMk (GammaA α) (DInfty.apex, z₀) ∉ support B := by
  intro hmem
  have hP := DInfty.isPortly_pos Z
  obtain ⟨φ, hφ, hφs⟩ := mem_support.1 hmem
  have hO : orbitMk (GammaA α) ⁻¹' φ.source ∈ 𝓝 (DInfty.apex, z₀) :=
    continuous_quot_mk.continuousAt.preimage_mem_nhds (φ.open_source.mem_nhds hφs)
  obtain ⟨u, hu, v, hv, huv⟩ := mem_nhds_prod_iff.1 hO
  obtain ⟨ε, hε, hεu⟩ := DInfty.hasBasis_nhds_apex.mem_iff.1 hu
  obtain ⟨V, hVv, -, hzV, hVc⟩ :=
    locallyConnectedSpace_iff_subsets_isOpen_isConnected.1 inferInstance z₀ v hv
  set S : Set (DInfty × Z) := {p : DInfty | 0 < p.r ∧ p.r < ε} ×ˢ V
  have hSc : IsPreconnected S := (DInfty.isPreconnected_pos_r_lt ε).prod hVc.isPreconnected
  have hSP : S ⊆ cylPos Z := fun y hy => hy.1.1
  have hSO : ∀ y ∈ S, orbitMk (GammaA α) y ∈ φ.source := fun y hy => huv ⟨hεu hy.1.2, hVv hy.2⟩
  have hdev := isAEAtlas_devAtlas (G := G) hP hD
  have hreg := hπ.regLocusOf_eq hdev.maximalAEAtlas hB.1
  have hloc : ∀ y ∈ S, ∃ g : G, ∀ᶠ y' in 𝓝 y, φ (orbitMk (GammaA α) y') = g • D y' := by
    intro y hy
    have hyR : y ∈ regLocusOf G (maximalAEAtlas G (devAtlas G D (cylPos Z))) B
        (orbitMk (GammaA α)) := by
      rw [hreg]
      exact ⟨subset_support_devStructure hP hD (hSP hy), mem_support.2 ⟨φ, hφ, hSO y hy⟩⟩
    have hys : y ∈ support (devAtlas G D (cylPos Z)) := by
      rw [support_devAtlas hP.isOpen hD]; exact hSP hy
    obtain ⟨e, he, hye⟩ := mem_support.1 hys
    obtain ⟨g, hg⟩ := (isRegularOn_regLocusOf (G := G) _ _ _).exists_smul_eq y hyR e
      (hdev.subset_maximalAEAtlas he) φ hφ hye (hSO y hy)
    obtain ⟨h, hh⟩ := he.2 y hye
    refine ⟨g * h⁻¹, ?_⟩
    filter_upwards [hg, hh] with y' h1 h2
    rw [h1, h2, mul_smul, inv_smul_smul]
  obtain ⟨g, hg⟩ := exists_smul_eq_on_of_isLocalHomeomorphOn hP.isOpen hD hSc hSP hloc
  obtain ⟨y, y', hy0, hyε, hy'0, hy'ε, hy2, hy'2, hcase⟩ := hsep ε hε
  have hyS : y ∈ S := ⟨⟨hy0, hyε⟩, by rw [hy2]; exact hzV⟩
  have hy'S : y' ∈ S := ⟨⟨hy'0, hy'ε⟩, by rw [hy'2]; exact hzV⟩
  rcases hcase with ⟨hπe, hDne⟩ | ⟨hπne, hDe⟩
  · have h1 : φ (orbitMk (GammaA α) y) = φ (orbitMk (GammaA α) y') := by rw [hπe]
    rw [hg _ hyS, hg _ hy'S, smul_left_cancel_iff] at h1
    exact hDne h1
  · have h1 : φ (orbitMk (GammaA α) y) = φ (orbitMk (GammaA α) y') := by
      rw [hg _ hyS, hg _ hy'S, hDe]
    exact hπne (φ.injOn (hSO y hyS) (hSO y' hy'S) h1)

theorem massiveDev_zero_posEmb (α : ℝ) (q : {q : ℝ × ℝ // 0 < q.1}) (z : ℝ) :
    massiveDev 1 0 α (DInfty.posEmb q, z) =
      (z, (q.1.1 : ℂ) * Complex.exp ((q.1.2 : ℂ) * Complex.I)) := by
  rw [massiveDev_posEmb one_ne_zero]
  refine Prod.ext (by simp) ?_
  simp only
  rw [Complex.exp_add, ← Complex.ofReal_exp, Real.exp_log q.2, one_mul]

/-- The separation hypothesis of `apex_notMem_support_of_sep` for the spinless massive particle
of angle `α > 0`, `α ≠ 2π`. -/
theorem massiveDev_sep {α : ℝ} (hα : 0 < α) (hα2 : α ≠ 2 * π) (z₀ : ℝ) (ε : ℝ) (hε : 0 < ε) :
    ∃ y y' : DInfty × ℝ, 0 < y.1.r ∧ y.1.r < ε ∧ 0 < y'.1.r ∧ y'.1.r < ε ∧
      y.2 = z₀ ∧ y'.2 = z₀ ∧
      ((orbitMk (GammaA α) y = orbitMk (GammaA α) y' ∧ massiveDev 1 0 α y ≠ massiveDev 1 0 α y') ∨
        (orbitMk (GammaA α) y ≠ orbitMk (GammaA α) y' ∧ massiveDev 1 0 α y = massiveDev 1 0 α y')) := by
  have hr : 0 < ε / 2 := half_pos hε
  have hrε : ε / 2 < ε := half_lt_self hε
  by_cases hk : ∃ k : ℤ, (k : ℝ) * α = 2 * π
  · obtain ⟨k, hk⟩ := hk
    set y : DInfty × ℝ := (DInfty.posEmb ⟨(ε / 2, 0), hr⟩, z₀)
    refine ⟨y, (GammaA.ofInt 1 : GammaA α) • y, hr, hrε, ?_, ?_, rfl, ?_, Or.inl ⟨?_, ?_⟩⟩
    · rw [gamma_smul_posEmb]; exact hr
    · rw [gamma_smul_posEmb]; exact hrε
    · rw [gamma_smul_posEmb]
    · rw [orbitMk_smul]
    · rw [gamma_smul_posEmb, massiveDev_zero_posEmb, massiveDev_zero_posEmb]
      intro h
      have h2 := congrArg Prod.snd h
      simp only [GammaA.toInt_ofInt, Int.cast_one, one_mul, zero_add, Complex.ofReal_zero,
        zero_mul, Complex.exp_zero, mul_one] at h2
      have hne : ((ε / 2 : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.2 hr.ne'
      have h3 : Complex.exp ((α : ℂ) * Complex.I) = 1 := by
        have := mul_left_cancel₀ hne (h2.symm.trans (mul_one _).symm)
        exact this
      obtain ⟨n, hn⟩ := Complex.exp_eq_one_iff.1 h3
      have hn' : α = n * (2 * π) := by
        have := congrArg Complex.im hn
        simpa using this
      have hkn : k * n = 1 := by
        have : (k : ℝ) * n * (2 * π) = 1 * (2 * π) := by rw [one_mul, mul_assoc, ← hn', hk]
        have h2pi : (2 * π : ℝ) ≠ 0 := by positivity
        exact_mod_cast mul_right_cancel₀ h2pi this
      rcases Int.eq_one_or_neg_one_of_mul_eq_one hkn with h1 | h1
      · rw [h1, Int.cast_one, one_mul] at hk; exact hα2 hk
      · rw [h1] at hk; push_cast at hk; nlinarith [Real.pi_pos]
  · refine ⟨(DInfty.posEmb ⟨(ε / 2, 0), hr⟩, z₀), (DInfty.posEmb ⟨(ε / 2, 2 * π), hr⟩, z₀),
      hr, hrε, hr, hrε, rfl, rfl, Or.inr ⟨fun h => hk ?_, ?_⟩⟩
    · obtain ⟨k, hk'⟩ := exists_smul_eq_of_orbitMk_eq h
      rw [gamma_smul_posEmb] at hk'
      have := congrArg (fun x : DInfty × ℝ => x.1.θ) hk'
      simp only [DInfty.posEmb_θ, zero_add] at this
      exact ⟨k.toInt, this⟩
    · rw [massiveDev_zero_posEmb, massiveDev_zero_posEmb]
      refine Prod.ext rfl ?_
      simp only [Complex.ofReal_zero, zero_mul, Complex.exp_zero, mul_one]
      rw [show ((2 * π : ℝ) : ℂ) * Complex.I = 2 * π * Complex.I by push_cast; ring,
        Complex.exp_two_pi_mul_I, mul_one]


/-- **The singular locus of the spinless massive particle `𝔼^{1,2}_α`** (`α > 0`, `α ≠ 2π`) is
the whole axis `π{r = 0}`, for every rigid `G`. -/
theorem massive_sing_eq {G : Type*} [Group G] [MulAction G (ℝ × ℂ)]
    [ContinuousConstSMul G (ℝ × ℂ)] [IsRigidAction G (ℝ × ℂ)] {α : ℝ} (hα : 0 < α)
    (hα2 : α ≠ 2 * π) {B : Set (OpenPartialHomeomorph (Orbits (GammaA α) (DInfty × ℝ)) (ℝ × ℂ))}
    (hB : IsMaximalAEAtlas G B)
    (hπ : IsAEMorphismOf G (maximalAEAtlas G (devAtlas G (massiveDev 1 0 α) (cylPos ℝ))) B
      (orbitMk (GammaA α))) :
    (support B)ᶜ = orbitMk (GammaA α) '' {x : DInfty × ℝ | x.1 = DInfty.apex} := by
  have hD := isLocalHomeomorphOn_massiveDev one_ne_zero 0 α
  refine Subset.antisymm ?_ ?_
  · rw [← setOf_r_eq_zero_cyl]; exact quotientBase_sing_subset hα.ne' hD hB hπ
  · rintro _ ⟨⟨p, z⟩, hx, rfl⟩
    simp only [mem_setOf_eq] at hx
    subst hx
    exact apex_notMem_support_of_sep hD hB hπ z (massiveDev_sep hα hα2 z)

/-- The deck transformations of `𝔻_∞ × ℝ → Γ_α\(𝔻_∞ × ℝ)` are the elements of `Γ_α`. -/
theorem exists_gamma_eq_of_over {α : ℝ} (hα : α ≠ 0) (ψ : DInfty × ℝ ≃ₜ DInfty × ℝ)
    (hψ : ∀ y, orbitMk (GammaA α) (ψ y) = orbitMk (GammaA α) y) :
    ∃ k : GammaA α, ∀ y, ψ y = k • y := by
  have hE : ∀ y, y ∈ CylPosE α ℝ ↔ ψ y ∈ CylPosE α ℝ := fun y => by
    show orbitMk (GammaA α) y ∈ orbitMk (GammaA α) '' cylPos ℝ ↔
      orbitMk (GammaA α) (ψ y) ∈ orbitMk (GammaA α) '' cylPos ℝ
    rw [hψ]
  set ψE : CylPosE α ℝ ≃ₜ CylPosE α ℝ := ψ.subtype hE
  have hψE : ∀ x : CylPosE α ℝ, (ψE x).1 = ψ x.1 := fun _ => rfl
  have hdeck : ψE ∈ deckGroup ((orbitMk (GammaA α) '' cylPos ℝ).restrictPreimage
      (orbitMk (GammaA α) : DInfty × ℝ → Orbits (GammaA α) (DInfty × ℝ))) :=
    funext fun x => Subtype.ext (hψ x.1)
  obtain ⟨k, hk⟩ := (cylPosDeck_bijective (Z := ℝ) hα).2 ⟨ψE, hdeck⟩
  refine ⟨k, fun y => ?_⟩
  by_cases hy : y ∈ CylPosE α ℝ
  · have h1 := cylPosDeck_apply (Z := ℝ) k ⟨y, hy⟩
    rw [hk] at h1
    exact h1
  · have hy1 : y.1 = DInfty.apex := by
      rcases y.1.pos_or_eq_apex with h | h
      · exact absurd (subset_preimage_image (orbitMk (GammaA α)) (cylPos ℝ) (show y ∈ cylPos ℝ from h)) hy
      · exact h
    obtain ⟨γ, hγ⟩ := exists_smul_eq_of_orbitMk_eq (hψ y).symm
    have hfix : ∀ k' : GammaA α, k' • y = y := fun k' => by
      rw [DInfty.smul_prod_def, DInfty.smul_def, hy1, DInfty.rot_apex]
      exact Prod.ext hy1.symm rfl
    rw [hfix k, ← hγ, hfix γ]

theorem coinduced_induced_of_surjective {A B : Type*} {f : A → B} (hf : Surjective f)
    (t : TopologicalSpace B) : TopologicalSpace.coinduced f (TopologicalSpace.induced f t) = t := by
  refine TopologicalSpace.ext (funext fun U => propext ⟨fun hU => ?_, fun hU => ⟨U, hU, rfl⟩⟩)
  obtain ⟨V, hV, hVU⟩ := hU
  rwa [← hf.preimage_injective hVU]

theorem tamTop_univ : tamTop univ = hornTop := by
  have h : ∀ y, @nhds _ (tamTop univ) y = @nhds _ hornTop y := fun y =>
    nhds_tamTop_of_mem isOpen_univ (mem_univ _)
  exact le_antisymm (le_of_nhds_le_nhds fun y => (h y).le) (le_of_nhds_le_nhds fun y => (h y).ge)

end MassiveSing

/-! #### The massive particle as a singular `(Isom₀(𝔼^{1,2}), 𝔼^{1,2})`-model -/

section MassiveModel

/-- `Isom₀(𝔼^{1,2})` acts faithfully (affine maps are determined by their values). -/
instance faithfulSMul_affineEquiv_sptop {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] :
    FaithfulSMul (V ≃ᵃ[ℝ] V) V :=
  ⟨fun h => AffineEquiv.ext h⟩

/-- The spinless massive particle `𝔼^{1,2}_α = Γ_α\(𝔻_∞ × ℝ)`, as a type. -/
abbrev MassCyl (α : ℝ) : Type := Orbits (GammaA α) (DInfty × ℝ)

variable {α : ℝ} [SingularGXStructure MinkIsom0 (ℝ × ℂ) (MassCyl α)]

/-- The structure of `MassCyl α` is the massive particle's: `π` is an a.e. morphism from the
structure the developing map `D = massiveDev 1 0 α` pulls back on `{r > 0}`. -/
def IsMassiveStructure (α : ℝ) [SingularGXStructure MinkIsom0 (ℝ × ℂ) (MassCyl α)] : Prop :=
  IsAEMorphismOf MinkIsom0 (maximalAEAtlas MinkIsom0 (devAtlas MinkIsom0 (massiveDev 1 0 α)
    (cylPos ℝ))) (aeAtlas MinkIsom0 (ℝ × ℂ) (MassCyl α)) (orbitMk (GammaA α))

theorem massCyl_instances (hα : α ≠ 0) :
    T2Space (MassCyl α) ∧ LocPathConnectedSpace (MassCyl α) ∧ FirstCountableTopology (MassCyl α) ∧
      ConnectedSpace (MassCyl α) := by
  obtain ⟨h1, h2, h3, h4, -, -⟩ := cyl_instances (V := ℝ) hα
  exact ⟨h1, h2, h3, h4⟩

theorem massCyl_sing (hα : 0 < α) (hα2 : α ≠ 2 * π) (hπ : IsMassiveStructure α) :
    Sing MinkIsom0 (ℝ × ℂ) (MassCyl α) = orbitMk (GammaA α) '' {x : DInfty × ℝ | x.1 = DInfty.apex} :=
  massive_sing_eq hα hα2 (isMaximalAEAtlas_aeAtlas MinkIsom0 (ℝ × ℂ) (MassCyl α)) hπ

/-- `\widetilde{𝔼_α}` is the cylinder `𝔻_∞ × ℝ`, over `𝔼_α`. -/
theorem massCyl_exists_homeomorph (hα : 0 < α) (hα2 : α ≠ 2 * π) (hπ : IsMassiveStructure α)
    (y₀ : ((Sing MinkIsom0 (ℝ × ℂ) (MassCyl α))ᶜ : Set (MassCyl α))) :
    ∃ Φ : MaxBranchedCover (Sing MinkIsom0 (ℝ × ℂ) (MassCyl α)) y₀ ≃ₜ DInfty × ℝ,
      ∀ e, orbitMk (GammaA α) (Φ e) = e.base := by
  have key : ∀ (S' : Set (MassCyl α))
      (_ : S' = orbitMk (GammaA α) '' {x : DInfty × ℝ | x.1 = DInfty.apex}) (y₀ : (S'ᶜ : Set _)),
      ∃ Φ : MaxBranchedCover S' y₀ ≃ₜ DInfty × ℝ, ∀ e, orbitMk (GammaA α) (Φ e) = e.base := by
    rintro S' rfl y₀
    exact (previous_examples_maxBranched.{0} (V := ℝ) hα.ne').2.2.2 y₀
  exact key _ (massCyl_sing hα hα2 hπ) y₀

theorem massCyl_slsc (hα : 0 < α) (hα2 : α ≠ 2 * π) (hπ : IsMassiveStructure α) :
    SemilocallySimplyConnected ((Sing MinkIsom0 (ℝ × ℂ) (MassCyl α))ᶜ : Set (MassCyl α)) := by
  rw [massCyl_sing hα hα2 hπ]
  exact (previous_examples_maxBranched.{0} (V := ℝ) hα.ne').2.1

theorem continuous_massiveDev_zero (α : ℝ) : Continuous (massiveDev 1 0 α) := by
  have : massiveDev 1 0 α = fun x => (x.2, DInfty.cplx (2 * π / 1) x.1) := by
    funext x; simp [massiveDev]
  rw [this]
  exact continuous_snd.prodMk ((DInfty.continuous_cplx _).comp continuous_fst)

/-- **`𝔼^{1,2}_α` is tame** (`RamcovGX.tex:2139`, "since `𝔼^{1,2}_θ` is tame"): the developing
map `massiveDev 1 0 α` of the cylinder is continuous on the whole cylinder. -/
theorem massCyl_isTame (hα : 0 < α) (hα2 : α ≠ 2 * π) (hπ : IsMassiveStructure α) :
    IsTame MinkIsom0 (ℝ × ℂ) (MassCyl α) := by
  have hD := isLocalHomeomorphOn_massiveDev one_ne_zero 0 α
  have hP := DInfty.isPortly_pos ℝ
  have hdevA : IsMaximalAEAtlas MinkIsom0 (maximalAEAtlas MinkIsom0
      (devAtlas MinkIsom0 (massiveDev 1 0 α) (cylPos ℝ))) :=
    (isAEAtlas_devAtlas (G := MinkIsom0) hP hD).isMaximalAEAtlas_maximalAEAtlas
  have heq := eq_aePullback hdevA hπ
  obtain ⟨hbc, hpb⟩ := isBranchedCovering_orbitMk_cyl (V := ℝ) hα.ne'
  haveI : LocPathConnectedSpace (DInfty × ℝ) := locPathConnectedSpace_prod_of
  refine ⟨DInfty × ℝ, inferInstance, inferInstance, inferInstance, inferInstance,
    orbitMk (GammaA α), hbc, by rw [massCyl_sing hα hα2 hπ]; exact hpb, massiveDev 1 0 α, ?_⟩
  show IsAEMorphismOf MinkIsom0 (aePullback MinkIsom0 (aeAtlas MinkIsom0 (ℝ × ℂ) (MassCyl α))
    (orbitMk (GammaA α))) (gxModelAtlas MinkIsom0 (ℝ × ℂ)) (massiveDev 1 0 α)
  rw [← heq]
  exact (isAEMorphismOf_iff (isMaximalAEAtlas_gxModelAtlas (G := MinkIsom0) (X := ℝ × ℂ)).1).2
    ⟨continuous_massiveDev_zero α, cylPos ℝ, hP,
      (previous_examples_developing (G := MinkIsom0) hα.ne' hD).2⟩

theorem massCyl_natural_tamifying (hα : 0 < α) (hα2 : α ≠ 2 * π) (hπ : IsMassiveStructure α)
    (y₀ : ((Sing MinkIsom0 (ℝ × ℂ) (MassCyl α))ᶜ : Set (MassCyl α))) :
    IsTamifyingTopology MinkIsom0 (ℝ × ℂ) (MassCyl α) y₀ inferInstance := by
  obtain ⟨h1, h2, h3, h4⟩ := massCyl_instances hα.ne'
  haveI := h1; haveI := h2; haveI := h3; haveI := h4
  exact (isTame_iff_isTamifyingTopology_natural (isLocallyUnloopable_of_normedSpace _) y₀).1
    (massCyl_isTame hα hα2 hπ)


variable (hα : 0 < α) (hα2 : α ≠ 2 * π) (hπ : IsMassiveStructure α)
  {y₀ : ((Sing MinkIsom0 (ℝ × ℂ) (MassCyl α))ᶜ : Set (MassCyl α))}
  {Φ : MaxBranchedCover (Sing MinkIsom0 (ℝ × ℂ) (MassCyl α)) y₀ ≃ₜ DInfty × ℝ}
  (hΦ : ∀ e, orbitMk (GammaA α) (Φ e) = e.base)

/-- `tamTop W`, pulled back along `f`. -/
@[reducible] def pullTamTop {E : Type*} (f : E → DInfty × ℝ) (W : Set ℝ) : TopologicalSpace E :=
  TopologicalSpace.induced f (tamTop W)

include hα hα2 hπ hΦ in
/-- **`tamTop W` transported to `\widetilde{𝔼_α}` is tamifying** (`def:singular_manifold_virtually_tame`),
for every open `W ⊆ ℝ`: (A) by `coinduced_orbitMk_tamTop`, (B) from the tameness of `𝔼_α`
(the developing map is continuous for the natural topology, hence for the finer one), (C) since
`Γ(\widetilde{𝔼_α}/𝔼_α) = Γ_α` (`exists_gamma_eq_of_over`) acts continuously
(`continuous_smul_tamTop`), (D) by `isPortly_cylPos_tamTop`. -/
theorem massCyl_isTamifying_tamTop {W : Set ℝ} (hW : IsOpen W) :
    IsTamifyingTopology MinkIsom0 (ℝ × ℂ) (MassCyl α) y₀ (pullTamTop Φ W) := by
  have hnat := massCyl_natural_tamifying hα hα2 hπ y₀
  have hle : (pullTamTop Φ W) ≤ weakTopMax MinkIsom0 (ℝ × ℂ) (MassCyl α) y₀ :=
    (induced_mono (tamTop_le hW)).trans_eq Φ.induced_eq
  have hbase : (SpreadEnd.base : MaxBranchedCover (Sing MinkIsom0 (ℝ × ℂ) (MassCyl α)) y₀ →
      MassCyl α) = orbitMk (GammaA α) ∘ Φ := funext fun e => (hΦ e).symm
  have hΦc : Continuous[pullTamTop Φ W, tamTop W] Φ := continuous_induced_dom
  have hΦsc : Continuous[tamTop W, pullTamTop Φ W] Φ.symm := continuous_induced_rng.2 (by
    have : (Φ : _ → DInfty × ℝ) ∘ Φ.symm = id := funext Φ.apply_symm_apply
    rw [this]; exact @continuous_id _ (tamTop W))
  refine ⟨hle, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact @firstCountableTopology_induced _ _ (tamTop W) (firstCountable_tamTop hW) Φ
  · have hemb : @IsOpenEmbedding _ _ (pullTamTop Φ W) (tamTop W) Φ :=
      @IsOpenEmbedding.mk _ _ (pullTamTop Φ W) (tamTop W) Φ (@IsEmbedding.mk _ _ (pullTamTop Φ W) (tamTop W) Φ
        (@IsInducing.mk _ _ (pullTamTop Φ W) (tamTop W) Φ rfl) Φ.injective)
        (by rw [Φ.range_coe]; exact @isOpen_univ _ (tamTop W))
    exact @IsOpenEmbedding.locPathConnectedSpace _ _ (tamTop W) (pullTamTop Φ W) (locPathConnected_tamTop hW) Φ
      hemb
  · rw [hbase, ← @coinduced_compose _ _ _ (pullTamTop Φ W) Φ (orbitMk (GammaA α)),
      coinduced_induced_of_surjective Φ.surjective, coinduced_orbitMk_tamTop hα.ne' hW]
  · obtain ⟨D, hDc, hDr⟩ := hnat.exists_extension
    exact ⟨D, continuous_le_dom hle hDc, hDr⟩
  · rintro _ ⟨γ, hγ, rfl⟩
    set ψ : DInfty × ℝ ≃ₜ DInfty × ℝ := (Φ.symm.trans γ).trans Φ
    have hψ : ∀ y, orbitMk (GammaA α) (ψ y) = orbitMk (GammaA α) y := fun y => by
      show orbitMk (GammaA α) (Φ (γ (Φ.symm y))) = _
      rw [hΦ (γ (Φ.symm y)), deck_apply (p := SpreadEnd.base) hγ (Φ.symm y), ← hΦ (Φ.symm y),
        Φ.apply_symm_apply]
    obtain ⟨k, hk⟩ := exists_gamma_eq_of_over hα.ne' ψ hψ
    refine continuous_induced_rng.2 ?_
    have : (Φ : _ → DInfty × ℝ) ∘ γ = (fun y => k • y) ∘ Φ := funext fun e => by
      show Φ (γ e) = k • Φ e
      rw [← hk]
      show Φ (γ e) = Φ (γ (Φ.symm (Φ e)))
      rw [Φ.symm_apply_apply]
    rw [this]
    exact @Continuous.comp _ _ _ (pullTamTop Φ W) (tamTop W) (tamTop W) _ _ (continuous_smul_tamTop k) hΦc
  · have hpre : (SpreadEnd.base : MaxBranchedCover (Sing MinkIsom0 (ℝ × ℂ) (MassCyl α)) y₀ →
        MassCyl α) ⁻¹' Reg MinkIsom0 (ℝ × ℂ) (MassCyl α) = Φ.symm '' cylPos ℝ := by
      rw [Φ.image_symm]
      ext e
      have hR : Reg MinkIsom0 (ℝ × ℂ) (MassCyl α) = orbitMk (GammaA α) '' cylPos ℝ := by
        rw [← compl_image_axis (V := ℝ) α, ← massCyl_sing hα hα2 hπ, Sing, compl_compl]
      simp only [mem_preimage, hR, ← hΦ e]
      rw [← mem_preimage (f := orbitMk (GammaA α)), preimage_image_cylPos]
    rw [hpre]
    have hopen : @IsOpenMap _ _ (tamTop W) (pullTamTop Φ W) Φ.symm := fun V hV => ⟨V, hV, by rw [Φ.image_symm]⟩
    exact @IsPortly.image_of_isOpenMap _ _ (tamTop W) (pullTamTop Φ W)
      (locallyConnectedSpace_of_lpc_sptop (locPathConnected_tamTop hW)) Φ.symm hΦsc hopen
      Φ.symm.surjective _ (isPortly_cylPos_tamTop hW)

include hα hα2 hπ hΦ in
/-- The time translation of the cylinder, conjugated by `Φ`, is an automorphism of
`\widetilde{𝔼_α}`: a homeomorphism which is an a.e. `(G,X)`-morphism of the pulled-back structure
(its developing map reads it as the time translation `screw s 1 ∈ Isom₀(𝔼^{1,2})`). -/
theorem massCyl_timeShift_mem_aeAut (s : ℝ) :
    ⇑((Φ.trans (timeShift s)).trans Φ.symm) ∈ aeAutMapsMax MinkIsom0 (ℝ × ℂ) (MassCyl α) y₀ := by
  have hnat := massCyl_natural_tamifying hα hα2 hπ y₀
  haveI := hnat.locPathConnected
  haveI : LocPathConnectedSpace (DInfty × ℝ) := locPathConnectedSpace_prod_of
  have hD := isLocalHomeomorphOn_massiveDev one_ne_zero 0 α
  have hP := DInfty.isPortly_pos ℝ
  set A := maximalAEAtlas MinkIsom0 (devAtlas MinkIsom0 (massiveDev 1 0 α) (cylPos ℝ))
  have hdevA : IsMaximalAEAtlas MinkIsom0 A :=
    (isAEAtlas_devAtlas (G := MinkIsom0) hP hD).isMaximalAEAtlas_maximalAEAtlas
  have hτ : IsAEMorphismOf MinkIsom0 A A (timeShift s) :=
    isAEMorphismOf_devStructure hP hD (timeShift s).continuous (fun y hy => hy) fun x _ =>
      ⟨⟨screw s 1, screw_mem s 1⟩, Eventually.of_forall fun y => by
        rw [Subgroup.mk_smul, affineEquiv_smul_def, screw_apply, timeShift_apply]
        simp [massiveDev]⟩
  have hloc : IsAELocalHomeomorph A Φ := by
    refine ⟨Φ ⁻¹' support A, support A, ?_, hdevA.1.2, subset_rfl, fun x hx => hx,
      Φ.isLocalHomeomorph.isLocalHomeomorphOn⟩
    rw [← Φ.image_symm]
    exact hdevA.1.2.image_of_isOpenMap Φ.symm.continuous Φ.symm.isOpenMap Φ.symm.surjective
  have hspec := aePullback_spec_of_isAELocalHomeomorph hdevA.1 Φ.continuous hloc
  have hbase : (SpreadEnd.base : MaxBranchedCover (Sing MinkIsom0 (ℝ × ℂ) (MassCyl α)) y₀ →
      MassCyl α) = orbitMk (GammaA α) ∘ Φ := funext fun e => (hΦ e).symm
  have hb := hπ.comp hspec.2
  rw [← hbase] at hb
  have heq := eq_aePullback hspec.1 hb
  have hsymm := IsAEMorphismOf.symm_of_homeomorph hspec.1 hdevA hspec.2
  refine ⟨(Φ.trans (timeShift s)).trans Φ.symm, rfl, ?_⟩
  rw [← heq]
  exact hsymm.comp (hτ.comp hspec.2)

include hΦ in
/-- The conjugated time translation is continuous for the transported BTZ topology, and the
time translation by `2` is not continuous for the transported messed-up topology `T'`. -/
theorem massCyl_timeShift_continuity :
    Continuous[TopologicalSpace.induced Φ hornTop, TopologicalSpace.induced Φ hornTop]
      ((Φ.trans (timeShift 2)).trans Φ.symm) ∧
    ¬ Continuous[TopologicalSpace.induced Φ (tamTop (Ioi 0)),
      TopologicalSpace.induced Φ (tamTop (Ioi 0))] ((Φ.trans (timeShift 2)).trans Φ.symm) := by
  have hcomp : (Φ : _ → DInfty × ℝ) ∘ ((Φ.trans (timeShift 2)).trans Φ.symm) = timeShift 2 ∘ Φ :=
    funext fun e => by simp
  refine ⟨continuous_induced_rng.2 ?_, fun h => not_continuous_timeShift_tamTop ?_⟩
  · rw [hcomp]
    exact @Continuous.comp _ _ _ (TopologicalSpace.induced Φ hornTop) hornTop hornTop _ _
      (continuous_timeShift_hornTop 2) continuous_induced_dom
  · have hΦsc : Continuous[tamTop (Ioi 0), TopologicalSpace.induced Φ (tamTop (Ioi 0))] Φ.symm :=
      continuous_induced_rng.2 (by
        have : (Φ : _ → DInfty × ℝ) ∘ Φ.symm = id := funext Φ.apply_symm_apply
        rw [this]; exact @continuous_id _ (tamTop (Ioi 0)))
    have : (timeShift 2 : DInfty × ℝ → DInfty × ℝ) =
        Φ ∘ ((Φ.trans (timeShift 2)).trans Φ.symm) ∘ Φ.symm := funext fun y => by simp
    rw [this]
    exact @Continuous.comp _ _ _ (tamTop (Ioi 0)) (TopologicalSpace.induced Φ (tamTop (Ioi 0)))
      (tamTop (Ioi 0)) _ _ continuous_induced_dom (@Continuous.comp _ _ _ (tamTop (Ioi 0))
        (TopologicalSpace.induced Φ (tamTop (Ioi 0))) (TopologicalSpace.induced Φ (tamTop (Ioi 0)))
        _ _ h hΦsc)


include hΦ in
/-- The transported `T'` is the topology generated by the natural one and the restriction of the
transported BTZ topology to `{t > 0}` (the paper's description of `T'`, l.2141). -/
theorem pullTamTop_eq_mixedTop :
    pullTamTop Φ (Ioi 0) = mixedTop (TopologicalSpace.induced Φ hornTop) (Φ ⁻¹' {y | 0 < y.2}) := by
  have hle : TopologicalSpace.induced Φ hornTop ≤
      (inferInstance : TopologicalSpace (MaxBranchedCover (Sing MinkIsom0 (ℝ × ℂ) (MassCyl α)) y₀)) :=
    (induced_mono hornTop_le).trans_eq Φ.induced_eq
  have hV : IsOpen (Φ ⁻¹' {y : DInfty × ℝ | 0 < y.2}) :=
    (isOpen_lt continuous_const continuous_snd).preimage Φ.continuous
  have h : ∀ e, @nhds _ (pullTamTop Φ (Ioi 0)) e =
      @nhds _ (mixedTop (TopologicalSpace.induced Φ hornTop) (Φ ⁻¹' {y | 0 < y.2})) e := by
    intro e
    rw [@nhds_induced _ _ (tamTop (Ioi 0)) Φ e]
    by_cases he : 0 < (Φ e).2
    · rw [nhds_mixedTop_of_mem hle hV he, @nhds_induced _ _ hornTop Φ e,
        nhds_tamTop_of_mem isOpen_Ioi he]
    · rw [nhds_mixedTop_of_notMem (T := TopologicalSpace.induced Φ hornTop) he,
        nhds_tamTop_of_notMem (W := Ioi 0) he]
      exact (Φ.comap_nhds_eq (Φ e)).trans (by rw [Φ.symm_apply_apply])
  exact le_antisymm (le_of_nhds_le_nhds fun e => (h e).le) (le_of_nhds_le_nhds fun e => (h e).ge)

end MassiveModel

/-- The massive particle structure exists (`ex:quotient_base`, `GX.massive_particle_isom0` with
spin `0` and the intended angular speed, DEC-47). -/
theorem exists_isMassiveStructure {α : ℝ} (hα : α ≠ 0) :
    ∃ s : SingularGXStructure MinkIsom0 (ℝ × ℂ) (MassCyl α), @IsMassiveStructure α s := by
  obtain ⟨B, ⟨hB, hπ⟩, -⟩ := massive_particle_isom0 one_ne_zero 0 hα
  exact ⟨⟨B, hB⟩, hπ⟩

/-- **`rem:hypothesis_model_spaces_necessary`** (`RamcovGX.tex:2137`), its counterexample:
for `θ = α ∈ ℝ₊ ∖ {0, 2π}`, the massive particle `𝔼^{1,2}_α` (spin `0`; `G = Isom₀(𝔼^{1,2})`)
has the whole axis as singular locus, is tame, and its maximal covering
`\widetilde{𝔼_α} ≅ 𝔻_∞ × ℝ` (over `𝔼_α`) carries three tamifying topologies: the natural one; the
BTZ tamifying topology `T` of `sec:mot_BTZ` transported (`hornTop`, generated by the natural
topology and `{rθ² < λ}`); and the "messed up" `T'` generated by the natural one and the
restriction of `T` to `{t > 0}`. `Γ(\widetilde{𝔼_α}/𝔼_α)` acts `T'`-continuously (`(C)`), but the
time translation by `2` — an element of `Aut(\widetilde{𝔼_α})`, `T`-continuous — is not
`T'`-continuous: hypothesis "`Aut(\widetilde X_α)` acts `T_α`-continuously" of
`theo:local_virt_tame` — the remark's "Hypothesis (C)", DEC-87(b) — is not implied by `T_α`
tamifying. -/
theorem hypothesis_model_spaces_necessary {α : ℝ} (hα : 0 < α) (hα2 : α ≠ 2 * π)
    [SingularGXStructure MinkIsom0 (ℝ × ℂ) (MassCyl α)] (hπ : IsMassiveStructure α)
    (y₀ : ((Sing MinkIsom0 (ℝ × ℂ) (MassCyl α))ᶜ : Set (MassCyl α))) :
    Sing MinkIsom0 (ℝ × ℂ) (MassCyl α) =
      orbitMk (GammaA α) '' {x : DInfty × ℝ | x.1 = DInfty.apex} ∧
    IsTame MinkIsom0 (ℝ × ℂ) (MassCyl α) ∧
    ∃ Φ : MaxBranchedCover (Sing MinkIsom0 (ℝ × ℂ) (MassCyl α)) y₀ ≃ₜ DInfty × ℝ,
      (∀ e, orbitMk (GammaA α) (Φ e) = e.base) ∧
      IsTamifyingTopology MinkIsom0 (ℝ × ℂ) (MassCyl α) y₀ inferInstance ∧
      IsTamifyingTopology MinkIsom0 (ℝ × ℂ) (MassCyl α) y₀ (TopologicalSpace.induced Φ btzGenTop) ∧
      pullTamTop Φ (Ioi 0) =
        mixedTop (TopologicalSpace.induced Φ btzGenTop) (Φ ⁻¹' {y | 0 < y.2}) ∧
      IsTamifyingTopology MinkIsom0 (ℝ × ℂ) (MassCyl α) y₀ (pullTamTop Φ (Ioi 0)) ∧
      ∃ f ∈ aeAutMapsMax MinkIsom0 (ℝ × ℂ) (MassCyl α) y₀,
        (∀ e, Φ (f e) = ((Φ e).1, (Φ e).2 + 2)) ∧
        Continuous[TopologicalSpace.induced Φ btzGenTop, TopologicalSpace.induced Φ btzGenTop] f ∧
        ¬ Continuous[pullTamTop Φ (Ioi 0), pullTamTop Φ (Ioi 0)] f := by
  obtain ⟨Φ, hΦ⟩ := massCyl_exists_homeomorph hα hα2 hπ y₀
  have hT := massCyl_isTamifying_tamTop hα hα2 hπ hΦ (W := univ) isOpen_univ
  rw [pullTamTop, tamTop_univ] at hT
  rw [← hornTop_eq_btzGenTop]
  obtain ⟨h1, h2⟩ := massCyl_timeShift_continuity hΦ
  exact ⟨massCyl_sing hα hα2 hπ, massCyl_isTame hα hα2 hπ, Φ, hΦ,
    massCyl_natural_tamifying hα hα2 hπ y₀, hT, pullTamTop_eq_mixedTop hΦ,
    massCyl_isTamifying_tamTop hα hα2 hπ hΦ isOpen_Ioi, _,
    massCyl_timeShift_mem_aeAut hα hα2 hπ hΦ 2, fun e => by simp, h1, h2⟩

end MassiveCounterexample

