namespace GX

open Set Function

universe u

/-! ## §1 Barbot's equality for an absolutely maximal flat spacetime with a loxodromic holonomy -/

section FlatEquality

variable {d : ℕ}

/-- **Equality `𝒟(M̃) = Ω^±(Λ(Γ))`** (Barbot §11.3 with Cor 10.3; gx l.2378–2380): for a causal
flat spacetime `M` (Type 0) with a Cauchy surface developing as in (CC′), a loxodromic element in
its holonomy, and `M` absolutely maximal (Barbot's sense, every GH flat target), the image of the
developing map is the whole regular domain `Ω⁺(Λ(Γ))` (future case) or `Ω⁻(Λ(Γ))` (past case),
on which `Γ = ρ(π₁)` acts freely and properly discontinuously. -/
theorem uniformization_range_eq_of_absMax (M : Causal.Flat.FlatSpacetime.{0} d) {x₀ : M}
    {D : Causal.UniversalCover M x₀ → Causal.Minkowski d}
    {ρ : Causal.Deck (Causal.UniversalCover.proj M x₀) →* Causal.Flat.isom d} {S : Set M}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ)
    (hcaus : (Causal.Flat.flatCausality d M).IsCausal) (h : Causal.Flat.DevelopsCC x₀ D S)
    (hlox : ∃ γ ∈ ρ.range, Causal.Flat.IsLoxodromic (Causal.Flat.linOf γ))
    (hmax : Causal.Flat.AbsMax (fun _ => True) M) :
    (Causal.Flat.FutureRegular (Causal.Flat.limitSetJ ρ.range) ∧
        range D = Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
        Causal.Flat.ActsFreelyProperlyOn ρ.range
          (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range))) ∨
      (Causal.Flat.PastRegular (Causal.Flat.limitSetJ ρ.range) ∧
        range D = Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range) ∧
        Causal.Flat.ActsFreelyProperlyOn ρ.range
          (Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range))) := by
  have hcc := Causal.Flat.ccAction_of_developsCC hpair h
  obtain ⟨hfp, B, hq, hGHB, -⟩ := Causal.Flat.Lox.bcor_loxo_proper_both hcc hlox
  have hr := Causal.Flat.range_eq_omegaS_of_absMax M hpair hcaus h B hq hGHB trivial hmax
  rcases Causal.Flat.blem_loxregular hcc hlox with ⟨hF, he⟩ | ⟨hP, he⟩
  · exact Or.inl ⟨hF, hr.trans he, he ▸ hfp⟩
  · exact Or.inr ⟨hP, hr.trans he, he ▸ hfp⟩


/-- **The developing map induces `M ≅ ρ(Γ)\Ω`** (gx l.2400–2403 on the regular part; Barbot §11.3):
if `𝒟` is injective with image the open set `Ω`, `B` a GH presentation of `ρ(Γ)\Ω` (projection
`π`), and `M` absolutely maximal, then the map `M → B`, `[z] ↦ π(𝒟 z)`, is a homeomorphism and a
local isometry. (The proof of `Causal.Flat.equality_of_absMax`, kept to its end.) -/
theorem exists_isometry_quotient_of_absMax {P : Causal.Flat.FlatSpacetime.{u} d → Prop}
    (M : Causal.Flat.FlatSpacetime.{u} d) {x₀ : M}
    {D : Causal.UniversalCover M x₀ → Causal.Minkowski d}
    {ρ : Causal.Deck (Causal.UniversalCover.proj M x₀) →* Causal.Flat.isom d}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) (hinj : Injective D)
    {Ω : TopologicalSpace.Opens (Causal.Minkowski d)} (hΩ : range D ⊆ Ω)
    (B : Causal.Flat.FlatSpacetime.{u} d) (π : Ω → B) (hπl : Causal.Flat.IsLocalIsometry d π)
    (hfib : ∀ p q : Ω, π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski d) = q)
    (hGHB : Causal.Flat.GH B) (hPB : P B) (hmax : Causal.Flat.AbsMax P M) :
    ∃ f : M ≃ₜ B, Causal.Flat.IsLocalIsometry d f ∧
      ∀ z (hz : D z ∈ Ω), f (Causal.UniversalCover.proj M x₀ z) = π ⟨D z, hz⟩ := by
  letI := Causal.Flat.flatCoverChartedSpace d M x₀
  haveI := Causal.Flat.locPathConnectedSpace_of_flat d M
  haveI : PathConnectedSpace M := pathConnectedSpace_iff_connectedSpace.2 inferInstance
  have hqs : Surjective (Causal.UniversalCover.proj M x₀) := Causal.UniversalCover.proj_surjective
  have hql : Causal.Flat.IsLocalIsometry d (Causal.UniversalCover.proj M x₀) :=
    Causal.Flat.isLocalIsometry_flatCover_proj x₀
  set D' : Causal.UniversalCover M x₀ → Ω := fun z => ⟨D z, hΩ (mem_range_self z)⟩
  have hDl : Causal.Flat.IsLocalIsometry d D :=
    Causal.Flat.isLocalIsometry_iff_eventually.2 ⟨hpair.gx.1, hpair.gx.2⟩
  have hD'l : Causal.Flat.IsLocalIsometry d D' :=
    Causal.Flat.IsLocalIsometry.of_comp_left (Causal.Flat.isIsometricEmbedding_subtype_val Ω) hDl
  set f : M → B := fun x => π (D' (surjInv hqs x))
  have key : ∀ z, f (Causal.UniversalCover.proj M x₀ z) = π (D' z) := by
    intro z
    set z' := surjInv hqs (Causal.UniversalCover.proj M x₀ z)
    obtain ⟨γ, hγ⟩ := Causal.Flat.UniversalCover.exists_deck_apply_eq z z'
      (surjInv_eq hqs (Causal.UniversalCover.proj M x₀ z)).symm
    refine ((hfib (D' z) (D' z')).2 ⟨ρ γ, ⟨γ, rfl⟩, ?_⟩).symm
    simp only [D']
    rw [← hpair.equiv, hγ]
  have hfq : f ∘ (Causal.UniversalCover.proj M x₀) = π ∘ D' := funext key
  have hfl : Causal.Flat.IsLocalIsometry d f := hql.of_comp_right hqs (hfq ▸ hπl.comp hD'l)
  have hfi : Injective f := by
    intro x x' hxx'
    obtain ⟨z, rfl⟩ := hqs x
    obtain ⟨z', rfl⟩ := hqs x'
    rw [key, key] at hxx'
    obtain ⟨_, ⟨γ, rfl⟩, hγ⟩ := (hfib _ _).1 hxx'
    have h1 : D (γ.1 z) = D z' := by rw [hpair.equiv]; exact hγ
    rw [← hinj h1]
    exact (Causal.Flat.proj_deck_apply γ z).symm
  have hfs := hmax B hGHB hPB f ⟨hfl, hfi⟩
  refine ⟨(IsHomeomorph.mk hfl.continuous hfl.isOpenMap ⟨hfi, hfs⟩).homeomorph f, hfl,
    fun z hz => key z⟩

/-- The quotient package on a given open set `Ω = Ω(S̃)`: `range 𝒟 = Ω`, and `M ≅ ρ(Γ)\Ω` through a
GH presentation `π : Ω → B` (covering, local isometry, onto, fibres the `ρ(Γ)`-orbits). -/
theorem uniformization_quotient_aux (M : Causal.Flat.FlatSpacetime.{0} d) {x₀ : M}
    {D : Causal.UniversalCover M x₀ → Causal.Minkowski d}
    {ρ : Causal.Deck (Causal.UniversalCover.proj M x₀) →* Causal.Flat.isom d} {S : Set M}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ)
    (hcaus : (Causal.Flat.flatCausality d M).IsCausal) (h : Causal.Flat.DevelopsCC x₀ D S)
    (hlox : ∃ γ ∈ ρ.range, Causal.Flat.IsLoxodromic (Causal.Flat.linOf γ))
    (hmax : Causal.Flat.AbsMax (fun _ => True) M) (Ω : TopologicalSpace.Opens (Causal.Minkowski d))
    (hΩe : Causal.Flat.omegaS ρ.range (D '' (Causal.UniversalCover.proj M x₀ ⁻¹' S)) = Ω) :
    range D = Ω ∧ ∃ (B : Causal.Flat.FlatSpacetime.{0} d) (π : Ω → B),
      IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry d π ∧ Surjective π ∧
      (∀ p q : Ω, π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski d) = q) ∧
      Causal.Flat.GH B ∧
      ∃ f : M ≃ₜ B, Causal.Flat.IsLocalIsometry d f ∧
        ∀ z (hz : D z ∈ Ω), f (Causal.UniversalCover.proj M x₀ z) = π ⟨D z, hz⟩ := by
  have hcc := Causal.Flat.ccAction_of_developsCC hpair h
  obtain ⟨-, B, hq, hGHB, -⟩ := Causal.Flat.Lox.bcor_loxo_proper_both hcc hlox
  have hr := Causal.Flat.range_eq_omegaS_of_absMax M hpair hcaus h B hq hGHB trivial hmax
  have hopens : Causal.Flat.omegaSOpens ρ.range (D '' (Causal.UniversalCover.proj M x₀ ⁻¹' S)) = Ω :=
    TopologicalSpace.Opens.ext hΩe
  rw [hopens] at hq
  obtain ⟨π, hcov, hπl, hπs, hfib⟩ := hq.quot
  have hinj := Causal.Flat.uniformization_injective hpair hcaus h
  have hrΩ : range D = Ω := hr.trans hΩe
  obtain ⟨f, hfl, hf⟩ := exists_isometry_quotient_of_absMax M hpair hinj hrΩ.subset B π hπl hfib
    hGHB trivial hmax
  exact ⟨hrΩ, B, π, hcov, hπl, hπs, hfib, hGHB, f, hfl, hf⟩

/-- **Barbot's uniformization of an absolutely maximal flat spacetime, with the quotient** (gx
l.2378–2380 and l.2400–2403 on the regular part): `𝒟` injective, `𝒟(M̃) = Ω⁺(Λ(Γ))` (future case)
or `Ω⁻(Λ(Γ))` (past case), `Γ` free and properly discontinuous there, and `𝒟` induces
`M ≅ ρ(Γ)\Ω^±`, presented by a GH flat spacetime `B` with projection `π`. -/
theorem uniformization_of_absMax (M : Causal.Flat.FlatSpacetime.{0} d) {x₀ : M}
    {D : Causal.UniversalCover M x₀ → Causal.Minkowski d}
    {ρ : Causal.Deck (Causal.UniversalCover.proj M x₀) →* Causal.Flat.isom d} {S : Set M}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ)
    (hcaus : (Causal.Flat.flatCausality d M).IsCausal) (h : Causal.Flat.DevelopsCC x₀ D S)
    (hlox : ∃ γ ∈ ρ.range, Causal.Flat.IsLoxodromic (Causal.Flat.linOf γ))
    (hmax : Causal.Flat.AbsMax (fun _ => True) M) :
    Injective D ∧
    ((Causal.Flat.FutureRegular (Causal.Flat.limitSetJ ρ.range) ∧
        range D = Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
        Causal.Flat.ActsFreelyProperlyOn ρ.range
          (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range)) ∧
        ∃ (B : Causal.Flat.FlatSpacetime.{0} d) (π : Causal.Flat.limitOpensPlus ρ.range → B),
          IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry d π ∧ Surjective π ∧
          (∀ p q : Causal.Flat.limitOpensPlus ρ.range,
            π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski d) = q) ∧
          Causal.Flat.GH B ∧
          ∃ f : M ≃ₜ B, Causal.Flat.IsLocalIsometry d f ∧
            ∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
              f (Causal.UniversalCover.proj M x₀ z) = π ⟨D z, hz⟩) ∨
      (Causal.Flat.PastRegular (Causal.Flat.limitSetJ ρ.range) ∧
        range D = Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range) ∧
        Causal.Flat.ActsFreelyProperlyOn ρ.range
          (Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range)) ∧
        ∃ (B : Causal.Flat.FlatSpacetime.{0} d) (π : Causal.Flat.limitOpensMinus ρ.range → B),
          IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry d π ∧ Surjective π ∧
          (∀ p q : Causal.Flat.limitOpensMinus ρ.range,
            π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski d) = q) ∧
          Causal.Flat.GH B ∧
          ∃ f : M ≃ₜ B, Causal.Flat.IsLocalIsometry d f ∧
            ∀ z (hz : D z ∈ Causal.Flat.limitOpensMinus ρ.range),
              f (Causal.UniversalCover.proj M x₀ z) = π ⟨D z, hz⟩)) := by
  have hcc := Causal.Flat.ccAction_of_developsCC hpair h
  have hfp := (Causal.Flat.Lox.bcor_loxo_proper_both hcc hlox).1
  refine ⟨Causal.Flat.uniformization_injective hpair hcaus h, ?_⟩
  rcases Causal.Flat.blem_loxregular hcc hlox with ⟨hF, he⟩ | ⟨hP, he⟩
  · obtain ⟨hr, hB⟩ := uniformization_quotient_aux M hpair hcaus h hlox hmax
      (Causal.Flat.limitOpensPlus ρ.range) he
    exact Or.inl ⟨hF, hr, he ▸ hfp, hB⟩
  · obtain ⟨hr, hB⟩ := uniformization_quotient_aux M hpair hcaus h hlox hmax
      (Causal.Flat.limitOpensMinus ρ.range) he
    exact Or.inr ⟨hP, hr, he ▸ hfp, hB⟩

end FlatEquality

/-! ## §2 Future completeness of the regular part (the first step of l.2350) -/

section RegFutureComplete

/-- **`Reg M̃` is future complete** (gx l.2350, "Barbot uniformization Theorem then implies future
completeness of the regular part"; `def:manifold_future_complete_all`'s condition for the universal
cover of a flat spacetime): if the developing map is injective with image `Ω⁺(Λ)`, then
`𝒟(J⁺(z)) = J⁺(𝒟 z)` and `𝒟(I⁺(z)) = I⁺(𝒟 z)` for every `z`. `Ω⁺(Λ)` is convex (so its causality
is the restricted one of `𝐌³`) and a future set (`J⁺(Ω⁺) ⊆ Ω⁺`). -/
theorem isFutureComplete_of_range_eq_omegaPlus (M : Causal.Flat.FlatSpacetime.{u} 2) {x₀ : M}
    {D : Causal.UniversalCover M x₀ → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj M x₀) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) (hinj : Injective D)
    {Λ : Set (Causal.Flat.PenroseSphere 2 × ℝ)} (hr : range D = Causal.Flat.omegaPlus Λ) :
    letI := Causal.Flat.flatCoverChartedSpace 2 M x₀
    haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) M x₀
    IsFutureComplete (Causal.Flat.flatCausality 2 (Causal.UniversalCover M x₀)) D := by
  letI := Causal.Flat.flatCoverChartedSpace 2 M x₀
  haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) M x₀
  have hDl : Causal.Flat.IsLocalIsometry 2 D :=
    Causal.Flat.isLocalIsometry_iff_eventually.2 ⟨hpair.gx.1, hpair.gx.2⟩
  have hemb : Causal.Flat.IsIsometricEmbedding 2 D := ⟨hDl, hinj⟩
  set U : TopologicalSpace.Opens (Causal.Minkowski 2) := ⟨range D, hDl.isOpenMap.isOpen_range⟩
  have hUc : Convex ℝ (U : Set (Causal.Minkowski 2)) := by
    show Convex ℝ (range D); rw [hr]; exact Causal.Flat.convex_omegaPlus Λ
  have hU : (U : Set (Causal.Minkowski 2)) = D '' ((⊤ : TopologicalSpace.Opens (Causal.UniversalCover M x₀)) : Set (Causal.UniversalCover M x₀)) := by
    simp [U, image_univ]
  have hrel := hemb.rel_iff ⊤ U hU
  rw [Causal.Flat.flatCausality_self] at hrel
  intro z
  have hfut : ∀ q, (Causal.minkowski 2).le ⊤ (D z) q → q ∈ range D := fun q hq => by
    rw [hr]; exact Causal.Flat.Jplus_omegaPlus_subset Λ ⟨D z, hr ▸ mem_range_self z, hq⟩
  constructor
  · ext q
    simp only [mem_image, Causal.Precausality.mem_Jplus_singleton]
    constructor
    · rintro ⟨w, hw, rfl⟩
      exact ((Causal.Flat.le_iff_of_convex hUc).1 (((hrel z w).1).1 hw)).2.2
    · intro hq
      obtain ⟨w, rfl⟩ := hfut q hq
      exact ⟨w, ((hrel z w).1).2 ((Causal.Flat.le_iff_of_convex hUc).2
        ⟨mem_range_self z, mem_range_self w, hq⟩), rfl⟩
  · ext q
    simp only [mem_image, Causal.Precausality.mem_Iplus_singleton]
    constructor
    · rintro ⟨w, hw, rfl⟩
      exact ((Causal.Flat.lt_iff_of_convex hUc).1 (((hrel z w).2).1 hw)).2.2
    · intro hq
      obtain ⟨w, rfl⟩ := hfut q ((Causal.minkowski 2).le_of_lt hq)
      exact ⟨w, ((hrel z w).2).2 ((Causal.Flat.lt_iff_of_convex hUc).2
        ⟨mem_range_self z, mem_range_self w, hq⟩), rfl⟩

end RegFutureComplete

/-! ## §3 The injectivity step of the headline's proof (l.2392–2394), abstractly -/

section InjectivityStep

variable {N : Type*} [TopologicalSpace N]

/-- **The injectivity step** (gx l.2392–2394): "Let `x, y ∈ M̃` with `𝒟(x) = 𝒟(y)`. Since `M` is
future complete, `𝒟(I⁺(x)) = I⁺(𝒟(x)) = I⁺(𝒟(y)) = 𝒟(I⁺(y))`, and since `I⁺(x)`, `I⁺(y)` are
subsets of `reg` and `𝒟|reg` is a bijection, `I⁺(x) = I⁺(y)`; `M̃` is future distinguishing, so
`x = y`." For any causality `C` and any `𝒟` future complete in the sense of
`def:manifold_future_complete_all`, injective on a set `R` containing every `I⁺(x)`. -/
theorem injective_of_isFutureComplete {C : Causal.Causality N} {D : N → Causal.Minkowski 2}
    (hfc : IsFutureComplete C D) {R : Set N} (hR : InjOn D R) (hI : ∀ x, C.Iplus ⊤ {x} ⊆ R)
    (hdist : IsFutureDistinguishing C) : Injective D := by
  intro x y hxy
  apply hdist
  have h : D '' C.Iplus ⊤ {x} = D '' C.Iplus ⊤ {y} := by
    rw [(hfc x).2, (hfc y).2, hxy]
  exact (hR.image_eq_image_iff (hI x) (hI y)).1 h

end InjectivityStep

/-! ## §3b The future-case selection: a BTZ point forbids a past-complete `Reg M̃` (DEC-77 (a)) -/

section FutureSelectionTools

open Filter Topology

open scoped Real
attribute [local instance] btzE0Structure

/-- Near a point of its source lying in the sector of `y₀`, a chart of `BTZE0`'s maximal a.e.
atlas is `g •` the sector chart `chartMap y₀` of the fixed base `y₀` (the angle branch of `y₀`). -/
theorem aeChart_eventually_chartMap_sector {c : OpenPartialHomeomorph BTZE0 (Causal.Minkowski 2)}
    (hc : c ∈ aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) {x : BTZE0}
    (hx : x ∈ c.source) {y₀ : E0} (hy₀ : y₀.2 ≠ 0) (hxs : E0.toPaper x ∈ E0.sector y₀) :
    ∃ g : Causal.Flat.isom 2, ∀ᶠ z in 𝓝 x,
      c z = g • E0.chartMap y₀ (E0.toPaper z) := by
  set y := E0.toPaper x
  have hyax : y ∉ E0.axis := E0.not_mem_axis_of_mem_sector hxs
  set p : ℝ × ℝ × ℝ := (y.1, E0.rad y, E0.angle y₀ y)
  have hpx : orbitMk (GammaA (2 * π)) (btzPaperCyl p) = x := by
    rw [← E0.toPaper_symm_eq_orbitMk hyax (E0.polar_angle hy₀ y), Homeomorph.symm_apply_apply]
  obtain ⟨g, hg⟩ := btz_chart_eq_smul_btzPaperDev isBTZStructure_btzE0 hc
    (p := p) (E0.rad_pos.2 hyax) (by rw [hpx]; exact hx)
  set φ : BTZE0 → ℝ × ℝ × ℝ := fun z =>
    ((E0.toPaper z).1, E0.rad (E0.toPaper z), E0.angle y₀ (E0.toPaper z))
  have hφ : ContinuousAt φ x := by
    have hang : ContinuousAt (E0.angle y₀) y :=
      (E0.continuousOn_angle y₀).continuousAt ((E0.isOpen_sector y₀).mem_nhds hxs)
    have h3 : ContinuousAt (fun z => E0.angle y₀ (E0.toPaper z)) x :=
      ContinuousAt.comp (g := E0.angle y₀) (f := E0.toPaper) hang E0.toPaper.continuous.continuousAt
    exact (continuous_fst.comp E0.toPaper.continuous).continuousAt.prodMk
      ((E0.continuous_rad.comp E0.toPaper.continuous).continuousAt.prodMk h3)
  have h1 : ∀ᶠ z in 𝓝 x, c (orbitMk (GammaA (2 * π)) (btzPaperCyl (φ z))) =
      g • btzPaperDev (φ z) := hφ.eventually hg
  have h2 : ∀ᶠ z in 𝓝 x, E0.toPaper z ∈ E0.sector y₀ :=
    E0.toPaper.continuous.continuousAt.preimage_mem_nhds
      ((E0.isOpen_sector y₀).mem_nhds hxs)
  refine ⟨g, ?_⟩
  filter_upwards [h1, h2] with z hz1 hz2
  have hzax : E0.toPaper z ∉ E0.axis := E0.not_mem_axis_of_mem_sector hz2
  have hz : orbitMk (GammaA (2 * π)) (btzPaperCyl (φ z)) = z := by
    rw [← E0.toPaper_symm_eq_orbitMk hzax (E0.polar_angle hy₀ (E0.toPaper z)),
      Homeomorph.symm_apply_apply]
  rw [hz] at hz1
  rw [hz1, E0.chartMap_eq]

/-- **A locally isometric reading through an open map is globally one isometry** on a
preconnected space: if near every point `D = g • F` for some `g ∈ Isom(𝐌³)`, one `g` works
everywhere (two isometries agreeing on the non-empty open `D(t)` are equal). -/
theorem exists_isom_eq_of_locally {X : Type*} [TopologicalSpace X] [PreconnectedSpace X]
    [Nonempty X] {D F : X → Causal.Minkowski 2} (hD : IsOpenMap D)
    (h : ∀ x, ∃ g : Causal.Flat.isom 2, ∀ᶠ y in 𝓝 x, D y = g • F y) :
    ∃ g : Causal.Flat.isom 2, ∀ y, D y = g • F y := by
  have huniq : ∀ (x : X) (g g' : Causal.Flat.isom 2), (∀ᶠ y in 𝓝 x, D y = g • F y) →
      (∀ᶠ y in 𝓝 x, D y = g' • F y) → g = g' := by
    intro x g g' h1 h2
    obtain ⟨t, ht, hto, hxt⟩ := eventually_nhds_iff.1 (h1.and h2)
    have hA : ((g⁻¹ : Causal.Flat.isom 2) : Causal.Minkowski 2 ≃ᵃ[ℝ] Causal.Minkowski 2).toAffineMap =
        ((g'⁻¹ : Causal.Flat.isom 2) : Causal.Minkowski 2 ≃ᵃ[ℝ] Causal.Minkowski 2).toAffineMap := by
      refine AffineMap.ext_on ((hD t hto).affineSpan_eq_top ⟨D x, x, hxt, rfl⟩) ?_
      rintro _ ⟨y, hy, rfl⟩
      show ((g⁻¹ : Causal.Flat.isom 2) : Causal.Minkowski 2 ≃ᵃ[ℝ] Causal.Minkowski 2) (D y) =
        ((g'⁻¹ : Causal.Flat.isom 2) : Causal.Minkowski 2 ≃ᵃ[ℝ] Causal.Minkowski 2) (D y)
      rw [← Causal.Flat.isom_smul_def, ← Causal.Flat.isom_smul_def]
      conv_lhs => rw [(ht y hy).1, inv_smul_smul]
      rw [(ht y hy).2, inv_smul_smul]
    have : (g⁻¹ : Causal.Flat.isom 2) = g'⁻¹ :=
      Subtype.ext (AffineEquiv.toAffineMap_injective hA)
    exact inv_injective this
  choose A hA using h
  have hlc : IsLocallyConstant A := by
    rw [IsLocallyConstant.iff_eventually_eq]
    intro x
    filter_upwards [(hA x).eventually_nhds] with y hy
    exact huniq y _ _ (hA y) hy
  obtain ⟨x₀⟩ := ‹Nonempty X›
  refine ⟨A x₀, fun y => ?_⟩
  rw [← hlc.apply_eq_of_preconnectedSpace y x₀]
  exact (hA y).self_of_nhds

end FutureSelectionTools

section FutureSelection

open Filter Topology TopologicalSpace E0CBG E0Spear E0AbsMax
open scoped Causal.Flat
attribute [local instance] btzE0Structure

variable {M : Type} [TopologicalSpace M] [T2Space M] [ConnectedSpace M]
  [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid]

/-- The base point in `M` of a point of `Reg M̃` (the universal cover of `Reg M`). -/
noncomputable def regCoverBase {x₀ : e0RegMFlat M}
    (w : Causal.UniversalCover (e0RegMFlat M) x₀) : M :=
  (show E0LM.e0RegM M from Causal.UniversalCover.proj (e0RegMFlat M) x₀ w).1

theorem continuous_regCoverBase {x₀ : e0RegMFlat M} :
    Continuous (regCoverBase (M := M) (x₀ := x₀)) :=
  continuous_subtype_val.comp (Causal.Flat.isCoveringMap_flatCover_proj 2 (e0RegMFlat M) x₀).continuous

/-- **Near a regular point read in a BTZ chart, the developing map is `g •` the sector chart**:
if `w ∈ Reg M̃` lies over a point of the source of the chart `chartAt E0Y x` of `M`, read in the
`𝔼₀` part in the sector of `y₀`, then near `w`, `𝒟 = g • chartMap y₀ ∘ paperOfY ∘ chartAt E0Y x`
for some `g ∈ Isom(𝐌³)` (the developing map, the cover's charts, the flat chart of `Reg M`, and the
transition to the chart at `x`, each locally an isometry). -/
theorem dev_eventually_chartMap_sector {x₀ : e0RegMFlat M}
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) (x : M) {y₀ : E0} (hy₀ : y₀.2 ≠ 0)
    (w : Causal.UniversalCover (e0RegMFlat M) x₀)
    (hw : regCoverBase w ∈ (chartAt E0Y x).source)
    (hwr : chartAt E0Y x (regCoverBase w) ∈ range Sum.inr)
    (hws : E0.paperOfY (chartAt E0Y x (regCoverBase w)) ∈ E0.sector y₀) :
    ∃ g : Causal.Flat.isom 2, ∀ᶠ w' in 𝓝 w,
      D w' = g • E0.chartMap y₀ (E0.paperOfY (chartAt E0Y x (regCoverBase w'))) := by
  letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
  haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
  have hDl : Causal.Flat.IsLocalIsometry 2 D :=
    Causal.Flat.isLocalIsometry_iff_eventually.2 ⟨hpair.gx.1, hpair.gx.2⟩
  obtain ⟨g2, hg2⟩ := (Causal.Flat.isLocalIsometry_iff_eventually.1 hDl).2 w
  have hpl := Causal.Flat.isLocalIsometry_flatCover_proj (d := 2) (M := e0RegMFlat M) x₀
  obtain ⟨g1, hg1⟩ := (Causal.Flat.isLocalIsometry_iff_eventually.1 hpl).2 w
  set q := Causal.UniversalCover.proj (e0RegMFlat M) x₀ with hq
  set y : E0LM.e0RegM M := q w with hy
  have hyw : (y : M) = regCoverBase w := rfl
  set e := chartAt E0Y x with he
  set em := chartAt E0Y (y : M) with hem
  rw [← hyw] at hw hwr hws
  obtain ⟨u, hu⟩ := hwr
  have hus : E0.toPaper u ∈ E0.sector y₀ := by rw [← E0.paperOfY_inr, hu]; exact hws
  have hureg : u ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 :=
    (E0.mem_reg_iff_toPaper u).2 (E0.not_mem_axis_of_mem_sector hus)
  obtain ⟨c'', hc'', hu''⟩ := mem_support.1 hureg
  obtain ⟨g3, hg3⟩ := aeChart_eventually_chartMap_sector hc'' hu'' hy₀ hus
  set c₂ := e0Inr.symm.trans c'' with hc₂def
  have hc₂ : c₂ ∈ e0Atlas := e0InrChart_mem_e0Atlas hc''
  set R := E0LM.regAtlasChart y with hR
  have ht : e.symm.trans em ∈ e0Groupoid :=
    HasGroupoid.compatible (chart_mem_atlas E0Y x) (chart_mem_atlas E0Y (y : M))
  have hyem : (y : M) ∈ em.source := mem_chart_source E0Y (y : M)
  have hc₂src : e (y : M) ∈ c₂.source := by
    rw [← hu]; exact mem_e0InrChart_source.2 ⟨u, hu'', rfl⟩
  have hvsrc : c₂ (e y) ∈ (c₂.symm.trans ((e.symm.trans em).trans R)).source := by
    simp only [OpenPartialHomeomorph.trans_source, mem_inter_iff, mem_preimage,
      OpenPartialHomeomorph.symm_source, OpenPartialHomeomorph.coe_trans, comp_apply,
      c₂.left_inv hc₂src, e.left_inv hw]
    exact ⟨c₂.map_source hc₂src, ⟨e.map_source hw, hyem⟩, E0LM.mem_regAtlasChart_source y⟩
  obtain ⟨g4, hg4⟩ := E0LM.e0_flat_transition_aux ht hc₂ (E0LM.regAtlasChart_mem y) _ hvsrc
  have hcont : ContinuousAt (fun m => c₂ (e m)) (y : M) :=
    (c₂.continuousAt hc₂src).comp (e.continuousAt hw)
  have hM : ∀ᶠ m in 𝓝 (y : M), R (em m) = (g4 * g3) • E0.chartMap y₀ (E0.paperOfY (e m)) := by
    have hA := hcont.eventually hg4
    have hB : ∀ᶠ m in 𝓝 (y : M), e m ∈ c₂.source :=
      (e.continuousAt hw).preimage_mem_nhds (c₂.open_source.mem_nhds hc₂src)
    have hC : ∀ᶠ m in 𝓝 (y : M), m ∈ e.source := e.open_source.mem_nhds hw
    have hval : e0Inr.symm (e (y : M)) = u := by rw [← hu, e0Inr_symm_inr]
    have hT : Tendsto (fun m => e0Inr.symm (e m)) (𝓝 (y : M)) (𝓝 u) := by
      have h0 : ContinuousAt (fun m => e0Inr.symm (e m)) (y : M) :=
        (e0Inr.symm.continuousAt (by rw [e0Inr_symm_source]; exact ⟨u, hu⟩)).comp
          (e.continuousAt hw)
      have h1 := h0.tendsto
      rwa [hval] at h1
    have hD' := hT.eventually hg3
    filter_upwards [hA, hB, hC, hD'] with m hA hB hC hD'
    simp only [OpenPartialHomeomorph.coe_trans, comp_apply] at hA
    rw [c₂.left_inv hB, e.left_inv hC] at hA
    rw [hA, mul_smul]
    congr 1
  have hbc : ContinuousAt (fun w' => regCoverBase w') w := continuous_regCoverBase.continuousAt
  have hM' := hbc.eventually hM
  refine ⟨g2 * g1⁻¹ * (g4 * g3), ?_⟩
  filter_upwards [hg2, hg1, hM'] with w' h2 h1 h0
  have hchart : (chartAt (Causal.Minkowski 2) (q w)) (q w') = R (em (regCoverBase w')) := by
    show ((E0LM.regChartM y).subtypeRestr ⟨y⟩) (q w') = _
    rw [regChart_subtypeRestr_eq]
    rfl
  rw [chartAt_self_eq, OpenPartialHomeomorph.refl_apply, id] at h2
  rw [hchart, h0] at h1
  have h1' : (chartAt (Causal.Minkowski 2) w) w' =
      g1⁻¹ • (g4 * g3) • E0.chartMap y₀ (E0.paperOfY (e (regCoverBase w'))) := by
    rw [h1, inv_smul_smul]
  rw [h2, h1', ← mul_smul, ← mul_smul]

/-- `btzPaperDev (τ₁ + s, s, 0) = (τ₁ + s, (τ₁, 0))`: the radial ray at angle `0`. -/
theorem btzPaperDev_ray (τ₁ s : ℝ) :
    btzPaperDev (τ₁ + s, s, 0) =
      ((τ₁ + s, WithLp.toLp 2 ![τ₁, 0]) : Causal.Minkowski 2) := by
  simp only [btzPaperDev]
  refine Prod.ext (by simp) ?_
  ext i; fin_cases i <;> simp

/-- **A BTZ point forbids a past-complete developed regular part** (the future-case selection,
DEC-77 (a); D-11 (d)'s mechanism without extending `𝒟`): if `M` has a BTZ point `x`, no developing
map of `Reg M̃` is injective with a past-complete image (`p ≤ 𝒟 z ⇒ p ∈ 𝒟(Reg M̃)`). Proof: in the
chart at `x` (paper coordinates, `x ↦ (τ₁, 0)`), the radial segment `c(s) = (τ₁ + s, s)`, `s ↓ 0`,
runs in `Reg M` towards `x`; on the component `X` of the lifted sector containing a lift `z̃` of
`c(δ)`, `𝒟 = g • chartMap` (`dev_eventually_chartMap_sector`, `exists_isom_eq_of_locally`), so the
lifts `c̃(s) ∈ X` develop to `g • (τ₁ + s, τ₁, 0) → p := g • (τ₁, τ₁, 0) ≤ 𝒟 z̃`. Past completeness
gives `p = 𝒟 w̃`; `𝒟` is an open embedding, so `c̃(s) → w̃`, and the base points `c(s)` converge
both to the regular point `w̃`'s base and to the BTZ point `x` in the Hausdorff `M`. -/
theorem false_of_sing_of_pastComplete (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    {x₀ : e0RegMFlat M}
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) (hinj : Injective D)
    (hpast : ∀ (p : Causal.Minkowski 2) (z : Causal.UniversalCover (e0RegMFlat M) x₀),
      (Causal.minkowski 2).le ⊤ p (D z) → p ∈ range D) : False := by
  letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
  haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
  haveI := Causal.Flat.locPathConnectedSpace_of_flat 2 (Causal.UniversalCover (e0RegMFlat M) x₀)
  haveI := Causal.Flat.locPathConnectedSpace_of_flat 2 (e0RegMFlat M)
  haveI : PathConnectedSpace (e0RegMFlat M) := pathConnectedSpace_iff_connectedSpace.2 inferInstance
  have hcov := Causal.Flat.isCoveringMap_flatCover_proj 2 (e0RegMFlat M) x₀
  have hDl : Causal.Flat.IsLocalIsometry 2 D :=
    Causal.Flat.isLocalIsometry_iff_eventually.2 ⟨hpair.gx.1, hpair.gx.2⟩
  set q := Causal.UniversalCover.proj (e0RegMFlat M) x₀ with hq
  obtain ⟨x, hx⟩ := hsing
  set e := chartAt E0Y x with he
  obtain ⟨b, hb, hbax⟩ := E0LM.mem_e0SingY_zero_iff.1 (show e x ∈ e0SingY 0 from hx)
  set a := E0.toPaper b with ha
  have ha2 : a.2 = 0 := hbax
  set Φ := e.trans E0.paperOfY with hΦ
  have hxΦ : x ∈ Φ.source := by
    rw [OpenPartialHomeomorph.trans_source]
    refine ⟨mem_chart_source E0Y x, ?_⟩
    show e x ∈ E0.paperOfY.source
    rw [E0.paperOfY_source, hb]; exact ⟨b, rfl⟩
  have hΦx : Φ x = a := by
    show E0.paperOfY (e x) = a
    rw [hb, E0.paperOfY_inr]
  have hat : a ∈ Φ.target := hΦx ▸ Φ.map_source hxΦ
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 Φ.open_target a hat
  set y₀ : E0 := (a.1, 1) with hy₀def
  have hy₀ : y₀.2 ≠ 0 := one_ne_zero
  set V : Set E0 := Metric.ball a ε ∩ E0.sector y₀ with hV
  have hVo : IsOpen V := Metric.isOpen_ball.inter (E0.isOpen_sector y₀)
  set c : ℝ → E0 := fun s => (a.1 + s, (s : ℂ)) with hcdef
  have hcc : Continuous c := (continuous_const.add continuous_id).prodMk Complex.continuous_ofReal
  have hc0 : c 0 = a := Prod.ext (by simp [c]) (by simp [c, ha2])
  have hcV : ∀ s, 0 < s → s < ε → c s ∈ V := by
    intro s hs hsε
    refine ⟨?_, ?_⟩
    · rw [Metric.mem_ball, Prod.dist_eq]
      have h1 : dist (a.1 + s) a.1 = s := by
        rw [Real.dist_eq, add_sub_cancel_left, abs_of_pos hs]
      have h2 : dist (s : ℂ) a.2 = s := by
        rw [ha2, dist_zero_right, Complex.norm_real, Real.norm_of_nonneg hs.le]
      show max (dist (a.1 + s) a.1) (dist (s : ℂ) a.2) < ε
      rw [h1, h2, max_self]; exact hsε
    · show (s : ℂ) / 1 ∈ Complex.slitPlane
      rw [div_one]; exact Complex.ofReal_mem_slitPlane.2 hs
  have hctgt : ∀ s, 0 < s → s < ε → c s ∈ Φ.target := fun s hs hsε => hball (hcV s hs hsε).1
  set κ : ℝ → M := fun s => Φ.symm (c s) with hκdef
  have hκsrc : ∀ s, 0 < s → s < ε → κ s ∈ Φ.source := fun s hs hsε => Φ.map_target (hctgt s hs hsε)
  have hΦκ : ∀ s, 0 < s → s < ε → Φ (κ s) = c s := fun s hs hsε => Φ.right_inv (hctgt s hs hsε)
  have hκW : ∀ s, 0 < s → s < ε → κ s ∈ Φ.source ∩ Φ ⁻¹' V := fun s hs hsε =>
    ⟨hκsrc s hs hsε, by rw [mem_preimage, hΦκ s hs hsε]; exact hcV s hs hsε⟩
  -- the points of `Φ.source ∩ Φ⁻¹ V` are regular
  have hWreg : ∀ m ∈ Φ.source ∩ Φ ⁻¹' V, m ∈ E0LM.e0RegM M := by
    rintro m ⟨hm, hmV⟩
    rw [OpenPartialHomeomorph.trans_source] at hm
    obtain ⟨hm1, hm2⟩ := hm
    rw [E0LM.mem_e0RegM_iff hm1]
    rw [mem_preimage, E0.paperOfY_source] at hm2
    obtain ⟨u, hu⟩ := hm2
    rw [← hu, E0.inr_mem_e0Reg_iff_toPaper]
    have : E0.toPaper u = Φ m := by
      show E0.toPaper u = E0.paperOfY (e m); rw [← hu, E0.paperOfY_inr]
    rw [this]; exact E0.not_mem_axis_of_mem_sector hmV.2
  -- `κ s → x` as `s ↓ 0`
  have hκt : Tendsto κ (𝓝[>] 0) (𝓝 x) := by
    have h1 : Tendsto c (𝓝 0) (𝓝 a) := by rw [← hc0]; exact hcc.tendsto 0
    have h2 : Tendsto Φ.symm (𝓝 a) (𝓝 x) := by
      have := Φ.continuousAt_symm hat
      rw [ContinuousAt, ← hΦx, Φ.left_inv hxΦ, hΦx] at this
      exact this
    exact (h2.comp h1).mono_left nhdsWithin_le_nhds
  set δ : ℝ := ε / 2 with hδdef
  have hδ : 0 < δ := half_pos hε
  have hδε : δ < ε := half_lt_self hε
  -- the base lift
  obtain ⟨z₁, hz₁⟩ := Causal.UniversalCover.proj_surjective (Y := e0RegMFlat M) (y₀ := x₀)
    (show e0RegMFlat M from ⟨κ δ, hWreg _ (hκW δ hδ hδε)⟩)
  have hz₁b : regCoverBase z₁ = κ δ := by
    show (show E0LM.e0RegM M from q z₁).1 = κ δ
    rw [show q z₁ = _ from hz₁]
  set X0 : Set (Causal.UniversalCover (e0RegMFlat M) x₀) :=
    regCoverBase ⁻¹' (Φ.source ∩ Φ ⁻¹' V) with hX0
  have hX0o : IsOpen X0 := (Φ.isOpen_inter_preimage hVo).preimage continuous_regCoverBase
  have hz₁X0 : z₁ ∈ X0 := by rw [hX0, mem_preimage, hz₁b]; exact hκW δ hδ hδε
  set X := connectedComponentIn X0 z₁ with hXdef
  have hXo : IsOpen X := hX0o.connectedComponentIn
  have hXX0 : X ⊆ X0 := connectedComponentIn_subset _ _
  have hz₁X : z₁ ∈ X := mem_connectedComponentIn hz₁X0
  -- on `X`, `𝒟 = g • chartMap y₀ ∘ Φ`
  haveI : PreconnectedSpace X := Subtype.preconnectedSpace isPreconnected_connectedComponentIn
  haveI : Nonempty X := ⟨⟨z₁, hz₁X⟩⟩
  obtain ⟨g, hg⟩ := exists_isom_eq_of_locally (X := X) (D := fun w => D w.1)
    (F := fun w => E0.chartMap y₀ (E0.paperOfY (e (regCoverBase w.1))))
    (hDl.isOpenMap.comp hXo.isOpenMap_subtype_val) (fun w => by
      have hw := hXX0 w.2
      rw [hX0, mem_preimage] at hw
      obtain ⟨hw1, hw2⟩ := hw
      rw [OpenPartialHomeomorph.trans_source] at hw1
      obtain ⟨g', hg'⟩ := dev_eventually_chartMap_sector hpair x hy₀ w.1 hw1.1
        (by rw [← E0.paperOfY_source]; exact hw1.2) hw2.2
      exact ⟨g', (continuous_subtype_val.tendsto w).eventually hg'⟩)
  have hgX : ∀ w ∈ X, D w = g • E0.chartMap y₀ (Φ (regCoverBase w)) := fun w hw => hg ⟨w, hw⟩
  -- lifts of the segment
  have hlift : ∀ s, 0 < s → s ≤ δ → ∃ w ∈ X, regCoverBase w = κ s := by
    intro s hs hsδ
    set σ : unitInterval → ℝ := fun t => δ + (t : ℝ) * (s - δ) with hσ
    have hσc : Continuous σ := continuous_const.add (continuous_subtype_val.mul continuous_const)
    have hσlo : ∀ t, s ≤ σ t := fun t => by
      have h1 : (t : ℝ) ≤ 1 := t.2.2
      have : (t : ℝ) * (s - δ) ≥ 1 * (s - δ) := mul_le_mul_of_nonpos_right h1 (by linarith)
      simp only [σ]; linarith
    have hσhi : ∀ t, σ t ≤ δ := fun t => by
      have h0 : 0 ≤ (t : ℝ) := t.2.1
      have : (t : ℝ) * (s - δ) ≤ 0 := mul_nonpos_of_nonneg_of_nonpos h0 (by linarith)
      simp only [σ]; linarith
    have hσpos : ∀ t, 0 < σ t := fun t => hs.trans_le (hσlo t)
    have hσε : ∀ t, σ t < ε := fun t => (hσhi t).trans_lt hδε
    have hκσ : Continuous fun t => κ (σ t) :=
      Φ.continuousOn_symm.comp_continuous (hcc.comp hσc) fun t => hctgt _ (hσpos t) (hσε t)
    let γ : C(unitInterval, e0RegMFlat M) :=
      ⟨fun t => (show e0RegMFlat M from ⟨κ (σ t), hWreg _ (hκW _ (hσpos t) (hσε t))⟩),
        hκσ.subtype_mk _⟩
    have hγ0 : γ 0 = q z₁ := by
      rw [show q z₁ = _ from hz₁]; apply Subtype.ext
      show κ (σ 0) = κ δ
      simp [σ]
    set Γ := hcov.liftPath γ z₁ hγ0 with hΓ
    have hΓq : ∀ t, regCoverBase (Γ t) = κ (σ t) := fun t => by
      have := congrFun (hcov.liftPath_lifts γ z₁ hγ0) t
      show (show E0LM.e0RegM M from q (Γ t)).1 = _
      rw [show q (Γ t) = γ t from this]
      rfl
    have hsub : range Γ ⊆ X0 := by
      rintro _ ⟨t, rfl⟩
      rw [hX0, mem_preimage, hΓq]; exact hκW _ (hσpos t) (hσε t)
    have hΓX : range Γ ⊆ X := (isPreconnected_range Γ.continuous).subset_connectedComponentIn
      ⟨0, hcov.liftPath_zero γ z₁ hγ0⟩ hsub
    refine ⟨Γ 1, hΓX ⟨1, rfl⟩, ?_⟩
    rw [hΓq]; simp [σ]
  have hlift' : ∀ s : ℝ, ∃ w, 0 < s → s ≤ δ → w ∈ X ∧ regCoverBase w = κ s := by
    intro s
    by_cases h : 0 < s ∧ s ≤ δ
    · obtain ⟨w, hw, hw'⟩ := hlift s h.1 h.2
      exact ⟨w, fun _ _ => ⟨hw, hw'⟩⟩
    · exact ⟨z₁, fun h1 h2 => absurd ⟨h1, h2⟩ h⟩
  choose C hC using hlift'
  -- the developed lifts
  set v : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![a.1, 0] with hv
  have hDc : ∀ s, 0 < s → s ≤ δ → D (C s) = g • ((a.1 + s, v) : Causal.Minkowski 2) := by
    intro s hs hsδ
    obtain ⟨hCX, hCb⟩ := hC s hs hsδ
    rw [hgX _ hCX, hCb, hΦκ s hs (hsδ.trans_lt hδε), E0.chartMap_eq]
    have hrad : E0.rad (c s) = s := by
      simp only [E0.rad, c, Complex.norm_real, Real.norm_of_nonneg hs.le]
    have hang : E0.angle y₀ (c s) = 0 := by
      simp only [E0.angle, y₀, c, Complex.arg_one, div_one, zero_add]
      exact Complex.arg_ofReal_of_nonneg hs.le
    rw [hrad, hang]
    exact congrArg _ (btzPaperDev_ray a.1 s)
  have hDz₁ : D z₁ = g • ((a.1 + δ, v) : Causal.Minkowski 2) := by
    have hC1 := hC δ hδ le_rfl
    rw [hgX _ hz₁X, hz₁b, ← hC1.2, ← hgX _ hC1.1]
    exact hDc δ hδ le_rfl
  set p : Causal.Minkowski 2 := g • ((a.1, v) : Causal.Minkowski 2) with hp
  have hle : (Causal.minkowski 2).le ⊤ p (D z₁) := by
    rw [hDz₁, hp, Causal.Flat.isom_le_top_iff, Causal.minkowski_le_top_iff]
    simp only [sub_self, norm_zero, add_sub_cancel_left]
    exact hδ.le
  obtain ⟨w₁, hw₁⟩ := hpast p z₁ hle
  have hev : ∀ᶠ s in 𝓝[>] (0 : ℝ), s ∈ Ioo 0 δ := Ioo_mem_nhdsGT hδ
  have hDt : Tendsto (D ∘ C) (𝓝[>] 0) (𝓝 (D w₁)) := by
    rw [hw₁]
    have h1 : Tendsto (fun s : ℝ => g • ((a.1 + s, v) : Causal.Minkowski 2)) (𝓝[>] 0) (𝓝 p) := by
      have hcont : Continuous fun s : ℝ => g • ((a.1 + s, v) : Causal.Minkowski 2) :=
        (continuous_const_smul g).comp ((continuous_const.add continuous_id).prodMk continuous_const)
      have := hcont.tendsto 0
      simp only [add_zero] at this
      exact this.mono_left nhdsWithin_le_nhds
    refine h1.congr' ?_
    filter_upwards [hev] with s hs
    exact (hDc s hs.1 hs.2.le).symm
  have hemb : IsOpenEmbedding D :=
    .of_continuous_injective_isOpenMap hDl.continuous hinj hDl.isOpenMap
  have hCt : Tendsto C (𝓝[>] 0) (𝓝 w₁) := hemb.isEmbedding.tendsto_nhds_iff.2 hDt
  have hbt : Tendsto (regCoverBase ∘ C) (𝓝[>] 0) (𝓝 (regCoverBase w₁)) :=
    (continuous_regCoverBase.tendsto _).comp hCt
  have hbx : Tendsto (regCoverBase ∘ C) (𝓝[>] 0) (𝓝 x) := by
    refine hκt.congr' ?_
    filter_upwards [hev] with s hs
    exact ((hC s hs.1 hs.2.le).2).symm
  have hxw : regCoverBase w₁ = x := tendsto_nhds_unique hbt hbx
  have hreg : regCoverBase w₁ ∈ E0LM.e0RegM M := (show E0LM.e0RegM M from q w₁).2
  rw [hxw] at hreg
  exact hreg hx

end FutureSelection

/-! ## §3c A non-abelian free group is not metabelian (DEC-76's « non-abelian », algebraically) -/

section FreeMetabelian

open scoped commutatorElement

/-- In `F₂ = ⟨a, b⟩`, the commutators `⁅a, b⁆` and `⁅a, b⁻¹⁆` do not commute (by reduction). -/
theorem freeGroup_fin2_comm_ne :
    ⁅⁅FreeGroup.of (0 : Fin 2), FreeGroup.of (1 : Fin 2)⁆,
      ⁅FreeGroup.of (0 : Fin 2), (FreeGroup.of (1 : Fin 2))⁻¹⁆⁆ ≠ 1 := by
  decide

/-- A free group on at most one generator is commutative. -/
theorem freeGroup_commute_of_subsingleton {X : Type*} [Subsingleton X] (a b : FreeGroup X) :
    Commute a b := by
  induction a using FreeGroup.induction_on with
  | C1 => exact Commute.one_left b
  | of x =>
    induction b using FreeGroup.induction_on with
    | C1 => exact Commute.one_right _
    | of y => rw [Subsingleton.elim x y]
    | inv_of y h => exact h.inv_right
    | mul y z hy hz => exact hy.mul_right hz
  | inv_of x h => exact h.inv_left
  | mul x y hx hy => exact hx.mul_left hy

/-- A free group on two distinct generators is not metabelian. -/
theorem freeGroup_not_isMetabelianGroup {X : Type*} {a b : X} (hab : a ≠ b) :
    ¬ IsMetabelianGroup (FreeGroup X) := by
  classical
  intro h
  set f : FreeGroup X →* FreeGroup (Fin 2) :=
    FreeGroup.lift (fun i => if i = a then FreeGroup.of 0 else if i = b then FreeGroup.of 1 else 1)
  have h1 := congrArg f (h (FreeGroup.of a) (FreeGroup.of b) (FreeGroup.of a) (FreeGroup.of b)⁻¹)
  simp only [map_commutatorElement, map_inv, map_one, f, FreeGroup.lift_apply_of,
    if_neg (Ne.symm hab)] at h1
  exact freeGroup_fin2_comm_ne h1

/-- **A non-abelian free group is not metabelian.** -/
theorem not_isMetabelianGroup_of_isFreeGroup {G : Type*} [Group G] [IsFreeGroup G]
    (hna : ∃ x y : G, x * y ≠ y * x) : ¬ IsMetabelianGroup G := by
  intro h
  set e := IsFreeGroup.toFreeGroup G
  by_cases hs : Subsingleton (IsFreeGroup.Generators G)
  · obtain ⟨x, y, hxy⟩ := hna
    apply hxy
    apply e.injective
    rw [map_mul, map_mul]
    exact (freeGroup_commute_of_subsingleton (e x) (e y)).eq
  · obtain ⟨a, b, hab⟩ := (not_subsingleton_iff_nontrivial.1 hs).exists_pair_ne
    exact freeGroup_not_isMetabelianGroup hab fun p q r s => by
      have := h (e.symm p) (e.symm q) (e.symm r) (e.symm s)
      apply e.symm.injective
      simpa [map_commutatorElement] using this

/-- `not_isMetabelianGroup_of_isFreeGroup` with freeness as an explicit hypothesis. -/
theorem not_isMetabelianGroup_of_isFreeGroup' {G : Type*} [Group G] (hfree : IsFreeGroup G)
    (hna : ∃ x y : G, x * y ≠ y * x) : ¬ IsMetabelianGroup G :=
  not_isMetabelianGroup_of_isFreeGroup hna

end FreeMetabelian

/-! ### The easy halves of `def:manifold_future_complete_all` on `M̃` (DEC-118 (a))

`D(J⁺(x)) ⊆ J⁺(D x)` and `D(I⁺(x)) ⊆ I⁺(D x)` for the chart-generated causality of every
`\widetilde M`-datum: `lem:increasing_map` (`btzTilde_le_dev`, `BTZTildeData.increasing_lt`). -/

section TildeSubsets

universe w

attribute [local instance] btzE0Structure

variable {M : Type w} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
  [FirstCountableTopology M] [ConnectedSpace M]
  [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) M]
  {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M)}
  {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
  {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ DInfty × ℝ}

/-- `D(J⁺(x)) ⊆ J⁺(D x)` on `M̃` (chart-generated causality). -/
theorem BTZTildeData.dev_image_Jplus_subset (d : BTZTildeData M y₀ Φ) (x : d.Space) :
    d.D '' d.causality.Jplus ⊤ {x} ⊆ (Causal.minkowski 2).Jplus ⊤ {d.D x} := by
  rintro _ ⟨w, hw, rfl⟩
  have hw' : d.causality.le ⊤ x (w : d.Space) := Causal.Precausality.mem_Jplus_singleton.1 hw
  exact Causal.Precausality.mem_Jplus_singleton.2 (btzTilde_le_dev (hD := d.isBTZTildeDev) hw').1

/-- `D(I⁺(x)) ⊆ I⁺(D x)` on `M̃` (chart-generated causality). -/
theorem BTZTildeData.dev_image_Iplus_subset (d : BTZTildeData M y₀ Φ) (x : d.Space) :
    d.D '' d.causality.Iplus ⊤ {x} ⊆ (Causal.minkowski 2).Iplus ⊤ {d.D x} := by
  rintro _ ⟨w, hw, rfl⟩
  have hw' : d.causality.lt ⊤ x (w : d.Space) := Causal.Precausality.mem_Iplus_singleton.1 hw
  exact Causal.Precausality.mem_Iplus_singleton.2 (d.increasing_lt hw')

/-- **`𝒟` is injective on `M̃`** (the headline's first bullet, the step l.2392–2394 on the maximal
branched covering; DEC-106: the charts and their `≪` from `T_BTZ`, `M`'s GH in `M`): if `M` is
globally hyperbolic, `M̃` future complete for the chart-generated `≪`
(`def:manifold_future_complete_all` read as `IsBTZFutureComplete`, the conclusion of
`prop:globally_hyperbolic_cauchy_complete_manifolds`), `𝒟` injective on `reg M̃` (Barbot) and every
`I⁺(x)` regular (B21: a BTZ point is not in the chronological future of anything), then `𝒟` is
injective on `M̃`. Future distinguishing is `BTZTildeData.isFutureDistinguishing_of_base`. -/
theorem BTZTildeData.injective_D_of_isBTZFutureComplete (d : BTZTildeData M y₀ Φ)
    (hM : IsBTZSingModelled M) (hG : (e0ManifoldCausality M hM).GloballyHyperbolic)
    (hfc : BTZTildeData.IsBTZFutureComplete M d)
    (hreg : InjOn d.D {e | e.base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M})
    (hI : ∀ x : d.Space, d.causality.Iplus ⊤ {x} ⊆
      {e | e.base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M}) :
    Injective d.D :=
  injective_of_isFutureComplete (N := d.Space) hfc hreg hI (d.isFutureDistinguishing_of_base hM hG)

end TildeSubsets

/-! ### §2b Charts of `M̃` at BTZ points; `I⁺(x)` regular; one chart step (WP-46h fixer round 2)

Every chart of the developed atlas of `M̃` sends a BTZ point to `Δ₀`
(`BTZTildeData.chart_notMem_btzJReg_of_sing`, through the lifted chart of `IsLocallyBTZTilde` and
the transition being an isometry), so a chronological future is regular
(`BTZTildeData.Iplus_subset_reg`, B21: a BTZ point is in the chronological future of nothing);
`BTZTildeData.exists_chart_step` is one straight step inside a chart. -/

section TildeChartsAll

open Filter Topology

section ChartsBTZ

open Classical

variable {E : Type*} [TopologicalSpace E] {D : E → Causal.Minkowski 2}

/-- `exists_mem_btzTildeDevAtlas_of_descent` with the value of the chart at a point of `U`:
`κ (Ψ v) = j (Φ v)` for a `v ∈ V` with `Ψ v = e`. -/
theorem exists_mem_btzTildeDevAtlas_of_descent_val {F : Type*} (Φ : F ≃ DInfty × ℝ) {V : Set F}
    (hV : IsOpen[TopologicalSpace.induced Φ hornTop] V) {U : Set E} (hU : IsOpen U) {Ψ : F → E}
    (hbij : BijOn Ψ V U)
    (hn : ∀ v ∈ V, 𝓝 (Ψ v) = Filter.map Ψ (@nhds _ (TopologicalSpace.induced Φ hornTop) v))
    {g : Causal.Flat.isom 2} (hg : ∀ v ∈ V, D (Ψ v) = g • btzDevM 0 btzV0 (Φ v)) {e : E}
    (he : e ∈ U) :
    ∃ κ ∈ btzTildeDevAtlas D, e ∈ κ.source ∧ ∃ v ∈ V, Ψ v = e ∧
      κ e = btzJDev (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos (Φ v) := by
  obtain ⟨v₀, hv₀, -⟩ := hbij.surjOn he
  haveI : Nonempty F := ⟨v₀⟩
  set TF : TopologicalSpace F := TopologicalSpace.induced Φ hornTop
  set j : DInfty × ℝ → BTZJ0 := btzJDev (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos
  set js : BTZJ0 → DInfty × ℝ := ⇑(btzJDevEquiv (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos).symm
  have hj : Continuous[hornTop, btzJTop 0] j := continuous_btzJDev btzV0_pos
  have hjs : Continuous[btzJTop 0, hornTop] js := continuous_btzJDevEquiv_symm btzV0_pos
  have hjjs : ∀ q, j (js q) = q := fun q =>
    (btzJDevEquiv (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos).apply_symm_apply q
  have hjsj : ∀ y, js (j y) = y := fun y =>
    (btzJDevEquiv (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos).symm_apply_apply y
  have hΦ : Continuous[TF, hornTop] Φ := continuous_induced_dom
  have hΦs : Continuous[hornTop, TF] Φ.symm := continuous_induced_rng.2 (by
    have : (⇑Φ ∘ ⇑Φ.symm) = id := funext fun y => Φ.apply_symm_apply y
    rw [this]; exact @continuous_id _ hornTop)
  set inv : E → F := Function.invFunOn Ψ V
  have hinv : ∀ w ∈ U, inv w ∈ V ∧ Ψ (inv w) = w := fun w hw => by
    have h := hbij.surjOn hw
    exact ⟨Function.invFunOn_mem h, Function.invFunOn_eq h⟩
  have hinvΨ : ∀ v ∈ V, inv (Ψ v) = v := fun v hv => hbij.injOn.leftInvOn_invFunOn hv
  have hVo : IsOpen[hornTop] (Φ.symm ⁻¹' V) := by
    obtain ⟨O, hO, rfl⟩ := (@isOpen_induced_iff _ _ hornTop _ _).1 hV
    have : Φ.symm ⁻¹' (Φ ⁻¹' O) = O := by
      ext y; simp
    rw [this]; exact hO
  let κ : OpenPartialHomeomorph E BTZJ0 :=
    { toFun := fun w => j (Φ (inv w))
      invFun := fun q => Ψ (Φ.symm (js q))
      source := U
      target := js ⁻¹' (Φ.symm ⁻¹' V)
      map_source' := fun w hw => by
        show Φ.symm (js (j (Φ (inv w)))) ∈ V
        rw [hjsj, Φ.symm_apply_apply]; exact (hinv w hw).1
      map_target' := fun q hq => hbij.mapsTo hq
      left_inv' := fun w hw => by
        show Ψ (Φ.symm (js (j (Φ (inv w))))) = w
        rw [hjsj, Φ.symm_apply_apply]; exact (hinv w hw).2
      right_inv' := fun q hq => by
        show j (Φ (inv (Ψ (Φ.symm (js q))))) = q
        rw [hinvΨ _ hq, Φ.apply_symm_apply, hjjs]
      open_source := hU
      open_target := @IsOpen.preimage _ _ (btzJTop 0) hornTop _ hjs _ hVo
      continuousOn_toFun := fun w hw => by
        obtain ⟨v, hv, rfl⟩ := hbij.surjOn hw
        refine ContinuousAt.continuousWithinAt ?_
        show Tendsto (fun w => j (Φ (inv w))) (𝓝 (Ψ v)) (𝓝 (j (Φ (inv (Ψ v)))))
        rw [hinvΨ v hv, hn v hv, tendsto_map'_iff]
        have hc : Continuous[TF, btzJTop 0] (fun v => j (Φ v)) :=
          @Continuous.comp _ _ _ TF hornTop (btzJTop 0) _ _ hj hΦ
        refine (@Continuous.tendsto _ _ TF _ _ hc v).congr' ?_
        filter_upwards [@IsOpen.mem_nhds _ TF _ _ hV hv] with v' hv'
        simp only [comp_apply, hinvΨ v' hv']
      continuousOn_invFun := fun q hq => by
        refine ContinuousAt.continuousWithinAt ?_
        show Tendsto _ (𝓝 q) (𝓝 (Ψ (Φ.symm (js q))))
        rw [hn _ hq]
        have hc : Continuous[btzJTop 0, TF] (fun q => Φ.symm (js q)) :=
          @Continuous.comp _ _ _ (btzJTop 0) hornTop TF _ _ hΦs hjs
        exact (tendsto_map (f := Ψ)).comp (@Continuous.tendsto _ _ (btzJTop 0) TF _ hc q) }
  refine ⟨κ, ⟨g, fun w hw => ?_⟩, he, inv e, (hinv e he).1, (hinv e he).2, rfl⟩
  obtain ⟨hv, hw'⟩ := hinv w hw
  show D w = g • btzDevM 0 btzV0 (Φ (inv w))
  conv_lhs => rw [← hw']
  exact hg _ hv

end ChartsBTZ

/-- **`J⁺(Δ₀)` is not a neighbourhood of a point of `Δ₀`** (in `𝐌³`): below the line the null
coordinate `b` is negative. -/
theorem btzJplus_notMem_nhds_of_mem_btzLine {p : Causal.Minkowski 2}
    (hp : p ∈ btzLine (0 : ℝ × ℝ × ℝ)) : btzJplus (0 : ℝ × ℝ × ℝ) ∉ 𝓝 p := by
  intro hN
  obtain ⟨s, rfl⟩ := (mem_btzLine_iff (0 : ℝ × ℝ × ℝ)).1 hp
  set f : ℝ → Causal.Minkowski 2 := fun t =>
    nullToMink ((0 : ℝ × ℝ × ℝ) + (s • nullU + ((0 : ℝ), -t, (0 : ℝ)))) with hfdef
  have hfc : Continuous f := nullToMinkHomeomorph.continuous.comp (by fun_prop)
  have hf0 : f 0 = btzPt (0 : ℝ × ℝ × ℝ) s := by simp [hfdef, btzPt]
  have hN' : f ⁻¹' btzJplus (0 : ℝ × ℝ × ℝ) ∈ 𝓝 (0 : ℝ) :=
    hfc.continuousAt.preimage_mem_nhds (by rw [hf0]; exact hN)
  obtain ⟨δ, hδ, hball⟩ := Metric.mem_nhds_iff.1 hN'
  have ht : f (δ / 2) ∈ btzJplus (0 : ℝ × ℝ × ℝ) :=
    hball (by rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_of_pos (by linarith)]; linarith)
  rw [hfdef] at ht
  simp only at ht
  rw [btzJ_mem_jplus_coords] at ht
  rcases ht with h | ⟨s', hs'⟩
  · simp [nullU] at h; linarith
  · have := congrArg (fun z : ℝ × ℝ × ℝ => z.2.1) hs'
    simp [nullU] at this
    linarith


/-- **A chart of a developed atlas sends a point to `Δ₀` as soon as one chart does** (the
transition is an isometry; at a regular model point the image of a chart is a Euclidean
neighbourhood, and `J⁺(Δ₀)` is a neighbourhood of no point of `Δ₀`). -/
theorem btzTildeDev_notMem_reg_of_chart {N : Type*} [TopologicalSpace N]
    {D : N → Causal.Minkowski 2} {κ κ' : OpenPartialHomeomorph N BTZJ0}
    (hκ : κ ∈ btzTildeDevAtlas D) (hκ' : κ' ∈ btzTildeDevAtlas D) {w : N} (hw : w ∈ κ.source)
    (hw' : w ∈ κ'.source) (h' : κ' w ∉ btzJReg (0 : ℝ × ℝ × ℝ)) :
    κ w ∉ btzJReg (0 : ℝ × ℝ × ℝ) := by
  intro hreg
  obtain ⟨h, hh⟩ := btzTildeDevAtlas_transition hκ hκ'
  have hO : IsOpen (κ '' (κ.source ∩ κ'.source)) := κ.isOpen_image_source_inter κ'.open_source
  obtain ⟨ε, hε, hball⟩ := btzJ_exists_ball_of_reg hO ⟨w, ⟨hw, hw'⟩, rfl⟩ hreg
  have hhalf : (κ w).val ∈ btzJ0HalfSpace := by
    have := hreg; rw [btzJReg_eq_preimage] at this; exact this
  obtain ⟨ε', hε', hball'⟩ := Metric.isOpen_iff.1 isOpen_btzJ0HalfSpace _ hhalf
  have hsub : Metric.ball (κ w).val (min ε ε') ⊆
      (fun m : Causal.Minkowski 2 => h • m) ⁻¹' btzJplus (0 : ℝ × ℝ × ℝ) := by
    intro m hm
    have hm1 : m ∈ Metric.ball (κ w).val ε := Metric.ball_subset_ball (min_le_left _ _) hm
    have hm2 : m ∈ btzJplus (0 : ℝ × ℝ × ℝ) :=
      btzJ0HalfSpace_subset (hball' (Metric.ball_subset_ball (min_le_right _ _) hm))
    obtain ⟨p, hp, hpq⟩ := hball (BTZJplus.mk m hm2) hm1
    have h1 := hh p hp
    rw [hpq] at h1
    show h • m ∈ btzJplus (0 : ℝ × ℝ × ℝ)
    have h2 : (κ' p).val ∈ btzJplus (0 : ℝ × ℝ × ℝ) := (κ' p).2
    rw [h1] at h2
    exact h2
  have hN : (fun m : Causal.Minkowski 2 => h • m) ⁻¹' btzJplus (0 : ℝ × ℝ × ℝ) ∈
      𝓝 (κ w).val := Filter.mem_of_superset (Metric.ball_mem_nhds _ (lt_min hε hε')) hsub
  have hN' : btzJplus (0 : ℝ × ℝ × ℝ) ∈ 𝓝 (h • (κ w).val) := by
    have := (Causal.Flat.isom.toHomeomorph h).map_nhds_eq (κ w).val
    rw [Causal.Flat.isom.coe_toHomeomorph] at this
    rw [← this]
    exact hN
  have hline : (κ' w).val ∈ btzLine (0 : ℝ × ℝ × ℝ) := by
    by_contra hc; exact h' hc
  rw [← hh w ⟨hw, hw'⟩] at hN'
  exact btzJplus_notMem_nhds_of_mem_btzLine hline hN'


section TildeCharts

universe w

attribute [local instance] btzE0Structure

variable {M : Type w} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
  [FirstCountableTopology M] [ConnectedSpace M]
  [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) M]
  {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M)}
  {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
  {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ DInfty × ℝ}

omit [T2Space M] [LocPathConnectedSpace M] [FirstCountableTopology M] in
/-- **Every chart of `M̃` sends a BTZ point to `Δ₀`**: the lifted chart of `IsLocallyBTZTilde`
does (`D_{𝔼₀}` maps the axis `{r = 0}` to `Δ₀`), and any two charts agree on this
(`btzTildeDev_notMem_reg_of_chart`). -/
theorem BTZTildeData.chart_notMem_btzJReg_of_sing (d : BTZTildeData M y₀ Φ)
    {κ : OpenPartialHomeomorph d.Space BTZJ0} (hκ : κ ∈ btzTildeDevAtlas (N := d.Space) d.D)
    {w : d.Space} (hw : w ∈ κ.source)
    (hs : (d.toNat w).base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) :
    κ w ∉ btzJReg (0 : ℝ × ℝ × ℝ) := by
  obtain ⟨c, f, Ψ, -, -, -, hVoB, -, hUoT, hbij, -, hiff, -, hT'n, g, hg⟩ :=
    d.isLocallyBTZTilde (d.toNat w) hs
  have hwU : d.toNat w ∈ connectedComponentIn ((SpreadEnd.base : MaxBranchedCover
      (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀ → M) ⁻¹' (c.U : Set M)) (d.toNat w) :=
    mem_connectedComponentIn c.mem
  obtain ⟨κ', hκ', hw', v, hv, hΨv, hκ'w⟩ :=
    exists_mem_btzTildeDevAtlas_of_descent_val (E := d.Space) Φ.toEquiv hVoB hUoT hbij hT'n hg
      (e := w) hwU
  have hvs : v.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 := by
    rw [← hiff v hv, hΨv]; exact hs
  have key : ∀ (k : GammaA (2 * Real.pi)) (y : DInfty × ℝ), y.1 = DInfty.apex → k • y = y := by
    rintro k ⟨p, t⟩ hp
    simp only at hp
    subst hp
    rw [DInfty.smul_prod_def, DInfty.smul_def, DInfty.rot_apex]
  have hs' : orbitMk (GammaA (2 * Real.pi)) (Φ v) ∈
      orbitMk (GammaA (2 * Real.pi)) '' {x : DInfty × ℝ | x.1 = DInfty.apex} := by
    rw [← btz_sing btzV0_pos btz_two_pi_ne_zero isBTZStructure_btzE0, d.isPresentation v]
    exact hvs
  obtain ⟨x, hx, hxe⟩ := hs'
  obtain ⟨k, hk⟩ := exists_smul_eq_of_orbitMk_eq hxe
  have hax : (Φ v).1 = DInfty.apex := by rw [← hk, key k x hx]; exact hx
  have hκ'reg : κ' w ∉ btzJReg (0 : ℝ × ℝ × ℝ) := by
    rw [hκ'w]
    show btzJDev (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos (Φ.toEquiv v) ∉ btzJReg (0 : ℝ × ℝ × ℝ)
    rw [btzJDev_mem_btzJReg_iff]
    show ¬ 0 < (Φ v).1.r
    rw [hax, DInfty.apex_r]; exact lt_irrefl 0
  exact btzTildeDev_notMem_reg_of_chart hκ hκ' hw hw' hκ'reg

/-- **A chronological future in `M̃` is regular** (B21: a BTZ point is in the chronological future
of nothing): the last link of `x ≪ y` ends, in its chart, at a point of `I⁺` of the model, off
`Δ₀` (`btzJ_mem_reg_of_lt`), which no BTZ point is (`chart_notMem_btzJReg_of_sing`). -/
theorem BTZTildeData.Iplus_subset_reg (d : BTZTildeData M y₀ Φ) (x : d.Space) :
    d.causality.Iplus ⊤ {x} ⊆
      {e | e.base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M} := by
  intro y hy
  have hxy : d.causality.lt ⊤ x y := Causal.Precausality.mem_Iplus_singleton.1 hy
  have hlast : ∀ a b : d.Space, (∃ κ : btzTildeDevAtlas (N := d.Space) d.D,
      ((btzJCausality (0 : ℝ × ℝ × ℝ)).chartTransport κ.1).lt (⊤ ⊓ Causal.chartSource κ.1) a b) →
      (d.toNat b).base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M := by
    rintro a b ⟨⟨κ, hκ⟩, hl⟩
    obtain ⟨-, ⟨-, hb⟩, hc⟩ := btzTilde_link_lt_iff.1 hl
    have hreg : κ b ∈ btzJReg (0 : ℝ × ℝ × ℝ) := btzJ_mem_reg_of_lt hc.lt
    by_contra hns
    exact d.chart_notMem_btzJReg_of_sing hκ hb (by simpa [Sing] using hns) hreg
  show (d.toNat y).base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M
  cases hxy with
  | single hl => exact hlast _ _ hl
  | tail _ hl => exact hlast _ _ hl


/-- **One chart step into the chronological future**: for `D x ≪ m` there is `y` with
`x ≪ y` in `M̃` and `D y ≪ m` — the beginning of the straight segment from `κ x` to
`g⁻¹ m` in a chart `κ` at `x` (it is `T_BTZ`-continuous, so it starts inside `κ`'s target). -/
theorem BTZTildeData.exists_chart_step (d : BTZTildeData M y₀ Φ) (x : d.Space)
    {m : Causal.Minkowski 2} (hm : (Causal.minkowski 2).le ⊤ (d.D x) m) :
    ∃ y : d.Space, ∃ κ ∈ btzTildeDevAtlas (N := d.Space) d.D, x ∈ κ.source ∧ y ∈ κ.source ∧
      d.causality.le ⊤ x y ∧ (Causal.minkowski 2).le ⊤ (d.D y) m ∧
      ((Causal.minkowski 2).lt ⊤ (d.D x) m →
        d.causality.lt ⊤ x y ∧ (Causal.minkowski 2).lt ⊤ (d.D y) m) := by
  obtain ⟨κ, hκ, hx⟩ := d.isBTZTildeDev x
  obtain ⟨g, hg⟩ := hκ
  have hDx : d.D x = g • (κ x).val := hg x hx
  have h1 : (Causal.minkowski 2).le ⊤ (κ x).val (g⁻¹ • m) := by
    have := (Causal.Flat.isom_le_top_iff g⁻¹).2 hm
    rwa [hDx, inv_smul_smul] at this
  have hm' : g⁻¹ • m ∈ btzJplus (0 : ℝ × ℝ × ℝ) := by
    obtain ⟨p, hp, hpq⟩ := (κ x).mem
    exact ⟨p, hp, (Causal.minkowski 2).le_trans hpq h1⟩
  set q₁ : BTZJ0 := BTZJplus.mk (g⁻¹ • m) hm' with hq₁
  have hlink : btzJLe (κ x) q₁ := h1
  set c := btzJSeg hlink with hcdef
  have hcont := btzJ_continuousOn_seg hlink
  have hT : κ.target ∈ 𝓝 (c 0) := by
    rw [hcdef, btzJSeg_zero]; exact κ.open_target.mem_nhds (κ.map_source hx)
  have hev : c ⁻¹' κ.target ∈ 𝓝[Icc (0 : ℝ) 1] 0 := hcont 0 ⟨le_rfl, zero_le_one⟩ hT
  obtain ⟨δ, hδ, hball⟩ := Metric.mem_nhdsWithin_iff.1 hev
  set t : ℝ := min (δ / 2) (1 / 2) with htdef
  have ht0 : 0 < t := lt_min (by linarith) (by norm_num)
  have ht1 : t < 1 := lt_of_le_of_lt (min_le_right _ _) (by norm_num)
  have htδ : t < δ := lt_of_le_of_lt (min_le_left _ _) (by linarith)
  have hsmall : ∀ s ∈ Icc (0 : ℝ) 1, c (s * t) ∈ κ.target := fun s hs => by
    have hst : s * t ∈ Icc (0 : ℝ) 1 :=
      ⟨mul_nonneg hs.1 ht0.le, by nlinarith [hs.1, hs.2, ht0, ht1]⟩
    refine hball ⟨?_, hst⟩
    rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_of_nonneg hst.1]
    nlinarith [hs.1, hs.2, ht0, htδ]
  set q₂ := c t with hq₂
  have hq₂T : q₂ ∈ κ.target := by simpa using hsmall 1 ⟨zero_le_one, le_rfl⟩
  have hlink2 : btzJLe (κ x) q₂ := by
    show (Causal.minkowski 2).le ⊤ (κ x).val (btzJSegPt (κ x) q₁ t)
    have := btzJ_le_segPt hlink ht0.le
    rwa [btzJSegPt_zero] at this
  have hval2 : q₂.val = (κ x).val + t • ((g⁻¹ • m) - (κ x).val) := by
    show btzJSegPt (κ x) q₁ t = _
    rw [btzJSegPt_eq_of_mem ⟨ht0.le, ht1.le⟩]; rfl
  have hseg2 : ∀ s ∈ Icc (0 : ℝ) 1, btzJSeg hlink2 s = c (s * t) := fun s hs => by
    have hst : s * t ∈ Icc (0 : ℝ) 1 :=
      ⟨mul_nonneg hs.1 ht0.le, by nlinarith [hs.1, hs.2, ht0, ht1]⟩
    apply BTZJplus.ext
    show btzJSegPt (κ x) q₂ s = btzJSegPt (κ x) q₁ (s * t)
    rw [btzJSegPt_eq_of_mem hs, btzJSegPt_eq_of_mem hst, hval2, add_sub_cancel_left, smul_smul]
    rfl
  have hmem2 : ∀ s ∈ Icc (0 : ℝ) 1,
      btzJSeg hlink2 s ∈ Causal.chartImage κ (⊤ ⊓ Causal.chartSource κ) := fun s hs => by
    rw [hseg2 s hs]
    have hT' := hsmall s hs
    exact ⟨κ.symm (c (s * t)), ⟨κ.map_target hT', trivial, κ.map_target hT'⟩, κ.right_inv hT'⟩
  set y := κ.symm q₂ with hydef
  have hy : y ∈ κ.source := κ.map_target hq₂T
  have hκy : κ y = q₂ := κ.right_inv hq₂T
  have hDy : d.D y = g • q₂.val := by rw [hg y hy, hκy]
  have hκ : κ ∈ btzTildeDevAtlas (N := d.Space) d.D := ⟨g, hg⟩
  have hle : d.causality.le ⊤ x y := by
    refine btzTildeAtlasCausality_le_of_link (hA := d.isBTZTildeDev) hκ
      (btzTilde_link_le_iff.2 ⟨⟨trivial, hx⟩, ⟨trivial, hy⟩, ?_⟩)
    rw [hκy]
    exact ⟨0, 1, zero_le_one, btzJSeg hlink2, btzJ_curveOn_seg hlink2 hmem2, btzJSeg_zero hlink2,
      btzJSeg_one hlink2⟩
  have hq₂m : (Causal.minkowski 2).le ⊤ q₂.val (g⁻¹ • m) := by
    have := btzJ_le_segPt hlink ht1.le
    rw [btzJSegPt_one] at this
    exact this
  refine ⟨y, κ, hκ, hx, hy, hle, ?_, fun hlt => ?_⟩
  · rw [hDy, ← smul_inv_smul g m]
    exact (Causal.Flat.isom_le_top_iff g).2 hq₂m
  · -- the chronological case
    have hlinkL : btzJLt (κ x) q₁ := by
      show (Causal.minkowski 2).lt ⊤ (κ x).val (g⁻¹ • m)
      have := (Causal.Flat.isom_lt_top_iff g⁻¹).2 hlt
      rwa [hDx, inv_smul_smul] at this
    have hlink3 : btzJLt (κ x) q₂ := by
      show (Causal.minkowski 2).lt ⊤ (κ x).val (btzJSegPt (κ x) q₁ t)
      have := btzJ_lt_segPt hlinkL le_rfl ht0
      rwa [btzJSegPt_zero] at this
    have hq₂m' : (Causal.minkowski 2).lt ⊤ q₂.val (g⁻¹ • m) := by
      have := btzJ_lt_segPt hlinkL ht0.le ht1
      rw [btzJSegPt_one] at this
      exact this
    refine ⟨?_, ?_⟩
    · refine btzTildeAtlasCausality_lt_of_link (hA := d.isBTZTildeDev) hκ
        (btzTilde_link_lt_iff.2 ⟨⟨trivial, hx⟩, ⟨trivial, hy⟩, ?_⟩)
      rw [hκy]
      exact ⟨0, 1, zero_lt_one, btzJSeg hlink3.le, btzJ_curveOn_seg_lt hlink3 hmem2,
        btzJSeg_zero hlink3.le, btzJSeg_one hlink3.le⟩
    · rw [hDy, ← smul_inv_smul g m]
      exact (Causal.Flat.isom_lt_top_iff g).2 hq₂m'

end TildeCharts

/-! ### §4i The BTZ topology of `𝒟(M̃)` (`defi:BTZtop`, l.2281, l.2373; proof l.2390–2395)

WP-47g fixer round 1 (audit issue 1): `defi:BTZtop` on `𝒟(M̃)` near the rays, `GX.btzRangeTop`,
generated by the topology induced by `𝐌³` and the traces of `I⁺(p) ∪ ]p, +∞[`, `p ∈ ⋃ Δₓ`, is
PROVED equal to `devImageTop` (`GX.BTZTildeData.btzRangeTop_eq_devImageTop`), which is the
paper's own step « the image of such `D(I_{p,q})` together with the topology induced by `𝐌`
generates the BTZ topology on `D(M̃)` ». -/

section RangeTopSec

/-- **The developed BTZ ray of a point** `Δ_x := 𝒟(sing M̃) ∩ J⁺(𝒟 x) ∖ {𝒟 x}` (the headline's
`Δᵢ`, l.2369, indexed by the BTZ points of `M̃`). -/
def btzTildeDelta {N : Type*} (D : N → Causal.Minkowski 2) (S : Set N) (x : N) :
    Set (Causal.Minkowski 2) :=
  (D '' S ∩ (Causal.minkowski 2).Jplus ⊤ {D x}) \ {D x}

/-- `a ≤ b ≪ c ⇒ a ≪ c` in `𝐌³`. -/
theorem btzMink_lt_of_le_of_lt {a b c : Causal.Minkowski 2} (h1 : (Causal.minkowski 2).le ⊤ a b)
    (h2 : (Causal.minkowski 2).lt ⊤ b c) : (Causal.minkowski 2).lt ⊤ a c := by
  rw [Causal.Flat.le_top_iff_minkQ] at h1
  rw [Causal.Flat.lt_top_iff_minkQ] at h2 ⊢
  have := Causal.Flat.isFutureTimelike_add h2 h1
  rwa [sub_add_sub_cancel] at this

/-- A non-negative multiple of a future causal vector is future causal. -/
theorem btzMink_isFutureCausal_smul {u : Causal.Minkowski 2} (hu : Causal.Flat.IsFutureCausal u)
    {a : ℝ} (ha : 0 ≤ a) : Causal.Flat.IsFutureCausal (a • u) := by
  refine ⟨?_, ?_⟩
  · simp only [Prod.smul_fst, smul_eq_mul]; exact mul_nonneg ha hu.1
  · rw [Causal.Flat.minkQ_smul]; exact mul_nonpos_of_nonneg_of_nonpos (sq_nonneg a) hu.2

/-- A non-zero future causal vector has positive time component. -/
theorem btzMink_fst_pos {u : Causal.Minkowski 2} (hu : Causal.Flat.IsFutureCausal u) (h0 : u ≠ 0) :
    0 < u.1 :=
  lt_of_le_of_ne hu.1 fun h => h0 (Causal.Flat.eq_zero_of_fst_eq_zero h.symm hu.2)

theorem btzMink_le_add_smul {p u : Causal.Minkowski 2} (hu : Causal.Flat.IsFutureCausal u)
    {a : ℝ} (ha : 0 ≤ a) : (Causal.minkowski 2).le ⊤ p (p + a • u) := by
  rw [Causal.Flat.le_top_iff_minkQ, add_sub_cancel_left]
  exact btzMink_isFutureCausal_smul hu ha

theorem btzPt_sub (s s' : ℝ) :
    btzPt (0 : ℝ × ℝ × ℝ) s' - btzPt (0 : ℝ × ℝ × ℝ) s = (s' - s) • nullToMink nullU := by
  simp only [btzPt, zero_add, map_smul, sub_smul]

/-- An isometry applied to the points of `Δ₀`: affine in the parameter. -/
theorem isom_smul_btzPt (g : Causal.Flat.isom 2) (s s' : ℝ) :
    g • btzPt (0 : ℝ × ℝ × ℝ) s' = g • btzPt (0 : ℝ × ℝ × ℝ) s +
      (s' - s) • (g : Causal.Minkowski 2 ≃ᵃ[ℝ] Causal.Minkowski 2).linear (nullToMink nullU) := by
  rw [Causal.Flat.isom_smul_def, Causal.Flat.isom_smul_def, ← map_smul, ← btzPt_sub,
    ← Causal.Flat.isom_sub, add_sub_cancel]

/-- **A basic BTZ-neighbourhood of a point of `Δ₀`** (`defi:BTZtop` on `J⁺(Δ₀)`): every
neighbourhood of `q = p_t ∈ Δ₀` contains the trace of `A ∩ (I⁺(p_{t−η}) ∪ ]p_{t−η}, +∞[)` for an
`𝐌³`-open `A` containing the segment `p_{t+s}`, `|s| < η` (the axis diamonds of
`btz_axis_diamond`, transported by `btzJDevHomeomorph`). -/
theorem btzJ0_exists_basic_of_mem_nhds {q : BTZJ0} {t : ℝ}
    (hq : q.val = btzPt (0 : ℝ × ℝ × ℝ) t) {V : Set BTZJ0} (hV : V ∈ 𝓝 q) :
    ∃ η > 0, ∃ A : Set (Causal.Minkowski 2), IsOpen A ∧
      (∀ s : ℝ, -η < s → s < η → btzPt (0 : ℝ × ℝ × ℝ) (t + s) ∈ A) ∧
      ∀ q' : BTZJ0, q'.val ∈ A → q'.val ∈ btzJGenSet (btzPt (0 : ℝ × ℝ × ℝ) (t - η)) →
        q' ∈ V := by
  set j := btzJDev (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos with hj
  have hjq : j (DInfty.apex, t) = q := BTZJplus.ext (by
    rw [hj, btzJDev_val, btzDevM_apex, hq])
  have hc : Continuous[hornTop, btzJTop 0] j := continuous_btzJDev btzV0_pos
  have hcat : @ContinuousAt _ _ hornTop _ j (DInfty.apex, t) :=
    @Continuous.continuousAt _ _ hornTop _ _ _ hc
  have hN : j ⁻¹' V ∈ @nhds _ hornTop (DInfty.apex, t) :=
    hcat (by rw [hjq]; exact hV)
  obtain ⟨ε, hε, hεN⟩ := (hasBasis_nhds_hornTop_apex t).mem_iff.1 hN
  obtain ⟨η, hη, hdiam⟩ := btz_axis_diamond (x₀ := (0 : ℝ × ℝ × ℝ)) btzV0_pos t hε
  refine ⟨η, hη, (Causal.minkowski 2).Iminus ⊤ {btzTopVertex 0 t η},
    Causal.Causality.isOpen_Iminus (C := Causal.minkowski 2), fun s hs1 hs2 => ?_,
    fun q' h1 h2 => ?_⟩
  · rw [Causal.Precausality.mem_Iminus_singleton, btzPt, btzTopVertex, btzJ_lt_iff]
    simp only [nullU, Prod.fst_sub, Prod.smul_fst, smul_eq_mul, mul_one,
      Prod.snd_sub, Prod.smul_snd, mul_zero, zero_add]
    refine ⟨by linarith, by linarith, by nlinarith⟩
  · obtain ⟨y', rfl⟩ := btzJDev_surjective (x₀ := (0 : ℝ × ℝ × ℝ)) btzV0_pos q'
    rw [btzJDev_val, Causal.Precausality.mem_Iminus_singleton] at h1
    rw [btzJDev_val, btzDevM_mem_genSet_iff btzV0_pos] at h2
    exact hεN (hdiam y' ((Causal.minkowski 2).le_of_lt h1) h2.le)

/-- **The chart line and the developed BTZ ray agree, with orientation**: if a chart `κ`
(`D = g · val ∘ κ` on its source) sends `z` to `p_t ∈ Δ₀`, the points of its source near `z`
sent to `Δ₀` are in `S`, and every point of `S` causally after `z` develops onto `𝒟z + ℝ₊ u`,
then `g` sends `Δ₀` to that line, parameter to parameter, by a positive factor:
`g · p_{t+s} = 𝒟z + (s c) u`, `c > 0`. -/
theorem btzTilde_chart_align {N : Type*} [TopologicalSpace N] {D : N → Causal.Minkowski 2}
    {S U : Set N} (hU : IsOpen U) {κ : OpenPartialHomeomorph N BTZJ0}
    (hUS : ∀ w ∈ κ.source, w ∈ U → (κ w).val ∈ btzLine (0 : ℝ × ℝ × ℝ) → w ∈ S)
    {g : Causal.Flat.isom 2} (hg : ∀ w ∈ κ.source, D w = g • (κ w).val)
    {z : N} (hz : z ∈ κ.source) (hzU : z ∈ U) {t : ℝ} (hzt : (κ z).val = btzPt (0 : ℝ × ℝ × ℝ) t)
    {u : Causal.Minkowski 2}
    (hΔ : ∀ w ∈ S, (Causal.minkowski 2).le ⊤ (D z) (D w) → D w ≠ D z →
      ∃ lam : ℝ, 0 < lam ∧ D w = D z + lam • u) :
    ∃ c : ℝ, 0 < c ∧ ∀ s : ℝ, g • btzPt (0 : ℝ × ℝ × ℝ) (t + s) = D z + (s * c) • u := by
  have hDz : D z = g • btzPt (0 : ℝ × ℝ × ℝ) t := by rw [hg z hz, hzt]
  have hV : κ '' (κ.source ∩ U) ∈ 𝓝 (κ z) :=
    (κ.isOpen_image_source_inter hU).mem_nhds ⟨z, ⟨hz, hzU⟩, rfl⟩
  obtain ⟨η, hη, A, -, hA, hAV⟩ := btzJ0_exists_basic_of_mem_nhds hzt hV
  set p := btzPt (0 : ℝ × ℝ × ℝ) (t + η / 2) with hp
  have hpline : ∀ s, btzPt (0 : ℝ × ℝ × ℝ) s ∈ btzLine (0 : ℝ × ℝ × ℝ) := fun s =>
    (mem_btzLine_iff (0 : ℝ × ℝ × ℝ)).2 ⟨s, rfl⟩
  have hpgen : p ∈ btzJGenSet (btzPt (0 : ℝ × ℝ × ℝ) (t - η)) := by
    right; rw [btzRay_btzPt]; exact ⟨t + η / 2, by linarith, rfl⟩
  obtain ⟨w, ⟨hws, hwU⟩, hκw⟩ := hAV (BTZJplus.mk p (btzJGenSet_subset (hpline _) hpgen))
    (hA _ (by linarith) (by linarith)) hpgen
  have hκw' : (κ w).val = p := by rw [hκw]; rfl
  have hwS : w ∈ S := hUS w hws hwU (by rw [hκw']; exact hpline _)
  have hDw : D w = g • p := by rw [hg w hws, hκw']
  have hray : p ∈ btzLineRay (btzLine (0 : ℝ × ℝ × ℝ)) (btzPt (0 : ℝ × ℝ × ℝ) t) := by
    rw [btzLineRay_btzLine (hpline t), btzRay_btzPt]; exact ⟨t + η / 2, by linarith, rfl⟩
  have hle : (Causal.minkowski 2).le ⊤ (D z) (D w) := by
    rw [hDz, hDw]; exact (Causal.Flat.isom_le_top_iff g).2 hray.2.1
  have hne : D w ≠ D z := by
    rw [hDz, hDw]; exact fun h => hray.2.2 (smul_left_cancel g h)
  obtain ⟨lam, hlam, hlw⟩ := hΔ w hwS hle hne
  set L := (g : Causal.Minkowski 2 ≃ᵃ[ℝ] Causal.Minkowski 2).linear (nullToMink nullU) with hL
  have hpL : g • p = D z + (η / 2) • L := by
    rw [hp, isom_smul_btzPt g t, hDz]; congr 2; ring
  have hLu : L = (2 * lam / η) • u := by
    have h1 : (η / 2) • L = lam • u := by
      have := hlw.symm.trans (hDw.trans hpL)
      exact (add_left_cancel this).symm
    have h2 : L = (2 / η) • ((η / 2) • L) := by
      rw [smul_smul, show 2 / η * (η / 2) = 1 by field_simp, one_smul]
    rw [h2, h1, smul_smul]; congr 1; ring
  refine ⟨2 * lam / η, by positivity, fun s => ?_⟩
  rw [isom_smul_btzPt g t, ← hDz, ← hL, hLu, smul_smul, add_sub_cancel_left]

section RangeTop

universe w

attribute [local instance] btzE0Structure

variable {M : Type w} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
  [FirstCountableTopology M] [ConnectedSpace M]
  [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) M]
  {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M)}
  {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
  {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ DInfty × ℝ}

omit [T2Space M] [LocPathConnectedSpace M] [FirstCountableTopology M] in
/-- **Near a BTZ point, a chart sends to `Δ₀` only BTZ points**: inside the lifted chart of
`IsLocallyBTZTilde` at a BTZ point `y`, a regular point is sent off `Δ₀` by the lifted chart
(`D_{𝔼₀}` sends `{r > 0}` off the axis), hence by every chart (`btzTildeDev_notMem_reg_of_chart`). -/
theorem BTZTildeData.exists_nhds_sing_of_mem_btzLine (d : BTZTildeData M y₀ Φ) (y : d.Space)
    (hy : (d.toNat y).base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) :
    ∃ U : Set d.Space, IsOpen U ∧ y ∈ U ∧ ∀ κ ∈ btzTildeDevAtlas (N := d.Space) d.D,
      ∀ w ∈ κ.source, w ∈ U → (κ w).val ∈ btzLine (0 : ℝ × ℝ × ℝ) →
        (d.toNat w).base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M := by
  obtain ⟨c, f, Ψ, -, -, -, hVoB, -, hUoT, hbij, -, hiff, -, hT'n, g, hg⟩ :=
    d.isLocallyBTZTilde (d.toNat y) hy
  have hyU : d.toNat y ∈ connectedComponentIn ((SpreadEnd.base : MaxBranchedCover
      (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀ → M) ⁻¹' (c.U : Set M)) (d.toNat y) :=
    mem_connectedComponentIn c.mem
  refine ⟨_, hUoT, hyU, ?_⟩
  intro κ hκ w hw hwU hline
  by_contra hns
  obtain ⟨κ', hκ', hw', v, hv, hΨv, hκ'w⟩ :=
    exists_mem_btzTildeDevAtlas_of_descent_val (E := d.Space) Φ.toEquiv hVoB hUoT hbij hT'n hg
      (e := w) hwU
  have hvr : v.base ∉ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 := by
    rw [← hiff v hv, hΨv]; exact hns
  have hr : 0 < (Φ v).1.r := by
    rcases (Φ v).1.pos_or_eq_apex with h | h
    · exact h
    · exfalso
      apply hvr
      have hs' : orbitMk (GammaA (2 * Real.pi)) (Φ v) ∈
          orbitMk (GammaA (2 * Real.pi)) '' {x : DInfty × ℝ | x.1 = DInfty.apex} := ⟨Φ v, h, rfl⟩
      rwa [← btz_sing btzV0_pos btz_two_pi_ne_zero isBTZStructure_btzE0, d.isPresentation v] at hs'
  have hreg' : κ' w ∈ btzJReg (0 : ℝ × ℝ × ℝ) := by
    rw [hκ'w]
    exact (btzJDev_mem_btzJReg_iff btzV0_pos (Φ.toEquiv v)).2 hr
  exact btzTildeDev_notMem_reg_of_chart hκ' hκ hw' hw (fun h => h hline) hreg'

/-- **`defi:BTZtop` on `𝒟(M̃)`, in the neighbourhood of the rays** (`RamcovGX.tex:2281`, l.2373):
the topology of `D(N) ⊆ 𝐌³` generated by the one induced by `𝐌³` and the traces of the sets
`I⁺(p) ∪ ]p, +∞[` for `p = D x`, `x ∈ S`, the half-ray being `Δₓ = D(S) ∩ J⁺(D x) ∖ {D x}`
(`btzTildeDelta`; on `M̃`, `Δₓ = {D x + λu : λ > 0}`, the relatively open future half-ray from
`D x` of the lightlike line carrying `D(S)` there). -/
@[reducible] def btzRangeTop {N : Type*} (D : N → Causal.Minkowski 2) (S : Set N) :
    TopologicalSpace (range D) :=
  TopologicalSpace.induced Subtype.val inferInstance ⊓
    TopologicalSpace.generateFrom {s | ∃ x ∈ S, s = Subtype.val ⁻¹'
      ((Causal.minkowski 2).Iplus ⊤ {D x} ∪ btzTildeDelta D S x)}

/-- **The BTZ topology of `𝒟(M̃)` is the image of `T_BTZ`** (`RamcovGX.tex:2390–2395`: « the image
of such `D(I_{p,q})` together with the topology induced by `𝐌` generates the BTZ topology on
`D(M̃)` »): for `D` injective on `M̃` and the developed BTZ points above each BTZ point a future
null half-line, `defi:BTZtop` on `𝒟(M̃)` (`btzRangeTop`, generated by `𝐌³`'s topology and the
sets `I⁺(p) ∪ ]p, +∞[`, `p ∈ ⋃ Δₓ`) is `devImageTop` (generated by `𝐌³`'s topology and the
`𝒟`-images of `T_BTZ`-open sets). Proof: at a regular point `𝒟` is a local homeomorphism; at a BTZ
point `y`, in a chart `κ` (`𝒟 = g · val ∘ κ`) the BTZ topology of `J⁺(Δ₀)` has the basic
neighbourhoods `A ∩ (I⁺(p_{t−η}) ∪ ]p_{t−η}, +∞[)` (`btzJ0_exists_basic_of_mem_nhds`), and `g`
sends `Δ₀` onto the developed half-line with its orientation (`btzTilde_chart_align`). -/
theorem BTZTildeData.btzRangeTop_eq_devImageTop (d : BTZTildeData M y₀ Φ) (hinj : Injective d.D)
    (hray : ∀ x ∈ {e : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀ |
        e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
      ∃ u : Causal.Minkowski 2, Causal.Flat.IsFutureCausal u ∧ Causal.Flat.minkQ u = 0 ∧ u ≠ 0 ∧
        btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} x =
          {m | ∃ lam : ℝ, 0 < lam ∧ m = d.D x + lam • u}) :
    btzRangeTop d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} =
      @devImageTop _ (Causal.Minkowski 2) d.T'.top _ d.D := by
  set S : Set (MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀) :=
    {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} with hSdef
  have hpline : ∀ s, btzPt (0 : ℝ × ℝ × ℝ) s ∈ btzLine (0 : ℝ × ℝ × ℝ) := fun s =>
    (mem_btzLine_iff (0 : ℝ × ℝ × ℝ)).2 ⟨s, rfl⟩
  have hS_of : ∀ y : d.Space, d.D y ∈ d.D '' S → y ∈ S := by
    rintro y ⟨s, hs, hsy⟩; rwa [← hinj hsy]
  -- a chart at a BTZ point, and the neighbourhood where it sends only BTZ points to `Δ₀`
  have hchart : ∀ y : d.Space, y ∈ S → ∃ κ : OpenPartialHomeomorph d.Space BTZJ0,
      ∃ g : Causal.Flat.isom 2, (∀ w ∈ κ.source, d.D w = g • (κ w).val) ∧ y ∈ κ.source ∧
      ∃ t : ℝ, (κ y).val = btzPt (0 : ℝ × ℝ × ℝ) t ∧ ∃ U : Set d.Space, IsOpen U ∧ y ∈ U ∧
        ∀ w ∈ κ.source, w ∈ U → (κ w).val ∈ btzLine (0 : ℝ × ℝ × ℝ) → w ∈ S := by
    intro y hy
    obtain ⟨κ, hκ, hyκ⟩ := d.isBTZTildeDev y
    obtain ⟨g, hg⟩ := id hκ
    have hline : (κ y).val ∈ btzLine (0 : ℝ × ℝ × ℝ) :=
      not_not.1 (d.chart_notMem_btzJReg_of_sing hκ hyκ hy)
    obtain ⟨t, ht⟩ := (mem_btzLine_iff (0 : ℝ × ℝ × ℝ)).1 hline
    obtain ⟨U, hU, hyU, hUS⟩ := d.exists_nhds_sing_of_mem_btzLine y hy
    exact ⟨κ, g, hg, hyκ, t, ht, U, hU, hyU, fun w hw hwU hl => hUS κ hκ w hw hwU hl⟩
  apply le_antisymm
  · -- the `𝒟`-image of a `T_BTZ`-open set is open for `defi:BTZtop`
    refine le_inf inf_le_left ?_
    rw [TopologicalSpace.le_generateFrom_iff_subset_isOpen]
    rintro _ ⟨O, hO, rfl⟩
    show IsOpen[btzRangeTop d.D S] (rangeFactorization d.D '' O)
    rw [@isOpen_iff_forall_mem_open _ (btzRangeTop d.D S)]
    rintro _ ⟨y, hyO, rfl⟩
    by_cases hyS : y ∈ S
    · obtain ⟨κ, g, hg, hyκ, t, ht, U, hU, hyU, hUS⟩ := hchart y hyS
      have hO' : @IsOpen d.Space _ O := hO
      have hV : κ '' (κ.source ∩ (U ∩ O)) ∈ 𝓝 (κ y) :=
        (κ.isOpen_image_source_inter (hU.inter hO')).mem_nhds ⟨y, ⟨hyκ, hyU, hyO⟩, rfl⟩
      obtain ⟨η, hη, A, hAo, hA, hAV⟩ := btzJ0_exists_basic_of_mem_nhds ht hV
      set b := btzPt (0 : ℝ × ℝ × ℝ) (t + -(η / 2)) with hb
      have hbgen : b ∈ btzJGenSet (btzPt (0 : ℝ × ℝ × ℝ) (t - η)) := by
        right; rw [btzRay_btzPt]; exact ⟨_, by linarith, rfl⟩
      obtain ⟨z, ⟨hzκ, hzU, hzO⟩, hκz⟩ := hAV (BTZJplus.mk b (btzJGenSet_subset (hpline _) hbgen))
        (hA _ (by linarith) (by linarith)) hbgen
      have hκz' : (κ z).val = b := by rw [hκz]; rfl
      have hzS : z ∈ S := hUS z hzκ hzU (by rw [hκz']; exact hpline _)
      obtain ⟨u, -, -, -, hΔz⟩ := hray z hzS
      obtain ⟨c, hc, halign⟩ := btzTilde_chart_align hU hUS hg hzκ hzU hκz' (u := u)
        (fun w hwS hle hne => by
          have h : d.D w ∈ btzTildeDelta d.D S z :=
            ⟨⟨⟨w, hwS, rfl⟩, Causal.Precausality.mem_Jplus_singleton.2 hle⟩, hne⟩
          rw [hΔz] at h; exact h)
      have hDz : d.D z = g • b := by rw [hg z hzκ, hκz']
      have hDy : d.D y = d.D z + ((η / 2) * c) • u := by
        rw [hg y hyκ, ht, ← halign]; congr 2; ring
      refine ⟨Subtype.val ⁻¹' ((Causal.minkowski 2).Iplus ⊤ {d.D z} ∪ btzTildeDelta d.D S z) ∩
        Subtype.val ⁻¹' ((fun m => g⁻¹ • m) ⁻¹' A), ?_, ?_, ?_⟩
      · rintro ⟨m, hm⟩ ⟨hm1, hm2⟩
        simp only [mem_preimage] at hm1 hm2
        have hmg : m = g • (g⁻¹ • m) := (smul_inv_smul g m).symm
        have hgen : g⁻¹ • m ∈ btzJGenSet (btzPt (0 : ℝ × ℝ × ℝ) (t - η)) := by
          rcases hm1 with hI | hΔ
          · left
            rw [Causal.Precausality.mem_Iplus_singleton] at hI ⊢
            rw [hDz, hmg] at hI
            have h1 := (Causal.Flat.isom_lt_top_iff g).1 hI
            have hbray : b ∈ btzLineRay (btzLine (0 : ℝ × ℝ × ℝ)) (btzPt (0 : ℝ × ℝ × ℝ) (t - η)) := by
              rw [btzLineRay_btzLine (hpline _), btzRay_btzPt]; exact ⟨_, by linarith, rfl⟩
            exact btzMink_lt_of_le_of_lt hbray.2.1 h1
          · right
            rw [hΔz] at hΔ
            obtain ⟨lam, hlam, rfl⟩ := hΔ
            have hm' : d.D z + lam • u = g • btzPt (0 : ℝ × ℝ × ℝ) (t + -(η / 2) + lam / c) := by
              rw [halign]; congr 2; field_simp
            rw [hm', inv_smul_smul, btzRay_btzPt]
            exact ⟨_, by have : 0 < lam / c := by positivity
                         linarith, rfl⟩
        obtain ⟨w, ⟨hwκ, -, hwO⟩, hκw⟩ := hAV (BTZJplus.mk _ (btzJGenSet_subset (hpline _) hgen))
          hm2 hgen
        refine ⟨w, hwO, Subtype.ext ?_⟩
        show d.D w = m
        rw [hg w hwκ, hκw]
        exact (smul_inv_smul g m)
      · have hgc : Continuous (fun m : Causal.Minkowski 2 => g⁻¹ • m) := by
          have := (Causal.Flat.isom.toHomeomorph g⁻¹).continuous
          rwa [Causal.Flat.isom.coe_toHomeomorph] at this
        exact @IsOpen.inter _ (btzRangeTop d.D S) _ _
          ((TopologicalSpace.le_def.1 (inf_le_right : btzRangeTop d.D S ≤ _)) _
            (TopologicalSpace.isOpen_generateFrom_of_mem ⟨z, hzS, rfl⟩))
          ((TopologicalSpace.le_def.1 (inf_le_left : btzRangeTop d.D S ≤ _)) _
            ⟨_, hAo.preimage hgc, rfl⟩)
      · refine ⟨Or.inr ?_, ?_⟩
        · show d.D y ∈ btzTildeDelta d.D S z
          rw [hΔz]; exact ⟨(η / 2) * c, by positivity, hDy⟩
        · show g⁻¹ • d.D y ∈ A
          rw [hg y hyκ, ht, inv_smul_smul]
          simpa using hA 0 (by linarith) hη
    · -- a regular point: `𝒟` is a local homeomorphism there
      have hyR : (d.toNat y).base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M := by
        by_contra h; exact hyS h
      have hloc := IsRegularOn.isLocalHomeomorphOn d.isRegDeveloping
      have hmap := hloc.map_nhds_eq (x := y) hyR
      have hOn : O ∈ @nhds _ (weakTopMax (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀) y := by
        rw [← d.nhds_reg y hyR]; exact @IsOpen.mem_nhds _ d.T'.top _ _ hO hyO
      have hD : d.D '' O ∈ 𝓝 (d.D y) := by rw [← hmap]; exact image_mem_map hOn
      obtain ⟨A, hAsub, hAo, hyA⟩ := mem_nhds_iff.1 hD
      refine ⟨Subtype.val ⁻¹' A, ?_, ?_, hyA⟩
      · rintro ⟨m, hm⟩ hmA
        obtain ⟨o, ho, rfl⟩ := hAsub hmA
        exact ⟨o, ho, rfl⟩
      · exact (TopologicalSpace.le_def.1 (inf_le_left : btzRangeTop d.D S ≤ _)) _ ⟨A, hAo, rfl⟩
  · -- the generators `I⁺(p) ∪ ]p, +∞[` are `𝒟`-images of `T_BTZ`-open sets
    refine le_inf inf_le_left ?_
    rw [TopologicalSpace.le_generateFrom_iff_subset_isOpen]
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨u, hu1, -, hu3, hΔx⟩ := hray x hx
    have hu0 : 0 < u.1 := btzMink_fst_pos hu1 hu3
    have hUx : IsOpen[d.T'.top]
        (d.D ⁻¹' ((Causal.minkowski 2).Iplus ⊤ {d.D x} ∪ btzTildeDelta d.D S x)) := by
      rw [@isOpen_iff_forall_mem_open _ d.T'.top]
      intro y hy
      rcases hy with hI | hΔ
      · exact ⟨d.D ⁻¹' (Causal.minkowski 2).Iplus ⊤ {d.D x}, fun w hw => Or.inl hw,
          d.continuous_dev.isOpen_preimage _ (Causal.Causality.isOpen_Iplus (C := Causal.minkowski 2)), hI⟩
      · have hyS : y ∈ S := hS_of y hΔ.1.1
        have hΔ' := hΔ
        rw [hΔx] at hΔ'
        obtain ⟨lam0, hlam0, hDy⟩ := hΔ'
        obtain ⟨κ, g, hg, hyκ, t, ht, U, hU, hyU, hUS⟩ := hchart y hyS
        have hxy : (Causal.minkowski 2).le ⊤ (d.D x) (d.D y) := by
          rw [hDy]; exact btzMink_le_add_smul hu1 hlam0.le
        have hΔy : ∀ w ∈ S, (Causal.minkowski 2).le ⊤ (d.D y) (d.D w) → d.D w ≠ d.D y →
            ∃ lam : ℝ, 0 < lam ∧ d.D w = d.D y + lam • u := by
          intro w hwS hle hne
          have hxw : (Causal.minkowski 2).le ⊤ (d.D x) (d.D w) :=
            (Causal.minkowski 2).le_trans hxy hle
          have hwx : d.D w ≠ d.D x := by
            intro h
            rw [h] at hle
            have h2 : d.D x = d.D y := Causal.minkowski_isCausal hxy hle
            have h3 : lam0 • u = 0 := by
              have := congrArg (fun m => m - d.D x) (hDy.symm.trans h2.symm)
              simpa using this
            exact smul_ne_zero hlam0.ne' hu3 h3
          have hwΔ : d.D w ∈ btzTildeDelta d.D S x :=
            ⟨⟨⟨w, hwS, rfl⟩, Causal.Precausality.mem_Jplus_singleton.2 hxw⟩, hwx⟩
          rw [hΔx] at hwΔ
          obtain ⟨mu, -, hDw⟩ := hwΔ
          have hdiff : d.D w - d.D y = (mu - lam0) • u := by
            rw [hDw, hDy, sub_smul]; abel
          have h1 := (Causal.Flat.le_top_iff_minkQ.1 hle).1
          rw [hdiff] at h1
          simp only [Prod.smul_fst, smul_eq_mul] at h1
          have hge : 0 ≤ mu - lam0 := nonneg_of_mul_nonneg_left h1 hu0
          refine ⟨mu - lam0, lt_of_le_of_ne hge fun h => hne ?_, ?_⟩
          · rw [← sub_eq_zero, hdiff, ← h, zero_smul]
          · rw [← hdiff, add_sub_cancel]
        obtain ⟨c, hc, halign⟩ := btzTilde_chart_align hU hUS hg hyκ hyU ht hΔy
        set η := lam0 / (2 * c) with hηdef
        have hη : 0 < η := by positivity
        have hηc : η * c = lam0 / 2 := by rw [hηdef]; field_simp
        refine ⟨κ.source ∩ κ ⁻¹' (BTZJplus.val ⁻¹' btzJGenSet (btzPt (0 : ℝ × ℝ × ℝ) (t - η))),
          ?_, κ.isOpen_inter_preimage (isOpen_btzJ_gen (hpline _)), hyκ, ?_⟩
        · rintro w ⟨hwκ, hwgen⟩
          simp only [mem_preimage] at hwgen ⊢
          have hDw : d.D w = g • (κ w).val := hg w hwκ
          rcases hwgen with hI | hR
          · left
            rw [Causal.Precausality.mem_Iplus_singleton] at hI ⊢
            have h1 := (Causal.Flat.isom_lt_top_iff g).2 hI
            have h2 : g • btzPt (0 : ℝ × ℝ × ℝ) (t - η) = d.D x + (lam0 / 2) • u := by
              rw [show t - η = t + -η by ring, halign, hDy, add_assoc, ← add_smul]
              congr 2; linarith
            rw [← hDw, h2] at h1
            exact btzMink_lt_of_le_of_lt (btzMink_le_add_smul hu1 (by positivity)) h1
          · right
            rw [btzRay_btzPt] at hR
            obtain ⟨s', hs', hs'eq⟩ := hR
            rw [hΔx]
            refine ⟨lam0 + (s' - t) * c, ?_, ?_⟩
            · nlinarith
            · have h := halign (s' - t)
              rw [show t + (s' - t) = s' by ring] at h
              rw [hDw, hs'eq, h, hDy, add_assoc, ← add_smul]
        · show (κ y).val ∈ btzJGenSet (btzPt (0 : ℝ × ℝ × ℝ) (t - η))
          right; rw [ht, btzRay_btzPt]; exact ⟨t, by linarith, rfl⟩
    have heq : (Subtype.val ⁻¹' ((Causal.minkowski 2).Iplus ⊤ {d.D x} ∪ btzTildeDelta d.D S x) :
        Set (range d.D)) = rangeFactorization d.D ''
          (d.D ⁻¹' ((Causal.minkowski 2).Iplus ⊤ {d.D x} ∪ btzTildeDelta d.D S x)) := by
      ext ⟨m, e, rfl⟩
      constructor
      · intro h; exact ⟨e, h, rfl⟩
      · rintro ⟨e', he', h'⟩
        have : d.D e' = d.D e := congrArg Subtype.val h'
        have h2 : d.D e ∈ (Causal.minkowski 2).Iplus ⊤ {d.D x} ∪ btzTildeDelta d.D S x :=
          this ▸ he'
        exact h2
    show IsOpen[@devImageTop _ (Causal.Minkowski 2) d.T'.top _ d.D] _
    rw [heq]
    exact (TopologicalSpace.le_def.1
      (inf_le_right : @devImageTop _ (Causal.Minkowski 2) d.T'.top _ d.D ≤ _)) _
      (TopologicalSpace.GenerateOpen.basic _ ⟨_, hUx, rfl⟩)

end RangeTop

end RangeTopSec

end TildeChartsAll

/-! ## §4 The `𝔼₀` case: `Reg M` of a GH Cauchy-compact Cauchy-maximal `𝔼₀`-manifold -/

section E0

open E0CBG E0Spear E0AbsMax
open scoped Causal.Flat

variable {M : Type} [TopologicalSpace M] [T2Space M] [ConnectedSpace M] [SecondCountableTopology M]
  [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid]

omit [SecondCountableTopology M] in
/-- **The uniformization of `Reg M`** (gx l.2377–2381 and l.2400–2403 on the regular part, in
DEC-28's Cauchy-compact form): for `M` a globally hyperbolic, Cauchy-compact, Cauchy-maximal
`𝔼₀`-manifold whose `π₁(Reg M)` is not metabelian, and **every** developing pair `(𝒟, ρ)` of
`Reg M`: a loxodromic element in `ρ(π₁)` (DEC-75); `𝒟` injective; `ρ` faithful, discrete,
torsion-free; the lightlike planes `Π_w` (`w ∈ Λ = Λ(ρ(π₁))`) a `ρ(π₁)`-invariant family; and, in
the future case, `𝒟(Reg M̃) = Ω⁺(Λ) = ⋂_w I⁺(Π_w)` (**equality**, Barbot §11.3 from B21 Cor 2.18),
`ρ(π₁)` free and properly discontinuous on it, `Reg M̃` future complete, and `𝒟` induces
`Reg M ≅ ρ(π₁)\Ω⁺(Λ)` — or the time-reversed statement. The case selection is
`btz_uniformization`'s. -/
theorem btz_uniformization_reg_of_regM
    (hRM : Causal.Flat.GH (e0RegMFlat M) ∧ Causal.Flat.IsCauchyComplete 2 (e0RegMFlat M) ∧
      Causal.Flat.AbsMax (fun _ => True) (e0RegMFlat M)) (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    (∃ γ ∈ ρ.range, Causal.Flat.IsLoxodromic (Causal.Flat.linOf γ)) ∧ Injective D ∧
      Injective ρ ∧ DiscreteTopology ρ.range ∧ Causal.Flat.IsTorsionFreeSubgroup ρ.range ∧
      (∀ γ ∈ ρ.range, ∀ w ∈ Causal.Flat.limitSetJ ρ.range,
        Causal.Flat.isomPenrose γ w ∈ Causal.Flat.limitSetJ ρ.range ∧
          (fun p => γ • p) '' nullPlane w = nullPlane (Causal.Flat.isomPenrose γ w)) ∧
      ((Causal.Flat.FutureRegular (Causal.Flat.limitSetJ ρ.range) ∧
          range D = Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
          Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) =
            ⋂ w ∈ Causal.Flat.limitSetJ ρ.range, (Causal.minkowski 2).Iplus ⊤ (nullPlane w) ∧
          Causal.Flat.ActsFreelyProperlyOn ρ.range
            (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range)) ∧
          (letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
           haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
           IsFutureComplete
            (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) ∧
          ∃ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B),
            IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry 2 π ∧ Surjective π ∧
            (∀ p q : Causal.Flat.limitOpensPlus ρ.range,
              π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski 2) = q) ∧
            Causal.Flat.GH B ∧
            ∃ f : e0RegMFlat M ≃ₜ B, Causal.Flat.IsLocalIsometry 2 f ∧
              ∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
                f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩) ∨
        (Causal.Flat.PastRegular (Causal.Flat.limitSetJ ρ.range) ∧
          range D = Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range) ∧
          Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range) =
            ⋂ w ∈ Causal.Flat.limitSetJ ρ.range, (Causal.minkowski 2).Iminus ⊤ (nullPlane w) ∧
          Causal.Flat.ActsFreelyProperlyOn ρ.range
            (Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range)) ∧
          ∃ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensMinus ρ.range → B),
            IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry 2 π ∧ Surjective π ∧
            (∀ p q : Causal.Flat.limitOpensMinus ρ.range,
              π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski 2) = q) ∧
            Causal.Flat.GH B ∧
            ∃ f : e0RegMFlat M ≃ₜ B, Causal.Flat.IsLocalIsometry 2 f ∧
              ∀ z (hz : D z ∈ Causal.Flat.limitOpensMinus ρ.range),
                f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩)) := by
  obtain ⟨hGH', hCC', hAM⟩ := hRM
  obtain ⟨hlox, hD, hρ, hdisc, htf, hinv, -⟩ := e0RegM_holonomy M hGH' hCC' x₀ hnm D ρ hpair
  obtain ⟨S, hS⟩ := Causal.Flat.exists_developsCC_of_isCauchyComplete' (e0RegMFlat M) hGH' hCC' hpair
  obtain ⟨-, hcase⟩ := uniformization_of_absMax (e0RegMFlat M) hpair hGH'.1 hS hlox hAM
  refine ⟨hlox, hD, hρ, hdisc, htf, hinv, ?_⟩
  rcases hcase with ⟨hF, hr, hfp, hB⟩ | ⟨hP, hr, hfp, hB⟩
  · exact Or.inl ⟨hF, hr, omegaPlus_eq_iInter_Iplus _, hfp,
      isFutureComplete_of_range_eq_omegaPlus (e0RegMFlat M) hpair hD hr, hB⟩
  · exact Or.inr ⟨hP, hr, omegaMinus_eq_iInter_Iminus _, hfp, hB⟩

/-- `btz_uniformization_reg_of_regM` fed by `E0AbsMax.cor_abs_max_C1` (DEC-107/117: « Cauchy-compact »
is a compact `C¹` spacelike Cauchy surface; the topological route through `cor_abs_max_e0` and its
smoothing step (G0) is deleted, DEC-117). -/
theorem btz_uniformization_reg (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S)
    (hmax : IsE0CauchyMaximal M) (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    (∃ γ ∈ ρ.range, Causal.Flat.IsLoxodromic (Causal.Flat.linOf γ)) ∧ Injective D ∧
      Injective ρ ∧ DiscreteTopology ρ.range ∧ Causal.Flat.IsTorsionFreeSubgroup ρ.range ∧
      (∀ γ ∈ ρ.range, ∀ w ∈ Causal.Flat.limitSetJ ρ.range,
        Causal.Flat.isomPenrose γ w ∈ Causal.Flat.limitSetJ ρ.range ∧
          (fun p => γ • p) '' nullPlane w = nullPlane (Causal.Flat.isomPenrose γ w)) ∧
      ((Causal.Flat.FutureRegular (Causal.Flat.limitSetJ ρ.range) ∧
          range D = Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
          Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) =
            ⋂ w ∈ Causal.Flat.limitSetJ ρ.range, (Causal.minkowski 2).Iplus ⊤ (nullPlane w) ∧
          Causal.Flat.ActsFreelyProperlyOn ρ.range
            (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range)) ∧
          (letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
           haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
           IsFutureComplete
            (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) ∧
          ∃ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B),
            IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry 2 π ∧ Surjective π ∧
            (∀ p q : Causal.Flat.limitOpensPlus ρ.range,
              π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski 2) = q) ∧
            Causal.Flat.GH B ∧
            ∃ f : e0RegMFlat M ≃ₜ B, Causal.Flat.IsLocalIsometry 2 f ∧
              ∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
                f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩) ∨
        (Causal.Flat.PastRegular (Causal.Flat.limitSetJ ρ.range) ∧
          range D = Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range) ∧
          Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range) =
            ⋂ w ∈ Causal.Flat.limitSetJ ρ.range, (Causal.minkowski 2).Iminus ⊤ (nullPlane w) ∧
          Causal.Flat.ActsFreelyProperlyOn ρ.range
            (Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range)) ∧
          ∃ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensMinus ρ.range → B),
            IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry 2 π ∧ Surjective π ∧
            (∀ p q : Causal.Flat.limitOpensMinus ρ.range,
              π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski 2) = q) ∧
            Causal.Flat.GH B ∧
            ∃ f : e0RegMFlat M ≃ₜ B, Causal.Flat.IsLocalIsometry 2 f ∧
              ∀ z (hz : D z ∈ Causal.Flat.limitOpensMinus ρ.range),
                f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩)) :=
  btz_uniformization_reg_of_regM (cor_abs_max_C1 hGH hCC hmax) x₀ hnm D ρ hpair

omit [SecondCountableTopology M] in
/-- **The future case is forced by a BTZ line** (DEC-77 (a); SCOPE D-11 (d)): if `M` has a BTZ
point, the developed regular part does not lie in a past regular domain. By Barbot's equality
(`btz_uniformization_reg`) `𝒟(Reg M̃) = Ω⁺(Λ)` or `Ω⁻(Λ)`; the first is disjoint from `Ω⁻(Λ)`
(`Λ ≠ ∅`), the second is past complete, which `false_of_sing_of_pastComplete` refutes. -/
theorem e0RegM_range_not_subset_omegaMinus_of_regM
    (hRM : Causal.Flat.GH (e0RegMFlat M) ∧ Causal.Flat.IsCauchyComplete 2 (e0RegMFlat M) ∧
      Causal.Flat.AbsMax (fun _ => True) (e0RegMFlat M))
    (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty) (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    ¬ range D ⊆ Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range) := by
  intro hsub
  obtain ⟨hlox, hD, -, -, -, -, hcase⟩ :=
    btz_uniformization_reg_of_regM hRM x₀ hnm D ρ hpair
  rcases hcase with ⟨-, hr, -⟩ | ⟨-, hr, -⟩
  · -- future case: `Ω⁺(Λ) ⊆ Ω⁻(Λ)` is impossible, `Λ ≠ ∅` (the loxodromic's fixed points)
    obtain ⟨γ, hγ, hl⟩ := hlox
    obtain ⟨w, hw, -⟩ := Causal.Flat.exists_two_loxRepSet hγ hl
    have hΛ : (Causal.Flat.limitSetJ ρ.range).Nonempty :=
      ⟨w, Causal.Flat.loxRepSet_subset_limitSetJ _ hw⟩
    set z := Causal.UniversalCover.base x₀
    exact Set.disjoint_left.1 (Causal.Flat.disjoint_omegaPlus_omegaMinus hΛ)
      (hr ▸ mem_range_self z) (hsub (mem_range_self z))
  · -- past case: `𝒟(Reg M̃) = Ω⁻(Λ)` is past complete, which a BTZ point forbids
    exact false_of_sing_of_pastComplete hsing hpair hD fun p z hpz => by
      rw [hr]
      exact Causal.Flat.Jminus_omegaMinus_subset _ ⟨D z, hr ▸ mem_range_self z, hpz⟩

/-- `e0RegM_range_not_subset_omegaMinus` in the `C¹` Cauchy-compact form (DEC-107/117). -/
theorem e0RegM_range_not_subset_omegaMinus (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S) (hmax : IsE0CauchyMaximal M)
    (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty) (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    ¬ range D ⊆ Causal.Flat.omegaMinus (Causal.Flat.limitSetJ ρ.range) :=
  e0RegM_range_not_subset_omegaMinus_of_regM (cor_abs_max_C1 hGH hCC hmax) hsing x₀ hnm D ρ hpair

/-- **THE HEADLINE on the regular part, future case** (`theo:globally_hyperbolic_cauchy_complete_cauchy_maximal`,
gx l.2363, in DEC-28's Cauchy-compact form with DEC-76/77): for `M` a globally hyperbolic,
Cauchy-compact, Cauchy-maximal `𝔼₀`-manifold with at least one BTZ point and `π₁(Reg M)` not
metabelian, and every developing pair `(𝒟, ρ)` of `Reg M`: a loxodromic in `ρ(π₁)`; `𝒟`
injective; `ρ` faithful, discrete and torsion-free; the null planes `(Π_w)_{w ∈ Λ}` form a
`ρ(π₁)`-invariant family; `𝒟(Reg M̃) = Ω⁺(Λ) = ⋂_w I⁺(Π_w)` on which `ρ(π₁)` acts freely and
properly discontinuously; `Reg M̃` is future complete; and `𝒟` induces an isometry
`Reg M ≅ ρ(π₁)\Ω⁺(Λ)`. The future case is selected by `e0RegM_range_not_subset_omegaMinus`. -/
theorem btz_uniformization_regFuture (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S)
    (hmax : IsE0CauchyMaximal M) (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    (∃ γ ∈ ρ.range, Causal.Flat.IsLoxodromic (Causal.Flat.linOf γ)) ∧ Injective D ∧
      Injective ρ ∧ DiscreteTopology ρ.range ∧ Causal.Flat.IsTorsionFreeSubgroup ρ.range ∧
      (∀ γ ∈ ρ.range, ∀ w ∈ Causal.Flat.limitSetJ ρ.range,
        Causal.Flat.isomPenrose γ w ∈ Causal.Flat.limitSetJ ρ.range ∧
          (fun p => γ • p) '' nullPlane w = nullPlane (Causal.Flat.isomPenrose γ w)) ∧
      Causal.Flat.FutureRegular (Causal.Flat.limitSetJ ρ.range) ∧
      range D = Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
      Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) =
        ⋂ w ∈ Causal.Flat.limitSetJ ρ.range, (Causal.minkowski 2).Iplus ⊤ (nullPlane w) ∧
      Causal.Flat.ActsFreelyProperlyOn ρ.range
        (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range)) ∧
      (letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
       haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
       IsFutureComplete
        (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) ∧
      ∃ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B),
        IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry 2 π ∧ Surjective π ∧
        (∀ p q : Causal.Flat.limitOpensPlus ρ.range,
          π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski 2) = q) ∧
        Causal.Flat.GH B ∧
        ∃ f : e0RegMFlat M ≃ₜ B, Causal.Flat.IsLocalIsometry 2 f ∧
          ∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
            f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩ := by
  obtain ⟨hlox, hD, hρ, hdisc, htf, hinv, hcase⟩ :=
    btz_uniformization_reg hGH hCC hmax x₀ hnm D ρ hpair
  rcases hcase with ⟨hF, hr, hI, hfp, hfc, hB⟩ | ⟨-, hr, -⟩
  · exact ⟨hlox, hD, hρ, hdisc, htf, hinv, hF, hr, hI, hfp, hfc, hB⟩
  · exact absurd hr.subset
      (e0RegM_range_not_subset_omegaMinus hGH hCC hmax hsing x₀ hnm D ρ hpair)

/-- **`prop:globally_hyperbolic_cauchy_complete_manifolds` (l.2348), corrected (DEC-77), on the regular
part**: a globally hyperbolic, Cauchy-compact, Cauchy-maximal `𝔼₀`-manifold with a BTZ point and
`π₁(Reg M)` not metabelian has its regular part future complete: for every developing pair of
`Reg M` and every `z ∈ Reg M̃`, `𝒟(J⁺(z)) = J⁺(𝒟 z)` and `𝒟(I⁺(z)) = I⁺(𝒟 z)` (the first step of
the paper's proof, l.2350). -/
theorem btz_reg_isFutureComplete (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S) (hmax : IsE0CauchyMaximal M) (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
    haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
    IsFutureComplete (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D :=
  (btz_uniformization_regFuture hGH hCC hmax hsing x₀ hnm D ρ hpair).2.2.2.2.2.2.2.2.2.2.1

/-! ### §4f The mixed-diamond leaf, isolated (proved upstream since WP-47f)

B21 Prop 2.17's mixed diamonds `GX.E0AbsMax.E0Pushout.isCompact_diamond_mixed`
(`GXScaffold.BTZ.AbsMax`, proved there since WP-47f). Its CONCLUSION without its `hGH`/`hmax`
premises (stronger) is the proposition `GX.E0MixedDiamondsCompact`; `GX.cor_abs_max_C1_of_mixed` is Cor 2.18 (DEC-107) from it
with standard axioms only (the proof of `E0Pushout.globallyHyperbolic` / `absMax_e0RegM`, the leaf
a hypothesis), so `GX.btz_uniformization_of_mixed` is the whole headline on standard axioms given
that one proposition. -/

variable (M) in
/-- **The one open leaf of B21 Prop 2.17** (`GX.E0AbsMax.E0Pushout.isCompact_diamond_mixed`, its
CONCLUSION): every mixed diamond `J(p, q)` — `p` BTZ, `q` regular — of the push-out
`M̄ = M ∪_{Reg M} N` along an isometric embedding into a GH flat spacetime is compact. The leaf
also assumes `M` globally hyperbolic and Cauchy-maximal; this proposition drops those premises,
so it is STRONGER than the leaf (`e0MixedDiamondsCompact_of_record` recovers it from the leaf under
them), and every consumer here (`absMax_e0RegM_of_mixed`, `cor_abs_max_C1_of_mixed`,
`btz_uniformization_of_mixed`) carries both premises anyway. -/
def E0MixedDiamondsCompact : Prop :=
  ∀ {N : Causal.Flat.FlatSpacetime.{0} 2}, Causal.Flat.GH N → ∀ {f : e0RegMFlat M → N}
    (P : E0Pushout M N f) {p q : P.carrier}, p ∈ S0 P.carrier → q ∉ S0 P.carrier →
      IsCompact ((CE P.carrier).diamond ⊤ p q)

/-- `E0AbsMax.absMax_e0RegM` with the mixed-diamond leaf as a hypothesis (the proof of
`E0AbsMax.E0Pushout.globallyHyperbolic` and `absMax_e0RegM`, verbatim otherwise). -/
theorem absMax_e0RegM_of_mixed (hmix : E0MixedDiamondsCompact M)
    (hGH : (CE M).GloballyHyperbolic) {S : Set M}
    (hS : (CE M).IsCauchySurface S) (hSc : IsCompact S) (hSac : (CE M).IsAcausal S)
    (hmax : IsE0CauchyMaximal M) :
    Causal.Flat.AbsMax (fun _ => True) (e0RegMFlat M) := by
  have hE := isE0Maximal_of_isE0CauchyMaximal e0_hLine hGH hS hSc hSac hmax
  intro N hN _ f hf y
  obtain ⟨P⟩ := exists_e0Pushout hN hf
  have hPGH : (CE P.carrier).GloballyHyperbolic := by
    have hP := e0_sfa e0_hLine P.carrier
    obtain ⟨hA, hsA, hBc⟩ := P.pieces
    let A : TopologicalSpace.Opens P.carrier := ⟨range P.ι₁, hA⟩
    let B : TopologicalSpace.Opens P.carrier := ⟨range P.ι₂, P.isOpenEmbedding_ι₂.isOpen_range⟩
    have hGA : (CE P.carrier).GloballyHyperbolicOn A :=
      globallyHyperbolicOn_of_le_iff hGH (continuous_of_isE0Mor P.isE0Mor_ι₁) rfl
        (le_iff_of_isE0Mor P.isE0Mor_ι₁ P.injective_ι₁ rfl)
    have hGB : (CE P.carrier).GloballyHyperbolicOn B :=
      globallyHyperbolicOn_of_le_iff hN P.isOpenEmbedding_ι₂.continuous rfl
        (P.le_ι₂ B rfl)
    exact globallyHyperbolic_of_twoOpens hP (A := A) (B := B) hsA hBc hGA hGB
      fun p hp q hq => hmix hN P hp hq
  have hbij := hE P.carrier P.ι₁ hPGH P.isE0Mor_ι₁ P.injective_ι₁
  obtain ⟨x, hx⟩ := hbij.2 (P.ι₂ y)
  obtain ⟨w, -, hw⟩ := P.glue x y hx
  exact ⟨w, hw⟩

/-- `E0AbsMax.cor_abs_max_C1` with the mixed-diamond leaf as a hypothesis: standard axioms. -/
theorem cor_abs_max_C1_of_mixed (hmix : E0MixedDiamondsCompact M)
    (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S) (hmax : IsE0CauchyMaximal M) :
    Causal.Flat.GH (e0RegMFlat M) ∧ Causal.Flat.IsCauchyComplete 2 (e0RegMFlat M) ∧
      Causal.Flat.AbsMax (fun _ => True) (e0RegMFlat M) := by
  obtain ⟨S, hS⟩ := hCC
  exact ⟨gh_e0RegMFlat_e0 hGH, E0Surgery.regM_isCauchyComplete_of_C1 hGH hS hmax,
    absMax_e0RegM_of_mixed hmix hGH hS.cauchy hS.compact
      (isAcausal_of_isCauchySurface_e0 hGH hS.cauchy) hmax⟩

/-- The leaf of record (`GXScaffold.BTZ.AbsMax`, sorry-free since WP-47f) discharges the hypothesis. -/
theorem e0MixedDiamondsCompact_of_record (hGH : (CE M).GloballyHyperbolic)
    (hmax : IsE0CauchyMaximal M) : E0MixedDiamondsCompact M :=
  fun {_N} hN {_f} P {_p _q} hp hq => E0Pushout.isCompact_diamond_mixed hGH hmax hN P hp hq

/-! ### §4a The forms of record (DEC-107: « Cauchy-compact » is a compact `C¹` spacelike Cauchy surface)

`E0AbsMax.cor_abs_max_C1` feeds the `_of_regM` cores, so the not-owed (G0) smoothing
`E0Surgery.exists_isE0C1SpacelikeCauchy` is off the path. The headline adds the BTZ side that is
available on `M` itself: every BTZ point is the origin of a full future BTZ ray
(`E0Spear.exists_fullFutureBTZRay_e0`, B21 Lemma 2.3 — the paper's « Lemma 2.4 », l.2352). -/

/-- `btz_uniformization_C1` from the triple « `Reg M` GH, Cauchy-complete, absolutely maximal »
(any form of B21 Cor 2.18), standard axioms only. -/
theorem btz_uniformization_C1_of_regM (hGH : (CE M).GloballyHyperbolic)
    (hRM : Causal.Flat.GH (e0RegMFlat M) ∧ Causal.Flat.IsCauchyComplete 2 (e0RegMFlat M) ∧
      Causal.Flat.AbsMax (fun _ => True) (e0RegMFlat M))
    (hmax : IsE0CauchyMaximal M) (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    (∃ γ ∈ ρ.range, Causal.Flat.IsLoxodromic (Causal.Flat.linOf γ)) ∧ Injective D ∧
      Injective ρ ∧ DiscreteTopology ρ.range ∧ Causal.Flat.IsTorsionFreeSubgroup ρ.range ∧
      (∀ γ ∈ ρ.range, ∀ w ∈ Causal.Flat.limitSetJ ρ.range,
        Causal.Flat.isomPenrose γ w ∈ Causal.Flat.limitSetJ ρ.range ∧
          (fun p => γ • p) '' nullPlane w = nullPlane (Causal.Flat.isomPenrose γ w)) ∧
      Causal.Flat.FutureRegular (Causal.Flat.limitSetJ ρ.range) ∧
      range D = Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
      Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) =
        ⋂ w ∈ Causal.Flat.limitSetJ ρ.range, (Causal.minkowski 2).Iplus ⊤ (nullPlane w) ∧
      Causal.Flat.ActsFreelyProperlyOn ρ.range
        (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range)) ∧
      (letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
       haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
       IsFutureComplete
        (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) ∧
      (∃ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B),
        IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry 2 π ∧ Surjective π ∧
        (∀ p q : Causal.Flat.limitOpensPlus ρ.range,
          π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski 2) = q) ∧
        Causal.Flat.GH B ∧
        ∃ f : e0RegMFlat M ≃ₜ B, Causal.Flat.IsLocalIsometry 2 f ∧
          ∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
            f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩) ∧
      ∀ p ∈ S0 M, ∃ γ : ℝ → M, E0Spear.IsFullFutureBTZRay p γ := by
  obtain ⟨hlox, hD, hρ, hdisc, htf, hinv, hcase⟩ :=
    btz_uniformization_reg_of_regM hRM x₀ hnm D ρ hpair
  rcases hcase with ⟨hF, hr, hI, hfp, hfc, hB⟩ | ⟨-, hr, -⟩
  · exact ⟨hlox, hD, hρ, hdisc, htf, hinv, hF, hr, hI, hfp, hfc, hB,
      fun p hp => E0Spear.exists_fullFutureBTZRay_e0 hGH hmax hp⟩
  · exact absurd hr.subset (e0RegM_range_not_subset_omegaMinus_of_regM
      hRM hsing x₀ hnm D ρ hpair)

/-- **The headline on `M` and `Reg M`, with « `π₁(Reg M)` not metabelian »**
(`theo:globally_hyperbolic_cauchy_complete_cauchy_maximal`, gx l.2363, DEC-28 + DEC-107 + DEC-77;
the form of record with DEC-119's « free and non-abelian » and the bridge is `btz_uniformization`): for `M` a globally hyperbolic Cauchy-maximal
`𝔼₀`-manifold with a compact `C¹` spacelike Cauchy surface, at least one BTZ point, and
`π₁(Reg M)` not metabelian, and **every** developing pair `(𝒟, ρ)` of `Reg M`: a loxodromic in
`ρ(π₁)`; `𝒟` injective on `Reg M̃`; `ρ` faithful, discrete, torsion-free; the `ρ(π₁)`-invariant
null planes `(Π_w)_{w ∈ Λ}`; `𝒟(Reg M̃) = Ω⁺(Λ) = ⋂_w I⁺(Π_w)`, freely and properly
discontinuously acted on; `Reg M̃` future complete; `𝒟` induces an isometry
`Reg M ≅ ρ(π₁)\Ω⁺(Λ)`; and every BTZ point of `M` starts a full future BTZ ray. -/
theorem btz_uniformization_C1 (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S)
    (hmax : IsE0CauchyMaximal M) (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    (∃ γ ∈ ρ.range, Causal.Flat.IsLoxodromic (Causal.Flat.linOf γ)) ∧ Injective D ∧
      Injective ρ ∧ DiscreteTopology ρ.range ∧ Causal.Flat.IsTorsionFreeSubgroup ρ.range ∧
      (∀ γ ∈ ρ.range, ∀ w ∈ Causal.Flat.limitSetJ ρ.range,
        Causal.Flat.isomPenrose γ w ∈ Causal.Flat.limitSetJ ρ.range ∧
          (fun p => γ • p) '' nullPlane w = nullPlane (Causal.Flat.isomPenrose γ w)) ∧
      Causal.Flat.FutureRegular (Causal.Flat.limitSetJ ρ.range) ∧
      range D = Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
      Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) =
        ⋂ w ∈ Causal.Flat.limitSetJ ρ.range, (Causal.minkowski 2).Iplus ⊤ (nullPlane w) ∧
      Causal.Flat.ActsFreelyProperlyOn ρ.range
        (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range)) ∧
      (letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
       haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
       IsFutureComplete
        (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) ∧
      (∃ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B),
        IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry 2 π ∧ Surjective π ∧
        (∀ p q : Causal.Flat.limitOpensPlus ρ.range,
          π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski 2) = q) ∧
        Causal.Flat.GH B ∧
        ∃ f : e0RegMFlat M ≃ₜ B, Causal.Flat.IsLocalIsometry 2 f ∧
          ∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
            f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩) ∧
      ∀ p ∈ S0 M, ∃ γ : ℝ → M, E0Spear.IsFullFutureBTZRay p γ :=
  btz_uniformization_C1_of_regM hGH (cor_abs_max_C1 hGH hCC hmax) hmax hsing x₀ hnm D ρ hpair

/-- **The proof's two steps of `prop:globally_hyperbolic_cauchy_complete_manifolds`** (l.2348,
DEC-77's corrected hypotheses, DEC-107; a LEMMA — the form of record, with DEC-118 (a)'s
conclusion `IsBTZFutureComplete`, is `btz_isBTZFutureComplete_C1`): a globally hyperbolic Cauchy-maximal `𝔼₀`-manifold with a compact `C¹`
spacelike Cauchy surface, a BTZ point and `π₁(Reg M)` not metabelian is future complete in the
two senses of the paper's proof: (1) its regular part — for every developing pair of `Reg M` and
every `z ∈ Reg M̃`, `𝒟(J⁺(z)) = J⁺(𝒟 z)` and `𝒟(I⁺(z)) = I⁺(𝒟 z)` (l.2350); (2) its singular
locus contains full future BTZ rays — every BTZ point `p` is `γ 0` for a ray
`γ(t) = ψ(v + t, 0)`, `ψ` an injective `𝔼₀`-morphism on a neighbourhood of the whole model ray
(l.2352, B21 Lemma 2.3). -/
theorem btz_isFutureComplete_C1 (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S)
    (hmax : IsE0CauchyMaximal M) (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    (letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
     haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
     IsFutureComplete (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) ∧
      ∀ p ∈ S0 M, ∃ γ : ℝ → M, E0Spear.IsFullFutureBTZRay p γ :=
  ⟨(btz_uniformization_C1 hGH hCC hmax hsing x₀ hnm D ρ hpair).2.2.2.2.2.2.2.2.2.2.1,
    fun _ hp => E0Spear.exists_fullFutureBTZRay_e0 hGH hmax hp⟩

/-! ### §4c DEC-76's « `π₁` non-abelian », through freeness

A non-abelian free group is not metabelian (`GX.not_isMetabelianGroup_of_isFreeGroup`: map two
distinct generators onto those of `F₂`, where `⁅⁅a, b⁆, ⁅a, b⁻¹⁆⁆ ≠ 1` is decided by reduction).
So the headline holds with DEC-76's hypothesis « non-abelian » as soon as `π₁(Reg M)` is known to
be free — the geometric fact (`Reg M ≅ (Σ ∖ sing) × ℝ`, `s ≥ 1`, a punctured surface has a free
`π₁`) that is carried here as the hypothesis `IsFreeGroup`. -/

/-- **The headline with DEC-76's « non-abelian »**, `π₁(Reg M)` being free. -/
theorem btz_uniformization_C1_of_isFreeGroup (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S)
    (hmax : IsE0CauchyMaximal M) (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    (x₀ : e0RegMFlat M)
    (hfree : IsFreeGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (hna : ∃ a b : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀), a * b ≠ b * a)
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    (∃ γ ∈ ρ.range, Causal.Flat.IsLoxodromic (Causal.Flat.linOf γ)) ∧ Injective D ∧
      Injective ρ ∧ DiscreteTopology ρ.range ∧ Causal.Flat.IsTorsionFreeSubgroup ρ.range ∧
      (∀ γ ∈ ρ.range, ∀ w ∈ Causal.Flat.limitSetJ ρ.range,
        Causal.Flat.isomPenrose γ w ∈ Causal.Flat.limitSetJ ρ.range ∧
          (fun p => γ • p) '' nullPlane w = nullPlane (Causal.Flat.isomPenrose γ w)) ∧
      Causal.Flat.FutureRegular (Causal.Flat.limitSetJ ρ.range) ∧
      range D = Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
      Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) =
        ⋂ w ∈ Causal.Flat.limitSetJ ρ.range, (Causal.minkowski 2).Iplus ⊤ (nullPlane w) ∧
      Causal.Flat.ActsFreelyProperlyOn ρ.range
        (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range)) ∧
      (letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
       haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
       IsFutureComplete
        (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) ∧
      (∃ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B),
        IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry 2 π ∧ Surjective π ∧
        (∀ p q : Causal.Flat.limitOpensPlus ρ.range,
          π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski 2) = q) ∧
        Causal.Flat.GH B ∧
        ∃ f : e0RegMFlat M ≃ₜ B, Causal.Flat.IsLocalIsometry 2 f ∧
          ∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
            f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩) ∧
      ∀ p ∈ S0 M, ∃ γ : ℝ → M, E0Spear.IsFullFutureBTZRay p γ :=
  btz_uniformization_C1 hGH hCC hmax hsing x₀ (not_isMetabelianGroup_of_isFreeGroup' hfree hna)
    D ρ hpair

/-! ### §4e The BTZ half through the bridge (DEC-106, DEC-118, DEC-119)

`GX.BTZ.HeadlineBridge` builds the singular structure of `M` from its `𝔼₀` atlas
(`E0Bridge.e0SingularGXStructure`), `reg M̃ ≃ₜ` the universal cover of `Reg M`
(`E0Bridge.regTildeHomeo`) and the extension of a developing pair of `Reg M` to the BTZ points
(`E0Bridge.exists_btzTildeData_of_isDevelopingPair`); `GX.BTZ.LiftGH` proves `M̃` globally
hyperbolic in its natural topology (DEC-106/118 (b)). -/

attribute [local instance] btzE0Structure in
/-- **The BTZ half of the headline, through the bridge**: for a globally hyperbolic `𝔼₀`-manifold
`M`, a developing pair `(𝒟, ρ)` of `Reg M` with `𝒟` injective, and every presentation `Φ` of
`\widetilde{𝔼₀}`: (1) ONE `\widetilde M`-datum `d` — the chartwise one (DEC-118 (c)) — on which
`𝒟` extends to the BTZ points (`d.D` `T_BTZ`-continuous, `d.D = 𝒟` on `reg M̃` through
`regTildeHomeo`), the extension is injective on `reg M̃`, and `M̃` is globally hyperbolic in its
natural topology (DEC-106, DEC-118 (b)); (2) every `\widetilde M`-datum is future distinguishing
for its chart-generated `≪` (DEC-118 (a)). The datum is `exists_isChartwise`'s, translated by
`E0Bridge.exists_btzTildeData_extending` (same `T_BTZ`, and `IsChartwise` reads `T_BTZ` only). -/
theorem btz_uniformization_btzHalf (hGH : (CE M).GloballyHyperbolic) (x₀ : e0RegMFlat M)
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) (hD : Injective D) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ}, (∀ e, orbitMk (GammaA (2 * Real.pi)) (Φ e) = e.base) →
      (∃ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, d.IsChartwise ∧
        (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) ∧
        InjOn d.D (E0Bridge.regTilde (E0Bridge.basePt x₀)) ∧
        d.natCausality.GloballyHyperbolic) ∧
      ∀ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, IsFutureDistinguishing d.causality := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ hΦ
  have hG : (e0ManifoldCausality M E0Bridge.isBTZSingModelled_e0).GloballyHyperbolic :=
    E0Bridge.globallyHyperbolic_e0ManifoldCausality_iff.2 hGH
  refine ⟨?_, fun d => d.isFutureDistinguishing_of_base E0Bridge.isBTZSingModelled_e0 hG⟩
  -- ONE datum: the chartwise datum, translated so that its developing map is `𝒟` on `reg M̃`
  -- (the translate keeps `T_BTZ`, and `IsChartwise` depends on `T_BTZ` alone)
  obtain ⟨d0, hd0⟩ := BTZTildeData.exists_isChartwise (y₀ := E0Bridge.basePt x₀)
    E0Bridge.isBTZSingModelled_e0 hΦ
  obtain ⟨d, hT, hd⟩ := E0Bridge.exists_btzTildeData_extending (E0Bridge.basePt x₀) d0 hpair
  have hch : d.IsChartwise := by
    unfold BTZTildeData.IsChartwise
    rw [hT]
    exact hd0
  refine ⟨d, hch, hd, ?_, d.natGloballyHyperbolic_of_base hch E0Bridge.isBTZSingModelled_e0 hG⟩
  intro a ha b hb hab
  have h1 := hd ⟨a, ha⟩
  have h2 := hd ⟨b, hb⟩
  simp only at h1 h2
  rw [h1, h2] at hab
  exact congrArg Subtype.val ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).injective (hD hab))

/-! ### §4g′ Transport of the flat causality of `Reg M̃` into `M̃` (WP-46h fixer round 2)

`btzTilde_transport`: a relation of the flat causality of the universal cover of `Reg M` is a
relation of `BTZTildeData.causality` between the corresponding points of `reg M̃`
(`E0Bridge.regTildeHomeo`) — the flat causality is absolutely minimal, and on a small ball of a
flat chart a relation is one link of a `T_BTZ`-chart developed by `d.D`
(`btzTilde_transport_local`). With it the reverse inclusions of DEC-118 (a) hold at regular points
(`btzTilde_supset_of_reg`), the chronological one at every point (`btzTilde_supset_of_null`), and
the causal one at BTZ points off the developed BTZ line (`btzTilde_null_supset`). -/

section Transport

open Filter Topology

attribute [local instance] btzE0Structure in
/-- **The local transport** (the core of `btzTilde_transport`): every point `c` of the universal
cover of `Reg M` has an open neighbourhood `O` — a small ball of the flat chart at `c` on which
`𝒟 = g · chart` — such that a relation `a ≤_O b` (resp. `a ≪_O b`) of the flat causality is a
relation `ι a ≤ ι b` (resp. `≪`) of `BTZTildeData.causality`, `ι` the inclusion through
`E0Bridge.regTildeHomeo`: `h · d.D` (a translation `h` into `J⁺(Δ₀) ∖ Δ₀`) is a chart of the
developed atlas on `ι(O)`, and the straight segment of its target ball is one chart link. -/
theorem btzTilde_transport_local (x₀ : e0RegMFlat M)
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ),
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
      haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
      ∀ c : Causal.UniversalCover (e0RegMFlat M) x₀,
        ∃ O : TopologicalSpace.Opens (Causal.UniversalCover (e0RegMFlat M) x₀), c ∈ O ∧
          ∀ a ∈ O, ∀ b ∈ O,
            ((Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)).le O a b →
              d.causality.le ⊤
                (d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm a :
                  MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))))
                (d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm b :
                  MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))))) ∧
            ((Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)).lt O a b →
              d.causality.lt ⊤
                (d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm a :
                  MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))))
                (d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm b :
                  MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))))) := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hd
  letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
  haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
  intro c
  set ι : Causal.UniversalCover (e0RegMFlat M) x₀ →
      MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) := fun a =>
    (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm a : E0Bridge.regTilde (E0Bridge.basePt x₀)) :
      MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) with hιdef
  have hDι : ∀ a, d.D (ι a) = D a := fun a => by
    show d.D (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm a : E0Bridge.regTilde (E0Bridge.basePt x₀)) :
      MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) = D a
    rw [hd, Homeomorph.apply_symm_apply]
  have hιreg : ∀ a, (ι a).base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M := fun a => by
    have h := ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm a).2
    have h' : (ι a).base ∈ (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ := h
    simpa [Sing] using h'
  have hιc : Continuous ι := continuous_subtype_val.comp (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm.continuous
  have hRo : IsOpen (E0Bridge.regTilde (E0Bridge.basePt x₀)) :=
    (isClosed_sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M).isOpen_compl.preimage
      SpreadEnd.continuous_base
  have hιo : IsOpenMap ι :=
    hRo.isOpenMap_subtype_val.comp (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm.isOpenMap
  have hιinj : Injective ι := Subtype.val_injective.comp (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm.injective
  -- the flat chart at `c` and `D = g • e` near `c`
  set e := chartAt (Causal.Minkowski 2) c with hedef
  have he : e ∈ (Causal.gxGroupoid (Causal.Flat.isom 2) (Causal.Minkowski 2)).maximalAtlas
      (Causal.UniversalCover (e0RegMFlat M) x₀) :=
    StructureGroupoid.chart_mem_maximalAtlas _ c
  obtain ⟨g, hg⟩ := hpair.gx.exists_smul_eq c
  have hg' : ∀ᶠ y in 𝓝 c, D y = g • e y ∧ y ∈ e.source := by
    filter_upwards [hg, e.open_source.mem_nhds (mem_chart_source _ c)] with y hy hy'
    refine ⟨?_, hy'⟩
    simpa [chartAt_self_eq] using hy
  obtain ⟨O₀, hO₀sub, hO₀o, hcO₀⟩ := mem_nhds_iff.1 hg'
  have hcs : c ∈ e.source := mem_chart_source _ c
  -- the ball of radius `ε` around `D c`
  set W := e.target ∩ e.symm ⁻¹' O₀ with hWdef
  have hWo : IsOpen W := e.isOpen_inter_preimage_symm hO₀o
  have hgc : Continuous (fun m : Causal.Minkowski 2 => g⁻¹ • m) :=
    (Causal.Flat.isom.toHomeomorph g⁻¹).continuous
  have hW' : IsOpen ((fun m : Causal.Minkowski 2 => g⁻¹ • m) ⁻¹' W) := hWo.preimage hgc
  have hDc : D c = g • e c := (hO₀sub hcO₀).1
  have hcW : D c ∈ (fun m : Causal.Minkowski 2 => g⁻¹ • m) ⁻¹' W := by
    show g⁻¹ • D c ∈ W
    rw [hDc, inv_smul_smul]
    exact ⟨e.map_source hcs, by rw [mem_preimage, e.left_inv hcs]; exact hcO₀⟩
  obtain ⟨ε₁, hε₁, hB₁⟩ := Metric.isOpen_iff.1 hW' _ hcW
  obtain ⟨ε₂, hε₂, hB₂⟩ := Metric.isOpen_iff.1 isOpen_btzJ0HalfSpace _ btzJ0Pt_mem
  obtain ⟨ε, hε, hεε₁, hεε₂⟩ : ∃ ε : ℝ, 0 < ε ∧ ε ≤ ε₁ ∧ ε ≤ ε₂ :=
    ⟨min ε₁ ε₂, lt_min hε₁ hε₂, min_le_left _ _, min_le_right _ _⟩
  -- the translation `h` of `D c` to `btzJ0Pt`
  obtain ⟨h, hh⟩ : ∃ h : Causal.Flat.isom 2, ∀ x, h • x = (btzJ0Pt - D c) + x :=
    ⟨⟨AffineEquiv.constVAdd ℝ (Causal.Minkowski 2) (btzJ0Pt - D c),
      Causal.Flat.constVAdd_mem_isom _⟩, fun x => by rw [Causal.Flat.isom_smul_def]; rfl⟩
  have hhB : ∀ x, h • x ∈ Metric.ball btzJ0Pt ε ↔ x ∈ Metric.ball (D c) ε := fun x => by
    rw [hh, Metric.mem_ball, Metric.mem_ball, dist_eq_norm, dist_eq_norm]
    have : btzJ0Pt - D c + x - btzJ0Pt = x - D c := by abel
    rw [this]
  have hHalf : Metric.ball btzJ0Pt ε ⊆ btzJ0HalfSpace :=
    (Metric.ball_subset_ball hεε₂).trans hB₂
  have hBW : ∀ m ∈ Metric.ball (D c) ε, g⁻¹ • m ∈ W := fun m hm =>
    hB₁ (Metric.ball_subset_ball hεε₁ hm)
  -- the open set `O`
  set O : Set (Causal.UniversalCover (e0RegMFlat M) x₀) :=
    O₀ ∩ D ⁻¹' Metric.ball (D c) ε with hOdef
  have hOo : IsOpen O := hO₀o.inter (Metric.isOpen_ball.preimage hpair.gx.continuous)
  have hcO : c ∈ O := ⟨hcO₀, Metric.mem_ball_self hε⟩
  have hOe : ∀ a ∈ O, D a = g • e a ∧ a ∈ e.source := fun a ha => hO₀sub ha.1
  -- the inverse on the ball
  have hinvB : ∀ m ∈ Metric.ball (D c) ε, e.symm (g⁻¹ • m) ∈ O ∧ D (e.symm (g⁻¹ • m)) = m :=
    fun m hm => by
      have hW := hBW m hm
      have hp : e.symm (g⁻¹ • m) ∈ O₀ := hW.2
      have hDp : D (e.symm (g⁻¹ • m)) = m := by
        rw [(hO₀sub hp).1, e.right_inv hW.1, smul_inv_smul]
      exact ⟨⟨hp, by rw [mem_preimage, hDp]; exact hm⟩, hDp⟩
  have hval : ∀ a ∈ O, (btzJ0RegInv (h • d.D (ι a))).val = h • D a := fun a ha => by
    rw [hDι]
    exact btzJ0RegInv_val (btzJ0HalfSpace_subset (hHalf ((hhB _).2 ha.2)))
  have hcontD : ∀ a, ContinuousAt d.D (ι a) := fun a => by
    have h1 := @Continuous.continuousAt _ _ d.T'.top _ _ (ι a) d.continuous_D
    unfold ContinuousAt at h1 ⊢
    rwa [d.nhds_reg (ι a) (hιreg a)] at h1
  have hhc : Continuous (fun x : Causal.Minkowski 2 => h • x) :=
    (Causal.Flat.isom.toHomeomorph h).continuous
  have hhic : Continuous (fun x : Causal.Minkowski 2 => h⁻¹ • x) :=
    (Causal.Flat.isom.toHomeomorph h⁻¹).continuous
  let κN : OpenPartialHomeomorph (MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) BTZJ0 :=
    { toFun := fun w => btzJ0RegInv (h • d.D w)
      invFun := fun q => ι (e.symm (g⁻¹ • (h⁻¹ • q.val)))
      source := ι '' O
      target := {q | q.val ∈ Metric.ball btzJ0Pt ε}
      map_source' := by
        rintro _ ⟨a, ha, rfl⟩
        show (btzJ0RegInv (h • d.D (ι a))).val ∈ Metric.ball btzJ0Pt ε
        rw [hval a ha]; exact (hhB _).2 ha.2
      map_target' := fun q hq => by
        have hm : h⁻¹ • q.val ∈ Metric.ball (D c) ε := by
          rw [← hhB, smul_inv_smul]; exact hq
        exact ⟨_, (hinvB _ hm).1, rfl⟩
      left_inv' := by
        rintro _ ⟨a, ha, rfl⟩
        show ι (e.symm (g⁻¹ • (h⁻¹ • (btzJ0RegInv (h • d.D (ι a))).val))) = ι a
        rw [hval a ha, inv_smul_smul, (hOe a ha).1, inv_smul_smul, e.left_inv (hOe a ha).2]
      right_inv' := fun q hq => by
        have hm : h⁻¹ • q.val ∈ Metric.ball (D c) ε := by
          rw [← hhB, smul_inv_smul]; exact hq
        show btzJ0RegInv (h • d.D (ι (e.symm (g⁻¹ • (h⁻¹ • q.val))))) = q
        rw [hDι, (hinvB _ hm).2, smul_inv_smul, btzJ0RegInv_of_mem q.mem]
        rfl
      open_source := hιo _ hOo
      open_target := Metric.isOpen_ball.preimage continuous_btzJ_val
      continuousOn_toFun := by
        rintro _ ⟨a, ha, rfl⟩
        refine ContinuousAt.continuousWithinAt ?_
        have hc2 : ContinuousAt btzJ0RegInv (h • d.D (ι a)) := by
          rw [hDι]
          exact btzJ0RegIncl.continuousAt_symm (hHalf ((hhB _).2 ha.2))
        have h4 : ContinuousAt (fun w => h • d.D w) (ι a) :=
          ContinuousAt.comp (g := fun x : Causal.Minkowski 2 => h • x) (f := d.D)
            hhc.continuousAt (hcontD a)
        exact ContinuousAt.comp (f := fun w => h • d.D w) hc2 h4
      continuousOn_invFun := by
        have hgc' : Continuous (fun x : Causal.Minkowski 2 => g⁻¹ • x) := hgc
        refine hιc.comp_continuousOn (e.continuousOn_symm.comp
          (hgc'.comp (hhic.comp continuous_btzJ_val)).continuousOn ?_)
        intro q hq
        have hm : h⁻¹ • q.val ∈ Metric.ball (D c) ε := by
          rw [← hhB, smul_inv_smul]; exact hq
        exact (hBW _ hm).1 }
  let κ : OpenPartialHomeomorph d.Space BTZJ0 :=
    OpenPartialHomeomorph.retopBTZ d.T' κN d.le_natural (by
      rintro _ ⟨a, -, rfl⟩
      exact d.nhds_reg (ι a) (hιreg a))
  have hκv : ∀ a ∈ O, (κ (d.fromNat (ι a))).val = h • D a := hval
  have hκs : ∀ a ∈ O, d.fromNat (ι a) ∈ κ.source := fun a ha => ⟨a, ha, rfl⟩
  have hκ : κ ∈ btzTildeDevAtlas (N := d.Space) d.D := by
    refine ⟨h⁻¹, ?_⟩
    rintro _ ⟨a, ha, rfl⟩
    show d.D (ι a) = h⁻¹ • (κ (d.fromNat (ι a))).val
    rw [hκv a ha, inv_smul_smul, hDι]
  have hOsub : (⟨O, hOo⟩ : TopologicalSpace.Opens _) ≤ Causal.chartSource e :=
    fun a ha => (hOe a ha).2
  have hchart := Causal.Flat.flatCausality_chartIso he
  have hDle : ∀ a ∈ O, ∀ b ∈ O, (Causal.minkowski 2).le ⊤ (e a) (e b) →
      btzJLe (κ (d.fromNat (ι a))) (κ (d.fromNat (ι b))) := fun a ha b hb hab => by
    show (Causal.minkowski 2).le ⊤ (κ (d.fromNat (ι a))).val (κ (d.fromNat (ι b))).val
    rw [hκv a ha, hκv b hb, (hOe a ha).1, (hOe b hb).1]
    exact (Causal.Flat.isom_le_top_iff h).2 ((Causal.Flat.isom_le_top_iff g).2 hab)
  have hDlt : ∀ a ∈ O, ∀ b ∈ O, (Causal.minkowski 2).lt ⊤ (e a) (e b) →
      btzJLt (κ (d.fromNat (ι a))) (κ (d.fromNat (ι b))) := fun a ha b hb hab => by
    show (Causal.minkowski 2).lt ⊤ (κ (d.fromNat (ι a))).val (κ (d.fromNat (ι b))).val
    rw [hκv a ha, hκv b hb, (hOe a ha).1, (hOe b hb).1]
    exact (Causal.Flat.isom_lt_top_iff h).2 ((Causal.Flat.isom_lt_top_iff g).2 hab)
  have hball : ∀ a ∈ O, (κ (d.fromNat (ι a))).val ∈ Metric.ball btzJ0Pt ε := fun a ha => by
    rw [hκv a ha]; exact (hhB _).2 ha.2
  have hseg : ∀ a ∈ O, ∀ b ∈ O, ∀ (hl : btzJLe (κ (d.fromNat (ι a))) (κ (d.fromNat (ι b)))),
      ∀ s ∈ Icc (0 : ℝ) 1, btzJSeg hl s ∈ Causal.chartImage κ (⊤ ⊓ Causal.chartSource κ) := by
    intro a ha b hb hl s hs
    have hmem : (btzJSeg hl s).val ∈ Metric.ball btzJ0Pt ε := by
      rw [btzJSeg_val]
      exact btzJSegPt_mem_ball (hball a ha) (hball b hb) hs
    have hmem' : btzJSeg hl s ∈ κ.target := hmem
    exact ⟨κ.symm (btzJSeg hl s), ⟨κ.map_target hmem', trivial, κ.map_target hmem'⟩,
      κ.right_inv hmem'⟩
  refine ⟨⟨O, hOo⟩, hcO, fun a ha b hb => ⟨fun hab => ?_, fun hab => ?_⟩⟩
  · have h1 := ((hchart ⟨O, hOo⟩ hOsub a ha b hb).1).1 hab
    have h2 : (Causal.minkowski 2).le ⊤ (e a) (e b) := (Causal.minkowski 2).le_mono le_top h1
    have hl := hDle a ha b hb h2
    exact btzTildeAtlasCausality_le_of_link (hA := d.isBTZTildeDev) hκ
      (btzTilde_link_le_iff.2 ⟨⟨trivial, hκs a ha⟩, ⟨trivial, hκs b hb⟩,
        0, 1, zero_le_one, btzJSeg hl, btzJ_curveOn_seg hl (hseg a ha b hb hl), btzJSeg_zero hl,
        btzJSeg_one hl⟩)
  · have h1 := ((hchart ⟨O, hOo⟩ hOsub a ha b hb).2).1 hab
    have h2 : (Causal.minkowski 2).lt ⊤ (e a) (e b) := (Causal.minkowski 2).lt_mono le_top h1
    have hl := hDlt a ha b hb h2
    exact btzTildeAtlasCausality_lt_of_link (hA := d.isBTZTildeDev) hκ
      (btzTilde_link_lt_iff.2 ⟨⟨trivial, hκs a ha⟩, ⟨trivial, hκs b hb⟩,
        0, 1, zero_lt_one, btzJSeg hl.le, btzJ_curveOn_seg_lt hl (hseg a ha b hb hl.le),
        btzJSeg_zero hl.le, btzJSeg_one hl.le⟩)


attribute [local instance] btzE0Structure in
/-- **Transport of the flat causality of `Reg M̃` into `M̃`** (WP-46h audit issue 2 (i)): for a
developing pair `(𝒟, ρ)` of `Reg M` and a datum `d` whose developing map is `𝒟` on `reg M̃`, every
relation `a ≤ b` / `a ≪ b` of the flat causality of the universal cover of `Reg M` is a relation of
`BTZTildeData.causality` between the corresponding points of `reg M̃` (`E0Bridge.regTildeHomeo`).
The flat causality is absolutely minimal (`flatCausality_absolutelyMinimal`), so a relation is a
chain of relations inside the neighbourhoods of `btzTilde_transport_local`. -/
theorem btzTilde_transport (x₀ : e0RegMFlat M)
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ),
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
      haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
      ∀ a b : Causal.UniversalCover (e0RegMFlat M) x₀,
        ((Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)).le ⊤ a b →
          d.causality.le ⊤
            (d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm a :
              MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))))
            (d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm b :
              MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))))) ∧
        ((Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)).lt ⊤ a b →
          d.causality.lt ⊤
            (d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm a :
              MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))))
            (d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm b :
              MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))))) := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hd
  letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
  haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
  intro a b
  have hloc := btzTilde_transport_local x₀ D ρ hpair d hd
  set C := Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀) with hCdef
  set ι : Causal.UniversalCover (e0RegMFlat M) x₀ → d.Space := fun a =>
    d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm a :
      MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))) with hιdef
  set S : Set (TopologicalSpace.Opens (Causal.UniversalCover (e0RegMFlat M) x₀)) :=
    {O | ∀ a ∈ O, ∀ b ∈ O, (C.le O a b → d.causality.le ⊤ (ι a) (ι b)) ∧
      (C.lt O a b → d.causality.lt ⊤ (ι a) (ι b))} with hSdef
  have hS : ∀ x ∈ (⊤ : TopologicalSpace.Opens (Causal.UniversalCover (e0RegMFlat M) x₀)),
      ∃ O ∈ S, x ∈ O := fun x _ => by
    obtain ⟨O, hx, hO⟩ := hloc x
    exact ⟨O, hO, hx⟩
  have hmin := (Causal.Precausality.absolutelyMinimal_iff.1
    (Causal.Flat.flatCausality_absolutelyMinimal (d := 2)
      (M := Causal.UniversalCover (e0RegMFlat M) x₀))) S hS ⊤ le_rfl a b
  refine ⟨fun hab => ?_, fun hab => ?_⟩
  · have hc := hmin.1 hab
    clear hab hmin
    induction hc with
    | single hl =>
      obtain ⟨O, hO, h⟩ := hl
      rw [top_inf_eq] at h
      exact (hO _ (C.le_mem_left h) _ (C.le_mem_right h)).1 h
    | tail _ hl ih =>
      obtain ⟨O, hO, h⟩ := hl
      rw [top_inf_eq] at h
      exact d.causality.le_trans ih ((hO _ (C.le_mem_left h) _ (C.le_mem_right h)).1 h)
  · have hc := hmin.2 hab
    clear hab hmin
    induction hc with
    | single hl =>
      obtain ⟨O, hO, h⟩ := hl
      rw [top_inf_eq] at h
      exact (hO _ (C.lt_mem_left h) _ (C.lt_mem_right h)).2 h
    | tail _ hl ih =>
      obtain ⟨O, hO, h⟩ := hl
      rw [top_inf_eq] at h
      exact d.causality.lt_trans ih ((hO _ (C.lt_mem_left h) _ (C.lt_mem_right h)).2 h)


attribute [local instance] btzE0Structure in
/-- **The reverse inclusions of DEC-118 (a) at a regular point of `M̃`**: if `Reg M̃` is future
complete for its flat causality (step (1) of the proof, l.2350), then for every `x ∈ reg M̃`,
`J⁺(𝒟 x) ⊆ 𝒟(J⁺(x))` and `I⁺(𝒟 x) ⊆ 𝒟(I⁺(x))` in `M̃` (through `btzTilde_transport`). -/
theorem btzTilde_supset_of_reg (x₀ : e0RegMFlat M)
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ)
    (hfc : letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
     haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
     IsFutureComplete (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ),
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      ∀ x : d.Space, (d.toNat x).base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M →
        (Causal.minkowski 2).Jplus ⊤ {d.D x} ⊆ d.D '' d.causality.Jplus ⊤ {x} ∧
        (Causal.minkowski 2).Iplus ⊤ {d.D x} ⊆ d.D '' d.causality.Iplus ⊤ {x} := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hd x hx
  have htr := btzTilde_transport x₀ D ρ hpair d hd
  letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
  haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
  have hxR : (d.toNat x : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) ∈
      E0Bridge.regTilde (E0Bridge.basePt x₀) := by
    show (d.toNat x).base ∈ (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ
    exact fun h => h hx
  set z : E0Bridge.regTilde (E0Bridge.basePt x₀) := ⟨d.toNat x, hxR⟩ with hzdef
  set c := E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z with hcdef
  have hxc : d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c :
      MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))) = x := by
    rw [hcdef, Homeomorph.symm_apply_apply]; rfl
  have hDx : d.D x = D c := hd z
  have hDι : ∀ a, d.D (d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm a :
      MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)))) = D a := fun a => by
    show d.D (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm a :
      E0Bridge.regTilde (E0Bridge.basePt x₀)) : MaxBranchedCover (E0Bridge.sing M)
        (E0Bridge.basePt x₀)) = D a
    rw [hd, Homeomorph.apply_symm_apply]
  refine ⟨fun m hm => ?_, fun m hm => ?_⟩
  · rw [hDx, ← (hfc c).1] at hm
    obtain ⟨c', hc', rfl⟩ := hm
    have h1 := (htr c c').1 (Causal.Precausality.mem_Jplus_singleton.1 hc')
    rw [hxc] at h1
    have h2 : d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c' :
        MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))) ∈ d.causality.Jplus ⊤ {x} :=
      Causal.Precausality.mem_Jplus_singleton.2 h1
    exact ⟨_, h2, hDι c'⟩
  · rw [hDx, ← (hfc c).2] at hm
    obtain ⟨c', hc', rfl⟩ := hm
    have h1 := (htr c c').2 (Causal.Precausality.mem_Iplus_singleton.1 hc')
    rw [hxc] at h1
    have h2 : d.fromNat (((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c' :
        MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀))) ∈ d.causality.Iplus ⊤ {x} :=
      Causal.Precausality.mem_Iplus_singleton.2 h1
    exact ⟨_, h2, hDι c'⟩


attribute [local instance] btzE0Structure in
/-- **The reverse inclusions of DEC-118 (a) on all of `M̃`, given the null part at the BTZ
points**: with `Reg M̃` future complete, `I⁺(𝒟 x) ⊆ 𝒟(I⁺(x))` holds at EVERY `x` (a chart step
`x ≪ y`, `𝒟 y ≪ m` lands at a regular `y`, `BTZTildeData.Iplus_subset_reg`, where
`btzTilde_supset_of_reg` applies), and `J⁺(𝒟 x) ⊆ 𝒟(J⁺(x))` at every regular `x` and at every
`m ∈ I⁺(𝒟 x)`; the remaining points — `x` BTZ, `m ∈ J⁺(𝒟 x) ∖ I⁺(𝒟 x)` — are the hypothesis
`hnull` (`btzTilde_null_supset`). -/
theorem btzTilde_supset_of_null (x₀ : e0RegMFlat M)
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ)
    (hfc : letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
     haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
     IsFutureComplete (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ),
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      (∀ x : d.Space, (d.toNat x).base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M →
        ∀ m ∈ (Causal.minkowski 2).Jplus ⊤ {d.D x}, m ∉ (Causal.minkowski 2).Iplus ⊤ {d.D x} →
          m ∈ d.D '' d.causality.Jplus ⊤ {x}) →
      ∀ x : d.Space,
        (Causal.minkowski 2).Jplus ⊤ {d.D x} ⊆ d.D '' d.causality.Jplus ⊤ {x} ∧
        (Causal.minkowski 2).Iplus ⊤ {d.D x} ⊆ d.D '' d.causality.Iplus ⊤ {x} := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hd hnull x
  have hreg := btzTilde_supset_of_reg x₀ D ρ hpair hfc d hd
  have hI : ∀ x : d.Space,
      (Causal.minkowski 2).Iplus ⊤ {d.D x} ⊆ d.D '' d.causality.Iplus ⊤ {x} := fun x m hm => by
    have hm' := Causal.Precausality.mem_Iplus_singleton.1 hm
    obtain ⟨y, κ, -, -, -, -, -, hlt⟩ :=
      d.exists_chart_step x ((Causal.minkowski 2).le_of_lt hm')
    obtain ⟨hxy, hym⟩ := hlt hm'
    have hyR := d.Iplus_subset_reg x (Causal.Precausality.mem_Iplus_singleton.2 hxy)
    obtain ⟨y', hy', hDy'⟩ := (hreg y hyR).2 (Causal.Precausality.mem_Iplus_singleton.2 hym)
    have hy'' : d.causality.lt ⊤ y (d.fromNat y') :=
      (Causal.Precausality.mem_Iplus_singleton (M := d.Space)).1 hy'
    have h2 : (d.fromNat y') ∈ d.causality.Iplus ⊤ {x} :=
      Causal.Precausality.mem_Iplus_singleton.2 (d.causality.lt_trans hxy hy'')
    exact ⟨y', h2, hDy'⟩
  refine ⟨fun m hm => ?_, hI x⟩
  by_cases hx : (d.toNat x).base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M
  · exact (hreg x hx).1 hm
  by_cases hmI : m ∈ (Causal.minkowski 2).Iplus ⊤ {d.D x}
  · obtain ⟨y, hy, rfl⟩ := hI x hmI
    have hy' : d.causality.lt ⊤ x (d.fromNat y) :=
      (Causal.Precausality.mem_Iplus_singleton (M := d.Space)).1 hy
    have h2 : (d.fromNat y) ∈ d.causality.Jplus ⊤ {x} :=
      Causal.Precausality.mem_Jplus_singleton.2 (d.causality.le_of_lt hy')
    exact ⟨y, h2, rfl⟩
  exact hnull x (by simpa [Sing] using hx) m hm hmI

attribute [local instance] btzE0Structure in
/-- **The null part of `J⁺(𝒟 x)` at a BTZ point `x`** (the last step of
`prop:globally_hyperbolic_cauchy_complete_manifolds`, l.2352): for `x` a BTZ point of `M̃` and
`m ∈ J⁺(𝒟 x) ∖ I⁺(𝒟 x)`, `m ∈ 𝒟(J⁺(x))`. PROVED when `m = 𝒟 x`, and when the chart step from `x`
towards `m` (`BTZTildeData.exists_chart_step`) reaches a regular point (then
`btzTilde_supset_of_reg`) — i.e. whenever `m − 𝒟 x` is not along the developed BTZ line of `x`;
on the future half of the developed BTZ line of `x` by the lifted full future BTZ ray. The proof
(WP-47g) is `GX.futureRay_null_supset` (`GXScaffold.BTZ.FutureRay`, DEC-126), fed by
`btzTilde_supset_of_reg`. -/
theorem btzTilde_null_supset (_hGH : (CE M).GloballyHyperbolic)
    (_hmax : IsE0CauchyMaximal M) (x₀ : e0RegMFlat M)
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) (_hD : Injective D)
    (hfc : letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
     haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
     IsFutureComplete (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D)
    (_hrays : ∀ p ∈ S0 M, ∃ γ : ℝ → M, E0Spear.IsFullFutureBTZRay p γ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ}, (∀ e, orbitMk (GammaA (2 * Real.pi)) (Φ e) = e.base) →
      ∀ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, d.IsChartwise →
        (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
        ∀ x : d.Space, (d.toNat x).base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M →
          ∀ m ∈ (Causal.minkowski 2).Jplus ⊤ {d.D x}, m ∉ (Causal.minkowski 2).Iplus ⊤ {d.D x} →
            m ∈ d.D '' d.causality.Jplus ⊤ {x} := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ _hΦ d hch hd x hxs m hm hmI
  exact futureRay_null_supset _hrays d hch
    (fun y hy => (btzTilde_supset_of_reg x₀ D ρ hpair hfc d hd y hy).1) x hxs m hm hmI

end Transport

/-! ### §4g `prop:globally_hyperbolic_cauchy_complete_manifolds` in its ruled reading (DEC-118 (a))

« `M` future complete » (`def:manifold_future_complete_all`, l.2343) is read by DEC-118 (a) as
`BTZTildeData.IsBTZFutureComplete M d`: `D(J⁺(x)) = J⁺(D x)` and `D(I⁺(x)) = I⁺(D x)` for EVERY
`x ∈ M̃`, BTZ points included, for the chart-generated causality `BTZTildeData.causality`. The
proof's two steps (`btz_isFutureComplete_C1`: `Reg M̃` future complete, and full future BTZ rays
in `M`) do not give it for free — `J⁺` in `Reg M̃` is not `J⁺` in `M̃`.
`isBTZFutureComplete_of_regFuture` is the reduction « the two steps ⇒ DEC-118 (a) », whose
`⊆` halves are `lem:increasing_map` and whose `⊇` halves are §4g′ (`btzTilde_supset_of_null`, with the
null part at BTZ points `btzTilde_null_supset`, through `GX.futureRay_null_supset`). -/

attribute [local instance] btzE0Structure in
/-- **The proof's two steps give `M̃` future complete in DEC-118 (a)'s reading** (the last step of
`prop:globally_hyperbolic_cauchy_complete_manifolds`, l.2350–2352): for `M` globally hyperbolic and
Cauchy-maximal, a developing pair `(𝒟, ρ)` of `Reg M` with `𝒟` injective and `Reg M̃` future
complete (step (1)), full future BTZ rays from every BTZ point (step (2)), every presentation `Φ`,
and every chartwise datum `d` whose developing map is `𝒟` on `reg M̃`:
`BTZTildeData.IsBTZFutureComplete M d`. The inclusions `D(J⁺(x)) ⊆ J⁺(D x)`,
`D(I⁺(x)) ⊆ I⁺(D x)` are proved (`BTZTildeData.dev_image_Jplus_subset`/`_Iplus_subset`); the
reverse inclusions are `btzTilde_supset_of_null` (proved) with its null part at BTZ points
`btzTilde_null_supset` (proved, `GX.futureRay_null_supset`). -/
theorem isBTZFutureComplete_of_regFuture (hGH : (CE M).GloballyHyperbolic)
    (hmax : IsE0CauchyMaximal M) (x₀ : e0RegMFlat M)
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) (hD : Injective D)
    (hfc : letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
     haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
     IsFutureComplete (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D)
    (hrays : ∀ p ∈ S0 M, ∃ γ : ℝ → M, E0Spear.IsFullFutureBTZRay p γ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ}, (∀ e, orbitMk (GammaA (2 * Real.pi)) (Φ e) = e.base) →
      ∀ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, d.IsChartwise →
        (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
        BTZTildeData.IsBTZFutureComplete M d := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ hΦ d hch hd x
  have hsup := btzTilde_supset_of_null x₀ D ρ hpair hfc d hd
    (btzTilde_null_supset hGH hmax x₀ D ρ hpair hD hfc hrays hΦ d hch hd) x
  exact ⟨(d.dev_image_Jplus_subset x).antisymm hsup.1, (d.dev_image_Iplus_subset x).antisymm hsup.2⟩

attribute [local instance] btzE0Structure in
/-- **`prop:globally_hyperbolic_cauchy_complete_manifolds`, form of record** (gx l.2348; DEC-77's
corrected hypotheses, DEC-107's Cauchy-compact, DEC-118 (a)'s « future complete », DEC-106/118 (c)'s
`M̃`): for `M` a globally hyperbolic Cauchy-maximal `𝔼₀`-manifold with a compact `C¹` spacelike
Cauchy surface, a BTZ point and `π₁(Reg M)` not metabelian, every developing pair `(𝒟, ρ)` of
`Reg M` and every presentation `Φ` of `\widetilde{𝔼₀}`: the chartwise `M̃` extending `𝒟` exists,
and EVERY chartwise `M̃` extending `𝒟` is future complete,
`BTZTildeData.IsBTZFutureComplete M d` (the input `hfc` of
`BTZTildeData.injective_D_of_isBTZFutureComplete`). Through `isBTZFutureComplete_of_regFuture`
and `btz_isFutureComplete_C1`; 0 `sorry`, standard axioms. -/
theorem btz_isBTZFutureComplete_C1 (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S)
    (hmax : IsE0CauchyMaximal M) (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ}, (∀ e, orbitMk (GammaA (2 * Real.pi)) (Φ e) = e.base) →
      (∃ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, d.IsChartwise ∧
        ∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) ∧
      ∀ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, d.IsChartwise →
        (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
        BTZTildeData.IsBTZFutureComplete M d := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ hΦ
  have hU := btz_uniformization_C1 hGH hCC hmax hsing x₀ hnm D ρ hpair
  have hsteps := btz_isFutureComplete_C1 hGH hCC hmax hsing x₀ hnm D ρ hpair
  obtain ⟨d, hch, hd, -, -⟩ := (btz_uniformization_btzHalf hGH x₀ D ρ hpair hU.2.1 hΦ).1
  exact ⟨⟨d, hch, hd⟩, isBTZFutureComplete_of_regFuture hGH hmax x₀ D ρ hpair hU.2.1 hsteps.1
    hsteps.2 hΦ⟩

attribute [local instance] btzE0Structure in
/-- **`𝒟` injective on ALL of `M̃`** (the headline's first bullet at the BTZ points, l.2392–2394),
for every chartwise `M̃` extending `𝒟`: through `btz_isBTZFutureComplete_C1` (the prop) and
`BTZTildeData.injective_D_of_isBTZFutureComplete`;
its hypothesis « every `I⁺(x)` is regular » (B21: a BTZ point is in the chronological future of
nothing) is PROVED, `BTZTildeData.Iplus_subset_reg` (fixer round 2; it was carried before). -/
theorem btz_injective_dev_C1 (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S)
    (hmax : IsE0CauchyMaximal M) (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ}, (∀ e, orbitMk (GammaA (2 * Real.pi)) (Φ e) = e.base) →
      ∀ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, d.IsChartwise →
        (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
        Injective d.D := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ hΦ d hch hd
  have hU := btz_uniformization_C1 hGH hCC hmax hsing x₀ hnm D ρ hpair
  have hG : (e0ManifoldCausality M E0Bridge.isBTZSingModelled_e0).GloballyHyperbolic :=
    E0Bridge.globallyHyperbolic_e0ManifoldCausality_iff.2 hGH
  have hfc := (btz_isBTZFutureComplete_C1 hGH hCC hmax hsing x₀ hnm D ρ hpair hΦ).2 d hch hd
  refine d.injective_D_of_isBTZFutureComplete E0Bridge.isBTZSingModelled_e0 hG hfc ?_
    d.Iplus_subset_reg
  intro a ha b hb hab
  have ha' : a ∈ E0Bridge.regTilde (E0Bridge.basePt x₀) := by
    show a.base ∈ (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ
    exact fun h => h ha
  have hb' : b ∈ E0Bridge.regTilde (E0Bridge.basePt x₀) := by
    show b.base ∈ (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ
    exact fun h => h hb
  have h1 := hd ⟨a, ha'⟩
  have h2 := hd ⟨b, hb'⟩
  simp only at h1 h2
  rw [h1, h2] at hab
  exact congrArg Subtype.val ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).injective (hU.2.1 hab))

/-! ### §4h The BTZ assertions of the headline (WP-47g)

The headline's bullets at the BTZ points (l.2366–2375, proof l.2382–2397), on ONE chartwise datum
with tamifying `T_BTZ` (`btzTilde_exists_tamifying_extending`): the deck group of `M̃ → M` acts
through the holonomy at the BTZ points too (`btzTildeDeckConj`, `btzTilde_dev_deck`); the developed
BTZ points above a BTZ point are a future null half-line (`btzTilde_sing_inter_Jplus`, through
`GXScaffold.BTZ.FutureRay`), with a BTZ point strictly below on the same line
(`btzTilde_exists_sing_below`); the rays `Δₓ` (`btzTildeDelta`) are carried onto one another by
`ρ(Γ)` (`btzTildeDelta_smul`) and lie in `∂Ω⁺` (`btzTilde_dev_mem_closure`); and
`M ≅ ρ(Γ)\𝒟(M̃)` (`btzTilde_quotient_homeomorph`, through GX's `quotient_virtually_tame`). The
assembly is `btz_uniformization_btzRays`. -/

section S47h

open Filter Topology



attribute [local instance] btzE0Structure in
theorem btzTilde_exists_tamifying_extending (x₀ : e0RegMFlat M)
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ}, (∀ e, orbitMk (GammaA (2 * Real.pi)) (Φ e) = e.base) →
      ∃ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, d.IsChartwise ∧
        IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) M (E0Bridge.basePt x₀)
          d.T'.top ∧
        ∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z) := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ hΦ
  obtain ⟨T, hT, hreg, hch⟩ := btz_manifold_exists_chartwise_tamifying_reg
    E0Bridge.isBTZSingModelled_e0 (E0Bridge.basePt x₀) yN Φ hΦ
  obtain ⟨D0, hDc, hDr⟩ := hT.exists_extension
  let d0 : BTZTildeData M (E0Bridge.basePt x₀) Φ := ⟨⟨T⟩, hT.le_natural, hreg, D0, hDc, hDr,
    isLocallyBTZTilde_of_chartwise E0Bridge.isBTZSingModelled_e0 hΦ ⟨T⟩ hT hch hDc hDr, hΦ⟩
  obtain ⟨d, hTd, hd⟩ := E0Bridge.exists_btzTildeData_extending (E0Bridge.basePt x₀) d0 hpair
  have hch' : d.IsChartwise := by
    unfold BTZTildeData.IsChartwise
    rw [hTd]
    exact hch
  refine ⟨d, hch', ?_, hd⟩
  rw [hTd]
  exact hT



/-- The conjugate by `E0Bridge.regTildeHomeo` of the restriction to `reg M̃` of a deck
transformation of `M̃ → M`: a deck transformation of the universal cover of `Reg M`. -/
noncomputable def btzTildeDeckConj (x₀ : e0RegMFlat M)
    (φ : Deck (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M)) :
    Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) :=
  ⟨(E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm.trans
    (((deckRestrict _ (E0Bridge.sing M)ᶜ φ : Deck _) :
      (SpreadEnd.base ⁻¹' (E0Bridge.sing M)ᶜ : Set (MaxBranchedCover (E0Bridge.sing M)
        (E0Bridge.basePt x₀))) ≃ₜ _).trans (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀))), by
    funext c
    apply Subtype.ext
    have h1 := E0Bridge.proj_regTildeHomeo (E0Bridge.basePt x₀)
      (((deckRestrict _ (E0Bridge.sing M)ᶜ φ : Deck _) :
        (SpreadEnd.base ⁻¹' (E0Bridge.sing M)ᶜ : Set (MaxBranchedCover (E0Bridge.sing M)
          (E0Bridge.basePt x₀))) ≃ₜ _) ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c))
    have h2 := E0Bridge.proj_regTildeHomeo (E0Bridge.basePt x₀)
      ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c)
    rw [Homeomorph.apply_symm_apply] at h2
    rw [deckRestrict_apply, deck_apply _ φ.2] at h1
    exact h1.trans h2.symm⟩

theorem btzTildeDeckConj_apply (x₀ : e0RegMFlat M)
    (φ : Deck (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M))
    (z : E0Bridge.regTilde (E0Bridge.basePt x₀)) :
    (btzTildeDeckConj x₀ φ).1 (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z) =
      E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)
        ⟨φ.1 z, by
          show SpreadEnd.base (φ.1 (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)))
            ∈ (E0Bridge.sing M)ᶜ
          rw [deck_apply _ φ.2]; exact z.2⟩ := by
  show E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) (((deckRestrict _ (E0Bridge.sing M)ᶜ φ : Deck _) :
      (SpreadEnd.base ⁻¹' (E0Bridge.sing M)ᶜ : Set (MaxBranchedCover (E0Bridge.sing M)
        (E0Bridge.basePt x₀))) ≃ₜ _)
      ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm
        (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z))) = _
  rw [Homeomorph.symm_apply_apply]
  rfl



theorem btzTildeDeckConj_surjective (x₀ : e0RegMFlat M) :
    Surjective (btzTildeDeckConj (M := M) x₀) := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro δ
  set R := E0Bridge.regTildeHomeo (M := M) (E0Bridge.basePt x₀) with hR
  set ψh : (SpreadEnd.base ⁻¹' (E0Bridge.sing M)ᶜ : Set (MaxBranchedCover (E0Bridge.sing M)
      (E0Bridge.basePt x₀))) ≃ₜ _ := R.trans (δ.1.trans R.symm) with hψh
  have hψ : ψh ∈ deckGroup ((E0Bridge.sing M)ᶜ.restrictPreimage
      (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M)) := by
    funext z
    apply Subtype.ext
    show SpreadEnd.base (R.symm (δ.1 (R z)) : MaxBranchedCover (E0Bridge.sing M)
      (E0Bridge.basePt x₀)) = SpreadEnd.base (z : MaxBranchedCover (E0Bridge.sing M)
      (E0Bridge.basePt x₀))
    have h1 := E0Bridge.proj_regTildeHomeo (M := M) (E0Bridge.basePt x₀) (R.symm (δ.1 (R z)))
    have h2 := E0Bridge.proj_regTildeHomeo (M := M) (E0Bridge.basePt x₀) z
    rw [← hR, Homeomorph.apply_symm_apply] at h1
    rw [← hR] at h2
    rw [← h1, ← h2]
    have h3 := congrFun δ.2 (R z)
    simp only [Function.comp_apply] at h3
    show E0Bridge.flatVal _ = E0Bridge.flatVal _
    exact congrArg E0Bridge.flatVal h3
  have hbc := (E0Bridge.maxBranched_basic_e0 (M := M) (E0Bridge.basePt x₀)).2.1
  have hU : IsPortly ((E0Bridge.sing M)ᶜ : Set M) := by
    rw [E0Bridge.compl_sing_eq]; exact E0Bridge.isPortly_e0RegM
  obtain ⟨φ, hφ⟩ := exists_deck_extend hbc hU ⟨ψh, hψ⟩
  refine ⟨φ, Subtype.ext (Homeomorph.ext fun c => ?_)⟩
  obtain ⟨z, rfl⟩ := R.surjective c
  rw [btzTildeDeckConj_apply]
  have h := congrArg (fun θ : Deck ((E0Bridge.sing M)ᶜ.restrictPreimage
      (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M)) =>
      (θ.1 z)) hφ
  simp only at h
  have h' : (⟨φ.1 z, _⟩ : E0Bridge.regTilde (E0Bridge.basePt x₀)) = R.symm (δ.1 (R z)) :=
    Subtype.ext (congrArg Subtype.val h)
  show R _ = δ.1 (R z)
  rw [h', Homeomorph.apply_symm_apply]

attribute [local instance] btzE0Structure in
/-- **`𝒟` is equivariant at the BTZ points too**: for the extension `d.D` of a developing pair
`(𝒟, ρ)` to `M̃` with a tamifying `T_BTZ`, every deck transformation `φ` of `M̃ → M` satisfies
`d.D ∘ φ = ρ(φ') • d.D` on ALL of `M̃`, `φ'` its conjugate on the universal cover of `Reg M`:
on `reg M̃` by the developing pair, at the BTZ points by `T_BTZ`-density of `reg M̃` and
`T_BTZ`-continuity of `φ` and `d.D`. -/
theorem btzTilde_dev_deck (x₀ : e0RegMFlat M)
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ),
      IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) M (E0Bridge.basePt x₀)
          d.T'.top →
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      ∀ (φ : Deck (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M))
        (e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)),
        d.D (φ.1 e) = ρ (btzTildeDeckConj x₀ φ) • d.D e := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hT hd φ
  have hreg : ∀ e ∈ E0Bridge.regTilde (E0Bridge.basePt x₀),
      d.D (φ.1 e) = ρ (btzTildeDeckConj x₀ φ) • d.D e := by
    intro e he
    have h1 := hd ⟨e, he⟩
    have h2 := hd ⟨φ.1 e, by
      show SpreadEnd.base (φ.1 e) ∈ (E0Bridge.sing M)ᶜ
      rw [deck_apply _ φ.2]; exact he⟩
    simp only at h1 h2
    rw [h2, h1, ← hpair.equiv, btzTildeDeckConj_apply]
  have hdense : Dense (d.toNat ⁻¹' E0Bridge.regTilde (E0Bridge.basePt x₀)) := by
    have h := @IsPortly.dense _ d.T'.top _ hT.isPortly
    have hRS : Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M = (E0Bridge.sing M)ᶜ := by
      rw [E0Bridge.compl_sing_eq, E0Bridge.reg_e0SingularGXStructure]
    rw [hRS] at h
    exact h
  have hφc : Continuous[d.T'.top, d.T'.top] φ.1 := hT.continuous_deck _ ⟨φ.1, φ.2, rfl⟩
  have hc1 : Continuous (fun e : d.Space => d.D (φ.1 (d.toNat e))) :=
    @Continuous.comp _ _ _ d.T'.top d.T'.top _ _ _ d.continuous_D hφc
  have hc2 : Continuous (fun e : d.Space => ρ (btzTildeDeckConj x₀ φ) • d.D (d.toNat e)) :=
    @Continuous.comp _ _ _ d.T'.top _ _ _ _ (continuous_const_smul _) d.continuous_D
  intro e
  exact congrFun (Continuous.ext_on hdense hc1 hc2 fun e he => hreg e he) (d.fromNat e)

/-- The orbit relation of a subgroup `H ≤ G` on a subset `A` of a `G`-set (used for `ρ(Γ)` acting
on `𝒟(M̃)`; the relation need not preserve `A`, only relate points of it). -/
def btzRangeOrbitSetoid {G X : Type*} [Group G] [MulAction G X] (H : Subgroup G) (A : Set X) :
    Setoid A where
  r a b := ∃ g ∈ H, g • (a : X) = b
  iseqv := ⟨fun a => ⟨1, H.one_mem, one_smul _ _⟩,
    fun ⟨g, hg, h⟩ => ⟨g⁻¹, H.inv_mem hg, by rw [← h, inv_smul_smul]⟩,
    fun ⟨g, hg, h⟩ ⟨k, hk, h'⟩ => ⟨k * g, H.mul_mem hk hg, by rw [mul_smul, h, h']⟩⟩

/-- A continuous open surjection whose fibres are the classes of a setoid is a homeomorphism from
the quotient. -/
theorem btz_exists_homeomorph_quotient {A B : Type*} [TopologicalSpace A] [TopologicalSpace B]
    (s : Setoid A) {f : A → B} (hfc : Continuous f) (hfo : IsOpenMap f) (hfs : Surjective f)
    (hfib : ∀ a a', f a = f a' ↔ s a a') :
    ∃ h : Quotient s ≃ₜ B, ∀ a, h (Quotient.mk s a) = f a := by
  have hresp : ∀ a a', s a a' → f a = f a' := fun a a' h => (hfib a a').2 h
  set F : Quotient s → B := Quotient.lift f hresp
  have hFc : Continuous F := hfc.quotient_lift hresp
  have hFi : Injective F := by
    rintro ⟨a⟩ ⟨a'⟩ h
    exact Quotient.sound ((hfib a a').1 h)
  have hFs : Surjective F := fun b => by
    obtain ⟨a, rfl⟩ := hfs b
    exact ⟨Quotient.mk s a, rfl⟩
  have hFo : IsOpenMap F := fun O hO => by
    have : F '' O = f '' (Quotient.mk s ⁻¹' O) := by
      ext b
      constructor
      · rintro ⟨q, hq, rfl⟩
        induction q using Quotient.inductionOn with
        | h a => exact ⟨a, hq, rfl⟩
      · rintro ⟨a, ha, rfl⟩
        exact ⟨Quotient.mk s a, ha, rfl⟩
    rw [this]
    exact hfo _ (hO.preimage continuous_quotient_mk')
  exact ⟨(Equiv.ofBijective F ⟨hFi, hFs⟩).toHomeomorphOfContinuousOpen hFc hFo, fun _ => rfl⟩

/-- **A homeomorphism onto a singular manifold is an a.e. isomorphism for the pulled-back
structure, and that structure is the quotient one** (the pattern of
`GX.tamely_singular_manifold_admits_aeIso`, for a GIVEN homeomorphism): for a branched covering
`p : N → M` of a singular `(G,X)`-manifold, `N` with `p^*B_M` (`prop:singular_manifold_branched_covering`),
a homeomorphism `h : Q ≃ₜ M` and a map `π : N → Q` with `h ∘ π = p`, the pullback `h^*B_M` is a
maximal a.e. atlas for which `h` and `h⁻¹` are a.e. `(G,X)`-morphisms, `π` is an a.e. morphism, and
`h^*B_M` is the UNIQUE maximal a.e. atlas on `Q` making `π` one. -/
theorem btz_aeIso_of_homeomorph_comp {G X N M Q : Type*} [TopologicalSpace X] [Group G]
    [MulAction G X] [ContinuousConstSMul G X] [LocallyConnectedSpace X] [T2Space X]
    [IsRigidAction G X] [TopologicalSpace N] [TopologicalSpace M] [TopologicalSpace Q] [T1Space M]
    [LocPathConnectedSpace M] [FirstCountableTopology M] [SingularGXStructure G X M]
    {p : N → M} (hp : IsBranchedCovering p) (h : Q ≃ₜ M) {π : N → Q}
    (hπ : ∀ e, h (π e) = p e) :
    IsMaximalAEAtlas G (aePullback G (aeAtlas G X M) p) ∧
    IsMaximalAEAtlas G (aePullback G (aeAtlas G X M) h) ∧
    IsAEMorphismOf G (aePullback G (aeAtlas G X M) h) (aeAtlas G X M) h ∧
    IsAEMorphismOf G (aeAtlas G X M) (aePullback G (aeAtlas G X M) h) h.symm ∧
    IsAEMorphismOf G (aePullback G (aeAtlas G X M) p) (aePullback G (aeAtlas G X M) h) π ∧
    ∀ B : Set (OpenPartialHomeomorph Q X), IsMaximalAEAtlas G B →
      IsAEMorphismOf G (aePullback G (aeAtlas G X M) p) B π →
      B = aePullback G (aeAtlas G X M) h := by
  haveI := hp.isSpread.locallyConnectedSpace
  have hπe : π = h.symm ∘ p := funext fun e => by
    show π e = h.symm (p e)
    rw [← hπ e, h.symm_apply_apply]
  have hBM := isMaximalAEAtlas_aeAtlas G X M
  have hN := singular_manifold_branched_covering hp hBM
  have hloc : IsAELocalHomeomorph (aeAtlas G X M) h := by
    refine ⟨h ⁻¹' Reg G X M, Reg G X M, ?_, isPortly_reg G X M, subset_rfl, fun _ hx => hx,
      h.isLocalHomeomorph.isLocalHomeomorphOn⟩
    rw [← h.image_symm]
    exact (isPortly_reg G X M).image_of_isOpenMap h.symm.continuous h.symm.isOpenMap
      h.symm.surjective
  have hspec := aePullback_spec_of_isAELocalHomeomorph hBM.1 h.continuous hloc
  have hsymm : IsAEMorphismOf G (aeAtlas G X M) (aePullback G (aeAtlas G X M) h) h.symm :=
    IsAEMorphismOf.symm_of_homeomorph hspec.1 hBM hspec.2
  have hπm : IsAEMorphismOf G (aePullback G (aeAtlas G X M) p) (aePullback G (aeAtlas G X M) h)
      π := by
    rw [hπe]; exact hsymm.comp hN.2.1
  have hπo : IsOpenMap π := by
    rw [hπe]; exact h.symm.isOpenMap.comp (spread_connected_image hp).1
  have hπs : Surjective π := by
    rw [hπe]; exact h.symm.surjective.comp hp.surjective
  exact ⟨hN.1, hspec.1, hspec.2, hsymm, hπm, fun B hB hBπ =>
    IsAEMorphismOf.eq_of_isMaximalAEAtlas_right hB hspec.1 hπo hπs hBπ hπm⟩

attribute [local instance] btzE0Structure in
/-- **`M ≅ ρ\𝒟(M̃)`** (the headline's last bullet, l.2374–2375 and l.2395–2397): for the
extension `d.D` of a developing pair `(𝒟, ρ)` to `M̃` with a tamifying `T_BTZ`, injective on
`M̃`, the map `𝒟(e) ↦ p(e)` is a homeomorphism `ρ(Γ)\𝒟(M̃) ≃ₜ M`, `𝒟(M̃)` carrying the topology
generated by that of `𝐌³` and the `𝒟`-images of `T_BTZ`-open sets (`devImageTop`, which IS
`defi:BTZtop` near the rays, `btzRangeTop_eq_devImageTop`; the form with `btzRangeTop` is
`btzTilde_quotient_homeomorph_btzTop`), `ρ(Γ)` acting by its orbits. -/
theorem btzTilde_quotient_homeomorph (x₀ : e0RegMFlat M)
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ),
      IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) M (E0Bridge.basePt x₀)
          d.T'.top →
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      Injective d.D →
      letI := @devImageTop _ (Causal.Minkowski 2) d.T'.top _ d.D
      ∃ h : Quotient (btzRangeOrbitSetoid ρ.range (range d.D)) ≃ₜ M,
        ∀ e, h (Quotient.mk _ (rangeFactorization d.D e)) = e.base := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hT hd hinj
  have hgal := btz_manifold_isGaloisian (M := M) E0Bridge.isBTZSingModelled_e0
    (E0Bridge.basePt x₀)
  have hdeck := btzTilde_dev_deck x₀ hpair d hT hd
  classical
  let ρ' : (MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) →
      MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) → Causal.Flat.isom 2 :=
    fun f => if h : ∃ φ : Deck (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M)
        (E0Bridge.basePt x₀) → M), ⇑φ.1 = f then ρ (btzTildeDeckConj x₀ h.choose) else 1
  have hρ' : ∀ γ ∈ deckMapsMax (Causal.Flat.isom 2) (Causal.Minkowski 2) M (E0Bridge.basePt x₀),
      ∀ e, d.D (γ e) = ρ' γ • d.D e ∧ ρ' γ ∈ ρ.range := by
    rintro γ ⟨φ, hφ, rfl⟩ e
    have hex : ∃ φ' : Deck (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M)
        (E0Bridge.basePt x₀) → M), ⇑φ'.1 = ⇑φ := ⟨⟨φ, hφ⟩, rfl⟩
    have hρ'γ : ρ' φ = ρ (btzTildeDeckConj x₀ hex.choose) := dif_pos hex
    refine ⟨?_, ⟨_, hρ'γ.symm⟩⟩
    rw [hρ'γ, ← hdeck, hex.choose_spec]
  obtain ⟨f, hfc, hfo, hfs, hfe, hfib⟩ := quotient_virtually_tame (E0Bridge.basePt x₀) hgal hT
    d.continuous_D hinj ρ' fun γ hγ e => (hρ' γ hγ e).1
  letI := @devImageTop _ (Causal.Minkowski 2) d.T'.top _ d.D
  have hfib' : ∀ a a' : range d.D, f a = f a' ↔ btzRangeOrbitSetoid ρ.range (range d.D) a a' := by
    intro a a'
    rw [hfib]
    constructor
    · rintro ⟨γ, hγ, h⟩
      obtain ⟨e, he⟩ := a.2
      exact ⟨ρ' γ, (hρ' γ hγ e).2, h⟩
    · rintro ⟨g, ⟨δ, rfl⟩, h⟩
      obtain ⟨φ, rfl⟩ := btzTildeDeckConj_surjective x₀ δ
      obtain ⟨e, he⟩ := a.2
      have hγ : ⇑φ.1 ∈ deckMapsMax (Causal.Flat.isom 2) (Causal.Minkowski 2) M
          (E0Bridge.basePt x₀) := ⟨φ.1, φ.2, rfl⟩
      refine ⟨⇑φ.1, hγ, ?_⟩
      rw [← h, ← he, ← (hρ' _ hγ e).1, hdeck]
  obtain ⟨h, hh⟩ := btz_exists_homeomorph_quotient
    (btzRangeOrbitSetoid ρ.range (range d.D)) hfc hfo hfs hfib'
  exact ⟨h, fun e => (hh _).trans (hfe e)⟩

attribute [local instance] btzE0Structure in
/-- **`M ≅ ρ\𝒟(M̃)` with `defi:BTZtop` on `𝒟(M̃)`** (the headline's last bullet as printed,
l.2373–2375: « endowing `D(M̃)` with the BTZ topology in the neighborhood of the lightlike rays »):
`btzTilde_quotient_homeomorph` with `𝒟(M̃)` carrying `btzRangeTop` — generated by the topology
induced by `𝐌³` and the sets `I⁺(p) ∪ ]p, +∞[`, `p ∈ ⋃ Δₓ` — through its identification with
`devImageTop` (`BTZTildeData.btzRangeTop_eq_devImageTop`, l.2390–2395). -/
theorem btzTilde_quotient_homeomorph_btzTop (x₀ : e0RegMFlat M)
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ),
      IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) M (E0Bridge.basePt x₀)
          d.T'.top →
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      Injective d.D →
      (∀ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
          ∃ u : Causal.Minkowski 2, Causal.Flat.IsFutureCausal u ∧ Causal.Flat.minkQ u = 0 ∧
            u ≠ 0 ∧ btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2)
              (Causal.Minkowski 2) M} x = {m | ∃ lam : ℝ, 0 < lam ∧ m = d.D x + lam • u}) →
      letI := btzRangeTop d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M}
      ∃ h : Quotient (btzRangeOrbitSetoid ρ.range (range d.D)) ≃ₜ M,
        ∀ e, h (Quotient.mk _ (rangeFactorization d.D e)) = e.base := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hT hd hinj hray
  have key := btzTilde_quotient_homeomorph x₀ hpair d hT hd hinj
  rw [← d.btzRangeTop_eq_devImageTop hinj hray] at key
  exact key

attribute [local instance] btzE0Structure in
/-- **The two halves of « isomorphism » agree** (l.2374, l.2397): any map
`h : ρ(Γ)\𝒟(M̃) → M` with `h [𝒟 e] = p(e)` restricts on the regular classes to the inverse of any
isometry `f : Reg M ≅ B` onto a presentation `π : Ω⁺ → B` of `ρ(Γ)\Ω⁺` induced by `𝒟`
(`f ∘ p = π ∘ 𝒟`): `h [m] = f⁻¹(π m)` for `m = 𝒟 e ∈ Ω⁺`, `e` regular (`E0Bridge.proj_regTildeHomeo`). -/
theorem btzTilde_quotient_compat (x₀ : e0RegMFlat M)
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2} :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ),
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      ∀ h : Quotient (btzRangeOrbitSetoid ρ.range (range d.D)) → M,
      (∀ e, h (Quotient.mk _ (rangeFactorization d.D e)) = e.base) →
      ∀ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B)
        (f : e0RegMFlat M ≃ₜ B),
      (∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
          f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩) →
      ∀ e ∈ E0Bridge.regTilde (E0Bridge.basePt x₀),
      ∀ hm : d.D e ∈ Causal.Flat.limitOpensPlus ρ.range,
        E0Bridge.flatVal (f.symm (π ⟨d.D e, hm⟩)) =
          h (Quotient.mk _ (rangeFactorization d.D e)) := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hd h hh B π f hf e he hm
  set z := E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) ⟨e, he⟩ with hzdef
  have h1 : d.D e = D z := hd ⟨e, he⟩
  have hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range := h1 ▸ hm
  have h2 : (⟨d.D e, hm⟩ : Causal.Flat.limitOpensPlus ρ.range) = ⟨D z, hz⟩ := Subtype.ext h1
  rw [hh e, h2, ← hf z hz, Homeomorph.symm_apply_apply]
  exact E0Bridge.proj_regTildeHomeo (E0Bridge.basePt x₀) ⟨e, he⟩

attribute [local instance] btzE0Structure in
/-- **`M ≅ ρ\𝒟(M̃)` as singular `𝐄^{1,2}`-manifolds** (the headline's last bullet in full,
l.2373–2375 and the proof's l.2397 « isomorphism of singular E-manifolds »; the reading of the
twins `prop:quotient_chart` = `GX.btz_quotient_chart` and `rem:tamely_singular_manifold_admits` =
`GX.tamely_singular_manifold_admits_aeIso`): `𝒟(M̃)` with `defi:BTZtop` near the rays
(`btzRangeTop`), `ρ(Γ)\𝒟(M̃)` with the quotient topology, `M̃` (natural topology, DEC-106) with the
structure `p^*B_M` of `prop:singular_manifold_branched_covering` (maximal), there is a homeomorphism
`h : ρ(Γ)\𝒟(M̃) ≃ₜ M`, `[𝒟 e] ↦ p(e)`, agreeing on the regular classes with every isometry
`Reg M ≅ ρ(Γ)\Ω⁺` induced by `𝒟`, such that `ρ(Γ)\𝒟(M̃)` carries a maximal a.e.
`(Isom 𝐌³, 𝐌³)`-atlas (`h^*B_M`) for which
* `h` and `h⁻¹` are a.e. `(G,X)`-morphisms (an a.e. isomorphism),
* the projection `M̃ → ρ(Γ)\𝒟(M̃)`, `e ↦ [𝒟 e]`, is an a.e. morphism,
* and it is the UNIQUE maximal a.e. atlas on `ρ(Γ)\𝒟(M̃)` making that projection an a.e.
  morphism (the quotient structure, as in `prop:aeGXquotient`). -/
theorem btzTilde_quotient_aeIso (x₀ : e0RegMFlat M)
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ),
      IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) M (E0Bridge.basePt x₀)
          d.T'.top →
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      Injective d.D →
      (∀ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
          ∃ u : Causal.Minkowski 2, Causal.Flat.IsFutureCausal u ∧ Causal.Flat.minkQ u = 0 ∧
            u ≠ 0 ∧ btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2)
              (Causal.Minkowski 2) M} x = {m | ∃ lam : ℝ, 0 < lam ∧ m = d.D x + lam • u}) →
      letI := btzRangeTop d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M}
      ∃ h : Quotient (btzRangeOrbitSetoid ρ.range (range d.D)) ≃ₜ M,
        (∀ e, h (Quotient.mk _ (rangeFactorization d.D e)) = e.base) ∧
        (∀ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B)
            (f : e0RegMFlat M ≃ₜ B),
          (∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
              f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩) →
          ∀ e ∈ E0Bridge.regTilde (E0Bridge.basePt x₀),
          ∀ hm : d.D e ∈ Causal.Flat.limitOpensPlus ρ.range,
            E0Bridge.flatVal (f.symm (π ⟨d.D e, hm⟩)) =
              h (Quotient.mk _ (rangeFactorization d.D e))) ∧
        IsMaximalAEAtlas (Causal.Flat.isom 2)
          (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
            (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M)) ∧
        IsMaximalAEAtlas (Causal.Flat.isom 2)
          (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) h) ∧
        IsAEMorphismOf (Causal.Flat.isom 2)
          (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) h)
          (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) h ∧
        IsAEMorphismOf (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
          (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) h)
          h.symm ∧
        IsAEMorphismOf (Causal.Flat.isom 2)
          (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
            (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M))
          (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) h)
          (fun e => Quotient.mk _ (rangeFactorization d.D e)) ∧
        ∀ B : Set (OpenPartialHomeomorph (Quotient (btzRangeOrbitSetoid ρ.range (range d.D)))
            (Causal.Minkowski 2)), IsMaximalAEAtlas (Causal.Flat.isom 2) B →
          IsAEMorphismOf (Causal.Flat.isom 2)
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M)) B
            (fun e => Quotient.mk _ (rangeFactorization d.D e)) →
          B = aePullback (Causal.Flat.isom 2)
            (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) h := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hT hd hinj hray
  letI := btzRangeTop d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M}
  obtain ⟨h, hh⟩ := btzTilde_quotient_homeomorph_btzTop x₀ hpair d hT hd hinj hray
  have hbc := (E0Bridge.maxBranched_basic_e0 (M := M) (E0Bridge.basePt x₀)).2.1
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := btz_aeIso_of_homeomorph_comp (G := Causal.Flat.isom 2)
    (X := Causal.Minkowski 2) hbc h hh
  exact ⟨h, hh, btzTilde_quotient_compat x₀ d hd h hh, h1, h2, h3, h4, h5, h6⟩

attribute [local instance] btzE0Structure in
/-- **The developed BTZ points above a BTZ point are a future null half-line**: for the
extension `d.D` of an injective developing pair `(𝒟, ρ)` with `Reg M̃` future complete, injective
on `M̃`, and a BTZ point `x` of the chartwise `M̃`, there is a future null `u ≠ 0` with
`𝒟(sing M̃) ∩ J⁺(𝒟 x) = 𝒟 x + ℝ₊ u` (`futureRay_halfLine`, and off the half-line a regular
`y ≥ x` whose future `J⁺(𝒟 y) = 𝒟(J⁺ y)` lies in `𝒟(Reg M̃)`, which meets no developed BTZ
point by injectivity). -/
theorem btzTilde_sing_inter_Jplus (x₀ : e0RegMFlat M)
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2}
    (hfc : letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
     haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
     IsFutureComplete (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D)
    (hrays : ∀ p ∈ S0 M, ∃ γ : ℝ → M, E0Spear.IsFullFutureBTZRay p γ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ), d.IsChartwise →
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      Injective d.D →
      ∀ x : d.Space, (d.toNat x).base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M →
        ∃ u : Causal.Minkowski 2, Causal.Flat.IsFutureCausal u ∧ Causal.Flat.minkQ u = 0 ∧
          u ≠ 0 ∧
          d.D '' {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} ∩
            (Causal.minkowski 2).Jplus ⊤ {d.D x} = {m | ∃ lam : ℝ, 0 ≤ lam ∧ m = d.D x + lam • u} := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hch hd hinj x hx
  obtain ⟨γ, hγ, u, hu₁, hu₂, hu₃, hhalf, hoff⟩ := futureRay_halfLine hrays d hch x hx
  refine ⟨u, hu₁, hu₂, hu₃, Set.Subset.antisymm ?_ ?_⟩
  · rintro m ⟨⟨e, he, rfl⟩, hm⟩
    have hm' := Causal.Precausality.mem_Jplus_singleton.1 hm
    rcases hoff _ hm' with hl | ⟨y, hyR, -, hym⟩
    · exact hl
    exfalso
    have hyT : d.toNat y ∈ E0Bridge.regTilde (E0Bridge.basePt x₀) := fun h => h hyR
    have h1 := hd ⟨d.toNat y, hyT⟩
    simp only at h1
    have h2 := (Set.ext_iff.1 (hfc (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)
      ⟨d.toNat y, hyT⟩)).1 (d.D e)).2 (by
        rw [← h1]; exact Causal.Precausality.mem_Jplus_singleton.2 hym)
    obtain ⟨c, -, hc⟩ := h2
    have h3 := hd ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c)
    rw [Homeomorph.apply_symm_apply, hc] at h3
    have h4 := hinj h3
    have h5 := ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c).2
    rw [h4] at h5
    exact h5 he
  · rintro m ⟨lam, hlam, rfl⟩
    obtain ⟨z, hxz, hzb, hzD⟩ := hhalf lam hlam
    refine ⟨⟨d.toNat z, ?_, hzD⟩, ?_⟩
    · show (d.toNat z).base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M
      rw [hzb]
      exact (Set.ext_iff.1 (E0Bridge.sing_e0SingularGXStructure (M := M)) _).2
        (hγ.mem_S0 (by linarith))
    · rw [← hzD]
      refine Causal.Precausality.mem_Jplus_singleton.2 ?_
      by_cases hzx : x = z
      · subst hzx; exact (Causal.minkowski 2).le_refl trivial
      · exact (d.increasing hxz hzx).1

attribute [local instance] btzE0Structure in
/-- A point of `M̃` in the causal future of a REGULAR point, for `d.D` injective and extending a
developing pair whose `Reg M̃` is future complete, is regular: its image lies in
`J⁺(𝒟 y) = 𝒟(J⁺ y) ⊆ 𝒟(Reg M̃)`. -/
theorem btzTilde_not_sing_of_le_reg (x₀ : e0RegMFlat M)
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2}
    (hfc : letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
     haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
     IsFutureComplete (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ),
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      Injective d.D →
      ∀ y e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀),
        y.base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M →
        (Causal.minkowski 2).le ⊤ (d.D y) (d.D e) →
        e.base ∉ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hd hinj y e hyR hym he
  have hyT : y ∈ E0Bridge.regTilde (E0Bridge.basePt x₀) := fun h => h hyR
  have h1 := hd ⟨y, hyT⟩
  simp only at h1
  have h2 := (Set.ext_iff.1 (hfc (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)
    ⟨y, hyT⟩)).1 (d.D e)).2 (by
      rw [← h1]; exact Causal.Precausality.mem_Jplus_singleton.2 hym)
  obtain ⟨c, -, hc⟩ := h2
  have h3 := hd ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c)
  rw [Homeomorph.apply_symm_apply, hc] at h3
  have h4 := hinj h3
  have h5 := ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c).2
  rw [h4] at h5
  exact h5 he

attribute [local instance] btzE0Structure in
/-- **Every BTZ point of `M̃` has a BTZ point strictly below it on its developed line** (the rays
`Δᵢ` are relatively open, l.2385–2386: « `S_x` is a totally ordered relatively open future half
line »): through ONE descending chart along the full future BTZ ray of `p(x)` started slightly
in the past of `p(x)` (`futureRay_exists_chart`, the domain of the ray's morphism being open), and
its lift at `x` (`exists_liftedChart_of_isChartwise`), whose developing map is `g · btzDevM` on the
lifted axis; the lower point is BTZ by `btzTilde_not_sing_of_le_reg`. -/
theorem btzTilde_exists_sing_below (x₀ : e0RegMFlat M)
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2}
    (hfc : letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
     haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
     IsFutureComplete (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D)
    (hrays : ∀ p ∈ S0 M, ∃ γ : ℝ → M, E0Spear.IsFullFutureBTZRay p γ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ), d.IsChartwise →
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      Injective d.D →
      ∀ x : d.Space, (d.toNat x).base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M →
        ∃ x' : d.Space, (d.toNat x').base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M ∧
          d.D x' ≠ d.D x ∧ (Causal.minkowski 2).le ⊤ (d.D x') (d.D x) := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hch hd hinj x hx
  have hxS : (d.toNat x).base ∈ E0CBG.S0 M :=
    (Set.ext_iff.1 (E0Bridge.sing_e0SingularGXStructure (M := M)) _).1 hx
  obtain ⟨γ, hγ⟩ := hrays _ hxS
  obtain ⟨v, W, ψ, hW, hray, hψ, hinjψ, hp, -⟩ := id hγ
  -- the axis below the vertex is still in `W`
  have hcont : Continuous fun s : ℝ =>
      (Sum.inr (orbitMk (GammaA (2 * Real.pi)) ((DInfty.apex, s) : DInfty × ℝ)) : E0Y) :=
    continuous_inr.comp (continuous_quot_mk.comp (continuous_const.prodMk continuous_id))
  have hWv : (Sum.inr (orbitMk (GammaA (2 * Real.pi)) ((DInfty.apex, 2 * v) : DInfty × ℝ)) : E0Y) ∈ W := by
    rw [← futureRay_yVertex_eq, ← E0Spear.yAxis_zero]; exact hray 0 le_rfl
  obtain ⟨ε₀, hε₀, hball⟩ := Metric.isOpen_iff.1 (hW.preimage hcont) (2 * v) hWv
  set ε := min ε₀ 1 with hεdef
  have hε : 0 < ε := lt_min hε₀ one_pos
  have hε1 : ε ≤ 1 := min_le_right _ _
  have hεε : ε ≤ ε₀ := min_le_left _ _
  set v' := v - ε / 4 with hv'
  have hray' : ∀ t, 0 ≤ t → E0Spear.yAxis v' t ∈ W := by
    intro t ht
    have e1 := futureRay_yAxis_eq v' (2 * v' + 2 * t)
    rw [show (2 * v' + 2 * t) / 2 - v' = t by ring] at e1
    rw [e1]
    by_cases hlt : 2 * v ≤ 2 * v' + 2 * t
    · have e2 := futureRay_yAxis_eq v (2 * v' + 2 * t)
      rw [← e2]; exact hray _ (by linarith)
    · apply hball
      rw [Metric.mem_ball, Real.dist_eq, abs_lt]
      constructor <;> linarith
  obtain ⟨c, hc, hr⟩ := futureRay_exists_chart hW hray' hψ hinjψ one_pos
  have hmem : ∀ s ∈ Icc (2 * v') (2 * v), s ∈ Icc (2 * v') (2 * v' + 2 * 1) := fun s hs =>
    ⟨hs.1, by linarith [hs.2]⟩
  have h2v : 2 * v ∈ Icc (2 * v') (2 * v) := ⟨by linarith, le_rfl⟩
  have hpx : ψ (Sum.inr (orbitMk (GammaA (2 * Real.pi)) ((DInfty.apex, 2 * v) : DInfty × ℝ))) =
      (d.toNat x).base := by rw [← futureRay_yVertex_eq]; exact hp
  have hxU : (d.toNat x).base ∈ (c.U : Set M) := by
    rw [← hpx]; exact (hr _ (hmem _ h2v)).1
  obtain ⟨f, Ψ, hΨ, hΨf, -, -, -, -, -, -, g, hg⟩ :=
    d.exists_liftedChart_of_isChartwise hch c hc (d.toNat x) hxU
  set Vh := connectedComponentIn ((SpreadEnd.base : MaxBranchedCover
    (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN → BTZE0) ⁻¹' (c.V : Set BTZE0)) f
    with hVhdef
  have hfV : f ∈ Vh := mem_connectedComponentIn hΨ.base_mem
  have hfb : f.base = orbitMk (GammaA (2 * Real.pi)) ((DInfty.apex, 2 * v) : DInfty × ℝ) := by
    rw [← hΨ.base f hfV, hΨf, ← hpx]; exact (hr _ (hmem _ h2v)).2
  have hΦf : Φ f = (DInfty.apex, 2 * v) := by
    apply futureRay_eq_apex_of_orbitMk
    rw [d.isPresentation]; exact hfb
  set σ : ℝ → MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN :=
    fun s => Φ.symm (DInfty.apex, s) with hσdef
  have hσc : Continuous σ := Φ.symm.continuous.comp (continuous_const.prodMk continuous_id)
  have hσb : ∀ s, (σ s).base = orbitMk (GammaA (2 * Real.pi)) ((DInfty.apex, s) : DInfty × ℝ) :=
    fun s => by rw [← d.isPresentation, hσdef, Φ.apply_symm_apply]
  have hσf : σ (2 * v) = f := by
    show Φ.symm (DInfty.apex, 2 * v) = f
    rw [← hΦf, Φ.symm_apply_apply]
  have hσV : σ (2 * v') ∈ Vh := by
    have hsub : σ '' Icc (2 * v') (2 * v) ⊆ SpreadEnd.base ⁻¹' (c.V : Set BTZE0) := by
      rintro _ ⟨s, hs, rfl⟩
      rw [mem_preimage, hσb, ← (hr s (hmem s hs)).2]
      exact mapsTo_chartExt c.φ (hr s (hmem s hs)).1
    have h := (isPreconnected_Icc.image σ hσc.continuousOn).subset_connectedComponentIn
      ⟨2 * v, h2v, hσf⟩ hsub
    exact h ⟨2 * v', ⟨le_rfl, by linarith⟩, rfl⟩
  have hDx : d.D x = g • btzDevM 0 btzV0 ((DInfty.apex, 2 * v) : DInfty × ℝ) := by
    have h := hg f hfV
    rw [hΨf, hΦf] at h; exact h
  have hDx' : d.D (Ψ (σ (2 * v'))) = g • btzDevM 0 btzV0 ((DInfty.apex, 2 * v') : DInfty × ℝ) := by
    rw [hg _ hσV, Φ.apply_symm_apply]
  have hle : (Causal.minkowski 2).le ⊤ (d.D (Ψ (σ (2 * v')))) (d.D x) := by
    rw [hDx, hDx']
    refine (Causal.Flat.isom_le_top_iff g).2 ?_
    rw [btzDevM_le_iff]
    simp only [BtzDevLe, DInfty.apex_r, zero_mul, zero_add, sub_self, le_refl, mul_zero,
      true_and]
    exact ⟨by linarith, by norm_num⟩
  have hne : d.D (Ψ (σ (2 * v'))) ≠ d.D x := by
    rw [hDx, hDx']
    intro h
    have h1 := btzDevM_injective 0 btzV0_pos (smul_left_cancel g h)
    have h2 := congrArg Prod.snd h1
    simp only at h2
    linarith
  refine ⟨d.fromNat (Ψ (σ (2 * v'))), ?_, hne, hle⟩
  by_contra hns
  have hR : (Ψ (σ (2 * v'))).base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M :=
    not_not.1 hns
  exact btzTilde_not_sing_of_le_reg x₀ hfc d hd hinj _ (d.toNat x) hR hle hx

/-- An isometry `g` with `D ∘ φ = g • D` for a bijection `φ` preserving `S` carries `Δ_x` onto
`Δ_{φ x}`. -/
theorem btzTildeDelta_smul {N : Type*} {D : N → Causal.Minkowski 2} {S : Set N} (φ : N ≃ N)
    (hS : ∀ e, φ e ∈ S ↔ e ∈ S) (g : Causal.Flat.isom 2) (hg : ∀ e, D (φ e) = g • D e)
    (x : N) : (fun m => g • m) '' btzTildeDelta D S x = btzTildeDelta D S (φ x) := by
  have hJ : ∀ p : Causal.Minkowski 2, (fun m => g • m) '' (Causal.minkowski 2).Jplus ⊤ {p} =
      (Causal.minkowski 2).Jplus ⊤ {g • p} := fun p => by
    ext m
    simp only [mem_image, Causal.Precausality.mem_Jplus_singleton]
    constructor
    · rintro ⟨m', hm', rfl⟩; exact (Causal.Flat.isom_le_top_iff g).2 hm'
    · intro hm
      refine ⟨g⁻¹ • m, ?_, smul_inv_smul g m⟩
      rw [← Causal.Flat.isom_le_top_iff g, smul_inv_smul]; exact hm
  have hSi : (fun m => g • m) '' (D '' S) = D '' S := by
    ext m
    constructor
    · rintro ⟨_, ⟨e, he, rfl⟩, rfl⟩
      exact ⟨φ e, (hS e).2 he, hg e⟩
    · rintro ⟨e, he, rfl⟩
      refine ⟨D (φ.symm e), ⟨φ.symm e, (hS _).1 (by rwa [Equiv.apply_symm_apply]), rfl⟩, ?_⟩
      show g • D (φ.symm e) = D e
      rw [← hg, Equiv.apply_symm_apply]
  have hinj : Injective (fun m : Causal.Minkowski 2 => g • m) := MulAction.injective g
  unfold btzTildeDelta
  rw [image_sdiff hinj, image_inter hinj, hSi, hJ, image_singleton, hg]

attribute [local instance] btzE0Structure in
/-- The developed BTZ points lie on the boundary of `𝒟(Reg M̃)` side: in the closure of
`𝒟(reg M̃)` (`T_BTZ`-density of `reg M̃` and `T_BTZ`-continuity of `d.D`). -/
theorem btzTilde_dev_mem_closure (x₀ : e0RegMFlat M)
    {D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2} :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData M (E0Bridge.basePt x₀) Φ),
      IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) M (E0Bridge.basePt x₀)
          d.T'.top →
      (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) →
      ∀ e, d.D e ∈ closure (range D) := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ d hT hd e
  have hdense : Dense (d.toNat ⁻¹' E0Bridge.regTilde (E0Bridge.basePt x₀)) := by
    have h := @IsPortly.dense _ d.T'.top _ hT.isPortly
    have hRS : Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M = (E0Bridge.sing M)ᶜ := by
      rw [E0Bridge.compl_sing_eq, E0Bridge.reg_e0SingularGXStructure]
    rw [hRS] at h
    exact h
  have hc : Continuous (fun e : d.Space => d.D (d.toNat e)) := d.continuous_D
  have h1 : d.D e ∈ closure ((fun e : d.Space => d.D (d.toNat e)) ''
      (d.toNat ⁻¹' E0Bridge.regTilde (E0Bridge.basePt x₀))) :=
    mem_closure_image hc.continuousAt (hdense (d.fromNat e))
  refine closure_mono ?_ h1
  rintro _ ⟨z, hz, rfl⟩
  exact ⟨_, (hd ⟨d.toNat z, hz⟩).symm⟩

set_option maxHeartbeats 1000000 in
attribute [local instance] btzE0Structure in
/-- **The BTZ half of the headline, in full** (l.2366–2375 at the BTZ points; DEC-28's display,
DEC-106's topologies, DEC-118/119's `M̃`): for `M` as in the headline and every developing pair
`(𝒟, ρ)` of `Reg M`, every presentation `Φ`: ONE chartwise `M̃`-datum `d`, with tamifying
`T_BTZ`, on which `𝒟` extends to the BTZ points, such that
* `d.D` is **injective on all of `M̃`**, `M̃` is globally hyperbolic (natural topology) and future
  complete (DEC-118 (a)), and `d.D ∘ φ = ρ(φ) • d.D` for every `φ ∈ Γ(M̃/M)`;
* the rays `Δₓ = 𝒟(sing M̃) ∩ J⁺(𝒟 x) ∖ {𝒟 x}` (`x` BTZ) are **relatively open future complete
  lightlike rays** `{𝒟 x + λu, λ > 0}`, contained in `∂Ω⁺(Λ)`, a `ρ(Γ)`-invariant family, whose
  union is `𝒟(sing M̃)`, disjoint from `Ω⁺(Λ)`, and `𝒟(M̃) = (⋃ Δₓ) ∪ Ω⁺(Λ)`;
* `𝒟(M̃)` with `defi:BTZtop` near the rays (`btzRangeTop`: `𝐌³`'s topology and the sets
  `I⁺(p) ∪ ]p,+∞[`, `p ∈ ⋃ Δₓ`) has the topology generated by `𝐌³`'s and the `𝒟`-images of
  `T_BTZ`-open sets (`devImageTop`), and for it `𝒟(e) ↦ p(e)` is a homeomorphism
  `ρ(Γ)\𝒟(M̃) ≃ₜ M` which, on the regular classes, is `f⁻¹ ∘ π` for every isometry
  `f : Reg M ≅ B` onto a presentation `π : Ω⁺ → B` of `ρ(Γ)\Ω⁺` with `f ∘ p = π ∘ 𝒟`, and which
  is an a.e. isomorphism of singular manifolds for the unique maximal a.e. atlas on `ρ(Γ)\𝒟(M̃)`
  making `M̃ → ρ(Γ)\𝒟(M̃)` an a.e. morphism (`btzTilde_quotient_aeIso`). -/
theorem btz_uniformization_btzRays (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S)
    (hmax : IsE0CauchyMaximal M) (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    (x₀ : e0RegMFlat M)
    (hnm : ¬IsMetabelianGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ}, (∀ e, orbitMk (GammaA (2 * Real.pi)) (Φ e) = e.base) →
      ∃ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, d.IsChartwise ∧
        IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) M (E0Bridge.basePt x₀)
          d.T'.top ∧
        (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) ∧
        Injective d.D ∧ d.natCausality.GloballyHyperbolic ∧
        BTZTildeData.IsBTZFutureComplete M d ∧
        (∀ (φ : Deck (SpreadEnd.base :
            MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M)) e,
          d.D (φ.1 e) = ρ (btzTildeDeckConj x₀ φ) • d.D e) ∧
        (∀ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
          ∃ u : Causal.Minkowski 2, Causal.Flat.IsFutureCausal u ∧ Causal.Flat.minkQ u = 0 ∧
            u ≠ 0 ∧ btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2)
              (Causal.Minkowski 2) M} x = {m | ∃ lam : ℝ, 0 < lam ∧ m = d.D x + lam • u}) ∧
        (∀ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
          btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} x ⊆
            frontier (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range))) ∧
        (∀ g ∈ ρ.range, ∀ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
          ∃ x' ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
            (fun m => g • m) '' btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2)
              (Causal.Minkowski 2) M} x =
              btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M}
                x') ∧
        d.D '' {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} =
          (⋃ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
            btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} x) ∧
        Disjoint (d.D '' {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M})
          (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range)) ∧
        range d.D =
          (⋃ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
            btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} x) ∪
          Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
        btzRangeTop d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} =
          @devImageTop _ (Causal.Minkowski 2) d.T'.top _ d.D ∧
        (letI := btzRangeTop d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M}
        ∃ h : Quotient (btzRangeOrbitSetoid ρ.range (range d.D)) ≃ₜ M,
          (∀ e, h (Quotient.mk _ (rangeFactorization d.D e)) = e.base) ∧
          (∀ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B)
            (f : e0RegMFlat M ≃ₜ B),
          (∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
              f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩) →
          ∀ e ∈ E0Bridge.regTilde (E0Bridge.basePt x₀),
          ∀ hm : d.D e ∈ Causal.Flat.limitOpensPlus ρ.range,
            E0Bridge.flatVal (f.symm (π ⟨d.D e, hm⟩)) =
              h (Quotient.mk _ (rangeFactorization d.D e))) ∧
          IsMaximalAEAtlas (Causal.Flat.isom 2)
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M)) ∧
          IsMaximalAEAtlas (Causal.Flat.isom 2)
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              h) ∧
          IsAEMorphismOf (Causal.Flat.isom 2)
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              h)
            (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) h ∧
          IsAEMorphismOf (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              h) h.symm ∧
          IsAEMorphismOf (Causal.Flat.isom 2)
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M))
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              h)
            (fun e => Quotient.mk _ (rangeFactorization d.D e)) ∧
          ∀ B : Set (OpenPartialHomeomorph (Quotient (btzRangeOrbitSetoid ρ.range (range d.D)))
              (Causal.Minkowski 2)), IsMaximalAEAtlas (Causal.Flat.isom 2) B →
            IsAEMorphismOf (Causal.Flat.isom 2)
              (aePullback (Causal.Flat.isom 2)
                (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
                (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M)) B
              (fun e => Quotient.mk _ (rangeFactorization d.D e)) →
            B = aePullback (Causal.Flat.isom 2)
              (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) h) := by
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ hΦ
  have hU := btz_uniformization_C1 hGH hCC hmax hsing x₀ hnm D ρ hpair
  have hrange : range D = Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) :=
    hU.2.2.2.2.2.2.2.1
  have hsteps := btz_isFutureComplete_C1 hGH hCC hmax hsing x₀ hnm D ρ hpair
  obtain ⟨d, hch, hT, hd⟩ := btzTilde_exists_tamifying_extending x₀ hpair hΦ
  have hinj := btz_injective_dev_C1 hGH hCC hmax hsing x₀ hnm D ρ hpair hΦ d hch hd
  have hG : (e0ManifoldCausality M E0Bridge.isBTZSingModelled_e0).GloballyHyperbolic :=
    E0Bridge.globallyHyperbolic_e0ManifoldCausality_iff.2 hGH
  have hfcd := (btz_isBTZFutureComplete_C1 hGH hCC hmax hsing x₀ hnm D ρ hpair hΦ).2 d hch hd
  have hdeck := btzTilde_dev_deck x₀ hpair d hT hd
  set Sg : Set (MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) :=
    {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} with hSg
  set Ω := Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) with hΩ
  have hΩo : IsOpen Ω := Causal.Flat.isOpen_omegaPlus_of_isClosed (Causal.Flat.isClosed_limitSetJ _)
  -- `𝒟(sing M̃)` misses `Ω`
  have hdisj : Disjoint (d.D '' Sg) Ω := by
    rw [Set.disjoint_left]
    rintro _ ⟨e, he, rfl⟩ hm
    rw [← hrange] at hm
    obtain ⟨c, hc⟩ := hm
    have h3 := hd ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c)
    rw [Homeomorph.apply_symm_apply, hc] at h3
    have h4 := hinj h3
    have h5 := ((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c).2
    rw [h4] at h5
    exact h5 he
  -- the rays
  have hray : ∀ x ∈ Sg, ∃ u : Causal.Minkowski 2, Causal.Flat.IsFutureCausal u ∧
      Causal.Flat.minkQ u = 0 ∧ u ≠ 0 ∧
      btzTildeDelta d.D Sg x = {m | ∃ lam : ℝ, 0 < lam ∧ m = d.D x + lam • u} := by
    intro x hx
    obtain ⟨u, hu₁, hu₂, hu₃, hJ⟩ :=
      btzTilde_sing_inter_Jplus x₀ hsteps.1 hsteps.2 d hch hd hinj (d.fromNat x) hx
    refine ⟨u, hu₁, hu₂, hu₃, ?_⟩
    unfold btzTildeDelta
    have hJ' : d.D '' Sg ∩ (Causal.minkowski 2).Jplus ⊤ {d.D x} =
        {m | ∃ lam : ℝ, 0 ≤ lam ∧ m = d.D x + lam • u} := hJ
    rw [hJ']
    ext m
    simp only [Set.mem_sdiff, mem_setOf_eq, mem_singleton_iff]
    constructor
    · rintro ⟨⟨lam, hlam, rfl⟩, hne⟩
      refine ⟨lam, lt_of_le_of_ne hlam fun h => hne ?_, rfl⟩
      rw [← h, zero_smul, add_zero]
    · rintro ⟨lam, hlam, rfl⟩
      refine ⟨⟨lam, hlam.le, rfl⟩, fun h => hu₃ ?_⟩
      have h' : lam • u = 0 := by
        have := congrArg (fun m => m - d.D x) h
        simpa using this
      exact (smul_eq_zero.1 h').resolve_left hlam.ne'
  have hsub : ∀ x, btzTildeDelta d.D Sg x ⊆ d.D '' Sg := fun x m hm => hm.1.1
  -- the union of the rays is `𝒟(sing M̃)`
  have hunion : d.D '' Sg = ⋃ x ∈ Sg, btzTildeDelta d.D Sg x := by
    refine Subset.antisymm ?_ (iUnion₂_subset fun x _ => hsub x)
    rintro _ ⟨e, he, rfl⟩
    obtain ⟨x', hx', hne, hle⟩ :=
      btzTilde_exists_sing_below x₀ hsteps.1 hsteps.2 d hch hd hinj (d.fromNat e) he
    refine mem_iUnion₂.2 ⟨d.toNat x', hx', ⟨⟨⟨e, he, rfl⟩, ?_⟩, ?_⟩⟩
    · exact Causal.Precausality.mem_Jplus_singleton.2 hle
    · exact fun h => hne (mem_singleton_iff.1 h).symm
  refine ⟨d, hch, hT, hd, hinj, d.natGloballyHyperbolic_of_base hch E0Bridge.isBTZSingModelled_e0 hG,
    hfcd, hdeck, hray, ?_, ?_, hunion, hdisj, ?_, d.btzRangeTop_eq_devImageTop hinj hray, ?_⟩
  · -- the rays lie on `∂Ω⁺(Λ)`
    intro x _ m hm
    obtain ⟨e, he, rfl⟩ := hsub x hm
    rw [hΩo.frontier_eq]
    refine ⟨?_, Set.disjoint_left.1 hdisj ⟨e, he, rfl⟩⟩
    rw [← hrange]
    exact btzTilde_dev_mem_closure x₀ d hT hd e
  · -- `ρ(Γ)`-invariance of the family
    rintro _ ⟨δ, rfl⟩ x hx
    obtain ⟨φ, rfl⟩ := btzTildeDeckConj_surjective x₀ δ
    have hbase : ∀ e, (φ.1 e).base = e.base := fun e => deck_apply _ φ.2 e
    refine ⟨φ.1 x, ?_, ?_⟩
    · show (φ.1 x).base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M
      rw [hbase]; exact hx
    · exact btzTildeDelta_smul φ.1.toEquiv (fun e => by
        show (φ.1 e).base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M ↔
          e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M
        rw [hbase]) _ (hdeck φ) x
  · -- `𝒟(M̃) = (⋃ Δₓ) ∪ Ω⁺(Λ)`
    rw [← hunion]
    ext m
    constructor
    · rintro ⟨e, rfl⟩
      by_cases he : e ∈ Sg
      · exact Or.inl ⟨e, he, rfl⟩
      · right
        have heR : e ∈ E0Bridge.regTilde (E0Bridge.basePt x₀) := he
        rw [← hrange, hd ⟨e, heR⟩]
        exact mem_range_self _
    · rintro (⟨e, -, rfl⟩ | hm)
      · exact mem_range_self e
      · rw [← hrange] at hm
        obtain ⟨c, rfl⟩ := hm
        refine ⟨((E0Bridge.regTildeHomeo (E0Bridge.basePt x₀)).symm c : _), ?_⟩
        rw [hd, Homeomorph.apply_symm_apply]
  · -- `ρ(Γ)\𝒟(M̃) ≃ₜ M` for `defi:BTZtop`, compatible with the isometry `Reg M ≅ ρ(Γ)\Ω⁺`
    exact btzTilde_quotient_aeIso x₀ hpair d hT hd hinj hray


end S47h

attribute [local instance] btzE0Structure in
/-- **The headline on standard axioms, given the one open leaf** (`E0MixedDiamondsCompact`, B21
Prop 2.17's mixed diamonds): the statement of `btz_uniformization`, through
`cor_abs_max_C1_of_mixed`. -/
theorem btz_uniformization_of_mixed (hmix : E0MixedDiamondsCompact M)
    (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S)
    (hmax : IsE0CauchyMaximal M) (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    (x₀ : e0RegMFlat M)
    (hfree : IsFreeGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (hna : ∃ a b : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀), a * b ≠ b * a)
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    ((∃ γ ∈ ρ.range, Causal.Flat.IsLoxodromic (Causal.Flat.linOf γ)) ∧ Injective D ∧
      Injective ρ ∧ DiscreteTopology ρ.range ∧ Causal.Flat.IsTorsionFreeSubgroup ρ.range ∧
      (∀ γ ∈ ρ.range, ∀ w ∈ Causal.Flat.limitSetJ ρ.range,
        Causal.Flat.isomPenrose γ w ∈ Causal.Flat.limitSetJ ρ.range ∧
          (fun p => γ • p) '' nullPlane w = nullPlane (Causal.Flat.isomPenrose γ w)) ∧
      Causal.Flat.FutureRegular (Causal.Flat.limitSetJ ρ.range) ∧
      range D = Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
      Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) =
        ⋂ w ∈ Causal.Flat.limitSetJ ρ.range, (Causal.minkowski 2).Iplus ⊤ (nullPlane w) ∧
      Causal.Flat.ActsFreelyProperlyOn ρ.range
        (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range)) ∧
      (letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
       haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
       IsFutureComplete
        (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) ∧
      (∃ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B),
        IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry 2 π ∧ Surjective π ∧
        (∀ p q : Causal.Flat.limitOpensPlus ρ.range,
          π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski 2) = q) ∧
        Causal.Flat.GH B ∧
        ∃ f : e0RegMFlat M ≃ₜ B, Causal.Flat.IsLocalIsometry 2 f ∧
          ∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
            f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩) ∧
      ∀ p ∈ S0 M, ∃ γ : ℝ → M, E0Spear.IsFullFutureBTZRay p γ) ∧
    (letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ}, (∀ e, orbitMk (GammaA (2 * Real.pi)) (Φ e) = e.base) →
      (∃ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, d.IsChartwise ∧
        (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) ∧
        InjOn d.D (E0Bridge.regTilde (E0Bridge.basePt x₀)) ∧
        d.natCausality.GloballyHyperbolic) ∧
      ∀ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, IsFutureDistinguishing d.causality) := by
  have h := btz_uniformization_C1_of_regM hGH (cor_abs_max_C1_of_mixed hmix hGH hCC hmax) hmax hsing
    x₀ (not_isMetabelianGroup_of_isFreeGroup' hfree hna) D ρ hpair
  exact ⟨h, btz_uniformization_btzHalf hGH x₀ D ρ hpair h.2.1⟩

attribute [local instance] btzE0Structure in
/-- **THE HEADLINE** (`theo:globally_hyperbolic_cauchy_complete_cauchy_maximal`, gx l.2363), in the
form the rulings fix: DEC-28 (Cauchy-compact, the image `(⋃Δᵢ) ∪ ⋂I⁺(Πⱼ)`), DEC-107/117 (a compact
`C¹` spacelike Cauchy surface, through `E0AbsMax.cor_abs_max_C1`), DEC-76/119 (`π₁(Reg M)` **free
and non-abelian**, `s ≥ 1`), DEC-77 (a) (no « up to time reversal »: the future case is proved),
DEC-106/118/119 (the lifted `M̃` in its natural topology for causality and GH, `T_BTZ` for the
final homeomorphism; the bridge). For `M` a globally hyperbolic Cauchy-maximal `𝔼₀`-manifold
with a compact `C¹` spacelike Cauchy surface and a BTZ point, and **every** developing pair
`(𝒟, ρ)` of `Reg M`:
* a loxodromic in `ρ(π₁)` (DEC-75); `𝒟` injective on `Reg M̃`; `ρ` faithful, discrete and
  torsion-free; the `ρ(π₁)`-invariant null planes `(Π_w)_{w ∈ Λ}`;
* `𝒟(Reg M̃) = Ω⁺(Λ) = ⋂_w I⁺(Π_w)`, on which `ρ(π₁)` acts freely and properly discontinuously;
  `Reg M̃` future complete; `𝒟` induces an isometry `Reg M ≅ ρ(π₁)\Ω⁺(Λ)`; every BTZ point of
  `M` starts a full future BTZ ray (B21 Lemma 2.3);
* for every presentation `Φ`, ONE chartwise `M̃` with tamifying `T_BTZ` on which `𝒟` extends to
  the BTZ points (`btz_uniformization_btzRays`): `𝒟` injective on all of `M̃`, `M̃` GH (natural
  topology) and future complete, `𝒟` equivariant under `Γ(M̃/M)` through `ρ`; the rays
  `Δₓ = 𝒟(sing M̃) ∩ J⁺(𝒟x) ∖ {𝒟x}` relatively open future complete lightlike rays in `∂Ω⁺`, a
  `ρ(Γ)`-invariant family whose union `𝒟(sing M̃)` misses `Ω⁺`, `𝒟(M̃) = (⋃ Δₓ) ∪ Ω⁺`; and
  `ρ(Γ)\𝒟(M̃) ≃ₜ M` with `𝒟(M̃)` carrying `defi:BTZtop` near the rays (`btzRangeTop`, PROVED equal
  to the `𝒟`-image of `T_BTZ`), agreeing on `Ω⁺` with the isometry `Reg M ≅ ρ(π₁)\Ω⁺` of the
  first block, and an **isomorphism of singular manifolds**: `h`, `h⁻¹` are a.e. morphisms for
  the unique maximal a.e. atlas on `ρ(Γ)\𝒟(M̃)` making `M̃ → ρ(Γ)\𝒟(M̃)` an a.e. morphism
  (`btzTilde_quotient_aeIso`); every `M̃` future distinguishing. -/
theorem btz_uniformization (hGH : (CE M).GloballyHyperbolic)
    (hCC : ∃ S : Set M, E0Surgery.IsE0C1SpacelikeCauchy M S)
    (hmax : IsE0CauchyMaximal M) (hsing : (Causal.CBG.chartedSing e0SingY M 0).Nonempty)
    (x₀ : e0RegMFlat M)
    (hfree : IsFreeGroup (Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀)))
    (hna : ∃ a b : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀), a * b ≠ b * a)
    (D : Causal.UniversalCover (e0RegMFlat M) x₀ → Causal.Minkowski 2)
    (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat M) x₀) →* Causal.Flat.isom 2)
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ) :
    ((∃ γ ∈ ρ.range, Causal.Flat.IsLoxodromic (Causal.Flat.linOf γ)) ∧ Injective D ∧
      Injective ρ ∧ DiscreteTopology ρ.range ∧ Causal.Flat.IsTorsionFreeSubgroup ρ.range ∧
      (∀ γ ∈ ρ.range, ∀ w ∈ Causal.Flat.limitSetJ ρ.range,
        Causal.Flat.isomPenrose γ w ∈ Causal.Flat.limitSetJ ρ.range ∧
          (fun p => γ • p) '' nullPlane w = nullPlane (Causal.Flat.isomPenrose γ w)) ∧
      Causal.Flat.FutureRegular (Causal.Flat.limitSetJ ρ.range) ∧
      range D = Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
      Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) =
        ⋂ w ∈ Causal.Flat.limitSetJ ρ.range, (Causal.minkowski 2).Iplus ⊤ (nullPlane w) ∧
      Causal.Flat.ActsFreelyProperlyOn ρ.range
        (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range)) ∧
      (letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat M) x₀
       haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat M) x₀
       IsFutureComplete
        (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat M) x₀)) D) ∧
      (∃ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B),
        IsCoveringMap π ∧ Causal.Flat.IsLocalIsometry 2 π ∧ Surjective π ∧
        (∀ p q : Causal.Flat.limitOpensPlus ρ.range,
          π p = π q ↔ ∃ γ ∈ ρ.range, γ • (p : Causal.Minkowski 2) = q) ∧
        Causal.Flat.GH B ∧
        ∃ f : e0RegMFlat M ≃ₜ B, Causal.Flat.IsLocalIsometry 2 f ∧
          ∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
            f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩) ∧
      ∀ p ∈ S0 M, ∃ γ : ℝ → M, E0Spear.IsFullFutureBTZRay p γ) ∧
    (letI := E0Bridge.e0SingularGXStructure M
    haveI := ChartedSpace.locPathConnectedSpace E0Y M
    ∀ {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ}, (∀ e, orbitMk (GammaA (2 * Real.pi)) (Φ e) = e.base) →
      (∃ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, d.IsChartwise ∧
        IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) M (E0Bridge.basePt x₀)
          d.T'.top ∧
        (∀ z : E0Bridge.regTilde (E0Bridge.basePt x₀),
          d.D (z : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀)) =
            D (E0Bridge.regTildeHomeo (E0Bridge.basePt x₀) z)) ∧
        Injective d.D ∧ d.natCausality.GloballyHyperbolic ∧
        BTZTildeData.IsBTZFutureComplete M d ∧
        (∀ (φ : Deck (SpreadEnd.base :
            MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M)) e,
          d.D (φ.1 e) = ρ (btzTildeDeckConj x₀ φ) • d.D e) ∧
        (∀ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
          ∃ u : Causal.Minkowski 2, Causal.Flat.IsFutureCausal u ∧ Causal.Flat.minkQ u = 0 ∧
            u ≠ 0 ∧ btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2)
              (Causal.Minkowski 2) M} x = {m | ∃ lam : ℝ, 0 < lam ∧ m = d.D x + lam • u}) ∧
        (∀ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
          btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} x ⊆
            frontier (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range))) ∧
        (∀ g ∈ ρ.range, ∀ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
          ∃ x' ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
            (fun m => g • m) '' btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2)
              (Causal.Minkowski 2) M} x =
              btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M}
                x') ∧
        d.D '' {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} =
          (⋃ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
            btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} x) ∧
        Disjoint (d.D '' {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M})
          (Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range)) ∧
        range d.D =
          (⋃ x ∈ {e : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) |
            e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M},
            btzTildeDelta d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} x) ∪
          Causal.Flat.omegaPlus (Causal.Flat.limitSetJ ρ.range) ∧
        btzRangeTop d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M} =
          @devImageTop _ (Causal.Minkowski 2) d.T'.top _ d.D ∧
        (letI := btzRangeTop d.D {e | e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M}
        ∃ h : Quotient (btzRangeOrbitSetoid ρ.range (range d.D)) ≃ₜ M,
          (∀ e, h (Quotient.mk _ (rangeFactorization d.D e)) = e.base) ∧
          (∀ (B : Causal.Flat.FlatSpacetime.{0} 2) (π : Causal.Flat.limitOpensPlus ρ.range → B)
            (f : e0RegMFlat M ≃ₜ B),
          (∀ z (hz : D z ∈ Causal.Flat.limitOpensPlus ρ.range),
              f (Causal.UniversalCover.proj (e0RegMFlat M) x₀ z) = π ⟨D z, hz⟩) →
          ∀ e ∈ E0Bridge.regTilde (E0Bridge.basePt x₀),
          ∀ hm : d.D e ∈ Causal.Flat.limitOpensPlus ρ.range,
            E0Bridge.flatVal (f.symm (π ⟨d.D e, hm⟩)) =
              h (Quotient.mk _ (rangeFactorization d.D e))) ∧
          IsMaximalAEAtlas (Causal.Flat.isom 2)
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M)) ∧
          IsMaximalAEAtlas (Causal.Flat.isom 2)
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              h) ∧
          IsAEMorphismOf (Causal.Flat.isom 2)
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              h)
            (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) h ∧
          IsAEMorphismOf (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              h) h.symm ∧
          IsAEMorphismOf (Causal.Flat.isom 2)
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M))
            (aePullback (Causal.Flat.isom 2) (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
              h)
            (fun e => Quotient.mk _ (rangeFactorization d.D e)) ∧
          ∀ B : Set (OpenPartialHomeomorph (Quotient (btzRangeOrbitSetoid ρ.range (range d.D)))
              (Causal.Minkowski 2)), IsMaximalAEAtlas (Causal.Flat.isom 2) B →
            IsAEMorphismOf (Causal.Flat.isom 2)
              (aePullback (Causal.Flat.isom 2)
                (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
                (SpreadEnd.base : MaxBranchedCover (E0Bridge.sing M) (E0Bridge.basePt x₀) → M)) B
              (fun e => Quotient.mk _ (rangeFactorization d.D e)) →
            B = aePullback (Causal.Flat.isom 2)
              (aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M) h)) ∧
      ∀ d : BTZTildeData M (E0Bridge.basePt x₀) Φ, IsFutureDistinguishing d.causality) := by
  have hnm := not_isMetabelianGroup_of_isFreeGroup' hfree hna
  have h := btz_uniformization_of_mixed (e0MixedDiamondsCompact_of_record hGH hmax) hGH hCC hmax
    hsing x₀ hfree hna D ρ hpair
  refine ⟨h.1, ?_⟩
  letI := E0Bridge.e0SingularGXStructure M
  haveI := ChartedSpace.locPathConnectedSpace E0Y M
  intro yN Φ hΦ
  exact ⟨btz_uniformization_btzRays hGH hCC hmax hsing x₀ hnm D ρ hpair hΦ, (h.2 hΦ).2⟩

end E0

/-! ## §4d DEC-31: Cauchy-completeness of an `𝔼₀`-manifold (the induced length metric)

DEC-31: a Cauchy surface is Cauchy-complete when it is complete for its induced length metric —
lengths measured in the flat charts, the length structure extended across the singular lines. On
`S ⊆ M` the chart system `e0SliceSys S` reads a point `y` in the flat chart of `Reg M` at a regular
`x`, and is constant at a BTZ point `x`, so a curve of `S` has density `√(q(ċ))` at a regular
time and `0` at a BTZ time: the length of a curve is the integral of its regular densities (the
lengths of its regular pieces), which is the extension across the lines. This is
`Causal.Flat.IsCauchyComplete` (Barbot l.551–553, DEC-35) with the regular flat charts and that
extension; on a manifold with no BTZ point it is the chart system of `Causal.Flat.chartSys`. -/

section DEC31

open E0CBG

variable {M : Type} [TopologicalSpace M] [T2Space M] [ConnectedSpace M] [ChartedSpace E0Y M]
  [HasGroupoid M e0Groupoid]

/-- **The length chart system of `S ⊆ M`** (DEC-31): the flat chart of `Reg M` at a regular
point, constant (`0`) at a BTZ point. -/
noncomputable def e0SliceSys (S : Set M) (x y : S) : Causal.Minkowski 2 := by
  classical
  exact if hx : (x : M) ∈ E0LM.e0RegM M then
    if hy : (y : M) ∈ E0LM.e0RegM M then
      chartAt (Causal.Minkowski 2) (show e0RegMFlat M from (⟨x, hx⟩ : E0LM.e0RegM M))
        (show e0RegMFlat M from (⟨y, hy⟩ : E0LM.e0RegM M))
    else 0
  else 0

/-- At a BTZ point the length chart system is constant. -/
theorem e0SliceSys_of_not_mem {S : Set M} {x : S} (hx : (x : M) ∉ E0LM.e0RegM M) (y : S) :
    e0SliceSys S x y = 0 := by
  simp [e0SliceSys, hx]

/-- At a regular point, the length chart system is the flat chart of `Reg M`. -/
theorem e0SliceSys_of_mem {S : Set M} {x y : S} (hx : (x : M) ∈ E0LM.e0RegM M)
    (hy : (y : M) ∈ E0LM.e0RegM M) :
    e0SliceSys S x y = chartAt (Causal.Minkowski 2)
      (show e0RegMFlat M from (⟨x, hx⟩ : E0LM.e0RegM M))
        (show e0RegMFlat M from (⟨y, hy⟩ : E0LM.e0RegM M)) := by
  simp [e0SliceSys, hx, hy]

/-- A BTZ time of a curve contributes no length (DEC-31's extension across the lines). -/
theorem localDensity_e0SliceSys_of_not_mem {S : Set M} {c : ℝ → S} {t : ℝ}
    (ht : (c t : M) ∉ E0LM.e0RegM M) :
    Causal.Flat.localDensity (e0SliceSys S) c t = 0 := by
  simp [Causal.Flat.localDensity, e0SliceSys_of_not_mem ht]

/-- **DEC-31 Cauchy-completeness of an `𝔼₀`-manifold**: a Cauchy surface `S`, spacelike Lipschitz
in the flat charts of `Reg M`, complete for its induced length metric (the length space of
`e0SliceSys S`), whose metric topology is at least as fine as the topology of `M`. -/
def IsE0CauchyComplete (M : Type) [TopologicalSpace M] [T2Space M] [ConnectedSpace M]
    [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid] : Prop :=
  ∃ S : Set M, (CE M).IsCauchySurface S ∧
    Causal.Flat.IsSpacelikeLipschitz 2 (E0Surgery.regSet M S) ∧
    CompleteSpace (Causal.Flat.LocalLengthSpace (e0SliceSys S)) ∧
    Continuous fun x : Causal.Flat.LocalLengthSpace (e0SliceSys S) =>
      ((Causal.Flat.LocalLengthSpace.toSpace x : S) : M)

end DEC31

/-! ## §4b The counterexample `{τ<0} ⊂ 𝔼₀` to the printed proposition (D-11, DEC-77) -/

section PastHalf

open TopologicalSpace E0CBG E0Spear E0AbsMax
open scoped Causal.Flat

/-- **The past half `{τ < 0}` of `𝔼₀`** (D-11's counterexample), an open subset of `Y = 𝕄 ⊕ 𝔼₀`,
hence an `𝔼₀`-manifold (`Opens`' charted structure; Hausdorff, second countable, connected). -/
noncomputable def e0PastHalf : Opens E0Y :=
  ⟨E0.paperInY '' {w : E0 | w.1 < 0},
    E0.paperInY.isOpen_image_of_subset_source (isOpen_lt continuous_fst continuous_const)
      (by simp)⟩

/-- A point of `Y` lies in `{τ<0}` iff it is in the `𝔼₀` part with paper time `τ < 0`. -/
theorem mem_e0PastHalf_iff {y : E0Y} :
    y ∈ e0PastHalf ↔ y ∈ E0.paperOfY.source ∧ (E0.paperOfY y).1 < 0 := by
  constructor
  · rintro ⟨w, hw, rfl⟩
    refine ⟨by rw [E0.paperOfY_source]; exact ⟨_, rfl⟩, ?_⟩
    simpa using hw
  · rintro ⟨hs, hy⟩
    rw [E0.paperOfY_source] at hs
    obtain ⟨x, rfl⟩ := hs
    refine ⟨E0.toPaper x, ?_, ?_⟩
    · simpa using hy
    · simp

/-- `{τ<0}` is connected (the image of a half-space of `ℝ × ℂ`). -/
instance e0PastHalf_connectedSpace : ConnectedSpace e0PastHalf := by
  have hc : IsConnected {w : E0 | w.1 < 0} := by
    refine ⟨⟨(-1, 0), by norm_num⟩, ?_⟩
    exact (convex_halfSpace_lt (f := fun w : E0 => w.1) ⟨fun _ _ => rfl, fun _ _ => rfl⟩ 0).isPreconnected
  have := hc.image _ (E0.paperInY.continuousOn.mono (by simp))
  exact isConnected_iff_connectedSpace.1 this

/-- On `{τ<0}`, every paper chart is defined everywhere. -/
theorem chartSource_paperChart_pastHalf (x : e0PastHalf) :
    Causal.chartSource (paperChart x) = ⊤ := by
  ext a
  simp only [Causal.coe_chartSource, paperChart, OpenPartialHomeomorph.trans_source]
  refine iff_of_true ⟨?_, ?_⟩ trivial
  · show a ∈ ((chartAt E0Y (x : E0Y)).subtypeRestr ⟨x⟩).source
    rw [OpenPartialHomeomorph.subtypeRestr_source]; exact trivial
  · show ((chartAt E0Y (x : E0Y)).subtypeRestr ⟨x⟩ a) ∈ E0.paperOfY.source
    rw [OpenPartialHomeomorph.subtypeRestr_coe]
    exact (mem_e0PastHalf_iff.1 a.2).1


/-- A chronological relation of `{τ<0}` is one of `𝔼₀` in the paper's coordinates. -/
theorem pastHalf_lt_paper {a b : e0PastHalf} (h : (CE e0PastHalf).lt ⊤ a b) :
    ∃ U, E0.causality.lt U (E0.paperOfY a) (E0.paperOfY b) := by
  have hU : (⊤ : Opens e0PastHalf) ≤ Causal.chartSource (paperChart a) := by
    rw [chartSource_paperChart_pastHalf]
  exact ⟨_, ((chartIso_paperChart a ⊤ hU a trivial b trivial).2).1 h⟩

/-- The paper coordinates of the base point of `z ∈ Reg {τ<0}~`. -/
noncomputable def pastHalfPaper {x₀ : e0RegMFlat e0PastHalf}
    (z : Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀) : E0 :=
  E0.paperOfY (show E0LM.e0RegM e0PastHalf from
    Causal.UniversalCover.proj (e0RegMFlat e0PastHalf) x₀ z).1.1

/-- The base point of a point of `Reg {τ<0}~` has `τ < 0`. -/
theorem pastHalfPaper_fst_neg {x₀ : e0RegMFlat e0PastHalf}
    (z : Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀) : (pastHalfPaper z).1 < 0 :=
  (mem_e0PastHalf_iff.1 (show E0LM.e0RegM e0PastHalf from
    Causal.UniversalCover.proj (e0RegMFlat e0PastHalf) x₀ z).1.2).2

/-- **A chronological relation of `Reg {τ<0}~` is one of `𝔼₀`** (through `Reg {τ<0}`, its
`𝔼₀` causality `flatCausality_e0RegM_eq`, the inclusion into `{τ<0}`, and the paper chart). -/
theorem pastHalf_cover_lt {x₀ : e0RegMFlat e0PastHalf}
    {z w : Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀}
    (h : letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat e0PastHalf) x₀
      haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat e0PastHalf) x₀
      (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀)).lt ⊤ z w) :
    ∃ U, E0.causality.lt U (pastHalfPaper z) (pastHalfPaper w) := by
  letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat e0PastHalf) x₀
  haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat e0PastHalf) x₀
  have h1 := (Causal.Flat.isLocalIsometry_flatCover_proj (d := 2) x₀).strongMorphism.map_lt ⊤ ⊤
    rfl h
  have h2 : (CE (E0LM.e0RegM e0PastHalf)).lt ⊤
      (Causal.UniversalCover.proj (e0RegMFlat e0PastHalf) x₀ z)
      (Causal.UniversalCover.proj (e0RegMFlat e0PastHalf) x₀ w) := by
    rw [← flatCausality_e0RegM_eq]; exact h1
  have hval : Causal.IsEMorphism (CE (E0LM.e0RegM e0PastHalf)) (CE e0PastHalf) Subtype.val :=
    isEMorphismOn_of_isE0Mor (W := ⊤) (isE0Mor_val _)
  have h3 := (Causal.isEMorphism_iff.1 hval).1.map_lt ⊤ ⊤ rfl h2
  exact pastHalf_lt_paper h3


section PastHalfGH

/-- `paperOfY ∘ paperInY = id`. -/
theorem pastHalf_paperOfY_paperInY (w : E0) : E0.paperOfY (E0.paperInY w) = w := by simp

/-- `paperInY ∘ paperOfY = id` on the `𝔼₀` part. -/
theorem pastHalf_paperInY_paperOfY {y : E0Y} (hy : y ∈ E0.paperOfY.source) :
    E0.paperInY (E0.paperOfY y) = y := by
  rw [E0.paperOfY_source] at hy
  obtain ⟨x, rfl⟩ := hy
  simp

/-- The chart image of `{τ<0}` in the paper's coordinates is `{τ < 0}`. -/
theorem mem_chartImage_paperChart_pastHalf (p : e0PastHalf) (w : E0) :
    w ∈ Causal.chartImage (paperChart p) ⊤ ↔ w.1 < 0 := by
  rw [← SetLike.mem_coe, Causal.coe_chartImage_of_le (by rw [chartSource_paperChart_pastHalf])]
  constructor
  · rintro ⟨a, -, rfl⟩
    exact (mem_e0PastHalf_iff.1 a.2).2
  · intro hw
    refine ⟨⟨E0.paperInY w, w, hw, rfl⟩, trivial, ?_⟩
    show E0.paperOfY (E0.paperInY w) = w
    exact pastHalf_paperOfY_paperInY w

/-- A causal relation of `𝔼₀` ending in `{τ<0}` is one of any open set containing `{τ<0}` (a future
causal curve has `τ` non-decreasing). -/
theorem e0_le_of_le_top_of_fst_neg {U : Opens E0} (hU : ∀ w : E0, w.1 < 0 → w ∈ U) {x y : E0}
    (h : E0.causality.le ⊤ x y) (hy : y.1 < 0) : E0.causality.le U x y := by
  obtain ⟨a, b, hab, c, hc, rfl, rfl⟩ := h
  refine ⟨a, b, hab, c, ⟨fun t ht => hU _ ?_, fun t ht N _ hN => hc.rel t ht N le_top hN⟩, rfl, rfl⟩
  rcases ht.2.lt_or_eq with htb | rfl
  · have := (hc.rel_of_lt E0.isRelFamily_le ht.1 htb le_rfl).2.2
    exact this.closed.1.trans_lt hy
  · exact hy

/-- **The causal relation of `{τ<0}` is that of `𝔼₀`** in the paper's coordinates. -/
theorem pastHalf_le_iff (p : e0PastHalf) {a b : e0PastHalf} :
    (CE e0PastHalf).le ⊤ a b ↔ E0.Le (E0.paperOfY a) (E0.paperOfY b) := by
  have hU : (⊤ : Opens e0PastHalf) ≤ Causal.chartSource (paperChart p) := by
    rw [chartSource_paperChart_pastHalf]
  rw [((chartIso_paperChart p ⊤ hU a trivial b trivial).1)]
  constructor
  · intro h; exact E0.CLe.le h
  · intro h
    exact e0_le_of_le_top_of_fst_neg (fun w hw => (mem_chartImage_paperChart_pastHalf p w).2 hw)
      (E0.le_top_iff.2 h) (mem_e0PastHalf_iff.1 b.2).2

/-- **`{τ<0}` is globally hyperbolic** (D-11's first hypothesis): its charted causality is that of
`𝔼₀` restricted to `{τ<0}` (`pastHalf_le_iff`), `𝔼₀` is causal, and a diamond is the closed set
`J⁺(p) ∩ J⁻(q)` of `𝔼₀`, bounded by `dist ≤ 3Δτ` (`E0.Le.dist_le`). -/
theorem e0PastHalf_globallyHyperbolic : (CE e0PastHalf).GloballyHyperbolic := by
  refine ⟨fun a b hab hba => ?_, fun p q => ?_⟩
  · have h1 := (pastHalf_le_iff a).1 hab
    have h2 := (pastHalf_le_iff a).1 hba
    have := E0.isCausal (E0.le_top_iff.2 h1) (E0.le_top_iff.2 h2)
    apply Subtype.ext
    rw [← pastHalf_paperInY_paperOfY (mem_e0PastHalf_iff.1 a.2).1,
      ← pastHalf_paperInY_paperOfY (mem_e0PastHalf_iff.1 b.2).1, this]
  · set P := E0.paperOfY p
    set Q := E0.paperOfY q
    set K : Set E0 := E0.causality.Jplus ⊤ {P} ∩ E0.causality.Jminus ⊤ {Q}
    have hK : IsCompact K := by
      refine Metric.isCompact_of_isClosed_isBounded
        ((E0.isClosed_Jplus P).inter (E0.isClosed_Jminus Q)) ?_
      refine (Metric.isBounded_closedBall (x := P) (r := 3 * (Q.1 - P.1))).subset ?_
      rintro w ⟨hw1, hw2⟩
      rw [Causal.Precausality.mem_Jplus_singleton, E0.le_top_iff] at hw1
      rw [Causal.Precausality.mem_Jminus_singleton, E0.le_top_iff] at hw2
      rw [Metric.mem_closedBall, dist_comm]
      have := hw1.dist_le
      have := hw2.closed.1
      linarith
    rw [Subtype.isCompact_iff]
    have himg : ((↑) : e0PastHalf → E0Y) '' (CE e0PastHalf).diamond ⊤ p q = E0.paperInY '' K := by
      ext y
      constructor
      · rintro ⟨a, ⟨haq, hpa⟩, rfl⟩
        rw [Causal.Precausality.mem_Jminus_singleton, pastHalf_le_iff p] at haq
        rw [Causal.Precausality.mem_Jplus_singleton, pastHalf_le_iff p] at hpa
        refine ⟨E0.paperOfY a, ⟨?_, ?_⟩, pastHalf_paperInY_paperOfY (mem_e0PastHalf_iff.1 a.2).1⟩
        · rw [Causal.Precausality.mem_Jplus_singleton, E0.le_top_iff]; exact hpa
        · rw [Causal.Precausality.mem_Jminus_singleton, E0.le_top_iff]; exact haq
      · rintro ⟨w, ⟨hw1, hw2⟩, rfl⟩
        rw [Causal.Precausality.mem_Jplus_singleton, E0.le_top_iff] at hw1
        rw [Causal.Precausality.mem_Jminus_singleton, E0.le_top_iff] at hw2
        have hw : w.1 < 0 := hw2.closed.1.trans_lt (mem_e0PastHalf_iff.1 q.2).2
        have hmem : E0.paperInY w ∈ e0PastHalf := ⟨w, hw, rfl⟩
        refine ⟨⟨_, hmem⟩, ⟨?_, ?_⟩, rfl⟩
        · rw [Causal.Precausality.mem_Jminus_singleton, pastHalf_le_iff p]
          show E0.Le (E0.paperOfY (E0.paperInY w)) Q
          rw [pastHalf_paperOfY_paperInY]; exact hw2
        · rw [Causal.Precausality.mem_Jplus_singleton, pastHalf_le_iff p]
          show E0.Le P (E0.paperOfY (E0.paperInY w))
          rw [pastHalf_paperOfY_paperInY]; exact hw1
    rw [himg]
    exact hK.image_of_continuousOn (E0.paperInY.continuousOn.mono (by simp))

/-- `{τ<0}` has BTZ points (`s ≥ 1`): the axis point `(−1, 0)`. -/
theorem e0PastHalf_sing_nonempty : (Causal.CBG.chartedSing e0SingY e0PastHalf 0).Nonempty := by
  have hmem : E0.paperInY ((-1, 0) : E0) ∈ e0PastHalf := ⟨_, by norm_num, rfl⟩
  refine ⟨⟨_, hmem⟩, ?_⟩
  show E0.paperInY ((-1, 0) : E0) ∈ e0SingY 0
  refine ⟨rfl, ?_⟩
  rw [E0.paperInY_apply, inr_mem_e0Reg_iff, E0.mem_reg_iff_toPaper,
    Homeomorph.apply_symm_apply, not_not]
  rfl

end PastHalfGH

section AeChartLocal

open Filter Topology
open scoped Real
attribute [local instance] btzE0Structure

/-- Near a point of its source, a chart of `BTZE0`'s maximal a.e. atlas is `g •` the sector chart
`chartMap` (the step of `E0.chartIso_aeAtlas`). -/
theorem pastHalf_aeChart_eventually {c : OpenPartialHomeomorph BTZE0 (Causal.Minkowski 2)}
    (hc : c ∈ aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) {x : BTZE0}
    (hx : x ∈ c.source) :
    ∃ g : Causal.Flat.isom 2, ∀ᶠ z in 𝓝 x,
      c z = g • E0.chartMap (E0.toPaper x) (E0.toPaper z) := by
  set y := E0.toPaper x
  have hxr : x ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 :=
    mem_support.2 ⟨c, hc, hx⟩
  have hyax : y ∉ E0.axis := (E0.mem_reg_iff_toPaper x).1 hxr
  have hy : y.2 ≠ 0 := hyax
  set p : ℝ × ℝ × ℝ := (y.1, E0.rad y, E0.angle y y)
  have hpx : orbitMk (GammaA (2 * π)) (btzPaperCyl p) = x := by
    rw [← E0.toPaper_symm_eq_orbitMk hyax (E0.polar_angle hy y), Homeomorph.symm_apply_apply]
  obtain ⟨g, hg⟩ := btz_chart_eq_smul_btzPaperDev isBTZStructure_btzE0 hc
    (p := p) (E0.rad_pos.2 hyax) (by rw [hpx]; exact hx)
  set φ : BTZE0 → ℝ × ℝ × ℝ := fun z =>
    ((E0.toPaper z).1, E0.rad (E0.toPaper z), E0.angle y (E0.toPaper z))
  have hφ : ContinuousAt φ x := by
    have hang : ContinuousAt (E0.angle y) y :=
      (E0.continuousOn_angle y).continuousAt ((E0.isOpen_sector y).mem_nhds (E0.mem_sector_self hy))
    have h3 : ContinuousAt (fun z => E0.angle y (E0.toPaper z)) x :=
      ContinuousAt.comp (g := E0.angle y) (f := E0.toPaper) hang E0.toPaper.continuous.continuousAt
    exact (continuous_fst.comp E0.toPaper.continuous).continuousAt.prodMk
      ((E0.continuous_rad.comp E0.toPaper.continuous).continuousAt.prodMk h3)
  have h1 : ∀ᶠ z in 𝓝 x, c (orbitMk (GammaA (2 * π)) (btzPaperCyl (φ z))) =
      g • btzPaperDev (φ z) := hφ.eventually hg
  have h2 : ∀ᶠ z in 𝓝 x, E0.toPaper z ∈ E0.sector y :=
    E0.toPaper.continuous.continuousAt.preimage_mem_nhds
      ((E0.isOpen_sector y).mem_nhds (E0.mem_sector_self hy))
  refine ⟨g, ?_⟩
  filter_upwards [h1, h2] with z hz1 hz2
  have hzax : E0.toPaper z ∉ E0.axis := E0.not_mem_axis_of_mem_sector hz2
  have hz : orbitMk (GammaA (2 * π)) (btzPaperCyl (φ z)) = z := by
    rw [← E0.toPaper_symm_eq_orbitMk hzax (E0.polar_angle hy (E0.toPaper z)),
      Homeomorph.symm_apply_apply]
  rw [hz] at hz1
  rw [hz1, E0.chartMap_eq]

end AeChartLocal

/-- The null functional `t − x` of `𝐌³`; it reads `r` off the paper's developing map. -/
noncomputable def minkTMinusX : Causal.Minkowski 2 →ₗ[ℝ] ℝ :=
  LinearMap.fst ℝ ℝ _ -
    ((EuclideanSpace.proj (0 : Fin 2) : EuclideanSpace ℝ (Fin 2) →L[ℝ] ℝ) : _ →ₗ[ℝ] ℝ) ∘ₗ
      LinearMap.snd ℝ ℝ _

/-- `t − x` of the paper's developing map is `r`. -/
theorem minkTMinusX_btzPaperDev (p : ℝ × ℝ × ℝ) : minkTMinusX (btzPaperDev p) = p.2.1 := by
  simp [minkTMinusX, btzPaperDev]

/-- `t − x` of a sector chart is `r`. -/
theorem minkTMinusX_chartMap (y w : E0) : minkTMinusX (E0.chartMap y w) = E0.rad w := by
  rw [E0.chartMap_eq, minkTMinusX_btzPaperDev]


section AffineLocal

open Filter Topology

/-- **A locally affine reading through an open map is globally affine** on a preconnected space:
if near every point `F = a ∘ D` for some affine `a`, one `a` works everywhere (two affine maps
agreeing on the non-empty open `D(t)` are equal). -/
theorem exists_affine_eq_of_locally {X E : Type*} [TopologicalSpace X] [PreconnectedSpace X]
    [NormedAddCommGroup E] [NormedSpace ℝ E] {D : X → E} (hD : IsOpenMap D) {F : X → ℝ}
    (h : ∀ x, ∃ a : E →ᵃ[ℝ] ℝ, ∀ᶠ y in 𝓝 x, F y = a (D y)) :
    ∃ a : E →ᵃ[ℝ] ℝ, ∀ y, F y = a (D y) := by
  have huniq : ∀ (x : X) (a a' : E →ᵃ[ℝ] ℝ), (∀ᶠ y in 𝓝 x, F y = a (D y)) →
      (∀ᶠ y in 𝓝 x, F y = a' (D y)) → a = a' := by
    intro x a a' h1 h2
    obtain ⟨t, ht, hto, hxt⟩ := eventually_nhds_iff.1 (h1.and h2)
    refine AffineMap.ext_on ((hD t hto).affineSpan_eq_top ⟨D x, x, hxt, rfl⟩) ?_
    rintro _ ⟨y, hy, rfl⟩
    exact (ht y hy).1.symm.trans (ht y hy).2
  choose A hA using h
  have hlc : IsLocallyConstant A := by
    rw [IsLocallyConstant.iff_eventually_eq]
    intro x
    filter_upwards [(hA x).eventually_nhds] with y hy
    exact huniq y _ _ (hA y) hy
  cases isEmpty_or_nonempty X with
  | inl _ => exact ⟨0, fun y => isEmptyElim y⟩
  | inr hne =>
    obtain ⟨x₀⟩ := hne
    refine ⟨A x₀, fun y => ?_⟩
    rw [← hlc.apply_eq_of_preconnectedSpace y x₀]
    exact (hA y).self_of_nhds

end AffineLocal


section PastHalfRad

open Filter Topology

/-- **`r` is locally affine in `𝒟` on `Reg {τ<0}~`**: near every point, `r = a ∘ 𝒟` with `a` affine
(`r = t − x` on the paper's developing map, and every flat chart is `g •` it). -/
theorem pastHalf_rad_locally {x₀ : e0RegMFlat e0PastHalf}
    {D : Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀ → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat e0PastHalf) x₀) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ)
    (z : Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀) :
    ∃ a : Causal.Minkowski 2 →ᵃ[ℝ] ℝ, ∀ᶠ w in 𝓝 z, E0.rad (pastHalfPaper w) = a (D w) := by
  letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat e0PastHalf) x₀
  haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat e0PastHalf) x₀
  have hDl : Causal.Flat.IsLocalIsometry 2 D :=
    Causal.Flat.isLocalIsometry_iff_eventually.2 ⟨hpair.gx.1, hpair.gx.2⟩
  obtain ⟨g2, hg2⟩ := (Causal.Flat.isLocalIsometry_iff_eventually.1 hDl).2 z
  have hpl := Causal.Flat.isLocalIsometry_flatCover_proj (d := 2) (M := e0RegMFlat e0PastHalf) x₀
  obtain ⟨g1, hg1⟩ := (Causal.Flat.isLocalIsometry_iff_eventually.1 hpl).2 z
  set q := Causal.UniversalCover.proj (e0RegMFlat e0PastHalf) x₀ with hq
  set y : E0LM.e0RegM e0PastHalf := q z
  set pt : Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀ → E0Y :=
    fun w => (show E0LM.e0RegM e0PastHalf from q w).1.1 with hpt
  have hptc : Continuous pt :=
    continuous_subtype_val.comp (continuous_subtype_val.comp hpl.continuous)
  have hrange : ∀ w, pt w ∈ range Sum.inr := fun w => by
    rw [← E0.paperOfY_source]
    exact (mem_e0PastHalf_iff.1 (show E0LM.e0RegM e0PastHalf from q w).1.2).1
  obtain ⟨x, hx⟩ := hrange z
  have hsrc : Sum.inr x ∈ (E0LM.regAtlasChart y).source := by
    rw [hx]; exact E0LM.mem_regAtlasChart_source y
  obtain ⟨c', hc', hceq, hxc⟩ := exists_of_mem_e0Atlas_inr (E0LM.regAtlasChart_mem y) hsrc
  obtain ⟨g, hg⟩ := pastHalf_aeChart_eventually hc' hxc
  set φ := fun w => e0Inr.symm (pt w) with hφ
  have hφz : φ z = x := by simp only [hφ, ← hx, e0Inr_symm_inr]
  have hφc : ContinuousAt φ z := by
    refine ContinuousAt.comp (g := e0Inr.symm) ?_ hptc.continuousAt
    exact e0Inr.symm.continuousAt (by rw [e0Inr_symm_source]; exact hrange z)
  have hgφ : ∀ᶠ w in 𝓝 z, c' (φ w) = g • E0.chartMap (E0.toPaper x) (E0.toPaper (φ w)) :=
    hφc.preimage_mem_nhds (t := {u | c' u = g • E0.chartMap (E0.toPaper x) (E0.toPaper u)})
      (by rw [hφz]; exact hg)
  set h := g2 * g1⁻¹ * g
  refine ⟨minkTMinusX.toAffineMap.comp
    ((h⁻¹ : Causal.Flat.isom 2) : Causal.Minkowski 2 ≃ᵃ[ℝ] Causal.Minkowski 2).toAffineMap, ?_⟩
  filter_upwards [hg2, hg1, hgφ] with w h2 h1 h0
  have hchart : (chartAt (Causal.Minkowski 2) (q z)) (q w) = c' (φ w) := by
    show ((E0LM.regChartM y).subtypeRestr ⟨y⟩) (q w) = _
    rw [regChart_subtypeRestr_eq, hceq]
    rfl
  have hpap : E0.toPaper (φ w) = pastHalfPaper w := rfl
  have hDw : D w = h • E0.chartMap (E0.toPaper x) (pastHalfPaper w) := by
    rw [chartAt_self_eq, OpenPartialHomeomorph.refl_apply, id] at h2
    rw [hchart, h0, hpap] at h1
    have h1' : (chartAt (Causal.Minkowski 2) z) w =
        g1⁻¹ • g • E0.chartMap (E0.toPaper x) (pastHalfPaper w) := by
      rw [h1, inv_smul_smul]
    rw [h2, h1', ← mul_smul, ← mul_smul]
  show E0.rad (pastHalfPaper w) =
    minkTMinusX (((h⁻¹ : Causal.Flat.isom 2) : Causal.Minkowski 2 ≃ᵃ[ℝ] Causal.Minkowski 2) (D w))
  rw [← Causal.Flat.isom_smul_def, hDw, inv_smul_smul, minkTMinusX_chartMap]


/-- **The past half `{τ<0}` of `𝔼₀` is not future complete** (D-11, DEC-77; the conclusion of
`prop:globally_hyperbolic_cauchy_complete_manifolds` fails on `Reg {τ<0}`): for **every** developing
pair `(𝒟, ρ)` of `Reg {τ<0}` and every `z`, `𝒟(I⁺(z)) ≠ I⁺(𝒟 z)`. Globally `r = a ∘ 𝒟` with `a`
affine (`pastHalf_rad_locally`, `exists_affine_eq_of_locally`); along `I⁺(z)`, `r` increases strictly
and stays below `r(z) − 2τ(z)` (`E0.calculus_lt`, `τ < 0`), while `a(𝒟 z + t e₀)` is affine in `t`. -/
theorem e0PastHalf_not_isFutureComplete {x₀ : e0RegMFlat e0PastHalf}
    {D : Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀ → Causal.Minkowski 2}
    {ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat e0PastHalf) x₀) →* Causal.Flat.isom 2}
    (hpair : Causal.Flat.IsDevelopingPair x₀ D ρ)
    (z : Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀) :
    letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat e0PastHalf) x₀
    haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat e0PastHalf) x₀
    D '' (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀)).Iplus ⊤
      {z} ≠ (Causal.minkowski 2).Iplus ⊤ {D z} := by
  letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat e0PastHalf) x₀
  haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat e0PastHalf) x₀
  have hDl : Causal.Flat.IsLocalIsometry 2 D :=
    Causal.Flat.isLocalIsometry_iff_eventually.2 ⟨hpair.gx.1, hpair.gx.2⟩
  obtain ⟨a, ha⟩ := exists_affine_eq_of_locally hDl.isOpenMap (pastHalf_rad_locally hpair)
  intro hfc
  set e : Causal.Minkowski 2 := ((1 : ℝ), 0)
  have key : ∀ t : ℝ, 0 < t → E0.rad (pastHalfPaper z) < E0.rad (pastHalfPaper z) + t * a.linear e ∧
      E0.rad (pastHalfPaper z) + t * a.linear e <
        E0.rad (pastHalfPaper z) - 2 * (pastHalfPaper z).1 := by
    intro t ht
    have hq : D z + t • e ∈ (Causal.minkowski 2).Iplus ⊤ {D z} := by
      rw [Causal.Precausality.mem_Iplus_singleton, Causal.minkowski_lt_top_iff]
      simp [e, ht]
    rw [← hfc] at hq
    obtain ⟨w, hw, hDw⟩ := hq
    rw [Causal.Precausality.mem_Iplus_singleton] at hw
    obtain ⟨U, hU⟩ := pastHalf_cover_lt hw
    obtain ⟨hr, -, -, hf, -⟩ := E0.calculus_lt hU
    have hneg := pastHalfPaper_fst_neg w
    have hrw : E0.rad (pastHalfPaper w) = E0.rad (pastHalfPaper z) + t * a.linear e := by
      rw [ha w, ha z, hDw, add_comm (D z), ← vadd_eq_add, a.map_vadd, vadd_eq_add,
        a.linear.map_smul, smul_eq_mul, add_comm]
    rw [← hrw]
    refine ⟨hr, ?_⟩
    simp only [E0.fcoord] at hf
    linarith
  have hℓ : 0 < a.linear e := by
    have := (key 1 one_pos).1; linarith
  have hτ := pastHalfPaper_fst_neg z
  have := (key (-2 * (pastHalfPaper z).1 / a.linear e + 1) (by
    have : 0 < -2 * (pastHalfPaper z).1 / a.linear e := div_pos (by linarith) hℓ
    linarith)).2
  rw [add_mul, div_mul_cancel₀ _ hℓ.ne'] at this
  linarith

/-- **D-11's counterexample to `prop:globally_hyperbolic_cauchy_complete_manifolds` as printed**
(DEC-27, DEC-77): the past half `{τ<0}` of `𝔼₀` is a globally hyperbolic `𝔼₀`-manifold with BTZ
points (`s ≥ 1`), and the conclusion of the corrected proposition (`btz_reg_isFutureComplete`)
fails on it: for **every** developing pair `(𝒟, ρ)` of `Reg {τ<0}` and **every** `z ∈ Reg {τ<0}~`,
`𝒟(I⁺(z)) ≠ I⁺(𝒟 z)`; in particular `Reg {τ<0}~` is not future complete. Its Cauchy surface
`{τ = −1}` carries the flat complete metric `dr² + r²dθ²` (DEC-31's Cauchy-completeness of the
paper's hypothesis, `e0PastHalf_isE0CauchyComplete`, `e0PastHalf_counterexample_DEC31`). It is
neither Cauchy-compact nor
Cauchy-maximal (`{τ<0} ⊂ 𝔼₀` is a Cauchy embedding), and `π₁(Reg {τ<0}) ≅ ℤ`. -/
theorem e0PastHalf_counterexample :
    (CE e0PastHalf).GloballyHyperbolic ∧ (Causal.CBG.chartedSing e0SingY e0PastHalf 0).Nonempty ∧
      ∀ (x₀ : e0RegMFlat e0PastHalf)
        (D : Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀ → Causal.Minkowski 2)
        (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat e0PastHalf) x₀) →*
          Causal.Flat.isom 2),
        Causal.Flat.IsDevelopingPair x₀ D ρ →
          letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat e0PastHalf) x₀
          haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat e0PastHalf) x₀
          ¬ IsFutureComplete
            (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀)) D :=
  ⟨e0PastHalf_globallyHyperbolic, e0PastHalf_sing_nonempty, fun x₀ _ _ hpair hfc =>
    e0PastHalf_not_isFutureComplete hpair (Causal.UniversalCover.base x₀) (hfc _).2⟩

/-- The slice `{τ = −1}` of `{τ<0}` (paper time `−1`). -/
def e0PastHalfSlice : Set e0PastHalf := {y | (E0.paperOfY (y : E0Y)).1 = -1}

/-! #### DEC-31 for `{τ<0}`: the slice `{τ = −1}` (SCOPE (c))

(i) Cauchy: `{τ = −1} ∩ {τ<0}` is a Cauchy surface of `{τ<0} ⊆ 𝔼₀` (an inextensible causal curve
of `{τ<0}` with `τ` bounded away from the level on one side has a limit in `{τ<0}` at that end, by
the monotonicity of `τ`, `r` — the argument of `E0.isCauchySurfaceOn_sliceDom`), transported to
`(CE {τ<0})` by the paper chart (`isCauchySurfaceOn_image_iff`). (ii) Spacelike Lipschitz: near a
regular point the flat chart of `Reg {τ<0}` is `g •` a sector chart (`pastHalf_regChart_eventually`)
and the slice's chart picture is the zero set of `chartHeight (−1) g`, cone-increasing
(`E0Surgery.fderiv_chartHeight_pos` with `spacelikeDelta 0 0 r = 1`). -/

section SliceCauchy

open TopologicalSpace Filter Topology
open scoped Real ENNReal NNReal

/-- `{τ < 0}` as an open set of `𝔼₀` (paper coordinates). -/
def e0PastOpen : Opens E0 := ⟨{z | z.1 < 0}, isOpen_lt continuous_fst continuous_const⟩

theorem mem_e0PastOpen {z : E0} : z ∈ e0PastOpen ↔ z.1 < 0 := Iff.rfl

/-- Paper time increases strictly along `≤` of `𝔼₀`. -/
theorem e0_fst_lt_of_le {x y : E0} (h : E0.causality.le ⊤ x y) (hne : x ≠ y) : x.1 < y.1 := by
  have hd := (E0.le_top_iff.1 h).dist_le
  rcases (E0.calculus_le h).2.2.1.lt_or_eq with h' | h'
  · exact h'
  · exfalso; apply hne; rw [h', sub_self, mul_zero] at hd; exact dist_le_zero.1 hd

theorem e0_pastExtensible_pastOpen {J : Set ℝ} {γ : ℝ → E0}
    (hγ : E0.causality.CausalCurveIn e0PastOpen J γ) (hJ : BddBelow J)
    (hT : ∀ u ∈ J, -1 < (γ u).1) : E0.causality.PastExtensible e0PastOpen J γ := by
  by_cases hmin : ∃ a', IsLeast J a'
  · obtain ⟨a', ha⟩ := hmin
    exact Causal.Causality.pastExtensible_of_isLeast E0.causallyArcConnected E0.isCausal hγ ha
      (E0.Jminus_ne_singleton (hγ.mem ha.1))
  have hglb : IsGLB J (sInf J) := isGLB_csInf hγ.nonempty hJ
  have hαJ : sInf J ∉ J := fun hα => hmin ⟨_, hα, hglb.1⟩
  have hgt : ∀ u ∈ J, sInf J < u := fun u hu =>
    lt_of_le_of_ne (hglb.1 hu) fun he => hαJ (he ▸ hu)
  have hle := E0.le_of_le_top_curve hγ
  obtain ⟨u₀, hu₀⟩ := hγ.nonempty
  have hbdd : BddBelow ((fun u => (γ u).1) '' J) :=
    ⟨-1, by rintro _ ⟨u, hu, rfl⟩; exact (hT u hu).le⟩
  obtain ⟨p, hp⟩ := E0.exists_tendsto_of_bddBelow
    (fun u hu u' hu' h => E0.le_top_iff.1 (hle u hu u' hu' h))
    hγ.nonempty hγ.ordConnected hglb hαJ hbdd
  have hsub := Causal.Flat.Ioo_subset_of_isGLB hγ.ordConnected hglb hu₀
  have hpz : E0.causality.le ⊤ p (γ u₀) := by
    refine Causal.Precausality.mem_Jminus_singleton.1
      ((E0.isClosed_Jminus (γ u₀)).mem_of_tendsto hp ?_)
    filter_upwards [Ioo_mem_nhdsGT (hgt u₀ hu₀)] with u hu
    exact Causal.Precausality.mem_Jminus_singleton.2 (hle u (hsub hu) u₀ hu₀ hu.2.le)
  have hpN : p ∈ e0PastOpen :=
    lt_of_le_of_lt (E0.calculus_le hpz).2.2.1 (mem_e0PastOpen.1 (hγ.mem hu₀))
  exact Causal.Causality.pastExtensible_of_tendsto_opens E0.isClosed_Jminus E0.stronglyCausal
    E0.causallyArcConnected E0.isCausal hγ hpN hgt
    (Causal.Flat.ordConnected_insert_of_isGLB hγ.ordConnected hglb) hp (E0.Jminus_ne_singleton hpN)

theorem e0_futureExtensible_pastOpen {J : Set ℝ} {γ : ℝ → E0}
    (hγ : E0.causality.CausalCurveIn e0PastOpen J γ) (hJ : BddAbove J)
    (hT : ∀ u ∈ J, (γ u).1 < -1) : E0.causality.FutureExtensible e0PastOpen J γ := by
  by_cases hmax : ∃ b', IsGreatest J b'
  · obtain ⟨b', hb⟩ := hmax
    exact Causal.Causality.futureExtensible_of_isGreatest E0.causallyArcConnected E0.isCausal hγ hb
      (E0.Jplus_ne_singleton (hγ.mem hb.1))
  have hlub : IsLUB J (sSup J) := isLUB_csSup hγ.nonempty hJ
  have hβJ : sSup J ∉ J := fun hβ => hmax ⟨_, hβ, hlub.1⟩
  have hlt : ∀ u ∈ J, u < sSup J := fun u hu =>
    lt_of_le_of_ne (hlub.1 hu) fun he => hβJ (he ▸ hu)
  have hle := E0.le_of_le_top_curve hγ
  obtain ⟨u₀, hu₀⟩ := hγ.nonempty
  have hbdd : BddAbove ((fun u => (γ u).1) '' J) :=
    ⟨-1, by rintro _ ⟨u, hu, rfl⟩; exact (hT u hu).le⟩
  obtain ⟨p, hp⟩ := E0.exists_tendsto_of_bddAbove
    (fun u hu u' hu' h => E0.le_top_iff.1 (hle u hu u' hu' h))
    hγ.nonempty hγ.ordConnected hlub hβJ hbdd
  have hsub := Causal.Flat.Ioo_subset_of_isLUB hγ.ordConnected hlub hu₀
  have hev : ∀ᶠ u in 𝓝[<] (sSup J), u ∈ J :=
    mem_of_superset (Ioo_mem_nhdsLT (hlt u₀ hu₀)) hsub
  have hp1 : p.1 ≤ -1 := (isClosed_le continuous_fst continuous_const).mem_of_tendsto hp
    (hev.mono fun u hu => (hT u hu).le)
  have hpN : p ∈ e0PastOpen := mem_e0PastOpen.2 (by linarith)
  exact Causal.Causality.futureExtensible_of_tendsto_opens E0.isClosed_Jplus E0.stronglyCausal
    E0.causallyArcConnected E0.isCausal hγ hpN hlt
    (Causal.Flat.ordConnected_insert_of_isLUB hγ.ordConnected hlub) hp (E0.Jplus_ne_singleton hpN)

/-- **`{τ = −1}` is a Cauchy surface of `{τ < 0} ⊆ 𝔼₀`**. -/
theorem e0_isCauchySurfaceOn_pastOpen :
    E0.causality.IsCauchySurfaceOn e0PastOpen ({z : E0 | z.1 = -1} ∩ e0PastOpen) := by
  intro I γ hγ
  have hle := E0.le_of_le_top_curve hγ.1
  obtain ⟨hpi, hfi⟩ := Causal.Causality.inextensible_iff.1 hγ
  obtain ⟨hd, hsub, htan, hpast, hfut⟩ := hγ.1.arctanReparam
  have hbb : BddBelow (Real.arctan '' I) := ⟨-(Real.pi / 2), fun u hu => (hsub hu).1.le⟩
  have hba : BddAbove (Real.arctan '' I) := ⟨Real.pi / 2, fun u hu => (hsub hu).2.le⟩
  obtain ⟨s₁, hs₁, h₁⟩ : ∃ s ∈ I, (γ s).1 ≤ -1 := by
    by_contra hcon
    push Not at hcon
    exact hpi.2 (hpast (e0_pastExtensible_pastOpen hd hbb fun u hu => hcon _ (htan u hu)))
  obtain ⟨s₂, hs₂, h₂⟩ : ∃ s ∈ I, -1 ≤ (γ s).1 := by
    by_contra hcon
    push Not at hcon
    exact hfi.2 (hfut (e0_futureExtensible_pastOpen hd hba fun u hu => hcon _ (htan u hu)))
  have hex : ∃ s ∈ I, (γ s).1 = -1 := by
    rcases le_total s₁ s₂ with h12 | h21
    · have hIcc : Icc s₁ s₂ ⊆ I := hγ.1.ordConnected.out hs₁ hs₂
      have hcont : ContinuousOn (fun s => (γ s).1) (Icc s₁ s₂) :=
        continuous_fst.comp_continuousOn (hγ.1.continuousOn_Icc hs₁ hs₂)
      obtain ⟨s, hs, hs0⟩ := intermediate_value_Icc h12 hcont ⟨h₁, h₂⟩
      exact ⟨s, hIcc hs, hs0⟩
    · have := (E0.calculus_le (hle s₂ hs₂ s₁ hs₁ h21)).2.2.1
      exact ⟨s₂, hs₂, le_antisymm (this.trans h₁) h₂⟩
  obtain ⟨s, hs, hsc⟩ := hex
  refine ⟨γ s, ⟨⟨s, hs, rfl⟩, hsc, hγ.1.mem hs⟩, ?_⟩
  rintro _ ⟨⟨s', hs', rfl⟩, hs'c, -⟩
  have hs'c' : (γ s').1 = -1 := hs'c
  by_contra hne
  rcases le_total s s' with h | h
  · have := e0_fst_lt_of_le (hle s hs s' hs' h) (Ne.symm hne)
    rw [hsc, hs'c'] at this; exact lt_irrefl _ this
  · have := e0_fst_lt_of_le (hle s' hs' s hs h) hne
    rw [hsc, hs'c'] at this; exact lt_irrefl _ this

theorem paperChart_pastHalf_apply (p a : e0PastHalf) :
    paperChart p a = E0.paperOfY (a : E0Y) := by
  show E0.paperOfY ((chartAt E0Y (p : E0Y)).subtypeRestr ⟨p⟩ a) = _
  rw [OpenPartialHomeomorph.subtypeRestr_coe]
  rfl

/-- **`{τ = −1}` is a Cauchy surface of `{τ<0}`** (SCOPE (c), piece (i)). -/
theorem e0PastHalfSlice_isCauchySurface : (CE e0PastHalf).IsCauchySurface e0PastHalfSlice := by
  set p : e0PastHalf := ⟨E0.paperInY ((-1, 0) : E0), ⟨_, by norm_num, rfl⟩⟩
  have hsrc : (⊤ : Opens e0PastHalf) ≤ Causal.chartSource (paperChart p) := by
    rw [chartSource_paperChart_pastHalf]
  have hU : ((e0PastOpen : Opens E0) : Set E0) = paperChart p '' ((⊤ : Opens e0PastHalf) : Set _) := by
    rw [← Causal.coe_chartImage_of_le hsrc]
    ext w
    rw [SetLike.mem_coe, SetLike.mem_coe, mem_chartImage_paperChart_pastHalf]
    rfl
  have himg : paperChart p '' e0PastHalfSlice = {z : E0 | z.1 = -1} ∩ e0PastOpen := by
    ext w
    constructor
    · rintro ⟨a, ha, rfl⟩
      rw [paperChart_pastHalf_apply]
      exact ⟨ha, (mem_e0PastHalf_iff.1 a.2).2⟩
    · rintro ⟨hw, hw0⟩
      refine ⟨⟨E0.paperInY w, w, hw0, rfl⟩, ?_, ?_⟩
      · show (E0.paperOfY (E0.paperInY w)).1 = -1
        rw [pastHalf_paperOfY_paperInY]; exact hw
      · rw [paperChart_pastHalf_apply]; exact pastHalf_paperOfY_paperInY w
  have := ((isEMorphismOn_of_chartIso (chartIso_paperChart p)).isCauchySurfaceOn_image_iff
    (paperChart p).injOn hsrc hU (S := e0PastHalfSlice) (fun _ _ => trivial)).2
  rw [himg] at this
  exact this e0_isCauchySurfaceOn_pastOpen

/-- The paper coordinates of a point of `Reg {τ<0}`. -/
noncomputable def pastHalfPt (z : e0RegMFlat e0PastHalf) : E0 :=
  E0.paperOfY ((E0Surgery.regVal e0PastHalf z : e0PastHalf) : E0Y)

attribute [local instance] btzE0Structure in
/-- **The flat charts of `Reg {τ<0}`** are, near every point `y`, `g •` the sector chart
`chartMap` at the paper coordinates of `y`. -/
theorem pastHalf_regChart_eventually (y : e0RegMFlat e0PastHalf) :
    (pastHalfPt y).2 ≠ 0 ∧ ∃ g : Causal.Flat.isom 2, ∀ᶠ z in 𝓝 y,
      z ∈ (chartAt (Causal.Minkowski 2) y).source ∧
      chartAt (Causal.Minkowski 2) y z = g • E0.chartMap (pastHalfPt y) (pastHalfPt z) := by
  set y' : E0LM.e0RegM e0PastHalf := y
  set pt : e0RegMFlat e0PastHalf → E0Y := fun w => (show E0LM.e0RegM e0PastHalf from w).1.1
    with hpt
  have hptc : Continuous pt := continuous_subtype_val.comp continuous_subtype_val
  have hrange : ∀ w, pt w ∈ range Sum.inr := fun w => by
    rw [← E0.paperOfY_source]
    exact (mem_e0PastHalf_iff.1 (show E0LM.e0RegM e0PastHalf from w).1.2).1
  obtain ⟨x, hx⟩ := hrange y
  have hsrc : Sum.inr x ∈ (E0LM.regAtlasChart y').source := by
    rw [hx]; exact E0LM.mem_regAtlasChart_source y'
  obtain ⟨c', hc', hceq, hxc⟩ := exists_of_mem_e0Atlas_inr (E0LM.regAtlasChart_mem y') hsrc
  obtain ⟨g, hg⟩ := pastHalf_aeChart_eventually hc' hxc
  set φ := fun w => e0Inr.symm (pt w) with hφ
  have hφz : φ y = x := by simp only [hφ, ← hx, e0Inr_symm_inr]
  have hφc : ContinuousAt φ y := by
    refine ContinuousAt.comp (g := e0Inr.symm) ?_ hptc.continuousAt
    exact e0Inr.symm.continuousAt (by rw [e0Inr_symm_source]; exact hrange y)
  have hgφ : ∀ᶠ w in 𝓝 y, c' (φ w) = g • E0.chartMap (E0.toPaper x) (E0.toPaper (φ w)) :=
    hφc.preimage_mem_nhds (t := {u | c' u = g • E0.chartMap (E0.toPaper x) (E0.toPaper u)})
      (by rw [hφz]; exact hg)
  have hxy : E0.toPaper x = pastHalfPt y := by
    rw [← hφz]; rfl
  refine ⟨?_, g, ?_⟩
  · rw [← hxy]
    have hxr : x ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 :=
      mem_support.2 ⟨c', hc', hxc⟩
    exact (E0.mem_reg_iff_toPaper x).1 hxr
  filter_upwards [hgφ, (chartAt (Causal.Minkowski 2) y).open_source.mem_nhds
    (mem_chart_source _ y)] with w h0 hws
  refine ⟨hws, ?_⟩
  have hchart : (chartAt (Causal.Minkowski 2) y) w = c' (φ w) := by
    show ((E0LM.regChartM y').subtypeRestr ⟨y'⟩) w = _
    rw [E0AbsMax.regChart_subtypeRestr_eq, hceq]
    rfl
  rw [hchart, h0, hxy]
  rfl

open scoped Pointwise in
/-- **`{τ = −1}` is spacelike Lipschitz in the flat charts of `Reg {τ<0}`** (SCOPE (c), piece
(ii)): near a point, its chart picture is the zero set of the height `chartHeight (−1) g`
(`τ + 1` read through `g⁻¹` and the sector chart), whose derivative is positive on the future
causal cone (Lemma 2.7 for the constant graph, `spacelikeDelta 0 0 r = 1`). -/
theorem e0PastHalfSlice_isSpacelikeLipschitz :
    Causal.Flat.IsSpacelikeLipschitz 2 (E0Surgery.regSet e0PastHalf e0PastHalfSlice) := by
  intro y hyT
  obtain ⟨hx0, g, hg⟩ := pastHalf_regChart_eventually y
  set x := pastHalfPt y with hxdef
  set e := chartAt (Causal.Minkowski 2) y with he
  set G : ℝ × ℝ → ℝ := fun _ => -1 with hG
  have hper : ∀ r θ, G (r, θ + 2 * π) = G (r, θ) := fun _ _ => rfl
  have hGs : ContDiffOn ℝ 1 G {q | 0 < q.1} := contDiffOn_const
  set pp : ℝ × ℝ × ℝ := (x.1, E0.rad x, E0.angle x x) with hpp
  have hrx : 0 < E0.rad x := E0.rad_pos.2 hx0
  have hp₀ : e y = g • nullToMink (btzPaperNull pp) := by
    rw [(hg.self_of_nhds).2]; rfl
  have hQ₀ : E0Surgery.chartNull g (e y) = btzPaperNull pp := by
    rw [hp₀]; simp [E0Surgery.chartNull]
  have hp₀U : e y ∈ {p : Causal.Minkowski 2 | 0 < (E0Surgery.chartNull g p).2.1} := by
    show 0 < (E0Surgery.chartNull g (e y)).2.1; rw [hQ₀]; exact hrx
  obtain ⟨ε, hε, c, hc0, hc1, hballU, hinc⟩ := E0Surgery.exists_ball_isConeIncreasingOn
    (E0Surgery.isOpen_chartPos g) (E0Surgery.contDiffOn_chartHeight hper hGs g) hp₀U (by
      intro v hv0 hv
      rw [hp₀]
      exact E0Surgery.fderiv_chartHeight_pos hper hGs g hrx (hasFDerivAt_const (-1 : ℝ) _)
        (by simp [E0Surgery.spacelikeDelta]) hv0 hv)
  have hys : y ∈ e.source := mem_chart_source _ y
  have hev : ∀ᶠ p in 𝓝 (e y), p ∈ e.target ∧ (e.symm p ∈ e.source ∧
      e (e.symm p) = g • E0.chartMap x (pastHalfPt (e.symm p))) := by
    have h1 : ∀ᶠ p in 𝓝 (e y), p ∈ e.target := e.open_target.mem_nhds (e.map_source hys)
    have hc := e.continuousAt_symm (e.map_source hys)
    have h2 : ∀ᶠ p in 𝓝 (e y), e.symm p ∈ {z | z ∈ e.source ∧
        e z = g • E0.chartMap x (pastHalfPt z)} :=
      hc.preimage_mem_nhds (by rw [e.left_inv hys]; exact hg)
    exact h1.and h2
  obtain ⟨ε', hε', hball'⟩ := Metric.eventually_nhds_iff_ball.1 hev
  set W := Metric.ball (e y) (min ε ε') with hW
  have hWε : W ⊆ Metric.ball (e y) ε := Metric.ball_subset_ball (min_le_left _ _)
  have hWε' : W ⊆ Metric.ball (e y) ε' := Metric.ball_subset_ball (min_le_right _ _)
  refine E0Surgery.isSpacelikeLipschitzAt_of_coneZeroSet (g := 1) Metric.isOpen_ball
    (Metric.mem_ball_self (lt_min hε hε')) (fun p hp => (hball' p (hWε' hp)).1)
    ((E0Surgery.contDiffOn_chartHeight hper hGs g).continuousOn.mono fun p hp => hballU (hWε hp))
    hc0 hc1 (by simpa only [inv_one, one_smul] using hinc.mono le_rfl hWε) ?_ hyT
  intro p hp
  obtain ⟨hpt, hzs, hze⟩ := hball' p (hWε' hp)
  set z := e.symm p with hz
  have hez : e z = p := e.right_inv hpt
  have hFp : E0Surgery.chartHeight G g p = (pastHalfPt z).1 + 1 := by
    have h1 : E0Surgery.chartHeight G g p =
        E0Surgery.nullHeight G (nullToMink.symm (E0.chartMap x (pastHalfPt z))) := by
      simp only [E0Surgery.chartHeight]
      rw [← hez, hze, inv_smul_smul]
    rw [h1, E0Surgery.nullHeight, E0.unlift_symm_chartMap hx0]
    simp [E0Surgery.height, E0Surgery.heightAt, hG]
  constructor
  · rintro ⟨z', ⟨hz'T, hz's⟩, hz'p⟩
    have hzz : z' = z := e.injOn hz's hzs (hz'p.trans hez.symm)
    rw [hzz] at hz'T
    have : (pastHalfPt z).1 = -1 := hz'T
    rw [hFp, this]; norm_num
  · intro h0
    refine ⟨z, ⟨?_, hzs⟩, hez⟩
    show (pastHalfPt z).1 = -1
    rw [hFp] at h0; linarith

/-! (iii) Completeness and continuity. In the coordinate `z ∈ ℂ` of the slice, the length chart
system `e0SliceSys` reads a curve, near a regular time, through `g •` the sector chart along
`τ = −1` (`e0SliceSys_pastSlice_eventually`), whose velocity has Minkowski norm `‖ż‖`
(`hasDerivAt_chartMap_slice`: `dr² + r²dθ² = |dz|²`); at a BTZ time the density is `0`. Lower
bound: on a zero-free interval `z` is Lipschitz (`lipschitz_pastSliceZ_near`) and the FTC gives
`‖Δz‖ ≤ ∫ ‖ż‖`; across the zeros `ofReal_norm_sub_le_of_zeroFree`. Upper bound: the straight
segment (`pathLength_pastSliceSegment_le`). So the length metric is the Euclidean metric of `ℂ`
(`edist_e0SliceSys_pastSlice`). -/

/-- **The sector chart along the slice `τ = −1`**: for a curve `f` of `ℂ` through the sector of
`x` (`x.2 ≠ 0`), `s ↦ chartMap x (−1, f s)` is differentiable where `f` is, with a velocity of
Minkowski norm `‖f'‖` (the induced metric of `{τ = −1}` is `dr² + r²dθ² = |dz|²`). -/
theorem hasDerivAt_chartMap_slice {x : E0} (hx : x.2 ≠ 0) {f : ℝ → ℂ} {f' : ℂ} {t : ℝ}
    (hf : HasDerivAt f f' t) (hslit : f t / x.2 ∈ Complex.slitPlane) :
    ∃ V : Causal.Minkowski 2, HasDerivAt (fun s => E0.chartMap x ((-1 : ℝ), f s)) V t ∧
      Causal.Flat.minkQ V = ‖f'‖ ^ 2 := by
  have hft : f t ≠ 0 := by
    intro h; rw [h, zero_div] at hslit; exact Complex.slitPlane_ne_zero hslit rfl
  set L : ℝ → ℂ := fun s => Complex.log (f s / x.2) with hLdef
  set q : ℂ := f' / f t with hq
  have hL : HasDerivAt L q t := by
    have := (hf.div_const x.2).clog_real hslit
    convert this using 1
    rw [hq]; field_simp
  -- the radius
  have hfev : ∀ᶠ s in 𝓝 t, f s ≠ 0 := hf.continuousAt.eventually_ne hft
  have hρeq : (fun s => ‖x.2‖ * Real.exp (L s).re) =ᶠ[𝓝 t] fun s => ‖f s‖ := by
    filter_upwards [hfev] with s hs
    simp only [hLdef, Complex.log_re, norm_div]
    rw [Real.exp_log (div_pos (norm_pos_iff.2 hs) (norm_pos_iff.2 hx))]
    field_simp
  have hρ0 : HasDerivAt (fun s => ‖x.2‖ * Real.exp (L s).re)
      (‖x.2‖ * (Real.exp (L t).re * q.re)) t := by
    have h1 : HasDerivAt (fun s => (L s).re) q.re t := by
      have := Complex.reCLM.hasFDerivAt.comp_hasDerivAt t hL
      exact this
    exact h1.exp.const_mul _
  have hρt : ‖x.2‖ * Real.exp (L t).re = ‖f t‖ := hρeq.self_of_nhds
  have hρ : HasDerivAt (fun s => ‖f s‖) (‖f t‖ * q.re) t := by
    have := hρ0.congr_of_eventuallyEq hρeq.symm
    rw [show ‖f t‖ * q.re = ‖x.2‖ * (Real.exp (L t).re * q.re) by rw [← hρt]; ring]
    exact this
  -- the angle
  have hθ : HasDerivAt (fun s => Complex.arg x.2 + Complex.arg (f s / x.2)) q.im t := by
    have h1 : HasDerivAt (fun s => (L s).im) q.im t := by
      have := Complex.imCLM.hasFDerivAt.comp_hasDerivAt t hL
      exact this
    have := h1.const_add (Complex.arg x.2)
    simpa [hLdef, Complex.log_im] using this
  set ρ : ℝ := ‖f t‖ with hρdef
  set θ : ℝ := Complex.arg x.2 + Complex.arg (f t / x.2) with hθdef
  set ρ' : ℝ := ρ * q.re
  set θ' : ℝ := q.im
  have hN : HasDerivAt (fun s => btzPaperNull ((-1 : ℝ), ‖f s‖,
      Complex.arg x.2 + Complex.arg (f s / x.2)))
      (ρ' * θ ^ 2 + ρ * (2 * θ * θ') - ρ', ρ', -(ρ' * θ + ρ * θ')) t := by
    have h1 : HasDerivAt (fun s => 2 * (-1 : ℝ) + ‖f s‖ *
        (Complex.arg x.2 + Complex.arg (f s / x.2)) ^ 2 - ‖f s‖)
        (ρ' * θ ^ 2 + ρ * (2 * θ * θ') - ρ') t := by
      have hsq := hθ.pow 2
      have := ((hρ.mul hsq).const_add (2 * (-1 : ℝ))).sub hρ
      convert this using 1
      all_goals first | rfl | (simp only [Pi.pow_apply, hθdef, hρdef]; ring)
    have h3 : HasDerivAt (fun s => -(‖f s‖ * (Complex.arg x.2 + Complex.arg (f s / x.2))))
        (-(ρ' * θ + ρ * θ')) t := by
      have := (hρ.mul hθ).neg
      convert this using 1
      all_goals rfl
    exact h1.prodMk (hρ.prodMk h3)
  refine ⟨nullToMink (ρ' * θ ^ 2 + ρ * (2 * θ * θ') - ρ', ρ', -(ρ' * θ + ρ * θ')), ?_, ?_⟩
  · have hcl := (LinearMap.toContinuousLinearMap
      (nullToMink : (ℝ × ℝ × ℝ) →ₗ[ℝ] Causal.Minkowski 2)).hasFDerivAt.comp_hasDerivAt t hN
    exact hcl
  · rw [minkQ_nullToMink, nullQ]
    have hnq : ‖q‖ ^ 2 = q.re ^ 2 + q.im ^ 2 := by
      rw [Complex.sq_norm, Complex.normSq_apply]; ring
    have hqn : ‖q‖ * ρ = ‖f'‖ := by
      rw [hq, norm_div, div_mul_cancel₀ _ (norm_pos_iff.2 hft).ne']
    have : ‖f'‖ ^ 2 = ρ ^ 2 * (q.re ^ 2 + q.im ^ 2) := by
      rw [← hnq, ← hqn]; ring
    rw [this]
    simp only [ρ', θ']
    ring



/-- The coordinate `z ∈ ℂ` of a point of the slice `{τ = −1}`. -/
noncomputable def pastSliceZ (s : e0PastHalfSlice) : ℂ := (E0.paperOfY ((s : e0PastHalf) : E0Y)).2

theorem paperOfY_pastSlice (s : e0PastHalfSlice) :
    E0.paperOfY ((s : e0PastHalf) : E0Y) = ((-1 : ℝ), pastSliceZ s) :=
  Prod.ext s.2 rfl

/-- The point `(−1, w)` of the slice. -/
noncomputable def pastSlicePt (w : ℂ) : e0PastHalfSlice :=
  ⟨⟨E0.paperInY ((-1 : ℝ), w), ⟨((-1 : ℝ), w), by norm_num, rfl⟩⟩,
    show (E0.paperOfY (E0.paperInY ((-1 : ℝ), w))).1 = -1 by rw [pastHalf_paperOfY_paperInY]⟩

theorem pastSliceZ_pastSlicePt (w : ℂ) : pastSliceZ (pastSlicePt w) = w := by
  show (E0.paperOfY (E0.paperInY ((-1 : ℝ), w))).2 = w
  rw [pastHalf_paperOfY_paperInY]

theorem pastSlicePt_pastSliceZ (s : e0PastHalfSlice) : pastSlicePt (pastSliceZ s) = s := by
  apply Subtype.ext; apply Subtype.ext
  show E0.paperInY ((-1 : ℝ), pastSliceZ s) = ((s : e0PastHalf) : E0Y)
  rw [← paperOfY_pastSlice, pastHalf_paperInY_paperOfY (mem_e0PastHalf_iff.1 (s : e0PastHalf).2).1]

theorem continuous_pastSliceZ : Continuous pastSliceZ := by
  have h : ContinuousOn E0.paperOfY (range ((↑) : e0PastHalf → E0Y)) :=
    E0.paperOfY.continuousOn.mono (by
      rintro _ ⟨a, rfl⟩; exact (mem_e0PastHalf_iff.1 a.2).1)
  exact continuous_snd.comp (h.comp_continuous (continuous_subtype_val.comp continuous_subtype_val)
    fun s => ⟨_, rfl⟩)

theorem continuous_pastSlicePt : Continuous pastSlicePt := by
  refine Continuous.subtype_mk (Continuous.subtype_mk ?_ _) _
  exact E0.paperInY.continuousOn.comp_continuous (continuous_const.prodMk continuous_id)
    (fun _ => by simp)

/-- A point of `{τ<0}` is regular iff it is off the BTZ line. -/
theorem mem_e0RegM_pastHalf_iff (a : e0PastHalf) :
    a ∈ E0LM.e0RegM e0PastHalf ↔ (E0.paperOfY (a : E0Y)).2 ≠ 0 := by
  rw [E0LM.mem_e0RegM_iff (mem_chart_source E0Y a)]
  show (a : E0Y) ∈ e0Reg ↔ _
  rw [← pastHalf_paperInY_paperOfY (mem_e0PastHalf_iff.1 a.2).1, E0.paperInY_mem_e0Reg_iff,
    pastHalf_paperOfY_paperInY]
  rfl

theorem pastSliceReg_iff (s : e0PastHalfSlice) :
    ((s : e0PastHalf)) ∈ E0LM.e0RegM e0PastHalf ↔ pastSliceZ s ≠ 0 :=
  mem_e0RegM_pastHalf_iff _

/-- **The length chart system of the slice near a regular point** is `g •` the sector chart along
`τ = −1`. -/
theorem e0SliceSys_pastSlice_eventually {s₀ : e0PastHalfSlice} (h0 : pastSliceZ s₀ ≠ 0) :
    ∃ g : Causal.Flat.isom 2, ∀ᶠ s in 𝓝 s₀, e0SliceSys e0PastHalfSlice s₀ s =
      g • E0.chartMap ((-1 : ℝ), pastSliceZ s₀) ((-1 : ℝ), pastSliceZ s) := by
  have hreg := (pastSliceReg_iff s₀).2 h0
  set y : e0RegMFlat e0PastHalf := (⟨(s₀ : e0PastHalf), hreg⟩ : E0LM.e0RegM e0PastHalf)
  obtain ⟨-, g, hg⟩ := pastHalf_regChart_eventually y
  refine ⟨g, ?_⟩
  have hR : IsOpen ((E0LM.e0RegM e0PastHalf : Set e0PastHalf)) := (E0LM.e0RegM e0PastHalf).isOpen
  have h1 : ∀ᶠ a in 𝓝 (s₀ : e0PastHalf), ∀ (ha : a ∈ E0LM.e0RegM e0PastHalf),
      chartAt (Causal.Minkowski 2) y (show e0RegMFlat e0PastHalf from
        (⟨a, ha⟩ : E0LM.e0RegM e0PastHalf)) =
        g • E0.chartMap (pastHalfPt y) (pastHalfPt (show e0RegMFlat e0PastHalf from
          (⟨a, ha⟩ : E0LM.e0RegM e0PastHalf))) := by
    obtain ⟨O, hOP, hOo, hyO⟩ := eventually_nhds_iff.1 hg
    have hOo' : IsOpen (((↑) : E0LM.e0RegM e0PastHalf → e0PastHalf) '' O) :=
      hR.isOpenMap_subtype_val O hOo
    filter_upwards [hOo'.mem_nhds ⟨y, hyO, rfl⟩] with a ⟨z, hzO, hza⟩ ha
    have hz : z = ⟨a, ha⟩ := Subtype.ext hza
    subst hz
    exact (hOP _ hzO).2
  have h2 : ∀ᶠ a in 𝓝 (s₀ : e0PastHalf), a ∈ E0LM.e0RegM e0PastHalf := hR.mem_nhds hreg
  have h3 := (continuous_subtype_val.tendsto s₀).eventually (h1.and h2)
  filter_upwards [h3] with s ⟨hs1, hs2⟩
  rw [e0SliceSys_of_mem hreg hs2, hs1 hs2]
  have e1 : pastHalfPt y = ((-1 : ℝ), pastSliceZ s₀) := paperOfY_pastSlice s₀
  have e2 : pastHalfPt (show e0RegMFlat e0PastHalf from
      (⟨(s : e0PastHalf), hs2⟩ : E0LM.e0RegM e0PastHalf)) = ((-1 : ℝ), pastSliceZ s) :=
    paperOfY_pastSlice s
  rw [e1, e2]

/-- **The density of a curve of the slice at a regular time** is `‖ż‖` when `z = pastSliceZ ∘ c` is
differentiable there. -/
theorem localDensity_pastSlice_eq {c : ℝ → e0PastHalfSlice} {t : ℝ} (hc : ContinuousAt c t)
    (ht : pastSliceZ (c t) ≠ 0) (hd : DifferentiableAt ℝ (fun s => pastSliceZ (c s)) t) :
    Causal.Flat.localDensity (e0SliceSys e0PastHalfSlice) c t =
      ENNReal.ofReal ‖deriv (fun s => pastSliceZ (c s)) t‖ := by
  obtain ⟨g, hg⟩ := e0SliceSys_pastSlice_eventually ht
  set x : E0 := ((-1 : ℝ), pastSliceZ (c t))
  have hx : x.2 ≠ 0 := ht
  have hev : (fun s => e0SliceSys e0PastHalfSlice (c t) (c s)) =ᶠ[𝓝 t]
      fun s => g • E0.chartMap x ((-1 : ℝ), pastSliceZ (c s)) := hc.eventually hg
  obtain ⟨V, hV, hQ⟩ := hasDerivAt_chartMap_slice hx hd.hasDerivAt (by
    show pastSliceZ (c t) / pastSliceZ (c t) ∈ Complex.slitPlane
    rw [div_self ht]; exact Complex.one_mem_slitPlane)
  unfold Causal.Flat.localDensity
  rw [hev.deriv_eq, Causal.Flat.deriv_isom_comp, hV.deriv, Causal.Flat.minkQ_isom_linear, hQ,
    Real.sqrt_sq (norm_nonneg _)]


/-- The `z`-reading of a point of `𝐌³` through the frame `g` and the inverse development. -/
noncomputable def pastSliceRead (g : Causal.Flat.isom 2) (p : Causal.Minkowski 2) : ℂ :=
  (E0.unlift (E0Surgery.chartNull g p)).2

theorem contDiffAt_pastSliceRead (g : Causal.Flat.isom 2) {p : Causal.Minkowski 2}
    (hp : (E0Surgery.chartNull g p).2.1 ≠ 0) : ContDiffAt ℝ 1 (pastSliceRead g) p := by
  have hU : ContDiffAt ℝ 1 (fun R : ℝ × ℝ × ℝ =>
      ((R.2.1 : ℂ) * Complex.exp (((-(R.2.2 / R.2.1) : ℝ) : ℂ) * Complex.I)))
      (E0Surgery.chartNull g p) := by
    have h1 : ContDiffAt ℝ 1 (fun R : ℝ × ℝ × ℝ => ((R.2.1 : ℂ))) (E0Surgery.chartNull g p) :=
      (Complex.ofRealCLM.contDiff.comp (contDiff_fst.comp contDiff_snd)).contDiffAt
    have h2 : ContDiffAt ℝ 1 (fun R : ℝ × ℝ × ℝ => (-(R.2.2 / R.2.1) : ℝ))
        (E0Surgery.chartNull g p) :=
      ((contDiff_snd.comp contDiff_snd).contDiffAt.div
        (contDiff_fst.comp contDiff_snd).contDiffAt hp).neg
    have h3 : ContDiffAt ℝ 1 (fun R : ℝ × ℝ × ℝ => (((-(R.2.2 / R.2.1) : ℝ) : ℂ) * Complex.I))
        (E0Surgery.chartNull g p) :=
      (Complex.ofRealCLM.contDiff.contDiffAt.comp _ h2).mul contDiffAt_const
    exact h1.mul h3.cexp
  exact hU.comp p (E0Surgery.contDiff_chartNull g).contDiffAt

/-- **`z` is Lipschitz near a regular time** of a curve Lipschitz in the length charts. -/
theorem lipschitz_pastSliceZ_near {c : ℝ → e0PastHalfSlice} {t : ℝ} (hc : ContinuousAt c t)
    (ht : pastSliceZ (c t) ≠ 0) (hL : Causal.Flat.LocLipAt (e0SliceSys e0PastHalfSlice) c t) :
    ∃ δ > (0 : ℝ), ∃ K : ℝ≥0, LipschitzOnWith K (fun s => pastSliceZ (c s)) (Icc (t - δ) (t + δ)) := by
  obtain ⟨g, hg⟩ := e0SliceSys_pastSlice_eventually ht
  set x : E0 := ((-1 : ℝ), pastSliceZ (c t)) with hxdef
  have hx : x.2 ≠ 0 := ht
  set F := fun s => e0SliceSys e0PastHalfSlice (c t) (c s) with hF
  obtain ⟨ε, hε, K, hK⟩ := hL
  have hev : ∀ᶠ s in 𝓝 t, F s = g • E0.chartMap x ((-1 : ℝ), pastSliceZ (c s)) := hc.eventually hg
  have hΘ : ∀ s, F s = g • E0.chartMap x ((-1 : ℝ), pastSliceZ (c s)) →
      pastSliceZ (c s) = pastSliceRead g (F s) := by
    intro s hs
    rw [hs, pastSliceRead, E0Surgery.chartNull, inv_smul_smul, E0.unlift_symm_chartMap hx]
  have hFt : F t = g • E0.chartMap x x := hev.self_of_nhds
  have hR0 : (E0Surgery.chartNull g (F t)).2.1 ≠ 0 := by
    rw [hFt, E0Surgery.chartNull, inv_smul_smul]
    show (nullToMink.symm (nullToMink (E0.locLift x x))).2.1 ≠ 0
    rw [LinearEquiv.symm_apply_apply]
    exact (E0.rad_pos.2 hx).ne'
  obtain ⟨K', U, hU, hΘU⟩ := (contDiffAt_pastSliceRead g hR0).exists_lipschitzOnWith
  have hFc : ContinuousAt F t :=
    hK.continuousOn.continuousAt (Icc_mem_nhds (by linarith) (by linarith))
  obtain ⟨δ, hδ, hδP⟩ := Causal.Flat.exists_Icc_subset_of_eventually
    ((show ∀ᶠ s in 𝓝 t, F s ∈ U from hFc.preimage_mem_nhds hU).and hev)
  refine ⟨min δ ε, lt_min hδ hε, K' * K, ?_⟩
  have hsub : Icc (t - min δ ε) (t + min δ ε) ⊆ Icc (t - δ) (t + δ) :=
    Icc_subset_Icc (by linarith [min_le_left δ ε]) (by linarith [min_le_left δ ε])
  have hsub' : Icc (t - min δ ε) (t + min δ ε) ⊆ Icc (t - ε) (t + ε) :=
    Icc_subset_Icc (by linarith [min_le_right δ ε]) (by linarith [min_le_right δ ε])
  have hcomp : LipschitzOnWith (K' * K) (fun s => pastSliceRead g (F s))
      (Icc (t - min δ ε) (t + min δ ε)) :=
    hΘU.comp (hK.mono hsub') fun s hs => (hδP s (hsub hs)).1
  exact Causal.Flat.lipschitzOnWith_congr_of_eqOn
    (fun s hs => ((hΘ s (hδP s (hsub hs)).2)).symm) hcomp

/-- **The fundamental theorem of calculus, as an inequality, for Lipschitz curves of `ℂ`**
(`Causal.Flat.norm_sub_le_integral_norm_deriv` read in `ℂ`). -/
theorem norm_sub_le_integral_norm_deriv_complex {X : ℝ → ℂ} {K : ℝ≥0}
    (hX : LipschitzWith K X) {a b : ℝ} (hab : a ≤ b) :
    ‖X b - X a‖ ≤ ∫ s in a..b, ‖deriv X s‖ := by
  set w := X b - X a
  set u : ℝ → ℝ := fun s => inner ℝ w (X s)
  have h1 : LipschitzWith ‖w‖₊ fun x : ℂ => inner ℝ w x :=
    LipschitzWith.of_dist_le_mul fun x y => by
      rw [Real.dist_eq, dist_eq_norm, ← inner_sub_right, coe_nnnorm]
      exact abs_real_inner_le_norm _ _
  have hu : LipschitzWith (‖w‖₊ * K) u := h1.comp hX
  have hFTC : ∫ s in a..b, deriv u s = u b - u a :=
    (hu.lipschitzOnWith.absolutelyContinuousOnInterval).integral_deriv_eq_sub
  have hub : u b - u a = ‖w‖ ^ 2 := by
    simp only [u, ← inner_sub_right, real_inner_self_eq_norm_sq, w]
  have hdu : ∀ᵐ s, deriv u s = inner ℝ w (deriv X s) := by
    filter_upwards [hX.ae_differentiableAt_real] with s hs
    exact ((innerSL ℝ w).hasFDerivAt.comp_hasDerivAt s hs.hasDerivAt).deriv
  have hbd : ∀ s, ‖deriv X s‖ ≤ K := fun s => norm_deriv_le_of_lipschitz hX
  have hint1 : IntervalIntegrable (fun s => inner ℝ w (deriv X s)) MeasureTheory.volume a b :=
    Causal.Flat.intervalIntegrable_of_bound ((continuous_const.inner continuous_id).measurable.comp
      (measurable_deriv X)) (‖w‖ * K) (fun s => by
        rw [Real.norm_eq_abs]
        exact (abs_real_inner_le_norm _ _).trans
          (mul_le_mul_of_nonneg_left (hbd s) (norm_nonneg _))) a b
  have hint2 : IntervalIntegrable (fun s => ‖w‖ * ‖deriv X s‖) MeasureTheory.volume a b :=
    Causal.Flat.intervalIntegrable_of_bound (measurable_const.mul (measurable_deriv X).norm)
      (‖w‖ * K) (fun s => by
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        exact mul_le_mul_of_nonneg_left (hbd s) (norm_nonneg _)) a b
  have hle : ‖w‖ ^ 2 ≤ ‖w‖ * ∫ s in a..b, ‖deriv X s‖ := by
    rw [← hub, ← hFTC, intervalIntegral.integral_congr_ae (hdu.mono fun s hs _ => hs),
      ← intervalIntegral.integral_const_mul]
    exact intervalIntegral.integral_mono_ae hab hint1 hint2
      (Filter.Eventually.of_forall fun s => real_inner_le_norm _ _)
  have hI : 0 ≤ ∫ s in a..b, ‖deriv X s‖ :=
    intervalIntegral.integral_nonneg hab fun _ _ => norm_nonneg _
  rcases (norm_nonneg w).eq_or_lt with h0 | hpos
  · rw [← h0]; exact hI
  · nlinarith

/-- The same on an interval, for a curve Lipschitz there, with the lower integral. -/
theorem ofReal_norm_sub_le_lintegral_of_lipschitzOnWith {f : ℝ → ℂ} {K : ℝ≥0} {u v : ℝ}
    (huv : u ≤ v) (hf : LipschitzOnWith K f (Icc u v)) :
    ENNReal.ofReal ‖f v - f u‖ ≤ ∫⁻ s in Ioc u v, ENNReal.ofReal ‖deriv f s‖ := by
  set h : ℝ → ℂ := fun s => f (projIcc u v huv s) with hh
  have hhL : LipschitzWith K h := by
    refine LipschitzWith.of_dist_le_mul fun a b => ?_
    have := hf.dist_le_mul (projIcc u v huv a) (projIcc u v huv a).2
      (projIcc u v huv b) (projIcc u v huv b).2
    refine this.trans (mul_le_mul_of_nonneg_left ?_ K.2)
    rw [Real.dist_eq, Real.dist_eq]
    exact abs_projIcc_sub_projIcc huv
  have hu : h u = f u := by simp [hh, projIcc_left]
  have hv : h v = f v := by simp [hh, projIcc_right]
  have h1 := norm_sub_le_integral_norm_deriv_complex hhL huv
  rw [hu, hv, intervalIntegral.integral_of_le huv] at h1
  have hbd : ∀ s, ‖deriv h s‖ ≤ K := fun s => norm_deriv_le_of_lipschitz hhL
  have hint : MeasureTheory.IntegrableOn (fun s => ‖deriv h s‖) (Ioc u v) :=
    MeasureTheory.Measure.integrableOn_of_bounded (by simp) (measurable_deriv h).norm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun s => by rw [norm_norm]; exact hbd s)
  have h2 := ENNReal.ofReal_le_ofReal h1
  rw [MeasureTheory.ofReal_integral_eq_lintegral_ofReal hint
    (Filter.Eventually.of_forall fun _ => norm_nonneg _)] at h2
  refine h2.trans (le_of_eq ?_)
  rw [MeasureTheory.setLIntegral_congr MeasureTheory.Ioo_ae_eq_Ioc.symm,
    MeasureTheory.setLIntegral_congr MeasureTheory.Ioo_ae_eq_Ioc.symm]
  refine MeasureTheory.setLIntegral_congr_fun measurableSet_Ioo fun s hs => ?_
  have : h =ᶠ[𝓝 s] f := by
    filter_upwards [Ioo_mem_nhds hs.1 hs.2] with r hr
    simp [hh, projIcc_of_mem huv ⟨hr.1.le, hr.2.le⟩]
  simp only [this.deriv_eq]


/-- **Crossing the zeros**: for a continuous curve `f` of `ℂ`, if the displacement over every
zero-free subinterval of `[a, b]` is bounded by the integral of `ρ`, so is `‖f b − f a‖` — across
the zero set the displacement is at most `‖f a‖ + ‖f b‖`, each bounded on the zero-free end pieces
`(a, s₀]` and `(s₁, b]` (`s₀`, `s₁` the first and last zeros), by continuity at `s₀`, `s₁`. -/
theorem ofReal_norm_sub_le_of_zeroFree {f : ℝ → ℂ} (hf : Continuous f) {ρ : ℝ → ℝ≥0∞}
    {a b : ℝ} (hab : a ≤ b)
    (H : ∀ u v, a ≤ u → u ≤ v → v ≤ b → (∀ s ∈ Icc u v, f s ≠ 0) →
      ENNReal.ofReal ‖f v - f u‖ ≤ ∫⁻ s in Ioc u v, ρ s) :
    ENNReal.ofReal ‖f b - f a‖ ≤ ∫⁻ s in Ioc a b, ρ s := by
  by_cases hz : ∃ s ∈ Icc a b, f s = 0
  swap
  · push Not at hz
    exact H a b le_rfl hab le_rfl hz
  set Zr : Set ℝ := Icc a b ∩ {s | f s = 0} with hZr
  have hZc : IsCompact Zr := isCompact_Icc.inter_right (isClosed_eq hf continuous_const)
  have hZn : Zr.Nonempty := let ⟨s, hs, h0⟩ := hz; ⟨s, hs, h0⟩
  set s₀ := sInf Zr
  set s₁ := sSup Zr
  have hs₀ : s₀ ∈ Zr := hZc.sInf_mem hZn
  have hs₁ : s₁ ∈ Zr := hZc.sSup_mem hZn
  have hlow : ∀ s ∈ Zr, s₀ ≤ s := fun s hs => csInf_le hZc.bddBelow hs
  have hupp : ∀ s ∈ Zr, s ≤ s₁ := fun s hs => le_csSup hZc.bddAbove hs
  have h01 : s₀ ≤ s₁ := hlow _ hs₁
  -- the first piece
  have hA : ENNReal.ofReal ‖f a‖ ≤ ∫⁻ s in Ioc a s₀, ρ s := by
    rcases hs₀.1.1.eq_or_lt with h | h
    · rw [← h] at hs₀; rw [hs₀.2, norm_zero, ENNReal.ofReal_zero]; exact zero_le
    have hlim : Tendsto (fun u => ENNReal.ofReal ‖f u - f a‖) (𝓝[<] s₀)
        (𝓝 (ENNReal.ofReal ‖f s₀ - f a‖)) :=
      ((ENNReal.continuous_ofReal.comp ((hf.sub continuous_const).norm)).tendsto s₀).mono_left
        nhdsWithin_le_nhds
    have hev : ∀ᶠ u in 𝓝[<] s₀, ENNReal.ofReal ‖f u - f a‖ ≤ ∫⁻ s in Ioc a s₀, ρ s := by
      filter_upwards [Ioo_mem_nhdsLT h] with u hu
      refine (H a u le_rfl hu.1.le (hu.2.le.trans hs₀.1.2) fun s hs h0 => ?_).trans
        (MeasureTheory.lintegral_mono_set (Ioc_subset_Ioc_right hu.2.le))
      have := hlow s ⟨⟨hs.1, hs.2.trans (hu.2.le.trans hs₀.1.2)⟩, h0⟩
      linarith [hs.2, hu.2]
    have := le_of_tendsto hlim hev
    rwa [hs₀.2, zero_sub, norm_neg] at this
  -- the last piece
  have hB : ENNReal.ofReal ‖f b‖ ≤ ∫⁻ s in Ioc s₁ b, ρ s := by
    rcases hs₁.1.2.eq_or_lt with h | h
    · rw [h] at hs₁; rw [hs₁.2, norm_zero, ENNReal.ofReal_zero]; exact zero_le
    have hlim : Tendsto (fun v => ENNReal.ofReal ‖f b - f v‖) (𝓝[>] s₁)
        (𝓝 (ENNReal.ofReal ‖f b - f s₁‖)) :=
      ((ENNReal.continuous_ofReal.comp ((continuous_const.sub hf).norm)).tendsto s₁).mono_left
        nhdsWithin_le_nhds
    have hev : ∀ᶠ v in 𝓝[>] s₁, ENNReal.ofReal ‖f b - f v‖ ≤ ∫⁻ s in Ioc s₁ b, ρ s := by
      filter_upwards [Ioo_mem_nhdsGT h] with v hv
      refine (H v b (hs₁.1.1.trans hv.1.le) hv.2.le le_rfl fun s hs h0 => ?_).trans
        (MeasureTheory.lintegral_mono_set (Ioc_subset_Ioc_left hv.1.le))
      have := hupp s ⟨⟨(hs₁.1.1.trans hv.1.le).trans hs.1, hs.2⟩, h0⟩
      linarith [hs.1, hv.1]
    have := le_of_tendsto hlim hev
    rwa [hs₁.2, sub_zero] at this
  calc ENNReal.ofReal ‖f b - f a‖ ≤ ENNReal.ofReal (‖f a‖ + ‖f b‖) :=
        ENNReal.ofReal_le_ofReal ((norm_sub_le _ _).trans_eq (add_comm _ _))
    _ = ENNReal.ofReal ‖f a‖ + ENNReal.ofReal ‖f b‖ :=
        ENNReal.ofReal_add (norm_nonneg _) (norm_nonneg _)
    _ ≤ (∫⁻ s in Ioc a s₀, ρ s) + ∫⁻ s in Ioc s₁ b, ρ s := add_le_add hA hB
    _ = ∫⁻ s in Ioc a s₀ ∪ Ioc s₁ b, ρ s :=
        (MeasureTheory.lintegral_union measurableSet_Ioc
          (Set.disjoint_left.2 fun s h1 h2 => by linarith [h1.2, h2.1])).symm
    _ ≤ ∫⁻ s in Ioc a b, ρ s := MeasureTheory.lintegral_mono_set
        (union_subset (Ioc_subset_Ioc_right hs₀.1.2) (Ioc_subset_Ioc_left hs₁.1.1))

/-- **The lower bound**: every path of the slice from `a` to `b` is at least `‖z_b − z_a‖` long
for the length chart system (`IsE0CauchyComplete`'s, BTZ times contributing `0`). -/
theorem ofReal_norm_pastSliceZ_sub_le_pathLength {a b : e0PastHalfSlice} (γ : Path a b) :
    ENNReal.ofReal ‖pastSliceZ b - pastSliceZ a‖ ≤
      Causal.Flat.pathLength (e0SliceSys e0PastHalfSlice) γ := by
  by_cases hL : Causal.Flat.IsLocLip (e0SliceSys e0PastHalfSlice) γ.extend
  swap; · rw [Causal.Flat.pathLength_of_not_isLocLip _ hL]; exact le_top
  rw [Causal.Flat.pathLength_of_isLocLip _ hL]
  set c := γ.extend with hcdef
  have hc : Continuous c := γ.continuous_extend
  set f : ℝ → ℂ := fun s => pastSliceZ (c s) with hfdef
  have hfc : Continuous f := continuous_pastSliceZ.comp hc
  set ρ : ℝ → ℝ≥0∞ := fun s => if f s ≠ 0 then ENNReal.ofReal ‖deriv f s‖ else 0 with hρdef
  have hρle : ∀ s, ρ s ≤ Causal.Flat.localDensity (e0SliceSys e0PastHalfSlice) c s := by
    intro s
    by_cases h0 : f s ≠ 0
    · by_cases hd : DifferentiableAt ℝ f s
      · rw [hρdef]; simp only [h0, if_true, ne_eq, not_false_eq_true]
        rw [localDensity_pastSlice_eq hc.continuousAt h0 hd]
      · rw [hρdef]
        simp only [h0, if_true, ne_eq, not_false_eq_true, deriv_zero_of_not_differentiableAt hd,
          norm_zero, ENNReal.ofReal_zero]
        exact zero_le
    · rw [hρdef]; simp only [h0, if_false]; exact zero_le
  have hf0 : f 0 = pastSliceZ a := by simp [hfdef, hcdef]
  have hf1 : f 1 = pastSliceZ b := by simp [hfdef, hcdef]
  have key : ENNReal.ofReal ‖f 1 - f 0‖ ≤ ∫⁻ s in Ioc 0 1, ρ s := by
    refine ofReal_norm_sub_le_of_zeroFree hfc zero_le_one fun u v hu huv hv hz => ?_
    have hloc : LocallyLipschitzOn (Icc u v) f := fun s hs => by
      obtain ⟨δ, hδ, K, hK⟩ := lipschitz_pastSliceZ_near hc.continuousAt (hz s hs) (hL s)
      exact ⟨K, Icc (s - δ) (s + δ),
        mem_nhdsWithin_of_mem_nhds (Icc_mem_nhds (by linarith) (by linarith)), hK⟩
    obtain ⟨K, hK⟩ := hloc.exists_lipschitzOnWith_of_compact isCompact_Icc
    refine (ofReal_norm_sub_le_lintegral_of_lipschitzOnWith huv hK).trans (le_of_eq ?_)
    refine MeasureTheory.setLIntegral_congr_fun measurableSet_Ioc fun s hs => ?_
    have : f s ≠ 0 := hz s ⟨hs.1.le, hs.2⟩
    simp only [hρdef, this, ne_eq, not_false_eq_true, if_true]
  rw [hf0, hf1] at key
  exact key.trans (MeasureTheory.lintegral_mono hρle)


/-- The sector chart along the slice is `C¹` off the cut. -/
theorem contDiffAt_chartMap_slice {x : E0} {w₀ : ℂ} (hslit : w₀ / x.2 ∈ Complex.slitPlane) :
    ContDiffAt ℝ 1 (fun w : ℂ => E0.chartMap x ((-1 : ℝ), w)) w₀ := by
  have hx : x.2 ≠ 0 := by
    intro h; rw [h, div_zero] at hslit; exact Complex.slitPlane_ne_zero hslit rfl
  have hw0 : w₀ ≠ 0 := by
    intro h; rw [h, zero_div] at hslit; exact Complex.slitPlane_ne_zero hslit rfl
  have hr : ContDiffAt ℝ 1 (fun w : ℂ => ‖w‖) w₀ := contDiffAt_norm (𝕜 := ℝ) hw0
  have ha : ContDiffAt ℝ 1 (fun w : ℂ => Complex.arg (w / x.2)) w₀ := by
    have hlog : ContDiffAt ℝ 1 Complex.log (w₀ / x.2) :=
      (Complex.contDiffAt_log hslit).restrict_scalars ℝ
    have hdiv : ContDiffAt ℝ 1 (fun w : ℂ => w / x.2) w₀ :=
      (contDiff_id.div_const x.2).contDiffAt
    have := Complex.imCLM.contDiff.contDiffAt.comp w₀ (hlog.comp w₀ hdiv)
    simpa [Function.comp_def, Complex.log_im] using this
  have hθ : ContDiffAt ℝ 1 (fun w : ℂ => Complex.arg x.2 + Complex.arg (w / x.2)) w₀ :=
    contDiffAt_const.add ha
  have hN : ContDiffAt ℝ 1 (fun w : ℂ => btzPaperNull ((-1 : ℝ), ‖w‖,
      Complex.arg x.2 + Complex.arg (w / x.2))) w₀ := by
    simp only [btzPaperNull]
    exact ((contDiffAt_const.add (hr.mul (hθ.pow 2))).sub hr).prodMk (hr.prodMk (hr.mul hθ).neg)
  exact (LinearMap.toContinuousLinearMap
    (nullToMink : (ℝ × ℝ × ℝ) →ₗ[ℝ] Causal.Minkowski 2)).contDiff.contDiffAt.comp w₀ hN

/-- The straight segment of the slice, `t ↦ (−1, z_a + t (z_b − z_a))`. -/
noncomputable def pastSliceSegment (a b : e0PastHalfSlice) : Path a b where
  toFun t := pastSlicePt (pastSliceZ a + (t : ℝ) • (pastSliceZ b - pastSliceZ a))
  continuous_toFun := continuous_pastSlicePt.comp (by fun_prop)
  source' := by simp [pastSlicePt_pastSliceZ]
  target' := by simp [pastSlicePt_pastSliceZ]

theorem pastSliceZ_pastSliceSegment_extend (a b : e0PastHalfSlice) (s : ℝ) :
    pastSliceZ ((pastSliceSegment a b).extend s) =
      pastSliceZ a + ((projIcc (0 : ℝ) 1 zero_le_one s : ℝ) : ℂ) * (pastSliceZ b - pastSliceZ a) := by
  show pastSliceZ (pastSlicePt _) = _
  rw [pastSliceZ_pastSlicePt, Complex.real_smul]

/-- **The upper bound**: the segment is at most `‖z_b − z_a‖` long. -/
theorem pathLength_pastSliceSegment_le (a b : e0PastHalfSlice) :
    Causal.Flat.pathLength (e0SliceSys e0PastHalfSlice) (pastSliceSegment a b) ≤
      ENNReal.ofReal ‖pastSliceZ b - pastSliceZ a‖ := by
  set c := (pastSliceSegment a b).extend with hcdef
  have hc : Continuous c := (pastSliceSegment a b).continuous_extend
  set f : ℝ → ℂ := fun s => pastSliceZ (c s) with hfdef
  set Δ := pastSliceZ b - pastSliceZ a with hΔ
  have hfeq : ∀ s, f s = pastSliceZ a + ((projIcc (0 : ℝ) 1 zero_le_one s : ℝ) : ℂ) * Δ :=
    pastSliceZ_pastSliceSegment_extend a b
  have hfL : LipschitzWith ‖Δ‖₊ f := by
    refine LipschitzWith.of_dist_le_mul fun u v => ?_
    rw [hfeq, hfeq, dist_add_left, dist_eq_norm, ← sub_mul, norm_mul, coe_nnnorm, mul_comm,
      ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs, Real.dist_eq]
    exact mul_le_mul_of_nonneg_left (abs_projIcc_sub_projIcc _) (norm_nonneg _)
  have hL : Causal.Flat.IsLocLip (e0SliceSys e0PastHalfSlice) c := by
    intro t
    by_cases h0 : f t = 0
    · refine ⟨1, one_pos, 0, ?_⟩
      have : (fun s => e0SliceSys e0PastHalfSlice (c t) (c s)) = fun _ => 0 := by
        funext s
        exact e0SliceSys_of_not_mem (fun h => ((pastSliceReg_iff _).1 h) h0) _
      rw [this]; exact (LipschitzWith.const _).lipschitzOnWith
    obtain ⟨g, hg⟩ := e0SliceSys_pastSlice_eventually h0
    set x : E0 := ((-1 : ℝ), pastSliceZ (c t))
    have hev : ∀ᶠ s in 𝓝 t, e0SliceSys e0PastHalfSlice (c t) (c s) =
        g • E0.chartMap x ((-1 : ℝ), f s) := hc.continuousAt.eventually hg
    obtain ⟨K₁, U, hU, hΨ⟩ := (contDiffAt_chartMap_slice (x := x) (w₀ := f t) (by
      show f t / f t ∈ Complex.slitPlane
      rw [div_self h0]; exact Complex.one_mem_slitPlane)).exists_lipschitzOnWith
    obtain ⟨Kg, hKg⟩ := Causal.Flat.isom_lipschitzWith g
    obtain ⟨δ, hδ, hδP⟩ := Causal.Flat.exists_Icc_subset_of_eventually
      ((show ∀ᶠ s in 𝓝 t, f s ∈ U from hfL.continuous.continuousAt.preimage_mem_nhds hU).and hev)
    refine ⟨δ, hδ, Kg * (K₁ * ‖Δ‖₊), ?_⟩
    have h1 : LipschitzOnWith (Kg * (K₁ * ‖Δ‖₊)) (fun s => g • E0.chartMap x ((-1 : ℝ), f s))
        (Icc (t - δ) (t + δ)) :=
      hKg.comp_lipschitzOnWith (hΨ.comp hfL.lipschitzOnWith fun s hs => (hδP s hs).1)
    exact Causal.Flat.lipschitzOnWith_congr_of_eqOn (fun s hs => ((hδP s hs).2).symm) h1
  rw [Causal.Flat.pathLength_of_isLocLip _ hL]
  unfold Causal.Flat.localLength
  rw [MeasureTheory.setLIntegral_congr MeasureTheory.Ioo_ae_eq_Ioc.symm]
  calc ∫⁻ s in Ioo 0 1, Causal.Flat.localDensity (e0SliceSys e0PastHalfSlice) c s
      ≤ ∫⁻ _ in Ioo (0 : ℝ) 1, ENNReal.ofReal ‖Δ‖ := by
        refine MeasureTheory.setLIntegral_mono measurable_const fun s hs => ?_
        by_cases h0 : f s = 0
        · rw [localDensity_e0SliceSys_of_not_mem (fun h => ((pastSliceReg_iff _).1 h) h0)]
          exact zero_le
        · have hd : HasDerivAt f Δ s := by
            have h2 : HasDerivAt (fun r : ℝ => pastSliceZ a + (r : ℂ) * Δ) Δ s := by
              simpa using ((Complex.ofRealCLM.hasDerivAt (x := s)).mul_const Δ).const_add
                (pastSliceZ a)
            refine h2.congr_of_eventuallyEq ?_
            filter_upwards [Ioo_mem_nhds hs.1 hs.2] with r hr
            rw [hfeq, projIcc_of_mem _ ⟨hr.1.le, hr.2.le⟩]
          rw [localDensity_pastSlice_eq hc.continuousAt h0 hd.differentiableAt, hd.deriv]
    _ = ENNReal.ofReal ‖Δ‖ := by simp


/-- **The length metric of the slice is the Euclidean metric of `ℂ`** in the coordinate `z`. -/
theorem edist_e0SliceSys_pastSlice (a b : Causal.Flat.LocalLengthSpace (e0SliceSys e0PastHalfSlice)) :
    edist (pastSliceZ (Causal.Flat.LocalLengthSpace.toSpace a))
      (pastSliceZ (Causal.Flat.LocalLengthSpace.toSpace b)) = edist a b := by
  rw [Causal.Flat.LocalLengthSpace.edist_def, edist_dist, dist_eq_norm, ← norm_neg, neg_sub]
  refine le_antisymm (le_iInf fun γ => ofReal_norm_pastSliceZ_sub_le_pathLength γ) ?_
  exact (iInf_le _ (pastSliceSegment _ _)).trans (pathLength_pastSliceSegment_le _ _)

/-- The slice, as `ℂ`. -/
noncomputable def pastSliceEquiv : e0PastHalfSlice ≃ ℂ where
  toFun := pastSliceZ
  invFun := pastSlicePt
  left_inv := pastSlicePt_pastSliceZ
  right_inv := pastSliceZ_pastSlicePt

end SliceCauchy

/-- **`{τ<0}` is Cauchy-complete in DEC-31's sense** — the printed hypothesis of
`prop:globally_hyperbolic_cauchy_complete_manifolds`, on the counterexample: the slice
`{τ = −1}` is a Cauchy surface, spacelike in the flat charts, and its induced length metric is
`dr² + r²dθ²` (`btzPaperDev`'s pullback at `dτ = 0`), the Euclidean metric of `ℂ` in the
coordinate `x.2`, hence complete. -/
theorem e0PastHalf_isE0CauchyComplete : IsE0CauchyComplete e0PastHalf := by
  set e : Causal.Flat.LocalLengthSpace (e0SliceSys e0PastHalfSlice) ≃ᵢ ℂ :=
    { toEquiv := Causal.Flat.LocalLengthSpace.toSpace.trans pastSliceEquiv
      isometry_toFun := fun a b => edist_e0SliceSys_pastSlice a b }
  refine ⟨e0PastHalfSlice, e0PastHalfSlice_isCauchySurface,
    e0PastHalfSlice_isSpacelikeLipschitz, e.completeSpace, ?_⟩
  have h : (fun x : Causal.Flat.LocalLengthSpace (e0SliceSys e0PastHalfSlice) =>
      ((Causal.Flat.LocalLengthSpace.toSpace x : e0PastHalfSlice) : e0PastHalf)) =
      fun x => ((pastSlicePt (e x) : e0PastHalfSlice) : e0PastHalf) := by
    funext x
    show _ = ((pastSlicePt (pastSliceZ (Causal.Flat.LocalLengthSpace.toSpace x)) : e0PastHalfSlice) :
      e0PastHalf)
    rw [pastSlicePt_pastSliceZ]
  rw [h]
  exact continuous_subtype_val.comp (continuous_pastSlicePt.comp e.continuous)

/-- **D-11's counterexample with the printed hypothesis** (DEC-27, DEC-31, DEC-77): `{τ<0} ⊂ 𝔼₀` is
globally hyperbolic, Cauchy-complete in DEC-31's sense, has BTZ points, and its regular part is
not future complete for any developing pair. -/
theorem e0PastHalf_counterexample_DEC31 :
    (CE e0PastHalf).GloballyHyperbolic ∧ IsE0CauchyComplete e0PastHalf ∧
      (Causal.CBG.chartedSing e0SingY e0PastHalf 0).Nonempty ∧
      ∀ (x₀ : e0RegMFlat e0PastHalf)
        (D : Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀ → Causal.Minkowski 2)
        (ρ : Causal.Deck (Causal.UniversalCover.proj (e0RegMFlat e0PastHalf) x₀) →*
          Causal.Flat.isom 2),
        Causal.Flat.IsDevelopingPair x₀ D ρ →
          letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat e0PastHalf) x₀
          haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat e0PastHalf) x₀
          ¬ IsFutureComplete
            (Causal.Flat.flatCausality 2 (Causal.UniversalCover (e0RegMFlat e0PastHalf) x₀)) D :=
  ⟨e0PastHalf_counterexample.1, e0PastHalf_isE0CauchyComplete, e0PastHalf_counterexample.2⟩

/-! #### D-11 in DEC-118 (a)'s reading: `{τ<0}~` is not future complete

The conclusion of `prop:globally_hyperbolic_cauchy_complete_manifolds` in its ruled reading is
`BTZTildeData.IsBTZFutureComplete` (for the chart-generated causality of `M̃`). It fails for EVERY
`\widetilde{\{τ<0\}}`-datum: on `reg M̃` the developing map reads `r = a ∘ D` with `a` affine
(through `E0Bridge.regTildeHomeo` and `pastHalf_rad_locally`); at a regular `x`, every `w ≫ x` has
`r(w) ≥ r(x) > 0` (so is regular) and `r(w) ≤ r(x) − 2τ(x)` (`E0.Le.closed`, `τ < 0`), so `a` is
bounded on the open cone `I⁺(D x) = D(I⁺(x))`, hence constant there (affine along rays), hence
constant — while `r` takes the values `1` and `2` on `Reg {τ<0}`. -/

/-- `Reg {τ<0}` is path connected. -/
theorem e0PastHalf_regFlat_pathConnected : PathConnectedSpace (e0RegMFlat e0PastHalf) := by
  haveI := ChartedSpace.locPathConnectedSpace (Causal.Minkowski 2) (e0RegMFlat e0PastHalf)
  exact pathConnectedSpace_iff_connectedSpace.2 inferInstance

/-- The regular point of `{τ<0}` with paper coordinates `(−1, c)`, `c ≠ 0`. -/
noncomputable def pastHalfRegPt (c : ℂ) (hc : c ≠ 0) : e0RegMFlat e0PastHalf :=
  ⟨⟨E0.paperInY ((-1 : ℝ), c), ⟨_, by norm_num, rfl⟩⟩, by
    rw [mem_e0RegM_pastHalf_iff]; simpa using hc⟩

attribute [local instance] btzE0Structure in
/-- **`{τ<0}~` is not future complete in DEC-118 (a)'s reading**: for the bridge structure of
`{τ<0}`, every base point, every presentation `Φ` and EVERY datum `d` (chartwise or not),
`¬ BTZTildeData.IsBTZFutureComplete {τ<0} d`. -/
theorem e0PastHalf_not_isBTZFutureComplete :
    letI := E0Bridge.e0SingularGXStructure e0PastHalf
    haveI := ChartedSpace.locPathConnectedSpace E0Y e0PastHalf
    ∀ {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) e0PastHalf)ᶜ : Set e0PastHalf)}
      {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
      {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
        DInfty × ℝ} (d : BTZTildeData e0PastHalf y₀ Φ),
      ¬ BTZTildeData.IsBTZFutureComplete e0PastHalf d := by
  letI := E0Bridge.e0SingularGXStructure e0PastHalf
  haveI := ChartedSpace.locPathConnectedSpace E0Y e0PastHalf
  intro y₀ yN Φ d hfc
  obtain ⟨ρ, hpair⟩ := E0Bridge.exists_isDevelopingPair_devOnCover y₀ d
  letI := Causal.Flat.flatCoverChartedSpace 2 (e0RegMFlat e0PastHalf) (E0Bridge.regPtF y₀)
  haveI := Causal.Flat.hasGroupoid_flatCover (d := 2) (e0RegMFlat e0PastHalf) (E0Bridge.regPtF y₀)
  have hDl : Causal.Flat.IsLocalIsometry 2 (E0Bridge.devOnCover y₀ d.D) :=
    Causal.Flat.isLocalIsometry_iff_eventually.2 ⟨hpair.gx.1, hpair.gx.2⟩
  obtain ⟨a, ha⟩ := exists_affine_eq_of_locally hDl.isOpenMap (pastHalf_rad_locally hpair)
  have hreg : ∀ e : MaxBranchedCover (E0Bridge.sing e0PastHalf) y₀, e ∈ E0Bridge.regTilde y₀ →
      E0.rad (E0.paperOfY (e.base : E0Y)) = a (d.D e) := by
    intro e he
    have h1 := ha (E0Bridge.regTildeHomeo y₀ ⟨e, he⟩)
    have h2 := E0Bridge.proj_regTildeHomeo y₀ ⟨e, he⟩
    have h3 : E0Bridge.devOnCover y₀ d.D (E0Bridge.regTildeHomeo y₀ ⟨e, he⟩) = d.D e := by
      simp only [E0Bridge.devOnCover, Homeomorph.symm_apply_apply]
    rw [h3] at h1
    rw [← h1]
    simp only [pastHalfPaper]
    rw [← h2]
  have hregIff : ∀ e : MaxBranchedCover (E0Bridge.sing e0PastHalf) y₀,
      e ∈ E0Bridge.regTilde y₀ ↔ 0 < E0.rad (E0.paperOfY (e.base : E0Y)) := by
    intro e
    show e.base ∈ (E0Bridge.sing e0PastHalf)ᶜ ↔ _
    have h := E0Bridge.compl_sing_eq (M := e0PastHalf)
    have : e.base ∈ (E0Bridge.sing e0PastHalf)ᶜ ↔ e.base ∈ (E0LM.e0RegM e0PastHalf : Set e0PastHalf) :=
      Set.ext_iff.1 h e.base
    rw [this, SetLike.mem_coe, mem_e0RegM_pastHalf_iff, E0.rad, norm_pos_iff]
  set x : MaxBranchedCover (E0Bridge.sing e0PastHalf) y₀ :=
    ((E0Bridge.regTildeHomeo y₀).symm (Causal.UniversalCover.base _) : E0Bridge.regTilde y₀).1
    with hxdef
  have hx : x ∈ E0Bridge.regTilde y₀ :=
    ((E0Bridge.regTildeHomeo y₀).symm (Causal.UniversalCover.base _) : E0Bridge.regTilde y₀).2
  set p := d.D x with hp
  set τx := (E0.paperOfY (x.base : E0Y)).1 with hτx
  have hτneg : τx < 0 := (mem_e0PastHalf_iff.1 x.base.2).2
  have hbound : ∀ v : Causal.Minkowski 2, (Causal.minkowski 2).lt ⊤ p v →
      a p ≤ a v ∧ a v ≤ a p - 2 * τx := by
    intro v hv
    have hv' : v ∈ (Causal.minkowski 2).Iplus ⊤ {d.D x} :=
      Causal.Precausality.mem_Iplus_singleton.2 hv
    rw [← (hfc x).2] at hv'
    obtain ⟨w, hw, hwv⟩ := hv'
    have hle := d.causality.le_of_lt (Causal.Precausality.mem_Iplus_singleton.1 hw)
    have hM := d.proj_le E0Bridge.isBTZSingModelled_e0 hle
    rw [E0Bridge.e0ManifoldCausality_eq_chartedCausality] at hM
    have hLe := (pastHalf_le_iff (d.proj x)).1 hM
    obtain ⟨hτ, hr, hq⟩ := hLe.closed
    have hτw : (E0.paperOfY ((d.proj w : e0PastHalf) : E0Y)).1 < 0 :=
      (mem_e0PastHalf_iff.1 (d.proj w).2).2
    have hrx := (hregIff x).1 hx
    have hw' : (w : MaxBranchedCover (E0Bridge.sing e0PastHalf) y₀) ∈ E0Bridge.regTilde y₀ :=
      (hregIff w).2 (lt_of_lt_of_le hrx hr)
    have hax := hreg x hx
    have haw := hreg w hw'
    rw [hwv] at haw
    have hd : E0.rad (E0.paperOfY ((d.proj w : e0PastHalf) : E0Y)) -
        E0.rad (E0.paperOfY ((d.proj x : e0PastHalf) : E0Y)) ≤
        2 * ((E0.paperOfY ((d.proj w : e0PastHalf) : E0Y)).1 -
          (E0.paperOfY ((d.proj x : e0PastHalf) : E0Y)).1) := by
      rcases (sub_nonneg.2 hr).lt_or_eq with h' | h'
      · have := E0.nonneg_of_mul_nonneg' h' hq
        linarith
      · rw [← h']; linarith
    have e1 : E0.rad (E0.paperOfY ((d.proj x : e0PastHalf) : E0Y)) = a p := hax
    have e2 : E0.rad (E0.paperOfY ((d.proj w : e0PastHalf) : E0Y)) = a v := haw
    have e3 : (E0.paperOfY ((d.proj x : e0PastHalf) : E0Y)).1 = τx := rfl
    rw [e1, e2, e3] at hd
    rw [e1, e2] at hr
    exact ⟨hr, by linarith⟩
  -- `a` is constant on the open cone `I⁺(p)`: it is bounded there and affine along rays
  set U : Set (Causal.Minkowski 2) := {q | ‖q.2 - p.2‖ < q.1 - p.1} with hU
  have hUlt : ∀ q ∈ U, (Causal.minkowski 2).lt ⊤ p q := fun q hq =>
    Causal.minkowski_lt_top_iff.2 hq
  have hconst : Set.EqOn a (AffineMap.const ℝ (Causal.Minkowski 2) (a p)) U := by
    intro q hq
    simp only [AffineMap.const_apply]
    have hs : ∀ s : ℝ, 0 < s → a p ≤ a (p + s • (q - p)) ∧ a (p + s • (q - p)) ≤ a p - 2 * τx := by
      intro s hs
      refine hbound _ (hUlt _ ?_)
      have hq' : ‖q.2 - p.2‖ < q.1 - p.1 := hq
      show ‖(p + s • (q - p)).2 - p.2‖ < (p + s • (q - p)).1 - p.1
      simp only [Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, Prod.fst_sub,
        Prod.snd_sub, add_sub_cancel_left, smul_eq_mul, norm_smul, Real.norm_eq_abs,
        abs_of_pos hs]
      exact mul_lt_mul_of_pos_left hq' hs
    have hlin : ∀ s : ℝ, a (p + s • (q - p)) = a p + s * a.linear (q - p) := by
      intro s
      rw [add_comm p, ← vadd_eq_add, a.map_vadd, vadd_eq_add, a.linear.map_smul, smul_eq_mul,
        add_comm]
    have h0 : 0 ≤ a.linear (q - p) := by
      have := (hs 1 one_pos).1; rw [hlin] at this; linarith
    have hle0 : a.linear (q - p) ≤ 0 := by
      by_contra hpos
      rw [not_le] at hpos
      have := (hs (-2 * τx / a.linear (q - p) + 1) (by
        have : 0 < -2 * τx / a.linear (q - p) := div_pos (by linarith) hpos
        linarith)).2
      rw [hlin, add_mul, div_mul_cancel₀ _ hpos.ne'] at this
      linarith
    have hz : a.linear (q - p) = 0 := le_antisymm hle0 h0
    have := hlin 1
    rw [one_smul, add_sub_cancel, hz, mul_zero, add_zero] at this
    exact this
  have hUo : IsOpen U := isOpen_lt (continuous_norm.comp (continuous_snd.sub continuous_const))
    (continuous_fst.sub continuous_const)
  have hUne : U.Nonempty := ⟨p + ((1 : ℝ), 0), by simp [hU]⟩
  have haeq := AffineMap.ext_on (hUo.affineSpan_eq_top hUne) hconst
  have hlin0 : a.linear = 0 := by rw [haeq]; rfl
  haveI := e0PastHalf_regFlat_pathConnected
  obtain ⟨w1, hw1⟩ := Causal.UniversalCover.proj_surjective (y₀ := E0Bridge.regPtF y₀)
    (pastHalfRegPt 1 one_ne_zero)
  obtain ⟨w2, hw2⟩ := Causal.UniversalCover.proj_surjective (y₀ := E0Bridge.regPtF y₀)
    (pastHalfRegPt 2 two_ne_zero)
  have h1 : E0.rad (pastHalfPaper w1) = 1 := by
    simp [pastHalfPaper, hw1, pastHalfRegPt, E0.rad]
  have h2 : E0.rad (pastHalfPaper w2) = 2 := by
    simp [pastHalfPaper, hw2, pastHalfRegPt, E0.rad]
  have hcst : ∀ u v : Causal.Minkowski 2, a u = a v := by
    intro u v
    have := a.linearMap_vsub u v
    rw [hlin0] at this
    simp at this
    linarith
  have := hcst (E0Bridge.devOnCover y₀ d.D w1) (E0Bridge.devOnCover y₀ d.D w2)
  rw [← ha, ← ha, h1, h2] at this
  norm_num at this


attribute [local instance] btzE0Structure in
/-- **D-11's counterexample in the ruled readings** (DEC-27, DEC-31/119, DEC-77, DEC-118 (a)): the
past half `{τ<0}` of `𝔼₀` satisfies the PRINTED hypotheses of
`prop:globally_hyperbolic_cauchy_complete_manifolds` — globally hyperbolic, Cauchy-complete in
DEC-31's sense (`IsE0CauchyComplete`), with BTZ points — and its conclusion « `M` future
complete », read as `BTZTildeData.IsBTZFutureComplete` (DEC-118 (a)), fails for every
`\widetilde{\{τ<0\}}`-datum — and such data EXIST (last conjunct: a presentation `Φ` of
`\widetilde{𝔼₀}` and a datum over it, so the refutation is not vacuous); the regular-part
reading fails too (`e0PastHalf_counterexample_DEC31`). -/
theorem e0PastHalf_counterexample_DEC118 :
    (CE e0PastHalf).GloballyHyperbolic ∧ IsE0CauchyComplete e0PastHalf ∧
      (Causal.CBG.chartedSing e0SingY e0PastHalf 0).Nonempty ∧
      (letI := E0Bridge.e0SingularGXStructure e0PastHalf
      haveI := ChartedSpace.locPathConnectedSpace E0Y e0PastHalf
      ∀ {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) e0PastHalf)ᶜ : Set e0PastHalf)}
        {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
        {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
          DInfty × ℝ} (d : BTZTildeData e0PastHalf y₀ Φ),
        ¬ BTZTildeData.IsBTZFutureComplete e0PastHalf d) ∧
      (letI := E0Bridge.e0SingularGXStructure e0PastHalf
      haveI := ChartedSpace.locPathConnectedSpace E0Y e0PastHalf
      ∃ (y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) e0PastHalf)ᶜ : Set e0PastHalf))
        (yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0))
        (Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
          DInfty × ℝ), (∀ e, orbitMk (GammaA (2 * Real.pi)) (Φ e) = e.base) ∧
          Nonempty (BTZTildeData e0PastHalf y₀ Φ)) := by
  refine ⟨e0PastHalf_counterexample.1, e0PastHalf_isE0CauchyComplete,
    e0PastHalf_counterexample.2.1, e0PastHalf_not_isBTZFutureComplete, ?_⟩
  letI := E0Bridge.e0SingularGXStructure e0PastHalf
  haveI := ChartedSpace.locPathConnectedSpace E0Y e0PastHalf
  obtain ⟨yN, Φ, hΦ⟩ := btz_exists_presentation
  exact ⟨E0Bridge.basePt (pastHalfRegPt 1 one_ne_zero), yN, Φ, hΦ,
    BTZTildeData.nonempty E0Bridge.isBTZSingModelled_e0 hΦ⟩

end PastHalfRad

end PastHalf


end GX
