import GXScaffold.BTZ.LocalModel
import GXScaffold.BTZ.Topology
import GXScaffold.BTZ.VirtTame
import Causal.StrongCausality
import Causal.GlobalHyperbolicity
import Causal.Generated
import Causal.GXStructure

/-!
# `GXScaffold.BTZ.Manifolds` — causal notions on `BTZ`- and `\widetilde{BTZ}`-manifolds (l.2313–2359)

Package WP-41l (WAVE5-PLAN.md, WP-39l). `papers/gx`, §4.5 (`RamcovGX.tex:2313–2361`).

* **`def:manifolds_future_distinguishing_map`** — `RamcovGX.tex:2317`, and its verbatim repeat
  **`def:manifolds_future_distinguishing_map_2`** — `RamcovGX.tex:2356` (D-8, one definition):
  `GX.IsFutureDistinguishing`.
* **`def:singular_manifold_endowed_causal`** — `RamcovGX.tex:2319`: `GX.IsCausallyConnected`
  (literal; WP-41e's stronger `CausallyArcConnected` implies it,
  `GX.isCausallyConnected_of_causallyArcConnected`).
* **`def:manifold_future_complete_all`** — `RamcovGX.tex:2343`: `GX.IsFutureComplete`, for `M`
  `GX.BTZTildeData.IsBTZFutureComplete`; inhabited by the model (`GX.btzJ0_isFutureComplete`);
  invariant under `D ↦ g · D` (`GX.BTZTildeData.isBTZFutureComplete_iff_of_smul`).
* `lem:globally_hyperbolic_manifolds_manifolds` — `RamcovGX.tex:2325`, partial (reading of
  `\widetilde{BTZ}`-manifold): `GX.e0Manifold_isFutureDistinguishing`,
  `GX.btzTildeAtlas_isFutureDistinguishing`, `GX.BTZTildeData.isFutureDistinguishing`; also for
  `M` in the `SingularGXStructure` form, `GX.e0SingManifold_isFutureDistinguishing`.
* `lem:manifolds_manifolds_causally_connected` — `RamcovGX.tex:2329`, partial (same reading):
  `GX.e0Manifold_isCausallyConnected`, `GX.btzTildeAtlas_isCausallyConnected`,
  `GX.BTZTildeData.isCausallyConnected`.
* `lem:increasing_map` — `RamcovGX.tex:2334`, partial (D-10 `∀ x y ∈ \widetilde M`; rests on WP-41d's
  readings of `\widetilde M`): `GX.BTZTildeData.increasing` (`<` of l.2193),
  `GX.BTZTildeData.increasing_lt` (`≪`), generic `GX.btzTilde_le_dev`, `GX.btzTilde_lt_dev`.
* `lem:globally_hyperbolic_manifolds_maximal` — `RamcovGX.tex:2359`, partial: stated in the
  paper's form "`M` GH ⇒ `\widetilde M` future distinguishing"
  (`GX.BTZTildeData.isFutureDistinguishing_of_base`), resting on ONE tagged `sorry`, the transfer
  "`M` GH ⇒ `\widetilde M` GH" (`GX.BTZTildeData.globallyHyperbolic_of_base`, its causal half
  proved); the Lorentzian half "`\widetilde M` GH ⇒ future distinguishing" is 0 `sorry` (SCOPE (d)).

> \begin{defi} A $\BTZtilde$-manifolds $M$ is future distinguishing if the map $x\mapsto I^+(x)$
> defined on $M$ is injective. \end{defi}
> \begin{defi} A singular $\mass{}$-manifold $M$ endowed with some causal pre-order $\leq$
> extending the one on $\reg(M)$ is causally connected if for all $x,y\in M$ such that $x\leq y$,
> there exists a future causal path from $x$ to $y$. \end{defi}
> \begin{lem} Globally hyperbolic $\BTZ$-manifolds and $\BTZtilde$-manifolds are future
> distinguishing. \end{lem}
> \begin{lem} $\BTZ$-manifolds and $\BTZtilde$-manifolds are causally connected. \end{lem}
> \begin{lem} Let $M$ be a $\BTZ$-manifold and let $\D:\widetilde M\rightarrow \mass{}$ be a
> developing map. Then $\D$ is increasing on $M$ eg $\forall x,y\in M, x<y \Rightarrow \D(x)<\D(y)$.
> \end{lem}
> \begin{defi} A $\BTZ$-manifold $M$ is future complete if for all $x\in \widetilde M$
> $\D(J^+(x)) = J^+(\D(x))$ and $\D(I^+(x)) = I^+(\D(x))$. \end{defi}
> \begin{lem} Let $M$ be a Globally hyperbolic $\BTZ$-manifolds. its maximal branched covering
> $\widetilde M$ is future distinguishing. \end{lem} (l.2317–2361)

## What is built (one tagged `sorry`: the GH transfer of SCOPE (d))

* The causality of an `𝔼₀`-manifold `M` in the `SingularGXStructure` form: generated by its regular
  charts (into `𝕄`) and its `𝔼₀`-charts (`def:atlas`, into `𝔼₀`) in `Y = 𝕄 ⊕ 𝔼₀`
  (`GX.e0ManifoldAtlas`, `GX.e0ManifoldCausality`, through the generic `GX.chartAtlasCausality`):
  tarentin, `Z⁺ = M`, GH ⇒ future distinguishing.

* `BTZ`-manifolds in the charted form of `GXScaffold.BTZ.LocalModel` (`ChartedSpace E0Y M`,
  `HasGroupoid M e0Groupoid`, `chartedCausality E0LM.D M`): GH ⇒ future distinguishing (tarentin
  `E0LM.e0_tarentin`, `Z⁺ = M` `E0LM.charted_mem_Zplus`, `GloballyHyperbolic.stronglyCausal`,
  `Iplus_injOn_Zplus`), causally connected (`E0LM.e0_causallyArcConnected`).
* `\widetilde{BTZ}`-manifolds: a space with an atlas `A` into `J⁺(Δ₀)` with the BTZ topology
  (`GX.BTZJ0`, WP-41h; `≅ \widetilde{𝔼₀}` with `T_BTZ` by `D`), causality generated by the charts
  transporting `btzJCausality` (`GX.btzTildeAtlasCausality`, DEC-33): tarentin, `Z⁺ = N`, causally
  connected, GH ⇒ future distinguishing, for **every** atlas. Developed by `D`
  (`GX.btzTildeDevAtlas`, `GX.IsBTZTildeDev`, transitions isometries): `D` increasing for `≤`, `<`,
  `≪`, and the causality is causal.
* `\widetilde M` (WP-41d's maximal covering of an `𝔼₀`-manifold, `IsBTZSingModelled`) with a
  chartwise-`T_BTZ` topology natural over `reg M` (`GX.btz_manifold_exists_chartwise_tamifying_reg`,
  WP-41d's construction with the regular clause kept) is such a manifold: regular charts from `D`
  (`GX.exists_mem_btzTildeDevAtlas_of_chart`), singular ones from the lifted charts
  (`GX.exists_mem_btzTildeDevAtlas_of_descent`); bundled as `GX.BTZTildeData` (non-empty,
  `GX.BTZTildeData.nonempty`), Hausdorff.

## Hypothesis checklist

| paper / dispatch | here |
|---|---|
| `x ↦ I⁺(x)` injective (l.2317 = l.2356) | ✓ `IsFutureDistinguishing C`, for every causality (`I⁺ = C.Iplus ⊤ {x}`) |
| "some causal pre-order extending the one on `reg(M)`" (l.2319) | ✓ any `Causal.Causality`; "future causal path" = `CausalCurveOn ⊤ c 0 1` |
| `BTZ`-manifold (l.2325, l.2329) | ✓ read: LocalModel's charted form (`E0Y`, `e0Groupoid`, `chartedCausality`); `[T2Space M]` (DEC-66 (a)) for l.2325 |
| `\widetilde{BTZ}`-manifold (l.2325, l.2329; never defined, WP-41d's question) | ⚠ read: Hausdorff space with an atlas into `J⁺(Δ₀)` (BTZ topology), causality generated by the charts; no compatibility used (⚠ weakened) |
| globally hyperbolic | ✓ ETT's `GloballyHyperbolic` (causal + compact diamonds; l.2235's Geroch form) |
| `D : \widetilde M → 𝐌³`, `T_BTZ` (l.2312, DEC-77 (b)) | ✓ `BTZTildeData`: WP-41d's tamifying topology (chartwise `T_BTZ`, natural over `reg M`), `T'`-continuous `D`, `IsLocallyBTZTilde` |
| `∀ x,y ∈ M` in `lem:increasing_map` | ⚠ corrected (D-10): `∀ x, y ∈ \widetilde M` |
| `x < y` (l.2193: causal and `t' > t`) | ✓ `≤ ∧ ≠ ⇒ D x ≤ D y ∧ D x ≠ D y`; `≪` version too |
| "for all `x ∈ \widetilde M`" (l.2343) | ✓ `IsFutureComplete C D`, `J^±`, `I^±` of `\widetilde M` and of `minkowski 2` |
| `M` globally hyperbolic (l.2359) | ⚠ carried (`e0ManifoldCausality M`); the transfer to `\widetilde M` is a tagged `sorry` (SCOPE (d)) |

## SCOPE (disclosed)

* (a) The `\widetilde{BTZ}`-model is `J⁺(Δ₀)` with the BTZ topology, homeomorphic to
  `\widetilde{𝔼₀}` with `T_BTZ` (`btzJDevHomeomorph`, WP-41h); its causality `btzJCausality` is
  WP-41h's (curves, BTZ-continuous, increasing for the order of `𝐌³`). A regular chart into `𝐌³`
  is translated into `J⁺(Δ₀) ∖ Δ₀` (`exists_mem_btzTildeDevAtlas_of_chart`), so one model suffices.
* (b) The causality of `\widetilde M` is generated by **all** charts developed by `D`
  (`btzTildeDevAtlas`); two of them differ by an isometry (`btzTildeDevAtlas_transition`). Whether
  it equals the causality generated by a sub-atlas (absolute minimality across charts) is not
  needed and not proved.
* (c) `lem:increasing_map` is proved from the construction: each generating link is an increasing
  model curve read by `D = g · val ∘ κ`, and `g` is monotone (`isom_le_top_iff`); the paper's
  "locally increasing + causally connected" is this argument. It rests on WP-41d's two pending
  readings of `prop:manifold_admits_galoisian_maximal` (chartwise `T_BTZ`; local `\widetilde{BTZ}`).
* (d) `lem:globally_hyperbolic_manifolds_maximal`: the paper's hypothesis "`M` globally
  hyperbolic" is stated for `M`'s own causality, generated by its charts into `𝕄 ⊕ 𝔼₀`
  (`e0ManifoldCausality`; the `SingularGXStructure` form, the one `\widetilde M` is built from), and
  the paper's statement is `BTZTildeData.isFutureDistinguishing_of_base`. It rests on the transfer
  `BTZTildeData.globallyHyperbolic_of_base` ("`M` GH ⇒ `\widetilde M` GH", "a lift of a Cauchy
  surface is Cauchy"): causality of `\widetilde M` is proved; compactness of its diamonds is the
  one tagged `sorry` — it needs (i) the projection `\widetilde M → M` causal (comparing the charts
  of `\widetilde M` developed by `D` with those of `M` through `IsLocallyBTZTilde`'s lifts) and
  (ii) either lifting inextensible causal curves through the BTZ lines for `T_BTZ` plus Geroch for
  singular spacetimes (Cauchy ⇒ GH, `geroch_sing_*`, scaffold), or a limit-curve theorem; neither
  exists for topological spacetimes at the pin. The Lorentzian half the paper invokes
  ("`\widetilde M` GH ⇒ future distinguishing") is proved (0 `sorry`).
* (e) `GX.btz_manifold_exists_chartwise_tamifying_reg` and `GX.isLocallyBTZTilde_of_chartwise`
  repeat WP-41d's proofs verbatim (VirtTame), keeping one more conclusion (natural over `reg M`)
  and allowing any `T'`, `D`; no statement of WP-41d is changed.

Provenance: mathlib `fabf563a` (tag `v4.31.0`), pinned via `lakefile.toml`; lean-causal `ca2ad78`
(`lake-manifest.json`).
-/

namespace GX

open Set Filter Topology Function TopologicalSpace Relation
open scoped Real

universe u

section Defs

variable {N : Type u} [TopologicalSpace N]

/-- **`def:manifolds_future_distinguishing_map`** (`RamcovGX.tex:2317`, repeated verbatim as
`def:manifolds_future_distinguishing_map_2`, l.2356, D-8): a spacetime is *future distinguishing*
if `x ↦ I⁺(x)` is injective. -/
def IsFutureDistinguishing (C : Causal.Causality N) : Prop :=
  Injective fun x : N => C.Iplus ⊤ {x}

/-- **`def:singular_manifold_endowed_causal`** (`RamcovGX.tex:2319`): a spacetime is *causally
connected* if for all `x ≤ y` there is a future causal path from `x` to `y`. -/
def IsCausallyConnected (C : Causal.Causality N) : Prop :=
  ∀ x y : N, C.le ⊤ x y → ∃ c : ℝ → N, C.CausalCurveOn ⊤ c 0 1 ∧ c 0 = x ∧ c 1 = y

/-- Causal arc-connectedness (`Causal.Causality.CausallyArcConnected`, the reading of WP-41e)
implies the paper's causal connectedness. -/
theorem isCausallyConnected_of_causallyArcConnected {C : Causal.Causality N}
    (h : C.CausallyArcConnected) : IsCausallyConnected C := fun x y hxy =>
  ((h ⊤ le_rfl x y).1.1 hxy)

/-- **`def:manifold_future_complete_all`** (`RamcovGX.tex:2343`): for a causality `C` on
`\widetilde M` and a developing map `D`, *future completeness* is
`D(J⁺(x)) = J⁺(D x)` and `D(I⁺(x)) = I⁺(D x)` for every `x`. -/
def IsFutureComplete (C : Causal.Causality N) (D : N → Causal.Minkowski 2) : Prop :=
  ∀ x : N, D '' C.Jplus ⊤ {x} = (Causal.minkowski 2).Jplus ⊤ {D x} ∧
    D '' C.Iplus ⊤ {x} = (Causal.minkowski 2).Iplus ⊤ {D x}

/-- The generic step of `lem:globally_hyperbolic_manifolds_manifolds`: a Hausdorff tarentin
globally hyperbolic spacetime whose points are all strongly tarentin in the future is future
distinguishing (`prop:GH_fortement_causal` + `prop:FZenon_injectif`). -/
theorem isFutureDistinguishing_of_globallyHyperbolic [T2Space N] {C : Causal.Causality N}
    (hT : C.Tarentin) (hZ : ∀ x : N, x ∈ C.Zplus) (hG : C.GloballyHyperbolic) :
    IsFutureDistinguishing C := fun x y h =>
  Causal.Causality.Iplus_injOn_Zplus (hG.stronglyCausal hT) (hZ x) (hZ y) h

end Defs

/-! ### `BTZ`-manifolds (the charted form of `GXScaffold.BTZ.LocalModel`) -/

section E0Manifolds

variable {M : Type} [TopologicalSpace M] [ChartedSpace E0Y M] [HasGroupoid M e0Groupoid]

/-- `lem:globally_hyperbolic_manifolds_manifolds`, `BTZ`-manifolds. -/
theorem e0Manifold_isFutureDistinguishing [T2Space M]
    (hG : (Causal.CBG.chartedCausality E0LM.D M).GloballyHyperbolic) :
    IsFutureDistinguishing (Causal.CBG.chartedCausality E0LM.D M) :=
  isFutureDistinguishing_of_globallyHyperbolic E0LM.e0_tarentin
    (E0LM.charted_mem_Zplus (M := M) E0.chartIso_mem_e0Groupoid E0.absolutelyMinimalOn_YBTZ
      E0LM.yb_locZplus) hG

/-- `lem:manifolds_manifolds_causally_connected`, `BTZ`-manifolds. -/
theorem e0Manifold_isCausallyConnected :
    IsCausallyConnected (Causal.CBG.chartedCausality E0LM.D M) :=
  isCausallyConnected_of_causallyArcConnected E0LM.e0_causallyArcConnected

end E0Manifolds

/-! ### `\widetilde{BTZ}`-manifolds: atlases into `J⁺(Δ₀)` with the BTZ topology -/

section TildeAtlas

/-- The chart model of `\widetilde{BTZ}`: `J⁺(Δ₀)`, `Δ₀ = btzLine 0`, with the BTZ topology
(`defi:BTZtop`), homeomorphic to `\widetilde{𝔼₀}` with `T_BTZ` by `D` (`GX.btzJDevHomeomorph`). -/
abbrev BTZJ0 : Type := BTZJplus (0 : ℝ × ℝ × ℝ)

variable {N : Type u} [TopologicalSpace N]

/-- **The causality of a `\widetilde{BTZ}`-manifold** (l.2313, DEC-33): the causality generated
(`theo:causalite_engendre`) by the charts of an atlas `A` into `J⁺(Δ₀)`, each transporting the ETT
causality `btzJCausality` of `J⁺(Δ₀)` (WP-41h). -/
noncomputable def btzTildeAtlasCausality (A : Set (OpenPartialHomeomorph N BTZJ0))
    (hA : ∀ e : N, ∃ κ ∈ A, e ∈ κ.source) : Causal.Causality N :=
  Causal.Causality.generated (fun κ : A => Causal.chartSource κ.1)
    (fun e => ⟨⟨(hA e).choose, (hA e).choose_spec.1⟩, (hA e).choose_spec.2⟩)
    (fun κ => (btzJCausality (0 : ℝ × ℝ × ℝ)).chartTransport κ.1)

variable {A : Set (OpenPartialHomeomorph N BTZJ0)} {hA : ∀ e : N, ∃ κ ∈ A, e ∈ κ.source}

theorem btzTilde_link_le_iff {κ : OpenPartialHomeomorph N BTZJ0} {V : Opens N} {x y : N} :
    ((btzJCausality (0 : ℝ × ℝ × ℝ)).chartTransport κ).le (V ⊓ Causal.chartSource κ) x y ↔
      x ∈ V ⊓ Causal.chartSource κ ∧ y ∈ V ⊓ Causal.chartSource κ ∧
        btzJCLe (Causal.chartImage κ (V ⊓ Causal.chartSource κ)) (κ x) (κ y) := by
  rw [Causal.Causality.chartTransport, Causal.LocalCausality.extend_le_iff inf_le_right]
  rfl

theorem btzTilde_link_lt_iff {κ : OpenPartialHomeomorph N BTZJ0} {V : Opens N} {x y : N} :
    ((btzJCausality (0 : ℝ × ℝ × ℝ)).chartTransport κ).lt (V ⊓ Causal.chartSource κ) x y ↔
      x ∈ V ⊓ Causal.chartSource κ ∧ y ∈ V ⊓ Causal.chartSource κ ∧
        btzJCLt (Causal.chartImage κ (V ⊓ Causal.chartSource κ)) (κ x) (κ y) := by
  rw [Causal.Causality.chartTransport, Causal.LocalCausality.extend_lt_iff inf_le_right]
  rfl

theorem btzTildeAtlasCausality_le_iff {V : Opens N} {x y : N} :
    (btzTildeAtlasCausality A hA).le V x y ↔
      TransGen (fun a b => ∃ κ : A,
        ((btzJCausality (0 : ℝ × ℝ × ℝ)).chartTransport κ.1).le (V ⊓ Causal.chartSource κ.1) a b)
        x y := Iff.rfl

theorem btzTildeAtlasCausality_lt_iff {V : Opens N} {x y : N} :
    (btzTildeAtlasCausality A hA).lt V x y ↔
      TransGen (fun a b => ∃ κ : A,
        ((btzJCausality (0 : ℝ × ℝ × ℝ)).chartTransport κ.1).lt (V ⊓ Causal.chartSource κ.1) a b)
        x y := Iff.rfl

/-- A chart link is a relation of the generated causality. -/
theorem btzTildeAtlasCausality_le_of_link {κ : OpenPartialHomeomorph N BTZJ0} (hκ : κ ∈ A)
    {V : Opens N} {x y : N}
    (h : ((btzJCausality (0 : ℝ × ℝ × ℝ)).chartTransport κ).le (V ⊓ Causal.chartSource κ) x y) :
    (btzTildeAtlasCausality A hA).le V x y :=
  TransGen.single ⟨⟨κ, hκ⟩, h⟩

theorem btzTildeAtlasCausality_lt_of_link {κ : OpenPartialHomeomorph N BTZJ0} (hκ : κ ∈ A)
    {V : Opens N} {x y : N}
    (h : ((btzJCausality (0 : ℝ × ℝ × ℝ)).chartTransport κ).lt (V ⊓ Causal.chartSource κ) x y) :
    (btzTildeAtlasCausality A hA).lt V x y :=
  TransGen.single ⟨⟨κ, hκ⟩, h⟩

/-! #### Local facts of the model `J⁺(Δ₀)` -/

/-- In the model, every open `P ∋ q` contains a point `q'` with `q ≪_P q'`. -/
theorem btzJ0_exists_lt_mem {q : BTZJ0} {P : Set BTZJ0} (hP : IsOpen P) (hq : q ∈ P) :
    ∃ q' ∈ P, btzJCLt ⟨P, hP⟩ q q' := by
  set m : Causal.Minkowski 2 := q.val + ((1 : ℝ), (0 : EuclideanSpace ℝ (Fin 2)))
  have hlt : (Causal.minkowski 2).lt ⊤ q.val m := by
    rw [Causal.minkowski_lt_top_iff]
    simp [m]
  have hm : m ∈ btzJplus (0 : ℝ × ℝ × ℝ) := by
    obtain ⟨p, hp, hpq⟩ := q.mem
    exact ⟨p, hp, (Causal.minkowski 2).le_trans hpq ((Causal.minkowski 2).le_of_lt hlt)⟩
  set q₁ : BTZJ0 := BTZJplus.mk m hm
  have h : btzJLt q q₁ := hlt
  have hcont := btzJ_continuousOn_seg h.le
  have hN : btzJSeg h.le ⁻¹' P ∈ 𝓝[Icc (0 : ℝ) 1] 0 :=
    hcont 0 ⟨le_rfl, zero_le_one⟩ (by rw [btzJSeg_zero]; exact hP.mem_nhds hq)
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhdsWithin_iff.1 hN
  set s₀ : ℝ := min (ε / 2) 1
  have hs₀ : 0 < s₀ := lt_min (by linarith) one_pos
  have hmem : ∀ s ∈ Icc (0 : ℝ) s₀, btzJSeg h.le s ∈ P := fun s hs => by
    refine hball ⟨?_, hs.1, hs.2.trans (min_le_right _ _)⟩
    rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_lt]
    constructor <;> linarith [hs.1, hs.2, min_le_left (ε / 2) 1]
  refine ⟨btzJSeg h.le s₀, hmem s₀ ⟨hs₀.le, le_rfl⟩, 0, s₀, hs₀, btzJSeg h.le, ?_,
    btzJSeg_zero h.le, rfl⟩
  exact btzJ_curveOn_of_continuousOn (hcont.mono (Icc_subset_Icc le_rfl (min_le_right _ _)))
    hmem fun s hs s' _ hss' => btzJ_lt_segPt h hs.1 hss'

/-- In the model, every open `P ∋ q` contains a diamond around `q`: points `p₁, p₂ ∈ P` and an
open `O ∋ q` whose points `z` satisfy `p₁ ≤_P z ≤_P p₂` (from `GX.btz_exists_diamond`, WP-41h,
through `D : \widetilde{𝔼₀} ≃ₜ J⁺(Δ₀)`). -/
theorem btzJ0_exists_diamond {q : BTZJ0} {P : Set BTZJ0} (hP : IsOpen P) (hq : q ∈ P) :
    ∃ p₁ ∈ P, ∃ p₂ ∈ P, ∃ O : Set BTZJ0, IsOpen O ∧ q ∈ O ∧
      ∀ z ∈ O, btzJCLe ⟨P, hP⟩ p₁ z ∧ btzJCLe ⟨P, hP⟩ z p₂ := by
  set H : DInfty × ℝ → BTZJ0 := btzJDev (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos
  set Hs : BTZJ0 → DInfty × ℝ := ⇑(btzJDevEquiv (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos).symm
  have hHs : Continuous[btzJTop 0, hornTop] Hs := continuous_btzJDevEquiv_symm btzV0_pos
  have hH : Continuous[hornTop, btzJTop 0] H := continuous_btzJDev btzV0_pos
  have hHv : ∀ y, (H y).val = btzDevM 0 btzV0 y := fun y => rfl
  have hHHs : ∀ z, H (Hs z) = z := fun z =>
    (btzJDevEquiv (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos).apply_symm_apply z
  have hval : ∀ z, btzDevM 0 btzV0 (Hs z) = z.val := fun z => by rw [← hHv, hHHs]
  have hN : H ⁻¹' P ∈ @nhds _ hornTop (Hs q) := by
    refine @IsOpen.mem_nhds _ hornTop _ _ (@IsOpen.preimage _ _ hornTop _ _ hH _ hP) ?_
    show H (Hs q) ∈ P
    rw [hHHs]; exact hq
  obtain ⟨pc, qc, hy, hsub⟩ := btz_exists_diamond (x₀ := 0) btzV0_pos (Hs q) hN
  have hyD : Hs q ∈ btzCylDiamond 0 btzV0 pc qc := @interior_subset _ hornTop _ _ hy
  -- the diamond, read in `J⁺(Δ₀)`
  have hdiam : ∀ z : BTZJ0, (Causal.minkowski 2).le ⊤ (H qc).val z.val →
      (Causal.minkowski 2).le ⊤ z.val (H pc).val → z ∈ P := fun z h1 h2 => by
    have : Hs z ∈ btzCylDiamond 0 btzV0 pc qc := by
      refine ⟨?_, ?_⟩
      · change (Causal.minkowski 2).le ⊤ (btzDevM 0 btzV0 (Hs z)) (btzDevM 0 btzV0 pc)
        rw [hval, ← hHv]; exact h2
      · change (Causal.minkowski 2).le ⊤ (btzDevM 0 btzV0 qc) (btzDevM 0 btzV0 (Hs z))
        rw [hval, ← hHv]; exact h1
    have h' := hsub this
    rw [mem_preimage, hHHs] at h'
    exact h'
  have hqc_le : (Causal.minkowski 2).le ⊤ (H qc).val (H pc).val := by
    rw [hHv, hHv]; exact (Causal.minkowski 2).le_trans hyD.2 hyD.1
  -- a segment between two points of the diamond stays in it
  have hseg : ∀ z z' : BTZJ0, ∀ h : btzJLe z z', (Causal.minkowski 2).le ⊤ (H qc).val z.val →
      (Causal.minkowski 2).le ⊤ z'.val (H pc).val → btzJCLe ⟨P, hP⟩ z z' := by
    intro z z' h hz hz'
    refine ⟨0, 1, zero_le_one, btzJSeg h, btzJ_curveOn_seg h fun s hs => ?_, btzJSeg_zero h,
      btzJSeg_one h⟩
    refine hdiam _ ?_ ?_
    · refine (Causal.minkowski 2).le_trans hz ?_
      have := btzJ_le_segPt h hs.1
      rwa [btzJSegPt_zero] at this
    · refine (Causal.minkowski 2).le_trans ?_ hz'
      have := btzJ_le_segPt h hs.2
      rwa [btzJSegPt_one] at this
  refine ⟨H qc, hdiam _ ((Causal.minkowski 2).le_refl (mem_univ _)) hqc_le, H pc,
    hdiam _ hqc_le ((Causal.minkowski 2).le_refl (mem_univ _)),
    Hs ⁻¹' (@interior _ hornTop (btzCylDiamond 0 btzV0 pc qc)),
    @IsOpen.preimage _ _ (btzJTop 0) hornTop _ hHs _ (@isOpen_interior _ hornTop _), hy,
    fun z hz => ?_⟩
  have hzD : Hs z ∈ btzCylDiamond 0 btzV0 pc qc := @interior_subset _ hornTop _ _ hz
  have h1 : (Causal.minkowski 2).le ⊤ (H qc).val z.val := by
    have h := hzD.2
    change (Causal.minkowski 2).le ⊤ (btzDevM 0 btzV0 qc) (btzDevM 0 btzV0 (Hs z)) at h
    rwa [hval, ← hHv] at h
  have h2 : (Causal.minkowski 2).le ⊤ z.val (H pc).val := by
    have h := hzD.1
    change (Causal.minkowski 2).le ⊤ (btzDevM 0 btzV0 (Hs z)) (btzDevM 0 btzV0 pc) at h
    rwa [hval, ← hHv] at h
  exact ⟨hseg _ _ h1 ((Causal.minkowski 2).le_refl (mem_univ _)) h2,
    hseg _ _ h2 h1 ((Causal.minkowski 2).le_refl (mem_univ _))⟩

/-! #### The generated causality of an atlas: local facts -/

/-- The image of the chart source is the target. -/
theorem btzTilde_target_le_chartImage (κ : OpenPartialHomeomorph N BTZJ0) {P : Set BTZJ0}
    (hP : P ⊆ κ.target) (hPo : IsOpen P) :
    (⟨P, hPo⟩ : Opens BTZJ0) ≤ Causal.chartImage κ (⊤ ⊓ Causal.chartSource κ) := by
  intro p hp
  exact ⟨κ.symm p, ⟨κ.map_target (hP hp), trivial, κ.map_target (hP hp)⟩, κ.right_inv (hP hp)⟩

/-- **Every point is strongly tarentin in the future**: `Z⁺ = N`. -/
theorem btzTildeAtlas_mem_Zplus (e : N) : e ∈ (btzTildeAtlasCausality A hA).Zplus := by
  intro S hS
  obtain ⟨κ, hκA, he⟩ := hA e
  set P : Set BTZJ0 := κ.target ∩ κ.symm ⁻¹' interior S
  have hPo : IsOpen P := κ.isOpen_inter_preimage_symm isOpen_interior
  have hqP : κ e ∈ P := ⟨κ.map_source he, by
    rw [mem_preimage, κ.left_inv he]; exact mem_interior_iff_mem_nhds.2 hS⟩
  obtain ⟨q', hq'P, hlt⟩ := btzJ0_exists_lt_mem hPo hqP
  have hq't : q' ∈ κ.target := hq'P.1
  refine ⟨κ.symm q', ?_, interior_subset hq'P.2⟩
  rw [Causal.Precausality.mem_Iplus_singleton]
  refine btzTildeAtlasCausality_lt_of_link hκA (btzTilde_link_lt_iff.2
    ⟨⟨trivial, he⟩, ⟨trivial, κ.map_target hq't⟩, ?_⟩)
  rw [κ.right_inv hq't]
  exact btzJCLt.mono (btzTilde_target_le_chartImage κ (fun _ h => h.1) hPo) hlt

/-- **The generated causality of an atlas is tarentin.** -/
theorem btzTildeAtlas_tarentin : (btzTildeAtlasCausality A hA).Tarentin := by
  intro e S hS
  obtain ⟨κ, hκA, he⟩ := hA e
  set P : Set BTZJ0 := κ.target ∩ κ.symm ⁻¹' interior S
  have hPo : IsOpen P := κ.isOpen_inter_preimage_symm isOpen_interior
  have hqP : κ e ∈ P := ⟨κ.map_source he, by
    rw [mem_preimage, κ.left_inv he]; exact mem_interior_iff_mem_nhds.2 hS⟩
  obtain ⟨p₁, hp₁, p₂, hp₂, O, hOo, hqO, hO⟩ := btzJ0_exists_diamond hPo hqP
  have hPle := btzTilde_target_le_chartImage κ (fun _ h => h.1) hPo
  refine ⟨κ.symm p₁, interior_subset hp₁.2, κ.symm p₂, interior_subset hp₂.2, ?_⟩
  have hW : IsOpen (κ.source ∩ κ ⁻¹' (O ∩ P)) := κ.isOpen_inter_preimage (hOo.inter hPo)
  refine interior_maximal ?_ hW ⟨he, hqO, hqP⟩
  rintro w ⟨hw, hwO, hwP⟩
  obtain ⟨h1, h2⟩ := hO _ hwO
  refine ⟨?_, ?_⟩
  · rw [Causal.Precausality.mem_Jminus_singleton]
    refine btzTildeAtlasCausality_le_of_link hκA (btzTilde_link_le_iff.2
      ⟨⟨trivial, hw⟩, ⟨trivial, κ.map_target hp₂.1⟩, ?_⟩)
    rw [κ.right_inv hp₂.1]
    exact btzJCLe.mono hPle h2
  · rw [Causal.Precausality.mem_Jplus_singleton]
    refine btzTildeAtlasCausality_le_of_link hκA (btzTilde_link_le_iff.2
      ⟨⟨trivial, κ.map_target hp₁.1⟩, ⟨trivial, hw⟩, ?_⟩)
    rw [κ.right_inv hp₁.1]
    exact btzJCLe.mono hPle h1

/-- **A model curve read through a chart is a future causal curve** of the generated causality. -/
theorem btzTildeAtlas_causalCurveOn_of_model {κ : OpenPartialHomeomorph N BTZJ0} (hκA : κ ∈ A)
    {O : Opens BTZJ0} (hO : (O : Set BTZJ0) ⊆ κ.target) {c : ℝ → BTZJ0} {a b : ℝ}
    (hc : Causal.CurveOn (btzJRelOn btzJLe) O c a b) :
    (btzTildeAtlasCausality A hA).CausalCurveOn ⊤ (fun t => κ.symm (c t)) a b where
  mem _ _ := trivial
  rel t ht N' _ htN' := by
    have hct : c t ∈ κ.target := hO (hc.mem t ht)
    set O' : Opens BTZJ0 := Causal.chartImage κ N'
    have hctO' : c t ∈ O' := ⟨κ.symm (c t), ⟨κ.map_target hct, htN'⟩, κ.right_inv hct⟩
    have hcont := hc.continuousOn btzJ_isRelFamily_le
    have hNt : c ⁻¹' ((O' ⊓ O : Opens BTZJ0) : Set BTZJ0) ∈ 𝓝[Icc a b] t :=
      hcont t ht ((O' ⊓ O).isOpen.mem_nhds ⟨hctO', hc.mem t ht⟩)
    obtain ⟨ε, hε, hball⟩ := Metric.mem_nhdsWithin_iff.1 hNt
    refine ⟨t - ε, t + ε, by linarith, by linarith, fun s hs s' hs' h1 h2 h3 => ?_⟩
    have hmem : ∀ τ ∈ Icc s s', c τ ∈ (O' ⊓ O : Opens BTZJ0) := fun τ hτ => by
      refine hball ⟨?_, hs.1.trans hτ.1, hτ.2.trans hs'.2⟩
      rw [Metric.mem_ball, Real.dist_eq, abs_lt]
      constructor <;> linarith [hτ.1, hτ.2]
    have hrel : btzJCLe (O' ⊓ O) (c s) (c s') :=
      ⟨s, s', h2.le, c, hc.restrict hs.1 hs'.2 inf_le_right hmem, rfl, rfl⟩
    obtain ⟨z, hzs, hzN, hz, hzs'⟩ := Causal.exists_of_mem_chartImage (hmem s ⟨le_rfl, h2.le⟩).1
    obtain ⟨z', hz's, hz'N, hz', hz's'⟩ :=
      Causal.exists_of_mem_chartImage (hmem s' ⟨h2.le, le_rfl⟩).1
    refine btzTildeAtlasCausality_le_of_link hκA (btzTilde_link_le_iff.2 ?_)
    rw [hzs', hz's']
    refine ⟨⟨hzN, hzs⟩, ⟨hz'N, hz's⟩, ?_⟩
    rw [hz, hz']
    refine btzJCLe.mono ?_ hrel
    rintro p ⟨hpO', -⟩
    obtain ⟨w, hws, hwN, rfl, -⟩ := Causal.exists_of_mem_chartImage hpO'
    exact ⟨w, ⟨hws, hwN, hws⟩, rfl⟩

/-- A chart link is realised by a future causal curve over `[0, 1]`. -/
theorem btzTildeAtlas_exists_curve_of_link {κ : OpenPartialHomeomorph N BTZJ0} (hκA : κ ∈ A)
    {x y : N}
    (h : ((btzJCausality (0 : ℝ × ℝ × ℝ)).chartTransport κ).le (⊤ ⊓ Causal.chartSource κ) x y) :
    ∃ c : ℝ → N, (btzTildeAtlasCausality A hA).CausalCurveOn ⊤ c 0 1 ∧ c 0 = x ∧ c 1 = y := by
  obtain ⟨hx, hy, a, b, hab, c, hc, hca, hcb⟩ := btzTilde_link_le_iff.1 h
  have hO : ((Causal.chartImage κ (⊤ ⊓ Causal.chartSource κ) : Opens BTZJ0) : Set BTZJ0) ⊆
      κ.target := by
    rintro _ ⟨w, ⟨hw, -⟩, rfl⟩; exact κ.map_source hw
  rcases hab.lt_or_eq with hab | hab
  · have hc' : Causal.CurveOn (btzJRelOn btzJLe) (Causal.chartImage κ (⊤ ⊓ Causal.chartSource κ))
        (fun t => c ((b - a) * t + a)) 0 1 :=
      Causal.CurveOn.comp_affine (sub_pos.2 hab) (by simpa using hc)
    refine ⟨_, btzTildeAtlas_causalCurveOn_of_model hκA hO hc', ?_, ?_⟩
    · simp only [mul_zero, zero_add]; rw [hca]; exact κ.left_inv hx.2
    · simp only [mul_one, sub_add_cancel]; rw [hcb]; exact κ.left_inv hy.2
  · have hxy : x = y := κ.injOn hx.2 hy.2 (by rw [← hca, ← hcb, hab])
    subst hxy
    exact ⟨fun _ => x, Causal.Causality.causalCurveOn_const trivial, rfl, rfl⟩

/-- `lem:manifolds_manifolds_causally_connected`, `\widetilde{BTZ}`-manifolds: the generated
causality of every atlas is causally connected. -/
theorem btzTildeAtlas_isCausallyConnected :
    IsCausallyConnected (btzTildeAtlasCausality A hA) := by
  intro x y h
  induction h with
  | single hl =>
    obtain ⟨⟨κ, hκ⟩, hl⟩ := hl
    exact btzTildeAtlas_exists_curve_of_link hκ hl
  | tail _ hl ih =>
    obtain ⟨⟨κ, hκ⟩, hl⟩ := hl
    obtain ⟨c₁, hc₁, h₁0, h₁1⟩ := ih
    obtain ⟨c₂, hc₂, h₂0, h₂1⟩ := btzTildeAtlas_exists_curve_of_link hκ hl
    obtain ⟨c, hc, hc0, hc1⟩ := Causal.CurveOn.exists_concat
      (Causal.Precausality.isRelFamily_le (btzTildeAtlasCausality A hA).toPrecausality)
      hc₁ hc₂ (h₁1.trans h₂0.symm)
    exact ⟨c, hc, hc0.trans h₁0, hc1.trans h₂1⟩

/-- `lem:globally_hyperbolic_manifolds_manifolds`, `\widetilde{BTZ}`-manifolds: a Hausdorff
space with an atlas into `J⁺(Δ₀)`, globally hyperbolic for the generated causality, is future
distinguishing. -/
theorem btzTildeAtlas_isFutureDistinguishing [T2Space N]
    (hG : (btzTildeAtlasCausality A hA).GloballyHyperbolic) :
    IsFutureDistinguishing (btzTildeAtlasCausality A hA) :=
  isFutureDistinguishing_of_globallyHyperbolic btzTildeAtlas_tarentin btzTildeAtlas_mem_Zplus hG

/-! #### Atlases compatible with a developing map -/

/-- The charts **developed by `D`**: `κ` into `J⁺(Δ₀)` with `D = g · val ∘ κ` on its source, for
some `g ∈ Isom(𝐌³)`. Two such charts differ by an isometry on their common source, so the set is
a `(Isom(𝐌³), J⁺(Δ₀))`-atlas whenever it covers (`btzTildeDevAtlas_transition`). -/
def btzTildeDevAtlas (D : N → Causal.Minkowski 2) : Set (OpenPartialHomeomorph N BTZJ0) :=
  {κ | ∃ g : Causal.Flat.isom 2, ∀ w ∈ κ.source, D w = g • (κ w).val}

/-- **`(N, D)` is a `\widetilde{BTZ}`-manifold developed by `D`** (the reading of l.2310, l.2313
for `\widetilde M`): every point is in the source of a chart into `J⁺(Δ₀)` (BTZ topology)
intertwining `D` with the inclusion `J⁺(Δ₀) ⊆ 𝐌³` up to an isometry. -/
def IsBTZTildeDev (D : N → Causal.Minkowski 2) : Prop :=
  ∀ e : N, ∃ κ ∈ btzTildeDevAtlas D, e ∈ κ.source

/-- The transitions of the developed atlas are restrictions of isometries of `𝐌³`. -/
theorem btzTildeDevAtlas_transition {D : N → Causal.Minkowski 2} {κ κ' : OpenPartialHomeomorph N BTZJ0}
    (hκ : κ ∈ btzTildeDevAtlas D) (hκ' : κ' ∈ btzTildeDevAtlas D) :
    ∃ h : Causal.Flat.isom 2, ∀ w ∈ κ.source ∩ κ'.source, (κ' w).val = h • (κ w).val := by
  obtain ⟨g, hg⟩ := hκ
  obtain ⟨g', hg'⟩ := hκ'
  refine ⟨g'⁻¹ * g, fun w hw => ?_⟩
  rw [mul_smul, ← hg w hw.1, hg' w hw.2, inv_smul_smul]

/-- **The causality of a `\widetilde{BTZ}`-manifold developed by `D`**: the one generated by the
developed atlas. -/
noncomputable def btzTildeCausality (D : N → Causal.Minkowski 2) (hD : IsBTZTildeDev D) :
    Causal.Causality N :=
  btzTildeAtlasCausality (btzTildeDevAtlas D) hD

variable {D : N → Causal.Minkowski 2} {hD : IsBTZTildeDev D}

/-- One link of the generated causality, read by `D`. -/
theorem btzTilde_link_dev {κ : OpenPartialHomeomorph N BTZJ0} (hκ : κ ∈ btzTildeDevAtlas D)
    {V : Opens N} {x y : N}
    (hl : ((btzJCausality (0 : ℝ × ℝ × ℝ)).chartTransport κ).le (V ⊓ Causal.chartSource κ) x y) :
    (Causal.minkowski 2).le ⊤ (D x) (D y) ∧ (D x = D y → x = y) := by
  obtain ⟨g, hg⟩ := hκ
  obtain ⟨hx, hy, hc⟩ := btzTilde_link_le_iff.1 hl
  have h1 : (Causal.minkowski 2).le ⊤ (κ x).val (κ y).val := hc.le
  rw [hg x hx.2, hg y hy.2]
  refine ⟨(Causal.Flat.isom_le_top_iff g).2 h1, fun he => ?_⟩
  exact κ.injOn hx.2 hy.2 (BTZJplus.ext (smul_left_cancel g he))

theorem btzTilde_link_dev_lt {κ : OpenPartialHomeomorph N BTZJ0} (hκ : κ ∈ btzTildeDevAtlas D)
    {V : Opens N} {x y : N}
    (hl : ((btzJCausality (0 : ℝ × ℝ × ℝ)).chartTransport κ).lt (V ⊓ Causal.chartSource κ) x y) :
    (Causal.minkowski 2).lt ⊤ (D x) (D y) := by
  obtain ⟨g, hg⟩ := hκ
  obtain ⟨hx, hy, hc⟩ := btzTilde_link_lt_iff.1 hl
  have h1 : (Causal.minkowski 2).lt ⊤ (κ x).val (κ y).val := hc.lt
  rw [hg x hx.2, hg y hy.2]
  exact (Causal.Flat.isom_lt_top_iff g).2 h1

/-- `lem:increasing_map`, causal form: `D` is non-decreasing for `≤`, and constant only on
equal points. -/
theorem btzTilde_le_dev {V : Opens N} {x y : N} (h : (btzTildeCausality D hD).le V x y) :
    (Causal.minkowski 2).le ⊤ (D x) (D y) ∧ (D x = D y → x = y) := by
  induction h with
  | single hl =>
    obtain ⟨⟨κ, hκ⟩, hl⟩ := hl
    exact btzTilde_link_dev hκ hl
  | @tail b c _ hl ih =>
    obtain ⟨⟨κ, hκ⟩, hl⟩ := hl
    obtain ⟨h1, h1e⟩ := ih
    obtain ⟨h2, h2e⟩ := btzTilde_link_dev hκ hl
    refine ⟨(Causal.minkowski 2).le_trans h1 h2, fun he => ?_⟩
    have hb : D x = D b := Causal.minkowski_isCausal h1 (he ▸ h2)
    have hxb : x = b := h1e hb
    subst hxb
    exact h2e he

/-- `lem:increasing_map`, chronological form: `x ≪ y ⇒ D x ≪ D y`. -/
theorem btzTilde_lt_dev {V : Opens N} {x y : N} (h : (btzTildeCausality D hD).lt V x y) :
    (Causal.minkowski 2).lt ⊤ (D x) (D y) := by
  induction h with
  | single hl =>
    obtain ⟨⟨κ, hκ⟩, hl⟩ := hl
    exact btzTilde_link_dev_lt hκ hl
  | tail _ hl ih =>
    obtain ⟨⟨κ, hκ⟩, hl⟩ := hl
    exact (Causal.minkowski 2).lt_trans ih (btzTilde_link_dev_lt hκ hl)

/-- `lem:increasing_map` in the paper's order (`RamcovGX.tex:2193`: `p < q` iff `q − p` is
causal and `t' > t`, i.e. `p ≤ q`, `p ≠ q`): `x < y ⇒ D x < D y`. -/
theorem btzTilde_strict_dev {x y : N} (h : (btzTildeCausality D hD).le ⊤ x y) (hne : x ≠ y) :
    (Causal.minkowski 2).le ⊤ (D x) (D y) ∧ D x ≠ D y :=
  ⟨(btzTilde_le_dev h).1, fun he => hne ((btzTilde_le_dev h).2 he)⟩

/-- A `\widetilde{BTZ}`-manifold developed by `D` is **causal**. -/
theorem btzTilde_isCausal : (btzTildeCausality D hD).IsCausal := fun _ _ hxy hyx =>
  (btzTilde_le_dev hxy).2 (Causal.minkowski_isCausal (btzTilde_le_dev hxy).1 (btzTilde_le_dev hyx).1)

end TildeAtlas

/-! ### Charts into `J⁺(Δ₀)`: the regular inclusion, regular and singular charts -/

section Charts

open Classical

/-- The open half-space `J⁺(Δ₀) ∖ Δ₀` of `𝐌³`. -/
def btzJ0HalfSpace : Set (Causal.Minkowski 2) :=
  {q : Causal.Minkowski 2 | 0 < (nullToMink.symm q - (0 : ℝ × ℝ × ℝ)).2.1}

theorem isOpen_btzJ0HalfSpace : IsOpen btzJ0HalfSpace := isOpen_btzJ_halfSpace

theorem btzJ0HalfSpace_subset : btzJ0HalfSpace ⊆ btzJplus (0 : ℝ × ℝ × ℝ) := fun m hm => by
  have h := (btzJ_mem_jplus_coords (x₀ := (0 : ℝ × ℝ × ℝ)) (nullToMink.symm m - 0)).2
    (Or.inl hm)
  simpa using h

/-- A point of the half-space: `nullToMink (0, 1, 0)`. -/
noncomputable def btzJ0Pt : Causal.Minkowski 2 := nullToMink ((0 : ℝ), (1 : ℝ), (0 : ℝ))

theorem btzJ0Pt_mem : btzJ0Pt ∈ btzJ0HalfSpace := by
  simp [btzJ0HalfSpace, btzJ0Pt]

/-- The inverse of the inclusion `J⁺(Δ₀) ⊆ 𝐌³` (a fixed point off `J⁺(Δ₀)`). -/
noncomputable def btzJ0RegInv (m : Causal.Minkowski 2) : BTZJ0 :=
  if h : m ∈ btzJplus (0 : ℝ × ℝ × ℝ) then BTZJplus.mk m h else
    BTZJplus.mk btzJ0Pt (btzJ0HalfSpace_subset btzJ0Pt_mem)

theorem btzJ0RegInv_of_mem {m : Causal.Minkowski 2} (h : m ∈ btzJplus (0 : ℝ × ℝ × ℝ)) :
    btzJ0RegInv m = BTZJplus.mk m h := dif_pos h

theorem btzJ0RegInv_val {m : Causal.Minkowski 2} (h : m ∈ btzJplus (0 : ℝ × ℝ × ℝ)) :
    (btzJ0RegInv m).val = m := by rw [btzJ0RegInv_of_mem h]; rfl

/-- The inclusion of `J⁺(Δ₀) ∖ Δ₀` in `𝐌³`, an open partial homeomorphism (on `J⁺(Δ₀) ∖ Δ₀` the
BTZ topology is that of `𝐌³`, `GX.nhds_btzJ_of_mem_reg`). -/
noncomputable def btzJ0RegIncl : OpenPartialHomeomorph BTZJ0 (Causal.Minkowski 2) where
  toFun := BTZJplus.val
  invFun := btzJ0RegInv
  source := btzJReg 0
  target := btzJ0HalfSpace
  map_source' q hq := by
    rw [btzJReg_eq_preimage] at hq; exact hq
  map_target' m hm := by
    rw [btzJReg_eq_preimage, mem_preimage, btzJ0RegInv_val (btzJ0HalfSpace_subset hm)]
    exact hm
  left_inv' q _ := by
    rw [btzJ0RegInv_of_mem q.mem]; rfl
  right_inv' m hm := btzJ0RegInv_val (btzJ0HalfSpace_subset hm)
  open_source := isOpen_btzJReg
  open_target := isOpen_btzJ0HalfSpace
  continuousOn_toFun := continuous_btzJ_val.continuousOn
  continuousOn_invFun m hm := by
    have hmJ := btzJ0HalfSpace_subset hm
    have hreg : btzJ0RegInv m ∈ btzJReg (0 : ℝ × ℝ × ℝ) := by
      rw [btzJReg_eq_preimage, mem_preimage, btzJ0RegInv_val hmJ]; exact hm
    show Tendsto btzJ0RegInv _ _
    rw [nhds_btzJ_of_mem_reg hreg, tendsto_comap_iff, btzJ0RegInv_val hmJ]
    refine tendsto_nhdsWithin_of_tendsto_nhds (tendsto_id.congr' ?_)
    filter_upwards [isOpen_btzJ0HalfSpace.mem_nhds hm] with m' hm'
    simp only [comp_apply, id]
    exact (btzJ0RegInv_val (btzJ0HalfSpace_subset hm')).symm

variable {E : Type*} [TopologicalSpace E] {D : E → Causal.Minkowski 2}

/-- **A regular chart**: an open partial homeomorphism `ψ : E → 𝐌³` agreeing with `D` on its
source gives, at each point of its source, a chart of the developed atlas (translate the point
into `J⁺(Δ₀) ∖ Δ₀`). -/
theorem exists_mem_btzTildeDevAtlas_of_chart (ψ : OpenPartialHomeomorph E (Causal.Minkowski 2))
    (hψ : EqOn D ψ ψ.source) {e : E} (he : e ∈ ψ.source) :
    ∃ κ ∈ btzTildeDevAtlas D, e ∈ κ.source := by
  set g : Causal.Flat.isom 2 :=
    ⟨AffineEquiv.constVAdd ℝ (Causal.Minkowski 2) (ψ e - btzJ0Pt),
      Causal.Flat.constVAdd_mem_isom _⟩
  have hge : g⁻¹ • ψ e = btzJ0Pt := by
    rw [inv_smul_eq_iff, Causal.Flat.isom_smul_def]
    simp [g]
  set τ : Causal.Minkowski 2 ≃ₜ Causal.Minkowski 2 := Causal.Flat.isom.toHomeomorph g⁻¹
  set κ := (ψ.transHomeomorph τ).trans btzJ0RegIncl.symm
  have hκ : ∀ w ∈ κ.source, (κ w).val = g⁻¹ • ψ w := by
    intro w hw
    have h2 : g⁻¹ • ψ w ∈ btzJ0HalfSpace := hw.2
    show (btzJ0RegIncl.symm (g⁻¹ • ψ w)).val = _
    exact btzJ0RegIncl.right_inv h2
  refine ⟨κ, ⟨g, fun w hw => ?_⟩, ⟨he, ?_⟩⟩
  · rw [hκ w hw, smul_inv_smul]; exact hψ hw.1
  · show g⁻¹ • ψ e ∈ btzJ0HalfSpace
    rw [hge]; exact btzJ0Pt_mem

/-- **A singular chart**: a lifted chart `Ψ : V̂ → Û` (`GX.IsLocallyBTZTilde`) — `V̂` open in
`\widetilde{𝔼₀}` with `T_BTZ = Φ^* hornTop`, `Ψ` a bijection onto the open `Û` which maps
`T_BTZ`-neighbourhoods onto neighbourhoods, `D ∘ Ψ = g · D_{𝔼₀} ∘ Φ` — gives the chart
`D_{𝔼₀} ∘ Φ ∘ Ψ⁻¹ : Û → J⁺(Δ₀)` of the developed atlas. -/
theorem exists_mem_btzTildeDevAtlas_of_descent {F : Type*} (Φ : F ≃ DInfty × ℝ) {V : Set F}
    (hV : IsOpen[TopologicalSpace.induced Φ hornTop] V) {U : Set E} (hU : IsOpen U) {Ψ : F → E}
    (hbij : BijOn Ψ V U)
    (hn : ∀ v ∈ V, 𝓝 (Ψ v) = Filter.map Ψ (@nhds _ (TopologicalSpace.induced Φ hornTop) v))
    {g : Causal.Flat.isom 2} (hg : ∀ v ∈ V, D (Ψ v) = g • btzDevM 0 btzV0 (Φ v)) {e : E}
    (he : e ∈ U) :
    ∃ κ ∈ btzTildeDevAtlas D, e ∈ κ.source := by
  obtain ⟨v₀, hv₀, -⟩ := hbij.surjOn he
  haveI : Nonempty F := ⟨v₀⟩
  set TF : TopologicalSpace F := TopologicalSpace.induced Φ hornTop
  set j : DInfty × ℝ → BTZJ0 := btzJDev (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos
  set js : BTZJ0 → DInfty × ℝ := ⇑(btzJDevEquiv (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos).symm
  have hj : Continuous[hornTop, btzJTop 0] j := continuous_btzJDev btzV0_pos
  have hjs : Continuous[btzJTop 0, hornTop] js := continuous_btzJDevEquiv_symm btzV0_pos
  have hjjs : ∀ q, j (js q) = q := fun q =>
    (btzJDevEquiv (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos).apply_symm_apply q
  have hjsj : ∀ y, js (j y) = y := fun y =>
    (btzJDevEquiv (0 : ℝ × ℝ × ℝ) btzV0 btzV0_pos).symm_apply_apply y
  have hΦ : Continuous[TF, hornTop] Φ := continuous_induced_dom
  have hΦs : Continuous[hornTop, TF] Φ.symm := continuous_induced_rng.2 (by
    have : (⇑Φ ∘ ⇑Φ.symm) = id := funext fun y => Φ.apply_symm_apply y
    rw [this]; exact @continuous_id _ hornTop)
  set inv : E → F := Function.invFunOn Ψ V
  have hinv : ∀ w ∈ U, inv w ∈ V ∧ Ψ (inv w) = w := fun w hw => by
    have h := hbij.surjOn hw
    exact ⟨Function.invFunOn_mem h, Function.invFunOn_eq h⟩
  have hinvΨ : ∀ v ∈ V, inv (Ψ v) = v := fun v hv => hbij.injOn.leftInvOn_invFunOn hv
  have hVo : IsOpen[hornTop] (Φ.symm ⁻¹' V) := by
    obtain ⟨O, hO, rfl⟩ := (@isOpen_induced_iff _ _ hornTop _ _).1 hV
    have : Φ.symm ⁻¹' (Φ ⁻¹' O) = O := by
      ext y; simp
    rw [this]; exact hO
  let κ : OpenPartialHomeomorph E BTZJ0 :=
    { toFun := fun w => j (Φ (inv w))
      invFun := fun q => Ψ (Φ.symm (js q))
      source := U
      target := js ⁻¹' (Φ.symm ⁻¹' V)
      map_source' := fun w hw => by
        show Φ.symm (js (j (Φ (inv w)))) ∈ V
        rw [hjsj, Φ.symm_apply_apply]; exact (hinv w hw).1
      map_target' := fun q hq => hbij.mapsTo hq
      left_inv' := fun w hw => by
        show Ψ (Φ.symm (js (j (Φ (inv w))))) = w
        rw [hjsj, Φ.symm_apply_apply]; exact (hinv w hw).2
      right_inv' := fun q hq => by
        show j (Φ (inv (Ψ (Φ.symm (js q))))) = q
        rw [hinvΨ _ hq, Φ.apply_symm_apply, hjjs]
      open_source := hU
      open_target := @IsOpen.preimage _ _ (btzJTop 0) hornTop _ hjs _ hVo
      continuousOn_toFun := fun w hw => by
        obtain ⟨v, hv, rfl⟩ := hbij.surjOn hw
        refine ContinuousAt.continuousWithinAt ?_
        show Tendsto (fun w => j (Φ (inv w))) (𝓝 (Ψ v)) (𝓝 (j (Φ (inv (Ψ v)))))
        rw [hinvΨ v hv, hn v hv, tendsto_map'_iff]
        have hc : Continuous[TF, btzJTop 0] (fun v => j (Φ v)) :=
          @Continuous.comp _ _ _ TF hornTop (btzJTop 0) _ _ hj hΦ
        refine (@Continuous.tendsto _ _ TF _ _ hc v).congr' ?_
        filter_upwards [@IsOpen.mem_nhds _ TF _ _ hV hv] with v' hv'
        simp only [comp_apply, hinvΨ v' hv']
      continuousOn_invFun := fun q hq => by
        refine ContinuousAt.continuousWithinAt ?_
        show Tendsto _ (𝓝 q) (𝓝 (Ψ (Φ.symm (js q))))
        rw [hn _ hq]
        have hc : Continuous[btzJTop 0, TF] (fun q => Φ.symm (js q)) :=
          @Continuous.comp _ _ _ (btzJTop 0) hornTop TF _ _ hΦs hjs
        exact (tendsto_map (f := Ψ)).comp (@Continuous.tendsto _ _ (btzJTop 0) TF _ hc q) }
  refine ⟨κ, ⟨g, fun w hw => ?_⟩, he⟩
  obtain ⟨hv, hw'⟩ := hinv w hw
  show D w = g • btzDevM 0 btzV0 (Φ (inv w))
  conv_lhs => rw [← hw']
  exact hg _ hv

end Charts

/-! ### The causality generated by an atlas into a model spacetime (`M` and `\widetilde M` alike) -/

section ChartAtlas

variable {Y : Type*} [TopologicalSpace Y] {N : Type u} [TopologicalSpace N]

/-- The causality generated (`theo:causalite_engendre`, DEC-33) by the charts of an atlas `A` of `N`
into a spacetime `(Y, DY)`, each chart transporting `DY`. `GX.btzTildeAtlasCausality` is the case
`Y = J⁺(Δ₀)` (`GX.btzTildeAtlasCausality_eq_chartAtlasCausality`); the causality of an
`𝔼₀`-manifold `M` is the case `Y = 𝕄 ⊕ 𝔼₀` (`GX.e0ManifoldCausality`). -/
noncomputable def chartAtlasCausality (DY : Causal.Causality Y)
    (A : Set (OpenPartialHomeomorph N Y)) (hA : ∀ e : N, ∃ κ ∈ A, e ∈ κ.source) :
    Causal.Causality N :=
  Causal.Causality.generated (fun κ : A => Causal.chartSource κ.1)
    (fun e => ⟨⟨(hA e).choose, (hA e).choose_spec.1⟩, (hA e).choose_spec.2⟩)
    (fun κ => DY.chartTransport κ.1)

theorem btzTildeAtlasCausality_eq_chartAtlasCausality {A : Set (OpenPartialHomeomorph N BTZJ0)}
    {hA : ∀ e : N, ∃ κ ∈ A, e ∈ κ.source} :
    btzTildeAtlasCausality A hA = chartAtlasCausality (btzJCausality (0 : ℝ × ℝ × ℝ)) A hA := rfl

variable {DY : Causal.Causality Y} {A : Set (OpenPartialHomeomorph N Y)}
  {hA : ∀ e : N, ∃ κ ∈ A, e ∈ κ.source}

/-- A relation of the model inside a chart is a relation of the generated causality. -/
theorem chartAtlasCausality_le_of_chart {κ : OpenPartialHomeomorph N Y} (hκ : κ ∈ A) {x y : N}
    (hx : x ∈ κ.source) (hy : y ∈ κ.source)
    (h : DY.le (Causal.chartImage κ (⊤ ⊓ Causal.chartSource κ)) (κ x) (κ y)) :
    (chartAtlasCausality DY A hA).le ⊤ x y :=
  TransGen.single ⟨⟨κ, hκ⟩,
    ((DY.chartTransport_chartIso κ) (⊤ ⊓ Causal.chartSource κ) inf_le_right x ⟨trivial, hx⟩ y ⟨trivial, hy⟩).1.2 h⟩

theorem chartAtlasCausality_lt_of_chart {κ : OpenPartialHomeomorph N Y} (hκ : κ ∈ A) {x y : N}
    (hx : x ∈ κ.source) (hy : y ∈ κ.source)
    (h : DY.lt (Causal.chartImage κ (⊤ ⊓ Causal.chartSource κ)) (κ x) (κ y)) :
    (chartAtlasCausality DY A hA).lt ⊤ x y :=
  TransGen.single ⟨⟨κ, hκ⟩,
    ((DY.chartTransport_chartIso κ) (⊤ ⊓ Causal.chartSource κ) inf_le_right x ⟨trivial, hx⟩ y ⟨trivial, hy⟩).2.2 h⟩

/-- **`Z⁺ = N`** for the causality generated by any atlas into a model with `Z⁺` in every open set. -/
theorem chartAtlasCausality_mem_Zplus (hZ : E0LM.LocZplus DY) (y : N) :
    y ∈ (chartAtlasCausality DY A hA).Zplus := by
  intro S hS
  obtain ⟨κ, hκ, hy⟩ := hA y
  obtain ⟨z', hz', hlt⟩ := hZ (Causal.chartImage κ (⊤ ⊓ Causal.chartSource κ)) (κ y)
    (Causal.mem_chartImage_of_mem hy ⟨trivial, hy⟩) _
    (κ.image_mem_nhds hy (inter_mem hS (κ.open_source.mem_nhds hy)))
  obtain ⟨z, ⟨hzS, hzs⟩, rfl⟩ := hz'
  exact ⟨z, Causal.Precausality.mem_Iplus_singleton.2 (chartAtlasCausality_lt_of_chart hκ hy hzs hlt),
    hzS⟩

/-- **Tarentin** for the causality generated by any atlas into a model tarentin in every open
set. -/
theorem chartAtlasCausality_tarentin (hT : E0LM.LocTarentin DY) :
    (chartAtlasCausality DY A hA).Tarentin := by
  intro y S hS
  obtain ⟨κ, hκ, hy⟩ := hA y
  obtain ⟨p', hp', q', hq', hd⟩ := hT (Causal.chartImage κ (⊤ ⊓ Causal.chartSource κ)) (κ y)
    (Causal.mem_chartImage_of_mem hy ⟨trivial, hy⟩) _
    (κ.image_mem_nhds hy (inter_mem hS (κ.open_source.mem_nhds hy)))
  obtain ⟨p, ⟨hpS, hps⟩, rfl⟩ := hp'
  obtain ⟨q, ⟨hqS, hqs⟩, rfl⟩ := hq'
  refine ⟨p, hpS, q, hqS, ?_⟩
  have hO : IsOpen (κ.source ∩ κ ⁻¹' interior (DY.diamond
      (Causal.chartImage κ (⊤ ⊓ Causal.chartSource κ)) (κ p) (κ q))) :=
    κ.isOpen_inter_preimage isOpen_interior
  refine interior_maximal (fun w hw => ?_) hO ⟨hy, hd⟩
  obtain ⟨h1, h2⟩ := Causal.Causality.mem_diamond.1 (interior_subset hw.2)
  exact Causal.Causality.mem_diamond.2
    ⟨chartAtlasCausality_le_of_chart hκ hps hw.1 h1, chartAtlasCausality_le_of_chart hκ hw.1 hqs h2⟩

end ChartAtlas

/-! ### The causality of an `𝔼₀`-manifold `M` in the `SingularGXStructure` form -/

section E0SingManifold

attribute [local instance] btzE0Structure

variable {M : Type*} [TopologicalSpace M]
  [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) M]

/-- A regular chart `ψ : M ⇀ 𝐌³` of the a.e. atlas, read into `Y = 𝕄 ⊕ 𝔼₀`. -/
noncomputable def regChartToE0Y (ψ : OpenPartialHomeomorph M (Causal.Minkowski 2)) :
    OpenPartialHomeomorph M E0Y :=
  ψ.trans (IsOpenEmbedding.inl.toOpenPartialHomeomorph (Sum.inl : Causal.Minkowski 2 → E0Y))

/-- An `𝔼₀`-chart `φ : U ≅ V ⊆ 𝔼₀` of `M` (`def:atlas`), read into `Y = 𝕄 ⊕ 𝔼₀`. -/
noncomputable def xaChartToE0Y {x : M}
    (c : XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS () x) :
    OpenPartialHomeomorph M E0Y :=
  (((c.U.openPartialHomeomorphSubtypeCoe ⟨⟨x, c.mem⟩⟩).symm.trans
    c.φ.toOpenPartialHomeomorph).trans
    (c.V.openPartialHomeomorphSubtypeCoe ⟨c.φ ⟨x, c.mem⟩⟩)).trans
    (IsOpenEmbedding.inr.toOpenPartialHomeomorph (Sum.inr : BTZE0 → E0Y))

theorem mem_xaChartToE0Y_source {x : M}
    (c : XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS () x) :
    x ∈ (xaChartToE0Y c).source := by
  simp [xaChartToE0Y, c.mem]

variable (M) in
/-- **The atlas of an `𝔼₀`-manifold** into `Y = 𝕄 ⊕ 𝔼₀`: the regular charts of the maximal a.e.
`(Isom 𝐌³, 𝐌³)`-atlas (into `𝕄`) and the `𝔼₀`-charts of `def:atlas` (into `𝔼₀`). -/
def e0ManifoldAtlas : Set (OpenPartialHomeomorph M E0Y) :=
  {κ | (∃ ψ ∈ aeAtlas (Causal.Flat.isom 2) (Causal.Minkowski 2) M, κ = regChartToE0Y ψ) ∨
    ∃ (x : M) (c : XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS () x),
      κ = xaChartToE0Y c}

/-- The atlas covers an `𝔼₀`-manifold (`reg M` by the a.e. atlas, `sing M` by `𝔼₀`-charts). -/
theorem e0ManifoldAtlas_covers (hM : IsBTZSingModelled M) (e : M) :
    ∃ κ ∈ e0ManifoldAtlas M, e ∈ κ.source := by
  by_cases he : e ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M
  · obtain ⟨ψ, hψ, hes⟩ := mem_support.1 he
    exact ⟨_, Or.inl ⟨ψ, hψ, rfl⟩, by simp [regChartToE0Y, hes]⟩
  · obtain ⟨⟨⟩, ⟨c⟩⟩ := hM e he
    exact ⟨_, Or.inr ⟨e, c, rfl⟩, mem_xaChartToE0Y_source c⟩

variable (M) in
/-- **The causality of an `𝔼₀`-manifold `M`** (`RamcovGX.tex:2313`: "causal notions … extend
naturally to `BTZ`-manifolds"; DEC-33): generated by its charts into `Y = 𝕄 ⊕ 𝔼₀`, each
transporting the model causality `E0LM.D` (Minkowski on `𝕄`, WP-41c's on `𝔼₀`). -/
noncomputable def e0ManifoldCausality (hM : IsBTZSingModelled M) : Causal.Causality M :=
  chartAtlasCausality E0LM.D (e0ManifoldAtlas M) (e0ManifoldAtlas_covers hM)

theorem e0ManifoldCausality_tarentin (hM : IsBTZSingModelled M) :
    (e0ManifoldCausality M hM).Tarentin :=
  chartAtlasCausality_tarentin E0LM.yb_locTarentin

theorem e0ManifoldCausality_mem_Zplus (hM : IsBTZSingModelled M) (y : M) :
    y ∈ (e0ManifoldCausality M hM).Zplus :=
  chartAtlasCausality_mem_Zplus E0LM.yb_locZplus y

/-- `lem:globally_hyperbolic_manifolds_manifolds`, `BTZ`-manifolds in the `SingularGXStructure`
form: a Hausdorff globally hyperbolic `𝔼₀`-manifold is future distinguishing. -/
theorem e0SingManifold_isFutureDistinguishing [T2Space M] (hM : IsBTZSingModelled M)
    (hG : (e0ManifoldCausality M hM).GloballyHyperbolic) :
    IsFutureDistinguishing (e0ManifoldCausality M hM) :=
  isFutureDistinguishing_of_globallyHyperbolic (e0ManifoldCausality_tarentin hM)
    (e0ManifoldCausality_mem_Zplus hM) hG

end E0SingManifold

/-! ### Developing maps differ by isometries: the causality and future completeness do not see it -/

section DevInvariance

open scoped Pointwise

variable {N : Type u} [TopologicalSpace N]

theorem btzTildeAtlasCausality_congr {A A' : Set (OpenPartialHomeomorph N BTZJ0)} (h : A = A')
    {hA : ∀ e : N, ∃ κ ∈ A, e ∈ κ.source} {hA' : ∀ e : N, ∃ κ ∈ A', e ∈ κ.source} :
    btzTildeAtlasCausality A hA = btzTildeAtlasCausality A' hA' := by
  subst h; rfl

/-- The developed atlas of `g · D` is that of `D`. -/
theorem btzTildeDevAtlas_smul (g : Causal.Flat.isom 2) (D : N → Causal.Minkowski 2) :
    btzTildeDevAtlas (fun x => g • D x) = btzTildeDevAtlas D := by
  ext κ
  constructor
  · rintro ⟨h, hh⟩
    exact ⟨g⁻¹ * h, fun w hw => by rw [mul_smul, ← hh w hw, inv_smul_smul]⟩
  · rintro ⟨h, hh⟩
    exact ⟨g * h, fun w hw => by rw [mul_smul, ← hh w hw]⟩

theorem isBTZTildeDev_smul_iff (g : Causal.Flat.isom 2) {D : N → Causal.Minkowski 2} :
    IsBTZTildeDev (fun x => g • D x) ↔ IsBTZTildeDev D := by
  unfold IsBTZTildeDev
  rw [btzTildeDevAtlas_smul]

/-- **The causality of a `\widetilde{BTZ}`-manifold does not depend on the developing map** within
its `Isom(𝐌³)`-orbit. -/
theorem btzTildeCausality_smul (g : Causal.Flat.isom 2) {D : N → Causal.Minkowski 2}
    (hD : IsBTZTildeDev D) (hD' : IsBTZTildeDev (fun x => g • D x)) :
    btzTildeCausality (fun x => g • D x) hD' = btzTildeCausality D hD :=
  btzTildeAtlasCausality_congr (btzTildeDevAtlas_smul g D)

theorem minkowski_Jplus_smul (g : Causal.Flat.isom 2) (m : Causal.Minkowski 2) :
    (Causal.minkowski 2).Jplus ⊤ {g • m} = g • (Causal.minkowski 2).Jplus ⊤ {m} := by
  ext z
  rw [Set.mem_smul_set_iff_inv_smul_mem, Causal.Precausality.mem_Jplus_singleton,
    Causal.Precausality.mem_Jplus_singleton]
  conv_rhs => rw [← Causal.Flat.isom_le_top_iff g, smul_inv_smul]

theorem minkowski_Iplus_smul (g : Causal.Flat.isom 2) (m : Causal.Minkowski 2) :
    (Causal.minkowski 2).Iplus ⊤ {g • m} = g • (Causal.minkowski 2).Iplus ⊤ {m} := by
  ext z
  rw [Set.mem_smul_set_iff_inv_smul_mem, Causal.Precausality.mem_Iplus_singleton,
    Causal.Precausality.mem_Iplus_singleton]
  conv_rhs => rw [← Causal.Flat.isom_lt_top_iff g, smul_inv_smul]

/-- **Future completeness does not depend on the developing map** within its `Isom(𝐌³)`-orbit. -/
theorem isFutureComplete_smul_iff (C : Causal.Causality N) (D : N → Causal.Minkowski 2)
    (g : Causal.Flat.isom 2) :
    IsFutureComplete C (fun x => g • D x) ↔ IsFutureComplete C D := by
  have himg : ∀ S : Set N, (fun x => g • D x) '' S = g • (D '' S) := fun S => by
    rw [← Set.image_smul, Set.image_image]
  have hinj : ∀ P Q : Set (Causal.Minkowski 2), g • P = g • Q ↔ P = Q := fun P Q => by
    simp only [← Set.image_smul]
    exact (Set.image_injective.2 (MulAction.injective g)).eq_iff
  simp only [IsFutureComplete, himg, minkowski_Jplus_smul, minkowski_Iplus_smul, hinj]

theorem isFutureComplete_btzTildeCausality_smul_iff (g : Causal.Flat.isom 2)
    {D : N → Causal.Minkowski 2} (hD : IsBTZTildeDev D) (hD' : IsBTZTildeDev (fun x => g • D x)) :
    IsFutureComplete (btzTildeCausality (fun x => g • D x) hD') (fun x => g • D x) ↔
      IsFutureComplete (btzTildeCausality D hD) D := by
  rw [btzTildeCausality_smul g hD hD']
  exact isFutureComplete_smul_iff _ _ g

end DevInvariance

/-! ### `\widetilde M` with the topology `T_BTZ` is a `\widetilde{BTZ}`-manifold developed by `D` -/

/-- A type carrying a wrapped topology as its instance (to read `\widetilde M` with `T_BTZ`). -/
def WithWrappedTop {α : Type*} (_T : WrappedTop α) : Type _ := α

instance instTopologicalSpaceWithWrappedTop {α : Type*} (T : WrappedTop α) :
    TopologicalSpace (WithWrappedTop T) := T.top

/-- An open partial homeomorphism of `α`, read for a finer wrapped topology `T'` having the same
neighbourhoods at the points of its source. -/
def OpenPartialHomeomorph.retopBTZ {α β : Type*} [TopologicalSpace α] [TopologicalSpace β]
    (T' : WrappedTop α) (φ : OpenPartialHomeomorph α β) (hle : T'.top ≤ ‹TopologicalSpace α›)
    (hn : ∀ x ∈ φ.source, @nhds α T'.top x = 𝓝 x) :
    OpenPartialHomeomorph (WithWrappedTop T') β where
  toPartialEquiv := φ.toPartialEquiv
  open_source := TopologicalSpace.le_def.1 hle _ φ.open_source
  open_target := φ.open_target
  continuousOn_toFun x hx := by
    have h := φ.continuousOn_toFun x hx
    unfold ContinuousWithinAt at h ⊢
    rw [nhdsWithin] at h ⊢
    erw [hn x hx]
    exact h
  continuousOn_invFun y hy := by
    have h := φ.continuousOn_invFun y hy
    unfold ContinuousWithinAt at h ⊢
    erw [hn _ (φ.map_target hy)]
    exact h

section TildeM

universe v

attribute [local instance] btzE0Structure

variable {M : Type v} [TopologicalSpace M] [T2Space M] [LocPathConnectedSpace M]
  [FirstCountableTopology M] [ConnectedSpace M]
  [SingularGXStructure (Causal.Flat.isom 2) (Causal.Minkowski 2) M]

/-- **`\widetilde M` is a `\widetilde{BTZ}`-manifold developed by `D`**: given a topology `T'` on
`\widetilde M`, finer than the natural one and natural over `reg M`, a `T'`-continuous developing
map `D` and the lifted charts of `GX.IsLocallyBTZTilde` at the singular points, every point of
`(\widetilde M, T')` is in the source of a chart into `J⁺(Δ₀)` developed by `D`. -/
theorem isBTZTildeDev_of_isLocallyBTZTilde
    {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M)}
    {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
    {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
      DInfty × ℝ}
    {T' : WrappedTop (MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀)}
    (hle : T'.top ≤ weakTopMax (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀)
    (hreg : ∀ e : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀,
      e.base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M →
        @nhds _ T'.top e = @nhds _ (weakTopMax (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀) e)
    {D : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀ →
      Causal.Minkowski 2}
    (hDr : IsRegDevelopingOnReg (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ D)
    (hL : IsLocallyBTZTilde M y₀ Φ T' D) :
    IsBTZTildeDev (N := WithWrappedTop T') D := by
  have hcc : ∀ (e : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀)
      (c : XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS () e.base),
      e ∈ connectedComponentIn (SpreadEnd.base ⁻¹' (c.U : Set M)) e :=
    fun e c => mem_connectedComponentIn c.mem
  intro (e : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀)
  by_cases he : e.base ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M
  · obtain ⟨c, f, Ψ, -, -, -, hVoB, -, hUoT, hbij, -, -, -, hT'n, g, hg⟩ := hL e he
    exact exists_mem_btzTildeDevAtlas_of_descent (E := WithWrappedTop T') Φ.toEquiv hVoB hUoT
      hbij hT'n hg (hcc e c)
  · have her : e ∈ (SpreadEnd.base : MaxBranchedCover (Sing (Causal.Flat.isom 2)
        (Causal.Minkowski 2) M) y₀ → M) ⁻¹' Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M := by
      rw [Set.mem_preimage]
      simpa [Sing] using he
    obtain ⟨φ, heφ, hDφ⟩ := hDr.isLocalHomeomorphOn e her
    set φ' := φ.restrOpen _ (isOpen_preimage_base_weakTopMax y₀
      (isOpen_reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M))
    have hn : ∀ x ∈ φ'.source, @nhds _ T'.top x =
        @nhds _ (weakTopMax (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀) x :=
      fun x hx => hreg x hx.2
    let ψ : OpenPartialHomeomorph (WithWrappedTop T') (Causal.Minkowski 2) :=
      OpenPartialHomeomorph.retopBTZ T' φ' hle hn
    refine exists_mem_btzTildeDevAtlas_of_chart ψ (fun x _ => ?_) (e := e) ⟨heφ, her⟩
    show D x = φ x
    rw [hDφ]

set_option maxHeartbeats 3200000 in
/-- **WP-41d's `GX.btz_manifold_exists_chartwise_tamifying`, with the regular clause** (its proof
verbatim, one conclusion added: the glued topology is natural over `reg M`, `hN none`). The
tamifying topology of an `𝔼₀`-manifold is chartwise `T_BTZ` (`RamcovGX.tex:2309–2312`,
and the construction of `theo:local_virt_tame`'s proof, l.2073–2077, in the descending case): for
every base point `y₀` of `\widetilde M` and every presentation `Φ : \widetilde{𝔼₀} ≅ 𝔻_∞ × ℝ` of
`\widetilde{𝔼₀}` (base point `yN`), `\widetilde M` carries a tamifying topology `T'` whose
neighbourhoods at every point of the image of a descent `Ψ : V̂ → Û` of a descending `𝔼₀`-chart
(in particular of every box chart, `exists_xaChart_hasMaximalLifts`) are the images by `Ψ` of the
`T_BTZ`-neighbourhoods (`T_BTZ = Φ^* hornTop`, `btz_isTamifyingTopology`). Only `hasType` of the
`X_A`-manifold notion is used (DEC-67 (e)'s "every singular point has a type"). The proof is that
of `isVirtuallyTame_of_descending` with `T_N = T_BTZ` fixed, keeping the glued topology. -/
theorem btz_manifold_exists_chartwise_tamifying_reg
    (hM : IsBTZSingModelled M)
    (y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M))
    (yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0))
    (Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
      DInfty × ℝ) (hΦ : ∀ e, orbitMk (GammaA (2 * π)) (Φ e) = e.base) :
    ∃ T' : TopologicalSpace
        (MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀),
      IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ T' ∧
      (∀ e : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀,
        e.base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M →
          @nhds _ T' e = @nhds _ (weakTopMax (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀) e) ∧
      ∀ (y : M) (c : XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS () y),
        IsDescendingChartMap (Causal.Flat.isom 2) (Causal.Minkowski 2) c.φ →
        ∀ (f : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN)
          (Ψ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN →
            MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀),
          IsChartDescent (c.U : Set M) (c.V : Set BTZE0) (chartExt c.φ) f Ψ →
          ∀ v ∈ connectedComponentIn (SpreadEnd.base ⁻¹' (c.V : Set BTZE0)) f,
            @nhds _ T' (Ψ v) =
              Filter.map Ψ (@nhds _ (TopologicalSpace.induced Φ hornTop) v) := by
  have hX := isLocallyUnloopable_of_normedSpace (Causal.Minkowski 2)
  have hfam := isAnalyticModelFamily_btzFam
  have hregM := semilocallySimplyConnected_compl_of_sing_subset (G := Causal.Flat.isom 2) hX
    (isClosed_sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) subset_rfl
  have hregN := semilocallySimplyConnected_compl_of_sing_subset (G := Causal.Flat.isom 2) hX
    (isClosed_sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) subset_rfl
  obtain ⟨D₀, hD₀⟩ := exists_isRegDevelopingOnReg hregM y₀
  let TN : WrappedTop
      (MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN) :=
    ⟨TopologicalSpace.induced Φ hornTop⟩
  have hTN : IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 yN TN.top :=
    btz_isTamifyingTopology btzV0_pos btz_two_pi_ne_zero isBTZStructure_btzE0 hΦ
  have hAut : ∀ f ∈ aeAutMapsMax (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0 yN,
      Continuous[TN.top, TN.top] f := fun f hf =>
    btz_aut_continuous btzV0_pos isBTZStructure_btzE0 hΦ hf
  have hdisc : ∀ x : BTZE0, DiscreteTopology
      ((SpreadEnd.base : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)
        yN → BTZE0) ⁻¹' {x}) :=
    fun x => discreteTopology_fiber_of_isLocallyGaloisian hX isLocallyGaloisian_btzE0 yN x
  obtain ⟨DN, hDNc, hDNr⟩ := hTN.exists_extension
  have hFam : ∀ c : {c : Σ a : Unit, Σ x : M,
        XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS a x //
        IsDescendingChartMap (Causal.Flat.isom 2) (Causal.Minkowski 2) c.2.2.φ},
      ∃ (fz : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀ →
          MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN)
        (Ψz : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀ →
          MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN →
          MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀),
        ∀ z : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀,
          z.base ∈ (c.1.2.2.U : Set M) →
          IsChartDescent (c.1.2.2.U : Set M) (c.1.2.2.V : Set BTZE0) (chartExt c.1.2.2.φ)
            (fz z) (Ψz z) ∧ Ψz z (fz z) = z := by
    rintro ⟨⟨a, x, c⟩, hc⟩
    obtain ⟨-, hβN, -, -, -, -⟩ := maxBranched_basic
      (isSkeletal_sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) hregN yN
    obtain ⟨f₀, -⟩ := hβN.surjective (Classical.arbitrary BTZE0)
    have : ∀ z : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀,
        ∃ (f : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN)
        (Ψ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN →
          MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀),
        z.base ∈ (c.U : Set M) →
          IsChartDescent (c.U : Set M) (c.V : Set BTZE0) (chartExt c.φ) f Ψ ∧ Ψ f = z := by
      intro z
      by_cases hz : z.base ∈ (c.U : Set M)
      · obtain ⟨f, hf⟩ := hβN.surjective (chartExt c.φ z.base)
        obtain ⟨Ψ, hΨ, hΨf⟩ := hc y₀ yN z f hz hf
        exact ⟨f, Ψ, fun _ => ⟨hΨ, hΨf⟩⟩
      · exact ⟨f₀, fun _ => z, fun h => absurd h hz⟩
    choose fz Ψz hFz using this
    exact ⟨fz, Ψz, hFz⟩
  choose fz Ψz hFz using hFam
  let ι := Option {c : Σ a : Unit, Σ x : M,
    XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS a x //
    IsDescendingChartMap (Causal.Flat.isom 2) (Causal.Minkowski 2) c.2.2.φ}
  let U : ι → Set M := fun i => match i with
    | none => Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M
    | some c => (c.1.2.2.U : Set M)
  let T : ι → TopologicalSpace
      (MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀) :=
    fun i => match i with
    | none => weakTopMax (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀
    | some c => descTop (c.1.2.2.U : Set M) (fz c) (Ψz c) TN
  have hUo : ∀ i, IsOpen (U i) := by
    rintro (_ | c)
    · exact isOpen_reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M
    · exact c.1.2.2.U.isOpen
  have hT : ∀ i, IsLocalTamifying (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ D₀ (U i)
      (T i) := by
    rintro (_ | ⟨⟨a, x, c⟩, hc⟩)
    · exact isLocalTamifying_natural_reg hregM hD₀
    · exact isLocalTamifying_descTop hregM hregN c.U.isOpen c.V.isOpen
        (continuousOn_chartExt c.φ) (injOn_chartExt c.φ) (mapsTo_chartExt c.φ)
        (fun m hm => chartExt_mem_reg_iff c.isAEMorphism hm) hdisc (hFz ⟨⟨a, x, c⟩, hc⟩)
        hTN (fun z f hz hf => hc y₀ yN z f hz hf) hDNc
        (fun z hz => exists_smul_eq_of_isChartDescent hregM hregN c.isAEMorphism hD₀
          hDNr (hFz ⟨⟨a, x, c⟩, hc⟩ z hz).1)
  have hdesc : ∀ y ∈ Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M,
      ∃ c : XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS () y,
        IsDescendingChartMap (Causal.Flat.isom 2) (Causal.Minkowski 2) c.φ := fun y hy =>
    btz_exists_descendingChart hM hy
  have hcov : ∀ y : M, ∃ i, y ∈ U i := fun y => by
    by_cases hy : y ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M
    · exact ⟨none, hy⟩
    · obtain ⟨c, hc⟩ := hdesc y hy
      exact ⟨some ⟨⟨(), y, c⟩, hc⟩, c.mem⟩
  have key : ∀ (b : Unit) (y : M)
      (c₀ : XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS b y)
      (hc₀ : IsDescendingChartMap (Causal.Flat.isom 2) (Causal.Minkowski 2) c₀.φ)
      (i : ι) (e : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀),
      e.base = y → y ∉ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M →
      e.base ∈ U i → @nhds _ (T (some ⟨⟨b, y, c₀⟩, hc₀⟩)) e = @nhds _ (T i) e := by
    rintro b y c₀ hc₀ (_ | ⟨⟨a, x, c⟩, hc⟩) e rfl hsing hi
    · exact absurd hi hsing
    set W : Opens M := ⟨connectedComponentIn ((c₀.U : Set M) ∩ c.U) e.base,
      (c₀.U.isOpen.inter c.U.isOpen).connectedComponentIn⟩
    have hyW : e.base ∈ W := mem_connectedComponentIn ⟨c₀.mem, hi⟩
    have hW₀ : W ≤ c₀.U := fun z hz => (connectedComponentIn_subset _ _ hz).1
    have hW : W ≤ c.U := fun z hz => (connectedComponentIn_subset _ _ hz).2
    have hWc : IsConnected (W : Set M) := isConnected_connectedComponentIn_iff.2 ⟨c₀.mem, hi⟩
    obtain rfl := XAChart.eq_of_mem_centre hfam c₀ c W hW₀ hW hWc hyW
    obtain ⟨ψ, hψ, hψeq⟩ := c₀.exists_aut_eq hfam c W hW₀ hW hWc hyW
    have hψφ : ∀ m ∈ (W : Set M), ψ (chartExt c₀.φ m) = chartExt c.φ m := fun m hm => by
      rw [chartExt_apply _ (hW₀ hm), chartExt_apply _ (hW hm)]; exact hψeq ⟨m, hm⟩
    have hψφ' : ∀ m ∈ (W : Set M), ψ⁻¹ (chartExt c.φ m) = chartExt c₀.φ m := fun m hm => by
      rw [← hψφ m hm]; exact ψ.symm_apply_apply _
    exact le_antisymm
      (nhds_descTop_le_of_aut hregM hregN hdisc c₀.U.isOpen c₀.V.isOpen
        (continuousOn_chartExt c₀.φ) (injOn_chartExt c₀.φ) (mapsTo_chartExt c₀.φ)
        (fun m hm => chartExt_mem_reg_iff c₀.isAEMorphism hm) (hFz ⟨⟨b, e.base, c₀⟩, hc₀⟩)
        c.U.isOpen c.V.isOpen (continuousOn_chartExt c.φ) (injOn_chartExt c.φ)
        (mapsTo_chartExt c.φ) (fun m hm => chartExt_mem_reg_iff c.isAEMorphism hm)
        (hFz ⟨⟨b, x, c⟩, hc⟩) hTN hAut W.isOpen hW hψ hψφ hyW (hW₀ hyW))
      (nhds_descTop_le_of_aut hregM hregN hdisc c.U.isOpen c.V.isOpen
        (continuousOn_chartExt c.φ) (injOn_chartExt c.φ) (mapsTo_chartExt c.φ)
        (fun m hm => chartExt_mem_reg_iff c.isAEMorphism hm) (hFz ⟨⟨b, x, c⟩, hc⟩)
        c₀.U.isOpen c₀.V.isOpen (continuousOn_chartExt c₀.φ) (injOn_chartExt c₀.φ)
        (mapsTo_chartExt c₀.φ) (fun m hm => chartExt_mem_reg_iff c₀.isAEMorphism hm)
        (hFz ⟨⟨b, e.base, c₀⟩, hc₀⟩) hTN hAut W.isOpen hW₀ (inv_mem hψ) hψφ' hyW
        (hW hyW))
  have hcompat : ∀ i j (e : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)
      y₀), e.base ∈ U i → e.base ∈ U j → @nhds _ (T i) e = @nhds _ (T j) e := by
    intro i j e hi hj
    by_cases hy : e.base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M
    · rw [(hT i).nhds_reg e hi hy, (hT j).nhds_reg e hj hy]
    · obtain ⟨c₀, hc₀⟩ := hdesc e.base hy
      rw [← key () _ c₀ hc₀ i e rfl hy hi, key () _ c₀ hc₀ j e rfl hy hj]
  have hcovE : ∀ e : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀,
      ∃ i, e ∈ (SpreadEnd.base : MaxBranchedCover (Sing (Causal.Flat.isom 2)
        (Causal.Minkowski 2) M) y₀ → M) ⁻¹' U i := fun e => hcov e.base
  have hWo : ∀ i, IsOpen[T i] ((SpreadEnd.base : MaxBranchedCover (Sing (Causal.Flat.isom 2)
      (Causal.Minkowski 2) M) y₀ → M) ⁻¹' U i) :=
    fun i => TopologicalSpace.le_def.1 (hT i).le_natural _
      (isOpen_preimage_base_weakTopMax y₀ (hUo i))
  have hN : ∀ i (e : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀),
      e.base ∈ U i → @nhds _ (glueTop _ T hcovE) e = @nhds _ (T i) e :=
    fun i e he => nhds_glueTop hcovE hWo (fun i j e hi hj => hcompat i j e hi hj) (i := i) he
  refine ⟨glueTop _ T hcovE, isTamifyingTopology_of_nhds_eq hD₀ U hUo hcov T hT _ hN,
    fun e he => hN none e he, ?_⟩
  intro y c hc f Ψ hΨ v hv
  exact (hN (some ⟨⟨(), y, c⟩, hc⟩) (Ψ v) (hΨ.mem v hv)).trans
    (nhds_descTop_eq_map hregM hregN c.U.isOpen c.V.isOpen (continuousOn_chartExt c.φ)
      (injOn_chartExt c.φ) (mapsTo_chartExt c.φ)
      (fun m hm => chartExt_mem_reg_iff c.isAEMorphism hm) hdisc (hFz ⟨⟨(), y, c⟩, hc⟩) hTN
      hΨ hv)

set_option maxHeartbeats 1600000 in
/-- **WP-41d's `GX.btz_manifold_tilde_isLocallyBTZTilde`, for every chartwise-`T_BTZ` tamifying
topology `T'` and every `T'`-continuous developing map `D`** (its proof, with `T'` and `D` given). -/
theorem isLocallyBTZTilde_of_chartwise
    (hM : IsBTZSingModelled M)
    {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M)}
    {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
    {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
      DInfty × ℝ} (hΦ : ∀ e, orbitMk (GammaA (2 * π)) (Φ e) = e.base)
    (T' : WrappedTop (MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀))
    (hT' : IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ T'.top)
    (hch : ∀ (y : M) (c : XAChart (Causal.Flat.isom 2) (Causal.Minkowski 2) btzFam btzFamS () y),
        IsDescendingChartMap (Causal.Flat.isom 2) (Causal.Minkowski 2) c.φ →
        ∀ (f : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN)
          (Ψ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN →
            MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀),
          IsChartDescent (c.U : Set M) (c.V : Set BTZE0) (chartExt c.φ) f Ψ →
          ∀ v ∈ connectedComponentIn (SpreadEnd.base ⁻¹' (c.V : Set BTZE0)) f,
            @nhds _ T'.top (Ψ v) =
              Filter.map Ψ (@nhds _ (TopologicalSpace.induced Φ hornTop) v))
    {D : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀ →
      Causal.Minkowski 2}
    (hDc : Continuous[T'.top, _] D)
    (hDr : IsRegDevelopingOnReg (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ D) :
    IsLocallyBTZTilde M y₀ Φ T' D := by
  intro e he
  obtain ⟨c, f, Ψ, hc, hΨ, hfs, hΨf, hVo, hUo, hbij, hbase, hsing, hnat, g, hg⟩ :=
    btz_exists_liftedChart hM hΦ hDr he
  have hTN := btz_isTamifyingTopology btzV0_pos btz_two_pi_ne_zero isBTZStructure_btzE0 hΦ
  have hT'n := hch e.base c hc f Ψ hΨ
  have hVoB := TopologicalSpace.le_def.1 hTN.le_natural _ hVo
  refine ⟨c, f, Ψ, hfs, hΨf, hVo, hVoB, hUo, TopologicalSpace.le_def.1 hT'.le_natural _ hUo,
    hbij, hbase, hsing, hnat, hT'n, g, ?_⟩
  -- the identity extends from the `T_BTZ`-dense regular part of `V̂` by continuity
  have hc1 : @ContinuousOn _ _ (TopologicalSpace.induced Φ hornTop) _ (fun v => D (Ψ v))
      (connectedComponentIn (SpreadEnd.base ⁻¹' (c.V : Set BTZE0)) f) := fun v hv => by
    have h1 := @Continuous.tendsto _ _ T'.top _ D hDc (Ψ v)
    rw [hT'n v hv] at h1
    exact (tendsto_map'_iff.1 h1).mono_left
      (@nhdsWithin_le_nhds _ (TopologicalSpace.induced Φ hornTop) v _)
  have hc2 : @ContinuousOn _ _ (TopologicalSpace.induced Φ hornTop) _
      (fun v => g • btzDevM 0 btzV0 (Φ v))
      (connectedComponentIn (SpreadEnd.base ⁻¹' (c.V : Set BTZE0)) f) := by
    have hdev : Continuous[TopologicalSpace.induced Φ hornTop, _]
        (fun v => btzDevM 0 btzV0 (Φ v)) :=
      @Continuous.comp _ _ _ (TopologicalSpace.induced Φ hornTop) hornTop _ _ _
        (continuous_btzDevM_hornTop 0 btzV0_pos) continuous_induced_dom
    exact @Continuous.continuousOn _ _ (TopologicalSpace.induced Φ hornTop) _ _ _
      (@Continuous.comp _ _ _ (TopologicalSpace.induced Φ hornTop) _ _ _ _
        (continuous_const_smul g) hdev)
  have hcl := @Dense.open_subset_closure_inter _ (TopologicalSpace.induced Φ hornTop) _ _
    (@IsPortly.dense _ (TopologicalSpace.induced Φ hornTop) _ hTN.isPortly) hVoB
  exact @Set.EqOn.of_subset_closure _ _ (TopologicalSpace.induced Φ hornTop) _ _ _ _ _ _
    (fun v hv => hg v hv.1 hv.2) hc1 hc2 inter_subset_left hcl

/-- **`\widetilde M` with `T_BTZ` is a `\widetilde{BTZ}`-manifold developed by `D`** (l.2310,
l.2312–2313, DEC-77 (b)): for every `𝔼₀`-manifold `M`, every base point and every presentation
`Φ` of `\widetilde{𝔼₀}`, `\widetilde M` carries a tamifying topology `T'`, chartwise `T_BTZ` and
natural over `reg M`, and a `T'`-continuous developing map `D`, with which `(\widetilde M, T')`
is covered by charts into `J⁺(Δ₀)` developed by `D` (`IsBTZTildeDev`); its causality is
`btzTildeCausality D`. -/
theorem btz_manifold_tilde_isBTZTildeDev (hM : IsBTZSingModelled M)
    (y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M))
    (yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0))
    (Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
      DInfty × ℝ) (hΦ : ∀ e, orbitMk (GammaA (2 * π)) (Φ e) = e.base) :
    ∃ T' : WrappedTop
        (MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀),
      IsTamifyingTopology (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ T'.top ∧
      (∀ e : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀,
        e.base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M →
          @nhds _ T'.top e = @nhds _ (weakTopMax (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀) e) ∧
      ∃ D : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀ →
          Causal.Minkowski 2,
        Continuous[T'.top, _] D ∧
        IsRegDevelopingOnReg (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ D ∧
        IsLocallyBTZTilde M y₀ Φ T' D ∧ IsBTZTildeDev (N := WithWrappedTop T') D := by
  obtain ⟨T, hT, hreg, hch⟩ := btz_manifold_exists_chartwise_tamifying_reg hM y₀ yN Φ hΦ
  obtain ⟨D, hDc, hDr⟩ := hT.exists_extension
  have hL := isLocallyBTZTilde_of_chartwise hM hΦ ⟨T⟩ hT hch hDc hDr
  exact ⟨⟨T⟩, hT, hreg, D, hDc, hDr, hL,
    isBTZTildeDev_of_isLocallyBTZTilde hT.le_natural hreg hDr hL⟩

variable (M) in
/-- **`\widetilde M` with the BTZ topology and its developing map** (l.2312: "Developing map … will
always refer to the one for the `T_BTZ`-topology"; DEC-77 (b)): a topology `T'` on the maximal
covering, finer than the natural one and natural over `reg M`, a `T'`-continuous developing map
`D`, and the lifted charts of `GX.IsLocallyBTZTilde` (chartwise `T_BTZ`). One exists for every
base point and presentation (`GX.btz_manifold_tilde_isBTZTildeDev`, `GX.BTZTildeData.nonempty`). -/
structure BTZTildeData (y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M))
    {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
    (Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ
      DInfty × ℝ) where
  /-- The topology `T_BTZ` of `\widetilde M`. -/
  T' : WrappedTop (MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀)
  le_natural : T'.top ≤ weakTopMax (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀
  nhds_reg : ∀ e : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀,
    e.base ∈ Reg (Causal.Flat.isom 2) (Causal.Minkowski 2) M →
      @nhds _ T'.top e = @nhds _ (weakTopMax (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀) e
  /-- The developing map. -/
  D : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀ → Causal.Minkowski 2
  continuous_D : Continuous[T'.top, _] D
  isRegDeveloping : IsRegDevelopingOnReg (Causal.Flat.isom 2) (Causal.Minkowski 2) M y₀ D
  isLocallyBTZTilde : IsLocallyBTZTilde M y₀ Φ T' D

namespace BTZTildeData

variable {y₀ : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M)ᶜ : Set M)}
  {yN : ((Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0)ᶜ : Set BTZE0)}
  {Φ : MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) BTZE0) yN ≃ₜ DInfty × ℝ}
  (d : BTZTildeData M y₀ Φ)

/-- The data exist for every `𝔼₀`-manifold, base point and presentation. -/
theorem nonempty (hM : IsBTZSingModelled M) (hΦ : ∀ e, orbitMk (GammaA (2 * π)) (Φ e) = e.base) :
    Nonempty (BTZTildeData M y₀ Φ) := by
  obtain ⟨T, hT, hreg, hch⟩ := btz_manifold_exists_chartwise_tamifying_reg hM y₀ yN Φ hΦ
  obtain ⟨D, hDc, hDr⟩ := hT.exists_extension
  exact ⟨⟨⟨T⟩, hT.le_natural, hreg, D, hDc, hDr,
    isLocallyBTZTilde_of_chartwise hM hΦ ⟨T⟩ hT hch hDc hDr⟩⟩

/-- `\widetilde M` with `T_BTZ` as a space. -/
abbrev Space : Type v := WithWrappedTop d.T'

theorem isBTZTildeDev : IsBTZTildeDev (N := d.Space) d.D :=
  isBTZTildeDev_of_isLocallyBTZTilde d.le_natural d.nhds_reg d.isRegDeveloping d.isLocallyBTZTilde

/-- **The causality of `\widetilde M`** (l.2313, DEC-33, DEC-77 (b)): generated by the charts of
`(\widetilde M, T_BTZ)` into `J⁺(Δ₀)` developed by `D`. -/
noncomputable def causality : Causal.Causality d.Space :=
  btzTildeCausality d.D d.isBTZTildeDev

instance t2Space : T2Space d.Space :=
  t2Space_antitone d.le_natural
    (inferInstance : T2Space (MaxBranchedCover (Sing (Causal.Flat.isom 2) (Causal.Minkowski 2) M) y₀))

/-- `lem:increasing_map` (`RamcovGX.tex:2334`, D-10: `∀ x, y ∈ \widetilde M`), in the paper's
order `<` (l.2193: causal and later, i.e. `≤` and `≠`): `x < y ⇒ D(x) < D(y)`. -/
theorem increasing {x y : d.Space} (h : d.causality.le ⊤ x y) (hne : x ≠ y) :
    (Causal.minkowski 2).le ⊤ (d.D x) (d.D y) ∧ d.D x ≠ d.D y :=
  btzTilde_strict_dev h hne

/-- `lem:increasing_map`, chronological order: `x ≪ y ⇒ D(x) ≪ D(y)`. -/
theorem increasing_lt {x y : d.Space} (h : d.causality.lt ⊤ x y) :
    (Causal.minkowski 2).lt ⊤ (d.D x) (d.D y) :=
  btzTilde_lt_dev h

/-- `\widetilde M` is causal. -/
theorem isCausal : d.causality.IsCausal := btzTilde_isCausal

/-- `lem:manifolds_manifolds_causally_connected` for `\widetilde M`. -/
theorem isCausallyConnected : IsCausallyConnected d.causality :=
  btzTildeAtlas_isCausallyConnected (hA := d.isBTZTildeDev)

/-- `lem:globally_hyperbolic_manifolds_manifolds` and the Lorentzian half of
`lem:globally_hyperbolic_manifolds_maximal`
for `\widetilde M` with `T_BTZ` (DEC-77 (b)): if `\widetilde M` is globally hyperbolic, it is future
distinguishing. -/
theorem isFutureDistinguishing (hG : d.causality.GloballyHyperbolic) :
    IsFutureDistinguishing d.causality :=
  btzTildeAtlas_isFutureDistinguishing (hA := d.isBTZTildeDev) hG

/-- **The transfer "`M` globally hyperbolic ⇒ `\widetilde M` (with `T_BTZ`) globally hyperbolic"**
(the step `lem:globally_hyperbolic_manifolds_maximal`'s proof, l.2361, calls "not different from the
Lorentzian case": a lift of a Cauchy surface is Cauchy). `M` carries its chart-generated causality
`GX.e0ManifoldCausality`, `\widetilde M` the one of `T_BTZ` (`BTZTildeData.causality`, DEC-77 (b)).
The causal half is proved (`BTZTildeData.isCausal`); the compactness of the diamonds of
`\widetilde M` is the tagged `sorry`. -/
theorem globallyHyperbolic_of_base (hM : IsBTZSingModelled M)
    (hG : (e0ManifoldCausality M hM).GloballyHyperbolic) : d.causality.GloballyHyperbolic := by
  refine ⟨d.isCausal, fun p q => ?_⟩
  sorry -- SORRY(lem:globally_hyperbolic_manifolds_maximal): compactness of `J⁺(p) ∩ J⁻(q)` in
  -- `(\widetilde M, T_BTZ)` from `M` GH. Two missing inputs, neither in GX/, the scaffold or
  -- lean-causal at 731ed99: (i) the projection `p : \widetilde M → M` is causal
  -- (`x ≤ y ⇒ p x ≤ p y`), which compares each chart of `btzTildeDevAtlas D` with the
  -- `𝔼₀`- and regular charts of `M` through the lifted charts `Ψ` of `IsLocallyBTZTilde` (rigidity
  -- of `D` on overlaps); (ii) a properness statement — either the Cauchy route (a Cauchy surface `S`
  -- of `M` by `geroch_sing_*`; `p⁻¹(S)` Cauchy in `\widetilde M` by lifting inextensible causal
  -- curves through the BTZ lines for `T_BTZ`; Cauchy ⇒ compact diamonds, ETT's (iii)⇒(i)) or the
  -- direct route (causal curves of `M` from `p a` to `p b` form a compact family, limit-curve
  -- theorem, and lift uniquely from `a`), none of which exists for topological spacetimes here.

/-- `lem:globally_hyperbolic_manifolds_maximal` (`RamcovGX.tex:2359`) in the paper's form: if
the `𝔼₀`-manifold `M` is globally hyperbolic, its maximal branched covering `\widetilde M` (with
`T_BTZ`, DEC-77 (b)) is future distinguishing. Rests on the transfer
`BTZTildeData.globallyHyperbolic_of_base` (one tagged `sorry`); the Lorentzian half is
`BTZTildeData.isFutureDistinguishing` (0 `sorry`). -/
theorem isFutureDistinguishing_of_base (hM : IsBTZSingModelled M)
    (hG : (e0ManifoldCausality M hM).GloballyHyperbolic) : IsFutureDistinguishing d.causality :=
  d.isFutureDistinguishing (d.globallyHyperbolic_of_base hM hG)

variable (M) in
/-- **`def:manifold_future_complete_all`** (`RamcovGX.tex:2343`) for a `BTZ`-manifold `M`: for all
`x ∈ \widetilde M`, `D(J⁺(x)) = J⁺(D x)` and `D(I⁺(x)) = I⁺(D x)`, the causality of `\widetilde M`
being that of `T_BTZ` (`BTZTildeData.causality`). -/
def IsBTZFutureComplete (d : BTZTildeData M y₀ Φ) : Prop :=
  IsFutureComplete d.causality d.D

/-- `def:manifold_future_complete_all` does not depend on the developing map within its
`Isom(𝐌³)`-orbit: two data with the same `T_BTZ` and developing maps `D' = g · D` are future
complete together. -/
theorem isBTZFutureComplete_iff_of_smul (d d' : BTZTildeData M y₀ Φ) (hT : d.T' = d'.T')
    (g : Causal.Flat.isom 2) (hD : d'.D = fun x => g • d.D x) :
    IsBTZFutureComplete M d' ↔ IsBTZFutureComplete M d := by
  cases d
  cases d'
  simp only at hT hD
  subst hT hD
  unfold IsBTZFutureComplete causality
  exact isFutureComplete_btzTildeCausality_smul_iff g _ _

end BTZTildeData

end TildeM

/-! ### The model `\widetilde{BTZ} ≅ J⁺(Δ₀)` itself: a future complete `\widetilde{BTZ}`-manifold -/

section ModelExample

/-- The identity chart of `J⁺(Δ₀)` is developed by the inclusion `val`. -/
theorem refl_mem_btzTildeDevAtlas :
    OpenPartialHomeomorph.refl BTZJ0 ∈ btzTildeDevAtlas (BTZJplus.val : BTZJ0 → _) :=
  ⟨1, fun _ _ => (one_smul _ _).symm⟩

theorem btzJ0_isBTZTildeDev : IsBTZTildeDev (BTZJplus.val : BTZJ0 → Causal.Minkowski 2) :=
  fun _ => ⟨_, refl_mem_btzTildeDevAtlas, mem_univ _⟩

/-- On the model, the generated causality has the order of `𝐌³`. -/
theorem btzJ0_le_top_iff {x y : BTZJ0} :
    (btzTildeCausality _ btzJ0_isBTZTildeDev).le ⊤ x y ↔ (Causal.minkowski 2).le ⊤ x.val y.val := by
  refine ⟨fun h => (btzTilde_le_dev h).1, fun h => ?_⟩
  refine btzTildeAtlasCausality_le_of_link refl_mem_btzTildeDevAtlas
    (btzTilde_link_le_iff.2 ⟨⟨trivial, mem_univ _⟩, ⟨trivial, mem_univ _⟩, ?_⟩)
  have h' : btzJCLe ⊤ x y := btzJCLe_top_iff.2 h
  refine btzJCLe.mono (fun p _ => ⟨p, ⟨mem_univ _, trivial, mem_univ _⟩, rfl⟩) h'

theorem btzJ0_lt_top_iff {x y : BTZJ0} :
    (btzTildeCausality _ btzJ0_isBTZTildeDev).lt ⊤ x y ↔ (Causal.minkowski 2).lt ⊤ x.val y.val := by
  refine ⟨fun h => btzTilde_lt_dev h, fun h => ?_⟩
  refine btzTildeAtlasCausality_lt_of_link refl_mem_btzTildeDevAtlas
    (btzTilde_link_lt_iff.2 ⟨⟨trivial, mem_univ _⟩, ⟨trivial, mem_univ _⟩, ?_⟩)
  have h' : btzJCLt ⊤ x y := btzJCLt_top_iff.2 h
  refine btzJCLt.mono (fun p _ => ⟨p, ⟨mem_univ _, trivial, mem_univ _⟩, rfl⟩) h'

/-- **The model `\widetilde{BTZ}` is future complete** (non-vacuity of
`def:manifold_future_complete_all`): `D(J⁺(x)) = J⁺(D x)`, `D(I⁺(x)) = I⁺(D x)`, `D` the inclusion
`J⁺(Δ₀) ⊆ 𝐌³`, because `J⁺(Δ₀)` is a future set. -/
theorem btzJ0_isFutureComplete :
    IsFutureComplete (btzTildeCausality _ btzJ0_isBTZTildeDev) BTZJplus.val := by
  intro x
  have hfut : ∀ m, (Causal.minkowski 2).le ⊤ x.val m → m ∈ btzJplus (0 : ℝ × ℝ × ℝ) := fun m hm => by
    obtain ⟨p, hp, hpx⟩ := x.mem
    exact ⟨p, hp, (Causal.minkowski 2).le_trans hpx hm⟩
  constructor
  · ext m
    simp only [mem_image, Causal.Precausality.mem_Jplus_singleton, btzJ0_le_top_iff]
    exact ⟨fun ⟨y, hy, hym⟩ => hym ▸ hy, fun hm => ⟨BTZJplus.mk m (hfut m hm), hm, rfl⟩⟩
  · ext m
    simp only [mem_image, Causal.Precausality.mem_Iplus_singleton, btzJ0_lt_top_iff]
    exact ⟨fun ⟨y, hy, hym⟩ => hym ▸ hy, fun hm =>
      ⟨BTZJplus.mk m (hfut m ((Causal.minkowski 2).le_of_lt hm)), hm, rfl⟩⟩

end ModelExample

end GX
