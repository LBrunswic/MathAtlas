import BenzecriScaffold.Structure.Basic
import Mathlib.Topology.Covering.Basic

/-!
# `BenzecriScaffold.Structure.Jets` — the étalé topology on jets; `J(V)` is a covering of `V` (Déf. 12)

J.-P. Benzécri, *Sur les variétés localement affines et localement projectives*, Bull. SMF 88
(1960) 229–332, Chapter 1 § 1, journal p. 236; transcription
`papers/benzecri/legacy/labeled/benzecri1960_ch1.tex`. Package WP-45j (wave 2 fix round, layer L3;
DEC-120: « Déf. 12 is to be certified by building the étalé topology on the jet space J(V) and
proving J(V) → V a covering map »).

* **`bzdef:c1s1d12_variete_localement_projective`** — `benzecri1960_ch1.tex:304` (Déf. 12,
  l.304–317, p. 236). Certified with `Structure/Basic` (WP-45h), which this file completes:
  the jets of `M` into `X` are `Benzecri.Jet M X = Σ x, Germ (𝓝 x) X` (plan F3); **the étalé
  topology** `Benzecri.etaleTopology` is generated by the sets `{jet y f | y ∈ W}`, `W` open, the
  étalé space of germs; **« ensemble ouvert $J(V)$ »** is openness in it, equivalent to Basic's
  `IsEtaleOpen` (`isOpen_iff_isEtaleOpen`, any set of jets), so `IsJetStructure` is Déf. 12's « ensemble
  ouvert de jets d'isomorphismes » with 1° and 2° (`IsJetStructure.isOpen`); the jet structures are
  exactly the `J(V)` of the `(G,X)`-structures, which they determine (`exists_hasGroupoid_jets_eq_iff`,
  `maximalAtlas_eq_of_jets_eq`, in Basic); and **« $J(V)$, muni de la projection source sur $V$ est un
  revêtement de $V$ »**: `isCoveringMap_jets` (the `J(V)` of a `(G,X)`-structure, `G` acting
  analytically, with its discrete fibres `G`) and `IsJetStructure.isCoveringMap` (every set `J` of
  jets satisfying Déf. 12), instantiated for the paper's two cases (`isCoveringMap_jets_proj`,
  `isCoveringMap_jets_aff`). Over the source of a chart `e` of the maximal atlas the trivialisation
  is `(y, g) ↦ g • jet y e` (`jetsTrivialization`), its sheets the basic opens
  `{jet y (g • e) | y ∈ e.source}`, disjoint by `mem_jets_iff_existsUnique`.

> **Déf. 12.** Sur une variété $V$, convexe, de dimension $n$, on définit une structure de *variété
> localement projective* (resp. *affine*), par la donnée d'un ensemble ouvert $J(V)$ de jets
> d'isomorphismes de $V$ dans $S(n)$ (resp. $\R^n$) appelé ensemble de jets projectifs (resp.
> affins) et jouissant des propriétés suivantes :
> 1° L'image de $J(V)$ par la projection source est $V$ tout entier;
> 2° $GS(n, \R)$ [resp. $GA(n, \R)$] opère transitivement sur chaque fibre de $J(V)$, composée des
> jets de source donnée.
> Il est clair que $J(V)$, muni de la projection source sur $V$ est un revêtement de $V$.

## Hypothesis checklist

| paper hypothesis | here |
|---|---|
| `V` a variété « convexe » (`[sic]`, read « connexe »), Hausdorff, second countable (plan F6) | generalised: none is used; `V` is any topological space |
| « ensemble ouvert $J(V)$ » | ✓ carried: `IsOpen` for the étalé topology `etaleTopology`, equivalent to `IsEtaleOpen` (`isOpen_iff_isEtaleOpen`) |
| « jets d'isomorphismes » | ✓ carried: germs of `OpenPartialHomeomorph` (`IsIsoJet`, Basic) |
| 1°, 2° | ✓ carried (`IsJetStructure`, Basic) |
| « revêtement » | ✓ carried: Mathlib's `IsCoveringMap` of the source projection `J(V) → V` (subspace topology of the étalé topology) |
| `GS(n, ℝ)`, `GA(n, ℝ)` and their rigidity | ✓ carried: `IsAnalyticAction G X`, an instance for both (`GSR n` on `S n`, wave 1; `GAR n` on `ℝⁿ`, Basic); the fibres are discrete by construction (the trivialisation's fibre is `G` with the discrete topology, chosen inside the proof, no hypothesis on `G`) |

## SCOPE (disclosed)

* **The topology is a scoped instance** (`Benzecri.etaleTopology`, active inside `namespace
  Benzecri`; elsewhere `open scoped Benzecri`): `Jet M X` is a `Sigma` of Mathlib's `Filter.Germ`,
  which carries no topology in Mathlib, and a global instance on a Mathlib type would be an orphan.
* The covering is proved for an arbitrary `(G, X)` with `G` acting analytically; rigidity is what
  makes the sheets `{jet y (g • e)}` over a chart disjoint (without it `J(V)` can be non-Hausdorff
  and is not a covering). The paper's two cases are corollaries.
* Not proved here (not asserted by Déf. 12): `J(V)` Hausdorff, the étalé space of ALL germs being a
  covering (it is only a local homeomorphism over `V`: `continuous_jet`, `isOpen_etaleBasic`).

Provenance: mathlib `fabf563a` (tag `v4.31.0`), pinned via `lakefile.toml`.
-/

noncomputable section

open Set Filter Topology Bundle

namespace Benzecri

universe u v w

/-! ### The étalé topology on jets -/

section Etale

variable {M : Type u} [TopologicalSpace M] {X : Type v}

variable (M X) in
/-- The basic open sets of the étalé topology of germs: `{jet y f | y ∈ W}`, `W` open in `M`,
`f : M → X` any map (a local map defined on `W`; its values off `W` do not matter). -/
def etaleBasis : Set (Set (Jet M X)) :=
  {S | ∃ (f : M → X) (W : Set M), IsOpen W ∧ S = (fun y => jet y f) '' W}

variable (M X) in
/-- **The étalé topology on the jets `J(M, X) = Σ x, Germ (𝓝 x) X`**, generated by the sets
`{jet y f | y ∈ W}`, `W` open: the étalé space of germs of maps `M → X` (Déf. 12's « ensemble
ouvert » of jets). A scoped instance (SCOPE). -/
scoped instance etaleTopology : TopologicalSpace (Jet M X) :=
  TopologicalSpace.generateFrom (etaleBasis M X)

/-- The basic sets `{jet y f | y ∈ W}` are open. -/
theorem isOpen_etaleBasic (f : M → X) {W : Set M} (hW : IsOpen W) :
    IsOpen ((fun y => jet y f) '' W) :=
  TopologicalSpace.GenerateOpen.basic _ ⟨f, W, hW, rfl⟩

/-- Every jet is the jet of a map at its source. -/
theorem exists_jet_eq (j : Jet M X) : ∃ f : M → X, jet j.1 f = j := by
  obtain ⟨x, γ⟩ := j
  exact Germ.inductionOn γ fun f => ⟨f, rfl⟩

theorem jet_mem_image_jet_iff {f g : M → X} {W : Set M} {y : M} :
    jet y g ∈ (fun z => jet z f) '' W ↔ y ∈ W ∧ f =ᶠ[𝓝 y] g := by
  constructor
  · rintro ⟨z, hz, h⟩
    obtain rfl : z = y := congrArg Sigma.fst h
    exact ⟨hz, jet_eq_jet_iff.1 h⟩
  · rintro ⟨hy, h⟩
    exact ⟨y, hy, jet_eq_jet_iff.2 h⟩

/-- **`y ↦ jet y g` is continuous** for the étalé topology, for every map `g : M → X`. -/
theorem continuous_jet (g : M → X) : Continuous fun y => jet y g := by
  refine continuous_generateFrom_iff.2 ?_
  rintro _ ⟨f, W, hW, rfl⟩
  have : (fun y => jet y g) ⁻¹' ((fun y => jet y f) '' W) = {y | y ∈ W ∧ f =ᶠ[𝓝 y] g} := by
    ext y
    exact jet_mem_image_jet_iff
  rw [this, isOpen_iff_mem_nhds]
  rintro y ⟨hy, h⟩
  exact Filter.Eventually.and (p := fun z => z ∈ W) (hW.mem_nhds hy) h.eventually_nhds

/-- **« ensemble ouvert » of Déf. 12**: a set of jets is open in the étalé topology iff with a jet
`jet x f` it contains `jet y f` for every `y` near `x` (Basic's `IsEtaleOpen`). -/
theorem isOpen_iff_isEtaleOpen [TopologicalSpace X] {J : Set (Jet M X)} : IsOpen J ↔ IsEtaleOpen J := by
  constructor
  · intro hJ x f hx
    exact (continuous_jet f).continuousAt.preimage_mem_nhds (hJ.mem_nhds hx)
  · intro hJ
    rw [isOpen_iff_forall_mem_open]
    intro j hj
    obtain ⟨f, hf⟩ := exists_jet_eq j
    rw [← hf] at hj ⊢
    obtain ⟨W, hWJ, hW, hxW⟩ := mem_nhds_iff.1 (hJ _ f hj)
    refine ⟨(fun y => jet y f) '' W, ?_, isOpen_etaleBasic f hW, ⟨_, hxW, rfl⟩⟩
    rintro _ ⟨y, hy, rfl⟩
    exact hWJ hy

/-- **The source projection `J(M, X) → M` is continuous.** -/
theorem continuous_jetSource : Continuous fun j : Jet M X => j.1 := by
  letI : TopologicalSpace X := ⊥
  refine continuous_def.2 fun W hW => isOpen_iff_isEtaleOpen.2 fun x f hx => ?_
  filter_upwards [hW.mem_nhds hx] with y hy using hy

/-- A jet structure (Déf. 12) is an open set of jets for the étalé topology. -/
theorem IsJetStructure.isOpen [TopologicalSpace X] {G : Type w} [Group G] [MulAction G X] {J : Set (Jet M X)}
    (hJ : IsJetStructure G J) : IsOpen J :=
  isOpen_iff_isEtaleOpen.2 hJ.isEtaleOpen

end Etale

/-! ### `J(V) → V` is a covering map -/

section Covering

variable {M : Type u} [TopologicalSpace M] {X : Type v} [TopologicalSpace X]
  {G : Type w} [Group G] [MulAction G X] [ContinuousConstSMul G X] [IsAnalyticAction G X]
  [ChartedSpace X M] [HasGroupoid M (gxGroupoid G X)]

omit [IsAnalyticAction G X] in
/-- `J(V)` is open for the étalé topology. -/
theorem isOpen_jets : IsOpen (jets G X M) :=
  (isJetStructure_jets (G := G) (X := X) (M := M)).isOpen

variable {e : OpenPartialHomeomorph M X}

theorem exists_sheetIndex (he : e ∈ (gxGroupoid G X).maximalAtlas M) {j : jets G X M}
    (hj : j.1.1 ∈ e.source) :
    ∃! g : G, j.1.2 = ((e : M → X) : Germ (𝓝 j.1.1) X).map (g • ·) :=
  (mem_jets_iff_existsUnique he hj j.1.2).1 j.2

open scoped Classical in
/-- **The sheet of a jet of `J(V)` over the source of a chart `e`**: the unique `g ∈ G` with
`j = g • jet y e` (and `1` off `e.source`). -/
def sheetIndex (he : e ∈ (gxGroupoid G X).maximalAtlas M) (j : jets G X M) : G :=
  if hj : j.1.1 ∈ e.source then (exists_sheetIndex he hj).exists.choose else 1

theorem sheetIndex_spec (he : e ∈ (gxGroupoid G X).maximalAtlas M) {j : jets G X M}
    (hj : j.1.1 ∈ e.source) :
    j.1.2 = ((e : M → X) : Germ (𝓝 j.1.1) X).map (sheetIndex he j • ·) := by
  rw [sheetIndex, dif_pos hj]
  exact (exists_sheetIndex he hj).exists.choose_spec

theorem sheetIndex_eq (he : e ∈ (gxGroupoid G X).maximalAtlas M) {j : jets G X M}
    (hj : j.1.1 ∈ e.source) {g : G} (h : j.1.2 = ((e : M → X) : Germ (𝓝 j.1.1) X).map (g • ·)) :
    sheetIndex he j = g :=
  (exists_sheetIndex he hj).unique (sheetIndex_spec he hj) h

/-- A jet of `J(V)` over `e.source` is `g • jet y e` for its sheet `g`. -/
theorem val_eq_jetSMul_sheetIndex (he : e ∈ (gxGroupoid G X).maximalAtlas M) {j : jets G X M}
    (hj : j.1.1 ∈ e.source) : j.1 = jetSMul (sheetIndex he j) (jet j.1.1 e) := by
  obtain ⟨⟨x, γ⟩, hγ⟩ := j
  have := sheetIndex_spec he (j := ⟨⟨x, γ⟩, hγ⟩) hj
  simp only at this hj ⊢
  rw [jetSMul, jet, Germ.map_coe, Sigma.mk.injEq]
  exact ⟨rfl, heq_of_eq (this.trans (Germ.map_coe _ _))⟩

/-- The sheet of `jet y (g • e)` is `g`. -/
theorem sheetIndex_eq_of_val_eq (he : e ∈ (gxGroupoid G X).maximalAtlas M) {j : jets G X M}
    {y : M} (hy : y ∈ e.source) {g : G} (h : j.1 = jet y fun z => g • e z) :
    sheetIndex he j = g := by
  obtain ⟨⟨x, γ⟩, hγ⟩ := j
  simp only at h
  rw [jet, Sigma.mk.injEq] at h
  obtain ⟨rfl, h⟩ := h
  refine sheetIndex_eq he hy ?_
  rw [heq_eq_eq] at h
  simp only [h, Germ.map_coe]
  rfl

omit [IsAnalyticAction G X] in
theorem jetSMul_jet_mem_jets (he : e ∈ (gxGroupoid G X).maximalAtlas M) {y : M}
    (hy : y ∈ e.source) (g : G) : jetSMul g (jet y e) ∈ jets G X M :=
  (isJetStructure_jets (G := G) (X := X) (M := M)).smul_mem g _ (jet_mem_jets he hy)

open scoped Classical in
/-- The inverse of the trivialisation over `e.source`: `(y, g) ↦ g • jet y e` (a junk jet of `J(V)`
off `e.source`). -/
def jetsTrivInv (he : e ∈ (gxGroupoid G X).maximalAtlas M) (p : M × G) : jets G X M :=
  if hp : p.1 ∈ e.source then ⟨jetSMul p.2 (jet p.1 e), jetSMul_jet_mem_jets he hp p.2⟩
  else ⟨jet p.1 (chartAt X p.1), jet_mem_jets ((gxGroupoid G X).chart_mem_maximalAtlas p.1)
    (mem_chart_source X p.1)⟩

omit [IsAnalyticAction G X] in
theorem jetsTrivInv_of_mem (he : e ∈ (gxGroupoid G X).maximalAtlas M) {p : M × G}
    (hp : p.1 ∈ e.source) : (jetsTrivInv he p).1 = jetSMul p.2 (jet p.1 e) := by
  rw [jetsTrivInv, dif_pos hp]

/-- **The trivialisation of `J(V) → V` over the source of a chart `e`** of the maximal atlas
(`G` with the discrete topology): `j ↦ (source, sheet)`, with inverse `(y, g) ↦ g • jet y e`. -/
def jetsTrivialization [TopologicalSpace G] [DiscreteTopology G]
    (he : e ∈ (gxGroupoid G X).maximalAtlas M) :
    Trivialization G (fun j : jets G X M => j.1.1) where
  toFun j := (j.1.1, sheetIndex he j)
  invFun := jetsTrivInv he
  source := {j | j.1.1 ∈ e.source}
  target := e.source ×ˢ univ
  map_source' _ hj := ⟨hj, trivial⟩
  map_target' p hp := by
    show (jetsTrivInv he p).1.1 ∈ e.source
    rw [jetsTrivInv_of_mem he hp.1]
    exact hp.1
  left_inv' j hj := by
    apply Subtype.ext
    show (jetsTrivInv he ((j : Jet M X).1, sheetIndex he j)).1 = j.1
    rw [jetsTrivInv_of_mem he (p := ((j : Jet M X).1, sheetIndex he j)) hj]
    exact (val_eq_jetSMul_sheetIndex he hj).symm
  right_inv' p hp := by
    obtain ⟨y, g⟩ := p
    have hy : y ∈ e.source := hp.1
    have hv := jetsTrivInv_of_mem he (p := (y, g)) hy
    show ((jetsTrivInv he (y, g)).1.1, sheetIndex he (jetsTrivInv he (y, g))) = (y, g)
    refine Prod.ext ?_ (sheetIndex_eq_of_val_eq he hy ((hv.trans (jetSMul_jet g y e))))
    show (jetsTrivInv he (y, g)).1.1 = y
    rw [hv]
    rfl
  open_source := (continuous_jetSource.comp continuous_subtype_val).isOpen_preimage _ e.open_source
  open_target := e.open_source.prod isOpen_univ
  continuousOn_toFun := by
    refine continuousOn_of_forall_continuousAt fun j hj => ?_
    refine ((continuous_jetSource.comp continuous_subtype_val).continuousAt).prodMk ?_
    rw [ContinuousAt, nhds_discrete G, tendsto_pure]
    set g₀ := sheetIndex he j
    have hB : IsOpen (Subtype.val ⁻¹' ((fun y => jet y fun z => g₀ • e z) '' e.source) :
        Set (jets G X M)) :=
      (isOpen_etaleBasic _ e.open_source).preimage continuous_subtype_val
    have hjB : j ∈ Subtype.val ⁻¹' ((fun y => jet y fun z => g₀ • e z) '' e.source) :=
      ⟨(j : Jet M X).1, hj, by
        show jet (j : Jet M X).1 (fun z => g₀ • e z) = j
        rw [← jetSMul_jet, ← val_eq_jetSMul_sheetIndex he hj]⟩
    filter_upwards [hB.mem_nhds hjB] with j' hj'
    obtain ⟨y, hy, hj'⟩ := hj'
    exact sheetIndex_eq_of_val_eq he hy hj'.symm
  continuousOn_invFun := by
    refine continuousOn_of_forall_continuousAt fun p hp => ?_
    obtain ⟨y₀, g₀⟩ := p
    have hy₀ : y₀ ∈ e.source := hp.1
    rw [IsInducing.subtypeVal.continuousAt_iff]
    have hN : e.source ×ˢ ({g₀} : Set G) ∈ 𝓝 (y₀, g₀) :=
      prod_mem_nhds (e.open_source.mem_nhds hy₀) ((isOpen_discrete ({g₀} : Set G)).mem_nhds rfl)
    refine ((continuous_jet fun z => g₀ • e z).comp continuous_fst).continuousAt.congr ?_
    filter_upwards [hN] with p hp'
    obtain ⟨y, g⟩ := p
    obtain ⟨hy, rfl : g = g₀⟩ := hp'
    show _ = (jetsTrivInv he (y, g)).1
    rw [jetsTrivInv_of_mem he (p := (y, g)) hy]
    exact (jetSMul_jet g y e).symm
  baseSet := e.source
  open_baseSet := e.open_source
  source_eq := rfl
  target_eq := rfl
  proj_toFun _ _ := rfl

variable (G X M) in
/-- **Déf. 12, « $J(V)$, muni de la projection source sur $V$ est un revêtement de $V$ »**: for a
`(G,X)`-structure with `G` acting analytically, the source projection of its jets `J(V) → V` is a
covering map (Mathlib's `IsCoveringMap`), with fibres `G` (discrete), trivial over every chart
domain (`jetsTrivialization`). -/
theorem isCoveringMap_jets : IsCoveringMap fun j : jets G X M => j.1.1 := by
  letI : TopologicalSpace G := ⊥
  haveI : DiscreteTopology G := ⟨rfl⟩
  exact IsCoveringMap.mk _ (fun _ => G)
    (fun x => jetsTrivialization ((gxGroupoid G X).chart_mem_maximalAtlas x))
    (fun x => mem_chart_source X x)

end Covering

/-- **Déf. 12 as printed**: every set `J` of jets of isomorphisms of `M` into `X` satisfying Déf. 12
(open, 1°, 2°) is a covering of `M` by the source projection, for an analytic action. -/
theorem IsJetStructure.isCoveringMap {M : Type u} [TopologicalSpace M] {X : Type v}
    [TopologicalSpace X] {G : Type w} [Group G] [MulAction G X] [ContinuousConstSMul G X]
    [IsAnalyticAction G X] {J : Set (Jet M X)} (hJ : IsJetStructure G J) :
    IsCoveringMap fun j : J => j.1.1 := by
  letI := chartedSpaceOfJets hJ
  haveI := hasGroupoid_chartedSpaceOfJets hJ
  have h := isCoveringMap_jets M X G
  rwa [jets_chartedSpaceOfJets hJ] at h

/-- Déf. 12 for locally projective manifolds: `J(V) → V` is a covering. -/
theorem isCoveringMap_jets_proj {n : ℕ} {V : Type u} [TopologicalSpace V] [ChartedSpace (S n) V]
    [HasGroupoid V (projGroupoid n)] : IsCoveringMap fun j : jets (GSR n) (S n) V => j.1.1 :=
  isCoveringMap_jets _ _ _

/-- Déf. 12 for locally affine manifolds: `J(V) → V` is a covering. -/
theorem isCoveringMap_jets_aff {n : ℕ} {V : Type u} [TopologicalSpace V]
    [ChartedSpace (Fin n → ℝ) V] [HasGroupoid V (affGroupoid n)] :
    IsCoveringMap fun j : jets (GAR n) (Fin n → ℝ) V => j.1.1 :=
  isCoveringMap_jets _ _ _

end Benzecri
