import Causal.GluingGeneric.Pullback

/-!
# Gluing in its hereditary form, generic constructions (3): generated causalities and gluings

No label of `ETT.tex` is marked by this file (target `T-abs-gluing-generic`, DEC-167 step 1a).
Cited, unmarked: `lem:precausalite_engendre_minimale` — `ETT.tex:498`,
`theo:causalite_engendre` — `ETT.tex:514`, `defi:ppcm` — `ETT.tex:1987`.

> Let $M$ be a topological space and let $(\leq,\ll)$ be the precausality generated by a family
> $(\U_i,\leq^i,\ll^i)_{i\in I}$. If the precausalities $(\leq^i,\ll^i)$ are absolutely minimal,
> then so is $(\leq,\ll)$. (`ETT.tex:499–501`)

> Absolute minimality of $(\leq^{i_k},\ll^{i_k})$ \emph{on $\U$} --- a statement quantified over
> every open cover of $\U$ and every open subset of $\U$ […] (`ETT.tex:508`)

## What is proved (no `sorry` in this file)

* **`lem:precausalite_engendre_minimale`, hereditary form**
  (`Precausality.generated_absolutelyMinimalOn_all`, `Causality.generated_absolutelyMinimalOn_all`):
  if each `P i` is absolutely minimal on every open subset of `U i`, the generated precausality is
  absolutely minimal on every open set. No compatibility (B) and no Baire hypothesis is used. The
  M-only form is the library's `Precausality.generated_absolutelyMinimal` (hypothesis:
  `AbsolutelyMinimalOn (U i)`), and **that hypothesis does not give the hereditary conclusion**:
  `generated_single_transparentLine` (one chart, the transparent-point line).
* **Transport along an open embedding** (`Causality.pushLocal`, extended): hereditary ⇒ hereditary
  (`pushLocal_extend_absolutelyMinimalOn_all`); M-only ⇒ M-only on the whole target
  (`pushLocal_extend_absolutelyMinimal`; the library's `absolutelyMinimalOn_pushLocal_extend` gives
  it on the image).
* **The gluing of two spacetimes** (`Gluing.causality`, the causality of `defi:ppcm`'s gluing):
  both forms are preserved (`Gluing.causality_absolutelyMinimalOn_all`,
  `Gluing.causality_absolutelyMinimal`); no compatibility is used.
* **The gluing of a family** (`CBG.FamilyGlueData.causality`): hereditary ⇒ hereditary
  (`FamilyGlueData.causality_absolutelyMinimalOn_all`; M-only is the library's
  `causality_absolutelyMinimal`). Its witness pieces `ofOpensCausality` (pullbacks along the
  inclusions of open sets): hereditary ⇒ hereditary (`ofOpensCausality_absolutelyMinimalOn_all`,
  `ofOpens_causality_absolutelyMinimalOn_all`), while the M-only form of a piece is the M-only form
  of `Y` on `V i` (`ofOpensCausality_absolutelyMinimal_iff`), which the M-only form of `Y` does not
  give (`Causal.transparentLine_pullback_val_not_absolutelyMinimal`).

## Hypothesis checklist

| paper hypothesis | here |
|---|---|
| `lem:precausalite_engendre_minimale`: each `(≤^i,≪^i)` absolutely minimal | ⚠ strengthened (the hereditary reading, OQ-95): absolutely minimal on every open subset of `U i`. The paper's proof (`ETT.tex:508`) uses absolute minimality on `U_i`, quantified over the open subsets of `U_i`, which is the library's `AbsolutelyMinimalOn (U i)`; that does not give the hereditary conclusion (the single-chart transparent-point counterexample) |
| — the family is a cover | ✓ carried: `hU` |
| `theo:causalite_engendre` (B), (C) Baire | ⚠ weakened: not used |

## SCOPE (disclosed)

* `lem:precausalite_engendre_minimale` is not marked: its statement is certified in the M-only
  reading by the library (`Precausality.generated_absolutelyMinimal`, marked there); the
  hereditary form proved here is its reading under OQ-95's hereditary field, where "absolutely
  minimal" of a causality on `U_i` means "on every open subset of `U_i`". Which reading is the
  formalization of record is the author's (OQ-95).

Provenance: mathlib `fabf563a` (tag `v4.31.0`), pinned via `lakefile.toml`.
-/

namespace Causal

open Set TopologicalSpace Topology Relation Function GluingGeneric

universe u v w

variable {M : Type u} [TopologicalSpace M]

/-! ### The generated precausality -/

namespace Precausality

variable {ι : Type w} {U : ι → Opens M} {P : ι → Precausality M}

/-- **`lem:precausalite_engendre_minimale`, hereditary form.** The precausality generated by a
family `(U i, P i)` each absolutely minimal on every open subset of `U i` is absolutely minimal on
every open set. -/
theorem generated_absolutelyMinimalOn_all (hU : ∀ x : M, ∃ i, x ∈ U i)
    (hA : ∀ i, ∀ W : Opens M, W ≤ U i → (P i).AbsolutelyMinimalOn W) (W : Opens M) :
    (generated U hU P).AbsolutelyMinimalOn W := by
  intro S hS V hV x y
  have hS' : ∀ i, ∀ z ∈ W ⊓ U i, ∃ O ∈ S, z ∈ O := fun i z hz => hS z hz.1
  refine ⟨fun hxy => ?_, fun hxy => ?_⟩
  · refine transGen_flatten (fun a b hab => ?_) (hxy : TransGen (LinkLe U P V) x y)
    obtain ⟨i, hi⟩ := hab
    refine TransGen.mono (fun c d hcd => ?_) (((hA i (W ⊓ U i) inf_le_right) S (hS' i) (V ⊓ U i)
      (inf_le_inf_right _ hV) a b).1 hi)
    obtain ⟨O, hO, hcd⟩ := hcd
    refine ⟨O, hO, TransGen.single ⟨i, ?_⟩⟩
    rwa [inf_right_comm]
  · refine transGen_flatten (fun a b hab => ?_) (hxy : TransGen (LinkLt U P V) x y)
    obtain ⟨i, hi⟩ := hab
    refine TransGen.mono (fun c d hcd => ?_) (((hA i (W ⊓ U i) inf_le_right) S (hS' i) (V ⊓ U i)
      (inf_le_inf_right _ hV) a b).2 hi)
    obtain ⟨O, hO, hcd⟩ := hcd
    refine ⟨O, hO, TransGen.single ⟨i, ?_⟩⟩
    rwa [inf_right_comm]

end Precausality

namespace Causality

variable {ι : Type w} {U : ι → Opens M} {C : ι → Causality M}

theorem generated_absolutelyMinimalOn_all (hU : ∀ x : M, ∃ i, x ∈ U i)
    (hA : ∀ i, ∀ W : Opens M, W ≤ U i → (C i).AbsolutelyMinimalOn W) (W : Opens M) :
    (generated U hU C).AbsolutelyMinimalOn W :=
  Precausality.generated_absolutelyMinimalOn_all hU hA W

end Causality

/-- **The hypothesis `AbsolutelyMinimalOn (U i)` of `generated_absolutelyMinimal` does not give
the hereditary conclusion**: one chart `U = ℝ` with the transparent-point line, absolutely minimal
on `ℝ`; the generated causality is the transparent-point line, not absolutely minimal on
`ℝ ∖ {0}`. -/
theorem generated_single_transparentLine :
    (∀ i : Unit, transparentLine.AbsolutelyMinimalOn ((fun _ => ⊤ : Unit → Opens ℝ) i)) ∧
      ¬ (Causality.generated (fun _ : Unit => (⊤ : Opens ℝ)) (fun _ => ⟨(), trivial⟩)
        (fun _ => transparentLine)).AbsolutelyMinimalOn realMinusZero := by
  refine ⟨fun _ => transparentLine_absolutelyMinimalOn_top, fun h => ?_⟩
  have hB : Precausality.Compatible (fun _ : Unit => (⊤ : Opens ℝ))
      (fun _ => transparentLine.toPrecausality) := fun _ _ _ _ _ _ => ⟨Iff.rfl, Iff.rfl⟩
  refine transparentLine_not_absolutelyMinimalOn ((Precausality.absolutelyMinimalOn_congr ?_).1 h)
  intro V _ x y
  have hU : ∀ x : ℝ, ∃ i : Unit, x ∈ (fun _ : Unit => (⊤ : Opens ℝ)) i := fun _ => ⟨(), trivial⟩
  exact ⟨Precausality.generated_le_iff (hU := hU) (i := ()) hB le_top,
    Precausality.generated_lt_iff (hU := hU) (i := ()) hB le_top⟩

/-! ### Transport along an open embedding -/

namespace Causality

variable {X : Type v} [TopologicalSpace X] {Z : Type w} [TopologicalSpace Z] {e : X → Z}

/-- **Transport along an open embedding, hereditary form.** -/
theorem pushLocal_extend_absolutelyMinimalOn_all (C : Causality X) (he : IsOpenEmbedding e)
    (h : ∀ W : Opens X, C.AbsolutelyMinimalOn W) (W : Opens Z) :
    (C.pushLocal he).extend.AbsolutelyMinimalOn W := by
  intro S hS V hV a b
  let S' : Set (Opens X) := (fun O => preimageOpens he.continuous O) '' S
  have hS' : ∀ x ∈ preimageOpens he.continuous W, ∃ O ∈ S', x ∈ O := by
    intro x hx
    obtain ⟨O, hO, hxO⟩ := hS (e x) hx
    exact ⟨_, ⟨O, hO, rfl⟩, hxO⟩
  have hVW : preimageOpens he.continuous (V ⊓ (⟨range e, he.isOpen_range⟩ : Opens Z)) ≤
      preimageOpens he.continuous W := fun z hz => hV hz.1
  have hinf : ∀ O : Opens Z,
      preimageOpens he.continuous (V ⊓ O ⊓ (⟨range e, he.isOpen_range⟩ : Opens Z)) =
        preimageOpens he.continuous (V ⊓ (⟨range e, he.isOpen_range⟩ : Opens Z)) ⊓
          preimageOpens he.continuous O := fun O =>
    (congrArg (preimageOpens he.continuous) (inf_right_comm V O _)).trans rfl
  refine ⟨fun hab => ?_, fun hab => ?_⟩
  · rcases hab with ⟨rfl, ha⟩ | ⟨x, y, rfl, rfl, hxy⟩
    · obtain ⟨O, hO, haO⟩ := hS a (hV ha)
      exact TransGen.single ⟨O, hO, Or.inl ⟨rfl, ha, haO⟩⟩
    · refine TransGen.lift e (fun c d hcd => ?_) ((h _ S' hS' _ hVW x y).1 hxy)
      obtain ⟨_, ⟨O, hO, rfl⟩, hcd⟩ := hcd
      refine ⟨O, hO, Or.inr ⟨c, d, rfl, rfl, ?_⟩⟩
      rw [← hinf] at hcd
      exact hcd
  · obtain ⟨x, y, rfl, rfl, hxy⟩ := hab
    refine TransGen.lift e (fun c d hcd => ?_) ((h _ S' hS' _ hVW x y).2 hxy)
    obtain ⟨_, ⟨O, hO, rfl⟩, hcd⟩ := hcd
    refine ⟨O, hO, ⟨c, d, rfl, rfl, ?_⟩⟩
    rw [← hinf] at hcd
    exact hcd

/-- **Transport along an open embedding, M-only form**, on the whole target. -/
theorem pushLocal_extend_absolutelyMinimal (C : Causality X) (he : IsOpenEmbedding e)
    (h : C.AbsolutelyMinimal) : (C.pushLocal he).extend.AbsolutelyMinimal :=
  LocalCausality.extend_absolutelyMinimal _ (C.absolutelyMinimalOn_pushLocal_extend he h)

end Causality

/-! ### The gluing of two spacetimes -/

namespace Gluing

variable {X : Type u} {Y : Type v} {W : Type w} [TopologicalSpace X] [TopologicalSpace Y]
  [TopologicalSpace W] {j₁ : W → X} {j₂ : W → Y} (hj₁ : IsOpenEmbedding j₁)
  (hj₂ : IsOpenEmbedding j₂)

/-- **The causality of the gluing, hereditary form.** No compatibility is used. -/
theorem causality_absolutelyMinimalOn_all {C₁ : Causality X} {C₂ : Causality Y}
    (h₁ : ∀ V : Opens X, C₁.AbsolutelyMinimalOn V) (h₂ : ∀ V : Opens Y, C₂.AbsolutelyMinimalOn V)
    (V : Opens (Gluing j₁ j₂)) : (causality hj₁ hj₂ C₁ C₂).AbsolutelyMinimalOn V := by
  refine Causality.generated_absolutelyMinimalOn_all _ (fun b W' _ => ?_) V
  cases b
  · exact C₂.pushLocal_extend_absolutelyMinimalOn_all _ h₂ W'
  · exact C₁.pushLocal_extend_absolutelyMinimalOn_all _ h₁ W'

/-- **The causality of the gluing, M-only form.** No compatibility is used. -/
theorem causality_absolutelyMinimal {C₁ : Causality X} {C₂ : Causality Y}
    (h₁ : C₁.AbsolutelyMinimal) (h₂ : C₂.AbsolutelyMinimal) :
    (causality hj₁ hj₂ C₁ C₂).AbsolutelyMinimal := by
  refine Causality.generated_absolutelyMinimal _ fun b => ?_
  cases b
  · exact C₂.absolutelyMinimalOn_pushLocal_extend _ h₂
  · exact C₁.absolutelyMinimalOn_pushLocal_extend _ h₁

end Gluing

/-! ### The gluing of a family -/

namespace CBG.FamilyGlueData

variable {I : Type v} {Mi : I → Type u} [∀ i, TopologicalSpace (Mi i)] (D : FamilyGlueData I Mi)

/-- **The glued causality of a family, hereditary form.** No compatibility is used. -/
theorem causality_absolutelyMinimalOn_all {C : ∀ i, Causality (Mi i)}
    (hA : ∀ i, ∀ W : Opens (Mi i), (C i).AbsolutelyMinimalOn W) (W : Opens D.Glued) :
    (D.causality C).AbsolutelyMinimalOn W :=
  Causality.generated_absolutelyMinimalOn_all _
    (fun i W' _ => (C i).pushLocal_extend_absolutelyMinimalOn_all _ (hA i) W') W

section OfOpens

variable {X : Type u} [TopologicalSpace X]

/-- The pieces of `ofOpens V` (pullbacks of `Y` along the inclusions) are hereditarily minimal
when `Y` is. -/
theorem ofOpensCausality_absolutelyMinimalOn_all (Y : Causality X) (V : I → Opens X)
    (hY : ∀ W : Opens X, Y.AbsolutelyMinimalOn W) (i : I) (W : Opens (V i)) :
    (ofOpensCausality Y V i).AbsolutelyMinimalOn W :=
  Y.pullback_absolutelyMinimalOn_all_of_isOpenEmbedding (V i).isOpen.isOpenEmbedding_subtypeVal
    (fun U _ => hY U) W

/-- The M-only form of a piece of `ofOpens V` is the absolute minimality of `Y` on `V i`. -/
theorem ofOpensCausality_absolutelyMinimal_iff (Y : Causality X) (V : I → Opens X) (i : I) :
    (ofOpensCausality Y V i).AbsolutelyMinimal ↔ Y.AbsolutelyMinimalOn (V i) :=
  Y.pullback_val_absolutelyMinimal_iff (V i)

/-- The glued causality of open subsets of a hereditarily minimal spacetime is hereditarily
minimal. -/
theorem ofOpens_causality_absolutelyMinimalOn_all (Y : Causality X) (V : I → Opens X)
    (hY : ∀ W : Opens X, Y.AbsolutelyMinimalOn W) (W : Opens (ofOpens V).Glued) :
    ((ofOpens V).causality (ofOpensCausality Y V)).AbsolutelyMinimalOn W :=
  (ofOpens V).causality_absolutelyMinimalOn_all
    (fun i => ofOpensCausality_absolutelyMinimalOn_all Y V hY i) W

end OfOpens

end CBG.FamilyGlueData

end Causal
