namespace Causal

open Set TopologicalSpace Topology

universe u

variable {M : Type u} [TopologicalSpace M]

namespace Causality

variable (C : Causality M)

/-! ### Causal plainness and push-up -/

/-- `defi:causalement_plat`. "A topological spacetime `M` is *causally plain* if for every open
subset `U` of `M` and every `A ⊂ U`, `Int(J^±_U(A)) ⊂ closure(I^±_U(A))`." -/
def CausallyPlain : Prop :=
  ∀ (U : Opens M) (A : Set M),
    interior (C.Jplus U A) ⊆ closure (C.Iplus U A) ∧
    interior (C.Jminus U A) ⊆ closure (C.Iminus U A)

/-- `defi:causalement_plat` for the open subset `W` seen as a spacetime (`ex:open_subset`): the
inclusions are asked of the open subsets of `W`. -/
def CausallyPlainOn (W : Opens M) : Prop :=
  ∀ (U : Opens M), U ≤ W → ∀ A : Set M,
    interior (C.Jplus U A) ⊆ closure (C.Iplus U A) ∧
    interior (C.Jminus U A) ⊆ closure (C.Iminus U A)

/-- `defi:pushup`. "`M` has the *push-up property* if for every open subset `U` of `M` and every
`x ∈ U`, `J^±_U(I^±_U(x)) ⊂ I^±_U(x)` and `I^±_U(J^±_U(x)) ⊂ I^±_U(x)`." -/
def PushUp : Prop :=
  ∀ (U : Opens M) (x : M),
    (C.Jplus U (C.Iplus U {x}) ⊆ C.Iplus U {x} ∧ C.Jminus U (C.Iminus U {x}) ⊆ C.Iminus U {x}) ∧
    (C.Iplus U (C.Jplus U {x}) ⊆ C.Iplus U {x} ∧ C.Iminus U (C.Jminus U {x}) ⊆ C.Iminus U {x})

/-! ### Diamonds -/

/-- `def:diamonds`. "`J_U(p,q) := J^-_U(q) ∩ J^+_U(p)`, the full diamond from `p` to `q`." -/
def diamond (U : Opens M) (p q : M) : Set M := C.Jminus U {q} ∩ C.Jplus U {p}

/-- `def:diamonds`. "`\ring J_U(p,q) := Int(J_U(p,q))`, the open diamond from `p` to `q`." -/
def openDiamond (U : Opens M) (p q : M) : Set M := interior (C.diamond U p q)

/-- `def:causally_compact`. "`M` is causally compact if the diamond `J(p,q)` is compact for all
`p, q ∈ M`." -/
def CausallyCompact : Prop := ∀ p q : M, IsCompact (C.diamond ⊤ p q)

/-- `def:alexandrov_topology`. "The Alexandrov topology on `M` is the topology generated by the
open diamonds of `M`." Not mathlib's `AlexandrovDiscrete`, which is unrelated. -/
@[reducible] def alexandrovTopology : TopologicalSpace M :=
  TopologicalSpace.generateFrom {S | ∃ p q : M, S = C.openDiamond ⊤ p q}

/-! ### Causal, causally convex, strongly causal -/

/-- `def:causal_spacetime`. "A topological spacetime is causal if the relation `≤_M` is an order
relation on `M`": antisymmetry, reflexivity and transitivity being axiom (a). -/
def IsCausal : Prop := ∀ ⦃x y : M⦄, C.le ⊤ x y → C.le ⊤ y x → x = y

/-- `defi:convexite_causale`, for an arbitrary subset `V` of the open `U`: "`V` is causally
convex in `U` if for all `p, q ∈ V` the full diamond `J_U(p,q)` is contained in `V`." -/
def CausallyConvexIn (V : Set M) (U : Opens M) : Prop :=
  V ⊆ U ∧ ∀ p ∈ V, ∀ q ∈ V, C.diamond U p q ⊆ V

/-- `def:strongly_causal_spacetime`, *neighbourhood* read as not necessarily open: "for every
`p ∈ M` and every neighbourhood `U` of `p` there exists a neighbourhood `V ⊂ U` of `p` which is
causally convex in `M`." -/
def StronglyCausal : Prop :=
  ∀ (p : M), ∀ U ∈ 𝓝 p, ∃ V ∈ 𝓝 p, V ⊆ U ∧ C.CausallyConvexIn V ⊤

/-- `def:strongly_causal_spacetime`, with `V` open as `defi:convexite_causale` has it. -/
def StronglyCausalOpen : Prop :=
  ∀ (p : M), ∀ U ∈ 𝓝 p, ∃ V : Opens M, p ∈ V ∧ (V : Set M) ⊆ U ∧ C.CausallyConvexIn V ⊤

/-! ### Tarentin spacetimes, open causalities -/

/-- `def:tarentin_spacetime`. "`M` is tarentin if for every `x ∈ M` and every neighbourhood `U`
of `x` there exist `p, q ∈ U` such that `x ∈ Int(J_M(p,q))`." -/
def Tarentin : Prop :=
  ∀ (x : M), ∀ U ∈ 𝓝 x, ∃ p ∈ U, ∃ q ∈ U, x ∈ C.openDiamond ⊤ p q

/-- `def:causally_open_spacetime_open`, as written: "for every open subset `U` of `M` and every
open subset `V ⊂ U` the set `J^+_U(V)` is open." -/
def CausallyOpenFuture : Prop :=
  ∀ U V : Opens M, V ≤ U → IsOpen (C.Jplus U V)

/-- `def:causally_open_spacetime_open`, as written, for the open subset `W` seen as a
spacetime. -/
def CausallyOpenFutureOn (W : Opens M) : Prop :=
  ∀ U V : Opens M, U ≤ W → V ≤ U → IsOpen (C.Jplus U V)

/-- Causal openness in the future and in the past. See the module's SCOPE. -/
def CausallyOpen : Prop :=
  (∀ U V : Opens M, V ≤ U → IsOpen (C.Jplus U V)) ∧
    ∀ U V : Opens M, V ≤ U → IsOpen (C.Jminus U V)

/-- `def:strongly_tarentin_point`. "A point `p ∈ M` is strongly tarentin in the future if for
every neighbourhood `U` of `p` the set `I^+(p) ∩ U` is non-empty"; `Z^+(M)` is the set of such
points. -/
def Zplus : Set M := {p | ∀ U ∈ 𝓝 p, (C.Iplus ⊤ {p} ∩ U).Nonempty}

/-- `def:strongly_tarentin_point`, in the past: `Z^-(M)`. -/
def Zminus : Set M := {p | ∀ U ∈ 𝓝 p, (C.Iminus ⊤ {p} ∩ U).Nonempty}

/-- `def:globally_hyperbolic`. "`M` is globally hyperbolic if `M` is causal and if `J_M(p,q)` is
compact for all `p, q ∈ M`." -/
def GloballyHyperbolic : Prop := C.IsCausal ∧ ∀ p q : M, IsCompact (C.diamond ⊤ p q)

variable {C} {U V : Opens M} {A : Set M} {p q x y z : M}

/-! ### First consequences -/

theorem mem_diamond : x ∈ C.diamond U p q ↔ C.le U p x ∧ C.le U x q := by
  simp [diamond, and_comm]

theorem openDiamond_subset_diamond : C.openDiamond U p q ⊆ C.diamond U p q := interior_subset

theorem isOpen_openDiamond : IsOpen (C.openDiamond U p q) := isOpen_interior

theorem diamond_subset_Jplus : C.diamond U p q ⊆ C.Jplus U {p} := inter_subset_right

theorem diamond_subset_Jminus : C.diamond U p q ⊆ C.Jminus U {q} := inter_subset_left

/-- A diamond with vertices in a diamond is contained in it. -/
theorem diamond_subset_diamond (hp : p ∈ C.diamond U x y) (hq : q ∈ C.diamond U x y) :
    C.diamond U p q ⊆ C.diamond U x y := by
  intro z hz
  rw [mem_diamond] at hp hq hz ⊢
  exact ⟨C.le_trans hp.1 hz.1, C.le_trans hz.2 hq.2⟩

/-- A full diamond is causally convex. -/
theorem causallyConvexIn_diamond : C.CausallyConvexIn (C.diamond U p q) U :=
  ⟨fun _ h => C.le_mem_right (mem_diamond.1 h).1, fun _ ha _ hb => diamond_subset_diamond ha hb⟩

@[simp] theorem dual_diamond : C.dual.diamond U p q = C.diamond U q p := by
  ext z
  rw [mem_diamond, mem_diamond]
  exact and_comm

@[simp] theorem dual_openDiamond : C.dual.openDiamond U p q = C.openDiamond U q p := by
  simp [openDiamond]

@[simp] theorem dual_Zplus : C.dual.Zplus = C.Zminus := rfl

@[simp] theorem dual_Zminus : C.dual.Zminus = C.Zplus := rfl

theorem dual_isCausal : C.dual.IsCausal ↔ C.IsCausal :=
  ⟨fun h _ _ hxy hyx => (h hyx hxy), fun h _ _ hxy hyx => (h hyx hxy)⟩

theorem dual_causallyConvexIn {V : Set M} :
    C.dual.CausallyConvexIn V U ↔ C.CausallyConvexIn V U := by
  refine and_congr Iff.rfl ⟨fun h a ha b hb => ?_, fun h a ha b hb => ?_⟩
  · have := h b hb a ha
    rwa [dual_diamond] at this
  · rw [dual_diamond]
    exact h b hb a ha

theorem dual_stronglyCausal : C.dual.StronglyCausal ↔ C.StronglyCausal := by
  simp only [StronglyCausal, dual_causallyConvexIn]

theorem dual_stronglyCausalOpen : C.dual.StronglyCausalOpen ↔ C.StronglyCausalOpen := by
  simp only [StronglyCausalOpen, dual_causallyConvexIn]

theorem dual_tarentin : C.dual.Tarentin ↔ C.Tarentin := by
  refine ⟨fun h x N hN => ?_, fun h x N hN => ?_⟩
  · obtain ⟨a, ha, b, hb, hx⟩ := h x N hN
    rw [dual_openDiamond] at hx
    exact ⟨b, hb, a, ha, hx⟩
  · obtain ⟨a, ha, b, hb, hx⟩ := h x N hN
    refine ⟨b, hb, a, ha, ?_⟩
    rwa [dual_openDiamond]

theorem dual_globallyHyperbolic : C.dual.GloballyHyperbolic ↔ C.GloballyHyperbolic := by
  refine and_congr dual_isCausal ⟨fun h a b => ?_, fun h a b => ?_⟩
  · have := h b a
    rwa [dual_diamond] at this
  · rw [dual_diamond]
    exact h b a

theorem dual_causallyPlain : C.dual.CausallyPlain ↔ C.CausallyPlain :=
  ⟨fun h U A => (h U A).symm, fun h U A => (h U A).symm⟩

theorem dual_causallyOpen : C.dual.CausallyOpen ↔ C.CausallyOpen :=
  ⟨fun h => h.symm, fun h => h.symm⟩

theorem CausallyOpen.future (h : C.CausallyOpen) : C.CausallyOpenFuture := h.1

theorem causallyPlainOn_top : C.CausallyPlainOn ⊤ ↔ C.CausallyPlain :=
  ⟨fun h U A => h U le_top A, fun h U _ A => h U A⟩

theorem dual_causallyPlainOn {W : Opens M} : C.dual.CausallyPlainOn W ↔ C.CausallyPlainOn W :=
  ⟨fun h U hU A => (h U hU A).symm, fun h U hU A => (h U hU A).symm⟩

theorem causallyOpenFutureOn_top : C.CausallyOpenFutureOn ⊤ ↔ C.CausallyOpenFuture :=
  ⟨fun h U V hVU => h U V le_top hVU, fun h U V _ hVU => h U V hVU⟩

theorem causallyOpen_iff :
    C.CausallyOpen ↔ C.CausallyOpenFuture ∧ C.dual.CausallyOpenFuture := Iff.rfl

/-- The open form of strong causality implies the neighbourhood form. -/
theorem StronglyCausalOpen.stronglyCausal (h : C.StronglyCausalOpen) : C.StronglyCausal := by
  intro p N hN
  obtain ⟨V, hpV, hVN, hV⟩ := h p N hN
  exact ⟨V, V.isOpen.mem_nhds hpV, hVN, hV⟩

/-- `defi:causalement_plat`, the "equivalently": every non-empty open subset of `J^±_U(A)`
meets `I^±_U(A)`. -/
theorem causallyPlain_iff :
    C.CausallyPlain ↔ ∀ (U : Opens M) (A : Set M) (O : Set M), IsOpen O → O.Nonempty →
      (O ⊆ C.Jplus U A → (O ∩ C.Iplus U A).Nonempty) ∧
      (O ⊆ C.Jminus U A → (O ∩ C.Iminus U A).Nonempty) := by
  constructor
  · intro h U A O hO hne
    obtain ⟨x, hx⟩ := hne
    refine ⟨fun hOJ => ?_, fun hOJ => ?_⟩
    · have hx' : x ∈ closure (C.Iplus U A) := (h U A).1 (interior_maximal hOJ hO hx)
      exact mem_closure_iff.1 hx' O hO hx
    · have hx' : x ∈ closure (C.Iminus U A) := (h U A).2 (interior_maximal hOJ hO hx)
      exact mem_closure_iff.1 hx' O hO hx
  · intro h U A
    refine ⟨fun x hx => ?_, fun x hx => ?_⟩
    · rw [mem_closure_iff]
      intro O hO hxO
      have := (h U A (O ∩ interior (C.Jplus U A)) (hO.inter isOpen_interior) ⟨x, hxO, hx⟩).1
        (inter_subset_right.trans interior_subset)
      obtain ⟨y, ⟨hyO, _⟩, hyI⟩ := this
      exact ⟨y, hyO, hyI⟩
    · rw [mem_closure_iff]
      intro O hO hxO
      have := (h U A (O ∩ interior (C.Jminus U A)) (hO.inter isOpen_interior) ⟨x, hxO, hx⟩).2
        (inter_subset_right.trans interior_subset)
      obtain ⟨y, ⟨hyO, _⟩, hyI⟩ := this
      exact ⟨y, hyO, hyI⟩

/-- `defi:pushup`, the "equivalently": "concatenating a causal relation with a chronological one
produces a chronological one." -/
theorem pushUp_iff :
    C.PushUp ↔ ∀ (U : Opens M) ⦃x y z : M⦄,
      (C.lt U x y → C.le U y z → C.lt U x z) ∧ (C.le U x y → C.lt U y z → C.lt U x z) := by
  constructor
  · intro h U x y z
    refine ⟨fun hxy hyz => ?_, fun hxy hyz => ?_⟩
    · have := (h U x).1.1 ⟨y, by simpa using hxy, hyz⟩
      simpa using this
    · have := (h U z).1.2 ⟨y, by simpa using hyz, hxy⟩
      simpa using this
  · intro h U x
    refine ⟨⟨?_, ?_⟩, ?_, ?_⟩
    · rintro z ⟨y, hy, hyz⟩
      have hxy : C.lt U x y := by simpa using hy
      simpa using (h U).1 hxy hyz
    · rintro z ⟨y, hy, hzy⟩
      have hyx : C.lt U y x := by simpa using hy
      simpa using (h U).2 hzy hyx
    · rintro z ⟨y, hy, hyz⟩
      have hxy : C.le U x y := by simpa using hy
      simpa using (h U).2 hxy hyz
    · rintro z ⟨y, hy, hzy⟩
      have hyx : C.le U y x := by simpa using hy
      simpa using (h U).1 hzy hyx

theorem mem_Zplus : p ∈ C.Zplus ↔ ∀ N ∈ 𝓝 p, (C.Iplus ⊤ {p} ∩ N).Nonempty := Iff.rfl

theorem mem_Zminus : p ∈ C.Zminus ↔ ∀ N ∈ 𝓝 p, (C.Iminus ⊤ {p} ∩ N).Nonempty := Iff.rfl

/-- A point strongly tarentin in the future has a non-empty chronological future. -/
theorem Iplus_nonempty_of_mem_Zplus (h : p ∈ C.Zplus) : (C.Iplus ⊤ {p}).Nonempty := by
  obtain ⟨y, hy, _⟩ := h univ Filter.univ_mem
  exact ⟨y, hy⟩

theorem Iminus_nonempty_of_mem_Zminus (h : p ∈ C.Zminus) : (C.Iminus ⊤ {p}).Nonempty := by
  obtain ⟨y, hy, _⟩ := h univ Filter.univ_mem
  exact ⟨y, hy⟩

end Causality

end Causal
