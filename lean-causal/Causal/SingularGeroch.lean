namespace Causal

open Set TopologicalSpace Topology Filter MeasureTheory

universe u

variable {M : Type u} [TopologicalSpace M]

namespace Causality

variable {C : Causality M} {sing : ℝ → Set M} {p : M}

/-! ### `def:singular_spacetime`, abstracted -/

/-- `def:singular_spacetime`, abstracted: the facts of an `E_{≥0}`-manifold
(`SingularFlatAxioms`) on a connected space. -/
structure SingularFlatSpacetime (C : Causality M) (sing : ℝ → Set M) : Prop
    extends SingularFlatAxioms C sing where
  /-- "A connected `E^{1,2}_A`-manifold". -/
  connected : ConnectedSpace M

/-! ### The flow of `lem:vecteur`, a hypothesis -/

/-- **The flow of the vector field `X` of `lem:vecteur`** (`ETT.tex:1751–1769`), with what the
proof of `theo:geroch_sing` asserts of it (`ETT.tex:1787–1796`), a named hypothesis (kb/0012):
the library has no differentiable structure. -/
structure VecteurFlow (C : Causality M) where
  /-- The flow `Φ` of `X`, complete ("up to multiplying it by a positive scalar field"). -/
  flow : M → ℝ → M
  continuous_flow : Continuous fun q : M × ℝ => flow q.1 q.2
  flow_zero : ∀ x, flow x 0 = x
  flow_add : ∀ x s t, flow (flow x s) t = flow x (s + t)
  /-- "`X` is causal, so the curves `c_x` are inextensible causal curves". -/
  inextensible : ∀ x, C.Inextensible ⊤ univ (flow x)
  /-- On a causal `M`, no orbit returns to any point (each `flow x` is injective): `X` is
  non-singular, so an orbit with `flow x s = flow x t`, `s ≠ t`, is a closed causal curve, which
  causality excludes. Nothing here concerns `Σ`; without causality the property may fail
  (`E_α` modulo a translation along its singular line, `CausalScaffold.SingularGeroch`, SCOPE). -/
  injective : C.IsCausal → ∀ x, Function.Injective (flow x)
  /-- "Since `X` is non-singular, `ψ` is a local diffeomorphism", for a Cauchy surface `Σ`: its
  `C⁰` content used, `ψ : Σ × ℝ → M` open. -/
  isOpenMap : ∀ S : Set M, C.IsCauchySurface S → IsOpenMap fun q : S × ℝ => flow q.1 q.2

/-! ### The local measures, a hypothesis -/

/-- The model fact behind hypothesis (i) of `prop:mesure_dieckmann_topo` in the proof of
`prop:mesure_admissible` (`ETT.tex:1736–1745`): every point has an open neighbourhood, causally
convex in `M` (inside a chart, by strong causality), carrying a measure admissible in the past
(`λ₃` on `E_κ`, `κ > 0`; `λ₃ + λ₁` on `E_0`) and one admissible in the future (`λ₃`). -/
structure ModelMeasures [MeasurableSpace M] (C : Causality M) : Prop where
  past : ∀ p : M, ∃ U : Opens M, p ∈ U ∧ C.CausallyConvexIn (U : Set M) ⊤ ∧
    ∃ ν : Measure M, C.AdmissiblePastOn U ν
  future : ∀ p : M, ∃ U : Opens M, p ∈ U ∧ C.CausallyConvexIn (U : Set M) ⊤ ∧
    ∃ ν : Measure M, C.AdmissibleFutureOn U ν

namespace SingularFlatAxioms

/-! ### `prop:mesure_admissible` -/

/-- `prop:mesure_admissible`: a causal `E_{≥0}`-manifold (⚠ weakened from strongly causal, whose
other use, causally convex charts, `ModelMeasures` carries) carries a measure admissible in the
past and one admissible in the future, by `prop:mesure_dieckmann_topo`, its hypothesis (ii) being
`prop:K_monotone`. -/
theorem mesure_admissible [MeasurableSpace M] [BorelSpace M] (h : C.SingularFlatAxioms sing)
    (hc : C.IsCausal) (hM : C.ModelMeasures) :
    (∃ μ : Measure M, C.AdmissiblePast μ) ∧ ∃ μ : Measure M, C.AdmissibleFuture μ := by
  haveI := h.t2
  haveI := h.secondCountable
  exact ⟨exists_admissiblePast_of_local h.causallyArcConnected hM.past
      fun _ _ hqp => (h.K_monotone hc hqp).1,
    exists_admissibleFuture_of_local h.causallyArcConnected hM.future
      fun _ _ hpq => (h.K_monotone hc hpq).2⟩

/-! ### `J^±(p) ≠ {p}` -/

/-- A non-empty open set inside `{p}` makes `p` isolated. -/
theorem not_open_subset_singleton (h : C.SingularFlatAxioms sing) {O : Set M} (hO : IsOpen O)
    (hne : O.Nonempty) (hsub : O ⊆ {p}) : False := by
  have hOp : O = {p} := (subset_singleton_iff_eq.1 hsub).resolve_left hne.ne_empty
  rw [hOp] at hO
  exact (NeBot.ne (h.noIsolated p)) ((isOpen_singleton_iff_punctured_nhds p).1 hO)

/-- `J^+(p) ≠ {p}` for every point of an `E_{≥0}`-manifold. -/
theorem Jplus_ne_singleton (h : C.SingularFlatAxioms sing) (p : M) :
    C.Jplus ⊤ {p} ≠ {p} := by
  intro hJ
  exact h.not_open_subset_singleton isOpen_Iplus (Iplus_nonempty_of_mem_Zplus (h.mem_Zplus p))
    (hJ ▸ Iplus_subset_Jplus)

/-- `J^-(p) ≠ {p}` for every point of an `E_{≥0}`-manifold. -/
theorem Jminus_ne_singleton (h : C.SingularFlatAxioms sing) (p : M) :
    C.Jminus ⊤ {p} ≠ {p} := by
  intro hJ
  by_cases hp : p ∈ sing 0
  · obtain ⟨⟨u, -, hup⟩, -⟩ := h.singularPastAt p hp
    have : u 0 ∈ C.Jminus ⊤ {p} := by simpa using (hup 0).1
    rw [hJ] at this
    exact (hup 0).2 this
  · exact h.not_open_subset_singleton isOpen_Iminus
      (Iminus_nonempty_of_mem_Zminus ((h.mem_Zminus_iff p).2 hp)) (hJ ▸ Iminus_subset_Jminus)

/-! ### `rem:singular_flat_spacetime_therefore` -/

/-- `rem:singular_flat_spacetime_therefore`, what the class gives without any added hypothesis:
every hypothesis of `theo:geroch` except local causal convexity and the pair of measures. -/
theorem geroch_hypotheses_of_singularFlat (h : C.SingularFlatAxioms sing) :
    MetrizableSpace M ∧ LocallyCompactSpace M ∧ C.Tarentin ∧ C.CausallyArcConnected ∧
      (∀ p : M, C.Jminus ⊤ {p} ≠ {p}) ∧ ∀ p : M, C.Jplus ⊤ {p} ≠ {p} :=
  ⟨h.metrizable, h.locallyCompact, h.tarentin, h.causallyArcConnected, h.Jminus_ne_singleton,
    h.Jplus_ne_singleton⟩

/-- **`rem:singular_flat_spacetime_therefore`** — its principal statement: a strongly causal
singular flat spacetime (strong causality assumed, as the author ruled, DEC-18) with the model
measures (⚠ strengthened: `ModelMeasures`) satisfies every hypothesis of `theo:geroch`. -/
theorem geroch_hypotheses [MeasurableSpace M] [BorelSpace M] (h : C.SingularFlatAxioms sing)
    (hSC : C.StronglyCausal) (hM : C.ModelMeasures) :
    MetrizableSpace M ∧ LocallyCompactSpace M ∧ C.Tarentin ∧ C.CausallyArcConnected ∧
      C.StronglyCausal ∧ (∀ p : M, C.Jminus ⊤ {p} ≠ {p}) ∧ (∀ p : M, C.Jplus ⊤ {p} ≠ {p}) ∧
      ∃ μp μm : Measure M, C.AdmissibleFuture μp ∧ C.AdmissiblePast μm := by
  haveI := h.t2
  obtain ⟨⟨μm, hμm⟩, ⟨μp, hμp⟩⟩ := h.mesure_admissible hSC.isCausal hM
  exact ⟨h.metrizable, h.locallyCompact, h.tarentin, h.causallyArcConnected, hSC,
    h.Jminus_ne_singleton, h.Jplus_ne_singleton, μp, μm, hμp, hμm⟩

/-! ### `theo:geroch_sing` -/

/-- `theo:geroch_sing`, (i)⇒(ii) (DEC-15): no hypothesis beyond the structure and the model
measures — global hyperbolicity gives strong causality. -/
theorem geroch_sing_i_imp_ii [MeasurableSpace M] [BorelSpace M] (h : C.SingularFlatAxioms sing)
    (hM : C.ModelMeasures) (hG : C.GloballyHyperbolic) :
    ∃ T : M → ℝ, C.IsCauchyTimeFunction T ∧ ∀ x y, C.le ⊤ x y → x ≠ y → T x < T y := by
  haveI := h.t2
  haveI := h.secondCountable
  obtain ⟨⟨μm, hμm⟩, ⟨μp, hμp⟩⟩ := h.mesure_admissible hG.1 hM
  exact geroch_i_imp_ii hμp hμm h.tarentin h.causallyArcConnected h.Jminus_ne_singleton
    h.Jplus_ne_singleton hG

/-- `theo:geroch_sing`, (i)⇒(iii). -/
theorem geroch_sing_i_imp_iii [MeasurableSpace M] [BorelSpace M] (h : C.SingularFlatAxioms sing)
    (hM : C.ModelMeasures) (hG : C.GloballyHyperbolic) : ∃ S : Set M, C.IsCauchySurface S := by
  haveI := h.t2
  haveI := h.secondCountable
  obtain ⟨⟨μm, hμm⟩, ⟨μp, hμp⟩⟩ := h.mesure_admissible hG.1 hM
  exact ⟨_, geroch_i_imp_iii hμp hμm h.tarentin h.causallyArcConnected h.Jminus_ne_singleton
    h.Jplus_ne_singleton hG⟩

/-- `theo:geroch_sing`, the splitting: a causal singular flat spacetime with a Cauchy surface `Σ`
is homeomorphic to `Σ × ℝ`, given the flow of `lem:vecteur` (⚠ strengthened: `VecteurFlow C`, a
named hypothesis; the structure itself is not used; ⚠ weakened: causal, where DEC-18 makes `M`
strongly causal). The paper's proof (`ETT.tex:1787–1796`): `ψ (x, t) = Φ (x, t)` is open
(asserted, l.1792: `VecteurFlow.isOpenMap`), its orbits meet `Σ` exactly once, so it is
bijective; the bijectivity is what is proved here. -/
theorem geroch_sing_split (_h : C.SingularFlatSpacetime sing) (hc : C.IsCausal)
    (F : C.VecteurFlow) {S : Set M} (hS : C.IsCauchySurface S) : Nonempty (S × ℝ ≃ₜ M) := by
  have hcont : Continuous fun q : S × ℝ => F.flow q.1 q.2 :=
    F.continuous_flow.comp ((continuous_subtype_val.comp continuous_fst).prodMk continuous_snd)
  -- an orbit meets `S` at one point only
  have huniq : ∀ (x : M) (a b : ℝ), F.flow x a ∈ S → F.flow x b ∈ S →
      F.flow x a = F.flow x b := by
    intro x a b ha hb
    obtain ⟨z, -, hz⟩ := hS univ (F.flow x) (F.inextensible x)
    exact (hz _ ⟨⟨a, trivial, rfl⟩, ha⟩).trans (hz _ ⟨⟨b, trivial, rfl⟩, hb⟩).symm
  have hinj : Function.Injective fun q : S × ℝ => F.flow q.1 q.2 := by
    rintro ⟨⟨x, hx⟩, t⟩ ⟨⟨y, hy⟩, s⟩ hxy
    have hxy' : F.flow x t = F.flow y s := hxy
    have hx' : F.flow y (s + -t) = x := by
      rw [← F.flow_add, ← hxy', F.flow_add, add_neg_cancel, F.flow_zero]
    have hyx : x = y := by
      have := huniq y (s + -t) 0 (by rw [hx']; exact hx) (by rw [F.flow_zero]; exact hy)
      rwa [hx', F.flow_zero] at this
    subst hyx
    have hts : t = s := F.injective hc x hxy'
    subst hts
    rfl
  have hsurj : Function.Surjective fun q : S × ℝ => F.flow q.1 q.2 := by
    intro m
    obtain ⟨z, ⟨⟨r, -, rfl⟩, hz⟩, -⟩ := hS univ (F.flow m) (F.inextensible m)
    refine ⟨(⟨F.flow m r, hz⟩, -r), ?_⟩
    change F.flow (F.flow m r) (-r) = m
    rw [F.flow_add, add_neg_cancel, F.flow_zero]
  exact ⟨(Equiv.ofBijective _ ⟨hinj, hsurj⟩).toHomeomorphOfContinuousOpen hcont
    (F.isOpenMap S hS)⟩

end SingularFlatAxioms

/-! ### The paper's form of `lem:cup_cap_BTZ`, as a `Prop` -/

/-- `lem:cup_cap_BTZ` **as printed** (`ETT.tex:1825–1833`), for the data `(C, sing)`: if `M` is a
strongly causal singular flat spacetime, then for every BTZ point `p` and every sequence `p_n → p`
with `p ∉ J^-(p_n)`, `⋃_N ⋂_{n ≥ N} J^-(p_n) = J^-(p) ∖ {p}`. A definition, not a theorem: it is
false for some strongly causal singular flat spacetime. **Finding** (formalized:
`Causal.CupCapBTZCounterexample.not_cupCapBTZAsPrinted`): in `E_0 ∖ {w}`, `w` a point of the BTZ line below
`p` and `z` a point of that line below `w`, `z ≪ p_n` for regular `p_n → p` with
`p ∉ J^-(p_n)` (a chronal curve from a BTZ point leaves the line at once and avoids `w`), while
`J^-(p) = ]w, p]`, so `z` is in the left side and not the right one; granted that `E_0` is
strongly causal and `p ∈ Int J^+(z)` (as the proof of `prop:K_calcul` (c) uses). The `⊇` half
holds with no hypothesis on `M` (`SingularPastAt.Jminus_diff_subset_iUnion_iInter`); the whole
holds when causal futures are closed (`cup_cap_BTZ_of_isClosed`), hence under global
hyperbolicity (`cupCapBTZAsPrinted_of_globallyHyperbolic`), the setting of its one use
(l.2122). The author ruled (DEC-19) that `lem:cup_cap_BTZ` is stated for globally hyperbolic `M`:
this `Prop` is the printed form, kept with the finding, not the lemma. -/
def CupCapBTZAsPrinted (C : Causality M) (sing : ℝ → Set M) : Prop :=
  C.SingularFlatSpacetime sing → C.StronglyCausal → ∀ p ∈ sing 0, ∀ u : ℕ → M,
    Tendsto u atTop (𝓝 p) → (∀ n, ¬ C.le ⊤ p (u n)) →
      ⋃ N : ℕ, ⋂ n ≥ N, C.Jminus ⊤ {u n} = C.Jminus ⊤ {p} \ {p}

/-- **`lem:cup_cap_BTZ`** as the author ruled it (DEC-19), for globally hyperbolic `M`: its
certificate (the printed form's strong causality is then redundant). Rests on
`SingularFlatAxioms.cup_cap_BTZ` (`Causal.SingularFlat`); the model facts are fields. -/
theorem cupCapBTZAsPrinted_of_globallyHyperbolic (hG : C.GloballyHyperbolic) :
    C.CupCapBTZAsPrinted sing := fun h _ _ hp _ hu hpu =>
  h.toSingularFlatAxioms.cup_cap_BTZ hG hp hu hpu

end Causality

/-! ### Satisfiability -/

section Witness

open Causality

/-- **Witness.** The timelike line is a singular flat spacetime of the abstract class. -/
theorem timelikeLine_singularFlatSpacetime :
    timelikeLine.SingularFlatSpacetime (fun _ => ∅) :=
  { timelikeLine_singularFlatAxioms with connected := inferInstance }

/-- **Witness.** `ModelMeasures` holds on the timelike line: the chart `ℝ`, with the standard
Gaussian measure, admissible in the past and in the future. -/
theorem timelikeLine_modelMeasures : timelikeLine.ModelMeasures :=
  ⟨fun _ => ⟨⊤, trivial, ⟨fun _ _ => trivial, fun _ _ _ _ _ _ => trivial⟩,
      ProbabilityTheory.gaussianReal 0 1,
      admissiblePastOn_top.2 timelikeLine_admissible_past_and_future.1⟩,
    fun _ => ⟨⊤, trivial, ⟨fun _ _ => trivial, fun _ _ _ _ _ _ => trivial⟩,
      ProbabilityTheory.gaussianReal 0 1,
      admissibleFutureOn_top.2 timelikeLine_admissible_past_and_future.2⟩⟩

/-- **Witness of `mesure_admissible`**: its hypotheses hold on the timelike line. -/
theorem timelikeLine_mesure_admissible :
    (∃ μ : Measure ℝ, timelikeLine.AdmissiblePast μ) ∧
      ∃ μ : Measure ℝ, timelikeLine.AdmissibleFuture μ :=
  timelikeLine_singularFlatAxioms.mesure_admissible timelikeLine_stronglyCausal.isCausal
    timelikeLine_modelMeasures

/-- **Witness of `geroch_hypotheses`**. -/
theorem timelikeLine_geroch_hypotheses :
    MetrizableSpace ℝ ∧ LocallyCompactSpace ℝ ∧ timelikeLine.Tarentin ∧
      timelikeLine.CausallyArcConnected ∧ timelikeLine.StronglyCausal ∧
      (∀ p : ℝ, timelikeLine.Jminus ⊤ {p} ≠ {p}) ∧ (∀ p : ℝ, timelikeLine.Jplus ⊤ {p} ≠ {p}) ∧
      ∃ μp μm : Measure ℝ, timelikeLine.AdmissibleFuture μp ∧ timelikeLine.AdmissiblePast μm :=
  timelikeLine_singularFlatAxioms.geroch_hypotheses timelikeLine_stronglyCausal
    timelikeLine_modelMeasures

/-- **Witness of `geroch_sing_i_imp_ii`**. -/
theorem timelikeLine_geroch_sing_i_imp_ii :
    ∃ T : ℝ → ℝ, timelikeLine.IsCauchyTimeFunction T ∧
      ∀ x y, timelikeLine.le ⊤ x y → x ≠ y → T x < T y :=
  timelikeLine_singularFlatAxioms.geroch_sing_i_imp_ii timelikeLine_modelMeasures
    timelikeLine_globallyHyperbolic

/-- **Witness of `geroch_sing_i_imp_iii`**. -/
theorem timelikeLine_geroch_sing_i_imp_iii : ∃ S : Set ℝ, timelikeLine.IsCauchySurface S :=
  timelikeLine_singularFlatAxioms.geroch_sing_i_imp_iii timelikeLine_modelMeasures
    timelikeLine_globallyHyperbolic

/-- `t ↦ p + t` is an inextensible causal curve of the timelike line. -/
theorem timelikeLine_inextensible_add (p : ℝ) :
    timelikeLine.Inextensible ⊤ univ (fun t => p + t) :=
  ⟨⟨⟨0, trivial⟩, ordConnected_univ, fun a _ b _ => timelikeLine_causalCurveOn_of_monotone
      (fun _ _ h => by simpa using h) (continuous_const.add continuous_id) a b⟩,
    fun ⟨_, c', _, _, ⟨t', _, hgrow⟩⟩ => hgrow (c' t' - p) trivial (by ring)⟩

/-- **Witness of `VecteurFlow`**: on the timelike line, the flow `(x, t) ↦ x + t` of `∂_t`. -/
def timelikeLine_vecteurFlow : timelikeLine.VecteurFlow where
  flow x t := x + t
  continuous_flow := continuous_fst.add continuous_snd
  flow_zero x := add_zero x
  flow_add x s t := add_assoc x s t
  inextensible x := timelikeLine_inextensible_add x
  injective _ x := add_right_injective x
  isOpenMap S _ := by
    let e : S × ℝ ≃ₜ S × ℝ :=
      { toFun := fun q => (q.1, (q.1 : ℝ) + q.2)
        invFun := fun q => (q.1, q.2 - q.1)
        left_inv := fun q => by simp
        right_inv := fun q => by simp
        continuous_toFun := by fun_prop
        continuous_invFun := by fun_prop }
    exact isOpenMap_snd.comp e.isOpenMap

/-- **Witness of `geroch_sing_split`**: on the timelike line, with the Cauchy surface `{0}`. -/
theorem timelikeLine_geroch_sing_split : Nonempty (({0} : Set ℝ) × ℝ ≃ₜ ℝ) :=
  SingularFlatAxioms.geroch_sing_split timelikeLine_singularFlatSpacetime
    timelikeLine_stronglyCausal.isCausal timelikeLine_vecteurFlow timelikeLine_isCauchySurface_zero

/-- **Witness of `cupCapBTZAsPrinted_of_globallyHyperbolic`** (vacuous: no BTZ point). -/
theorem timelikeLine_cupCapBTZAsPrinted : timelikeLine.CupCapBTZAsPrinted (fun _ => ∅) :=
  cupCapBTZAsPrinted_of_globallyHyperbolic timelikeLine_globallyHyperbolic

/-- **Sanity of `geroch_sing_split`'s hypotheses**: on the timelike line `{0}` is a Cauchy
surface, and `{0} × ℝ ≃ₜ ℝ` holds directly, not through `geroch_sing_split`. -/
theorem timelikeLine_split_zero :
    timelikeLine.IsCauchySurface ({0} : Set ℝ) ∧ Nonempty (({0} : Set ℝ) × ℝ ≃ₜ ℝ) :=
  ⟨timelikeLine_isCauchySurface_zero,
    ⟨(Homeomorph.prodCongr (Homeomorph.homeomorphOfUnique ({0} : Set ℝ) PUnit.{1}) (Homeomorph.refl ℝ)).trans
      (Homeomorph.punitProd.{0, 0} ℝ)⟩⟩

