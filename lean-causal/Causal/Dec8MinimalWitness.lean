namespace Causal

open Set TopologicalSpace Topology

/-- **The half-lit line**: on `ℝ`, `x ≤_U y` iff `x = y ∈ U`, or `0 ≤ x ≤ y` and `[x, y] ⊆ U`;
no chronology. The spacelike line below `0`, the lightlike line from `0` on; the half-line variant
of `rationalLine` with every point of `[0, ∞)` in place of the rationals. -/
def halfLightLine : Causality ℝ where
  le U x y := (x = y ∧ x ∈ U) ∨ (0 ≤ x ∧ x ≤ y ∧ Icc x y ⊆ (U : Set ℝ))
  lt _ _ _ := False
  le_mem_left h := h.elim (fun h => h.2) fun h => h.2.2 (left_mem_Icc.2 h.2.1)
  le_mem_right h := h.elim (fun h => h.1 ▸ h.2) fun h => h.2.2 (right_mem_Icc.2 h.2.1)
  lt_mem_left h := h.elim
  lt_mem_right h := h.elim
  le_refl hx := Or.inl ⟨rfl, hx⟩
  le_trans h₁ h₂ := by
    rcases h₁ with ⟨rfl, -⟩ | ⟨h0, h1, h3⟩
    · exact h₂
    rcases h₂ with ⟨rfl, -⟩ | ⟨-, h1', h3'⟩
    · exact Or.inr ⟨h0, h1, h3⟩
    · exact Or.inr ⟨h0, h1.trans h1', Icc_subset_Icc_union_Icc.trans (union_subset h3 h3')⟩
  lt_trans h _ := h
  le_mono h _ _ h' := h'.elim (fun h' => Or.inl ⟨h'.1, h h'.2⟩)
    fun h' => Or.inr ⟨h'.1, h'.2.1, fun _ hz => h (h'.2.2 hz)⟩
  lt_mono _ _ _ h' := h'
  le_of_lt h := h.elim
  isOpen_lt_right _ _ := by simp
  isOpen_lt_left _ _ := by simp

theorem halfLightLine_le {U : Opens ℝ} {x y : ℝ} :
    halfLightLine.le U x y ↔ (x = y ∧ x ∈ U) ∨ (0 ≤ x ∧ x ≤ y ∧ Icc x y ⊆ (U : Set ℝ)) :=
  Iff.rfl

/-- Below `0` the order is the diagonal. -/
theorem halfLightLine_le_of_neg {U : Opens ℝ} {x y : ℝ} (hx : x < 0) :
    halfLightLine.le U x y ↔ x = y ∧ x ∈ U :=
  ⟨fun h => h.elim id fun h => absurd h.1 (not_le.2 hx), Or.inl⟩

/-- Along `≤` the real order increases. -/
theorem halfLightLine_le_real {U : Opens ℝ} {x y : ℝ} (h : halfLightLine.le U x y) : x ≤ y :=
  h.elim (fun h => h.1.le) fun h => h.2.1

/-! ## Causal arc-connectedness and absolute minimality -/

/-- From a point of `[0, ∞)`, the affine map to a later point is a future causal curve of every open
set containing the segment (the timelike line's chronal curve, `timelikeLine_chronalCurveOn_affine`). -/
theorem halfLightLine_causalCurveOn_affine {U : Opens ℝ} {p q : ℝ} (hp : 0 ≤ p) (hpq : p < q)
    (hsub : Icc p q ⊆ (U : Set ℝ)) :
    halfLightLine.CausalCurveOn U (fun t => p + t * (q - p)) 0 1 where
  mem t ht := hsub ⟨by nlinarith [ht.1], by nlinarith [ht.2]⟩
  rel t ht N hN htN := by
    obtain ⟨l, u, hl, hu, hrel⟩ :=
      (timelikeLine_chronalCurveOn_affine hpq hsub).rel t ht N hN htN
    refine ⟨l, u, hl, hu, fun s hs s' hs' h1 h2 h3 => ?_⟩
    obtain ⟨hlt, hI⟩ := hrel s hs s' hs' h1 h2 h3
    exact Or.inr ⟨by nlinarith [hs.1], hlt.le, hI⟩

/-- **The half-lit line is causally arc-connected** (`def:causal_arc_connectedness`): `x ≤_U y` is
realised by the constant curve when `x = y`, by the affine curve when `0 ≤ x < y`. -/
theorem halfLightLine_causallyArcConnected : halfLightLine.CausallyArcConnected := by
  rw [Causality.CausallyArcConnected, Causality.causallyArcConnectedOn_iff]
  intro U _ p q
  refine ⟨fun hpq => ?_, fun h => False.elim h⟩
  rcases hpq with ⟨rfl, hp⟩ | ⟨h0, hpq, hsub⟩
  · exact ⟨fun _ => p, Causality.causalCurveOn_const hp, rfl, rfl⟩
  rcases hpq.eq_or_lt with h | h
  · subst h
    exact ⟨fun _ => p, Causality.causalCurveOn_const (hsub (left_mem_Icc.2 le_rfl)), rfl, rfl⟩
  · exact ⟨_, halfLightLine_causalCurveOn_affine h0 h hsub, by simp, by simp⟩

/-- **The half-lit line is absolutely minimal** (`cor:causalement_connexe_minimal`). -/
theorem halfLightLine_absolutelyMinimal : halfLightLine.AbsolutelyMinimal :=
  halfLightLine_causallyArcConnected.absolutelyMinimal

/-- Every open subset is causally arc-connected (`rem:cac_local`). -/
theorem halfLightLine_causallyArcConnectedOn (W : Opens ℝ) :
    halfLightLine.CausallyArcConnectedOn W :=
  Causality.CausallyArcConnectedOn.mono halfLightLine_causallyArcConnected le_top

/-- **Absolutely minimal on every open set, for every cover of it**: on every open `W` the relations
are generated by the restrictions to any open cover of `W` — the gluing reading of
`defi:causalite` (OQ-18), not only the library's. -/
theorem halfLightLine_absolutelyMinimalOn (W : Opens ℝ) : halfLightLine.AbsolutelyMinimalOn W :=
  (halfLightLine_causallyArcConnectedOn W).absolutelyMinimalOn

/-! ## Causal openness: in the future, not in the past -/

/-- **The half-lit line is causally open in the future** (`def:causally_open_spacetime_open` as
printed): `J⁺_U(V)` is `V` together with the points `y` above some `x ∈ V ∩ [0, ∞)` with
`[x, y] ⊆ U`, and such a `y > x` keeps a neighbourhood above `x` inside `U`. -/
theorem halfLightLine_causallyOpenFuture : halfLightLine.CausallyOpenFuture := by
  intro U V hVU
  rw [isOpen_iff_mem_nhds]
  rintro y ⟨x, hx, hxy⟩
  have hV : (V : Set ℝ) ∈ 𝓝 x := V.isOpen.mem_nhds hx
  have hVJ : (V : Set ℝ) ⊆ halfLightLine.Jplus U V :=
    Precausality.subset_Jplus fun _ hz => hVU hz
  rcases hxy with ⟨rfl, -⟩ | ⟨h0, hxy, hsub⟩
  · exact Filter.mem_of_superset hV hVJ
  rcases hxy.eq_or_lt with rfl | hlt
  · exact Filter.mem_of_superset hV hVJ
  -- `x < y`: every point of `(max l x, u)` lies above `x`, with the segment in `U`
  obtain ⟨l, u, ⟨hl, hu⟩, hlu⟩ :=
    mem_nhds_iff_exists_Ioo_subset.1 (U.isOpen.mem_nhds (hsub (right_mem_Icc.2 hlt.le)))
  refine Filter.mem_of_superset (Ioo_mem_nhds (max_lt hl hlt) hu) ?_
  rintro z ⟨hz1, hz2⟩
  refine ⟨x, hx, Or.inr ⟨h0, (le_max_right _ _).trans hz1.le, fun w hw => ?_⟩⟩
  rcases le_or_gt w y with hwy | hwy
  · exact hsub ⟨hw.1, hwy⟩
  · exact hlu ⟨hl.trans hwy, hw.2.trans_lt hz2⟩

/-- **`J⁻_M((1, 2)) = [0, 2)`**: every point of `[0, 2)` lies below a point of `(1, 2)`, and no
negative point lies below anything but itself. -/
theorem halfLightLine_Jminus_Ioo : halfLightLine.Jminus ⊤ (Ioo 1 2) = Ico 0 2 := by
  ext y
  constructor
  · rintro ⟨x, hx, hyx⟩
    rcases hyx with ⟨rfl, -⟩ | ⟨h0, hyx, -⟩
    · exact ⟨by linarith [hx.1], hx.2⟩
    · exact ⟨h0, hyx.trans_lt hx.2⟩
  · rintro ⟨h0, h2⟩
    refine ⟨(max y 1 + 2) / 2, ⟨?_, ?_⟩, Or.inr ⟨h0, ?_, fun _ _ => trivial⟩⟩
    · linarith [le_max_right y 1]
    · linarith [max_lt h2 (show (1 : ℝ) < 2 by norm_num)]
    · linarith [le_max_left y 1, max_lt h2 (show (1 : ℝ) < 2 by norm_num)]

/-- `J⁻_M((1, 2))` is not open: `0` is in it, no negative point is. -/
theorem halfLightLine_not_isOpen_Jminus_Ioo : ¬ IsOpen (halfLightLine.Jminus ⊤ (Ioo 1 2)) := by
  rw [halfLightLine_Jminus_Ioo]
  intro h
  obtain ⟨l, u, ⟨hl, hu⟩, hlu⟩ :=
    mem_nhds_iff_exists_Ioo_subset.1 (h.mem_nhds (show (0 : ℝ) ∈ Ico 0 2 by norm_num))
  have := (hlu ⟨by linarith, by linarith⟩ : l / 2 ∈ Ico (0 : ℝ) 2).1
  linarith

/-- **The half-lit line is not causally open in the past**. -/
theorem halfLightLine_not_causallyOpenPast : ¬ halfLightLine.dual.CausallyOpenFuture := fun h =>
  halfLightLine_not_isOpen_Jminus_Ioo (h ⊤ ⟨Ioo 1 2, isOpen_Ioo⟩ le_top)

/-- **The half-lit line is not causally open** in DEC-8's two-sided reading (`causally_open`). -/
theorem halfLightLine_not_causallyOpen : ¬ halfLightLine.CausallyOpen := fun h =>
  halfLightLine_not_isOpen_Jminus_Ioo (h.2 ⊤ ⟨Ioo 1 2, isOpen_Ioo⟩ le_top)

/-- Locally causally open in the future (`locally_causally_open_future`), being so globally. -/
theorem halfLightLine_locallyCausallyOpenFuture : halfLightLine.LocallyCausallyOpenFuture :=
  halfLightLine_causallyOpenFuture.locallyCausallyOpenFuture

/-- **No open set containing `0` is causally open in the past**: in `W ∋ 0`, `J⁻_W((0, u))`
contains `0` and no negative point. -/
theorem halfLightLine_not_causallyOpenPastOn_of_zero_mem {W : Opens ℝ} (hW : (0 : ℝ) ∈ W) :
    ¬ halfLightLine.dual.CausallyOpenFutureOn W := by
  intro h
  obtain ⟨l, u, ⟨hl, hu⟩, hlu⟩ := mem_nhds_iff_exists_Ioo_subset.1 (W.isOpen.mem_nhds hW)
  let V : Opens ℝ := ⟨Ioo 0 u, isOpen_Ioo⟩
  have hVW : V ≤ W := fun z hz => hlu ⟨hl.trans hz.1, hz.2⟩
  have hopen := h W V le_rfl hVW
  -- `0 ≤_W u / 2` with `u / 2 ∈ V`, so `0 ∈ J⁻_W(V)`
  have h0 : (0 : ℝ) ∈ halfLightLine.Jminus W V :=
    ⟨u / 2, show u / 2 ∈ Ioo (0 : ℝ) u from ⟨by linarith, by linarith⟩,
      Or.inr ⟨le_rfl, by linarith, fun z hz => hlu ⟨hl.trans_le hz.1, by linarith [hz.2]⟩⟩⟩
  obtain ⟨l', u', ⟨hl', hu'⟩, hlu'⟩ := mem_nhds_iff_exists_Ioo_subset.1 (hopen.mem_nhds h0)
  -- the negative point `l' / 2` would precede a point of `V`
  obtain ⟨x, hx, hyx⟩ := hlu' (show l' / 2 ∈ Ioo l' u' from ⟨by linarith, by linarith⟩)
  rcases (halfLightLine_le_of_neg (show l' / 2 < 0 by linarith)).1 hyx with ⟨rfl, -⟩
  exact absurd (hx : l' / 2 ∈ Ioo (0 : ℝ) u).1 (by linarith)

/-- **Every open set missing `0` is causally open in the past**: there a point `y` below `x ≠ y`
is positive, and keeps a neighbourhood below `x`. The failure of past causal openness sits at `0`. -/
theorem halfLightLine_causallyOpenPastOn_of_zero_notMem {W : Opens ℝ} (hW : (0 : ℝ) ∉ W) :
    halfLightLine.dual.CausallyOpenFutureOn W := by
  intro U V hUW hVU
  rw [isOpen_iff_mem_nhds]
  rintro y ⟨x, hx, hyx⟩
  have hV : (V : Set ℝ) ∈ 𝓝 x := V.isOpen.mem_nhds hx
  have hVJ : (V : Set ℝ) ⊆ halfLightLine.dual.Jplus U V :=
    Precausality.subset_Jplus fun _ hz => hVU hz
  rcases hyx with ⟨rfl, -⟩ | ⟨h0, hyx, hsub⟩
  · exact Filter.mem_of_superset hV hVJ
  rcases hyx.eq_or_lt with rfl | hlt
  · exact Filter.mem_of_superset hV hVJ
  -- `0 < y < x`: every point of `(max l 0, min u x)` lies below `x`, with the segment in `U`
  have hyU : y ∈ (U : Set ℝ) := hsub (left_mem_Icc.2 hlt.le)
  have hy0 : 0 < y := lt_of_le_of_ne h0 fun h => hW (hUW (h ▸ hyU))
  obtain ⟨l, u, ⟨hl, hu⟩, hlu⟩ := mem_nhds_iff_exists_Ioo_subset.1 (U.isOpen.mem_nhds hyU)
  refine Filter.mem_of_superset (Ioo_mem_nhds (max_lt hl hy0) (lt_min hu hlt)) ?_
  rintro z ⟨hz1, hz2⟩
  refine ⟨x, hx, Or.inr ⟨(le_max_right _ _).trans hz1.le,
    (hz2.trans_le (min_le_right _ _)).le, fun w hw => ?_⟩⟩
  rcases le_or_gt y w with hyw | hyw
  · exact hsub ⟨hyw, hw.2⟩
  · exact hlu ⟨((le_max_left _ _).trans_lt hz1).trans_le hw.1,
      hyw.trans hu⟩

/-- **The half-lit line is not locally causally open** (`locally_causally_open`, two-sided): `0`
has no neighbourhood causally open in the past. (Also a consequence of absolute minimality and
`AbsolutelyMinimal.causallyOpen_of_locallyCausallyOpen`.) -/
theorem halfLightLine_not_locallyCausallyOpen : ¬ halfLightLine.LocallyCausallyOpen := fun h =>
  let ⟨_, h0, hW⟩ := h.2 0
  halfLightLine_not_causallyOpenPastOn_of_zero_mem h0 hW

/-! ## The other ladder properties -/

/-- The half-lit line has the push-up property, vacuously (`≪` is empty). -/
theorem halfLightLine_pushUp : halfLightLine.PushUp := by
  rw [Causality.pushUp_iff]
  intro U x y z
  exact ⟨fun h _ => h.elim, fun _ h => h.elim⟩

/-- **The half-lit line is causal**: `≤` lies in the order of `ℝ`. -/
theorem halfLightLine_isCausal : halfLightLine.IsCausal := fun _ _ hxy hyx =>
  (halfLightLine_le_real hxy).antisymm (halfLightLine_le_real hyx)

/-- Every diamond lies in the segment of its vertices. -/
theorem halfLightLine_diamond_subset_Icc (U : Opens ℝ) (p q : ℝ) :
    halfLightLine.diamond U p q ⊆ Icc p q := fun _ hx =>
  ⟨halfLightLine_le_real (Causality.mem_diamond.1 hx).1,
    halfLightLine_le_real (Causality.mem_diamond.1 hx).2⟩

/-- From a point of `[0, ∞)` the diamond in `M` is the segment. -/
theorem halfLightLine_diamond_of_nonneg {p : ℝ} (hp : 0 ≤ p) (q : ℝ) :
    halfLightLine.diamond ⊤ p q = Icc p q := by
  refine (halfLightLine_diamond_subset_Icc ⊤ p q).antisymm fun x hx => ?_
  exact Causality.mem_diamond.2 ⟨Or.inr ⟨hp, hx.1, fun _ _ => trivial⟩,
    Or.inr ⟨hp.trans hx.1, hx.2, fun _ _ => trivial⟩⟩

/-- From a negative point every diamond is at most that point. -/
theorem halfLightLine_diamond_of_neg {p : ℝ} (hp : p < 0) (U : Opens ℝ) (q : ℝ) :
    halfLightLine.diamond U p q ⊆ {p} := fun _ hx =>
  ((halfLightLine_le_of_neg hp).1 (Causality.mem_diamond.1 hx).1).1.symm

/-- **The half-lit line is globally hyperbolic**: causal, with diamonds a segment or at most a
point. -/
theorem halfLightLine_globallyHyperbolic : halfLightLine.GloballyHyperbolic := by
  refine ⟨halfLightLine_isCausal, fun p q => ?_⟩
  rcases le_or_gt 0 p with hp | hp
  · rw [halfLightLine_diamond_of_nonneg hp]
    exact isCompact_Icc
  · exact (subsingleton_singleton.anti (halfLightLine_diamond_of_neg hp ⊤ q)).isCompact

/-- **The half-lit line is strongly causal, with open causally convex neighbourhoods**: an open
interval contains the diamonds of its points. -/
theorem halfLightLine_stronglyCausalOpen : halfLightLine.StronglyCausalOpen := by
  intro p N hN
  obtain ⟨l, u, ⟨hl, hu⟩, hlu⟩ := mem_nhds_iff_exists_Ioo_subset.1 hN
  refine ⟨⟨Ioo l u, isOpen_Ioo⟩, ⟨hl, hu⟩, hlu, fun _ _ => trivial, fun a ha b hb x hx => ?_⟩
  have hx' := halfLightLine_diamond_subset_Icc ⊤ a b hx
  exact ⟨ha.1.trans_le hx'.1, hx'.2.trans_lt hb.2⟩

/-- **The half-lit line has a time function** (the ladder node `time_function`): the identity. -/
theorem halfLightLine_hasTimeFunction : halfLightLine.HasTimeFunction :=
  ⟨id, continuous_id, fun _ _ hxy hne => (halfLightLine_le_real hxy).lt_of_ne hne⟩

/-- **The half-lit line is not tarentin**: near `−1` every diamond is at most a point. -/
theorem halfLightLine_not_tarentin : ¬ halfLightLine.Tarentin := by
  intro h
  obtain ⟨p, hp, q, -, hx⟩ := h (-1) (Iio 0) (Iio_mem_nhds (by norm_num))
  obtain ⟨l, u, ⟨hl, hu⟩, hlu⟩ :=
    mem_nhds_iff_exists_Ioo_subset.1 (mem_interior_iff_mem_nhds.1 hx)
  exact (Set.Ioo_infinite (hl.trans hu)) ((Set.finite_singleton p).subset
    (hlu.trans (halfLightLine_diamond_of_neg hp ⊤ q)))

/-- The half-lit line has no chronal neighbours: `≪` is empty. -/
theorem halfLightLine_not_chronalNeighbours : ¬ halfLightLine.ChronalNeighbours := fun h =>
  let ⟨_, _, hp⟩ := h.1 ⊤ 0 trivial
  hp

/-- **The half-lit line is not causally plain**: `Int J⁺(ℝ) = ℝ` while `I⁺(ℝ) = ∅`. -/
theorem halfLightLine_not_causallyPlain : ¬ halfLightLine.CausallyPlain := by
  intro h
  have hJ : halfLightLine.Jplus ⊤ univ = univ :=
    eq_univ_of_forall fun y => ⟨y, trivial, halfLightLine.le_refl trivial⟩
  have hI : halfLightLine.Iplus ⊤ univ = ∅ := eq_empty_of_forall_notMem fun _ ⟨_, _, h⟩ => h
  have h0 := (h ⊤ univ).1 (show (0 : ℝ) ∈ interior (halfLightLine.Jplus ⊤ univ) by
    rw [hJ, interior_univ]; trivial)
  rw [hI, closure_empty] at h0
  exact h0

/-! ## The separation -/

/-- **The printed causal openness is strictly weaker than DEC-8's two-sided one, among absolutely
minimal causalities** (`causally_open_future ⇏ causally_open`, and `⇏ locally_causally_open`; with
every positive conjunct in the `from`). The half-lit line is absolutely minimal, causally
arc-connected, causally open in the future (hence locally), push-up (hence locally), causal,
globally hyperbolic (hence causally compact), strongly causal (both forms), with a time function
(hence curves extend); it is neither causally open nor locally causally open, nor tarentin, nor
causally plain, and has no chronal neighbours. The conjoined witness for the ladder. -/
theorem halfLightLine_separates_causallyOpen :
    halfLightLine.AbsolutelyMinimal ∧ halfLightLine.CausallyArcConnected ∧
      halfLightLine.CausallyOpenFuture ∧ halfLightLine.LocallyCausallyOpenFuture ∧
      halfLightLine.PushUp ∧ halfLightLine.LocallyPushUp ∧ halfLightLine.IsCausal ∧
      halfLightLine.GloballyHyperbolic ∧ halfLightLine.CausallyCompact ∧
      halfLightLine.StronglyCausalOpen ∧ halfLightLine.StronglyCausal ∧
      halfLightLine.HasTimeFunction ∧ halfLightLine.CurvesExtend ∧
      ¬ halfLightLine.CausallyOpen ∧ ¬ halfLightLine.LocallyCausallyOpen ∧
      ¬ halfLightLine.Tarentin ∧ ¬ halfLightLine.ChronalNeighbours ∧
      ¬ halfLightLine.CausallyPlain :=
  ⟨halfLightLine_absolutelyMinimal, halfLightLine_causallyArcConnected,
    halfLightLine_causallyOpenFuture, halfLightLine_locallyCausallyOpenFuture,
    halfLightLine_pushUp, halfLightLine_pushUp.locallyPushUp, halfLightLine_isCausal,
    halfLightLine_globallyHyperbolic, halfLightLine_globallyHyperbolic.causallyCompact,
    halfLightLine_stronglyCausalOpen, halfLightLine_stronglyCausalOpen.stronglyCausal,
    halfLightLine_hasTimeFunction, halfLightLine_hasTimeFunction.curvesExtend,
    halfLightLine_not_causallyOpen, halfLightLine_not_locallyCausallyOpen,
    halfLightLine_not_tarentin, halfLightLine_not_chronalNeighbours,
    halfLightLine_not_causallyPlain⟩

/-- **Absolute minimality and causal openness in the future do not give causal openness**, on `ℝ`:
DEC-8's `±` changes the notion among absolutely minimal causalities. -/
theorem not_causallyOpen_of_causallyOpenFuture_of_absolutelyMinimal_bare :
    ¬ ∀ C : Causality ℝ, C.AbsolutelyMinimal → C.CausallyOpenFuture → C.CausallyOpen := fun h =>
  halfLightLine_not_causallyOpen
    (h _ halfLightLine_absolutelyMinimal halfLightLine_causallyOpenFuture)

/-- The same, with absolute minimality on every open set for every cover of it (the gluing
reading of `defi:causalite`, OQ-18). -/
theorem not_causallyOpen_of_causallyOpenFuture_of_absolutelyMinimalOn_bare :
    ¬ ∀ C : Causality ℝ, (∀ W : Opens ℝ, C.AbsolutelyMinimalOn W) → C.CausallyOpenFuture →
      C.CausallyOpen := fun h =>
  halfLightLine_not_causallyOpen (h _ halfLightLine_absolutelyMinimalOn
    halfLightLine_causallyOpenFuture)

/-- Absolute minimality and causal openness in the future do not give two-sided local causal
openness. -/
theorem not_locallyCausallyOpen_of_causallyOpenFuture_of_absolutelyMinimal_bare :
    ¬ ∀ C : Causality ℝ, C.AbsolutelyMinimal → C.CausallyOpenFuture →
      C.LocallyCausallyOpen := fun h =>
  halfLightLine_not_locallyCausallyOpen
    (h _ halfLightLine_absolutelyMinimal halfLightLine_causallyOpenFuture)

/-- **Causal arc-connectedness does not give causal openness** (the ladder's
`causally_arc_connected → causally_open`), not even with causal openness in the future, push-up
and global hyperbolicity. -/
theorem not_causallyOpen_of_causallyArcConnected_bare :
    ¬ ∀ C : Causality ℝ, C.CausallyArcConnected → C.CausallyOpenFuture → C.PushUp →
      C.GloballyHyperbolic → C.CausallyOpen := fun h =>
  halfLightLine_not_causallyOpen (h _ halfLightLine_causallyArcConnected
    halfLightLine_causallyOpenFuture halfLightLine_pushUp halfLightLine_globallyHyperbolic)

/-- **The printed causal openness is not invariant under time reversal**, among absolutely
minimal causalities: the time-reversed half-lit line is absolutely minimal and causally open in
the past, not in the future. -/
theorem not_dual_causallyOpenFuture_of_absolutelyMinimal_bare :
    ¬ ∀ C : Causality ℝ, C.AbsolutelyMinimal → C.CausallyOpenFuture →
      C.dual.CausallyOpenFuture := fun h =>
  halfLightLine_not_causallyOpenPast
    (h _ halfLightLine_absolutelyMinimal halfLightLine_causallyOpenFuture)

/-- The time-reversed half-lit line: absolutely minimal, causally open in the past and not in the
future. -/
theorem halfLightLine_dual_separates :
    halfLightLine.dual.AbsolutelyMinimal ∧ halfLightLine.dual.dual.CausallyOpenFuture ∧
      ¬ halfLightLine.dual.CausallyOpenFuture :=
  ⟨Causality.dual_absolutelyMinimal.2 halfLightLine_absolutelyMinimal,
    halfLightLine_causallyOpenFuture, halfLightLine_not_causallyOpenPast⟩

end Causal
