namespace Causal.Flat

open Topology Module

section Disc

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]

/-- `(ĝ − 1)(y, s) = (L(g) y + s • g 0 − y, 0)`. -/
theorem affacd_affExtV_sub_one_apply (g : V ≃ᵃ[ℝ] V) (y : V) (s : ℝ) :
    (affExtV g - 1) (y, s) = (g.linear y + s • g 0 - y, 0) := by
  rw [show (affExtV g - 1) (y, s) = affExtV g (y, s) - (y, s) from rfl, affExtV_apply]
  exact Prod.ext rfl (sub_self s)

/-- `‖L(g) − 1‖ ≤ ‖ĝ − 1‖` (test on `(y, 0)`). -/
theorem affacd_norm_affLin_sub_one_le (g : V ≃ᵃ[ℝ] V) :
    ‖((affLin g : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) - 1‖ ≤ ‖affExtV g - 1‖ := by
  refine ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _) fun y => ?_
  have h := (affExtV g - 1).le_opNorm (y, 0)
  rw [affacd_affExtV_sub_one_apply, zero_smul, add_zero] at h
  have e1 : ‖((g.linear y - y, (0 : ℝ)) : V × ℝ)‖ = ‖g.linear y - y‖ := by
    rw [Prod.norm_def, norm_zero, max_eq_left (norm_nonneg _)]
  have e2 : ‖((y, (0 : ℝ)) : V × ℝ)‖ = ‖y‖ := by
    rw [Prod.norm_def, norm_zero, max_eq_left (norm_nonneg _)]
  rw [e1, e2] at h
  exact h

/-- `‖g 0‖ ≤ ‖ĝ − 1‖` (test on `(0, 1)`). -/
theorem affacd_norm_apply_zero_le (g : V ≃ᵃ[ℝ] V) : ‖g 0‖ ≤ ‖affExtV g - 1‖ := by
  have h := (affExtV g - 1).le_opNorm (0, 1)
  rw [affacd_affExtV_sub_one_apply, map_zero, one_smul, zero_add, sub_zero] at h
  have e1 : ‖((g 0, (0 : ℝ)) : V × ℝ)‖ = ‖g 0‖ := by
    rw [Prod.norm_def, norm_zero, max_eq_left (norm_nonneg _)]
  have e2 : ‖(((0 : V), (1 : ℝ)) : V × ℝ)‖ = 1 := by
    rw [Prod.norm_def, norm_zero, norm_one, max_eq_right zero_le_one]
  rw [e1, e2, mul_one] at h
  exact h

/-- **Discreteness, quantified**: a discrete `Γ ≤ Aff(V)` has a neighbourhood of `1`, read on the
affine extension, containing no other element of `Γ` (`‖ĝ − 1‖` dominates `‖L(g) − 1‖` and
`‖g 0‖`). -/
theorem affacd_exists_isolated {Γ : Subgroup (V ≃ᵃ[ℝ] V)} (hdisc : AffDiscrete Γ) :
    ∃ η > 0, ∀ x ∈ Γ, ‖affExtV x - 1‖ < η → x = 1 := by
  letI : TopologicalSpace (V ≃ᵃ[ℝ] V) := affTopology
  have hd : DiscreteTopology Γ := hdisc
  have hop : IsOpen ({1} : Set Γ) := isOpen_discrete _
  obtain ⟨t, ht, htΓ⟩ := isOpen_induced_iff.1 hop
  obtain ⟨t', ht', htt⟩ := isOpen_induced_iff.1 ht
  have h1t : (1 : V ≃ᵃ[ℝ] V) ∈ t := by
    have : (1 : Γ) ∈ Subtype.val ⁻¹' t := by rw [htΓ]; rfl
    exact this
  have h1t' : affPair (1 : V ≃ᵃ[ℝ] V) ∈ t' := by rw [← htt] at h1t; exact h1t
  obtain ⟨η, hη, hball⟩ := Metric.isOpen_iff.1 ht' _ h1t'
  refine ⟨η, hη, fun x hx hxη => ?_⟩
  have hpair : affPair x ∈ t' := by
    apply hball
    rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
    have e1 : (affPair (1 : V ≃ᵃ[ℝ] V)).1 = 1 := by
      show ((affLin (1 : V ≃ᵃ[ℝ] V) : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) = 1
      rw [map_one, Units.val_one]
    have e2 : (affPair (1 : V ≃ᵃ[ℝ] V)).2 = 0 := rfl
    rw [e1, e2, dist_eq_norm, dist_eq_norm, sub_zero]
    exact ⟨(affacd_norm_affLin_sub_one_le x).trans_lt hxη,
      (affacd_norm_apply_zero_le x).trans_lt hxη⟩
  have hxt : x ∈ t := by rw [← htt]; exact hpair
  have : (⟨x, hx⟩ : Γ) ∈ Subtype.val ⁻¹' t := hxt
  rw [htΓ] at this
  exact congrArg Subtype.val (Set.mem_singleton_iff.1 this)

/-- `‖L(g⁻¹) − 1‖ ≤ 2 ‖L(g) − 1‖` when `‖L(g) − 1‖ ≤ 1/2` (Neumann series). -/
theorem affacd_norm_affLin_inv_sub_one_le {g : V ≃ᵃ[ℝ] V}
    (hg : ‖((affLin g : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) - 1‖ ≤ 1 / 2) :
    ‖((affLin g⁻¹ : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) - 1‖ ≤
      2 * ‖((affLin g : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) - 1‖ := by
  set X := ((affLin g : (V →L[ℝ] V)ˣ) : V →L[ℝ] V)
  set Y := ((affLin g⁻¹ : (V →L[ℝ] V)ˣ) : V →L[ℝ] V)
  have hXY : X * Y = 1 := by
    rw [← Units.val_mul, ← map_mul, mul_inv_cancel, map_one, Units.val_one]
  have h1 : ‖(1 : V →L[ℝ] V)‖ ≤ 1 := ContinuousLinearMap.norm_id_le
  have eY : 1 - (X - 1) * Y = Y := by rw [sub_mul, hXY, one_mul, sub_sub_cancel]
  have eY1 : Y - 1 = -((X - 1) * Y) := by rw [sub_mul, hXY, one_mul, neg_sub]
  have hXY' : ‖(X - 1) * Y‖ ≤ ‖X - 1‖ * ‖Y‖ := norm_mul_le _ _
  have hYn : ‖Y‖ ≤ 2 := by
    have : ‖Y‖ ≤ 1 + ‖X - 1‖ * ‖Y‖ := by
      calc ‖Y‖ = ‖1 - (X - 1) * Y‖ := by rw [eY]
        _ ≤ ‖(1 : V →L[ℝ] V)‖ + ‖(X - 1) * Y‖ := norm_sub_le _ _
        _ ≤ 1 + ‖X - 1‖ * ‖Y‖ := add_le_add h1 hXY'
    have : ‖X - 1‖ * ‖Y‖ ≤ 1 / 2 * ‖Y‖ := mul_le_mul_of_nonneg_right hg (norm_nonneg _)
    linarith
  rw [eY1, norm_neg]
  calc ‖(X - 1) * Y‖ ≤ ‖X - 1‖ * ‖Y‖ := hXY'
    _ ≤ ‖X - 1‖ * 2 := mul_le_mul_of_nonneg_left hYn (norm_nonneg _)
    _ = _ := mul_comm _ _

/-- `D_K (y, s) = (y, K s)`. -/
noncomputable def affacdScale (K : ℝ) : V × ℝ →L[ℝ] V × ℝ :=
  (ContinuousLinearMap.id ℝ V).prodMap (K • ContinuousLinearMap.id ℝ ℝ)

omit [FiniteDimensional ℝ V] in
/-- `D_K (y, s) = (y, K s)`, pointwise. -/
theorem affacdScale_apply (K : ℝ) (y : V) (s : ℝ) : affacdScale K (y, s) = (y, K * s) := rfl

omit [FiniteDimensional ℝ V] in
/-- `D_K D_{K'} = 1` when `K K' = 1`. -/
theorem affacdScale_mul {K K' : ℝ} (h : K * K' = 1) :
    affacdScale (V := V) K * affacdScale K' = 1 := by
  refine ContinuousLinearMap.ext fun ⟨y, s⟩ => ?_
  show affacdScale K (affacdScale K' (y, s)) = (y, s)
  rw [affacdScale_apply, affacdScale_apply, ← mul_assoc, h, one_mul]

/-- `(D_K ĝ D_K⁻¹ − 1)(y, s) = ((L(g) − 1) y + K⁻¹ s • g 0, 0)`. -/
theorem affacd_scale_conj_apply (x : V ≃ᵃ[ℝ] V) {K : ℝ} (hK : K ≠ 0) (y : V) (s : ℝ) :
    (affacdScale K * affExtV x * affacdScale K⁻¹ - 1 : V × ℝ →L[ℝ] V × ℝ) (y, s) =
      ((affLin x : V →L[ℝ] V) y - y + (K⁻¹ * s) • x 0, 0) := by
  show affacdScale K (affExtV x (affacdScale K⁻¹ (y, s))) - (y, s) = _
  rw [affacdScale_apply, affExtV_apply, affacdScale_apply, ← mul_assoc, mul_inv_cancel₀ hK,
    one_mul, affLin_apply]
  refine Prod.ext ?_ (sub_self s)
  show x.linear y + (K⁻¹ * s) • x 0 - y = x.linear y - y + (K⁻¹ * s) • x 0
  abel

/-- **The scaling** `D_K (y, s) = (y, K s)`: for a finite `T ⊆ Aff(V)` with linear parts
`1/64`-close to `1`, a conjugation brings every `ĝ`, `g ∈ T`, within `1/32` of `1`. -/
theorem affacd_exists_scale {T : Set (V ≃ᵃ[ℝ] V)} (hT : T.Finite)
    (hTε : ∀ x ∈ T, ‖((affLin x : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) - 1‖ ≤ 1 / 64) :
    ∃ S S' : V × ℝ →L[ℝ] V × ℝ, S * S' = 1 ∧ S' * S = 1 ∧
      ∀ x ∈ T, ‖S * affExtV x * S' - 1‖ ≤ 1 / 32 := by
  set K : ℝ := 1 + 64 * ∑ x ∈ hT.toFinset, ‖x 0‖ with hKdef
  have hsum0 : 0 ≤ ∑ x ∈ hT.toFinset, ‖x 0‖ := Finset.sum_nonneg fun x _ => norm_nonneg _
  have hK0 : 0 < K := by rw [hKdef]; linarith
  refine ⟨affacdScale K, affacdScale K⁻¹, affacdScale_mul (mul_inv_cancel₀ hK0.ne'),
    affacdScale_mul (inv_mul_cancel₀ hK0.ne'), fun x hx => ?_⟩
  have hCx : ‖x 0‖ ≤ ∑ x ∈ hT.toFinset, ‖x 0‖ :=
    Finset.single_le_sum (f := fun x : V ≃ᵃ[ℝ] V => ‖x 0‖) (fun y _ => norm_nonneg _)
      (hT.mem_toFinset.2 hx)
  have hsmall : K⁻¹ * ‖x 0‖ ≤ 1 / 64 := by
    rw [inv_mul_le_iff₀ hK0]; rw [hKdef]; nlinarith [norm_nonneg (x 0)]
  have hL := hTε x hx
  refine ContinuousLinearMap.opNorm_le_bound _ (by norm_num) fun ⟨y, s⟩ => ?_
  rw [affacd_scale_conj_apply x hK0.ne']
  have hn : ‖((((affLin x : V →L[ℝ] V) y - y + (K⁻¹ * s) • x 0), (0 : ℝ)) : V × ℝ)‖ =
      ‖(affLin x : V →L[ℝ] V) y - y + (K⁻¹ * s) • x 0‖ := by
    rw [Prod.norm_def, norm_zero, max_eq_left (norm_nonneg _)]
  rw [hn]
  have hy : ‖y‖ ≤ ‖((y, s) : V × ℝ)‖ := norm_fst_le ((y, s) : V × ℝ)
  have hs : ‖s‖ ≤ ‖((y, s) : V × ℝ)‖ := norm_snd_le ((y, s) : V × ℝ)
  have e : (affLin x : V →L[ℝ] V) y - y = ((affLin x : V →L[ℝ] V) - 1) y := rfl
  rw [e]
  calc ‖((affLin x : V →L[ℝ] V) - 1) y + (K⁻¹ * s) • x 0‖
      ≤ ‖((affLin x : V →L[ℝ] V) - 1) y‖ + ‖(K⁻¹ * s) • x 0‖ := norm_add_le _ _
    _ ≤ ‖(affLin x : V →L[ℝ] V) - 1‖ * ‖y‖ + K⁻¹ * ‖x 0‖ * ‖s‖ := by
        refine add_le_add (ContinuousLinearMap.le_opNorm _ _) ?_
        rw [norm_smul, norm_mul, Real.norm_eq_abs, abs_of_pos (inv_pos.2 hK0)]
        rw [Real.norm_eq_abs]; nlinarith [abs_nonneg s, norm_nonneg (x 0), inv_pos.2 hK0]
    _ ≤ 1 / 64 * ‖((y, s) : V × ℝ)‖ + 1 / 64 * ‖((y, s) : V × ℝ)‖ := by
        refine add_le_add ?_ ?_
        · exact mul_le_mul hL hy (norm_nonneg _) (by norm_num)
        · exact mul_le_mul hsmall hs (norm_nonneg _) (by norm_num)
    _ = 1 / 32 * ‖((y, s) : V × ℝ)‖ := by ring

/-- **Step 1 (local nilpotency from discreteness).** A finite set of elements of a discrete
`Γ ≤ Aff(V)` with linear parts `1/128`-close to `1` generates a nilpotent subgroup. -/
theorem affacd_isNilpotent_closure_of_finite {Γ : Subgroup (V ≃ᵃ[ℝ] V)} (hdisc : AffDiscrete Γ)
    {F : Set (V ≃ᵃ[ℝ] V)} (hF : F.Finite) (hFΓ : F ⊆ affNearSet Γ (1 / 128)) :
    Group.IsNilpotent (Subgroup.closure F) := by
  have hT : (F ∪ F⁻¹).Finite := hF.union hF.inv
  have hFε : ∀ x ∈ F, ‖((affLin x : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) - 1‖ < 1 / 128 :=
    fun x hx => (hFΓ hx).2
  have hTε : ∀ x ∈ F ∪ F⁻¹, ‖((affLin x : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) - 1‖ ≤ 1 / 64 := by
    rintro x (hx | hx)
    · linarith [hFε x hx]
    · have h1 := hFε _ (Set.mem_inv.1 hx)
      have h2 := affacd_norm_affLin_inv_sub_one_le (g := x⁻¹) (by linarith)
      rw [inv_inv] at h2
      linarith
  obtain ⟨S, S', hSS', hS'S, hS⟩ := affacd_exists_scale hT hTε
  obtain ⟨η, hη, hiso⟩ := affacd_exists_isolated hdisc
  have hF' : ∀ a b : V ≃ᵃ[ℝ] V, S * affExtV (a * b) * S' =
      (S * affExtV a * S') * (S * affExtV b * S') := fun a b => by
    rw [affExtV_mul]
    calc S * (affExtV a * affExtV b) * S' = S * affExtV a * (S' * S) * affExtV b * S' := by
          rw [hS'S, mul_one]; noncomm_ring
      _ = S * affExtV a * S' * (S * affExtV b * S') := by noncomm_ring
  have hF1 : S * affExtV (1 : V ≃ᵃ[ℝ] V) * S' = 1 := by rw [affExtV_one, mul_one, hSS']
  have hX : ∀ x ∈ F,
      ‖S * affExtV x * S' - 1‖ ≤ 1 / 32 ∧ ‖S * affExtV x⁻¹ * S' - 1‖ ≤ 1 / 32 := fun x hx =>
    ⟨hS _ (Or.inl hx), hS _ (Or.inr (by rw [Set.mem_inv, inv_inv]; exact hx))⟩
  have hM : 0 < ‖S'‖ * ‖S‖ + 1 := by positivity
  obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one (div_pos hη hM) (show (1 / 2 : ℝ) < 1 by norm_num)
  refine isNilpotent_closure_of_leftCommIter_eq_one (k := k) fun x hx l hl hlen => ?_
  refine hiso _ (leftCommIter_mem (hFΓ hx).1 fun y hy => (hFΓ (hl y hy)).1) ?_
  have hb := (norm_leftCommIter_le (F := fun x => S * affExtV x * S')
    ContinuousLinearMap.norm_id_le hF' hF1 hX l hl (by norm_num : (1 / 32 : ℝ) ≤ 3)
    (hX x hx).1 (hX x hx).2).1
  rw [hlen] at hb
  have hp : (0 : ℝ) ≤ (1 / 2) ^ k := by positivity
  rw [lt_div_iff₀ hM] at hk
  calc ‖affExtV (leftCommIter x l) - 1‖
      ≤ ‖S'‖ * ‖S‖ * ‖S * affExtV (leftCommIter x l) * S' - 1‖ := norm_sub_one_le_of_conj hS'S _
    _ ≤ ‖S'‖ * ‖S‖ * (1 / 32 * (1 / 2) ^ k) :=
        mul_le_mul_of_nonneg_left hb (by positivity)
    _ ≤ (1 / 2) ^ k * (‖S'‖ * ‖S‖ + 1) := by nlinarith [norm_nonneg S, norm_nonneg S']
    _ < η := hk

omit [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V] in
/-- A subgroup mapped injectively into a nilpotent subgroup is nilpotent. -/
theorem affacd_isNilpotent_of_map_le {G H : Type*} [Group G] [Group H] {f : G →* H}
    (hf : Function.Injective f) {A : Subgroup G} {B : Subgroup H} (hAB : A.map f ≤ B)
    [hB : Group.IsNilpotent B] : Group.IsNilpotent A := by
  obtain ⟨n, hn⟩ := (Subgroup.isNilpotent_iff_lowerCentralSeries B).1 hB
  refine (Subgroup.isNilpotent_iff_lowerCentralSeries A).2 ⟨n, ?_⟩
  refine (Subgroup.map_eq_bot_iff_of_injective _ hf).1 (le_bot_iff.1 ?_)
  rw [Subgroup.map_lowerCentralSeries, ← hn]
  exact Subgroup.lowerCentralSeries_mono n hAB

omit [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V] in
/-- The image of a nilpotent subgroup is nilpotent. -/
theorem affacd_isNilpotent_map {G H : Type*} [Group G] [Group H] (f : G →* H) {A : Subgroup G}
    [hA : Group.IsNilpotent A] : Group.IsNilpotent (A.map f) := by
  obtain ⟨n, hn⟩ := (Subgroup.isNilpotent_iff_lowerCentralSeries A).1 hA
  refine (Subgroup.isNilpotent_iff_lowerCentralSeries _).2 ⟨n, ?_⟩
  rw [← Subgroup.map_lowerCentralSeries, hn, Subgroup.map_bot]

/-- **Step 2 (uniform class).** Under the class bound for `V × ℝ`, the subgroup of Step 1 has
`γ_{dim V + 2} = 1`, whatever `F`. -/
theorem affacd_lowerCentralSeries_closure_finite (hcb : AffNearOneClassBound (V × ℝ))
    {Γ : Subgroup (V ≃ᵃ[ℝ] V)} (hdisc : AffDiscrete Γ) {F : Set (V ≃ᵃ[ℝ] V)} (hF : F.Finite)
    (hFΓ : F ⊆ affNearSet Γ (1 / 128)) :
    (Subgroup.closure F).lowerCentralSeries (finrank ℝ V + 1) = ⊥ := by
  have hT : (F ∪ F⁻¹).Finite := hF.union hF.inv
  have hTε : ∀ x ∈ F ∪ F⁻¹, ‖((affLin x : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) - 1‖ ≤ 1 / 64 := by
    rintro x (hx | hx)
    · linarith [(hFΓ hx).2]
    · have h1 := (hFΓ (Set.mem_inv.1 hx)).2
      have h2 := affacd_norm_affLin_inv_sub_one_le (g := x⁻¹) (by linarith)
      rw [inv_inv] at h2
      linarith
  obtain ⟨S, S', hSS', hS'S, hS⟩ := affacd_exists_scale hT hTε
  set u : (V × ℝ →L[ℝ] V × ℝ)ˣ := ⟨S, S', hSS', hS'S⟩ with hu
  set ψ : (V ≃ᵃ[ℝ] V) →* (V × ℝ →L[ℝ] V × ℝ)ˣ :=
    (MulAut.conj u).toMonoidHom.comp affExtU with hψ
  have hψv : ∀ g, ((ψ g : (V × ℝ →L[ℝ] V × ℝ)ˣ) : V × ℝ →L[ℝ] V × ℝ) = S * affExtV g * S' :=
    fun g => rfl
  have hψinj : Function.Injective ψ := fun a b hab =>
    affExtU_injective ((MulAut.conj u).injective hab)
  haveI hnil : Group.IsNilpotent (Subgroup.closure F) :=
    affacd_isNilpotent_closure_of_finite hdisc hF hFΓ
  haveI : Group.IsNilpotent (Subgroup.closure (ψ '' F)) := by
    rw [← MonoidHom.map_closure]; exact affacd_isNilpotent_map ψ
  have hgen : ∀ x ∈ ψ '' F,
      ‖((x : (V × ℝ →L[ℝ] V × ℝ)ˣ) : V × ℝ →L[ℝ] V × ℝ) - 1‖ < 1 / 3 := by
    rintro _ ⟨g, hg, rfl⟩
    rw [hψv]; linarith [hS g (Or.inl hg)]
  have hb := hcb (ψ '' F) inferInstance hgen
  have hdim : finrank ℝ (V × ℝ) = finrank ℝ V + 1 := by
    rw [Module.finrank_prod, Module.finrank_self]
  rw [hdim, ← MonoidHom.map_closure, ← Subgroup.map_lowerCentralSeries] at hb
  exact (Subgroup.map_eq_bot_iff_of_injective _ hψinj).1 hb

omit [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V] in
/-- A left-normed commutator of weight `l.length + 1` with letters in `S` lies in `γ_{l.length}(S)`. -/
theorem affacd_leftCommIter_mem_lowerCentralSeries {G : Type*} [Group G] (S : Subgroup G) :
    ∀ (l : List G) {c : G} {m : ℕ}, c ∈ S.lowerCentralSeries m → (∀ y ∈ l, y ∈ S) →
      leftCommIter c l ∈ S.lowerCentralSeries (m + l.length)
  | [], _, _, hc, _ => hc
  | x :: l, c, m, hc, hl => by
    have hx : x ∈ S := hl x List.mem_cons_self
    have h1 : c * x * c⁻¹ * x⁻¹ ∈ S.lowerCentralSeries (m + 1) := by
      rw [Subgroup.lowerCentralSeries_succ, ← commutatorElement_def]
      exact Subgroup.commutator_mem_commutator hc hx
    have := affacd_leftCommIter_mem_lowerCentralSeries S l h1
      fun y hy => hl y (List.mem_cons_of_mem _ hy)
    rw [leftCommIter_cons, List.length_cons]
    rwa [show m + (l.length + 1) = m + 1 + l.length by omega]

/-- **Step 3: `Γ_ε` is nilpotent** (`ε = 1/128`), of class `≤ dim V + 1`. -/
theorem affacd_isNilpotent_nearSubgroup (hcb : AffNearOneClassBound (V × ℝ))
    {Γ : Subgroup (V ≃ᵃ[ℝ] V)} (hdisc : AffDiscrete Γ) :
    Group.IsNilpotent (affNearSubgroup Γ (1 / 128)) := by
  classical
  refine isNilpotent_closure_of_leftCommIter_eq_one (k := finrank ℝ V + 1)
    fun x hx l hl hlen => ?_
  set F : Set (V ≃ᵃ[ℝ] V) := insert x {y | y ∈ l} with hFdef
  have hF : F.Finite := (List.finite_toSet l).insert x
  have hFΓ : F ⊆ affNearSet Γ (1 / 128) := by
    rintro y (rfl | hy)
    · exact hx
    · exact hl y hy
  have hmem := affacd_leftCommIter_mem_lowerCentralSeries (Subgroup.closure F) l
    (c := x) (m := 0) (Subgroup.subset_closure (Set.mem_insert x _))
    fun y hy => Subgroup.subset_closure (Set.mem_insert_of_mem x hy)
  rw [zero_add, hlen, affacd_lowerCentralSeries_closure_finite hcb hdisc hF hFΓ] at hmem
  exact (Subgroup.mem_bot).1 hmem

end Disc

section Topo

/-- `⁅cl A, cl B⁆ ≤ cl ⁅A, B⁆` in a topological group. -/
theorem affacd_commutator_closure_le {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] (A B : Subgroup G) :
    ⁅A.topologicalClosure, B.topologicalClosure⁆ ≤ (⁅A, B⁆ : Subgroup G).topologicalClosure := by
  rw [Subgroup.commutator_le]
  intro a ha b hb
  have hc : Continuous (Function.uncurry fun x y : G => x * y * x⁻¹ * y⁻¹) := by
    fun_prop
  have := map_mem_closure₂ (u := ((⁅A, B⁆ : Subgroup G) : Set G)) hc
    (ha : a ∈ closure (A : Set G))
    (hb : b ∈ closure (B : Set G))
    fun x hx y hy => by
      rw [← commutatorElement_def]; exact Subgroup.commutator_mem_commutator hx hy
  rw [← commutatorElement_def] at this
  exact this

/-- **The closure of a nilpotent subgroup is nilpotent** (Hausdorff topological group):
`γ_k(cl H) ⊆ cl γ_k(H)`, commutators being continuous. -/
theorem affacd_isNilpotent_topologicalClosure {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] (H : Subgroup G) [Group.IsNilpotent H] :
    Group.IsNilpotent H.topologicalClosure := by
  have key : ∀ n, H.topologicalClosure.lowerCentralSeries n ≤
      (H.lowerCentralSeries n).topologicalClosure := by
    intro n
    induction n with
    | zero => exact le_rfl
    | succ n ih =>
      rw [Subgroup.lowerCentralSeries_succ, Subgroup.lowerCentralSeries_succ]
      exact (Subgroup.commutator_mono ih le_rfl).trans (affacd_commutator_closure_le _ _)
  obtain ⟨n, hn⟩ := (Subgroup.isNilpotent_iff_lowerCentralSeries H).1 inferInstance
  refine (Subgroup.isNilpotent_iff_lowerCentralSeries _).2 ⟨n, le_bot_iff.1 ?_⟩
  refine (key n).trans fun x hx => ?_
  rw [hn] at hx
  have hx' : x ∈ closure (((⊥ : Subgroup G)) : Set G) := hx
  rw [Subgroup.coe_bot, closure_singleton] at hx'
  exact (Subgroup.mem_bot).2 hx'

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]

/-- The near-identity ball of `GL(V)`. -/
def affacdBall (ε : ℝ) : Set (V →L[ℝ] V)ˣ :=
  {u | ‖((u : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) - 1‖ < ε}

omit [FiniteDimensional ℝ V] in
/-- The ball is open (`Units.continuous_val`). -/
theorem isOpen_affacdBall (ε : ℝ) : IsOpen (affacdBall (V := V) ε) :=
  isOpen_lt (continuous_norm.comp (Units.continuous_val.sub continuous_const)) continuous_const

omit [FiniteDimensional ℝ V] in
/-- `1` lies in the ball. -/
theorem one_mem_affacdBall {ε : ℝ} (hε : 0 < ε) : (1 : (V →L[ℝ] V)ˣ) ∈ affacdBall ε := by
  show ‖(((1 : (V →L[ℝ] V)ˣ)) : V →L[ℝ] V) - 1‖ < ε
  rw [Units.val_one, sub_self, norm_zero]; exact hε

/-- An element of `L(Γ)` in the ball is the linear part of a generator of `Γ_ε`. -/
theorem affacd_linearImage_inter_ball_subset (Γ : Subgroup (V ≃ᵃ[ℝ] V)) (ε : ℝ) :
    (affLinearImage Γ : Set (V →L[ℝ] V)ˣ) ∩ affacdBall ε ⊆
      ((affNearSubgroup Γ ε).map affLin : Set _) := by
  rintro _ ⟨⟨g, hg, rfl⟩, hb⟩
  exact ⟨g, Subgroup.subset_closure ⟨hg, hb⟩, rfl⟩

/-- `cl L(Γ) ∩ B(1, ε) ⊆ cl L(Γ_ε)`. -/
theorem affacd_closure_linearImage_inter_ball_subset (Γ : Subgroup (V ≃ᵃ[ℝ] V)) {ε : ℝ} :
    closure (affLinearImage Γ : Set (V →L[ℝ] V)ˣ) ∩ affacdBall ε ⊆
      closure (((affNearSubgroup Γ ε).map affLin : Subgroup (V →L[ℝ] V)ˣ) :
        Set (V →L[ℝ] V)ˣ) := by
  intro x hx
  have h := (isOpen_affacdBall ε).closure_inter (s := (affLinearImage Γ : Set (V →L[ℝ] V)ˣ)) hx
  refine closure_mono (fun y hy => ?_) h
  exact affacd_linearImage_inter_ball_subset Γ ε ⟨hy.1, hy.2⟩

/-- **Step 4: `G₀ ⊆ cl L(Γ_ε)`** for every `ε > 0` (no discreteness). -/
theorem affG0_subset_closure_near (Γ : Subgroup (V ≃ᵃ[ℝ] V)) {ε : ℝ} (hε : 0 < ε) :
    affG0 Γ ⊆
      closure (((affNearSubgroup Γ ε).map affLin : Subgroup (V →L[ℝ] V)ˣ) : Set (V →L[ℝ] V)ˣ) := by
  set F : Subgroup (V →L[ℝ] V)ˣ := (affLinearImage Γ).topologicalClosure with hFdef
  set O : Subgroup (V →L[ℝ] V)ˣ := ((affNearSubgroup Γ ε).map affLin).topologicalClosure
    with hOdef
  have hF : (F : Set (V →L[ℝ] V)ˣ) = closure (affLinearImage Γ : Set (V →L[ℝ] V)ˣ) := rfl
  have hO : (O : Set (V →L[ℝ] V)ˣ) =
      closure (((affNearSubgroup Γ ε).map affLin : Subgroup (V →L[ℝ] V)ˣ) :
        Set (V →L[ℝ] V)ˣ) := rfl
  have hOF : ∀ x ∈ O, x ∈ F := fun x hx => by
    have hx' : x ∈ (O : Set (V →L[ℝ] V)ˣ) := hx
    show x ∈ (F : Set (V →L[ℝ] V)ˣ)
    rw [hO] at hx'; rw [hF]
    exact closure_mono (fun y hy => Subgroup.map_mono (affNearSubgroup_le Γ ε) hy) hx'
  have hFB : ∀ x ∈ F, x ∈ affacdBall ε → x ∈ O := fun x hx hb => by
    have hx' : x ∈ (F : Set (V →L[ℝ] V)ˣ) := hx
    show x ∈ (O : Set (V →L[ℝ] V)ˣ)
    rw [hO]; rw [hF] at hx'; exact affacd_closure_linearImage_inter_ball_subset Γ ⟨hx', hb⟩
  set W := affacdBall (V := V) ε
  set u : Set (V →L[ℝ] V)ˣ := ⋃ o ∈ (O : Set (V →L[ℝ] V)ˣ), (fun x => o⁻¹ * x) ⁻¹' W
  set v : Set (V →L[ℝ] V)ˣ := ⋃ o ∈ (F : Set (V →L[ℝ] V)ˣ) \ O, (fun x => o⁻¹ * x) ⁻¹' W
  have hu : IsOpen u := isOpen_biUnion fun o _ =>
    (isOpen_affacdBall ε).preimage (continuous_const.mul continuous_id)
  have hv : IsOpen v := isOpen_biUnion fun o _ =>
    (isOpen_affacdBall ε).preimage (continuous_const.mul continuous_id)
  have h1W : (1 : (V →L[ℝ] V)ˣ) ∈ W := one_mem_affacdBall hε
  have huO : ∀ x ∈ F, x ∈ u → x ∈ O := by
    intro x hx hxu
    obtain ⟨o, ho, hxo⟩ := Set.mem_iUnion₂.1 hxu
    have hw : o⁻¹ * x ∈ O := hFB _ (F.mul_mem (F.inv_mem (hOF o ho)) hx) hxo
    have : x = o * (o⁻¹ * x) := by group
    rw [this]; exact O.mul_mem ho hw
  have hvO : ∀ x ∈ F, x ∈ v → x ∉ O := by
    intro x hx hxv hxO
    obtain ⟨o, ⟨hoF, hoO⟩, hxo⟩ := Set.mem_iUnion₂.1 hxv
    have hw : o⁻¹ * x ∈ O := hFB _ (F.mul_mem (F.inv_mem hoF) hx) hxo
    have : o = x * (o⁻¹ * x)⁻¹ := by group
    exact hoO (this ▸ O.mul_mem hxO (O.inv_mem hw))
  have hC := isPreconnected_connectedComponentIn (F := (F : Set (V →L[ℝ] V)ˣ))
    (x := (1 : (V →L[ℝ] V)ˣ))
  have hCF : connectedComponentIn (F : Set (V →L[ℝ] V)ˣ) 1 ⊆ F :=
    connectedComponentIn_subset _ _
  have hcover : connectedComponentIn (F : Set (V →L[ℝ] V)ˣ) 1 ⊆ u ∪ v := by
    intro x hx
    by_cases hxO : x ∈ O
    · exact Or.inl (Set.mem_iUnion₂.2 ⟨x, hxO, by simpa using h1W⟩)
    · exact Or.inr (Set.mem_iUnion₂.2 ⟨x, ⟨hCF hx, hxO⟩, by simpa using h1W⟩)
  have hdisj : connectedComponentIn (F : Set (V →L[ℝ] V)ˣ) 1 ∩ (u ∩ v) = ∅ := by
    refine Set.eq_empty_of_forall_notMem fun x ⟨hx, hxu, hxv⟩ => ?_
    exact hvO x (hCF hx) hxv (huO x (hCF hx) hxu)
  have h1F : (1 : (V →L[ℝ] V)ˣ) ∈ (F : Set (V →L[ℝ] V)ˣ) := F.one_mem
  have h1C := mem_connectedComponentIn h1F
  have hG0 : affG0 Γ = connectedComponentIn (F : Set (V →L[ℝ] V)ˣ) 1 := rfl
  rw [hG0]
  rcases isPreconnected_iff_subset_of_disjoint.1 hC u v hu hv hcover hdisj with h | h
  · intro x hx; rw [← hO]; exact huO x (hCF hx) (h hx)
  · exact absurd O.one_mem (hvO 1 h1F (h h1C))

/-- **Step 5: `Γ_nd ≤ Γ_ε`** for every `ε > 0` (no discreteness). -/
theorem affNonDiscretePart_le_near (Γ : Subgroup (V ≃ᵃ[ℝ] V)) {ε : ℝ} (hε : 0 < ε) :
    affNonDiscretePart Γ ≤ affNearSubgroup Γ ε := by
  rintro γ ⟨hγ, hγ'⟩
  set O : Subgroup (V →L[ℝ] V)ˣ := ((affNearSubgroup Γ ε).map affLin).topologicalClosure
    with hOdef
  have hle : Subgroup.closure (affG0 Γ) ≤ O :=
    (Subgroup.closure_le O).2 (affG0_subset_closure_near Γ hε)
  have hx : affLin γ ∈
      closure (((affNearSubgroup Γ ε).map affLin : Subgroup (V →L[ℝ] V)ˣ) :
        Set (V →L[ℝ] V)ˣ) :=
    hle hγ'
  have hopen : IsOpen {y : (V →L[ℝ] V)ˣ | y⁻¹ * affLin γ ∈ affacdBall ε} :=
    (isOpen_affacdBall ε).preimage (continuous_inv.mul continuous_const)
  have hmem : affLin γ ∈ {y : (V →L[ℝ] V)ˣ | y⁻¹ * affLin γ ∈ affacdBall ε} := by
    show (affLin γ)⁻¹ * affLin γ ∈ affacdBall ε
    rw [inv_mul_cancel]; exact one_mem_affacdBall hε
  obtain ⟨y, hy, ⟨γ', hγ'N, rfl⟩⟩ := mem_closure_iff.1 hx _ hopen hmem
  have hgen : γ'⁻¹ * γ ∈ affNearSubgroup Γ ε := by
    refine Subgroup.subset_closure
      ⟨Γ.mul_mem (Γ.inv_mem (affNearSubgroup_le Γ ε hγ'N)) hγ, ?_⟩
    have : affLin (γ'⁻¹ * γ) ∈ affacdBall ε := by rw [map_mul, map_inv]; exact hy
    exact this
  have : γ = γ' * (γ'⁻¹ * γ) := by group
  rw [this]; exact (affNearSubgroup Γ ε).mul_mem hγ'N hgen

/-- **Step 6**: `Γ_ε` nilpotent for some `ε > 0` gives the conclusion of `bthm:ausl`. -/
theorem affAusConclusion_of_isNilpotent_near (Γ : Subgroup (V ≃ᵃ[ℝ] V)) {ε : ℝ} (hε : 0 < ε)
    (h : Group.IsNilpotent (affNearSubgroup Γ ε)) : AffAusConclusion Γ := by
  haveI := h
  haveI : Group.IsNilpotent ((affNearSubgroup Γ ε).map affLin) := affacd_isNilpotent_map affLin
  haveI : Group.IsNilpotent ((affNearSubgroup Γ ε).map affLin).topologicalClosure :=
    affacd_isNilpotent_topologicalClosure _
  refine ⟨?_, ?_⟩
  · refine affacd_isNilpotent_of_map_le (f := MonoidHom.id _) Function.injective_id
      (B := ((affNearSubgroup Γ ε).map affLin).topologicalClosure) ?_
    rw [Subgroup.map_id]
    exact (Subgroup.closure_le _).2 (affG0_subset_closure_near Γ hε)
  · refine affacd_isNilpotent_of_map_le (f := MonoidHom.id _) Function.injective_id
      (B := affNearSubgroup Γ ε) ?_
    rw [Subgroup.map_id]
    exact affNonDiscretePart_le_near Γ hε

/-- **`bthm:ausl` from the uniform class bound.** -/
theorem affAuslanderCarriereDalbo_of_classBound (hcb : AffNearOneClassBound (V × ℝ)) :
    AffAuslanderCarriereDalbo V := fun Γ hdisc =>
  affAusConclusion_of_isNilpotent_near Γ (by norm_num) (affacd_isNilpotent_nearSubgroup hcb hdisc)

end Topo

section Isom

variable {d : ℕ}

/-- `isomPair g = affPair g`: the two topologies are induced along the same map. -/
theorem affacd_isomPair_eq (g : isom d) :
    isomPair g = affPair (g : Minkowski d ≃ᵃ[ℝ] Minkowski d) :=
  Prod.ext (ContinuousLinearMap.ext fun _ => rfl) rfl

/-- **Discreteness transfers from `Isom(𝐌ⁿ)` to `Aff(𝐌ⁿ)`**: `isomTopology` and `affTopology` are
both induced by `g ↦ (L(g), g 0)`. -/
theorem affDiscrete_map_isom {Γ : Subgroup (isom d)} (hdisc : DiscreteTopology Γ) :
    AffDiscrete (Γ.map (isom d).subtype) := by
  letI : TopologicalSpace (Minkowski d ≃ᵃ[ℝ] Minkowski d) := affTopology
  show DiscreteTopology (Γ.map (isom d).subtype)
  refine discreteTopology_iff_isOpen_singleton.2 fun γ' => ?_
  obtain ⟨g, hgΓ, hgγ⟩ := γ'.2
  have hop : IsOpen ({⟨g, hgΓ⟩} : Set Γ) := isOpen_discrete _
  obtain ⟨t, ht, htΓ⟩ := isOpen_induced_iff.1 hop
  obtain ⟨t', ht', htt⟩ := isOpen_induced_iff.1 ht
  refine isOpen_induced_iff.2 ⟨affPair ⁻¹' t', ht'.preimage continuous_induced_dom, ?_⟩
  ext x
  simp only [Set.mem_preimage, Set.mem_singleton_iff]
  constructor
  · intro hx
    obtain ⟨y, hyΓ, hyx⟩ := x.2
    have hyt : y ∈ t := by
      rw [← htt]
      show isomPair y ∈ t'
      rw [affacd_isomPair_eq]; simp only [Subgroup.coe_subtype] at hyx; rw [hyx]; exact hx
    have : (⟨y, hyΓ⟩ : Γ) ∈ Subtype.val ⁻¹' t := hyt
    rw [htΓ, Set.mem_singleton_iff] at this
    have hyg : y = g := congrArg Subtype.val this
    refine Subtype.ext ?_
    rw [← hyx, ← hgγ, hyg]
  · rintro rfl
    have hgt : g ∈ t := by
      have : (⟨g, hgΓ⟩ : Γ) ∈ Subtype.val ⁻¹' t := by rw [htΓ]; rfl
      exact this
    rw [← htt] at hgt
    have h2 : isomPair g ∈ t' := hgt
    rw [affacd_isomPair_eq] at h2
    rw [← hgγ]; exact h2

/-- `L : SO₀(1, d) → GL(𝐌ⁿ)`. -/
noncomputable def affacdLorentzUnits : lorentz d →* (Minkowski d →L[ℝ] Minkowski d)ˣ where
  toFun A := ⟨linToCLM (A : Minkowski d ≃ₗ[ℝ] Minkowski d),
    linToCLM ((A⁻¹ : lorentz d) : Minkowski d ≃ₗ[ℝ] Minkowski d),
    by rw [← linToCLM_mul, ← Subgroup.coe_mul, mul_inv_cancel, Subgroup.coe_one, linToCLM_one],
    by rw [← linToCLM_mul, ← Subgroup.coe_mul, inv_mul_cancel, Subgroup.coe_one, linToCLM_one]⟩
  map_one' := Units.ext linToCLM_one
  map_mul' _ _ := Units.ext (linToCLM_mul _ _)

/-- `affacdLorentzUnits` is injective. -/
theorem affacdLorentzUnits_injective : Function.Injective (affacdLorentzUnits (d := d)) :=
  fun _ _ h => Subtype.ext (linToCLM_injective (congrArg Units.val h))

/-- `affacdLorentzUnits` is continuous (`Units.isOpenEmbedding_val`). -/
theorem continuous_affacdLorentzUnits : Continuous (affacdLorentzUnits (d := d)) :=
  Units.isOpenEmbedding_val.isInducing.continuous_iff.2 continuous_lorentz_linToCLM

/-- `φ ∘ linearPart = affLin ∘ subtype`. -/
theorem affacdLorentzUnits_linearPart (g : isom d) :
    affacdLorentzUnits (linearPart g) = affLin (g : Minkowski d ≃ᵃ[ℝ] Minkowski d) :=
  Units.ext (ContinuousLinearMap.ext fun _ => rfl)

/-- **The Isom conclusion from the affine one.** -/
theorem ausConclusion_of_aff {Γ : Subgroup (isom d)}
    (h : AffAusConclusion (Γ.map (isom d).subtype)) : AusConclusion Γ := by
  set Γ' := Γ.map (isom d).subtype with hΓ'
  set φ := affacdLorentzUnits (d := d)
  obtain ⟨h1, h2⟩ := h
  have himg : φ '' (linearImage Γ : Set (lorentz d)) ⊆ (affLinearImage Γ' : Set _) := by
    rintro _ ⟨_, ⟨g, hg, rfl⟩, rfl⟩
    exact ⟨g, ⟨g, hg, rfl⟩, (affacdLorentzUnits_linearPart g).symm⟩
  have hG0 : φ '' linClosureIdentityComponent Γ ⊆ affG0 Γ' := by
    refine (isPreconnected_connectedComponentIn.image _
      continuous_affacdLorentzUnits.continuousOn).subset_connectedComponentIn
      ⟨1, mem_connectedComponentIn (subset_closure (linearImage Γ).one_mem), map_one φ⟩ ?_
    refine (Set.image_mono (connectedComponentIn_subset _ _)).trans ?_
    exact (image_closure_subset_closure_image continuous_affacdLorentzUnits).trans
      (closure_mono himg)
  have hcl : (Subgroup.closure (linClosureIdentityComponent Γ)).map φ ≤
      Subgroup.closure (affG0 Γ') := by
    rw [MonoidHom.map_closure]; exact Subgroup.closure_mono hG0
  refine ⟨?_, ?_⟩
  · exact affacd_isNilpotent_of_map_le affacdLorentzUnits_injective hcl
  · refine affacd_isNilpotent_of_map_le (f := (isom d).subtype) Subtype.val_injective
      (B := affNonDiscretePart Γ') ?_
    rintro _ ⟨g, ⟨hgΓ, hgG⟩, rfl⟩
    refine ⟨⟨g, hgΓ, rfl⟩, ?_⟩
    show affLin (g : Minkowski d ≃ᵃ[ℝ] Minkowski d) ∈ Subgroup.closure (affG0 Γ')
    rw [← affacdLorentzUnits_linearPart]
    exact hcl ⟨_, hgG, rfl⟩

/-- **The DEC-36 Isom form is a corollary of the printed affine form.** -/
theorem auslanderCarriereDalbo_of_aff (h : AffAuslanderCarriereDalbo (Minkowski d)) :
    AuslanderCarriereDalbo d := fun _ hdisc =>
  ausConclusion_of_aff (h _ (affDiscrete_map_isom hdisc))

