import Causal.Flat.Bieberbach
import Causal.Flat.TitsNull

/-!
# `Causal.Flat.BieberbachZassenhaus` — near-identity linear parts of a discrete Euclidean group commute, on a subgroup of finite index

T. Barbot, *Globally hyperbolic flat space-times* (`papers/barbot`, arXiv math/0402257), §5.1,
the prose item **[5.B]** of `docs/BARBOT.md` (l.1720–1725). Package WP-Bieb-1 (DEC-110: Bieberbach
I proved through "a discrete subgroup of `Isom(ℝⁿ)` is virtually abelian"). **No ledger label is
certified here**: this is step (1a) of that proof, the Euclidean Zassenhaus lemma.

> As an application of these theorems, it is easy for example to recover the following version
> of Bieberbach's Theorem: *If Γ is discrete group of isometries of the euclidean space of
> dimension n, it contains a finite index free abelian subgroup of finite rank.* (l.1720–1725)

* `commute_of_commute_conj_linearIsometryEquiv` — **Frobenius' lemma** in `O(E)`: if `A` commutes
  with `B A B⁻¹` and `‖B − 1‖ < 1/2`, then `A B = B A` (`c = [A, B]` has all its powers
  `cⁿ = Aⁿ B A⁻ⁿ B⁻¹` within `2‖B − 1‖ < 1` of `1`; no small subgroups,
  `eq_self_of_forall_iterate_near`, `Flat/TitsNull`).
* `commute_linearPart_of_iterate_eq_one` — the **backward induction**.
* `exists_iterate_commutator_eq_one_eucl` — the **Engel property** of an element of a discrete
  `Γ` whose linear part is `1/64`-close to `1`, through the scaled affine extension
  `euclAffExt K g (y, s) = (L(g) y + (s / K) • g 0, s)`, the halving step
  `norm_iterate_commutator_le` (`Flat/TitsNull`) and `IsDiscreteEucl` at the origin.
* `commute_linearPart_of_near_one` — linear parts `1/64`-close to `1` commute.
* `exists_finiteIndex_commute_linearPart` — **the subgroup generated by the elements with
  linear part `1/64`-close to `1` has finite index and pairwise commuting linear parts**
  (`relIndex_closure_ne_zero`, `commute_of_mem_closure`, `Flat/TitsNull`).

## Hypothesis checklist
| paper hypothesis | here |
|---|---|
| Γ discrete (l.1723) | ✓ carried, as `IsDiscreteEucl` (`Flat/Bieberbach`'s choice) |
| `E = ℝⁿ` | ⚠ weakened: any finite-dimensional real inner product space |

## SCOPE (disclosed)
* Step (1a) only; the abelian subgroup, the invariant subspace and the effective action are
  `Flat/BieberbachAbelian`, `Flat/BieberbachMinSet`, `Flat/BieberbachEffective`; the assembly
  `bieberbachI` is `Flat/BieberbachProof`.
* The constant `1/64` is the one of `Flat/TitsNull`'s halving step (uniform in `Γ` and `E`).

Provenance: mathlib `fabf563a` (tag `v4.31.0`), pinned via `lakefile.toml`. Barbot campaign,
DEC-110.
-/

namespace Causal.Flat

open Set Function Module

section Zassenhaus

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- `orthToCLM` sends `1` to `1`. -/
theorem orthToCLM_one : orthToCLM (1 : E ≃ₗᵢ[ℝ] E) = 1 := ContinuousLinearMap.ext fun _ => rfl

/-- `orthToCLM` is multiplicative (composition of linear isometries). -/
theorem orthToCLM_mul (A B : E ≃ₗᵢ[ℝ] E) : orthToCLM (A * B) = orthToCLM A * orthToCLM B :=
  ContinuousLinearMap.ext fun _ => rfl

/-- `‖L‖ ≤ 1` for a linear isometry. -/
theorem norm_orthToCLM_le_one (A : E ≃ₗᵢ[ℝ] E) : ‖orthToCLM A‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun x => by simp

/-- `‖L⁻¹ − 1‖ = ‖L − 1‖` for a linear isometry. -/
theorem norm_orthToCLM_inv_sub_one (A : E ≃ₗᵢ[ℝ] E) :
    ‖orthToCLM A⁻¹ - 1‖ = ‖orthToCLM A - 1‖ := by
  have key : ∀ B : E ≃ₗᵢ[ℝ] E, ‖orthToCLM B⁻¹ - 1‖ ≤ ‖orthToCLM B - 1‖ := fun B => by
    have h1 : orthToCLM B⁻¹ * orthToCLM B = 1 := by
      rw [← orthToCLM_mul, inv_mul_cancel, orthToCLM_one]
    have e : orthToCLM B⁻¹ - 1 = -(orthToCLM B⁻¹ * (orthToCLM B - 1)) := by
      rw [mul_sub, h1, mul_one, neg_sub]
    rw [e, norm_neg]
    calc ‖orthToCLM B⁻¹ * (orthToCLM B - 1)‖ ≤ ‖orthToCLM B⁻¹‖ * ‖orthToCLM B - 1‖ :=
          norm_mul_le _ _
      _ ≤ 1 * ‖orthToCLM B - 1‖ :=
          mul_le_mul_of_nonneg_right (norm_orthToCLM_le_one _) (norm_nonneg _)
      _ = _ := one_mul _
  refine le_antisymm (key A) ?_
  simpa using key A⁻¹

/-- `‖L − 1‖ ≤ 2` for a linear isometry. -/
theorem norm_orthToCLM_sub_one_le_two (A : E ≃ₗᵢ[ℝ] E) : ‖orthToCLM A - 1‖ ≤ 2 := by
  calc ‖orthToCLM A - 1‖ ≤ ‖orthToCLM A‖ + ‖(1 : E →L[ℝ] E)‖ := norm_sub_le _ _
    _ ≤ 1 + 1 := add_le_add (norm_orthToCLM_le_one A) ContinuousLinearMap.norm_id_le
    _ = 2 := by norm_num

/-- `L(Aⁿ) x = L(A)^[n] x`. -/
theorem orthToCLM_pow_apply (A : E ≃ₗᵢ[ℝ] E) (n : ℕ) (x : E) :
    orthToCLM (A ^ n) x = (orthToCLM A)^[n] x := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
    rw [pow_succ, orthToCLM_mul, iterate_succ_apply, ← ih]
    rfl

/-- **Frobenius' lemma in `O(E)`**: if `A` commutes with `B A B⁻¹` and `B` is `½`-close to `1`,
then `A` and `B` commute. -/
theorem commute_of_commute_conj_linearIsometryEquiv [FiniteDimensional ℝ E]
    {A B : E ≃ₗᵢ[ℝ] E} (hB : ‖orthToCLM B - 1‖ < 1 / 2) (hc : Commute A (B * A * B⁻¹)) :
    Commute A B := by
  set c := A * B * A⁻¹ * B⁻¹ with hcdef
  have hcn : ∀ n : ℕ, c ^ n = A ^ n * B * A⁻¹ ^ n * B⁻¹ := by
    intro n
    have e1 : c = A * (B * A * B⁻¹)⁻¹ := by rw [hcdef]; group
    have e2 : (B * A * B⁻¹)⁻¹ = B * A⁻¹ * B⁻¹ := by group
    rw [e1, hc.inv_right.mul_pow, e2, conj_pow]
    group
  have hθ : ∀ n : ℕ, ‖orthToCLM (c ^ n) - 1‖ ≤ 2 * ‖orthToCLM B - 1‖ := by
    intro n
    rw [hcn, orthToCLM_mul, orthToCLM_mul, orthToCLM_mul]
    have hX : orthToCLM (A ^ n) * orthToCLM (A⁻¹ ^ n) = 1 := by
      rw [← orthToCLM_mul, inv_pow, mul_inv_cancel, orthToCLM_one]
    have hY : orthToCLM B * orthToCLM B⁻¹ = 1 := by
      rw [← orthToCLM_mul, mul_inv_cancel, orthToCLM_one]
    refine (norm_conj_mul_sub_one_le hX hY).trans ?_
    have h12 : ‖orthToCLM (A ^ n)‖ * ‖orthToCLM (A⁻¹ ^ n)‖ ≤ 1 :=
      mul_le_one₀ (norm_orthToCLM_le_one _) (norm_nonneg _) (norm_orthToCLM_le_one _)
    have h3 := norm_orthToCLM_le_one B⁻¹
    calc _ ≤ (1 + 1) * ‖orthToCLM B - 1‖ * 1 := by gcongr
      _ = 2 * ‖orthToCLM B - 1‖ := by ring
  have hnear : ∀ (n : ℕ) (x : E), ‖(orthToCLM c)^[n] x - x‖ ≤ 2 * ‖orthToCLM B - 1‖ * ‖x‖ := by
    intro n x
    rw [← orthToCLM_pow_apply]
    exact ((orthToCLM (c ^ n) - 1).le_opNorm x).trans
      (mul_le_mul_of_nonneg_right (hθ n) (norm_nonneg _))
  have hid := eq_self_of_forall_iterate_near (orthToCLM c) (norm_orthToCLM_le_one c)
    (by linarith) hnear
  have hc1 : c = 1 := LinearIsometryEquiv.ext fun x => hid x
  rw [hcdef, mul_inv_eq_one, mul_inv_eq_iff_eq_mul] at hc1
  exact hc1


/-- **The backward induction** (Zassenhaus): if `L(g)` is `½`-close to `1`, `L(h)` is `½`-close to
`1` and `[g, [g, …, [g, h]]] = 1` (`N` brackets), then `L(g)` and `L(h)` commute. -/
theorem commute_linearPart_of_iterate_eq_one [FiniteDimensional ℝ E] {g : E ≃ᵃⁱ[ℝ] E}
    (hg : ‖orthToCLM g.linearIsometryEquiv - 1‖ ≤ 1 / 2) (N : ℕ) :
    ∀ h : E ≃ᵃⁱ[ℝ] E, ‖orthToCLM h.linearIsometryEquiv - 1‖ < 1 / 2 →
      (fun x => g * x * g⁻¹ * x⁻¹)^[N] h = 1 →
        Commute g.linearIsometryEquiv h.linearIsometryEquiv := by
  induction N with
  | zero =>
    intro h _ hN
    rw [iterate_zero_apply] at hN
    rw [hN]
    exact Commute.one_right _
  | succ N ih =>
    intro h hhε hN
    rw [iterate_succ_apply] at hN
    set a := g.linearIsometryEquiv
    set b := h.linearIsometryEquiv
    have hlin : (g * h * g⁻¹ * h⁻¹).linearIsometryEquiv = a * b * a⁻¹ * b⁻¹ := by
      simp only [← euclLinearPart_apply, map_mul, map_inv, a, b]
    have hε' : ‖orthToCLM (g * h * g⁻¹ * h⁻¹).linearIsometryEquiv - 1‖ < 1 / 2 := by
      rw [hlin, orthToCLM_mul, orthToCLM_mul, orthToCLM_mul]
      have hX : orthToCLM a * orthToCLM a⁻¹ = 1 := by
        rw [← orthToCLM_mul, mul_inv_cancel, orthToCLM_one]
      have hY : orthToCLM b * orthToCLM b⁻¹ = 1 := by
        rw [← orthToCLM_mul, mul_inv_cancel, orthToCLM_one]
      refine (norm_mul_mul_mul_sub_one_le hX hY).trans_lt ?_
      have hai := norm_orthToCLM_le_one a⁻¹
      have hbi := norm_orthToCLM_le_one b⁻¹
      have h0 : 0 ≤ ‖orthToCLM b - 1‖ := norm_nonneg _
      calc 2 * ‖orthToCLM a - 1‖ * ‖orthToCLM b - 1‖ * ‖orthToCLM a⁻¹‖ * ‖orthToCLM b⁻¹‖
          ≤ 2 * (1 / 2) * ‖orthToCLM b - 1‖ * 1 * 1 := by gcongr
        _ < 1 / 2 := by linarith
    have hc := ih _ hε' hN
    rw [hlin] at hc
    have hu2 : Commute a (b * a * b⁻¹) := by
      have e : a * b * a⁻¹ * b⁻¹ = a * (b * a * b⁻¹)⁻¹ := by group
      rw [e] at hc
      have h2 : a * (a * (b * a * b⁻¹)⁻¹) = a * ((b * a * b⁻¹)⁻¹ * a) := by
        rw [hc.eq, mul_assoc]
      exact Commute.inv_right_iff.1 (mul_left_cancel h2)
    exact commute_of_commute_conj_linearIsometryEquiv hhε hu2

/-- `g x = L(g) x + g 0`. -/
theorem apply_eq_linear_add_apply_zero (g : E ≃ᵃⁱ[ℝ] E) (x : E) :
    g x = g.linearIsometryEquiv x + g 0 := by
  have := g.map_vadd 0 x
  rwa [vadd_eq_add, vadd_eq_add, add_zero] at this

/-- **The scaled affine extension** of a Euclidean isometry: `(y, s) ↦ (L(g) y + (s / K) • g 0, s)`.
For `K ≠ 0`, `g ↦ euclAffExt K g` is multiplicative and injective. -/
noncomputable def euclAffExt (K : ℝ) (g : E ≃ᵃⁱ[ℝ] E) : E × ℝ →L[ℝ] E × ℝ :=
  ((orthToCLM g.linearIsometryEquiv).comp (ContinuousLinearMap.fst ℝ E ℝ) +
    (ContinuousLinearMap.snd ℝ E ℝ).smulRight (K⁻¹ • g 0)).prod (ContinuousLinearMap.snd ℝ E ℝ)

theorem euclAffExt_apply (K : ℝ) (g : E ≃ᵃⁱ[ℝ] E) (y : E) (s : ℝ) :
    euclAffExt K g (y, s) = (g.linearIsometryEquiv y + (s * K⁻¹) • g 0, s) := by
  simp [euclAffExt, smul_smul]

theorem euclAffExt_mul (K : ℝ) (g h : E ≃ᵃⁱ[ℝ] E) :
    euclAffExt K (g * h) = euclAffExt K g * euclAffExt K h := by
  refine ContinuousLinearMap.ext fun ⟨y, s⟩ => ?_
  rw [show (euclAffExt K g * euclAffExt K h) (y, s) = euclAffExt K g (euclAffExt K h (y, s)) from
    rfl, euclAffExt_apply, euclAffExt_apply, euclAffExt_apply]
  have h0 : (g * h) 0 = g.linearIsometryEquiv (h 0) + g 0 := apply_eq_linear_add_apply_zero g _
  refine Prod.ext ?_ rfl
  simp only [h0, map_add, map_smul, smul_add]
  show g.linearIsometryEquiv (h.linearIsometryEquiv y) + _ = _
  abel

theorem euclAffExt_one (K : ℝ) : euclAffExt K (1 : E ≃ᵃⁱ[ℝ] E) = 1 := by
  refine ContinuousLinearMap.ext fun ⟨y, s⟩ => ?_
  rw [euclAffExt_apply]
  show (y + (s * K⁻¹) • (0 : E), s) = (y, s)
  rw [smul_zero, add_zero]

/-- `(euclAffExt K g − 1) (y, s) = (L(g) y − y + (s / K) • g 0, 0)`. -/
theorem euclAffExt_sub_one_apply (K : ℝ) (g : E ≃ᵃⁱ[ℝ] E) (y : E) (s : ℝ) :
    (euclAffExt K g - 1) (y, s) = (g.linearIsometryEquiv y - y + (s * K⁻¹) • g 0, 0) := by
  rw [show (euclAffExt K g - 1) (y, s) = euclAffExt K g (y, s) - (y, s) from rfl,
    euclAffExt_apply]
  refine Prod.ext ?_ (sub_self s)
  show _ + _ - y = _
  exact add_sub_right_comm _ _ _

/-- `‖euclAffExt K g − 1‖ ≤ ‖L(g) − 1‖ + ‖g 0‖ / K` (max norm on `E × ℝ`). -/
theorem norm_euclAffExt_sub_one_le {K : ℝ} (hK : 0 < K) (g : E ≃ᵃⁱ[ℝ] E) :
    ‖euclAffExt K g - 1‖ ≤ ‖orthToCLM g.linearIsometryEquiv - 1‖ + ‖g 0‖ / K := by
  refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun ⟨y, s⟩ => ?_
  rw [euclAffExt_sub_one_apply, Prod.norm_def, Prod.norm_def, norm_zero,
    max_eq_left (norm_nonneg _)]
  have h1 : ‖g.linearIsometryEquiv y - y‖ ≤ ‖orthToCLM g.linearIsometryEquiv - 1‖ * ‖y‖ :=
    (orthToCLM g.linearIsometryEquiv - 1).le_opNorm y
  have h2 : ‖(s * K⁻¹) • g 0‖ = ‖g 0‖ / K * ‖s‖ := by
    rw [norm_smul, norm_mul, norm_inv, Real.norm_of_nonneg hK.le]; ring
  have hy := le_max_left ‖y‖ ‖s‖
  have hs := le_max_right ‖y‖ ‖s‖
  have hA := norm_nonneg (orthToCLM g.linearIsometryEquiv - 1)
  have hB : 0 ≤ ‖g 0‖ / K := by positivity
  calc ‖g.linearIsometryEquiv y - y + (s * K⁻¹) • g 0‖
      ≤ ‖g.linearIsometryEquiv y - y‖ + ‖(s * K⁻¹) • g 0‖ := norm_add_le _ _
    _ ≤ ‖orthToCLM g.linearIsometryEquiv - 1‖ * max ‖y‖ ‖s‖ + ‖g 0‖ / K * max ‖y‖ ‖s‖ := by
        exact add_le_add (h1.trans (mul_le_mul_of_nonneg_left hy hA))
          (by rw [h2]; exact mul_le_mul_of_nonneg_left hs hB)
    _ = _ := by ring

/-- `‖g 0‖ ≤ K ‖euclAffExt K g − 1‖`: read the image of `(0, 1)`. -/
theorem norm_apply_zero_le_euclAffExt {K : ℝ} (hK : 0 < K) (g : E ≃ᵃⁱ[ℝ] E) :
    ‖g 0‖ ≤ K * ‖euclAffExt K g - 1‖ := by
  have h := (euclAffExt K g - 1).le_opNorm (0, 1)
  rw [euclAffExt_sub_one_apply, map_zero, sub_zero, zero_add, one_mul, Prod.norm_def,
    Prod.norm_def, norm_zero, norm_zero, norm_one, max_eq_left (norm_nonneg _),
    max_eq_right zero_le_one, mul_one, norm_smul, norm_inv, Real.norm_of_nonneg hK.le] at h
  rw [inv_mul_le_iff₀ hK] at h
  exact h

theorem eq_one_of_euclAffExt_eq_one {K : ℝ} (hK : 0 < K) {g : E ≃ᵃⁱ[ℝ] E}
    (h : euclAffExt K g = 1) : g = 1 := by
  have h0 : g 0 = 0 := by
    have := congrArg Prod.fst (congrArg (fun F => F ((0 : E), (1 : ℝ))) h)
    simp only [euclAffExt_apply, map_zero, zero_add, one_mul] at this
    exact (smul_eq_zero.1 this).resolve_left (inv_ne_zero hK.ne')
  have hL : ∀ y : E, g.linearIsometryEquiv y = y := fun y => by
    have := congrArg Prod.fst (congrArg (fun F => F (y, (0 : ℝ))) h)
    simpa [euclAffExt_apply] using this
  ext x
  rw [apply_eq_linear_add_apply_zero, hL, h0, add_zero]
  rfl


/-- `‖g⁻¹ 0‖ = ‖g 0‖`. -/
theorem norm_inv_apply_zero (g : E ≃ᵃⁱ[ℝ] E) : ‖g⁻¹ 0‖ = ‖g 0‖ := by
  have h1 : g (g⁻¹ 0) = 0 := by
    show (g * g⁻¹) 0 = 0
    rw [mul_inv_cancel]; rfl
  rw [← dist_zero_right, ← dist_zero_right, ← g.dist_map, h1, dist_comm]

/-- **The Engel property** (Bieberbach's contraction, made discrete): in a discrete `Γ`, an
element `g` whose linear part is `1/64`-close to `1` is an Engel element: for every `h ∈ Γ` the
iterated commutator `[g, [g, …, [g, h]]]` is eventually `1`. -/
theorem exists_iterate_commutator_eq_one_eucl {Γ : Subgroup (E ≃ᵃⁱ[ℝ] E)} (hΓ : IsDiscreteEucl Γ)
    {g h : E ≃ᵃⁱ[ℝ] E} (hg : g ∈ Γ) (hh : h ∈ Γ)
    (hgε : ‖orthToCLM g.linearIsometryEquiv - 1‖ < 1 / 64) :
    ∃ N : ℕ, (fun x => g * x * g⁻¹ * x⁻¹)^[N] h = 1 := by
  set K : ℝ := 1 + 64 * (‖g 0‖ + ‖h 0‖) with hKdef
  have hg0 := norm_nonneg (g 0)
  have hh0 := norm_nonneg (h 0)
  have hK0 : 0 < K := by positivity
  set F := euclAffExt (E := E) K with hFdef
  have hF : ∀ a b, F (a * b) = F a * F b := euclAffExt_mul K
  have hF1 : F 1 = 1 := euclAffExt_one K
  have hsmall : ‖g 0‖ / K ≤ 1 / 64 := by rw [div_le_iff₀ hK0]; linarith
  have hbig : ‖h 0‖ / K ≤ 1 := by rw [div_le_iff₀ hK0]; linarith
  have hLgi : ‖orthToCLM g⁻¹.linearIsometryEquiv - 1‖ = ‖orthToCLM g.linearIsometryEquiv - 1‖ := by
    rw [← euclLinearPart_apply, map_inv, euclLinearPart_apply, norm_orthToCLM_inv_sub_one]
  have hb1 : ‖F g - 1‖ ≤ 1 / 32 := by
    linarith [norm_euclAffExt_sub_one_le hK0 g]
  have hb2 : ‖F g⁻¹ - 1‖ ≤ 1 / 32 := by
    have := norm_euclAffExt_sub_one_le hK0 g⁻¹
    rw [hLgi, norm_inv_apply_zero] at this
    linarith
  have hb3 : ‖F h - 1‖ ≤ 3 := by
    linarith [norm_euclAffExt_sub_one_le hK0 h,
      norm_orthToCLM_sub_one_le_two h.linearIsometryEquiv]
  have hb4 : ‖F h⁻¹ - 1‖ ≤ 3 := by
    have := norm_euclAffExt_sub_one_le hK0 h⁻¹
    rw [norm_inv_apply_zero] at this
    linarith [norm_orthToCLM_sub_one_le_two h⁻¹.linearIsometryEquiv]
  have hk : ∀ k : ℕ, ‖F ((fun x => g * x * g⁻¹ * x⁻¹)^[k] h) - 1‖ ≤ 3 * (1 / 2) ^ k := fun k =>
    (norm_iterate_commutator_le (F := F) ContinuousLinearMap.norm_id_le hF hF1 hb1 hb2 hb3 hb4
      k).1
  -- the iterates lie in a finite set
  set S : Set (E ≃ᵃⁱ[ℝ] E) := {γ | γ ∈ Γ ∧ dist (γ 0) 0 ≤ 3 * K} with hSdef
  have hSf : S.Finite := hΓ 0 (3 * K)
  have hmemS : ∀ k : ℕ, (fun x => g * x * g⁻¹ * x⁻¹)^[k] h ∈ S := by
    intro k
    refine ⟨iterate_commutator_mem hg hh k, ?_⟩
    rw [dist_zero_right]
    refine (norm_apply_zero_le_euclAffExt hK0 _).trans ?_
    have hp : (1 / 2 : ℝ) ^ k ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
    have := hk k
    nlinarith
  -- a uniform positive lower bound on `‖F γ − 1‖` over `S \ {1}`
  obtain ⟨η, hη, hηle⟩ : ∃ η > 0, ∀ γ ∈ S \ {1}, η ≤ ‖F γ - 1‖ := by
    rcases (S \ {1}).eq_empty_or_nonempty with hT | hT
    · exact ⟨1, one_pos, by simp [hT]⟩
    · obtain ⟨γ₀, hγ₀, hmin⟩ := Set.exists_min_image _ (fun γ => ‖F γ - 1‖) hSf.sdiff hT
      refine ⟨‖F γ₀ - 1‖, ?_, hmin⟩
      refine (norm_nonneg (F γ₀ - 1)).lt_of_ne fun h0 => hγ₀.2 ?_
      exact eq_one_of_euclAffExt_eq_one hK0 (sub_eq_zero.1 (norm_eq_zero.1 h0.symm))
  obtain ⟨k, hk'⟩ := exists_pow_lt_of_lt_one (div_pos hη (by norm_num : (0 : ℝ) < 3))
    (show (1 / 2 : ℝ) < 1 by norm_num)
  refine ⟨k, by_contra fun hne => ?_⟩
  have := hηle _ ⟨hmemS k, hne⟩
  have := hk k
  rw [lt_div_iff₀ (by norm_num : (0 : ℝ) < 3)] at hk'
  linarith

/-- **Zassenhaus' lemma for `Isom(E)`**: in a discrete `Γ`, linear parts `1/64`-close to `1`
commute. -/
theorem commute_linearPart_of_near_one [FiniteDimensional ℝ E] {Γ : Subgroup (E ≃ᵃⁱ[ℝ] E)}
    (hΓ : IsDiscreteEucl Γ) {g h : E ≃ᵃⁱ[ℝ] E} (hg : g ∈ Γ) (hh : h ∈ Γ)
    (hgε : ‖orthToCLM g.linearIsometryEquiv - 1‖ < 1 / 64)
    (hhε : ‖orthToCLM h.linearIsometryEquiv - 1‖ < 1 / 64) :
    Commute g.linearIsometryEquiv h.linearIsometryEquiv := by
  obtain ⟨N, hN⟩ := exists_iterate_commutator_eq_one_eucl hΓ hg hh hgε
  exact commute_linearPart_of_iterate_eq_one (by linarith) N h (by linarith) hN

/-- **Step (1a)**: a discrete `Γ` has a subgroup of finite index whose linear parts pairwise
commute — the subgroup generated by the elements whose linear part is `1/64`-close to `1`. -/
theorem exists_finiteIndex_commute_linearPart [FiniteDimensional ℝ E]
    {Γ : Subgroup (E ≃ᵃⁱ[ℝ] E)} (hΓ : IsDiscreteEucl Γ) :
    ∃ Γ₁ : Subgroup (E ≃ᵃⁱ[ℝ] E), Γ₁ ≤ Γ ∧ (Γ₁.subgroupOf Γ).FiniteIndex ∧
      ∀ g ∈ Γ₁, ∀ h ∈ Γ₁, Commute g.linearIsometryEquiv h.linearIsometryEquiv := by
  set f : (E ≃ᵃⁱ[ℝ] E) → (E →L[ℝ] E) := fun γ => orthToCLM γ.linearIsometryEquiv with hfdef
  have hmul : ∀ a ∈ Γ, ∀ b ∈ Γ, f (a * b) = f a * f b := fun a _ b _ =>
    orthToCLM_mul a.linearIsometryEquiv b.linearIsometryEquiv
  have hone : f 1 = 1 := orthToCLM_one
  set S : Set (E ≃ᵃⁱ[ℝ] E) := {g | g ∈ Γ ∧ ‖f g - 1‖ < 1 / 64} with hSdef
  have hS : S ⊆ Γ := fun g hg => hg.1
  refine ⟨Subgroup.closure S, (Subgroup.closure_le Γ).2 hS, ⟨?_⟩, ?_⟩
  · exact relIndex_closure_ne_zero hmul hone (M := 1)
      (fun g _ => norm_orthToCLM_le_one g.linearIsometryEquiv) (by norm_num : (0 : ℝ) < 1 / 64)
  · intro g hg h hh
    exact commute_of_mem_closure (f := fun γ : E ≃ᵃⁱ[ℝ] E => γ.linearIsometryEquiv)
      (fun _ _ _ _ => rfl) rfl hS
      (fun a ha b hb => commute_linearPart_of_near_one hΓ ha.1 hb.1 ha.2 hb.2) hg hh

