import Causal.Flat.SelbergBase
import Mathlib.RingTheory.Jacobson.Ring
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Localization.Away.AdjoinRoot
import Mathlib.FieldTheory.Finite.Basic
import Mathlib.Algebra.Algebra.ZMod

/-!
# `Causal.Flat.SelbergResidue` — finitely generated `ℤ`-algebras have finite residue fields, of two characteristics

Step 2 of the proof of Selberg's lemma by congruence subgroups (DEC-115). **No label is marked**:
Selberg's lemma has no paper environment (Barbot cites it, [10.G]).

* `isJacobsonRing_int` — `ℤ` is a Jacobson ring (absent from mathlib at `fabf563a`).
* `finite_of_field_finiteType_int` — a field that is a finitely generated `ℤ`-algebra is finite
  (Zariski's lemma over the Jacobson base `ℤ`, `finite_of_finite_type_of_isJacobsonRing`).
* `finite_quotient_of_isMaximal` — `R ⧸ m` is finite for `m` maximal, `R` of finite type over `ℤ`.
* `residueCharsStatement` — `ResidueCharsStatement` (`Flat/SelbergBase`): a characteristic-`0`
  domain of finite type over `ℤ` has finite residue fields of two distinct characteristics.
* Primed helpers `finite_of_field_finiteType_int'`, `finite_quotient_of_isMaximal'` take an
  arbitrary `[Algebra ℤ _]` (all agree, `int_algebra_subsingleton`), so that the quotient and
  localization instances need not match the `Ring.toIntAlgebra` path.

> its residue fields at maximal ideals are finite (ℤ is Jacobson); two maximal ideals of
> distinct residue characteristics p ≠ q exist (DEC-115, the author's route)

## Hypothesis checklist
| paper hypothesis | here |
|---|---|
| `R` generated by the matrix entries, a subring of `ℝ` | ⚠ weakened: any domain of characteristic `0`, finitely generated as a `ℤ`-algebra |

## SCOPE (disclosed)
* Fully proved, no `sorry`, no axiom. The second residue field is `R[1/p] ⧸ M` itself, reached
  through the ring hom `R → R[1/p] → R[1/p] ⧸ M`; no contraction to a maximal ideal of `R` and no
  Jacobson-localization step is taken (the step statement asks for homs, not ideals of `R`).
* Zariski's lemma: `F` finite over `ℤ` forces `ringChar F = p ≠ 0` (else `ℤ ↪ F` integral makes
  `ℤ` a field), then `F` is a finite `ZMod p`-module.

Provenance: mathlib `fabf563a` (tag `v4.31.0`), pinned via `lakefile.toml`. DEC-115.
-/

namespace Causal.Flat


/-- **`ℤ` is a Jacobson ring**: its prime ideals are `⊥` and the maximal `(p)`, and
`⊥ = ⋂ₚ (p)` (an integer divisible by every prime is `0`). -/
theorem isJacobsonRing_int : IsJacobsonRing ℤ := by
  rw [isJacobsonRing_iff_prime_eq]
  intro P hP
  by_cases h : P = ⊥
  · subst h
    refine le_antisymm (fun x hx => ?_) Ideal.le_jacobson
    rw [Ideal.mem_bot]
    obtain ⟨p, hle, hp⟩ := Nat.exists_infinite_primes (x.natAbs + 1)
    have hmax : (Ideal.span {(p : ℤ)}).IsMaximal :=
      PrincipalIdealRing.isMaximal_of_irreducible (Nat.prime_iff_prime_int.mp hp).irreducible
    have hx' : x ∈ Ideal.span {(p : ℤ)} := (Ideal.mem_sInf.mp hx) ⟨bot_le, hmax⟩
    rw [Ideal.mem_span_singleton] at hx'
    exact Int.eq_zero_of_dvd_of_natAbs_lt_natAbs hx' (by simp; omega)
  · haveI := hP
    haveI := IsPrime.to_maximal_ideal h
    exact Ideal.jacobson_eq_self_of_isMaximal

/-- Zariski's lemma over `ℤ`, for an arbitrary `ℤ`-algebra structure on `F` (all agree,
`int_algebra_subsingleton`; stated generically so that no instance path has to be matched). -/
theorem finite_of_field_finiteType_int' (F : Type*) [Field F] [Algebra ℤ F]
    [Algebra.FiniteType ℤ F] : Finite F := by
  obtain rfl : ‹Algebra ℤ F› = Ring.toIntAlgebra F := Subsingleton.elim _ _
  haveI := isJacobsonRing_int
  haveI : Module.Finite ℤ F := finite_of_finite_type_of_isJacobsonRing ℤ F
  haveI : Algebra.IsIntegral ℤ F := Algebra.IsIntegral.of_finite ℤ F
  have hp0 : ringChar F ≠ 0 := by
    intro h0
    haveI : CharP F 0 := h0 ▸ ringChar.charP F
    haveI : CharZero F := CharP.charP_to_charZero F
    have hinj : Function.Injective (algebraMap ℤ F) := (algebraMap ℤ F).injective_int
    exact Int.not_isField ((Algebra.IsIntegral.isField_iff_isField hinj).mpr (Field.toIsField F))
  set p := ringChar F with hpdef
  haveI : CharP F p := ringChar.charP F
  haveI : NeZero p := ⟨hp0⟩
  haveI : Fact p.Prime := CharP.char_is_prime_of_pos F p
  letI : Algebra (ZMod p) F := ZMod.algebra F p
  haveI : Module.Finite (ZMod p) F := Module.Finite.of_restrictScalars_finite ℤ (ZMod p) F
  exact Module.finite_of_finite (ZMod p)

/-- **A field of finite type over `ℤ` is finite** (Zariski's lemma over `ℤ`). -/
theorem finite_of_field_finiteType_int (F : Type*) [Field F] [Algebra.FiniteType ℤ F] :
    Finite F :=
  finite_of_field_finiteType_int' F

/-- `finite_quotient_of_isMaximal` for an arbitrary `ℤ`-algebra structure on `R`. -/
theorem finite_quotient_of_isMaximal' (R : Type*) [CommRing R] [Algebra ℤ R]
    [Algebra.FiniteType ℤ R] (m : Ideal R) [m.IsMaximal] : Finite (R ⧸ m) := by
  haveI : Algebra.FiniteType ℤ (R ⧸ m) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ℤ m) (Ideal.Quotient.mkₐ_surjective ℤ m)
  letI := Ideal.Quotient.field m
  exact finite_of_field_finiteType_int' (R ⧸ m)

/-- **The residue fields of a ring of finite type over `ℤ` are finite.** -/
theorem finite_quotient_of_isMaximal (R : Type*) [CommRing R] [Algebra.FiniteType ℤ R]
    (m : Ideal R) [m.IsMaximal] : Finite (R ⧸ m) :=
  finite_quotient_of_isMaximal' R m

/-- **Step 2**: a characteristic-`0` domain of finite type over `ℤ` has finite residue fields of
two distinct characteristics `p ≠ q`: any maximal `m` (characteristic `p`), and a maximal ideal of
`R[1/p]`, nonzero since `p ≠ 0` in `R`, in whose residue field `p` is a unit. -/
theorem residueCharsStatement : ResidueCharsStatement := by
  intro R _ _ _ _
  obtain ⟨m, hm⟩ := Ideal.exists_maximal R
  letI := Ideal.Quotient.field m
  haveI := finite_quotient_of_isMaximal R m
  set p := ringChar (R ⧸ m) with hpdef
  haveI : CharP (R ⧸ m) p := ringChar.charP _
  have hp : p.Prime := CharP.char_is_prime (R ⧸ m) p
  have hpR : (p : R) ≠ 0 := Nat.cast_ne_zero.mpr hp.ne_zero
  have hinj : Function.Injective (algebraMap R (Localization.Away (p : R))) :=
    IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors hpR)
  haveI : Nontrivial (Localization.Away (p : R)) := hinj.nontrivial
  obtain ⟨M, hM⟩ := Ideal.exists_maximal (Localization.Away (p : R))
  letI := Ideal.Quotient.field M
  haveI := finite_quotient_of_isMaximal' (Localization.Away (p : R)) M
  refine ⟨R ⧸ m, Localization.Away (p : R) ⧸ M, inferInstance, inferInstance, inferInstance,
    inferInstance, Ideal.Quotient.mk m,
    (Ideal.Quotient.mk M).comp (algebraMap R (Localization.Away (p : R))), ?_⟩
  intro heq
  haveI : CharP (Localization.Away (p : R) ⧸ M) p := ringChar.of_eq (heq.symm.trans hpdef.symm)
  have hu : IsUnit (algebraMap R (Localization.Away (p : R)) (p : R)) :=
    IsLocalization.Away.algebraMap_isUnit _
  have hu2 := hu.map (Ideal.Quotient.mk M)
  simp only [map_natCast, CharP.cast_eq_zero] at hu2
  exact not_isUnit_zero hu2

end Causal.Flat
