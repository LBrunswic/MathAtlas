import Causal.Flat.SelbergBase

/-!
# `Causal.Flat.SelbergMatrix` — Selberg's lemma reduced to congruence kernels over a ring of entries

Step 1 and step 5 of the proof of Selberg's lemma by congruence subgroups (DEC-115), from the two
step statements of `Flat/SelbergBase` (`ResidueCharsStatement`, `CongrStatement`) taken as
hypotheses, so that this file is provable in parallel with `Flat/SelbergResidue` and
`Flat/SelbergTorsion`. **No label is marked**: Selberg's lemma has no paper environment (Barbot
cites it, [10.G]).

* `glEntries S` — the entries of the matrices `s` and `s⁻¹`, `s ∈ S`; finite (`glEntries_finite`).
* `entryAlg S := Algebra.adjoin ℤ (glEntries S)` — a subring of `ℝ`, of finite type over `ℤ`
  (`entryAlg_finiteType`), a domain of characteristic `0`.
* `glIncl A n : GL_n(A) →* GL_n(ℝ)` — entrywise inclusion, injective (`glIncl_injective`);
  `mem_range_glIncl_of_entries` (the lift), `closure_le_range_glIncl`: `⟨S⟩ ≤ GL_n(entryAlg S)`.
* `selbergProperty_GL_of` — the matrix form `SelbergProperty (GL (Fin n) ℝ)`, and
  `selbergLemma_of_statements` — `SelbergLemma V` for every finite-dimensional real `V`, **no
  `sorry`** beyond the step modules'.

> the entries of the generators generate a finitely generated subring R ⊂ ℝ (…);
> G ∩ Γ(m) ∩ Γ(m′) is torsion-free of finite index (DEC-115, the author's route)

## Hypothesis checklist
| paper hypothesis | here |
|---|---|
| finitely generated subgroup of `GL(n, ℝ)` | ✓ carried (`G.FG`); every finite-dimensional real `V` through a basis |

## SCOPE (disclosed)
* **No `sorry`** in this file (the five prover tasks of DEC-115's skeleton are proved). The step
  `⟨S⟩ ≤ GL_n(entryAlg S)` goes through `mem_range_glIncl_of_entries` (a lift of a real matrix
  whose entries and inverse entries lie in `A`), by injectivity of the entrywise inclusion
  `RingHom.mapMatrix` and its multiplicativity.
* `ResidueCharsStatement` and `CongrStatement` are hypotheses here, discharged in
  `Flat/SelbergProof`.

Provenance: mathlib `fabf563a` (tag `v4.31.0`), pinned via `lakefile.toml`. DEC-115.
-/

namespace Causal.Flat

open Function

/-- The entries of the matrices `s` and `s⁻¹`, for `s ∈ S`. -/
def glEntries {n : ℕ} (S : Finset (Matrix.GeneralLinearGroup (Fin n) ℝ)) : Set ℝ :=
  {x | ∃ s ∈ S, ∃ i j : Fin n,
    x = (s : Matrix (Fin n) (Fin n) ℝ) i j ∨ x = ((s⁻¹ : Matrix.GeneralLinearGroup (Fin n) ℝ) :
      Matrix (Fin n) (Fin n) ℝ) i j}

theorem glEntries_finite {n : ℕ} (S : Finset (Matrix.GeneralLinearGroup (Fin n) ℝ)) :
    (glEntries S).Finite := by
  classical
  refine (Set.finite_range (fun x : S × Fin n × Fin n × Bool =>
    if x.2.2.2 then ((x.1 : Matrix.GeneralLinearGroup (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ)
        x.2.1 x.2.2.1
      else (((x.1 : Matrix.GeneralLinearGroup (Fin n) ℝ)⁻¹ : Matrix.GeneralLinearGroup (Fin n) ℝ) :
        Matrix (Fin n) (Fin n) ℝ) x.2.1 x.2.2.1)).subset ?_
  rintro x ⟨s, hs, i, j, h | h⟩
  · exact ⟨⟨⟨s, hs⟩, i, j, true⟩, by simp [h]⟩
  · exact ⟨⟨⟨s, hs⟩, i, j, false⟩, by simp [h]⟩

/-- **The ring of entries**: the `ℤ`-subalgebra of `ℝ` generated by `glEntries S`. -/
noncomputable def entryAlg {n : ℕ} (S : Finset (Matrix.GeneralLinearGroup (Fin n) ℝ)) :
    Subalgebra ℤ ℝ :=
  Algebra.adjoin ℤ (glEntries S)

theorem entryAlg_finiteType {n : ℕ} (S : Finset (Matrix.GeneralLinearGroup (Fin n) ℝ)) :
    Algebra.FiniteType ℤ (entryAlg S) :=
  Algebra.FiniteType.adjoin_of_finite (glEntries_finite S)

/-- Entrywise inclusion `GL_n(A) →* GL_n(ℝ)` of a subalgebra `A ≤ ℝ`. -/
noncomputable def glIncl (A : Subalgebra ℤ ℝ) (n : ℕ) :
    Matrix.GeneralLinearGroup (Fin n) A →* Matrix.GeneralLinearGroup (Fin n) ℝ :=
  Matrix.GeneralLinearGroup.map (n := Fin n) (A.val : A →+* ℝ)

theorem glIncl_injective (A : Subalgebra ℤ ℝ) (n : ℕ) : Injective (glIncl A n) := by
  intro a b h
  ext i j
  have := congrArg (fun g : Matrix.GeneralLinearGroup (Fin n) ℝ =>
    (g : Matrix (Fin n) (Fin n) ℝ) i j) h
  simp only [glIncl, Matrix.GeneralLinearGroup.map_apply] at this
  exact this

/-- **Lifting to `GL_n(A)`**: a matrix of `GL_n(ℝ)` whose entries, and those of its inverse, lie
in `A` is the image of a unit of `Matrix (Fin n) (Fin n) A` under `glIncl A n`. -/
theorem mem_range_glIncl_of_entries (A : Subalgebra ℤ ℝ) {n : ℕ}
    (s : Matrix.GeneralLinearGroup (Fin n) ℝ)
    (h₁ : ∀ i j, (s : Matrix (Fin n) (Fin n) ℝ) i j ∈ A)
    (h₂ : ∀ i j, ((s⁻¹ : Matrix.GeneralLinearGroup (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ) i j ∈ A) :
    s ∈ (glIncl A n).range := by
  let M : Matrix (Fin n) (Fin n) A := Matrix.of fun i j => ⟨_, h₁ i j⟩
  let N : Matrix (Fin n) (Fin n) A := Matrix.of fun i j => ⟨_, h₂ i j⟩
  have hinj : Injective (fun X : Matrix (Fin n) (Fin n) A => (A.val : A →+* ℝ).mapMatrix X) :=
    fun X Y hXY => Matrix.ext fun i j => Subtype.val_injective (congr_fun (congr_fun hXY i) j)
  have hM : (A.val : A →+* ℝ).mapMatrix M = (s : Matrix (Fin n) (Fin n) ℝ) := by
    ext i j; rfl
  have hN : (A.val : A →+* ℝ).mapMatrix N =
      ((s⁻¹ : Matrix.GeneralLinearGroup (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ) := by
    ext i j; rfl
  have hMN : M * N = 1 := hinj (by
    simp only [map_mul, map_one, hM, hN]
    exact Units.mul_inv s)
  have hNM : N * M = 1 := hinj (by
    simp only [map_mul, map_one, hM, hN]
    exact Units.inv_mul s)
  exact ⟨⟨M, N, hMN, hNM⟩, Units.ext hM⟩

/-- **Step 1**: every element of `⟨S⟩` has its entries (and those of its inverse) in `entryAlg S`. -/
theorem closure_le_range_glIncl {n : ℕ} (S : Finset (Matrix.GeneralLinearGroup (Fin n) ℝ)) :
    Subgroup.closure (S : Set (Matrix.GeneralLinearGroup (Fin n) ℝ)) ≤
      (glIncl (entryAlg S) n).range := by
  rw [Subgroup.closure_le]
  intro s hs
  exact mem_range_glIncl_of_entries _ s
    (fun i j => Algebra.subset_adjoin ⟨s, hs, i, j, Or.inl rfl⟩)
    (fun i j => Algebra.subset_adjoin ⟨s, hs, i, j, Or.inr rfl⟩)

/-- **Steps 1 + 5, the matrix form**: from the step statements, every finitely generated
`G ≤ GL_n(ℝ)` has a torsion-free subgroup of finite index, namely
`ι (ι⁻¹ G ⊓ Γ(φ₁) ⊓ Γ(φ₂))`. -/
theorem selbergProperty_GL_of (hR : ResidueCharsStatement) (hC : CongrStatement) (n : ℕ) :
    SelbergProperty (Matrix.GeneralLinearGroup (Fin n) ℝ) := by
  intro G hG
  obtain ⟨S, rfl⟩ := hG
  -- `ResidueCharsStatement` reads `Algebra.FiniteType` for the `ℤ`-algebra structure of a ring
  -- (`Ring.toIntAlgebra`), which agrees definitionally with the subalgebra's.
  haveI : @Algebra.FiniteType ℤ (entryAlg S) _ _ (Ring.toIntAlgebra _) :=
    entryAlg_finiteType S
  obtain ⟨F₁, F₂, _, _, _, _, φ₁, φ₂, hne⟩ := hR (entryAlg S)
  obtain ⟨hidx, htf⟩ := hC n (entryAlg S) F₁ F₂ φ₁ φ₂ hne
  have hinj := glIncl_injective (entryAlg S) n
  have hG : ((Subgroup.closure (S : Set (Matrix.GeneralLinearGroup (Fin n) ℝ))).comap
      (glIncl (entryAlg S) n)).map (glIncl (entryAlg S) n) = Subgroup.closure (S : Set _) :=
    Subgroup.map_comap_eq_self (closure_le_range_glIncl S)
  refine ⟨(((Subgroup.closure (S : Set (Matrix.GeneralLinearGroup (Fin n) ℝ))).comap
      (glIncl (entryAlg S) n)) ⊓ (congrKer n φ₁ ⊓ congrKer n φ₂)).map (glIncl (entryAlg S) n),
    ?_, ?_, ?_⟩
  · rw [Subgroup.map_le_iff_le_comap]
    exact inf_le_left
  · conv_lhs => arg 2; rw [← hG]
    rw [Subgroup.relIndex_map_map_of_injective _ _ hinj, Subgroup.inf_relIndex_left]
    exact mt (Subgroup.relIndex_eq_zero_of_le_right le_top) (by rwa [Subgroup.relIndex_top_right])
  · rintro g ⟨g', hg', rfl⟩ hfin
    rw [hinj.isOfFinOrder_iff] at hfin
    rw [htf g' hg'.2 hfin, map_one]

/-- **Selberg's lemma from the step statements**, for every finite-dimensional real `V`. -/
theorem selbergLemma_of_statements (hR : ResidueCharsStatement) (hC : CongrStatement)
    (V : Type*) [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V] : SelbergLemma V :=
  selbergLemma_of_selbergProperty_GL (selbergProperty_GL_of hR hC) V

end Causal.Flat
