import Mathlib.Topology.Algebra.Module.FiniteDimension
import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.Analysis.Normed.Ring.Units
import Mathlib.LinearAlgebra.AffineSpace.AffineEquiv
import Mathlib.GroupTheory.Nilpotent
import Mathlib.Topology.Connected.Basic

/-!
# `Causal.Flat.AffACDBase` — the statement of `bthm:ausl` for `Aff(V)`: topology, `L`, `G₀`, `Γ_nd`, `Γ_ε`

T. Barbot, *Globally hyperbolic flat space-times* (`papers/barbot`, arXiv math/0402257), §5,
Theorem 5.1 (`bthm:ausl`, `GHFspace.tex:1696`), the Auslander–Carrière–Dal'bo theorem, in the
PRINTED generality (DEC-123): a discrete subgroup of the affine group `Aff(n, ℝ)`, not only of
`Isom(𝐌ⁿ)` (the DEC-36 / DEC-121 form `AuslanderCarriereDalbo d` of `Flat/Externals`, which
becomes a corollary in `Flat/AffACDProof`). **No ledger label is certified here**: this module
fixes the definitions only (sorry-free); the certificate is `Flat/AffACDProof`.

> Let $\Gamma$ be a discrete subgroup of $\mbox{Aff}(n, {\mathbb R})$.
> Then, the identity component $G_{0}$ of
> the closure of $L(\Gamma)$ in $GL(n, {\mathbb R})$ is nilpotent.
> In particular, $\Gamma_{nd} = L^{-1}(G_{0} \cap L(\Gamma))$
> is nilpotent. (l.1699–1703)

## The forms (new definitions; nothing of `Flat/Externals` is changed)

* `ℝⁿ` is any finite-dimensional real normed space `V` (Barbot's `ℝⁿ` is
  `EuclideanSpace ℝ (Fin n)`; `Minkowski d` is the Isom case). `Aff(n, ℝ)` is `V ≃ᵃ[ℝ] V`.
* `GL(n, ℝ)` is `(V →L[ℝ] V)ˣ` with mathlib's topology on units, which for the complete normed
  ring `V →L[ℝ] V` is the operator-norm (matrix) subspace topology (`Units.isOpenEmbedding_val`);
  `L = affLin`, the linear part, a monoid hom.
* `Aff(n, ℝ)` carries the topology of its embedding in `GL(n + 1, ℝ)`, i.e. the topology induced
  by `g ↦ (L(g), g 0) ∈ End(V) × V` (`affTopology`). It is a **definition, not an instance**: an
  instance on `V ≃ᵃ[ℝ] V` would put a second topology on `↥(isom d)` beside the scoped
  `isomTopology`, an instance diamond. Discreteness is `AffDiscrete Γ`, literally
  `DiscreteTopology Γ` for the subspace topology of `affTopology`.
* `G₀ = affG0 Γ`, the connected component of `1` in the closure of `L(Γ)` in `GL`.
* `Γ_nd = affNonDiscretePart Γ = Γ ∩ L⁻¹(⟨G₀⟩)`, with `G₀` replaced by the subgroup it generates
  (equal to it: `G₀` is a subgroup), exactly as `nonDiscretePart` (Externals).
* `Γ_ε = affNearSubgroup Γ ε`, generated by the `γ ∈ Γ` with `‖L(γ) − 1‖ < ε` (route object).

## Hypothesis checklist

| paper hypothesis | here |
|---|---|
| `Γ` discrete in `Aff(n, ℝ)` (l.1699) | ✓ carried: `AffDiscrete Γ` (the natural topology of `Aff ⊆ GL(n+1)`) |
| closure of `L(Γ)` in `GL(n, ℝ)` (l.1700–1701) | ✓ carried: closure in `(V →L[ℝ] V)ˣ` |

## SCOPE (disclosed)

* Definitions only. `G₀` is used through the subgroup it generates, as in `Flat/Externals`.

Provenance: mathlib `fabf563a` (tag `v4.31.0`), pinned via `lakefile.toml`. Barbot campaign,
DEC-123 (printed generality), route: `docs/CARRIERE-DALBO-SURVEY.md` §2.2 T2 with the uniform
class bound of `Flat/AffACDTriang`.
-/

namespace Causal.Flat

open Topology Module

section AffBase

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]

/-- **Barbot's `L`** on `Aff(V)`: the linear part, as an element of `GL(V) = (V →L[ℝ] V)ˣ`. -/
noncomputable def affLin : (V ≃ᵃ[ℝ] V) →* (V →L[ℝ] V)ˣ where
  toFun g := (ContinuousLinearEquiv.unitsEquiv ℝ V).symm g.linear.toContinuousLinearEquiv
  map_one' := by ext; rfl
  map_mul' g h := by ext; rfl

@[simp] theorem affLin_apply (g : V ≃ᵃ[ℝ] V) (v : V) :
    ((affLin g : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) v = g.linear v := rfl

omit [FiniteDimensional ℝ V] in
/-- `g x = L(g) x + g 0`. -/
theorem aff_apply_eq (g : V ≃ᵃ[ℝ] V) (x : V) : g x = g.linear x + g 0 := by
  have := g.toAffineMap.linearMap_vsub x 0
  rw [vsub_eq_sub, vsub_eq_sub, sub_zero] at this
  have e : (g.toAffineMap).linear = (g.linear : V →ₗ[ℝ] V) := rfl
  rw [e] at this
  show g.toAffineMap x = _
  rw [show g.toAffineMap 0 = g 0 from rfl] at this
  have h2 : g.linear x = g.toAffineMap x - g 0 := this
  rw [h2]; abel

/-- The pair (linear part, translation part) `g ↦ (L(g), g 0)`. -/
noncomputable def affPair (g : V ≃ᵃ[ℝ] V) : (V →L[ℝ] V) × V :=
  (((affLin g : (V →L[ℝ] V)ˣ) : V →L[ℝ] V), g 0)

theorem affPair_injective : Function.Injective (affPair (V := V)) := by
  intro g h hgh
  have h1 : ((affLin g : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) = ((affLin h : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) :=
    congrArg Prod.fst hgh
  have h2 : g 0 = h 0 := congrArg Prod.snd hgh
  refine AffineEquiv.ext fun x => ?_
  rw [aff_apply_eq g, aff_apply_eq h, h2]
  have := congrArg (fun f : V →L[ℝ] V => f x) h1
  simp only [affLin_apply] at this
  rw [this]

/-- **The topology of `Aff(n, ℝ)`**: induced by `g ↦ (L(g), g 0)`, i.e. the subspace topology of
`Aff(n, ℝ) ⊆ GL(n + 1, ℝ)`. A definition, not an instance (module docstring). -/
@[reducible] noncomputable def affTopology : TopologicalSpace (V ≃ᵃ[ℝ] V) :=
  TopologicalSpace.induced affPair inferInstance

/-- **`Γ` is a discrete subgroup of `Aff(n, ℝ)`**: `DiscreteTopology Γ` for the subspace topology
of `affTopology`. -/
def AffDiscrete (Γ : Subgroup (V ≃ᵃ[ℝ] V)) : Prop :=
  @DiscreteTopology Γ (TopologicalSpace.induced Subtype.val affTopology)

/-- Barbot's `L(Γ)`, a subgroup of `GL(V)`. -/
noncomputable abbrev affLinearImage (Γ : Subgroup (V ≃ᵃ[ℝ] V)) : Subgroup (V →L[ℝ] V)ˣ :=
  Γ.map affLin

/-- Barbot's `G₀`: the identity component of the closure of `L(Γ)` in `GL(V)` (l.1700–1701). -/
def affG0 (Γ : Subgroup (V ≃ᵃ[ℝ] V)) : Set (V →L[ℝ] V)ˣ :=
  connectedComponentIn (closure (affLinearImage Γ : Set (V →L[ℝ] V)ˣ)) 1

/-- Barbot's `Γ_nd = L⁻¹(G₀ ∩ L(Γ)) ∩ Γ` (l.1702–1703), with `G₀` replaced by the subgroup it
generates (equal to it, `G₀` being a subgroup), as `nonDiscretePart` in `Flat/Externals`. -/
noncomputable def affNonDiscretePart (Γ : Subgroup (V ≃ᵃ[ℝ] V)) : Subgroup (V ≃ᵃ[ℝ] V) :=
  Γ ⊓ (Subgroup.closure (affG0 Γ)).comap affLin

theorem affNonDiscretePart_le (Γ : Subgroup (V ≃ᵃ[ℝ] V)) : affNonDiscretePart Γ ≤ Γ :=
  inf_le_left

/-- The conclusion of `bthm:ausl` for one `Γ ≤ Aff(V)`: `G₀` and `Γ_nd` are nilpotent. -/
def AffAusConclusion (Γ : Subgroup (V ≃ᵃ[ℝ] V)) : Prop :=
  Group.IsNilpotent (Subgroup.closure (affG0 Γ)) ∧ Group.IsNilpotent (affNonDiscretePart Γ)

variable (V) in
/-- **Auslander's theorem, refined by Carrière and Dal'bo** (`bthm:ausl`, l.1697–1704, `cardal`
Theorem 1.2.1), in the printed generality: for every discrete subgroup of `Aff(V)`. Proved as
`affAuslanderCarriereDalbo` in `Flat/AffACDProof`. -/
def AffAuslanderCarriereDalbo : Prop :=
  ∀ Γ : Subgroup (V ≃ᵃ[ℝ] V), AffDiscrete Γ → AffAusConclusion Γ

/-- The generators of `Γ_ε`: the `γ ∈ Γ` whose linear part is `ε`-close to `1`. -/
def affNearSet (Γ : Subgroup (V ≃ᵃ[ℝ] V)) (ε : ℝ) : Set (V ≃ᵃ[ℝ] V) :=
  {g | g ∈ Γ ∧ ‖((affLin g : (V →L[ℝ] V)ˣ) : V →L[ℝ] V) - 1‖ < ε}

/-- `Γ_ε`: the subgroup generated by `affNearSet Γ ε`. -/
noncomputable def affNearSubgroup (Γ : Subgroup (V ≃ᵃ[ℝ] V)) (ε : ℝ) : Subgroup (V ≃ᵃ[ℝ] V) :=
  Subgroup.closure (affNearSet Γ ε)

theorem affNearSubgroup_le (Γ : Subgroup (V ≃ᵃ[ℝ] V)) (ε : ℝ) : affNearSubgroup Γ ε ≤ Γ :=
  (Subgroup.closure_le Γ).2 fun _ hg => hg.1

/-! ### The uniform class bound, as a statement -/

end AffBase

section ClassBound

variable (W : Type*) [NormedAddCommGroup W] [NormedSpace ℝ W] [FiniteDimensional ℝ W]

/-- **The uniform class bound** (the linear input of the affine route, proved as
`affNearOneClassBound` in `Flat/AffACDTriang`): a nilpotent subgroup of `GL(W)` generated by
elements `1/3`-close to `1` has `γ_{dim W + 1} = 1`. Stated here, as a `Prop`, so that
`Flat/AffACDLocal` and `Flat/AffACDTriang` are independent leaves over this module. -/
def AffNearOneClassBound : Prop :=
  ∀ X : Set (W →L[ℝ] W)ˣ, Group.IsNilpotent (Subgroup.closure X) →
    (∀ x ∈ X, ‖((x : (W →L[ℝ] W)ˣ) : W →L[ℝ] W) - 1‖ < 1 / 3) →
      (Subgroup.closure X).lowerCentralSeries (finrank ℝ W) = ⊥

end ClassBound

section AffExt

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]

/-! ### The affine extension `ĝ ∈ GL(V × ℝ)` -/

/-- **The affine extension** `ĝ (y, s) = (L(g) y + s • g 0, s)`, a continuous linear endomorphism
of `V × ℝ` (the embedding `Aff(n) ⊆ GL(n + 1)`). Generalises `affExt` (`Flat/TitsNull`). -/
noncomputable def affExtV (g : V ≃ᵃ[ℝ] V) : V × ℝ →L[ℝ] V × ℝ :=
  LinearMap.toContinuousLinearMap
    (((g.linear : V →ₗ[ℝ] V).comp (LinearMap.fst ℝ V ℝ) +
      (LinearMap.snd ℝ V ℝ).smulRight (g 0)).prod (LinearMap.snd ℝ V ℝ))

theorem affExtV_apply (g : V ≃ᵃ[ℝ] V) (y : V) (s : ℝ) :
    affExtV g (y, s) = (g.linear y + s • g 0, s) := rfl

theorem affExtV_mul (g h : V ≃ᵃ[ℝ] V) : affExtV (g * h) = affExtV g * affExtV h := by
  refine ContinuousLinearMap.ext fun ⟨y, s⟩ => ?_
  rw [show (affExtV g * affExtV h) (y, s) = affExtV g (affExtV h (y, s)) from rfl, affExtV_apply, affExtV_apply, affExtV_apply]
  refine Prod.ext ?_ rfl
  show (g * h).linear y + s • (g * h) 0 = g.linear (h.linear y + s • h 0) + s • g 0
  rw [show (g * h) 0 = g (h 0) from rfl, aff_apply_eq g (h 0), map_add, map_smul, smul_add,
    show (g * h).linear y = g.linear (h.linear y) from rfl]
  abel

theorem affExtV_one : affExtV (1 : V ≃ᵃ[ℝ] V) = 1 := by
  refine ContinuousLinearMap.ext fun ⟨y, s⟩ => ?_
  rw [affExtV_apply]
  refine Prod.ext ?_ rfl
  show y + s • (0 : V) = y
  rw [smul_zero, add_zero]

/-- The affine extension as a monoid hom into `GL(V × ℝ)`. -/
noncomputable def affExtU : (V ≃ᵃ[ℝ] V) →* (V × ℝ →L[ℝ] V × ℝ)ˣ where
  toFun g := ⟨affExtV g, affExtV g⁻¹, by rw [← affExtV_mul, mul_inv_cancel, affExtV_one],
    by rw [← affExtV_mul, inv_mul_cancel, affExtV_one]⟩
  map_one' := Units.ext affExtV_one
  map_mul' g h := Units.ext (affExtV_mul g h)

@[simp] theorem affExtU_val (g : V ≃ᵃ[ℝ] V) :
    ((affExtU g : (V × ℝ →L[ℝ] V × ℝ)ˣ) : V × ℝ →L[ℝ] V × ℝ) = affExtV g := rfl

theorem affExtU_injective : Function.Injective (affExtU (V := V)) := by
  intro g h hgh
  have e : affExtV g = affExtV h := congrArg Units.val hgh
  refine AffineEquiv.ext fun x => ?_
  have := congrArg (fun f : V × ℝ →L[ℝ] V × ℝ => (f (x, 1)).1) e
  simp only [affExtV_apply, one_smul] at this
  rw [aff_apply_eq g, aff_apply_eq h, this]

end AffExt

end Causal.Flat
