namespace Causal.Flat

open Set Topology Module

variable {d : ℕ}

/-- **The local commutation property (★_Γ)** (survey §2.2): some `ε > 0` makes any two elements
of `L(Γ)` within `ε` of `1` (operator norm on `Minkowski d`) commute. -/
def ACDStar (Γ : Subgroup (isom d)) : Prop :=
  ∃ ε > 0, ∀ g ∈ Γ, ∀ h ∈ Γ, ‖linToCLM (linOf g) - 1‖ < ε → ‖linToCLM (linOf h) - 1‖ < ε →
    linOf g * linOf h = linOf h * linOf g

/-- `Γ_ε`: the subgroup generated by the elements of `Γ` whose linear part is `ε`-close to `1`. -/
noncomputable def nearSubgroup (Γ : Subgroup (isom d)) (ε : ℝ) : Subgroup (isom d) :=
  Subgroup.closure {g | g ∈ Γ ∧ ‖linToCLM (linOf g) - 1‖ < ε}

theorem nearSubgroup_le (Γ : Subgroup (isom d)) (ε : ℝ) : nearSubgroup Γ ε ≤ Γ :=
  (Subgroup.closure_le Γ).2 fun _ hg => hg.1

/-- Under (★) with constant `ε`, the linear parts of `Γ_ε` pairwise commute. -/
theorem linOf_comm_of_mem_nearSubgroup {Γ : Subgroup (isom d)} {ε : ℝ}
    (hloc : ∀ g ∈ Γ, ∀ h ∈ Γ, ‖linToCLM (linOf g) - 1‖ < ε → ‖linToCLM (linOf h) - 1‖ < ε →
      linOf g * linOf h = linOf h * linOf g) :
    ∀ g ∈ nearSubgroup Γ ε, ∀ h ∈ nearSubgroup Γ ε, linOf g * linOf h = linOf h * linOf g := by
  intro g hg h hh
  exact commute_of_mem_closure (Γ := Γ) (f := linOf) (fun a _ b _ => linOf_mul a b) linOf_one'
    (fun _ hx => hx.1) (fun a ha b hb => hloc a ha.1 b hb.1 ha.2 hb.2) hg hh

/-! ### Step 3: `cl L(Γ_ε)` is open in `cl L(Γ)` -/

/-- The near-identity ball of `SO₀(1, d)`. -/
def acdBall (ε : ℝ) : Set (lorentz d) :=
  {A | ‖linToCLM (A : Minkowski d ≃ₗ[ℝ] Minkowski d) - 1‖ < ε}

theorem isOpen_acdBall (ε : ℝ) : IsOpen (acdBall (d := d) ε) := by
  have : acdBall (d := d) ε =
      (fun A : lorentz d => linToCLM (A : Minkowski d ≃ₗ[ℝ] Minkowski d)) ⁻¹' Metric.ball 1 ε := by
    ext A; simp [acdBall, Metric.mem_ball, dist_eq_norm]
  rw [this]; exact Metric.isOpen_ball.preimage continuous_lorentz_linToCLM

theorem one_mem_acdBall {ε : ℝ} (hε : 0 < ε) : (1 : lorentz d) ∈ acdBall ε := by
  show ‖linToCLM ((1 : lorentz d) : Minkowski d ≃ₗ[ℝ] Minkowski d) - 1‖ < ε
  rw [show ((1 : lorentz d) : Minkowski d ≃ₗ[ℝ] Minkowski d) = 1 from rfl, linToCLM_one, sub_self,
    norm_zero]
  exact hε

/-- An element of `L(Γ)` in the ball is the linear part of a generator of `Γ_ε`. -/
theorem linearImage_inter_acdBall_subset (Γ : Subgroup (isom d)) (ε : ℝ) :
    (linearImage Γ : Set (lorentz d)) ∩ acdBall ε ⊆ ((nearSubgroup Γ ε).map linearPart : Set _) := by
  rintro _ ⟨⟨g, hg, rfl⟩, hb⟩
  exact ⟨g, Subgroup.subset_closure ⟨hg, hb⟩, rfl⟩

theorem closure_linearImage_inter_acdBall_subset (Γ : Subgroup (isom d)) {ε : ℝ} :
    closure (linearImage Γ : Set (lorentz d)) ∩ acdBall ε ⊆
      closure (((nearSubgroup Γ ε).map linearPart : Subgroup (lorentz d)) : Set (lorentz d)) := by
  intro x hx
  have h := (isOpen_acdBall ε).closure_inter (s := (linearImage Γ : Set (lorentz d))) hx
  refine closure_mono (fun y hy => ?_) h
  exact linearImage_inter_acdBall_subset Γ ε ⟨hy.1, hy.2⟩

/-- **Step 3, topological half**: `G₀ ⊆ cl L(Γ_ε)` for every `ε > 0` — `cl L(Γ_ε)` is a
subgroup of `cl L(Γ)` containing `cl L(Γ) ∩ B(1, ε)`, hence open, hence clopen in `cl L(Γ)`. -/
theorem linClosureIdentityComponent_subset_near (Γ : Subgroup (isom d)) {ε : ℝ} (hε : 0 < ε) :
    linClosureIdentityComponent Γ ⊆
      closure (((nearSubgroup Γ ε).map linearPart : Subgroup (lorentz d)) : Set (lorentz d)) := by
  haveI := Lox.lorentz_isTopologicalGroup (d := d)
  set F : Subgroup (lorentz d) := (linearImage Γ).topologicalClosure with hFdef
  set O : Subgroup (lorentz d) := ((nearSubgroup Γ ε).map linearPart).topologicalClosure with hOdef
  have hF : (F : Set (lorentz d)) = closure (linearImage Γ : Set (lorentz d)) := rfl
  have hO : (O : Set (lorentz d)) =
      closure (((nearSubgroup Γ ε).map linearPart : Subgroup (lorentz d)) : Set (lorentz d)) := rfl
  have hOF : ∀ x ∈ O, x ∈ F := fun x hx => by
    have hx' : x ∈ (O : Set (lorentz d)) := hx
    show x ∈ (F : Set (lorentz d))
    rw [hO] at hx'; rw [hF]
    refine closure_mono (fun y hy => Subgroup.map_mono (nearSubgroup_le Γ ε) hy) hx'
  have hFB : ∀ x ∈ F, x ∈ acdBall ε → x ∈ O := fun x hx hb => by
    have hx' : x ∈ (F : Set (lorentz d)) := hx
    show x ∈ (O : Set (lorentz d))
    rw [hO]; rw [hF] at hx'; exact closure_linearImage_inter_acdBall_subset Γ ⟨hx', hb⟩
  set W := acdBall (d := d) ε
  set u : Set (lorentz d) := ⋃ o ∈ (O : Set (lorentz d)), (fun x => o⁻¹ * x) ⁻¹' W
  set v : Set (lorentz d) := ⋃ o ∈ (F : Set (lorentz d)) \ O, (fun x => o⁻¹ * x) ⁻¹' W
  have hu : IsOpen u := isOpen_biUnion fun o _ =>
    (isOpen_acdBall ε).preimage (continuous_const.mul continuous_id)
  have hv : IsOpen v := isOpen_biUnion fun o _ =>
    (isOpen_acdBall ε).preimage (continuous_const.mul continuous_id)
  have h1W : (1 : lorentz d) ∈ W := one_mem_acdBall hε
  have huO : ∀ x ∈ F, x ∈ u → x ∈ O := by
    intro x hx hxu
    obtain ⟨o, ho, hxo⟩ := mem_iUnion₂.1 hxu
    have hw : o⁻¹ * x ∈ O := hFB _ (F.mul_mem (F.inv_mem (hOF o ho)) hx) hxo
    have : x = o * (o⁻¹ * x) := by group
    rw [this]; exact O.mul_mem ho hw
  have hvO : ∀ x ∈ F, x ∈ v → x ∉ O := by
    intro x hx hxv hxO
    obtain ⟨o, ⟨hoF, hoO⟩, hxo⟩ := mem_iUnion₂.1 hxv
    have hw : o⁻¹ * x ∈ O := hFB _ (F.mul_mem (F.inv_mem hoF) hx) hxo
    have : o = x * (o⁻¹ * x)⁻¹ := by group
    exact hoO (this ▸ O.mul_mem hxO (O.inv_mem hw))
  have hC := isPreconnected_connectedComponentIn (F := (F : Set (lorentz d))) (x := (1 : lorentz d))
  have hCF : connectedComponentIn (F : Set (lorentz d)) 1 ⊆ F := connectedComponentIn_subset _ _
  have hcover : connectedComponentIn (F : Set (lorentz d)) 1 ⊆ u ∪ v := by
    intro x hx
    by_cases hxO : x ∈ O
    · exact Or.inl (mem_iUnion₂.2 ⟨x, hxO, by simpa using h1W⟩)
    · exact Or.inr (mem_iUnion₂.2 ⟨x, ⟨hCF hx, hxO⟩, by simpa using h1W⟩)
  have hdisj : connectedComponentIn (F : Set (lorentz d)) 1 ∩ (u ∩ v) = ∅ := by
    refine Set.eq_empty_of_forall_notMem fun x ⟨hx, hxu, hxv⟩ => ?_
    exact hvO x (hCF hx) hxv (huO x (hCF hx) hxu)
  have h1F : (1 : lorentz d) ∈ (F : Set (lorentz d)) := F.one_mem
  have h1C := mem_connectedComponentIn h1F
  rcases isPreconnected_iff_subset_of_disjoint.1 hC u v hu hv hcover hdisj with h | h
  · intro x hx; rw [← hO]; exact huO x (hCF hx) (h hx)
  · exact absurd O.one_mem (hvO 1 h1F (h h1C))

/-- **Step 4**: `Γ_nd ≤ Γ_ε` for every `ε > 0` (no (★) needed): `L(Γ) ∩ cl L(Γ_ε) = L(Γ_ε)` and
the translations `Γ ∩ ker L` are generators of `Γ_ε`. -/
theorem nonDiscretePart_le_nearSubgroup (Γ : Subgroup (isom d)) {ε : ℝ} (hε : 0 < ε) :
    nonDiscretePart Γ ≤ nearSubgroup Γ ε := by
  haveI := Lox.lorentz_isTopologicalGroup (d := d)
  rintro γ ⟨hγ, hγ'⟩
  set O : Subgroup (lorentz d) := ((nearSubgroup Γ ε).map linearPart).topologicalClosure with hOdef
  have hle : Subgroup.closure (linClosureIdentityComponent Γ) ≤ O :=
    (Subgroup.closure_le O).2 (linClosureIdentityComponent_subset_near Γ hε)
  have hx : linearPart γ ∈
      closure (((nearSubgroup Γ ε).map linearPart : Subgroup (lorentz d)) : Set (lorentz d)) :=
    hle hγ'
  have hopen : IsOpen {y : lorentz d | y⁻¹ * linearPart γ ∈ acdBall ε} :=
    (isOpen_acdBall ε).preimage (continuous_inv.mul continuous_const)
  have hmem : linearPart γ ∈ {y : lorentz d | y⁻¹ * linearPart γ ∈ acdBall ε} := by
    show (linearPart γ)⁻¹ * linearPart γ ∈ acdBall ε
    rw [inv_mul_cancel]; exact one_mem_acdBall hε
  obtain ⟨y, hy, ⟨γ', hγ'N, rfl⟩⟩ := mem_closure_iff.1 hx _ hopen hmem
  have hgen : γ'⁻¹ * γ ∈ nearSubgroup Γ ε := by
    refine Subgroup.subset_closure ⟨Γ.mul_mem (Γ.inv_mem (nearSubgroup_le Γ ε hγ'N)) hγ, ?_⟩
    have : linearPart (γ'⁻¹ * γ) ∈ acdBall ε := by rw [map_mul, map_inv]; exact hy
    exact this
  have : γ = γ' * (γ'⁻¹ * γ) := by group
  rw [this]; exact (nearSubgroup Γ ε).mul_mem hγ'N hgen

/-! ### Step 5, linear algebra: commuting (locally) nilpotent endomorphisms share a flag -/

section Flag

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- **A common kernel vector modulo an invariant submodule.** For pairwise commuting `f ∈ S`,
each locally nilpotent on the `S`-invariant `U`, and an `S`-invariant `K ≤ U` with `U ⊄ K`,
some `u ∈ U \ K` has `f u ∈ K` for every `f ∈ S`. Strong induction on `finrank U`: if some
`f` moves `U` out of `K`, the last iterate `fⁱ u₀ ∉ K` lies in `U' = U ⊓ f⁻¹ K`, which is
`S`-invariant (commutation) and strictly smaller. -/
theorem acd_exists_rel_kernel [FiniteDimensional ℝ V] (S : Set (Module.End ℝ V))
    (hcomm : ∀ f ∈ S, ∀ g ∈ S, Commute f g) (K : Submodule ℝ V)
    (hK : ∀ f ∈ S, ∀ v ∈ K, f v ∈ K) :
    ∀ n : ℕ, ∀ U : Submodule ℝ V, finrank ℝ U = n → K ≤ U → (∀ f ∈ S, ∀ v ∈ U, f v ∈ U) →
      (∀ f ∈ S, ∀ u ∈ U, ∃ m : ℕ, (f ^ m) u = 0) → ¬ U ≤ K →
      ∃ u ∈ U, u ∉ K ∧ ∀ f ∈ S, f u ∈ K := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro U hn hKU hU hnil hUK
  by_cases hall : ∀ f ∈ S, ∀ u ∈ U, f u ∈ K
  · obtain ⟨u, huU, huK⟩ := Set.not_subset.1 hUK
    exact ⟨u, huU, huK, fun f hf => hall f hf u huU⟩
  simp only [not_forall] at hall
  obtain ⟨f, hf, u₀, hu₀U, hfu₀⟩ := hall
  have hu₀K : u₀ ∉ K := fun h => hfu₀ (hK f hf u₀ h)
  -- the last iterate of `u₀` outside `K`
  obtain ⟨m, hm⟩ := hnil f hf u₀ hu₀U
  classical
  have hex : ∃ i : ℕ, (f ^ (i + 1)) u₀ ∈ K := ⟨m, by
    rw [pow_succ', Module.End.mul_apply, hm, map_zero]; exact K.zero_mem⟩
  set i := Nat.find hex with hi
  have hi1 : (f ^ (i + 1)) u₀ ∈ K := Nat.find_spec hex
  have hi0 : (f ^ i) u₀ ∉ K := by
    rcases Nat.eq_zero_or_eq_succ_pred i with h0 | hs
    · rw [h0, pow_zero, Module.End.one_apply]; exact hu₀K
    · intro hmem
      have := Nat.find_min hex (show i - 1 < i by omega)
      rw [show i - 1 + 1 = i by omega] at this
      exact this hmem
  have hpowU : ∀ k : ℕ, ∀ v ∈ U, (f ^ k) v ∈ U := by
    intro k
    induction k with
    | zero => intro v hv; simpa using hv
    | succ k ihk => intro v hv; rw [pow_succ', Module.End.mul_apply]; exact hU f hf _ (ihk v hv)
  set U' : Submodule ℝ V := U ⊓ K.comap f with hU'
  have hw : (f ^ i) u₀ ∈ U' := ⟨hpowU i u₀ hu₀U, by
    show f ((f ^ i) u₀) ∈ K
    rw [← Module.End.mul_apply, ← pow_succ']; exact hi1⟩
  have hlt : U' < U := by
    refine lt_of_le_of_ne inf_le_left fun h => hfu₀ ?_
    have : u₀ ∈ U' := h ▸ hu₀U
    exact this.2
  have hrank : finrank ℝ U' < n := hn ▸ Submodule.finrank_lt_finrank_of_lt hlt
  have hU'inv : ∀ g ∈ S, ∀ v ∈ U', g v ∈ U' := by
    intro g hg v hv
    refine ⟨hU g hg v hv.1, ?_⟩
    show f (g v) ∈ K
    rw [← Module.End.mul_apply, (hcomm f hf g hg).eq, Module.End.mul_apply]
    exact hK g hg _ hv.2
  obtain ⟨u, huU', huK, hu⟩ := ih _ hrank U' rfl (le_inf hKU fun v hv => hK f hf v hv) hU'inv
    (fun g hg v hv => hnil g hg v hv.1) (fun h => hi0 (h hw))
  exact ⟨u, huU'.1, huK, hu⟩

/-- The kernel flag of a set `S` of endomorphisms relative to a submodule `U`:
`W 0 = ⊥`, `W (j + 1) = {v ∈ U | f v ∈ W j for every f ∈ S}`. -/
noncomputable def acdKerFlag (S : Set (Module.End ℝ V)) (U : Submodule ℝ V) :
    ℕ → Submodule ℝ V
  | 0 => ⊥
  | j + 1 => U ⊓ ⨅ f ∈ S, (acdKerFlag S U j).comap f

theorem mem_acdKerFlag_succ {S : Set (Module.End ℝ V)} {U : Submodule ℝ V} {j : ℕ} {v : V} :
    v ∈ acdKerFlag S U (j + 1) ↔ v ∈ U ∧ ∀ f ∈ S, f v ∈ acdKerFlag S U j := by
  simp only [acdKerFlag, Submodule.mem_inf, Submodule.mem_iInf, Submodule.mem_comap]

theorem acdKerFlag_le (S : Set (Module.End ℝ V)) (U : Submodule ℝ V) :
    ∀ j, acdKerFlag S U j ≤ U
  | 0 => bot_le
  | _ + 1 => inf_le_left

theorem acdKerFlag_mono (S : Set (Module.End ℝ V)) (U : Submodule ℝ V) :
    ∀ j, acdKerFlag S U j ≤ acdKerFlag S U (j + 1)
  | 0 => bot_le
  | j + 1 => fun v hv => by
    rw [mem_acdKerFlag_succ] at hv ⊢
    exact ⟨hv.1, fun f hf => acdKerFlag_mono S U j (hv.2 f hf)⟩

theorem acdKerFlag_invariant {S : Set (Module.End ℝ V)} (hcomm : ∀ f ∈ S, ∀ g ∈ S, Commute f g)
    {U : Submodule ℝ V} (hU : ∀ f ∈ S, ∀ v ∈ U, f v ∈ U) :
    ∀ j, ∀ f ∈ S, ∀ v ∈ acdKerFlag S U j, f v ∈ acdKerFlag S U j
  | 0 => fun f _ v hv => by
    rw [show v = 0 from (Submodule.mem_bot ℝ).1 hv, map_zero]; exact Submodule.zero_mem _
  | j + 1 => fun f hf v hv => by
    rw [mem_acdKerFlag_succ] at hv ⊢
    refine ⟨hU f hf v hv.1, fun g hg => ?_⟩
    rw [← Module.End.mul_apply, (hcomm g hg f hf).eq, Module.End.mul_apply]
    exact acdKerFlag_invariant hcomm hU j f hf _ (hv.2 g hg)

/-- **Common flag, relative form** (the kernel flag `acdKerFlag` reaches `U`): pairwise commuting endomorphisms, each locally nilpotent on an
`S`-invariant submodule `U`, share a flag `⊥ = W 0 ≤ W 1 ≤ … ≤ W n = U` with `f (W (j+1)) ≤ W j`. -/
theorem acd_exists_flag_rel [FiniteDimensional ℝ V] (S : Set (Module.End ℝ V))
    (hcomm : ∀ f ∈ S, ∀ g ∈ S, Commute f g) (U : Submodule ℝ V)
    (hU : ∀ f ∈ S, ∀ v ∈ U, f v ∈ U) (hnil : ∀ f ∈ S, ∀ u ∈ U, ∃ m : ℕ, (f ^ m) u = 0) :
    ∃ n : ℕ, acdKerFlag S U n = U := by
  by_contra hne
  simp only [not_exists] at hne
  have hgrow : ∀ j, j ≤ finrank ℝ (acdKerFlag S U j) := by
    intro j
    induction j with
    | zero => exact Nat.zero_le _
    | succ j ih =>
      have hnot : ¬ U ≤ acdKerFlag S U j := fun h => hne j (le_antisymm (acdKerFlag_le S U j) h)
      obtain ⟨u, huU, huK, hu⟩ := acd_exists_rel_kernel S hcomm (acdKerFlag S U j)
        (acdKerFlag_invariant hcomm hU j) _ U rfl (acdKerFlag_le S U j) hU hnil hnot
      have hlt : acdKerFlag S U j < acdKerFlag S U (j + 1) :=
        lt_of_le_of_ne (acdKerFlag_mono S U j) fun h => huK (h ▸ (mem_acdKerFlag_succ.2 ⟨huU, hu⟩))
      exact lt_of_le_of_lt ih (Submodule.finrank_lt_finrank_of_lt hlt)
  have := hgrow (finrank ℝ V + 1)
  have := Submodule.finrank_le (acdKerFlag S U (finrank ℝ V + 1))
  omega

end Flag

/-- **Commuting nilpotent endomorphisms share a flag** (generic; Engel's theorem in the
commutative case): a set `S` of pairwise commuting nilpotent endomorphisms of a finite-dimensional
real vector space admits `0 = W 0 ≤ … ≤ W n = ⊤` with `f (W (j + 1)) ≤ W j` for `f ∈ S`. -/
theorem exists_flag_of_commute_isNilpotent {V : Type*} [AddCommGroup V] [Module ℝ V]
    [FiniteDimensional ℝ V] (S : Set (Module.End ℝ V))
    (hcomm : ∀ f ∈ S, ∀ g ∈ S, Commute f g) (hnil : ∀ f ∈ S, IsNilpotent f) :
    ∃ (n : ℕ) (W : ℕ → Submodule ℝ V), W 0 = ⊥ ∧ W n = ⊤ ∧
      ∀ f ∈ S, ∀ j, (W (j + 1)).map f ≤ W j := by
  obtain ⟨n, hn⟩ := acd_exists_flag_rel S hcomm ⊤ (fun _ _ _ _ => Submodule.mem_top)
    (fun f hf u _ => by
      obtain ⟨m, hm⟩ := hnil f hf
      exact ⟨m, by rw [hm, LinearMap.zero_apply]⟩)
  refine ⟨n, acdKerFlag S ⊤, rfl, hn, fun f hf j => ?_⟩
  rintro _ ⟨v, hv, rfl⟩
  exact (mem_acdKerFlag_succ.1 hv).2 f hf

/-! ### Step 5, translations: `[g, k]` and `[k, g]` for a translation `k` -/

theorem acd_linOf_inv_apply (g : isom d) (v : Minkowski d) : linOf g⁻¹ (linOf g v) = v := by
  rw [← LinearEquiv.mul_apply, ← linOf_mul, inv_mul_cancel, linOf_one']; rfl

theorem acd_linOf_apply_inv (g : isom d) (v : Minkowski d) : linOf g (linOf g⁻¹ v) = v := by
  rw [← LinearEquiv.mul_apply, ← linOf_mul, mul_inv_cancel, linOf_one']; rfl

theorem acd_trOf_inv (g : isom d) : trOf g⁻¹ = -linOf g⁻¹ (trOf g) := by
  have h := trOf_mul g⁻¹ g
  rw [inv_mul_cancel, trOf_one] at h
  exact eq_neg_of_add_eq_zero_right h.symm

theorem acd_linOf_of_eq_one {k : isom d} (hk : linOf k = 1) (v : Minkowski d) : linOf k v = v := by
  rw [hk]; rfl

theorem acd_linOf_inv_eq_one {k : isom d} (hk : linOf k = 1) : linOf k⁻¹ = 1 := by
  rw [linOf_inv, hk, inv_one]

/-- `[g, k]` for a translation `k`: a translation by `L(g) τ(k) − τ(k)`. -/
theorem acd_commutator_translation (g k : isom d) (hk : linOf k = 1) :
    linOf (g * k * g⁻¹ * k⁻¹) = 1 ∧ trOf (g * k * g⁻¹ * k⁻¹) = linOf g (trOf k) - trOf k := by
  have hL : linOf (g * k * g⁻¹) = 1 := by rw [linOf_mul, linOf_mul, hk, linOf_inv]; group
  refine ⟨by rw [linOf_mul, hL, acd_linOf_inv_eq_one hk, one_mul], ?_⟩
  have h1 : trOf (g * k * g⁻¹) = linOf g (trOf k) := by
    rw [trOf_mul, trOf_mul, acd_trOf_inv g, linOf_mul, LinearEquiv.mul_apply,
      acd_linOf_of_eq_one hk, map_neg, acd_linOf_apply_inv]
    abel
  rw [trOf_mul, hL, h1, acd_trOf_inv k, acd_linOf_inv_eq_one hk]
  show -trOf k + linOf g (trOf k) = _
  abel

/-- `[x, g]` for a translation `x`: a translation by `τ(x) − L(g) τ(x)`. -/
theorem acd_translation_commutator (x g : isom d) (hx : linOf x = 1) :
    linOf (x * g * x⁻¹ * g⁻¹) = 1 ∧ trOf (x * g * x⁻¹ * g⁻¹) = trOf x - linOf g (trOf x) := by
  refine ⟨by rw [linOf_mul, linOf_mul, linOf_mul, hx, acd_linOf_inv_eq_one hx, linOf_inv]; group,
    ?_⟩
  have hL : linOf (x * g * x⁻¹) = linOf g := by
    rw [linOf_mul, linOf_mul, hx, acd_linOf_inv_eq_one hx]; group
  rw [trOf_mul, hL, trOf_mul, trOf_mul, linOf_mul, hx, one_mul, acd_trOf_inv g,
    acd_trOf_inv x, acd_linOf_inv_eq_one hx, map_neg, acd_linOf_apply_inv]
  have e : ∀ v : Minkowski d, (1 : Minkowski d ≃ₗ[ℝ] Minkowski d) v = v := fun _ => rfl
  rw [e, e, map_neg]
  abel

theorem acd_eq_one_of_translation {x : isom d} (h1 : linOf x = 1) (h0 : trOf x = 0) : x = 1 := by
  refine isomPair_injective (Prod.ext ?_ ?_)
  · show linToCLM (linOf x) = linToCLM (linOf (1 : isom d))
    rw [h1, linOf_one']
  · show trOf x = trOf (1 : isom d)
    rw [h0, trOf_one]

theorem acd_norm_affExt_sub_one_le {x : isom d} (h1 : linOf x = 1) :
    ‖affExt x - 1‖ ≤ ‖trOf x‖ := by
  refine ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _) fun ⟨y, s⟩ => ?_
  rw [affExt_sub_one_apply, acd_linOf_of_eq_one h1, add_sub_cancel_left]
  have e1 : ‖((s • trOf x, (0 : ℝ)) : Minkowski d × ℝ)‖ = |s| * ‖trOf x‖ := by
    rw [Prod.norm_def, norm_zero, max_eq_left (norm_nonneg _), norm_smul, Real.norm_eq_abs]
  rw [e1, mul_comm]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
  rw [Prod.norm_def, ← Real.norm_eq_abs]
  exact le_max_right _ _

/-! ### Step 5: `Γ_ε` is nilpotent -/

/-- The translation vectors `Λ = τ(Γ ∩ ker L)` of `Γ`. -/
def acdTransVec (Γ : Subgroup (isom d)) : Set (Minkowski d) :=
  {v | ∃ k ∈ Γ, linOf k = 1 ∧ trOf k = v}

/-- The translations whose vector lies in a submodule `W`, a subgroup of `Isom(𝐌ⁿ)`. -/
noncomputable def acdTransSub (W : Submodule ℝ (Minkowski d)) : Subgroup (isom d) where
  carrier := {x | linOf x = 1 ∧ trOf x ∈ W}
  one_mem' := ⟨linOf_one', by rw [trOf_one]; exact W.zero_mem⟩
  mul_mem' := by
    rintro a b ⟨ha1, ha⟩ ⟨hb1, hb⟩
    refine ⟨by rw [linOf_mul, ha1, hb1, one_mul], ?_⟩
    rw [trOf_mul, acd_linOf_of_eq_one ha1]
    exact W.add_mem hb ha
  inv_mem' := by
    rintro a ⟨ha1, ha⟩
    refine ⟨acd_linOf_inv_eq_one ha1, ?_⟩
    rw [acd_trOf_inv, acd_linOf_of_eq_one (acd_linOf_inv_eq_one ha1)]
    exact W.neg_mem ha

theorem acd_pOf_apply_mem_transVec {Γ : Subgroup (isom d)} {g : isom d} (hg : g ∈ Γ)
    {v : Minkowski d} (hv : v ∈ acdTransVec Γ) : pOf (linOf g) v ∈ acdTransVec Γ := by
  obtain ⟨k, hk, hk1, rfl⟩ := hv
  obtain ⟨h1, h2⟩ := acd_commutator_translation g k hk1
  exact ⟨g * k * g⁻¹ * k⁻¹, Γ.mul_mem (Γ.mul_mem (Γ.mul_mem hg hk) (Γ.inv_mem hg)) (Γ.inv_mem hk),
    h1, by rw [h2, pOf_apply]⟩

theorem acd_pOf_pow_apply_mem_transVec {Γ : Subgroup (isom d)} {g : isom d} (hg : g ∈ Γ)
    {v : Minkowski d} (hv : v ∈ acdTransVec Γ) (m : ℕ) : (pOf (linOf g) ^ m) v ∈ acdTransVec Γ := by
  induction m with
  | zero => simpa using hv
  | succ m ih => rw [pow_succ', Module.End.mul_apply]; exact acd_pOf_apply_mem_transVec hg ih

theorem acd_norm_pOf_pow_apply_le {g : isom d} {ε : ℝ} (hε : 0 ≤ ε)
    (hg : ‖linToCLM (linOf g) - 1‖ ≤ ε) (v : Minkowski d) (m : ℕ) :
    ‖(pOf (linOf g) ^ m) v‖ ≤ ε ^ m * ‖v‖ := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [pow_succ', Module.End.mul_apply]
    have e : pOf (linOf g) ((pOf (linOf g) ^ m) v) =
        (linToCLM (linOf g) - 1) ((pOf (linOf g) ^ m) v) := by
      rfl
    rw [e, pow_succ', mul_assoc]
    exact ((linToCLM (linOf g) - 1).le_opNorm _).trans
      (mul_le_mul hg ih (norm_nonneg _) hε)

/-- **Discreteness makes a near-identity linear part nilpotent on the translations**: for
`‖L(g) − 1‖ < ε < 1`, `(L(g) − 1)ᵐ` kills every translation vector of `Γ` for `m` large. -/
theorem acd_exists_pOf_pow_eq_zero {Γ : Subgroup (isom d)} (hdisc : DiscreteTopology Γ)
    {ε : ℝ} (hε : 0 < ε) (hε1 : ε < 1) {g : isom d} (hg : g ∈ Γ)
    (hgε : ‖linToCLM (linOf g) - 1‖ < ε) {v : Minkowski d} (hv : v ∈ acdTransVec Γ) :
    ∃ m : ℕ, (pOf (linOf g) ^ m) v = 0 := by
  obtain ⟨η, hη, hiso⟩ := exists_affExt_isolated hdisc
  obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one (show 0 < η / (‖v‖ + 1) by positivity) hε1
  refine ⟨m, ?_⟩
  obtain ⟨k, hk, hk1, hkv⟩ := acd_pOf_pow_apply_mem_transVec hg hv m
  have hbound : ‖trOf k‖ < η := by
    rw [hkv]
    refine (acd_norm_pOf_pow_apply_le hε.le hgε.le v m).trans_lt ?_
    have h1 : 0 < ‖v‖ + 1 := by positivity
    calc ε ^ m * ‖v‖ ≤ ε ^ m * (‖v‖ + 1) := by
            gcongr; linarith
      _ < η / (‖v‖ + 1) * (‖v‖ + 1) := by gcongr
      _ = η := by field_simp
  have := hiso k hk ((acd_norm_affExt_sub_one_le hk1).trans_lt hbound)
  rw [← hkv, this, trOf_one]

theorem acd_pow_apply_eq_zero_of_le {V : Type*} [AddCommGroup V] [Module ℝ V]
    {f : Module.End ℝ V} {v : V} {m m' : ℕ} (h : m ≤ m') (hv : (f ^ m) v = 0) :
    (f ^ m') v = 0 := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [add_comm, pow_add, Module.End.mul_apply, hv, map_zero]

/-- Commuting linear parts give commuting `L − 1`. -/
theorem acd_commute_pOf {A B : Minkowski d ≃ₗ[ℝ] Minkowski d} (h : A * B = B * A) :
    Commute (pOf A) (pOf B) := by
  have h' : ∀ v, A (B v) = B (A v) := fun v => by
    rw [← LinearEquiv.mul_apply, h, LinearEquiv.mul_apply]
  refine LinearMap.ext fun v => ?_
  simp only [Module.End.mul_apply, pOf_apply, map_sub, h']
  abel

/-- The generators of `Γ_ε`. -/
def acdGen (Γ : Subgroup (isom d)) (ε : ℝ) : Set (isom d) :=
  {g | g ∈ Γ ∧ ‖linToCLM (linOf g) - 1‖ < ε}

/-- The series `H 0 = Γ_ε`, `H (j + 1) = {translations of Γ_ε with vector in W (n − j)}`. -/
noncomputable def acdSeries (N : Subgroup (isom d)) (W : ℕ → Submodule ℝ (Minkowski d)) (n : ℕ) :
    ℕ → Subgroup N
  | 0 => ⊤
  | j + 1 => (acdTransSub (W (n - j))).subgroupOf N

/-- **Step 5**: under (★) with `ε < 1`, `Γ_ε` is nilpotent (class `≤ dim V_K + 1`). -/
theorem isNilpotent_nearSubgroup {Γ : Subgroup (isom d)} (hdisc : DiscreteTopology Γ) {ε : ℝ}
    (hε : 0 < ε) (hε1 : ε < 1)
    (hloc : ∀ g ∈ Γ, ∀ h ∈ Γ, ‖linToCLM (linOf g) - 1‖ < ε → ‖linToCLM (linOf h) - 1‖ < ε →
      linOf g * linOf h = linOf h * linOf g) :
    Group.IsNilpotent (nearSubgroup Γ ε) := by
  set N := nearSubgroup Γ ε with hNdef
  set S : Set (Module.End ℝ (Minkowski d)) := (fun g => pOf (linOf g)) '' acdGen Γ ε with hSdef
  set U : Submodule ℝ (Minkowski d) := Submodule.span ℝ (acdTransVec Γ) with hUdef
  have hcomm : ∀ f ∈ S, ∀ f' ∈ S, Commute f f' := by
    rintro _ ⟨g, hg, rfl⟩ _ ⟨h, hh, rfl⟩
    exact acd_commute_pOf (hloc g hg.1 h hh.1 hg.2 hh.2)
  have hU : ∀ f ∈ S, ∀ v ∈ U, f v ∈ U := by
    rintro _ ⟨g, hg, rfl⟩ v hv
    have hle : U ≤ U.comap (pOf (linOf g)) := Submodule.span_le.2 fun w hw =>
      Submodule.subset_span (acd_pOf_apply_mem_transVec hg.1 hw)
    exact hle hv
  have hnil : ∀ f ∈ S, ∀ u ∈ U, ∃ m : ℕ, (f ^ m) u = 0 := by
    rintro _ ⟨g, hg, rfl⟩ u hu
    induction hu using Submodule.span_induction with
    | mem v hv => exact acd_exists_pOf_pow_eq_zero hdisc hε hε1 hg.1 hg.2 hv
    | zero => exact ⟨0, map_zero _⟩
    | add a b _ _ iha ihb =>
      obtain ⟨ma, hma⟩ := iha
      obtain ⟨mb, hmb⟩ := ihb
      refine ⟨ma + mb, ?_⟩
      rw [map_add, acd_pow_apply_eq_zero_of_le (Nat.le_add_right ma mb) hma,
        acd_pow_apply_eq_zero_of_le (Nat.le_add_left mb ma) hmb, add_zero]
    | smul c a _ iha =>
      obtain ⟨ma, hma⟩ := iha
      exact ⟨ma, by rw [map_smul, hma, smul_zero]⟩
  obtain ⟨n, hn⟩ := acd_exists_flag_rel S hcomm U hU hnil
  set W := acdKerFlag S U with hWdef
  have hWinv := acdKerFlag_invariant hcomm hU
  -- every `γ ∈ Γ_ε` lowers the flag
  have hP : ∀ γ ∈ N, ∀ j, (∀ w ∈ W j, linOf γ w ∈ W j ∧ linOf γ⁻¹ w ∈ W j) ∧
      ∀ w ∈ W (j + 1), linOf γ w - w ∈ W j := by
    intro γ hγ
    induction hγ using Subgroup.closure_induction with
    | mem g hg =>
      have hf : pOf (linOf g) ∈ S := ⟨g, hg, rfl⟩
      have hfwd : ∀ j, ∀ w ∈ W j, linOf g w ∈ W j := fun j w hw => by
        have := (W j).add_mem hw (hWinv j _ hf w hw)
        rwa [pOf_apply, add_sub_cancel] at this
      intro j
      refine ⟨fun w hw => ⟨hfwd j w hw, ?_⟩, fun w hw => (mem_acdKerFlag_succ.1 hw).2 _ hf⟩
      have hmap : (W j).map (linOf g : Minkowski d →ₗ[ℝ] Minkowski d) = W j :=
        Submodule.eq_of_le_of_finrank_eq (by rintro _ ⟨u, hu, rfl⟩; exact hfwd j u hu)
          (LinearEquiv.finrank_map_eq (linOf g) (W j))
      rw [← hmap] at hw
      obtain ⟨u, hu, rfl⟩ := hw
      show linOf g⁻¹ (linOf g u) ∈ W j
      rw [acd_linOf_inv_apply]; exact hu
    | one =>
      intro j
      refine ⟨fun w hw => ⟨?_, ?_⟩, fun w hw => ?_⟩
      · rw [linOf_one']; exact hw
      · rw [inv_one, linOf_one']; exact hw
      · rw [linOf_one']; show w - w ∈ W j; rw [sub_self]; exact (W j).zero_mem
    | mul a b _ _ iha ihb =>
      intro j
      refine ⟨fun w hw => ⟨?_, ?_⟩, fun w hw => ?_⟩
      · rw [linOf_mul, LinearEquiv.mul_apply]; exact ((iha j).1 _ ((ihb j).1 w hw).1).1
      · rw [mul_inv_rev, linOf_mul, LinearEquiv.mul_apply]
        exact ((ihb j).1 _ ((iha j).1 w hw).2).2
      · have e : linOf (a * b) w - w = linOf a (linOf b w - w) + (linOf a w - w) := by
          rw [linOf_mul, LinearEquiv.mul_apply, map_sub]; abel
        rw [e]
        exact (W j).add_mem ((iha j).1 _ ((ihb j).2 w hw)).1 ((iha j).2 w hw)
    | inv a _ iha =>
      intro j
      refine ⟨fun w hw => ⟨((iha j).1 w hw).2, by rw [inv_inv]; exact ((iha j).1 w hw).1⟩,
        fun w hw => ?_⟩
      have e : linOf a⁻¹ w - w = -linOf a⁻¹ (linOf a w - w) := by
        rw [map_sub, acd_linOf_inv_apply]; abel
      rw [e]
      exact (W j).neg_mem ((iha j).1 _ ((iha j).2 w hw)).2
  have hcommN := linOf_comm_of_mem_nearSubgroup hloc
  refine (Subgroup.nilpotent_iff_finite_descending_central_series (G := N)).2 ⟨n + 1, acdSeries N W n, ⟨rfl, ?_⟩, ?_⟩
  · intro x j hx g
    obtain ⟨x, hxN⟩ := x
    obtain ⟨g, hgN⟩ := g
    rw [acdSeries, Subgroup.mem_subgroupOf]
    show x * g * x⁻¹ * g⁻¹ ∈ acdTransSub (W (n - j))
    cases j with
    | zero =>
      have hL : linOf (x * g * x⁻¹ * g⁻¹) = 1 := by
        rw [linOf_mul, linOf_mul, linOf_mul, hcommN x hxN g hgN, linOf_inv, linOf_inv]; group
      refine ⟨hL, ?_⟩
      rw [Nat.sub_zero, hn]
      refine Submodule.subset_span ⟨_, ?_, hL, rfl⟩
      have hx := nearSubgroup_le Γ ε hxN
      have hg := nearSubgroup_le Γ ε hgN
      exact Γ.mul_mem (Γ.mul_mem (Γ.mul_mem hx hg) (Γ.inv_mem hx)) (Γ.inv_mem hg)
    | succ j =>
      rw [acdSeries, Subgroup.mem_subgroupOf] at hx
      obtain ⟨hx1, hxW⟩ := hx
      obtain ⟨h1, h2⟩ := acd_translation_commutator x g hx1
      refine ⟨h1, ?_⟩
      rw [h2]
      by_cases hj : j < n
      · have e : n - j = n - (j + 1) + 1 := by omega
        rw [e] at hxW
        have := (W (n - (j + 1))).neg_mem ((hP g hgN (n - (j + 1))).2 _ hxW)
        rwa [neg_sub] at this
      · have e : n - j = 0 := by omega
        rw [e] at hxW
        have h0 : trOf x = 0 := (Submodule.mem_bot ℝ).1 hxW
        rw [h0, map_zero, sub_zero]; exact Submodule.zero_mem _
  · rw [acdSeries, Nat.sub_self, eq_bot_iff]
    rintro ⟨x, hxN⟩ hx
    rw [Subgroup.mem_subgroupOf] at hx
    obtain ⟨hx1, hx0⟩ := hx
    rw [Subgroup.mem_bot]
    exact Subtype.ext (acd_eq_one_of_translation hx1 ((Submodule.mem_bot ℝ).1 hx0))

/-- **(★_Γ) ⇒ `AusConclusion Γ`** (Steps 3–5): for a discrete `Γ ≤ Isom(𝐌ⁿ)` satisfying (★),
`G₀` is nilpotent (indeed abelian) and `Γ_nd` is nilpotent. -/
theorem ausConclusion_of_star {Γ : Subgroup (isom d)} (hdisc : DiscreteTopology Γ)
    (hstar : ACDStar Γ) : AusConclusion Γ := by
  obtain ⟨ε₀, hε₀, hloc₀⟩ := hstar
  set ε := min ε₀ (1 / 2) with hεdef
  have hε : 0 < ε := lt_min hε₀ (by norm_num)
  have hε1 : ε < 1 := (min_le_right _ _).trans_lt (by norm_num)
  have hloc : ∀ g ∈ Γ, ∀ h ∈ Γ, ‖linToCLM (linOf g) - 1‖ < ε → ‖linToCLM (linOf h) - 1‖ < ε →
      linOf g * linOf h = linOf h * linOf g := fun g hg h hh hg' hh' =>
    hloc₀ g hg h hh (hg'.trans_le (min_le_left _ _)) (hh'.trans_le (min_le_left _ _))
  refine ⟨?_, ?_⟩
  · -- conjunct 1: `G₀ ⊆ cl L(Γ_ε)`, which is abelian
    have hcommL : ∀ x ∈ (((nearSubgroup Γ ε).map linearPart : Subgroup (lorentz d)) :
        Set (lorentz d)), ∀ y ∈ (((nearSubgroup Γ ε).map linearPart : Subgroup (lorentz d)) :
        Set (lorentz d)), x * y = y * x := by
      rintro _ ⟨g, hg, rfl⟩ _ ⟨h, hh, rfl⟩
      refine Subtype.ext ?_
      show linOf g * linOf h = linOf h * linOf g
      exact linOf_comm_of_mem_nearSubgroup hloc g hg h hh
    have hcl := lorentz_closure_comm hcommL
    have hsub := linClosureIdentityComponent_subset_near Γ hε
    exact isNilpotent_closure_of_comm fun x hx y hy => hcl x (hsub hx) y (hsub hy)
  · -- conjunct 2: `Γ_nd ≤ Γ_ε`, which is nilpotent
    haveI := isNilpotent_nearSubgroup hdisc hε hε1 hloc
    have hle := nonDiscretePart_le_nearSubgroup Γ hε
    refine Subgroup.isNilpotent_of_ker_le_center (Subgroup.inclusion hle) ?_
    rw [(MonoidHom.ker_eq_bot_iff _).2 (Subgroup.inclusion_injective hle)]
    exact bot_le

end Causal.Flat
