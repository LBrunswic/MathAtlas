namespace Causal.Flat

open Module
open scoped commutatorElement TensorProduct

section Triang

variable {G : Type*} [Group G] {W : Type*} [AddCommGroup W] [Module ℂ W] [FiniteDimensional ℂ W]

/-- Every eigenvalue of `f` lies in the open disc `|μ − 1| < 1` (so has positive real part). -/
def AffSpecNearOne (f : Module.End ℂ W) : Prop :=
  ∀ μ : ℂ, f.HasEigenvalue μ → ‖μ - 1‖ < 1

/-- An eigenvector equation gives an eigenvalue. -/
theorem affacd_hasEigenvalue_of_eq {M : Type*} [AddCommGroup M] [Module ℂ M] {f : Module.End ℂ M}
    {μ : ℂ} {v : M} (hv : f v = μ • v) (h0 : v ≠ 0) : f.HasEigenvalue μ :=
  Module.End.hasEigenvalue_of_hasEigenvector
    (Module.End.hasEigenvector_iff.2 ⟨Module.End.mem_eigenspace_iff.2 hv, h0⟩)

/-- An eigenvalue has an eigenvector, as an equation. -/
theorem affacd_exists_eq_of_hasEigenvalue {M : Type*} [AddCommGroup M] [Module ℂ M]
    {f : Module.End ℂ M} {μ : ℂ} (h : f.HasEigenvalue μ) : ∃ v, f v = μ • v ∧ v ≠ 0 := by
  obtain ⟨v, hv⟩ := h.exists_hasEigenvector
  rw [Module.End.hasEigenvector_iff, Module.End.mem_eigenspace_iff] at hv
  exact ⟨v, hv⟩

/-- An eigenvalue of the map induced on a quotient by an invariant submodule is an eigenvalue of
the map (finite dimension: `f − μ` bijective on `W` and injective on `p` is bijective on `W ⧸ p`). -/
theorem affacd_hasEigenvalue_of_mapQ (f : Module.End ℂ W) (p : Submodule ℂ W)
    (hp : p ≤ p.comap f) {μ : ℂ} (h : Module.End.HasEigenvalue (p.mapQ p f hp) μ) :
    f.HasEigenvalue μ := by
  by_contra hne
  obtain ⟨q, hq1, hq0⟩ := affacd_exists_eq_of_hasEigenvalue h
  obtain ⟨w, rfl⟩ := p.mkQ_surjective q
  set g : Module.End ℂ W := f - μ • 1 with hg
  have ginj : Function.Injective g := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro v hv
    by_contra hv0
    apply hne
    refine affacd_hasEigenvalue_of_eq (v := v) ?_ hv0
    have : f v - μ • v = 0 := by simpa [hg] using hv
    exact sub_eq_zero.1 this
  have hgp : ∀ v ∈ p, g v ∈ p := fun v hv => by
    simp only [hg, LinearMap.sub_apply, LinearMap.smul_apply, Module.End.one_apply]
    exact p.sub_mem (hp hv) (p.smul_mem μ hv)
  have grinj : Function.Injective (g.restrict hgp) := by
    intro a b hab
    apply Subtype.ext
    apply ginj
    have := congrArg Subtype.val hab
    simpa [LinearMap.restrict_apply] using this
  have grsurj := LinearMap.injective_iff_surjective.1 grinj
  have hw : g w ∈ p := by
    have h1 : p.mkQ (f w) = μ • p.mkQ w := by
      rw [← hq1]; rfl
    have h2 : p.mkQ (f w - μ • w) = 0 := by
      rw [map_sub, map_smul, h1, sub_self]
    have h3 : f w - μ • w ∈ p := (Submodule.Quotient.mk_eq_zero p).1 h2
    simpa [hg] using h3
  obtain ⟨⟨u, hu⟩, hgu⟩ := grsurj ⟨g w, hw⟩
  have hgu' : g u = g w := by
    have := congrArg Subtype.val hgu
    simpa [LinearMap.restrict_apply] using this
  have := ginj hgu'
  subst this
  exact hq0 (by simpa [Submodule.Quotient.mk_eq_zero] using hu)

omit [FiniteDimensional ℂ W] in
/-- An eigenvalue of the restriction to an invariant submodule is an eigenvalue of the map. -/
theorem affacd_hasEigenvalue_of_restrict (f : Module.End ℂ W) (p : Submodule ℂ W)
    (hp : ∀ w ∈ p, f w ∈ p) {μ : ℂ} (h : Module.End.HasEigenvalue (f.restrict hp) μ) :
    f.HasEigenvalue μ := by
  obtain ⟨v, hv, h0⟩ := affacd_exists_eq_of_hasEigenvalue h
  refine affacd_hasEigenvalue_of_eq (v := (v : W)) ?_ ?_
  · have := congrArg Subtype.val hv
    simpa [LinearMap.restrict_apply] using this
  · intro h0'; exact h0 (Subtype.ext h0')

/-- **Schur's lemma** for an irreducible representation over `ℂ`: an endomorphism commuting with
`ρ(G)` is a scalar. -/
theorem affacd_schur (ρ : Representation ℂ G W) [Nontrivial W]
    (hirr : ∀ p : Submodule ℂ W, (∀ g : G, ∀ w ∈ p, ρ g w ∈ p) → p = ⊥ ∨ p = ⊤)
    (T : Module.End ℂ W) (hT : ∀ g : G, T * ρ g = ρ g * T) : ∃ c : ℂ, T = c • 1 := by
  obtain ⟨μ, hμ⟩ := Module.End.exists_eigenvalue T
  obtain ⟨v, hv, hv0⟩ := affacd_exists_eq_of_hasEigenvalue hμ
  have hinv : ∀ g : G, ∀ w ∈ T.eigenspace μ, ρ g w ∈ T.eigenspace μ := by
    intro g w hw
    rw [Module.End.mem_eigenspace_iff] at hw ⊢
    rw [← Module.End.mul_apply, hT g, Module.End.mul_apply, hw, map_smul]
  rcases hirr _ hinv with h | h
  · exact absurd (h ▸ Module.End.mem_eigenspace_iff.2 hv) (by simpa using hv0)
  · refine ⟨μ, LinearMap.ext fun w => ?_⟩
    have : w ∈ T.eigenspace μ := h ▸ Submodule.mem_top
    rw [Module.End.mem_eigenspace_iff] at this
    simp [this]

/-- **(T1) An irreducible nilpotent group generated by elements with spectrum near `1` is
one-dimensional** (module docstring, step 1). -/
theorem affacd_finrank_eq_one_of_irreducible [Group.IsNilpotent G] (ρ : Representation ℂ G W)
    {X : Set G} (hX : Subgroup.closure X = ⊤) (hspec : ∀ x ∈ X, AffSpecNearOne (ρ x))
    [Nontrivial W]
    (hirr : ∀ p : Submodule ℂ W, (∀ g : G, ∀ w ∈ p, ρ g w ∈ p) → p = ⊥ ∨ p = ⊤) :
    finrank ℂ W = 1 := by
  classical
  -- `Sc g`: `ρ g` is a scalar
  let Sc : G → Prop := fun g => ∃ c : ℂ, ρ g = c • 1
  by_cases hall : ∀ g, Sc g
  · -- every line is invariant
    obtain ⟨v, hv⟩ := exists_ne (0 : W)
    have hinv : ∀ g : G, ∀ w ∈ Submodule.span ℂ {v}, ρ g w ∈ Submodule.span ℂ {v} := by
      intro g w hw
      obtain ⟨c, hc⟩ := hall g
      rw [hc]
      simpa using Submodule.smul_mem _ c hw
    rcases hirr _ hinv with h | h
    · exact absurd (Submodule.span_singleton_eq_bot.1 h) hv
    · rw [← finrank_top ℂ W, ← h, finrank_span_singleton hv]
  push Not at hall
  -- the first term of the upper central series not acting by scalars
  have hex : ∃ n, ∃ y ∈ Subgroup.upperCentralSeries G n, ¬ Sc y := by
    obtain ⟨n, hn⟩ := Group.IsNilpotent.nilpotent G
    obtain ⟨y, hy⟩ := hall
    exact ⟨n, y, hn ▸ Subgroup.mem_top y, hy⟩
  set n₀ := Nat.find hex with hn₀
  obtain ⟨y, hyZ, hyS⟩ := Nat.find_spec hex
  have hn₀0 : n₀ ≠ 0 := by
    intro h0
    rw [← hn₀, h0, Subgroup.upperCentralSeries_zero, Subgroup.mem_bot] at hyZ
    exact hyS ⟨1, by rw [hyZ, map_one, one_smul]⟩
  obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hn₀0
  have hZk : ∀ z ∈ Subgroup.upperCentralSeries G k, Sc z := by
    intro z hz
    by_contra hzS
    have := Nat.find_min hex (show k < n₀ by omega)
    exact this ⟨z, hz, hzS⟩
  rw [← hn₀, hk] at hyZ
  -- scalar commutators: `ρ x ρ y ρ x⁻¹ = c(x) ρ y`
  have hcomm : ∀ x : G, ∃ c : ℂ, ρ x * ρ y * ρ x⁻¹ = c • ρ y := by
    intro x
    have h1 : ⁅y, x⁆⁻¹ ∈ Subgroup.upperCentralSeries G k :=
      Subgroup.inv_mem _ (Subgroup.mem_upperCentralSeries_succ_iff.1 hyZ x)
    obtain ⟨c, hc⟩ := hZk _ h1
    refine ⟨c, ?_⟩
    have e : x * y * x⁻¹ = ⁅y, x⁆⁻¹ * y := by rw [commutatorElement_def]; group
    rw [← map_mul, ← map_mul, e, map_mul, hc, smul_mul_assoc, one_mul]
  -- some generator does not commute with `ρ y`
  have hnc : ∃ x ∈ X, ρ x * ρ y ≠ ρ y * ρ x := by
    by_contra hcon
    push Not at hcon
    have hall' : ∀ g : G, ρ g * ρ y = ρ y * ρ g := by
      intro g
      have hg : g ∈ Subgroup.closure X := hX ▸ Subgroup.mem_top g
      induction hg using Subgroup.closure_induction with
      | mem x hx => exact hcon x hx
      | one => simp
      | mul a b _ _ ha hb => rw [map_mul, mul_assoc, hb, ← mul_assoc, ha, mul_assoc]
      | inv a _ ha =>
        have h1 : ρ a⁻¹ * ρ a = 1 := by rw [← map_mul, inv_mul_cancel, map_one]
        have h2 : ρ a * ρ a⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel, map_one]
        calc ρ a⁻¹ * ρ y = ρ a⁻¹ * ρ y * (ρ a * ρ a⁻¹) := by rw [h2, mul_one]
          _ = ρ a⁻¹ * (ρ a * ρ y) * ρ a⁻¹ := by rw [ha]; noncomm_ring
          _ = ρ y * ρ a⁻¹ := by rw [← mul_assoc, h1, one_mul]
    obtain ⟨c, hc⟩ := affacd_schur ρ hirr (ρ y) fun g => (hall' g).symm
    exact hyS ⟨c, hc⟩
  obtain ⟨x, hxX, hxy⟩ := hnc
  obtain ⟨c, hc⟩ := hcomm x
  have hxyc : ρ x * ρ y = c • (ρ y * ρ x) := by
    have h1 : ρ x⁻¹ * ρ x = 1 := by rw [← map_mul, inv_mul_cancel, map_one]
    calc ρ x * ρ y = ρ x * ρ y * ρ x⁻¹ * ρ x := by rw [mul_assoc _ (ρ x⁻¹), h1, mul_one]
      _ = c • (ρ y * ρ x) := by rw [hc, smul_mul_assoc]
  have hc1 : c ≠ 1 := by
    rintro rfl
    exact hxy (by rw [hxyc, one_smul])
  -- `c ^ m = 1` by the determinant
  have hcm : c ^ finrank ℂ W = 1 := by
    have hdet := congrArg LinearMap.det hc
    have hxx : ρ x * ρ x⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel, map_one]
    rw [LinearMap.det_smul, map_mul LinearMap.det, map_mul LinearMap.det, mul_right_comm,
      ← map_mul LinearMap.det (ρ x), hxx, map_one, one_mul] at hdet
    have hy0 : LinearMap.det (ρ y) ≠ 0 := by
      intro h0
      have : LinearMap.det (ρ y * ρ y⁻¹) = 1 := by rw [← map_mul, mul_inv_cancel, map_one,
        map_one]
      rw [map_mul, h0, zero_mul] at this
      exact zero_ne_one this
    exact (mul_eq_right₀ hy0).1 hdet.symm
  -- the spectrum of `ρ x` is stable under multiplication by `c`
  have hstab : ∀ μ, Module.End.HasEigenvalue (ρ x) μ → Module.End.HasEigenvalue (ρ x) (c * μ) := by
    intro μ hμ
    obtain ⟨v, hv, hv0⟩ := affacd_exists_eq_of_hasEigenvalue hμ
    refine affacd_hasEigenvalue_of_eq (v := ρ y v) ?_ ?_
    · rw [← Module.End.mul_apply, hxyc, LinearMap.smul_apply, Module.End.mul_apply, hv,
        map_smul, smul_smul]
    · intro h0
      exact hv0 ((Representation.apply_bijective ρ y).1 (by rw [h0, map_zero]))
  obtain ⟨lam, hlam⟩ := Module.End.exists_eigenvalue (ρ x)
  have hpow : ∀ j : ℕ, Module.End.HasEigenvalue (ρ x) (c ^ j * lam) := by
    intro j
    induction j with
    | zero => simpa using hlam
    | succ j ih => rw [pow_succ', mul_assoc]; exact hstab _ ih
  have hre : ∀ j : ℕ, 0 < (c ^ j * lam).re := by
    intro j
    have h1 := hspec x hxX _ (hpow j)
    have h2 := Complex.abs_re_le_norm (c ^ j * lam - 1)
    rw [Complex.sub_re, Complex.one_re] at h2
    have := abs_lt.1 (lt_of_le_of_lt h2 h1)
    linarith [this.1]
  have hm : 0 < finrank ℂ W := Module.finrank_pos
  have hsum : ∑ j ∈ Finset.range (finrank ℂ W), c ^ j * lam = 0 := by
    rw [← Finset.sum_mul]
    have hg := geom_sum_mul c (finrank ℂ W)
    rw [hcm, sub_self] at hg
    rw [(mul_eq_zero.1 hg).resolve_right (sub_ne_zero.2 hc1), zero_mul]
  have hpos : 0 < (∑ j ∈ Finset.range (finrank ℂ W), c ^ j * lam).re := by
    rw [Complex.re_sum]
    exact Finset.sum_pos (fun j _ => hre j) (Finset.nonempty_range_iff.2 hm.ne')
  rw [hsum, Complex.zero_re] at hpos
  exact absurd hpos (lt_irrefl _)

/-- **(T2a) A common eigenvector** (module docstring, step 2). -/
theorem affacd_exists_common_eigenvector [Group.IsNilpotent G] (ρ : Representation ℂ G W)
    {X : Set G} (hX : Subgroup.closure X = ⊤) (hspec : ∀ x ∈ X, AffSpecNearOne (ρ x))
    [Nontrivial W] :
    ∃ v : W, v ≠ 0 ∧ ∀ g : G, ∃ c : ℂ, ρ g v = c • v := by
  classical
  let Inv : Submodule ℂ W → Prop := fun p => ∀ g : G, ∀ w ∈ p, ρ g w ∈ p
  have hex : ∃ n, ∃ p : Submodule ℂ W, Inv p ∧ p ≠ ⊥ ∧ finrank ℂ p = n :=
    ⟨_, ⊤, fun _ _ _ => Submodule.mem_top, top_ne_bot, rfl⟩
  obtain ⟨p, hpinv, hpbot, hpn⟩ := Nat.find_spec hex
  have hmin : ∀ q : Submodule ℂ W, Inv q → q ≠ ⊥ → finrank ℂ p ≤ finrank ℂ q :=
    fun q hq hqb => hpn ▸ Nat.find_min' hex ⟨q, hq, hqb, rfl⟩
  haveI : Nontrivial p := Submodule.nontrivial_iff_ne_bot.2 hpbot
  let ρp := ρ.subrepresentation p (fun g w hw => hpinv g w hw)
  have hρp : ∀ g (w : p), ((ρp g w : p) : W) = ρ g w := fun _ _ => rfl
  have hirr : ∀ q : Submodule ℂ p, (∀ g : G, ∀ w ∈ q, ρp g w ∈ q) → q = ⊥ ∨ q = ⊤ := by
    intro q hq
    by_cases hq0 : q = ⊥
    · exact Or.inl hq0
    right
    have hinvq : Inv (q.map p.subtype) := by
      rintro g _ ⟨w, hw, rfl⟩
      exact ⟨ρp g w, hq g w hw, rfl⟩
    have hne : q.map p.subtype ≠ ⊥ := by
      obtain ⟨w, hw, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hq0
      intro h
      have : (w : W) ∈ q.map p.subtype := ⟨w, hw, rfl⟩
      rw [h, Submodule.mem_bot] at this
      exact hw0 (Subtype.ext this)
    have := hmin _ hinvq hne
    rw [Submodule.finrank_map_subtype_eq] at this
    exact Submodule.eq_top_of_finrank_eq (le_antisymm (Submodule.finrank_le q) this)
  have hspec' : ∀ x ∈ X, AffSpecNearOne (ρp x) := fun x hx μ hμ =>
    hspec x hx μ (affacd_hasEigenvalue_of_restrict (ρ x) p (hpinv x) hμ)
  have h1 := affacd_finrank_eq_one_of_irreducible ρp hX hspec' hirr
  obtain ⟨v, hv0, hv⟩ := finrank_eq_one_iff'.1 h1
  refine ⟨v, fun h => hv0 (Subtype.ext h), fun g => ⟨(hv (ρp g v)).choose, ?_⟩⟩
  have := congrArg Subtype.val (hv (ρp g v)).choose_spec
  rw [hρp] at this
  exact this.symm

/-- `finrank (p.comap L.mkQ) = finrank p + finrank L`. -/
theorem affacd_finrank_comap_mkQ (L : Submodule ℂ W) (p : Submodule ℂ (W ⧸ L)) :
    finrank ℂ (p.comap L.mkQ) = finrank ℂ p + finrank ℂ L := by
  let f : p.comap L.mkQ →ₗ[ℂ] W ⧸ L := L.mkQ ∘ₗ (p.comap L.mkQ).subtype
  have hr : LinearMap.range f = p := by
    ext y
    constructor
    · rintro ⟨⟨x, hx⟩, rfl⟩; exact hx
    · intro hy
      obtain ⟨x, rfl⟩ := L.mkQ_surjective y
      exact ⟨⟨x, hy⟩, rfl⟩
  have hk : LinearMap.ker f = L.comap (p.comap L.mkQ).subtype := by
    ext ⟨x, hx⟩
    simp [f, Submodule.Quotient.mk_eq_zero]
  have hLle : L ≤ p.comap L.mkQ := fun x hx => by
    simp [Submodule.mem_comap, (Submodule.Quotient.mk_eq_zero L).2 hx]
  have := LinearMap.finrank_range_add_finrank_ker f
  rw [hr, hk, (Submodule.comapSubtypeEquivOfLe hLle).finrank_eq] at this
  exact this.symm

universe u in
/-- The flag, by induction on the dimension (`affacd_exists_flag`). -/
theorem affacd_exists_flag_aux [Group.IsNilpotent G] {X : Set G} (hX : Subgroup.closure X = ⊤)
    (n : ℕ) : ∀ (V : Type u) [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (ρ : Representation ℂ G V), (∀ x ∈ X, AffSpecNearOne (ρ x)) → finrank ℂ V = n →
    ∃ F : ℕ → Submodule ℂ V, F 0 = ⊥ ∧ F (finrank ℂ V) = ⊤ ∧ Monotone F ∧
      (∀ i, finrank ℂ (F (i + 1)) ≤ finrank ℂ (F i) + 1) ∧
      ∀ g : G, ∀ i, ∀ w ∈ F i, ρ g w ∈ F i := by
  induction n with
  | zero =>
    intro V _ _ _ ρ _ hn
    haveI : Subsingleton V := Module.finrank_zero_iff.1 hn
    refine ⟨fun _ => ⊥, rfl, Subsingleton.elim _ _, fun _ _ _ => le_rfl, fun i => by simp,
      fun g i w hw => ?_⟩
    rw [Submodule.mem_bot] at hw ⊢
    rw [hw, map_zero]
  | succ n ih =>
    intro V _ _ _ ρ hspec hn
    haveI : Nontrivial V := Module.finrank_pos_iff.1 (by rw [hn]; omega)
    obtain ⟨v, hv0, hv⟩ := affacd_exists_common_eigenvector ρ hX hspec
    set L := Submodule.span ℂ {v} with hL
    have hLinv : ∀ g : G, L ≤ L.comap (ρ g) := by
      intro g w hw
      obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.1 hw
      obtain ⟨c, hc⟩ := hv g
      rw [Submodule.mem_comap, map_smul, hc, smul_smul]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self v)
    let ρQ := ρ.quotient L hLinv
    have hspecQ : ∀ x ∈ X, AffSpecNearOne (ρQ x) := fun x hx μ hμ =>
      hspec x hx μ (affacd_hasEigenvalue_of_mapQ (ρ x) L (hLinv x) hμ)
    have hL1 : finrank ℂ L = 1 := finrank_span_singleton hv0
    have hQn : finrank ℂ (V ⧸ L) = n := by
      have := Submodule.finrank_quotient_add_finrank L
      omega
    obtain ⟨F', hF0, hFtop, hFmono, hFstep, hFinv⟩ := ih (V ⧸ L) ρQ hspecQ hQn
    rw [hQn] at hFtop
    let F : ℕ → Submodule ℂ V := fun i => if i = 0 then ⊥ else (F' (i - 1)).comap L.mkQ
    have hF0' : F 0 = ⊥ := if_pos rfl
    have hFs : ∀ i, F (i + 1) = (F' i).comap L.mkQ := fun i => by
      simp only [F, Nat.add_eq_zero_iff, one_ne_zero, and_false, if_false, Nat.add_sub_cancel]
    refine ⟨F, hF0', ?_, ?_, ?_, ?_⟩
    · rw [hn, hFs, hFtop, Submodule.comap_top]
    · intro i j hij
      rcases i with _ | i
      · rw [hF0']; exact bot_le
      · obtain ⟨j, rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
        rw [hFs, hFs]
        exact Submodule.comap_mono (hFmono (by omega))
    · intro i
      rcases i with _ | i
      · rw [hFs, hF0', hF0, affacd_finrank_comap_mkQ, finrank_bot, finrank_bot, hL1]
      · rw [hFs, hFs, affacd_finrank_comap_mkQ, affacd_finrank_comap_mkQ]
        have := hFstep i
        omega
    · intro g i w hw
      rcases i with _ | i
      · rw [hF0', Submodule.mem_bot] at hw ⊢
        rw [hw, map_zero]
      · rw [hFs, Submodule.mem_comap] at hw ⊢
        exact hFinv g i _ hw

/-- **(T2b) A complete invariant flag**: `F 0 = ⊥`, `F (dim W) = ⊤`, steps of dimension `≤ 1`,
every `F i` invariant under `ρ(G)`. -/
theorem affacd_exists_flag [Group.IsNilpotent G] (ρ : Representation ℂ G W)
    {X : Set G} (hX : Subgroup.closure X = ⊤) (hspec : ∀ x ∈ X, AffSpecNearOne (ρ x)) :
    ∃ F : ℕ → Submodule ℂ W, F 0 = ⊥ ∧ F (finrank ℂ W) = ⊤ ∧ Monotone F ∧
      (∀ i, finrank ℂ (F (i + 1)) ≤ finrank ℂ (F i) + 1) ∧
      ∀ g : G, ∀ i, ∀ w ∈ F i, ρ g w ∈ F i := by
  exact affacd_exists_flag_aux hX (finrank ℂ W) W ρ hspec rfl

omit [FiniteDimensional ℂ W] in
/-- `ρ (g h) w = ρ g (ρ h w)`. -/
theorem affacd_mul_apply (ρ : Representation ℂ G W) (g h : G) (w : W) :
    ρ (g * h) w = ρ g (ρ h w) := by
  rw [map_mul, Module.End.mul_apply]

/-- On a step `p ≤ q` of dimension `≤ 1`, an endomorphism preserving both acts by a scalar
modulo `p`. -/
theorem affacd_exists_scalar_of_step (f : Module.End ℂ W) {p q : Submodule ℂ W} (hpq : p ≤ q)
    (hdim : finrank ℂ q ≤ finrank ℂ p + 1) (hq : ∀ w ∈ q, f w ∈ q) (hp : ∀ w ∈ p, f w ∈ p)
    {e : W} (he : e ∈ q) (hep : e ∉ p) :
    ∃ s : ℂ, ∀ w ∈ q, f w - s • w ∈ p := by
  have hsup : p ⊔ Submodule.span ℂ {e} = q := by
    have hle : p ⊔ Submodule.span ℂ {e} ≤ q :=
      sup_le hpq ((Submodule.span_singleton_le_iff_mem _ _).2 he)
    refine Submodule.eq_of_le_of_finrank_le hle ?_
    have hlt : p < p ⊔ Submodule.span ℂ {e} := by
      refine lt_of_le_of_ne le_sup_left fun h => hep ?_
      rw [h]; exact Submodule.mem_sup_right (Submodule.mem_span_singleton_self e)
    have := Submodule.finrank_lt_finrank_of_lt hlt
    omega
  have hfe : f e ∈ p ⊔ Submodule.span ℂ {e} := hsup ▸ hq e he
  obtain ⟨p₀, hp₀, y, hy, hfe'⟩ := Submodule.mem_sup.1 hfe
  obtain ⟨s, rfl⟩ := Submodule.mem_span_singleton.1 hy
  refine ⟨s, fun w hw => ?_⟩
  rw [← hsup] at hw
  obtain ⟨p₁, hp₁, y₁, hy₁, rfl⟩ := Submodule.mem_sup.1 hw
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hy₁
  have : f (p₁ + c • e) - s • (p₁ + c • e) = (f p₁ - s • p₁) + c • p₀ := by
    rw [map_add, map_smul, ← hfe', smul_add, smul_add, smul_smul, smul_smul, mul_comm c s]
    abel
  rw [this]
  exact p.add_mem (p.sub_mem (hp p₁ hp₁) (p.smul_mem s hp₁)) (p.smul_mem c hp₀)

/-- **The character of an invariant step** `p ≤ q` of dimension `≤ 1`: a monoid hom
`χ : G →* ℂ` with `ρ g w − χ(g) w ∈ p` for `w ∈ q`. -/
theorem affacd_exists_char_of_step (ρ : Representation ℂ G W) {p q : Submodule ℂ W}
    (hpq : p ≤ q) (hdim : finrank ℂ q ≤ finrank ℂ p + 1) (hq : ∀ g : G, ∀ w ∈ q, ρ g w ∈ q)
    (hp : ∀ g : G, ∀ w ∈ p, ρ g w ∈ p) :
    ∃ χ : G →* ℂ, ∀ g : G, ∀ w ∈ q, ρ g w - χ g • w ∈ p := by
  by_cases hqp : q ≤ p
  · exact ⟨1, fun g w hw => p.sub_mem (hqp (hq g w hw)) (by simpa using hqp hw)⟩
  obtain ⟨e, he, hep⟩ := Set.not_subset.1 hqp
  have hs := fun g : G => affacd_exists_scalar_of_step (ρ g) hpq hdim (hq g) (hp g) he hep
  choose χ hχ using hs
  -- uniqueness of the scalar
  have uniq : ∀ (g : G) (s : ℂ), (∀ w ∈ q, ρ g w - s • w ∈ p) → s = χ g := by
    intro g s hs'
    by_contra hne
    have h1 := p.sub_mem (hχ g e he) (hs' e he)
    have h2 : ρ g e - χ g • e - (ρ g e - s • e) = (s - χ g) • e := by
      rw [sub_smul]; abel
    rw [h2] at h1
    have := p.smul_mem (s - χ g)⁻¹ h1
    rw [smul_smul, inv_mul_cancel₀ (sub_ne_zero.2 hne), one_smul] at this
    exact hep this
  refine ⟨{ toFun := χ, map_one' := ?_, map_mul' := ?_ }, hχ⟩
  · refine (uniq 1 1 fun w hw => ?_).symm
    simp
  · intro g h
    refine (uniq (g * h) (χ g * χ h) fun w hw => ?_).symm
    rw [affacd_mul_apply]
    have e1 : ρ g (ρ h w) - (χ g * χ h) • w =
        ρ g (ρ h w - χ h • w) + χ h • (ρ g w - χ g • w) := by
      rw [map_sub, map_smul, smul_sub, smul_smul, mul_comm (χ h) (χ g)]; abel
    rw [e1]
    exact p.add_mem (hp g _ (hχ h w hw)) (p.smul_mem _ (hχ g w hw))

omit [FiniteDimensional ℂ W] in
/-- `U_j`: the elements moving each `F i` into `F (i − j)` (module docstring, step 3). -/
def affacdFlagU (ρ : Representation ℂ G W) (F : ℕ → Submodule ℂ W)
    (hinv : ∀ g : G, ∀ i, ∀ w ∈ F i, ρ g w ∈ F i) (j : ℕ) : Subgroup G where
  carrier := {g | ∀ i, ∀ w ∈ F i, ρ g w - w ∈ F (i - j)}
  one_mem' := fun i w _ => by simp
  mul_mem' := by
    intro g h hg hh i w hw
    have e : ρ (g * h) w - w = (ρ g (ρ h w) - ρ h w) + (ρ h w - w) := by
      rw [affacd_mul_apply]; abel
    rw [e]
    exact (F (i - j)).add_mem (hg i _ (hinv h i w hw)) (hh i w hw)
  inv_mem' := by
    intro g hg i w hw
    have h1 := hg i _ (hinv g⁻¹ i w hw)
    rw [Representation.self_inv_apply] at h1
    simpa using (F (i - j)).neg_mem h1

omit [FiniteDimensional ℂ W] in
/-- `U_j` is normal. -/
theorem affacdFlagU_conj (ρ : Representation ℂ G W) (F : ℕ → Submodule ℂ W)
    (hinv : ∀ g : G, ∀ i, ∀ w ∈ F i, ρ g w ∈ F i) (j : ℕ) {u : G}
    (hu : u ∈ affacdFlagU ρ F hinv j) (x : G) : x * u * x⁻¹ ∈ affacdFlagU ρ F hinv j := by
  intro i w hw
  have h1 := hinv x (i - j) _ (hu i _ (hinv x⁻¹ i w hw))
  have e : ρ x (ρ u (ρ x⁻¹ w) - ρ x⁻¹ w) = ρ (x * u * x⁻¹) w - w := by
    rw [map_sub, Representation.self_inv_apply, affacd_mul_apply, affacd_mul_apply]
  rwa [e] at h1

/-- **(T3) The class bound for a nilpotent group with a complete invariant flag**
(module docstring, step 3): `γ_{m+1}(G) ≤ ker ρ`. -/
theorem affacd_lowerCentralSeries_le_ker_of_flag [Group.IsNilpotent G]
    (ρ : Representation ℂ G W) (F : ℕ → Submodule ℂ W) (m : ℕ) (h0 : F 0 = ⊥) (hm : F m = ⊤)
    (hmono : Monotone F) (hstep : ∀ i, finrank ℂ (F (i + 1)) ≤ finrank ℂ (F i) + 1)
    (hinv : ∀ g : G, ∀ i, ∀ w ∈ F i, ρ g w ∈ F i) :
    (⊤ : Subgroup G).lowerCentralSeries m ≤ ρ.ker := by
  set U := affacdFlagU ρ F hinv with hU
  have hstep' : ∀ n, F (n - 1) ≤ F n ∧ finrank ℂ (F n) ≤ finrank ℂ (F (n - 1)) + 1 := by
    intro n
    rcases n with _ | n
    · simp
    · exact ⟨hmono (Nat.le_succ n), by rw [Nat.add_sub_cancel]; exact hstep n⟩
  have hchar : ∀ n, ∃ χ : G →* ℂ, ∀ g : G, ∀ w ∈ F n, ρ g w - χ g • w ∈ F (n - 1) := fun n =>
    affacd_exists_char_of_step ρ (hstep' n).1 (hstep' n).2 (fun g => hinv g n)
      (fun g => hinv g (n - 1))
  -- the commutator `⁅g, x⁆ = g · (x g⁻¹ x⁻¹)` stays in `U j`
  have hUcomm : ∀ j, ∀ g ∈ U j, ∀ x : G, ⁅g, x⁆ ∈ U j := by
    intro j g hg x
    rw [commutatorElement_def, mul_assoc g x, mul_assoc]
    exact (U j).mul_mem hg (affacdFlagU_conj ρ F hinv j ((U j).inv_mem hg) x)
  -- (B) the diagonal characters commute: `⁅G, G⁆ ≤ U₁`
  have hB : ∀ u x : G, ⁅u, x⁆ ∈ U 1 := by
    intro u x i w hw
    obtain ⟨χ, hχ⟩ := hchar i
    have h1 : χ ⁅u, x⁆ = 1 := by
      rw [commutatorElement_def, map_mul, map_mul, map_mul]
      calc χ u * χ x * χ u⁻¹ * χ x⁻¹ = χ (u * u⁻¹) * χ (x * x⁻¹) := by
              rw [map_mul, map_mul]; ring
        _ = 1 := by simp
    have := hχ ⁅u, x⁆ w hw
    rwa [h1, one_smul] at this
  -- (C) `[U_j, G] ≤ U_{j+1}` for `j ≥ 1`, by nilpotency
  have hC : ∀ j, 1 ≤ j → ∀ u ∈ U j, ∀ x : G, ⁅u, x⁆ ∈ U (j + 1) := by
    intro j hj u hu x i w hw
    obtain ⟨χ, hχ⟩ := hchar i
    obtain ⟨χ', hχ'⟩ := hchar (i - j)
    set p' := F (i - j - 1) with hp'
    let φ : G → W ⧸ p' := fun v => Submodule.Quotient.mk (ρ v w - w)
    have hmk : ∀ a b : W, a - b ∈ p' →
        (Submodule.Quotient.mk a : W ⧸ p') = Submodule.Quotient.mk b :=
      fun a b h => (Submodule.Quotient.eq p').2 h
    -- (a) additivity on `U j`
    have ha : ∀ v ∈ U j, ∀ v' ∈ U j, φ (v * v') = φ v + φ v' := by
      intro v hv v' hv'
      have hy := hv' i w hw
      have h2 : ρ v (ρ v' w - w) - (ρ v' w - w) ∈ p' :=
        hmono (by omega) (hv (i - j) _ hy)
      show Submodule.Quotient.mk _ = Submodule.Quotient.mk _ + Submodule.Quotient.mk _
      rw [← Submodule.Quotient.mk_add]
      apply hmk
      convert h2 using 1
      rw [affacd_mul_apply, map_sub]; abel
    have hone : φ 1 = 0 := by simp [φ]
    have hinvφ : ∀ v ∈ U j, φ v⁻¹ = -φ v := by
      intro v hv
      have := ha v⁻¹ ((U j).inv_mem hv) v hv
      rw [inv_mul_cancel, hone] at this
      exact eq_neg_of_add_eq_zero_left this.symm
    -- (b) conjugation by `x` scales the entry
    set r : ℂ := χ' x * χ x⁻¹ with hr
    have hb : ∀ v ∈ U j, φ (x * v * x⁻¹) = r • φ v := by
      intro v hv
      have hw' : ρ x⁻¹ w ∈ F i := hinv x⁻¹ i w hw
      set y := ρ v (ρ x⁻¹ w) - ρ x⁻¹ w with hy
      have hyF : y ∈ F (i - j) := hv i _ hw'
      have e1 : ρ (x * v * x⁻¹) w - w = ρ x y := by
        rw [hy, affacd_mul_apply, affacd_mul_apply, map_sub, Representation.self_inv_apply]
      have e2 : (Submodule.Quotient.mk (ρ x y) : W ⧸ p') = χ' x • Submodule.Quotient.mk y := by
        rw [← Submodule.Quotient.mk_smul]
        exact hmk _ _ (hχ' x y hyF)
      have hf := hχ x⁻¹ w hw
      have e3 : (Submodule.Quotient.mk y : W ⧸ p') =
          χ x⁻¹ • Submodule.Quotient.mk (ρ v w - w) := by
        rw [← Submodule.Quotient.mk_smul]
        apply hmk
        have h4 := hv (i - 1) _ hf
        have e4 : y - χ x⁻¹ • (ρ v w - w) =
            ρ v (ρ x⁻¹ w - χ x⁻¹ • w) - (ρ x⁻¹ w - χ x⁻¹ • w) := by
          rw [hy, map_sub, map_smul, smul_sub]; abel
        rw [e4]
        exact hmono (by omega) h4
      show Submodule.Quotient.mk _ = r • Submodule.Quotient.mk _
      rw [e1, e2, e3, smul_smul]
    -- (c) the commutator multiplies the entry by `1 − r`
    have hc : ∀ v ∈ U j, φ ⁅v, x⁆ = (1 - r) • φ v := by
      intro v hv
      have e : ⁅v, x⁆ = v * (x * v⁻¹ * x⁻¹) := by group
      rw [e, ha v hv _ (affacdFlagU_conj ρ F hinv j ((U j).inv_mem hv) x),
        hb _ ((U j).inv_mem hv), hinvφ v hv, sub_smul, one_smul, smul_neg, sub_eq_add_neg]
    -- iterate `⁅·, x⁆` and use nilpotency
    let s : ℕ → G := fun k => Nat.rec u (fun _ g => ⁅g, x⁆) k
    have hs : ∀ k, s k ∈ U j ∧ s k ∈ (⊤ : Subgroup G).lowerCentralSeries k ∧
        φ (s k) = (1 - r) ^ k • φ u := by
      intro k
      induction k with
      | zero => exact ⟨hu, Subgroup.mem_top _, by simp [s]⟩
      | succ k ih =>
        refine ⟨hUcomm j _ ih.1 x, Subgroup.commutator_mem_commutator ih.2.1 (Subgroup.mem_top x),
          ?_⟩
        show φ ⁅s k, x⁆ = _
        rw [hc _ ih.1, ih.2.2, smul_smul, pow_succ', mul_comm]
    obtain ⟨c, hcbot⟩ := Subgroup.nilpotent_iff_lowerCentralSeries.1 ‹Group.IsNilpotent G›
    have hsc : s c = 1 := by
      have := (hs c).2.1
      rw [hcbot] at this
      exact Subgroup.mem_bot.1 this
    have hzero : (1 - r) ^ c • φ u = 0 := by rw [← (hs c).2.2, hsc, hone]
    have hfin : φ ⁅u, x⁆ = 0 := by
      rw [hc u hu]
      rcases smul_eq_zero.1 hzero with h | h
      · rw [eq_zero_of_pow_eq_zero h, zero_smul]
      · rw [h, smul_zero]
    have := (Submodule.Quotient.mk_eq_zero p').1 hfin
    rwa [hp', Nat.sub_sub] at this
  -- the induction `γ_{j+1} ≤ U_j`
  have hlcs : ∀ j, (⊤ : Subgroup G).lowerCentralSeries j ≤ U j := by
    intro j
    induction j with
    | zero =>
      intro g _ i w hw
      exact (F (i - 0)).sub_mem (hinv g i w hw) hw
    | succ j ih =>
      rw [Subgroup.lowerCentralSeries_succ, Subgroup.commutator_le]
      intro g₁ hg₁ g₂ _
      rcases Nat.eq_zero_or_pos j with rfl | hj
      · exact hB g₁ g₂
      · exact hC j hj g₁ (ih hg₁) g₂
  intro g hg
  have hgU := hlcs m hg
  rw [MonoidHom.mem_ker]
  refine LinearMap.ext fun w => ?_
  have hw : w ∈ F m := hm ▸ Submodule.mem_top
  have := hgU m w hw
  rw [Nat.sub_self, h0, Submodule.mem_bot, sub_eq_zero] at this
  exact this

/-- **The uniform class bound, complex form**: `γ_{dim W + 1}(G) ≤ ker ρ`. -/
theorem affacd_lowerCentralSeries_le_ker [Group.IsNilpotent G] (ρ : Representation ℂ G W)
    {X : Set G} (hX : Subgroup.closure X = ⊤) (hspec : ∀ x ∈ X, AffSpecNearOne (ρ x)) :
    (⊤ : Subgroup G).lowerCentralSeries (finrank ℂ W) ≤ ρ.ker := by
  obtain ⟨F, h0, hm, hmono, hstep, hinv⟩ := affacd_exists_flag ρ hX hspec
  exact affacd_lowerCentralSeries_le_ker_of_flag ρ F _ h0 hm hmono hstep hinv

end Triang

section Real

variable {W : Type*} [NormedAddCommGroup W] [NormedSpace ℝ W] [FiniteDimensional ℝ W]

/-- **Eigenvalues of the complexification are bounded by the operator norm** (up to `3`). -/
theorem affacd_norm_eigenvalue_baseChange_le (f : W →L[ℝ] W) {μ : ℂ}
    (h : Module.End.HasEigenvalue ((f : W →ₗ[ℝ] W).baseChange ℂ) μ) : ‖μ‖ ≤ 3 * ‖f‖ := by
  by_contra hlt
  push Not at hlt
  obtain ⟨v, hv⟩ := h.exists_hasEigenvector
  rw [Module.End.hasEigenvector_iff, Module.End.mem_eigenspace_iff] at hv
  obtain ⟨hz, hz0⟩ := hv
  set z := v
  have hf0 : 0 ≤ ‖f‖ := norm_nonneg _
  have hμ0 : 0 < ‖μ‖ := lt_of_le_of_lt (by positivity) hlt
  set a : ℝ := μ.re with ha
  set n : ℝ := Complex.normSq μ with hn
  have hnr : n = ‖μ‖ ^ 2 := by rw [hn, Complex.normSq_eq_norm_sq]
  have hnpos : 0 < n := by rw [hnr]; positivity
  set S : W →L[ℝ] W := (2 * a) • f - f * f with hS
  set P : W →L[ℝ] W := n • 1 - S with hP
  -- `P` kills the eigenvector after base change
  set B := (f : W →ₗ[ℝ] W).baseChange ℂ with hB
  have hPz : ((P : W →ₗ[ℝ] W).baseChange ℂ) z = 0 := by
    have e : (P : W →ₗ[ℝ] W) = n • (1 : Module.End ℝ W) - ((2 * a) • (f : W →ₗ[ℝ] W) -
        (f : W →ₗ[ℝ] W) * (f : W →ₗ[ℝ] W)) := by
      ext w; simp [hP, hS]
    rw [e, LinearMap.baseChange_sub, LinearMap.baseChange_sub, LinearMap.baseChange_smul,
      LinearMap.baseChange_smul, LinearMap.baseChange_mul, LinearMap.baseChange_one]
    simp only [LinearMap.sub_apply, LinearMap.smul_apply, Module.End.mul_apply,
      Module.End.one_apply]
    rw [← hB, hz, map_smul, hz, ← algebraMap_smul ℂ n z, ← algebraMap_smul ℂ (2 * a) (μ • z),
      smul_smul, smul_smul, ← sub_smul, ← sub_smul]
    convert zero_smul ℂ z using 2
    apply Complex.ext <;> simp [ha, hn, Complex.normSq_apply] <;> ring
  -- `P` is invertible (Neumann)
  have hSn : ‖S‖ < n := by
    have h1 : ‖S‖ ≤ 2 * |a| * ‖f‖ + ‖f‖ * ‖f‖ := by
      refine (norm_sub_le _ _).trans (add_le_add ?_ (norm_mul_le _ _))
      rw [norm_smul, Real.norm_eq_abs, abs_mul, abs_two]
    have h2 : |a| ≤ ‖μ‖ := Complex.abs_re_le_norm μ
    rw [hnr]
    nlinarith [mul_le_mul_of_nonneg_right h2 hf0]
  have hPunit : IsUnit P := by
    have hT : ‖n⁻¹ • S‖ < 1 := by
      rw [norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hnpos, inv_mul_lt_iff₀ hnpos, mul_one]
      exact hSn
    have e : P = (algebraMap ℝ (W →L[ℝ] W) n) * (1 - n⁻¹ • S) := by
      rw [Algebra.algebraMap_eq_smul_one, mul_sub, mul_one, smul_mul_assoc, one_mul, smul_smul,
        mul_inv_cancel₀ hnpos.ne', one_smul]
    rw [e]
    exact ((isUnit_iff_ne_zero.2 hnpos.ne').map _).mul (Units.oneSub _ hT).isUnit
  obtain ⟨u, hu⟩ := hPunit
  have hQP : ((u⁻¹ : (W →L[ℝ] W)ˣ) : W →L[ℝ] W) * P = 1 := by rw [← hu]; exact u.inv_mul
  have hQP' : (((u⁻¹ : (W →L[ℝ] W)ˣ) : W →L[ℝ] W) : W →ₗ[ℝ] W) * (P : W →ₗ[ℝ] W) = 1 := by
    rw [← ContinuousLinearMap.toLinearMap_mul, hQP]; rfl
  apply hz0
  have := congrArg (fun T : Module.End ℝ W => (T.baseChange ℂ) z) hQP'
  simp only [LinearMap.baseChange_mul, Module.End.mul_apply, hPz, map_zero,
    LinearMap.baseChange_one, Module.End.one_apply] at this
  exact this.symm

/-- The complexification `GL(W) → GL(ℂ ⊗ W)`, as a monoid hom into `End ℂ (ℂ ⊗[ℝ] W)`. -/
noncomputable def affacdComplexify : (W →L[ℝ] W)ˣ →* Module.End ℂ (ℂ ⊗[ℝ] W) :=
  (Module.End.baseChangeHom ℝ ℂ W).toMonoidHom.comp
    (ContinuousLinearMap.toLinearMapRingHom.toMonoidHom.comp (Units.coeHom _))

omit [FiniteDimensional ℝ W] in
/-- Unfolding `affacdComplexify`. -/
theorem affacdComplexify_apply (g : (W →L[ℝ] W)ˣ) :
    affacdComplexify g = (((g : W →L[ℝ] W) : W →ₗ[ℝ] W)).baseChange ℂ := rfl

omit [FiniteDimensional ℝ W] in
/-- The complexification is faithful. -/
theorem affacdComplexify_injective : Function.Injective (affacdComplexify (W := W)) := by
  rw [injective_iff_map_eq_one]
  intro g hg
  apply Units.ext
  refine ContinuousLinearMap.ext fun w => ?_
  have := congrArg (fun T : Module.End ℂ (ℂ ⊗[ℝ] W) => T ((1 : ℂ) ⊗ₜ[ℝ] w)) hg
  simp only [affacdComplexify_apply, LinearMap.baseChange_tmul, Module.End.one_apply] at this
  exact Module.Flat.tensorProduct_mk_injective ℝ W ℂ this

/-- **The uniform class bound, real form**: a nilpotent subgroup of `GL(W)` generated by elements
`1/3`-close to `1` has `γ_{dim W + 1} = 1`. -/
theorem affacd_lowerCentralSeries_eq_bot_of_near_one {X : Set (W →L[ℝ] W)ˣ}
    [Group.IsNilpotent (Subgroup.closure X)]
    (hX : ∀ x ∈ X, ‖((x : (W →L[ℝ] W)ˣ) : W →L[ℝ] W) - 1‖ < 1 / 3) :
    (Subgroup.closure X).lowerCentralSeries (finrank ℝ W) = ⊥ := by
  set H := Subgroup.closure X with hH
  let ρ : Representation ℂ H (ℂ ⊗[ℝ] W) := affacdComplexify.comp H.subtype
  have hgen : Subgroup.closure ((H.subtype) ⁻¹' X) = ⊤ := Subgroup.closure_closure_coe_preimage
  have hspec : ∀ x ∈ (H.subtype) ⁻¹' X, AffSpecNearOne (ρ x) := by
    intro x hx μ hμ
    obtain ⟨z, hz⟩ := hμ.exists_hasEigenvector
    rw [Module.End.hasEigenvector_iff, Module.End.mem_eigenspace_iff] at hz
    have hz' : (((((x : (W →L[ℝ] W)ˣ) : W →L[ℝ] W) - 1 : W →L[ℝ] W) : W →ₗ[ℝ] W).baseChange ℂ) z
        = (μ - 1) • z := by
      have e : ((((x : (W →L[ℝ] W)ˣ) : W →L[ℝ] W) - 1 : W →L[ℝ] W) : W →ₗ[ℝ] W) =
          (((x : (W →L[ℝ] W)ˣ) : W →L[ℝ] W) : W →ₗ[ℝ] W) - 1 := by ext; simp
      rw [e, LinearMap.baseChange_sub, LinearMap.baseChange_one, LinearMap.sub_apply,
        Module.End.one_apply, sub_smul, one_smul]
      exact congrArg (· - z) hz.1
    have hb := affacd_norm_eigenvalue_baseChange_le _
      (Module.End.hasEigenvalue_of_hasEigenvector (Module.End.hasEigenvector_iff.2
        ⟨Module.End.mem_eigenspace_iff.2 hz', hz.2⟩))
    have : ‖((x : (W →L[ℝ] W)ˣ) : W →L[ℝ] W) - 1‖ < 1 / 3 := hX _ hx
    linarith
  have key := affacd_lowerCentralSeries_le_ker ρ hgen hspec
  rw [Module.finrank_baseChange] at key
  rw [← Subgroup.top_subtype_lowerCentralSeries, eq_bot_iff]
  rintro _ ⟨h, hh, rfl⟩
  have h1 : ρ h = 1 := key hh
  have : (h : (W →L[ℝ] W)ˣ) = 1 := affacdComplexify_injective (by rw [map_one]; exact h1)
  exact Subgroup.mem_bot.2 this

variable (W) in
/-- **The uniform class bound** `AffNearOneClassBound W` (`Flat/AffACDBase`), the input of
`Flat/AffACDLocal`. -/
theorem affNearOneClassBound : AffNearOneClassBound W := fun _ hN hX => by
  haveI := hN
  exact affacd_lowerCentralSeries_eq_bot_of_near_one hX

end Real

