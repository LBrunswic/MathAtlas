import Causal.Morphism
import Causal.LinesCurves
import Mathlib.Geometry.Manifold.HasGroupoid
import Mathlib.Topology.Algebra.ConstMulAction
import Mathlib.Topology.LocallyConstant.Basic

/-!
# The causality of a `(G,X)`-manifold

`prop:GX_espace_temps_topo` — `ETT.tex:589` (proof `ETT.tex:597`). Not marked: existence and
the chart condition over the maximal atlas (DEC-16) are proved; the uniqueness as stated is false
in the library's gluing-free reading (SCOPE (d)), proved among absolutely minimal causalities.

> Let $(G,X)$ be an analytic structure and let $(M,\A)$ be a $(G,X)$-manifold.
> If $X$ is a causally arc-connected Baire topological spacetime on which $G$ acts by morphisms
> of topological spacetimes, then $M$ admits a unique topological spacetime structure such that
> for every chart $(\U,\V,\phi)\in\A$ the map $\phi:\U\rightarrow \V$ is an isomorphism of
> topological spacetimes.

> […] Theorem \ref{theo:causalite_engendre} then produces an absolutely minimal causality on $M$
> for which every chart is an isomorphism, and minimality gives uniqueness.

## Hypothesis checklist

| paper hypothesis | here |
|---|---|
| `(G,X)` an analytic structure | ⚠ weakened: not part of the definition (DEC-16), not used |
| `(M,𝒜)` a `(G,X)`-manifold | ✓ carried (DEC-16): `HasGroupoid M (gxGroupoid G X)`, `𝒜` the maximal atlas |
| `X` causally arc-connected | ✓ carried |
| `X` Baire | **⚠ weakened: not used** (OQ-10) |
| `X`, `M` second countable, Hausdorff | ⚠ weakened: not used |
| `G` acts by morphisms | ✓ carried (DEC-12): every `g • ·` a strong morphism |
| uniqueness | ⚠ strengthened: false as stated (`GX_maximal_not_unique`); outright when a chart covers `M`; else among absolutely minimal causalities |

## SCOPE (disclosed)

* **(a)** DEC-16: a maximal atlas whose transitions are, near each point, restrictions of
  elements of `G` (`gxGroupoid`, mathlib's `maximalAtlas`). `existsUnique_causality_GX` states
  the chart condition over a generating atlas; `chartIso_of_mem_maximalAtlas` extends it to the
  maximal atlas, giving `existsUnique_causality_GX_maximal`.
* **(b)** DEC-12: strong morphisms. `G` being a group, each `g` is an isomorphism
  (`smul_rel_iff`).
* **(c)** "isomorphism": `ChartIso`, on the relations. By `chartIso_iff_strongMorphism` it is a
  strong morphism of the subspaces with a strong-morphism inverse (DEC-12).
* **(d) Uniqueness** is false in the paper's "equivalently" form of `defi:causalite`, which the
  library implements without gluing, and true if the sheaf clause is read as gluing (`≤`
  generated by covers, i.e. absolute minimality). The defect is in the claimed equivalence, not in
  the proposition. Over the maximal atlas: if some chart covers `M`, uniqueness holds outright
  (`existsUnique_causality_GX_of_covering_chart`; the identity of `ℝ` makes the earlier interval
  witness `GX_not_unique_without_minimality`, a non-maximal atlas, disappear,
  `eq_of_chartIso_refl`). If none does it can fail: on `ℝ ⊔ ℝ` for the translations of the
  timelike line, no chart of the maximal atlas covers the space, and enlarging `≤_M` to all pairs
  (`Causality.topEnlarge`, non-local by kb/0014) keeps every chart an isomorphism
  (`GX_maximal_not_unique`).
* (B) uses the minimality of the model on every open subset (`compatible_of_agree_locally`): a
  transition is an element of `G` only locally.
* Sanity: `X` with its own atlas gets back its causality (`causality_GX_self`).

Provenance: mathlib `fabf563a` (tag `v4.31.0`), pinned via `lakefile.toml`.
-/

namespace Causal

open Set TopologicalSpace Topology Relation Filter

universe u v w x

variable {M : Type u} {X : Type v} [TopologicalSpace M] [TopologicalSpace X]

/-! ### Charts: sources and images as open sets -/

/-- The source of a chart, as an open set. -/
def chartSource (e : OpenPartialHomeomorph M X) : Opens M := ⟨e.source, e.open_source⟩

/-- The image by the chart `e` of the part of `U` in its source, as an open set. -/
def chartImage (e : OpenPartialHomeomorph M X) (U : Opens M) : Opens X :=
  ⟨e '' (e.source ∩ U), e.isOpen_image_source_inter U.isOpen⟩

/-- The chart `e` is an **isomorphism of topological spacetimes** from its source, with the
causality `C`, onto its target, with `D` (SCOPE (c)): for every open `U` in the source and all
`x, y ∈ U`, `x ≤_U y ↔ e x ≤_{e(U)} e y` and `x ≪_U y ↔ e x ≪_{e(U)} e y`. -/
def ChartIso (C : Causality M) (D : Causality X) (e : OpenPartialHomeomorph M X) : Prop :=
  ∀ U : Opens M, U ≤ chartSource e → ∀ x ∈ U, ∀ y ∈ U,
    (C.le U x y ↔ D.le (chartImage e U) (e x) (e y)) ∧
      (C.lt U x y ↔ D.lt (chartImage e U) (e x) (e y))

section Charts

variable {e : OpenPartialHomeomorph M X} {U V : Opens M} {x y : M}

@[simp] theorem coe_chartSource : (chartSource e : Set M) = e.source := rfl

@[simp] theorem coe_chartImage : (chartImage e U : Set X) = e '' (e.source ∩ U) := rfl

theorem mem_chartSource : x ∈ chartSource e ↔ x ∈ e.source := Iff.rfl

theorem mem_chartImage_of_mem (hx : x ∈ e.source) (hxU : x ∈ U) : e x ∈ chartImage e U :=
  ⟨x, ⟨hx, hxU⟩, rfl⟩

theorem chartImage_mono (h : V ≤ U) : chartImage e V ≤ chartImage e U :=
  image_mono (inter_subset_inter_right _ h)

/-- A point of `chartImage e U` is the image of a point of `U` in the source, which the inverse
recovers. -/
theorem exists_of_mem_chartImage {p : X} (hp : p ∈ chartImage e U) :
    ∃ z, z ∈ e.source ∧ z ∈ U ∧ e z = p ∧ e.symm p = z := by
  obtain ⟨z, ⟨hz, hzU⟩, rfl⟩ := hp
  exact ⟨z, hz, hzU, rfl, e.left_inv hz⟩

/-- On the source, a chart preserves intersections. -/
theorem chartImage_inf : chartImage e (U ⊓ V) = chartImage e U ⊓ chartImage e V := by
  apply SetLike.coe_injective
  ext p
  constructor
  · rintro ⟨z, ⟨hz, hzU, hzV⟩, rfl⟩
    exact ⟨⟨z, ⟨hz, hzU⟩, rfl⟩, ⟨z, ⟨hz, hzV⟩, rfl⟩⟩
  · rintro ⟨⟨z, ⟨hz, hzU⟩, rfl⟩, ⟨z', ⟨hz', hzV⟩, hzz⟩⟩
    have : z' = z := e.injOn hz' hz hzz
    subst this
    exact ⟨z', ⟨hz, hzU, hzV⟩, rfl⟩

theorem coe_chartImage_of_le (hU : U ≤ chartSource e) : (chartImage e U : Set X) = e '' U := by
  have hU' : (U : Set M) ⊆ e.source := hU
  rw [coe_chartImage, inter_eq_right.2 hU']

end Charts

/-! ### Transporting a causality along a chart -/

/-- The causality `D` of the model, transported to the source of the chart `e`: `x ≤_U y` if
`x, y ∈ U` and `e x ≤_{e(U)} e y`. -/
def chartLocal (D : Causality X) (e : OpenPartialHomeomorph M X) :
    LocalCausality (chartSource e) where
  le U x y := x ∈ U ∧ y ∈ U ∧ D.le (chartImage e U) (e x) (e y)
  lt U x y := x ∈ U ∧ y ∈ U ∧ D.lt (chartImage e U) (e x) (e y)
  le_mem_left _ h := h.1
  le_mem_right _ h := h.2.1
  lt_mem_left _ h := h.1
  lt_mem_right _ h := h.2.1
  le_refl hU hx := ⟨hx, hx, D.le_refl (mem_chartImage_of_mem (hU hx) hx)⟩
  le_trans _ h₁ h₂ := ⟨h₁.1, h₂.2.1, D.le_trans h₁.2.2 h₂.2.2⟩
  lt_trans _ h₁ h₂ := ⟨h₁.1, h₂.2.1, D.lt_trans h₁.2.2 h₂.2.2⟩
  le_mono _ hVU _ _ h := ⟨hVU h.1, hVU h.2.1, D.le_mono (chartImage_mono hVU) h.2.2⟩
  lt_mono _ hVU _ _ h := ⟨hVU h.1, hVU h.2.1, D.lt_mono (chartImage_mono hVU) h.2.2⟩
  le_of_lt _ h := ⟨h.1, h.2.1, D.le_of_lt h.2.2⟩
  isOpen_lt_right U x hU := by
    by_cases hx : x ∈ U
    · have heq : {y | x ∈ U ∧ y ∈ U ∧ D.lt (chartImage e U) (e x) (e y)} =
          (U : Set M) ∩ (e.source ∩ e ⁻¹' {q | D.lt (chartImage e U) (e x) q}) := by
        ext y
        simp only [mem_setOf_eq, mem_inter_iff, mem_preimage]
        exact ⟨fun h => ⟨h.2.1, hU h.2.1, h.2.2⟩, fun h => ⟨hx, h.1, h.2.2⟩⟩
      rw [heq]
      exact U.isOpen.inter (e.isOpen_inter_preimage (D.isOpen_lt_right _ _))
    · convert isOpen_empty
      ext y
      simp [hx]
  isOpen_lt_left U x hU := by
    by_cases hx : x ∈ U
    · have heq : {y | y ∈ U ∧ x ∈ U ∧ D.lt (chartImage e U) (e y) (e x)} =
          (U : Set M) ∩ (e.source ∩ e ⁻¹' {q | D.lt (chartImage e U) q (e x)}) := by
        ext y
        simp only [mem_setOf_eq, mem_inter_iff, mem_preimage]
        exact ⟨fun h => ⟨h.1, hU h.1, h.2.2⟩, fun h => ⟨h.1, hx, h.2.2⟩⟩
      rw [heq]
      exact U.isOpen.inter (e.isOpen_inter_preimage (D.isOpen_lt_left _ _))
    · convert isOpen_empty
      ext y
      simp [hx]

/-- The causality `D` transported along the chart `e`, extended to `M` (`Causal.Local`); only its
restriction to the source of `e` is ever read. -/
def Causality.chartTransport (D : Causality X) (e : OpenPartialHomeomorph M X) : Causality M :=
  (chartLocal D e).extend

/-- The transported causality makes the chart an isomorphism: existence, chart by chart. -/
theorem Causality.chartTransport_chartIso (D : Causality X) (e : OpenPartialHomeomorph M X) :
    ChartIso (D.chartTransport e) D e := by
  intro U hU x hx y hy
  refine ⟨?_, ?_⟩
  · rw [Causality.chartTransport, LocalCausality.extend_le_iff hU]
    exact ⟨fun h => h.2.2, fun h => ⟨hx, hy, h⟩⟩
  · rw [Causality.chartTransport, LocalCausality.extend_lt_iff hU]
    exact ⟨fun h => h.2.2, fun h => ⟨hx, hy, h⟩⟩

namespace ChartIso

variable {C C' : Causality M} {D : Causality X} {e : OpenPartialHomeomorph M X}
  {U V W : Opens M} {x y : M}

/-- Through an isomorphism, a chain of the model is a chain of `M`: the step of
`ChartIso.absolutelyMinimalOn`. -/
theorem transGen_of_transGen (h : ChartIso C D e) (hV : V ≤ chartSource e) {S : Set (Opens M)}
    {p q : X}
    (hpq : TransGen (fun a b => ∃ O' ∈ chartImage e '' S, D.le (chartImage e V ⊓ O') a b) p q) :
    TransGen (fun a b => ∃ O ∈ S, C.le (V ⊓ O) a b) (e.symm p) (e.symm q) := by
  have step : ∀ a b, (∃ O' ∈ chartImage e '' S, D.le (chartImage e V ⊓ O') a b) →
      ∃ O ∈ S, C.le (V ⊓ O) (e.symm a) (e.symm b) := by
    rintro a b ⟨_, ⟨O, hO, rfl⟩, hab⟩
    rw [← chartImage_inf] at hab
    obtain ⟨a₀, ha₀, ha₀V, rfl, ha⟩ := exists_of_mem_chartImage (D.le_mem_left hab)
    obtain ⟨b₀, hb₀, hb₀V, rfl, hb⟩ := exists_of_mem_chartImage (D.le_mem_right hab)
    refine ⟨O, hO, ?_⟩
    rw [ha, hb]
    exact ((h (V ⊓ O) (inf_le_left.trans hV) a₀ ha₀V b₀ hb₀V).1).2 hab
  induction hpq with
  | single hl => exact TransGen.single (step _ _ hl)
  | tail _ hl ih => exact ih.tail (step _ _ hl)

theorem transGen_of_transGen_lt (h : ChartIso C D e) (hV : V ≤ chartSource e)
    {S : Set (Opens M)} {p q : X}
    (hpq : TransGen (fun a b => ∃ O' ∈ chartImage e '' S, D.lt (chartImage e V ⊓ O') a b) p q) :
    TransGen (fun a b => ∃ O ∈ S, C.lt (V ⊓ O) a b) (e.symm p) (e.symm q) := by
  have step : ∀ a b, (∃ O' ∈ chartImage e '' S, D.lt (chartImage e V ⊓ O') a b) →
      ∃ O ∈ S, C.lt (V ⊓ O) (e.symm a) (e.symm b) := by
    rintro a b ⟨_, ⟨O, hO, rfl⟩, hab⟩
    rw [← chartImage_inf] at hab
    obtain ⟨a₀, ha₀, ha₀V, rfl, ha⟩ := exists_of_mem_chartImage (D.lt_mem_left hab)
    obtain ⟨b₀, hb₀, hb₀V, rfl, hb⟩ := exists_of_mem_chartImage (D.lt_mem_right hab)
    refine ⟨O, hO, ?_⟩
    rw [ha, hb]
    exact ((h (V ⊓ O) (inf_le_left.trans hV) a₀ ha₀V b₀ hb₀V).2).2 hab
  induction hpq with
  | single hl => exact TransGen.single (step _ _ hl)
  | tail _ hl ih => exact ih.tail (step _ _ hl)

/-- (A) of `theo:causalite_engendre`, transported: an open subset of the source whose image is
absolutely minimal is absolutely minimal. -/
theorem absolutelyMinimalOn (h : ChartIso C D e) (hW : W ≤ chartSource e)
    (hD : D.AbsolutelyMinimalOn (chartImage e W)) : C.AbsolutelyMinimalOn W := by
  intro S hS V hV x y
  have hS' : ∀ p ∈ chartImage e W, ∃ O' ∈ chartImage e '' S, p ∈ O' := by
    intro p hp
    obtain ⟨z, hz, hzW, rfl, -⟩ := exists_of_mem_chartImage hp
    obtain ⟨O, hO, hzO⟩ := hS z hzW
    exact ⟨chartImage e O, mem_image_of_mem _ hO, mem_chartImage_of_mem hz hzO⟩
  have hVs : V ≤ chartSource e := hV.trans hW
  refine ⟨fun hxy => ?_, fun hxy => ?_⟩
  · have hx := C.le_mem_left hxy
    have hy := C.le_mem_right hxy
    have h' := ((h V hVs x hx y hy).1).1 hxy
    have hc := ((hD _ hS' (chartImage e V) (chartImage_mono hV) _ _).1 h')
    have := transGen_of_transGen h hVs hc
    rwa [e.left_inv (hVs hx), e.left_inv (hVs hy)] at this
  · have hx := C.lt_mem_left hxy
    have hy := C.lt_mem_right hxy
    have h' := ((h V hVs x hx y hy).2).1 hxy
    have hc := ((hD _ hS' (chartImage e V) (chartImage_mono hV) _ _).2 h')
    have := transGen_of_transGen_lt h hVs hc
    rwa [e.left_inv (hVs hx), e.left_inv (hVs hy)] at this

/-- Two causalities for which the same chart is an isomorphism agree on the open subsets of its
source. -/
theorem agree (h : ChartIso C D e) (h' : ChartIso C' D e) (hV : V ≤ chartSource e) (x y : M) :
    (C.le V x y ↔ C'.le V x y) ∧ (C.lt V x y ↔ C'.lt V x y) := by
  refine ⟨⟨fun hxy => ?_, fun hxy => ?_⟩, ⟨fun hxy => ?_, fun hxy => ?_⟩⟩
  · have hx := C.le_mem_left hxy; have hy := C.le_mem_right hxy
    exact ((h' V hV x hx y hy).1).2 (((h V hV x hx y hy).1).1 hxy)
  · have hx := C'.le_mem_left hxy; have hy := C'.le_mem_right hxy
    exact ((h V hV x hx y hy).1).2 (((h' V hV x hx y hy).1).1 hxy)
  · have hx := C.lt_mem_left hxy; have hy := C.lt_mem_right hxy
    exact ((h' V hV x hx y hy).2).2 (((h V hV x hx y hy).2).1 hxy)
  · have hx := C'.lt_mem_left hxy; have hy := C'.lt_mem_right hxy
    exact ((h V hV x hx y hy).2).2 (((h' V hV x hx y hy).2).1 hxy)

/-- A chart which is an isomorphism for `C` is one for every causality agreeing with `C` on the
open subsets of its source. -/
theorem congr (h : ChartIso C D e)
    (hC : ∀ V : Opens M, V ≤ chartSource e → ∀ x y, (C'.le V x y ↔ C.le V x y) ∧
      (C'.lt V x y ↔ C.lt V x y)) : ChartIso C' D e := by
  intro U hU x hx y hy
  rw [(hC U hU x y).1, (hC U hU x y).2]
  exact h U hU x hx y hy

/-- Two charts into the models `D`, `D'`, isomorphisms for `C₁` and `C₂`, whose images of every
open subset of `O` carry corresponding relations: then `C₁` and `C₂` agree on `O`. This is (B) of
`theo:causalite_engendre`, locally; the hypothesis `hrel` is where the transition maps enter. -/
theorem agree_of_rel {Y : Type w} [TopologicalSpace Y] {D' : Causality Y}
    {e' : OpenPartialHomeomorph M Y} (h : ChartIso C D e) (h' : ChartIso C' D' e')
    {O : Opens M} (hO : O ≤ chartSource e) (hO' : O ≤ chartSource e')
    (hrel : ∀ V : Opens M, V ≤ O → ∀ a ∈ V, ∀ b ∈ V,
      (D.le (chartImage e V) (e a) (e b) ↔ D'.le (chartImage e' V) (e' a) (e' b)) ∧
        (D.lt (chartImage e V) (e a) (e b) ↔ D'.lt (chartImage e' V) (e' a) (e' b)))
    (hV : V ≤ O) (x y : M) : (C.le V x y ↔ C'.le V x y) ∧ (C.lt V x y ↔ C'.lt V x y) := by
  have hVs := hV.trans hO
  have hVs' := hV.trans hO'
  refine ⟨⟨fun hxy => ?_, fun hxy => ?_⟩, ⟨fun hxy => ?_, fun hxy => ?_⟩⟩
  · have hx := C.le_mem_left hxy; have hy := C.le_mem_right hxy
    exact ((h' V hVs' x hx y hy).1).2 (((hrel V hV x hx y hy).1).1
      (((h V hVs x hx y hy).1).1 hxy))
  · have hx := C'.le_mem_left hxy; have hy := C'.le_mem_right hxy
    exact ((h V hVs x hx y hy).1).2 (((hrel V hV x hx y hy).1).2
      (((h' V hVs' x hx y hy).1).1 hxy))
  · have hx := C.lt_mem_left hxy; have hy := C.lt_mem_right hxy
    exact ((h' V hVs' x hx y hy).2).2 (((hrel V hV x hx y hy).2).1
      (((h V hVs x hx y hy).2).1 hxy))
  · have hx := C'.lt_mem_left hxy; have hy := C'.lt_mem_right hxy
    exact ((h V hVs x hx y hy).2).2 (((hrel V hV x hx y hy).2).2
      (((h' V hVs' x hx y hy).2).1 hxy))

end ChartIso

/-! ### Gluing local causalities which agree locally -/

/-- A causality is determined by its relations (the other fields are propositions). -/
theorem Causality.ext_toPrecausality {C₁ C₂ : Causality M}
    (h : C₁.toPrecausality = C₂.toPrecausality) : C₁ = C₂ := by
  cases C₁; cases C₂; cases h; rfl

section Gluing

variable {ι : Type w} {U : ι → Opens M} {C : ι → Causality M}

/-- Local agreement of `C i` and `C j` on the open set `O`. -/
def AgreeOn (C₁ C₂ : Causality M) (O : Opens M) : Prop :=
  ∀ V : Opens M, V ≤ O → ∀ x y : M, (C₁.le V x y ↔ C₂.le V x y) ∧ (C₁.lt V x y ↔ C₂.lt V x y)

/-- One direction of (B): if `C₁` is absolutely minimal on `W` and agrees with `C₂` near every
point of `W`, every relation of `C₁` in an open `V ⊆ W` is one of `C₂`. -/
theorem imp_of_agree_locally {C₁ C₂ : Causality M} {W : Opens M} (hA : C₁.AbsolutelyMinimalOn W)
    (hB : ∀ x ∈ W, ∃ O : Opens M, x ∈ O ∧ AgreeOn C₁ C₂ O) {V : Opens M} (hV : V ≤ W)
    {x y : M} : (C₁.le V x y → C₂.le V x y) ∧ (C₁.lt V x y → C₂.lt V x y) := by
  have hS : ∀ x ∈ W, ∃ O ∈ {O : Opens M | AgreeOn C₁ C₂ O}, x ∈ O := fun x hx => by
    obtain ⟨O, hxO, hO⟩ := hB x hx
    exact ⟨O, hO, hxO⟩
  refine ⟨fun hxy => ?_, fun hxy => ?_⟩
  · refine Precausality.le_of_transGen (S := {O : Opens M | AgreeOn C₁ C₂ O})
      (TransGen.mono ?_ ((hA _ hS V hV x y).1 hxy))
    rintro a b ⟨O, hO, hab⟩
    exact ⟨O, hO, ((hO (V ⊓ O) inf_le_right a b).1).1 hab⟩
  · refine Precausality.lt_of_transGen (S := {O : Opens M | AgreeOn C₁ C₂ O})
      (TransGen.mono ?_ ((hA _ hS V hV x y).2 hxy))
    rintro a b ⟨O, hO, hab⟩
    exact ⟨O, hO, ((hO (V ⊓ O) inf_le_right a b).2).1 hab⟩

theorem AgreeOn.symm {C₁ C₂ : Causality M} {O : Opens M} (h : AgreeOn C₁ C₂ O) :
    AgreeOn C₂ C₁ O := fun V hV x y => ⟨(h V hV x y).1.symm, (h V hV x y).2.symm⟩

/-- (B) of `theo:causalite_engendre` from local agreement: causalities which are absolutely
minimal on every open subset of their domain and agree near every point of the overlaps agree on
the overlaps. -/
theorem compatible_of_agree_locally (hA : ∀ i, ∀ W : Opens M, W ≤ U i → (C i).AbsolutelyMinimalOn W)
    (hB : ∀ i j, ∀ x ∈ U i ⊓ U j, ∃ O : Opens M, x ∈ O ∧ AgreeOn (C i) (C j) O) :
    Precausality.Compatible U fun i => (C i).toPrecausality := by
  intro i j V hV x y
  have h₁ := imp_of_agree_locally (hA i _ inf_le_left) (hB i j) hV (x := x) (y := y)
  have h₂ := imp_of_agree_locally (hA j _ inf_le_right)
    (fun z hz => by
      obtain ⟨O, hzO, hO⟩ := hB i j z hz
      exact ⟨O, hzO, hO.symm⟩) hV (x := x) (y := y)
  exact ⟨⟨h₁.1, h₂.1⟩, ⟨h₁.2, h₂.2⟩⟩

/-- `theo:causalite_engendre` with (B) asked locally, and the uniqueness the absolute minimality
gives. Let `(U_i)` be an open cover of `M`, `C i` a causality on `U_i` absolutely minimal on every
open subset of `U_i`, the `C i` agreeing near every point of the overlaps. Then there is an
absolutely minimal causality on `M` restricting to `C i` on every open subset of `U_i`, and it is
the only absolutely minimal one. -/
theorem existsUnique_absolutelyMinimal_of_agree_locally (hU : ∀ x : M, ∃ i, x ∈ U i)
    (hA : ∀ i, ∀ W : Opens M, W ≤ U i → (C i).AbsolutelyMinimalOn W)
    (hB : ∀ i j, ∀ x ∈ U i ⊓ U j, ∃ O : Opens M, x ∈ O ∧ AgreeOn (C i) (C j) O) :
    ∃ C₀ : Causality M, (∀ i, AgreeOn C₀ (C i) (U i)) ∧ C₀.AbsolutelyMinimal ∧
      ∀ C' : Causality M, (∀ i, AgreeOn C' (C i) (U i)) → C'.AbsolutelyMinimal → C' = C₀ := by
  have hcompat := compatible_of_agree_locally hA hB
  refine ⟨Causality.generated U hU C, fun i V hV x y =>
    ⟨Precausality.generated_le_iff (hU := hU) hcompat hV,
      Precausality.generated_lt_iff (hU := hU) hcompat hV⟩,
    Causality.generated_absolutelyMinimal hU fun i => hA i _ le_rfl, ?_⟩
  intro C' hC' hmin
  have hmin' := Precausality.absolutelyMinimal_iff.1 hmin
  have key : C'.toPrecausality = (Causality.generated U hU C).toPrecausality := by
    ext V x y
    · constructor
      · intro hxy
        refine TransGen.mono ?_ (hmin'.linkLe_of_family U (fun x _ => hU x) le_top hxy)
        rintro a b ⟨i, hab⟩
        exact ⟨i, ((hC' i _ inf_le_right a b).1).1 hab⟩
      · exact Precausality.generated_le_imp (hU := hU) C'.toPrecausality
          fun i V hV x y h => ((hC' i V hV x y).1).2 h
    · constructor
      · intro hxy
        refine TransGen.mono ?_ (hmin'.linkLt_of_family U (fun x _ => hU x) le_top hxy)
        rintro a b ⟨i, hab⟩
        exact ⟨i, ((hC' i _ inf_le_right a b).2).1 hab⟩
      · exact Precausality.generated_lt_imp (hU := hU) C'.toPrecausality
          fun i V hV x y h => ((hC' i V hV x y).2).2 h
  exact Causality.ext_toPrecausality key

end Gluing

/-! ### `(G,X)`-structures -/

section GX

/-- The pregroupoid of the maps which are, near every point of the set, the action of an element
of `G` (SCOPE (a)). -/
def gxPregroupoid (G : Type w) (X : Type v) [TopologicalSpace X] [Group G] [MulAction G X]
    [ContinuousConstSMul G X] : Pregroupoid X where
  property f s := ∀ x ∈ s, ∃ g : G, f =ᶠ[𝓝 x] fun y => g • y
  comp {f f' u v} hf hf' _ _ _ := by
    rintro x ⟨hxu, hxv⟩
    obtain ⟨a, ha⟩ := hf x hxu
    obtain ⟨b, hb⟩ := hf' (f x) hxv
    have hcont : ContinuousAt f x :=
      (continuous_const_smul a).continuousAt.congr ha.symm
    refine ⟨b * a, ?_⟩
    filter_upwards [hcont.eventually hb, ha] with y hy hy'
    show f' (f y) = (b * a) • y
    rw [hy, hy', mul_smul]
  id_mem x _ := ⟨1, Eventually.of_forall fun y => (one_smul G y).symm⟩
  locality {f u} _ h x hx := by
    obtain ⟨v, -, hxv, hp⟩ := h x hx
    exact hp x ⟨hx, hxv⟩
  congr {f f' u} hu heq hf x hx := by
    obtain ⟨g, hg⟩ := hf x hx
    refine ⟨g, ?_⟩
    filter_upwards [hu.mem_nhds hx, hg] with y hy hy'
    rw [heq y hy, hy']

/-- **The groupoid of a `(G,X)`-structure**: the open partial homeomorphisms of `X` which, near
every point of their source, are the restriction of an element of `G`. A `(G,X)`-manifold is a
charted space `ChartedSpace X M` with `HasGroupoid M (gxGroupoid G X)`. -/
def gxGroupoid (G : Type w) (X : Type v) [TopologicalSpace X] [Group G] [MulAction G X]
    [ContinuousConstSMul G X] : StructureGroupoid X := (gxPregroupoid G X).groupoid

variable {G : Type w} [Group G] [MulAction G X] [ContinuousConstSMul G X]

/-- The transition between two charts of a `(G,X)`-manifold is, near every point of the overlap,
the action of an element of `G`. -/
theorem exists_smul_eq_of_mem_gxGroupoid {e e' : OpenPartialHomeomorph M X}
    (h : e.symm.trans e' ∈ gxGroupoid G X) {x : M} (hx : x ∈ e.source) (hx' : x ∈ e'.source) :
    ∃ g : G, ∃ O : Opens M, x ∈ O ∧ O ≤ chartSource e ⊓ chartSource e' ∧
      ∀ z ∈ O, e' z = g • e z := by
  have hmem : e x ∈ (e.symm.trans e').source := by
    rw [OpenPartialHomeomorph.trans_source, OpenPartialHomeomorph.symm_source]
    exact ⟨e.map_source hx, by simpa [e.left_inv hx] using hx'⟩
  obtain ⟨g, hg⟩ := (mem_groupoid_of_pregroupoid.1 h).1 (e x) hmem
  rw [OpenPartialHomeomorph.coe_trans] at hg
  let O : Opens M := ⟨(e.source ∩ e'.source) ∩ e ⁻¹' interior {y | e' (e.symm y) = g • y}, by
    have := e.isOpen_inter_preimage (isOpen_interior (s := {y | e' (e.symm y) = g • y}))
    convert this.inter e'.open_source using 1
    ext z; simp only [mem_inter_iff, mem_preimage]; tauto⟩
  refine ⟨g, O, ⟨⟨hx, hx'⟩, ?_⟩, fun z hz => ⟨hz.1.1, hz.1.2⟩, fun z hz => ?_⟩
  · exact mem_interior_iff_mem_nhds.2 hg
  · have := interior_subset hz.2
    simp only [mem_setOf_eq, e.left_inv hz.1.1] at this
    exact this

/-- The image of an open set under the action of `g`. -/
def smulOpens (g : G) (V : Opens X) : Opens X :=
  ⟨(fun p => g • p) '' V, isOpenMap_smul g _ V.isOpen⟩

/-- If `G` acts by strong morphisms, each `g ∈ G` is an isomorphism of topological spacetimes: it
matches the relations of every open `V` with those of `g V`. -/
theorem smul_rel_iff {D : Causality X} (hG : ∀ g : G, StrongMorphism D D fun p => g • p)
    (g : G) (V : Opens X) (a b : X) :
    (D.le (smulOpens g V) (g • a) (g • b) ↔ D.le V a b) ∧
      (D.lt (smulOpens g V) (g • a) (g • b) ↔ D.lt V a b) := by
  have h₁ : (smulOpens g V : Set X) = (fun p => g⁻¹ • p) ⁻¹' V := by
    ext p
    simp only [smulOpens, Opens.coe_mk, mem_image, mem_preimage]
    constructor
    · rintro ⟨q, hq, rfl⟩; simpa using hq
    · intro hp; exact ⟨g⁻¹ • p, hp, by simp⟩
  have h₂ : (V : Set X) = (fun p => g • p) ⁻¹' (smulOpens g V) := by
    show (V : Set X) = (fun p => g • p) ⁻¹' ((fun p => g • p) '' (V : Set X))
    exact ((MulAction.injective g).preimage_image _).symm
  refine ⟨⟨fun h => ?_, fun h => (hG g).map_le _ V h₂ h⟩,
    ⟨fun h => ?_, fun h => (hG g).map_lt _ V h₂ h⟩⟩
  · simpa using (hG g⁻¹).map_le V _ h₁ h
  · simpa using (hG g⁻¹).map_lt V _ h₁ h

/-- (B), locally: two charts of a `(G,X)`-manifold, isomorphisms for `C` and `C'`, give
causalities which agree near every point of the overlap of their sources. -/
theorem ChartIso.agreeOn_of_smul {C C' : Causality M} {D : Causality X}
    (hG : ∀ g : G, StrongMorphism D D fun p => g • p) {e e' : OpenPartialHomeomorph M X}
    (h : ChartIso C D e) (h' : ChartIso C' D e') {g : G} {O : Opens M}
    (hO : O ≤ chartSource e ⊓ chartSource e') (heq : ∀ z ∈ O, e' z = g • e z) :
    AgreeOn C C' O := by
  intro V hV x y
  refine h.agree_of_rel h' (hO.trans inf_le_left) (hO.trans inf_le_right) ?_ hV x y
  intro V hV a ha b hb
  have himg : chartImage e' V = smulOpens g (chartImage e V) := by
    apply SetLike.coe_injective
    change (chartImage e' V : Set X) = (fun p => g • p) '' (chartImage e V : Set X)
    rw [coe_chartImage_of_le (hV.trans (hO.trans inf_le_right)),
      coe_chartImage_of_le (hV.trans (hO.trans inf_le_left)), image_image]
    exact image_congr fun z hz => heq z (hV hz)
  rw [himg, heq a (hV ha), heq b (hV hb)]
  exact ⟨(smul_rel_iff hG g _ _ _).1.symm, (smul_rel_iff hG g _ _ _).2.symm⟩

/-- A causally arc-connected model is absolutely minimal on every open subset. -/
theorem Causality.CausallyArcConnected.absolutelyMinimalOn_all {D : Causality X}
    (hD : D.CausallyArcConnected) (W : Opens X) : D.AbsolutelyMinimalOn W :=
  Causality.CausallyArcConnectedOn.absolutelyMinimalOn (Causality.CausallyArcConnectedOn.mono hD le_top)

variable [ChartedSpace X M] [HasGroupoid M (gxGroupoid G X)]

/-- `prop:GX_espace_temps_topo` over a generating atlas (SCOPE (a), (d)). Let `(M, 𝒜)` be a
`(G,X)`-manifold, `X` a causally arc-connected topological spacetime on which `G` acts by
strong morphisms. Then `M` carries an absolutely minimal causality for which every chart of `𝒜`
is an isomorphism of topological spacetimes, and it is the only absolutely minimal one. -/
theorem existsUnique_causality_GX (D : Causality X) (hD : D.CausallyArcConnected)
    (hG : ∀ g : G, StrongMorphism D D fun p => g • p) :
    ∃ C : Causality M, (∀ e ∈ atlas X M, ChartIso C D e) ∧ C.AbsolutelyMinimal ∧
      ∀ C' : Causality M, (∀ e ∈ atlas X M, ChartIso C' D e) → C'.AbsolutelyMinimal → C' = C := by
  let U : atlas X M → Opens M := fun e => chartSource e.1
  let Cl : atlas X M → Causality M := fun e => D.chartTransport e.1
  have hU : ∀ x : M, ∃ i, x ∈ U i := fun x =>
    ⟨⟨chartAt X x, chart_mem_atlas X x⟩, mem_chart_source X x⟩
  have hiso : ∀ i, ChartIso (Cl i) D i.1 := fun i => D.chartTransport_chartIso i.1
  have hA : ∀ i, ∀ W : Opens M, W ≤ U i → (Cl i).AbsolutelyMinimalOn W := fun i W hW =>
    (hiso i).absolutelyMinimalOn hW (hD.absolutelyMinimalOn_all _)
  have hB : ∀ i j, ∀ x ∈ U i ⊓ U j, ∃ O : Opens M, x ∈ O ∧ AgreeOn (Cl i) (Cl j) O := by
    intro i j x hx
    obtain ⟨g, O, hxO, hO, heq⟩ := exists_smul_eq_of_mem_gxGroupoid
      (HasGroupoid.compatible (G := gxGroupoid G X) i.2 j.2) hx.1 hx.2
    exact ⟨O, hxO, (hiso i).agreeOn_of_smul hG (hiso j) hO heq⟩
  obtain ⟨C, hC, hmin, huniq⟩ := existsUnique_absolutelyMinimal_of_agree_locally hU hA hB
  refine ⟨C, fun e he => (hiso ⟨e, he⟩).congr (hC ⟨e, he⟩), hmin, fun C' hC' hmin' => ?_⟩
  refine huniq C' (fun i V hV x y => ?_) hmin'
  exact (hC' i.1 i.2).agree (hiso i) hV x y

/-- An absolutely minimal causality which is absolutely minimal on every open subset of the
members of some open cover is absolutely minimal on every open set. -/
theorem absolutelyMinimalOn_of_locally {C : Causality M} (hmin : C.AbsolutelyMinimal)
    (hloc : ∀ x : M, ∃ N : Opens M, x ∈ N ∧ ∀ W : Opens M, W ≤ N → C.AbsolutelyMinimalOn W)
    (W : Opens M) : C.AbsolutelyMinimalOn W := by
  choose N hxN hN using hloc
  have hmin' := Precausality.absolutelyMinimal_iff.1 hmin
  intro S hS V hV x y
  have hS' : ∀ z, ∀ p ∈ V ⊓ N z, ∃ O ∈ S, p ∈ O := fun z p hp => hS p (hV hp.1)
  refine ⟨fun hxy => ?_, fun hxy => ?_⟩
  · have hchain := hmin'.linkLe_of_family N (fun x _ => ⟨x, hxN x⟩) le_top hxy
    clear hxy
    have step : ∀ a b, Precausality.LinkLe N (fun _ => C.toPrecausality) V a b →
        TransGen (fun a b => ∃ O ∈ S, C.le (V ⊓ O) a b) a b := by
      rintro a b ⟨z, hab⟩
      refine TransGen.mono ?_ (((hN z _ inf_le_right) S (hS' z) _ le_rfl a b).1 hab)
      rintro c d ⟨O, hO, hcd⟩
      exact ⟨O, hO, C.le_mono (inf_le_inf_right _ inf_le_left) hcd⟩
    induction hchain with
    | single hl => exact step _ _ hl
    | tail _ hl ih => exact ih.trans (step _ _ hl)
  · have hchain := hmin'.linkLt_of_family N (fun x _ => ⟨x, hxN x⟩) le_top hxy
    clear hxy
    have step : ∀ a b, Precausality.LinkLt N (fun _ => C.toPrecausality) V a b →
        TransGen (fun a b => ∃ O ∈ S, C.lt (V ⊓ O) a b) a b := by
      rintro a b ⟨z, hab⟩
      refine TransGen.mono ?_ (((hN z _ inf_le_right) S (hS' z) _ le_rfl a b).2 hab)
      rintro c d ⟨O, hO, hcd⟩
      exact ⟨O, hO, C.lt_mono (inf_le_inf_right _ inf_le_left) hcd⟩
    induction hchain with
    | single hl => exact step _ _ hl
    | tail _ hl ih => exact ih.trans (step _ _ hl)

omit [HasGroupoid M (gxGroupoid G X)] in
/-- **The maximal atlas (DEC-16).** An absolutely minimal causality for which every chart of the
atlas is an isomorphism makes every chart of the maximal atlas an isomorphism: a compatible
chart agrees near each point with an atlas chart up to an element of `G`, and the transport
argument applies. -/
theorem chartIso_of_mem_maximalAtlas {D : Causality X} (hD : D.CausallyArcConnected)
    (hG : ∀ g : G, StrongMorphism D D fun p => g • p) {C : Causality M}
    (hC : ∀ e ∈ atlas X M, ChartIso C D e) (hmin : C.AbsolutelyMinimal)
    {e : OpenPartialHomeomorph M X} (he : e ∈ (gxGroupoid G X).maximalAtlas M) :
    ChartIso C D e := by
  have hCe := D.chartTransport_chartIso e
  -- `C` and the transported causality agree near every point of the source of `e`
  have hloc : ∀ x ∈ chartSource e, ∃ O : Opens M, x ∈ O ∧ AgreeOn C (D.chartTransport e) O := by
    intro x hx
    obtain ⟨g, O, hxO, hO, heq⟩ := exists_smul_eq_of_mem_gxGroupoid
      (he (chartAt X x) (chart_mem_atlas X x)).2 (mem_chart_source X x) hx
    exact ⟨O, hxO, (hC _ (chart_mem_atlas X x)).agreeOn_of_smul hG hCe hO heq⟩
  -- both are absolutely minimal on the source of `e`
  have hAC : C.AbsolutelyMinimalOn (chartSource e) :=
    absolutelyMinimalOn_of_locally hmin (fun x => ⟨chartSource (chartAt X x),
      mem_chart_source X x, fun W hW => (hC _ (chart_mem_atlas X x)).absolutelyMinimalOn hW
        (hD.absolutelyMinimalOn_all _)⟩) _
  have hACe : (D.chartTransport e).AbsolutelyMinimalOn (chartSource e) :=
    hCe.absolutelyMinimalOn le_rfl (hD.absolutelyMinimalOn_all _)
  refine hCe.congr fun V hV x y => ?_
  have h₁ := imp_of_agree_locally hAC hloc hV (x := x) (y := y)
  have h₂ := imp_of_agree_locally hACe (fun z hz => by
    obtain ⟨O, hzO, hO⟩ := hloc z hz
    exact ⟨O, hzO, hO.symm⟩) hV (x := x) (y := y)
  exact ⟨⟨h₁.1, h₂.1⟩, ⟨h₁.2, h₂.2⟩⟩

/-- `prop:GX_espace_temps_topo` over the **maximal atlas** (DEC-16): `M` carries an absolutely
minimal causality for which every chart of the maximal `(G,X)`-atlas is an isomorphism, and it is
the only absolutely minimal one. -/
theorem existsUnique_causality_GX_maximal (D : Causality X) (hD : D.CausallyArcConnected)
    (hG : ∀ g : G, StrongMorphism D D fun p => g • p) :
    ∃ C : Causality M, (∀ e ∈ (gxGroupoid G X).maximalAtlas M, ChartIso C D e) ∧
      C.AbsolutelyMinimal ∧
      ∀ C' : Causality M, (∀ e ∈ (gxGroupoid G X).maximalAtlas M, ChartIso C' D e) →
        C'.AbsolutelyMinimal → C' = C := by
  obtain ⟨C, hC, hmin, huniq⟩ := existsUnique_causality_GX (M := M) D hD hG
  exact ⟨C, fun e he => chartIso_of_mem_maximalAtlas hD hG hC hmin he, hmin,
    fun C' hC' hmin' => huniq C' (fun e he =>
      hC' e ((gxGroupoid G X).subset_maximalAtlas he)) hmin'⟩

omit [ChartedSpace X M] [HasGroupoid M (gxGroupoid G X)] in
/-- Uniqueness **outright**, without minimality, when one chart covers `M`: a chart whose source
is all of `M` determines the causality. -/
theorem eq_of_chartIso_of_source_eq_univ {C C' : Causality M} {D : Causality X}
    {e : OpenPartialHomeomorph M X} (h : ChartIso C D e) (h' : ChartIso C' D e)
    (hs : e.source = univ) : C = C' := by
  have hV : ∀ V : Opens M, V ≤ chartSource e := fun V p _ => by
    show p ∈ e.source; rw [hs]; trivial
  apply Causality.ext_toPrecausality
  ext V x y
  · exact (h.agree h' (hV V) x y).1
  · exact (h.agree h' (hV V) x y).2

/-- `prop:GX_espace_temps_topo` with the paper's uniqueness, when some chart of the maximal
atlas covers `M`: the causality is then unique among all causalities making every chart of the
maximal atlas an isomorphism. -/
theorem existsUnique_causality_GX_of_covering_chart (D : Causality X)
    (hD : D.CausallyArcConnected) (hG : ∀ g : G, StrongMorphism D D fun p => g • p)
    (hcov : ∃ e ∈ (gxGroupoid G X).maximalAtlas M, e.source = univ) :
    ∃ C : Causality M, (∀ e ∈ (gxGroupoid G X).maximalAtlas M, ChartIso C D e) ∧
      C.AbsolutelyMinimal ∧
      ∀ C' : Causality M, (∀ e ∈ (gxGroupoid G X).maximalAtlas M, ChartIso C' D e) → C' = C := by
  obtain ⟨C, hC, hmin, -⟩ := existsUnique_causality_GX_maximal (M := M) D hD hG
  obtain ⟨e, he, hs⟩ := hcov
  exact ⟨C, hC, hmin, fun C' hC' => eq_of_chartIso_of_source_eq_univ (hC' e he) (hC e he) hs⟩

end GX

/-! ### The definition is inhabited -/

section Instances

/-- The identity chart is an isomorphism of a causality onto itself. -/
theorem chartIso_refl (D : Causality X) : ChartIso D D (OpenPartialHomeomorph.refl X) := by
  intro U _ x _ y _
  have : chartImage (OpenPartialHomeomorph.refl X) U = U := by
    apply SetLike.coe_injective
    simp [chartImage]
  rw [this]
  exact ⟨Iff.rfl, Iff.rfl⟩

/-- The identity chart forces the causality: if it is an isomorphism for `C`, then `C = D`. -/
theorem eq_of_chartIso_refl {C D : Causality X} (h : ChartIso C D (OpenPartialHomeomorph.refl X)) :
    C = D := by
  have h' : ChartIso D D (OpenPartialHomeomorph.refl X) := chartIso_refl D
  apply Causality.ext_toPrecausality
  ext V x y
  · exact (h.agree h' (fun _ _ => trivial) x y).1
  · exact (h.agree h' (fun _ _ => trivial) x y).2

variable {G : Type w} [Group G] [MulAction G X] [ContinuousConstSMul G X]

/-- **Sanity instance.** `X` itself, with its one-chart atlas, is a `(G,X)`-manifold, and the
causality `prop:GX_espace_temps_topo` produces on it is the causality of `X`. -/
theorem causality_GX_self (D : Causality X) (hD : D.CausallyArcConnected)
    (hG : ∀ g : G, StrongMorphism D D fun p => g • p) :
    (∀ e ∈ atlas X X, ChartIso D D e) ∧ D.AbsolutelyMinimal ∧
      ∀ C : Causality X, (∀ e ∈ atlas X X, ChartIso C D e) → C.AbsolutelyMinimal → C = D := by
  have hatlas : ∀ e ∈ atlas X X, ChartIso D D e := fun e he => by
    rw [chartedSpaceSelf_atlas.1 he]; exact chartIso_refl D
  obtain ⟨C₀, -, -, huniq⟩ := existsUnique_causality_GX (M := X) (G := G) D hD hG
  have hD₀ : D = C₀ := huniq D hatlas hD.absolutelyMinimal
  refine ⟨hatlas, hD.absolutelyMinimal, fun C hC hmin => ?_⟩
  rw [hD₀]
  exact huniq C hC hmin

/-- On the timelike line, every translation is a strong morphism. -/
theorem timelikeLine_strongMorphism_add (t : ℝ) :
    StrongMorphism timelikeLine timelikeLine fun p => t + p where
  continuous := continuous_const.add continuous_id
  isOpenMap := (Homeomorph.addLeft t).isOpenMap
  map_le U V hV x y h := by
    refine ⟨by linarith [h.1], fun z hz => ?_⟩
    have hz' : z - t ∈ (V : Set ℝ) := h.2 ⟨by linarith [hz.1], by linarith [hz.2]⟩
    rw [hV] at hz'
    simpa using hz'
  map_lt U V hV x y h := by
    refine ⟨by linarith [h.1], fun z hz => ?_⟩
    have hz' : z - t ∈ (V : Set ℝ) := h.2 ⟨by linarith [hz.1], by linarith [hz.2]⟩
    rw [hV] at hz'
    simpa using hz'

/-- The translations of `ℝ`, as a multiplicative group acting on `ℝ`, act continuously. -/
local instance continuousConstSMul_multiplicative_real : ContinuousConstSMul (Multiplicative ℝ) ℝ :=
  ⟨fun _ => continuous_const.add continuous_id⟩

/-- The translations act on the timelike line by strong morphisms. -/
theorem timelikeLine_strongMorphism_translation (g : Multiplicative ℝ) :
    StrongMorphism timelikeLine timelikeLine fun p : ℝ => g • p :=
  timelikeLine_strongMorphism_add (Multiplicative.toAdd g)

/-- The chart of `ℝ` which is the identity on `]x - 1, x + 1[`. -/
def intervalChart (x : ℝ) : OpenPartialHomeomorph ℝ ℝ :=
  (OpenPartialHomeomorph.refl ℝ).restrOpen (Ioo (x - 1) (x + 1)) isOpen_Ioo

theorem intervalChart_source (x : ℝ) : (intervalChart x).source = Ioo (x - 1) (x + 1) := by
  simp [intervalChart]

/-- `ℝ` with the atlas of the intervals `]x - 1, x + 1[`, each charted by the identity: no chart
covers `ℝ`. -/
@[reducible] def intervalAtlas : ChartedSpace ℝ ℝ where
  atlas := range intervalChart
  chartAt := intervalChart
  mem_chart_source x := by
    rw [intervalChart_source]; exact ⟨by linarith, by linarith⟩
  chart_mem_atlas x := mem_range_self x

/-- The interval atlas is a `(G,X)`-structure for the translations: its transition maps are
identities. -/
theorem intervalAtlas_hasGroupoid :
    @HasGroupoid ℝ _ ℝ _ intervalAtlas (gxGroupoid (Multiplicative ℝ) ℝ) := by
  refine @HasGroupoid.mk ℝ _ ℝ _ intervalAtlas _ ?_
  rintro e e' ⟨x, rfl⟩ ⟨x', rfl⟩
  have hid : ∀ y, ((intervalChart x).symm.trans (intervalChart x')) y = (1 : Multiplicative ℝ) • y :=
    fun y => by simp [intervalChart]
  have hid' : ∀ y, ((intervalChart x).symm.trans (intervalChart x')).symm y =
      (1 : Multiplicative ℝ) • y := fun y => by simp [intervalChart]
  refine mem_groupoid_of_pregroupoid.2 ⟨fun y _ => ⟨1, Eventually.of_forall hid⟩,
    fun y _ => ⟨1, Eventually.of_forall hid'⟩⟩

/-- The interval charts are isomorphisms for any causality of `ℝ` which agrees with the timelike
line on the open sets other than `ℝ`. -/
theorem chartIso_intervalChart {C : Causality ℝ}
    (hC : ∀ U : Opens ℝ, U ≠ ⊤ → ∀ a b, (C.le U a b ↔ timelikeLine.le U a b) ∧
      (C.lt U a b ↔ timelikeLine.lt U a b)) (x : ℝ) :
    ChartIso C timelikeLine (intervalChart x) := by
  intro U hU a _ b _
  have himg : chartImage (intervalChart x) U = U := by
    apply SetLike.coe_injective
    rw [coe_chartImage_of_le hU]
    simp [intervalChart]
  have hne : U ≠ ⊤ := by
    rintro rfl
    have : x + 1 ∈ (intervalChart x).source := hU (show x + 1 ∈ (⊤ : Opens ℝ) from trivial)
    rw [intervalChart_source] at this
    exact lt_irrefl _ this.2
  rw [himg]
  simpa [intervalChart] using hC U hne a b

/-- Uniqueness fails over a **non-maximal** atlas (SCOPE (d)): on `ℝ` with the interval atlas, a
`(G,X)`-manifold for the translations of the causally arc-connected timelike line, the two
distinct causalities `timelikeLine` and `timelikeLineTop` both make every chart of that atlas an
isomorphism. The maximal atlas contains the identity of `ℝ`, which forces `timelikeLine`
(`eq_of_chartIso_refl`), so this witness does not refute DEC-16's reading; `GX_maximal_not_unique`
does. `timelikeLineTop` is a causality only because `Causality` has no gluing (kb/0014). -/
theorem GX_not_unique_without_minimality :
    @HasGroupoid ℝ _ ℝ _ intervalAtlas (gxGroupoid (Multiplicative ℝ) ℝ) ∧
      timelikeLine.CausallyArcConnected ∧
      (∀ g : Multiplicative ℝ, StrongMorphism timelikeLine timelikeLine fun p : ℝ => g • p) ∧
      (∀ e ∈ @atlas ℝ _ ℝ _ intervalAtlas,
        ChartIso timelikeLine timelikeLine e ∧ ChartIso timelikeLineTop timelikeLine e) ∧
      timelikeLineTop ≠ timelikeLine ∧ ¬ timelikeLineTop.AbsolutelyMinimal := by
  refine ⟨intervalAtlas_hasGroupoid, timelikeLine_causallyArcConnected,
    timelikeLine_strongMorphism_translation, ?_, localIsomorphism_not_unique.2.2,
    timelikeLineTop_not_absolutelyMinimal⟩
  rintro e ⟨x, rfl⟩
  refine ⟨chartIso_intervalChart (fun _ _ _ _ => ⟨Iff.rfl, Iff.rfl⟩) x,
    chartIso_intervalChart (C := timelikeLineTop) (fun U hU a b =>
      ⟨⟨fun h => (show U = ⊤ ∨ timelikeLine.le U a b from h).resolve_left hU, Or.inr⟩,
        Iff.rfl⟩) x⟩

end Instances

/-! ### Uniqueness over the maximal atlas: a counterexample on two lines -/

section TwoLines

attribute [local instance] continuousConstSMul_multiplicative_real

/-- The causality `C` with the causal relation of `M` itself enlarged to all pairs. It is a
causality because the library, like the paper's "equivalently" form, has no gluing axiom
(kb/0014); `timelikeLineTop` is the case of the timelike line. -/
def Causality.topEnlarge (C : Causality M) : Causality M where
  le U x y := U = ⊤ ∨ C.le U x y
  lt := C.lt
  le_mem_left := by
    rintro U x y (rfl | h)
    · trivial
    · exact C.le_mem_left h
  le_mem_right := by
    rintro U x y (rfl | h)
    · trivial
    · exact C.le_mem_right h
  lt_mem_left h := C.lt_mem_left h
  lt_mem_right h := C.lt_mem_right h
  le_refl hx := Or.inr (C.le_refl hx)
  le_trans := by
    rintro U x y z (rfl | h₁) h₂
    · exact Or.inl rfl
    · rcases h₂ with rfl | h₂
      · exact Or.inl rfl
      · exact Or.inr (C.le_trans h₁ h₂)
  lt_trans h₁ h₂ := C.lt_trans h₁ h₂
  le_mono := by
    rintro U V hVU x y (rfl | h)
    · exact Or.inl (top_le_iff.1 hVU)
    · exact Or.inr (C.le_mono hVU h)
  lt_mono hVU _ _ h := C.lt_mono hVU h
  le_of_lt h := Or.inr (C.le_of_lt h)
  isOpen_lt_right := C.isOpen_lt_right
  isOpen_lt_left := C.isOpen_lt_left

theorem Causality.topEnlarge_agree (C : Causality M) {U : Opens M} (hU : U ≠ ⊤) (x y : M) :
    (C.topEnlarge.le U x y ↔ C.le U x y) ∧ (C.topEnlarge.lt U x y ↔ C.lt U x y) :=
  ⟨⟨fun h => (show U = ⊤ ∨ C.le U x y from h).resolve_left hU, Or.inr⟩, Iff.rfl⟩

/-- An open partial homeomorphism which is the identity on its source and target lies in every
`(G,X)`-groupoid. -/
theorem mem_gxGroupoid_of_eq_id {G : Type w} [Group G] [MulAction G X] [ContinuousConstSMul G X]
    {f : OpenPartialHomeomorph X X} (h₁ : ∀ z ∈ f.source, f z = z)
    (h₂ : ∀ z ∈ f.target, f.symm z = z) : f ∈ gxGroupoid G X :=
  mem_groupoid_of_pregroupoid.2
    ⟨fun y hy => ⟨1, by
      filter_upwards [f.open_source.mem_nhds hy] with z hz
      rw [h₁ z hz, one_smul]⟩,
    fun y hy => ⟨1, by
      filter_upwards [f.open_target.mem_nhds hy] with z hz
      rw [h₂ z hz, one_smul]⟩⟩

/-- The chart of the left copy of `ℝ` in `ℝ ⊕ ℝ`. -/
noncomputable def lineL : OpenPartialHomeomorph (ℝ ⊕ ℝ) ℝ :=
  (OpenPartialHomeomorph.refl ℝ).lift_openEmbedding IsOpenEmbedding.inl

/-- The chart of the right copy of `ℝ` in `ℝ ⊕ ℝ`. -/
noncomputable def lineR : OpenPartialHomeomorph (ℝ ⊕ ℝ) ℝ :=
  (OpenPartialHomeomorph.refl ℝ).lift_openEmbedding IsOpenEmbedding.inr

@[simp] theorem lineL_inl (y : ℝ) : lineL (Sum.inl y) = y :=
  (OpenPartialHomeomorph.refl ℝ).lift_openEmbedding_apply IsOpenEmbedding.inl

@[simp] theorem lineR_inr (y : ℝ) : lineR (Sum.inr y) = y :=
  (OpenPartialHomeomorph.refl ℝ).lift_openEmbedding_apply IsOpenEmbedding.inr

@[simp] theorem lineL_symm (y : ℝ) : lineL.symm y = Sum.inl y := rfl

@[simp] theorem lineR_symm (y : ℝ) : lineR.symm y = Sum.inr y := rfl

theorem lineL_source : lineL.source = range Sum.inl := by
  rw [lineL, OpenPartialHomeomorph.lift_openEmbedding_source]; simp

theorem lineR_source : lineR.source = range Sum.inr := by
  rw [lineR, OpenPartialHomeomorph.lift_openEmbedding_source]; simp

theorem lineL_target : lineL.target = univ := by
  rw [lineL, OpenPartialHomeomorph.lift_openEmbedding_target]; rfl

theorem lineR_target : lineR.target = univ := by
  rw [lineR, OpenPartialHomeomorph.lift_openEmbedding_target]; rfl

/-- `ℝ ⊔ ℝ`, charted by its two copies of `ℝ`. -/
@[reducible] noncomputable def twoLinesAtlas : ChartedSpace ℝ (ℝ ⊕ ℝ) where
  atlas := {lineL, lineR}
  chartAt := Sum.elim (fun _ => lineL) fun _ => lineR
  mem_chart_source := by
    rintro (y | y)
    · show Sum.inl y ∈ lineL.source; rw [lineL_source]; exact mem_range_self y
    · show Sum.inr y ∈ lineR.source; rw [lineR_source]; exact mem_range_self y
  chart_mem_atlas := by
    rintro (y | y)
    · exact Or.inl rfl
    · exact Or.inr rfl

theorem twoLinesAtlas_hasGroupoid :
    @HasGroupoid ℝ _ (ℝ ⊕ ℝ) _ twoLinesAtlas (gxGroupoid (Multiplicative ℝ) ℝ) := by
  refine @HasGroupoid.mk ℝ _ (ℝ ⊕ ℝ) _ twoLinesAtlas _ ?_
  rintro e e' (rfl | rfl) (rfl | rfl) <;> refine mem_gxGroupoid_of_eq_id ?_ ?_ <;>
    intro z hz <;>
    simp only [OpenPartialHomeomorph.trans_source, OpenPartialHomeomorph.trans_target,
      OpenPartialHomeomorph.symm_source, OpenPartialHomeomorph.symm_target, mem_inter_iff,
      mem_preimage, lineL_source, lineR_source, lineL_symm, lineR_symm, mem_range,
      Sum.inl.injEq, Sum.inr.injEq, reduceCtorEq, exists_false, and_false] at hz ⊢ <;>
    simp

/-- On `ℝ ⊔ ℝ`, no chart of the maximal `(G,X)`-atlas for the translations covers the space:
along each copy a compatible chart is one translation, onto `ℝ`, so it cannot be injective on
both copies. -/
theorem twoLines_source_ne_univ {e : OpenPartialHomeomorph (ℝ ⊕ ℝ) ℝ}
    (he : e ∈ @StructureGroupoid.maximalAtlas ℝ (ℝ ⊕ ℝ) _ _ twoLinesAtlas
      (gxGroupoid (Multiplicative ℝ) ℝ)) : e.source ≠ univ := by
  intro hs
  -- along a copy `ι`, `e ∘ ι` minus the identity is locally constant, hence constant
  have key : ∀ (c : OpenPartialHomeomorph (ℝ ⊕ ℝ) ℝ) (ι : ℝ → ℝ ⊕ ℝ), c.target = univ →
      (∀ y, c.symm y = ι y) → c.symm.trans e ∈ gxGroupoid (Multiplicative ℝ) ℝ →
      ∀ z, e (ι z) = z + (e (ι 0) - 0) := by
    intro c ι hct hcs hc z
    have hlc : IsLocallyConstant fun y => e (ι y) - y := by
      rw [IsLocallyConstant.iff_eventually_eq]
      intro y
      have hy : y ∈ (c.symm.trans e).source := by
        rw [OpenPartialHomeomorph.trans_source, OpenPartialHomeomorph.symm_source, hct, hs]
        exact ⟨trivial, trivial⟩
      obtain ⟨g, hg⟩ := (mem_groupoid_of_pregroupoid.1 hc).1 y hy
      have hg' : ∀ᶠ w in 𝓝 y, e (ι w) = Multiplicative.toAdd g + w := by
        filter_upwards [hg] with w hw
        have hw' : e (ι w) = g • w := by simpa [OpenPartialHomeomorph.coe_trans, hcs] using hw
        exact hw'
      have hgy : e (ι y) = Multiplicative.toAdd g + y := hg'.self_of_nhds
      filter_upwards [hg'] with w hw
      rw [hw, hgy]; ring
    have := hlc.apply_eq_of_preconnectedSpace z 0
    linarith
  have hL := key lineL Sum.inl lineL_target lineL_symm (he lineL (Or.inl rfl)).2
  have hR := key lineR Sum.inr lineR_target lineR_symm (he lineR (Or.inr rfl)).2
  have heq : e (Sum.inl 0) = e (Sum.inr (e (Sum.inl 0) - e (Sum.inr 0))) := by
    rw [hR]; simp
  have := e.injOn (by rw [hs]; trivial) (by rw [hs]; trivial) heq
  exact Sum.inl_ne_inr this

/-- For a causality making the two charts of `ℝ ⊔ ℝ` isomorphisms onto the timelike line, absolute
minimality forbids `1 ≤ 0` on a copy. -/
theorem twoLines_not_le {C : Causality (ℝ ⊕ ℝ)}
    (hC : ∀ e ∈ @atlas ℝ _ (ℝ ⊕ ℝ) _ twoLinesAtlas, ChartIso C timelikeLine e)
    (hmin : C.AbsolutelyMinimal) : ¬ C.le ⊤ (Sum.inl 1) (Sum.inl 0) := by
  intro h
  let T : ℝ ⊕ ℝ → ℝ := Sum.elim id id
  let E : Bool → OpenPartialHomeomorph (ℝ ⊕ ℝ) ℝ := fun b => cond b lineL lineR
  have hE : ∀ b, ∀ a ∈ (E b).source, E b a = T a := by
    rintro (_ | _) a ha
    · simp only [E, cond_false, lineR_source] at ha ⊢; obtain ⟨a, rfl⟩ := ha; simp [T]
    · simp only [E, cond_true, lineL_source] at ha ⊢; obtain ⟨a, rfl⟩ := ha; simp [T]
  have hEC : ∀ b, ChartIso C timelikeLine (E b) := by
    rintro (_ | _)
    · exact hC lineR (Or.inr rfl)
    · exact hC lineL (Or.inl rfl)
  have hcov : ∀ x ∈ (⊤ : Opens (ℝ ⊕ ℝ)), ∃ b, x ∈ chartSource (E b) := by
    rintro (y | y) -
    · exact ⟨true, show Sum.inl y ∈ lineL.source by rw [lineL_source]; exact mem_range_self y⟩
    · exact ⟨false, show Sum.inr y ∈ lineR.source by rw [lineR_source]; exact mem_range_self y⟩
  have hchain := (Precausality.absolutelyMinimal_iff.1 hmin).linkLe_of_family
    (fun b => chartSource (E b)) hcov le_top h
  clear h
  have step : ∀ a c, Precausality.LinkLe (fun b => chartSource (E b))
      (fun _ => C.toPrecausality) ⊤ a c → T a ≤ T c := by
    rintro a c ⟨b, hac⟩
    have ha := C.le_mem_left hac
    have hc := C.le_mem_right hac
    have := (((hEC b) _ inf_le_right a ha c hc).1).1 hac
    have hsub : (⊤ : Opens (ℝ ⊕ ℝ)) ⊓ chartSource (E b) ≤ chartSource (E b) := inf_le_right
    rw [hE b a (hsub ha), hE b c (hsub hc)] at this
    exact this.1
  have : ∀ a c, TransGen (Precausality.LinkLe (fun b => chartSource (E b))
      (fun _ => C.toPrecausality) ⊤) a c → T a ≤ T c := by
    intro a c hac
    induction hac with
    | single hl => exact step _ _ hl
    | tail _ hl ih => exact ih.trans (step _ _ hl)
  have h10 : (1 : ℝ) ≤ 0 := this _ _ hchain
  norm_num at h10

/-- **Uniqueness fails over the maximal atlas too, without minimality** (SCOPE (d)). `ℝ ⊔ ℝ`, a
`(G,X)`-manifold for the translations of the causally arc-connected timelike line, carries two
distinct causalities making every chart of its MAXIMAL atlas an isomorphism: the absolutely
minimal one, and the same with `≤_M` enlarged to all pairs. No chart of the maximal atlas covers
`ℝ ⊔ ℝ`, which is what lets `≤_M` vary (compare `existsUnique_causality_GX_of_covering_chart`).
The second is not absolutely minimal; it is a causality because the library has no gluing. -/
theorem GX_maximal_not_unique :
    @HasGroupoid ℝ _ (ℝ ⊕ ℝ) _ twoLinesAtlas (gxGroupoid (Multiplicative ℝ) ℝ) ∧
      (∀ e ∈ @StructureGroupoid.maximalAtlas ℝ (ℝ ⊕ ℝ) _ _ twoLinesAtlas
        (gxGroupoid (Multiplicative ℝ) ℝ), e.source ≠ univ) ∧
      ∃ C C' : Causality (ℝ ⊕ ℝ), C ≠ C' ∧ C.AbsolutelyMinimal ∧ ¬ C'.AbsolutelyMinimal ∧
        ∀ e ∈ @StructureGroupoid.maximalAtlas ℝ (ℝ ⊕ ℝ) _ _ twoLinesAtlas
          (gxGroupoid (Multiplicative ℝ) ℝ),
          ChartIso C timelikeLine e ∧ ChartIso C' timelikeLine e := by
  letI := twoLinesAtlas
  haveI := twoLinesAtlas_hasGroupoid
  obtain ⟨C, hC, hmin, huniq⟩ := existsUnique_causality_GX_maximal (M := ℝ ⊕ ℝ)
    (G := Multiplicative ℝ) timelikeLine timelikeLine_causallyArcConnected
    timelikeLine_strongMorphism_translation
  have hC' : ∀ e ∈ (gxGroupoid (Multiplicative ℝ) ℝ).maximalAtlas (ℝ ⊕ ℝ),
      ChartIso C.topEnlarge timelikeLine e := by
    intro e he
    refine (hC e he).congr fun V hV x y => C.topEnlarge_agree ?_ x y
    rintro rfl
    exact twoLines_source_ne_univ he (eq_univ_of_forall fun p => hV (show p ∈ (⊤ : Opens _) from trivial))
  have hne : C ≠ C.topEnlarge := by
    intro h
    have h1 : C.topEnlarge.le ⊤ (Sum.inl 1) (Sum.inl 0) := Or.inl rfl
    rw [← h] at h1
    exact twoLines_not_le (fun e he => hC e ((gxGroupoid _ ℝ).subset_maximalAtlas he)) hmin h1
  refine ⟨twoLinesAtlas_hasGroupoid, fun e he => twoLines_source_ne_univ he, C, C.topEnlarge, hne,
    hmin, fun hmin' => hne (huniq _ hC' hmin').symm, fun e he => ⟨hC e he, hC' e he⟩⟩

end TwoLines

/-! ### `ChartIso` is an isomorphism of topological spacetimes (DEC-10) -/

section Bridge

variable {C : Causality M} {D : Causality X} {e : OpenPartialHomeomorph M X}

/-- The target of a chart, as an open set. -/
def chartTarget (e : OpenPartialHomeomorph M X) : Opens X := ⟨e.target, e.open_target⟩

/-- A chart, as a homeomorphism of its source onto its target (subspaces). -/
def chartHomeomorph (e : OpenPartialHomeomorph M X) : chartSource e ≃ₜ chartTarget e where
  toFun z := ⟨e z, e.map_source z.2⟩
  invFun p := ⟨e.symm p, e.map_target p.2⟩
  left_inv z := Subtype.ext (e.left_inv z.2)
  right_inv p := Subtype.ext (e.right_inv p.2)
  continuous_toFun :=
    (e.continuousOn.comp_continuous continuous_subtype_val fun z => z.2).subtype_mk _
  continuous_invFun :=
    (e.continuousOn_symm.comp_continuous continuous_subtype_val fun p => p.2).subtype_mk _

@[simp] theorem chartHomeomorph_apply (z : chartSource e) :
    ((chartHomeomorph e z : chartTarget e) : X) = e z := rfl

@[simp] theorem chartHomeomorph_symm_apply (p : chartTarget e) :
    (((chartHomeomorph e).symm p : chartSource e) : M) = e.symm p := rfl

/-- The image by the chart of an open set of its source is the corresponding open set of its
target. -/
theorem chartImage_imageOpens {U' : Opens (chartSource e)} {V' : Opens (chartTarget e)}
    (h : (U' : Set (chartSource e)) = chartHomeomorph e ⁻¹' (V' : Set (chartTarget e))) :
    chartImage e (imageOpens U') = imageOpens V' := by
  apply SetLike.coe_injective
  ext p
  constructor
  · rintro ⟨z, ⟨-, ⟨z', hz', rfl⟩⟩, rfl⟩
    rw [h] at hz'
    exact ⟨chartHomeomorph e z', hz', rfl⟩
  · rintro ⟨q, hq, rfl⟩
    refine ⟨e.symm q, ⟨e.map_target q.2, ⟨(chartHomeomorph e).symm q, ?_, rfl⟩⟩,
      e.right_inv q.2⟩
    rw [h]
    simpa using hq

/-- **The reading of "isomorphism of topological spacetimes" (SCOPE (c)) is DEC-10's**: `e` is a
`ChartIso` if and only if, as a homeomorphism of its source onto its target, each with the
restricted causality, it is a strong morphism whose inverse is a strong morphism. -/
theorem chartIso_iff_strongMorphism :
    ChartIso C D e ↔
      StrongMorphism (C.restrict (chartSource e)).toSubtype (D.restrict (chartTarget e)).toSubtype
          (chartHomeomorph e) ∧
        StrongMorphism (D.restrict (chartTarget e)).toSubtype
          (C.restrict (chartSource e)).toSubtype (chartHomeomorph e).symm := by
  constructor
  · intro h
    have hinv : ∀ (U' : Opens (chartSource e)) (V' : Opens (chartTarget e)),
        (V' : Set (chartTarget e)) = (chartHomeomorph e).symm ⁻¹' (U' : Set (chartSource e)) →
        (U' : Set (chartSource e)) = chartHomeomorph e ⁻¹' (V' : Set (chartTarget e)) := by
      intro U' V' hV
      rw [hV, preimage_preimage]
      simp
    refine ⟨⟨(chartHomeomorph e).continuous, (chartHomeomorph e).isOpenMap, ?_, ?_⟩,
      ⟨(chartHomeomorph e).symm.continuous, (chartHomeomorph e).symm.isOpenMap, ?_, ?_⟩⟩
    · intro V' U' hU' a b hab
      have hab' : C.le (imageOpens U') a b := hab
      have := ((h (imageOpens U') (imageOpens_le _) a (C.le_mem_left hab') b
        (C.le_mem_right hab')).1).1 hab'
      rw [chartImage_imageOpens hU'] at this
      exact this
    · intro V' U' hU' a b hab
      have hab' : C.lt (imageOpens U') a b := hab
      have := ((h (imageOpens U') (imageOpens_le _) a (C.lt_mem_left hab') b
        (C.lt_mem_right hab')).2).1 hab'
      rw [chartImage_imageOpens hU'] at this
      exact this
    · intro U' V' hV' p q hpq
      have hpq' : D.le (imageOpens V') p q := hpq
      have hp : ((chartHomeomorph e).symm p : M) ∈ imageOpens U' := by
        have := D.le_mem_left hpq'
        rw [← chartImage_imageOpens (hinv U' V' hV')] at this
        obtain ⟨z, hz, hzU, hzp, -⟩ := exists_of_mem_chartImage this
        rw [chartHomeomorph_symm_apply, ← hzp, e.left_inv hz]; exact hzU
      have hq : ((chartHomeomorph e).symm q : M) ∈ imageOpens U' := by
        have := D.le_mem_right hpq'
        rw [← chartImage_imageOpens (hinv U' V' hV')] at this
        obtain ⟨z, hz, hzU, hzp, -⟩ := exists_of_mem_chartImage this
        rw [chartHomeomorph_symm_apply, ← hzp, e.left_inv hz]; exact hzU
      show C.le (imageOpens U') ((chartHomeomorph e).symm p : M) ((chartHomeomorph e).symm q : M)
      refine ((h (imageOpens U') (imageOpens_le _) _ hp _ hq).1).2 ?_
      rw [chartImage_imageOpens (hinv U' V' hV'), chartHomeomorph_symm_apply,
        chartHomeomorph_symm_apply, e.right_inv p.2, e.right_inv q.2]
      exact hpq'
    · intro U' V' hV' p q hpq
      have hpq' : D.lt (imageOpens V') p q := hpq
      have hp : ((chartHomeomorph e).symm p : M) ∈ imageOpens U' := by
        have := D.lt_mem_left hpq'
        rw [← chartImage_imageOpens (hinv U' V' hV')] at this
        obtain ⟨z, hz, hzU, hzp, -⟩ := exists_of_mem_chartImage this
        rw [chartHomeomorph_symm_apply, ← hzp, e.left_inv hz]; exact hzU
      have hq : ((chartHomeomorph e).symm q : M) ∈ imageOpens U' := by
        have := D.lt_mem_right hpq'
        rw [← chartImage_imageOpens (hinv U' V' hV')] at this
        obtain ⟨z, hz, hzU, hzp, -⟩ := exists_of_mem_chartImage this
        rw [chartHomeomorph_symm_apply, ← hzp, e.left_inv hz]; exact hzU
      show C.lt (imageOpens U') ((chartHomeomorph e).symm p : M) ((chartHomeomorph e).symm q : M)
      refine ((h (imageOpens U') (imageOpens_le _) _ hp _ hq).2).2 ?_
      rw [chartImage_imageOpens (hinv U' V' hV'), chartHomeomorph_symm_apply,
        chartHomeomorph_symm_apply, e.right_inv p.2, e.right_inv q.2]
      exact hpq'
  · rintro ⟨hφ, hψ⟩ U hU x hx y hy
    -- `U` and `e(U)` as open sets of the subspaces
    let U' : Opens (chartSource e) :=
      ⟨Subtype.val ⁻¹' (U : Set M), U.isOpen.preimage continuous_subtype_val⟩
    let V' : Opens (chartTarget e) :=
      ⟨Subtype.val ⁻¹' (chartImage e U : Set X),
        (chartImage e U).isOpen.preimage continuous_subtype_val⟩
    have hUU : imageOpens U' = U := by
      rw [imageOpens_eq_inf (U := U) rfl]; exact inf_eq_left.2 hU
    have hU'V' : (U' : Set (chartSource e)) = chartHomeomorph e ⁻¹' (V' : Set (chartTarget e)) := by
      ext z
      simp only [U', V', Opens.coe_mk, mem_preimage, chartHomeomorph_apply]
      constructor
      · intro hz; exact mem_chartImage_of_mem z.2 hz
      · intro hz
        obtain ⟨w, hw, hwU, hwz, -⟩ := exists_of_mem_chartImage hz
        rwa [← e.injOn hw z.2 hwz]
    have hV'U' : (V' : Set (chartTarget e)) =
        (chartHomeomorph e).symm ⁻¹' (U' : Set (chartSource e)) := by
      rw [hU'V', preimage_preimage]
      simp
    have hVV : imageOpens V' = chartImage e U := by
      rw [← chartImage_imageOpens hU'V', hUU]
    let xs : chartSource e := ⟨x, hU hx⟩
    let ys : chartSource e := ⟨y, hU hy⟩
    have hxs : (chartHomeomorph e).symm (chartHomeomorph e xs) = xs := by simp
    have hys : (chartHomeomorph e).symm (chartHomeomorph e ys) = ys := by simp
    refine ⟨⟨fun h => ?_, fun h => ?_⟩, ⟨fun h => ?_, fun h => ?_⟩⟩
    · have h' : (C.restrict (chartSource e)).toSubtype.le U' xs ys := by
        show C.le (imageOpens U') x y; rw [hUU]; exact h
      have := hφ.map_le V' U' hU'V' h'
      change D.le (imageOpens V') (e x) (e y) at this
      rwa [hVV] at this
    · have h' : (D.restrict (chartTarget e)).toSubtype.le V' (chartHomeomorph e xs)
          (chartHomeomorph e ys) := by
        show D.le (imageOpens V') (e x) (e y); rw [hVV]; exact h
      have := hψ.map_le U' V' hV'U' h'
      rw [hxs, hys] at this
      change C.le (imageOpens U') x y at this
      rwa [hUU] at this
    · have h' : (C.restrict (chartSource e)).toSubtype.lt U' xs ys := by
        show C.lt (imageOpens U') x y; rw [hUU]; exact h
      have := hφ.map_lt V' U' hU'V' h'
      change D.lt (imageOpens V') (e x) (e y) at this
      rwa [hVV] at this
    · have h' : (D.restrict (chartTarget e)).toSubtype.lt V' (chartHomeomorph e xs)
          (chartHomeomorph e ys) := by
        show D.lt (imageOpens V') (e x) (e y); rw [hVV]; exact h
      have := hψ.map_lt U' V' hV'U' h'
      rw [hxs, hys] at this
      change C.lt (imageOpens U') x y at this
      rwa [hUU] at this

end Bridge

end Causal
