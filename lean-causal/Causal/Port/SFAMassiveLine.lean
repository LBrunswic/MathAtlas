namespace Causal

open Set Filter Topology TopologicalSpace Metric

universe u

namespace SFAMassiveLine

open SFALocal MassAModelsInstance LineDevelopment

section Manifold

variable {M : Type u} [TopologicalSpace M] [SingularGXStructure (Flat.isom 2) (Minkowski 2) M]
  {C : Causality M}

section Kappa

attribute [local instance] EAlphaGX.singularGX

variable {κ : ℝ} [Fact (0 < κ)]

variable (C κ) in
/-- The `X_A`-charts into `E_κ` which are chart isomorphisms for `C`: the index set of the
translation atlas of `sing_κ(M)`. -/
def IsoChart : Type u :=
  {e : OpenPartialHomeomorph M (Massive κ) //
    IsAEChart (Flat.isom 2) (Minkowski 2) e ∧ ChartIso C (massive κ) e}

/-- The domain of the chart `i` of the atlas: its source. -/
def lineV (i : IsoChart C κ) : Set M := i.1.source

/-- The chart `i` of the atlas: the time coordinate. -/
noncomputable def lineτ (i : IsoChart C κ) (x : M) : ℝ := (i.1 x).1

/-- The inverse chart `i` of the atlas: the line of `E_κ` read back in `M`. -/
noncomputable def lineσ (i : IsoChart C κ) (r : ℝ) : M := i.1.symm (r, Cone.apex)

/-- The parameter domain of the chart `i`: the times of the line inside the target. -/
def lineJ (i : IsoChart C κ) : Set ℝ := {r | ((r, Cone.apex) : Massive κ) ∈ i.1.target}

/-- **`sing_κ(M)` read in an `X_A`-chart into `E_κ`**, `κ ≠ 2π`: a point of the source is in
`sing_κ(M)` iff the chart sends it to the line. -/
theorem mem_sing_iff_mem_singLine (hκ : κ ≠ 2 * Real.pi)
    {e : OpenPartialHomeomorph M (Massive κ)} (he : IsAEChart (Flat.isom 2) (Minkowski 2) e)
    {x : M} (hx : x ∈ e.source) : x ∈ sing M κ ↔ e x ∈ singLine κ := by
  have hS : Sing (Flat.isom 2) (Minkowski 2) (Massive κ) = singLine κ := EAlphaGX.sing_eq hκ
  constructor
  · intro h
    have hxs : x ∈ Sing (Flat.isom 2) (Minkowski 2) M := sing_subset κ h
    have hes : e x ∈ Sing (Flat.isom 2) (Minkowski 2) (Massive κ) := fun hr =>
      hxs ((he.mem_reg_iff hx).2 hr)
    rw [hS] at hes
    exact hes
  · intro h
    rw [sing_pos_eq hκ]
    exact ⟨e, he, hx, h⟩

/-- At a point of `sing_κ(M)` some isomorphic chart is into `E_κ` (type invariance). -/
theorem exists_isoChart
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality) {p : M}
    (hp : p ∈ sing M κ) : ∃ i : IsoChart C κ, p ∈ i.1.source := by
  rcases hC p with ⟨e, he, hpe, -⟩ | ⟨o, e, hea, hpe, he⟩
  · exact absurd (mem_support.2 ⟨e, he, hpe⟩) (sing_subset κ hp)
  · have ho := (mem_sing_iff_of_mem_source hea hpe (sing_subset κ hp) κ).1 hp
    rcases o with _ | ⟨κ', hκ'⟩
    · exact absurd ho (ne_of_lt (Fact.out : 0 < κ))
    · have hk : κ' = κ := ho
      subst hk
      exact ⟨⟨e, hea, he⟩, hpe⟩

/-- **The translation atlas of `sing_κ(M)`**, `κ > 0`, `κ ≠ 2π`. -/
theorem isTranslationAtlas
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality)
    (hκ : κ ≠ 2 * Real.pi) :
    IsTranslationAtlas (sing M κ) (lineV (C := C) (κ := κ)) lineτ lineσ lineJ := by
  have hpt : ∀ (i : IsoChart C κ) {x : M}, x ∈ sing M κ → x ∈ i.1.source →
      (((i.1 x).1, Cone.apex) : Massive κ) = i.1 x := fun i x hxS hxi =>
    Prod.ext rfl ((mem_sing_iff_mem_singLine hκ i.2.1 hxi).1 hxS).symm
  refine
    { isOpen_V := fun i => i.1.open_source
      isOpen_J := fun i => i.1.open_target.preimage (continuous_id.prodMk continuous_const)
      continuousOn_τ := fun i => ?_
      continuousOn_σ := fun i => ?_
      mapsTo_τ := fun i x hx => ?_
      mapsTo_σ := fun i r hr => ?_
      σ_τ := fun i x hx => ?_
      τ_σ := fun i r hr => ?_
      cover := fun p hp => exists_isoChart hC hp
      trans := fun i j x hx => ?_ }
  · exact (continuous_fst.comp_continuousOn i.1.continuousOn).mono inter_subset_right
  · exact i.1.continuousOn_symm.comp (continuous_id.prodMk continuous_const).continuousOn
      fun r hr => hr
  · show (((i.1 x).1, Cone.apex) : Massive κ) ∈ i.1.target
    rw [hpt i hx.1 hx.2]
    exact i.1.map_source hx.2
  · have hs : i.1.symm (r, Cone.apex) ∈ i.1.source := i.1.map_target hr
    refine ⟨(mem_sing_iff_mem_singLine hκ i.2.1 hs).2 ?_, hs⟩
    rw [i.1.right_inv hr]
    rfl
  · show i.1.symm ((i.1 x).1, Cone.apex) = x
    rw [hpt i hx.1 hx.2, i.1.left_inv hx.2]
  · show (i.1 (i.1.symm (r, Cone.apex))).1 = r
    rw [i.1.right_inv hr]
  · obtain ⟨⟨hxS, hxi⟩, hxj⟩ := hx
    have hψ : IsAEChart (Flat.isom 2) (Minkowski 2) (i.1.symm.trans j.1) := i.2.1.symm.trans j.2.1
    have hmem : i.1 x ∈ (i.1.symm.trans j.1).source := by
      rw [OpenPartialHomeomorph.trans_source]
      refine ⟨i.1.map_source hxi, ?_⟩
      show i.1.symm (i.1 x) ∈ j.1.source
      rw [i.1.left_inv hxi]
      exact hxj
    have hline := (mem_sing_iff_mem_singLine hκ i.2.1 hxi).1 hxS
    obtain ⟨-, ε, hε, -, s, c, hform⟩ := BPrimeEAlpha.prop_isom_local hκ hψ hmem hline
    refine ⟨s, ?_⟩
    have hev1 : ∀ᶠ y in 𝓝 x, y ∈ i.1.source := i.1.open_source.mem_nhds hxi
    have hev2 : ∀ᶠ y in 𝓝 x, i.1 y ∈ ball (i.1 x) ε :=
      (i.1.continuousAt hxi).preimage_mem_nhds (ball_mem_nhds _ hε)
    have hev := hev1.and hev2
    filter_upwards [hev] with y hy _
    obtain ⟨r, θ, hr, hyr⟩ := BPrimeEAlpha.exists_polar (i.1 y).2
    have h1 := hform (i.1 y) hy.2 r θ hr hyr
    have h2 : (i.1.symm.trans j.1) (i.1 y) = j.1 y := by
      show j.1 (i.1.symm (i.1 y)) = j.1 y
      rw [i.1.left_inv hy.1]
    rw [h2] at h1
    show (j.1 y).1 = (i.1 y).1 + s
    rw [h1]

/-- **The inverse charts are chronal curves** over every segment of their domain. -/
theorem chronalCurveOn_lineσ (i : IsoChart C κ) {a b : ℝ} (h : Icc a b ⊆ lineJ i) :
    C.ChronalCurveOn ⊤ (lineσ i) a b := by
  have hc : (massive κ).ChronalCurveOn (chartImage i.1 (chartSource i.1))
      (fun τ => ((τ, Cone.apex) : Massive κ)) a b := by
    refine singLine_chronalCurveOn fun τ hτ => ?_
    have hτ' : ((τ, Cone.apex) : Massive κ) ∈ i.1.target := h hτ
    exact ⟨i.1.symm _, ⟨i.1.map_target hτ', i.1.map_target hτ'⟩, i.1.right_inv hτ'⟩
  have h1 := ChartIso.curveOn_symm (rC := C.lt)
    (fun N hN x hx y hy => (i.2.2 N hN x hx y hy).2) (massive κ).isRelFamily_lt
    (le_refl (chartSource i.1)) hc
  exact CurveOn.mono_opens C.isRelFamily_lt h1 le_top

/-- **`massive_line` at `κ`**, `κ > 0`, `κ ≠ 2π`. -/
theorem massive_line_of_ne [T2Space M]
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality)
    (hκ : κ ≠ 2 * Real.pi) {p : M} (hp : p ∈ sing M κ) :
    ∃ γ : ℝ → M, γ 0 = p ∧ (C.IsCausal → IsClosedEmbedding γ) ∧
      C.Inextensible ⊤ univ γ ∧ (∀ a b, C.ChronalCurveOn ⊤ γ a b) ∧
      range γ = connectedComponentIn (sing M κ) p :=
  exists_chronal_line
    (SFALocal.isClosed_sing (massACovered_of_isoChartsCover hC) κ (le_of_lt Fact.out))
    (isTranslationAtlas hC hκ) (fun i _ _ h => chronalCurveOn_lineσ i h) hp

/-- **`defi:causal_Ealpha`'s « for `α > 0` the singular line is timelike, hence locally chronal »,
read in `M`** (unmarked): through each point `p` of `sing_κ(M)`, in every open set `W` containing
it, a chronal curve of `W` inside `sing_κ(M)`, whose points are chronologically related in `W`. -/
theorem sing_locallyChronal
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality)
    (hκ : κ ≠ 2 * Real.pi) {p : M} (hp : p ∈ sing M κ) (W : Opens M) (hpW : p ∈ W) :
    ∃ γ : ℝ → M, ∃ t₀ : ℝ, ∃ ε > 0, γ t₀ = p ∧ C.ChronalCurveOn W γ (t₀ - ε) (t₀ + ε) ∧
      (∀ s ∈ Icc (t₀ - ε) (t₀ + ε), γ s ∈ sing M κ) ∧
      ∀ s ∈ Icc (t₀ - ε) (t₀ + ε), ∀ s' ∈ Icc (t₀ - ε) (t₀ + ε), s < s' → C.lt W (γ s) (γ s') := by
  obtain ⟨i, hpi⟩ := exists_isoChart hC hp
  have hl := (mem_sing_iff_mem_singLine hκ i.2.1 hpi).1 hp
  have hpt : (((i.1 p).1, Cone.apex) : Massive κ) = i.1 p := Prod.ext rfl hl.symm
  let U : Opens M := W ⊓ chartSource i.1
  have hpU : p ∈ U := ⟨hpW, hpi⟩
  have hU : U ≤ chartSource i.1 := inf_le_right
  have hep : (((i.1 p).1, Cone.apex) : Massive κ) ∈ chartImage i.1 U := by
    rw [hpt]
    exact mem_chartImage_of_mem hpi hpU
  obtain ⟨ε, hε, hcurve, hlt⟩ := singLine_locallyChronal hep
  refine ⟨lineσ i, (i.1 p).1, ε, hε, ?_, ?_, ?_, ?_⟩
  · show i.1.symm ((i.1 p).1, Cone.apex) = p
    rw [hpt, i.1.left_inv hpi]
  · exact CurveOn.mono_opens C.isRelFamily_lt (ChartIso.curveOn_symm (rC := C.lt)
      (fun N hN x hx y hy => (i.2.2 N hN x hx y hy).2) (massive κ).isRelFamily_lt hU hcurve)
      inf_le_left
  · intro s hs
    obtain ⟨z, hz, -, hez, hsz⟩ := exists_of_mem_chartImage (CurveOn.mem hcurve s hs)
    show i.1.symm (s, Cone.apex) ∈ sing M κ
    rw [hsz]
    refine (mem_sing_iff_mem_singLine hκ i.2.1 hz).2 ?_
    rw [hez]
    rfl
  · intro s hs s' hs' hss
    have h := hlt s hs s' hs' hss
    obtain ⟨z, -, hzU, hez, hsz⟩ := exists_of_mem_chartImage (CurveOn.mem hcurve s hs)
    obtain ⟨z', -, hzU', hez', hsz'⟩ := exists_of_mem_chartImage (CurveOn.mem hcurve s' hs')
    rw [← hez, ← hez'] at h
    have h' : C.lt U z z' := ((i.2.2 U hU z hzU z' hzU').2).2 h
    show C.lt W (i.1.symm (s, Cone.apex)) (i.1.symm (s', Cone.apex))
    rw [hsz, hsz']
    exact C.lt_mono inf_le_left h'

end Kappa

/-- **`SingularFlatAxioms.massive_line` at every Hausdorff `E_{≥0}`-manifold** (unmarked,
SCOPE): each component of `sing_α(M)`, `α > 0`, is an inextensible chronal curve parametrised by
`ℝ`, a closed embedding when `C` is causal. -/
theorem massive_line [T2Space M]
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality) :
    ∀ α : ℝ, 0 < α → ∀ p ∈ sing M α, ∃ γ : ℝ → M, γ 0 = p ∧
      (C.IsCausal → IsClosedEmbedding γ) ∧
      C.Inextensible ⊤ univ γ ∧ (∀ a b, C.ChronalCurveOn ⊤ γ a b) ∧
      range γ = connectedComponentIn (sing M α) p := by
  intro α hα p hp
  by_cases h2 : α = 2 * Real.pi
  · subst h2
    rw [sing_two_pi] at hp
    exact absurd hp (notMem_empty p)
  · haveI : Fact (0 < α) := ⟨hα⟩
    exact massive_line_of_ne hC h2 hp

/-- **`massive_line` for the natural causality** (`IsAtlasCausalityDEC25`, every chart an
isomorphism, absolutely minimal: the causality of a singular spacetime, `def:singular_spacetime`,
in DEC-25's reading). -/
theorem massive_line_of_isAtlasCausalityDEC25 [T2Space M] (hcov : MassACovered M)
    (hC : IsAtlasCausalityDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality) :
    ∀ α : ℝ, 0 < α → ∀ p ∈ sing M α, ∃ γ : ℝ → M, γ 0 = p ∧
      (C.IsCausal → IsClosedEmbedding γ) ∧
      C.Inextensible ⊤ univ γ ∧ (∀ a b, C.ChronalCurveOn ⊤ γ a b) ∧
      range γ = connectedComponentIn (sing M α) p :=
  massive_line (of_isAtlasCausalityDEC25 hcov hC).2

/-- **A component of `sing_α(M)`, `α > 0`, is timelike in `M`**: any two of its points are equal
or chronologically related in `M`, one way or the other. -/
theorem component_timelike [T2Space M]
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality) {α : ℝ}
    (hα : 0 < α) {p : M} (hp : p ∈ sing M α) {x y : M}
    (hx : x ∈ connectedComponentIn (sing M α) p) (hy : y ∈ connectedComponentIn (sing M α) p) :
    x = y ∨ C.lt ⊤ x y ∨ C.lt ⊤ y x := by
  obtain ⟨γ, -, -, -, hchron, hrange⟩ := massive_line hC α hα p hp
  rw [← hrange] at hx hy
  obtain ⟨s, rfl⟩ := hx
  obtain ⟨s', rfl⟩ := hy
  rcases lt_trichotomy s s' with h | h | h
  · exact Or.inr (Or.inl (CurveOn.rel_of_lt C.isRelFamily_lt (hchron s s') le_rfl h le_rfl))
  · exact Or.inl (congrArg γ h)
  · exact Or.inr (Or.inr (CurveOn.rel_of_lt C.isRelFamily_lt (hchron s' s) le_rfl h le_rfl))

/-- **`SingularFlatAxioms` at a Hausdorff, second countable `E_{≥0}`-manifold is exactly the BTZ
field `line`.** -/
theorem singularFlatAxioms_iff_line [T2Space M] [SecondCountableTopology M]
    (hmin : C.AbsolutelyMinimal)
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality) :
    C.SingularFlatAxioms (sing M) ↔
      ∀ p ∈ sing M 0, ∃ γ : ℝ → M, γ 0 = p ∧ (C.IsCausal → IsClosedEmbedding γ) ∧
        C.Inextensible ⊤ univ γ ∧ range γ = connectedComponentIn (sing M 0) p := by
  rw [SFABTZ.singularFlatAxioms_iff_lines hmin hC]
  exact ⟨fun h => h.1, fun h => ⟨h, massive_line hC⟩⟩

/-- **`SingularFlatAxioms` at every Hausdorff, second countable `E_{≥0}`-manifold with no BTZ
point**, its singular points all massive. -/
theorem singularFlatAxioms_of_sing_zero [T2Space M] [SecondCountableTopology M]
    (hmin : C.AbsolutelyMinimal)
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality)
    (h0 : sing M 0 = ∅) : C.SingularFlatAxioms (sing M) := by
  refine (singularFlatAxioms_iff_line hmin hC).2 fun p hp => ?_
  rw [h0] at hp
  exact absurd hp (notMem_empty p)

/-- **`SingularFlatAxioms` at every Hausdorff, second countable `E_{>0}`-manifold**: its singular
points in `X_A`-charts into massive models `E_κ`, `κ > 0`, only. -/
theorem singularFlatAxioms_of_massive [T2Space M] [SecondCountableTopology M]
    (hmin : C.AbsolutelyMinimal)
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality)
    (hpos : ∀ x ∈ Sing (Flat.isom 2) (Minkowski 2) M, ∃ o, o ≠ none ∧
      ∃ e : OpenPartialHomeomorph M (MassAModel o), IsAEChart (Flat.isom 2) (Minkowski 2) e ∧
        x ∈ e.source) :
    C.SingularFlatAxioms (sing M) := by
  refine singularFlatAxioms_of_sing_zero hmin hC (eq_empty_iff_forall_notMem.2 fun x hx => ?_)
  obtain ⟨o, ho, e, he, hxe⟩ := hpos x (sing_subset 0 hx)
  exact ho (eq_none_of_mem_sing_zero he hx hxe)

end Manifold

/-! ### The witness `E_π` -/

section WitnessEPi

attribute [local instance] EAlphaGX.singularGX EAlphaGX.fact_pi_pos

/-- **`E_π` satisfies `SingularFlatAxioms`**, with `sing_π(E_π)` the singular line, non-empty. -/
theorem epi_singularFlatAxioms :
    (massive Real.pi).SingularFlatAxioms (sing (Massive Real.pi)) := by
  obtain ⟨hmin, hC, -, -, h0⟩ := SFALocal.nonvacuous_epi
  exact singularFlatAxioms_of_sing_zero hmin hC h0

/-- **`E_π` is an `E_{>0}`-manifold**: the hypothesis `hpos` of `singularFlatAxioms_of_massive`
holds, through the identity chart into the model `E_π` of the family. -/
theorem epi_hpos : ∀ x ∈ Sing (Flat.isom 2) (Minkowski 2) (Massive Real.pi), ∃ o, o ≠ none ∧
    ∃ e : OpenPartialHomeomorph (Massive Real.pi) (MassAModel o),
      IsAEChart (Flat.isom 2) (Minkowski 2) e ∧ x ∈ e.source := by
  intro x _
  exact ⟨some ⟨Real.pi, Real.pi_pos⟩, Option.some_ne_none _, OpenPartialHomeomorph.refl _,
    isAEChart_refl, mem_univ x⟩

/-- `E_π` satisfies `SingularFlatAxioms` through `singularFlatAxioms_of_massive`. -/
theorem epi_singularFlatAxioms_of_massive :
    (massive Real.pi).SingularFlatAxioms (sing (Massive Real.pi)) := by
  obtain ⟨hmin, hC, -, -, -⟩ := SFALocal.nonvacuous_epi
  exact singularFlatAxioms_of_massive hmin hC epi_hpos

/-- **Non-vacuity at `E_π`**: the hypotheses of `massive_line` hold, `sing_π(E_π)` is the line,
non-empty, and the line through `(0, apex)` is a closed embedding onto the whole singular line. -/
theorem nonvacuous_epi :
    IsoChartsCoverDEC25 (Flat.isom 2) (massive Real.pi) (minkowski 2) massAModelCausality ∧
      sing (Massive Real.pi) Real.pi = singLine Real.pi ∧
      ∃ γ : ℝ → Massive Real.pi, γ 0 = ((0 : ℝ), Cone.apex) ∧ IsClosedEmbedding γ ∧
        (massive Real.pi).Inextensible ⊤ univ γ ∧
        (∀ a b, (massive Real.pi).ChronalCurveOn ⊤ γ a b) ∧ range γ = singLine Real.pi := by
  obtain ⟨-, hC, hl, -, -⟩ := SFALocal.nonvacuous_epi
  have hp : (((0 : ℝ), Cone.apex) : Massive Real.pi) ∈ sing (Massive Real.pi) Real.pi := by
    rw [hl]
    rfl
  obtain ⟨γ, hγ0, hemb, hinext, hchron, hrange⟩ := massive_line hC Real.pi Real.pi_pos _ hp
  have hline : singLine Real.pi = range (fun t : ℝ => ((t, Cone.apex) : Massive Real.pi)) := by
    ext y
    constructor
    · intro hy
      exact ⟨y.1, Prod.ext rfl hy.symm⟩
    · rintro ⟨t, rfl⟩
      rfl
  have hconn : IsPreconnected (singLine Real.pi) := by
    rw [hline]
    exact isPreconnected_range (continuous_id.prodMk continuous_const)
  refine ⟨hC, hl, γ, hγ0, hemb massive_isCausal, hinext, hchron, ?_⟩
  rw [hrange, hl]
  exact hconn.connectedComponentIn rfl

end WitnessEPi

end SFAMassiveLine

