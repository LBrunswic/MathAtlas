namespace Causal

open Set Filter Topology Function Complex
open scoped Real

namespace E0

variable {x y z : E0} {θ θ' θ₁ θ₂ θ₃ : ℝ}

/-! ### Isometries of `𝔼₀` as chart isomorphisms; the singular-flat axioms but push-up -/

section Isom

open TopologicalSpace

/-- A homeomorphism carrying the relation `R` forward carries `R`-curves of `W` to `R`-curves of
`e(W)`. -/
theorem curveOn_homeo (e : E0 ≃ₜ E0) {R : E0 → E0 → Prop} (hR : ∀ x y, R x y → R (e x) (e y))
    {W W' : Opens E0} (hW : (W' : Set E0) = e '' W) {c : ℝ → E0} {a b : ℝ}
    (hc : Causal.CurveOn (relOn R) W c a b) :
    Causal.CurveOn (relOn R) W' (fun t => e (c t)) a b where
  mem t ht := by
    show e (c t) ∈ (W' : Set E0)
    rw [hW]; exact mem_image_of_mem e (hc.mem t ht)
  rel t ht N hN htN := by
    let N' : Opens E0 := ⟨e ⁻¹' N, N.isOpen.preimage e.continuous⟩
    have hN' : N' ≤ W := fun z hz => by
      have h1 : e z ∈ (W' : Set E0) := hN hz
      rw [hW] at h1
      obtain ⟨z', hz', he⟩ := h1
      exact e.injective he ▸ hz'
    obtain ⟨l, u, hl, hu, h⟩ := hc.rel t ht N' hN' htN
    exact ⟨l, u, hl, hu, fun s hs s' hs' h1 h2 h3 => by
      obtain ⟨m1, m2, hr⟩ := h s hs s' hs' h1 h2 h3
      exact ⟨m1, m2, hR _ _ hr⟩⟩

/-- **A homeomorphism of `𝔼₀` preserving `≼` and `≺` both ways is a chart isomorphism**
(`Causal.ChartIso`) of the causality of `𝔼₀` onto itself. -/
theorem chartIso_of_homeo (e : E0 ≃ₜ E0) (hle : ∀ x y, Le (e x) (e y) ↔ Le x y)
    (hlt : ∀ x y, Lt (e x) (e y) ↔ Lt x y) :
    Causal.ChartIso causality causality e.toOpenPartialHomeomorph := by
  intro U hU x _ y _
  have himg : ((Causal.chartImage e.toOpenPartialHomeomorph U : Opens E0) : Set E0) = e '' U := by
    rw [Causal.coe_chartImage_of_le hU]; rfl
  have himg' : (U : Set E0) =
      e.symm '' (Causal.chartImage e.toOpenPartialHomeomorph U : Opens E0) := by
    rw [himg, ← image_comp, Homeomorph.symm_comp_self, image_id]
  have hle' : ∀ a b, Le a b → Le (e.symm a) (e.symm b) := fun a b h => by
    rw [← hle, Homeomorph.apply_symm_apply, Homeomorph.apply_symm_apply]; exact h
  have hlt' : ∀ a b, Lt a b → Lt (e.symm a) (e.symm b) := fun a b h => by
    rw [← hlt, Homeomorph.apply_symm_apply, Homeomorph.apply_symm_apply]; exact h
  show (CLe U x y ↔ CLe _ (e x) (e y)) ∧ (CLt U x y ↔ CLt _ (e x) (e y))
  refine ⟨⟨fun ⟨a, b, hab, c, hc, h0, h1⟩ => ⟨a, b, hab, _,
      curveOn_homeo e (fun x y => (hle x y).2) himg hc, by simp only [h0], by simp only [h1]⟩,
    fun ⟨a, b, hab, c, hc, h0, h1⟩ => ⟨a, b, hab, _, curveOn_homeo e.symm hle' himg' hc,
      by simp only [h0, Homeomorph.symm_apply_apply], by simp only [h1, Homeomorph.symm_apply_apply]⟩⟩,
    ⟨fun ⟨a, b, hab, c, hc, h0, h1⟩ => ⟨a, b, hab, _,
      curveOn_homeo e (fun x y => (hlt x y).2) himg hc, by simp only [h0], by simp only [h1]⟩,
    fun ⟨a, b, hab, c, hc, h0, h1⟩ => ⟨a, b, hab, _, curveOn_homeo e.symm hlt' himg' hc,
      by simp only [h0, Homeomorph.symm_apply_apply], by simp only [h1, Homeomorph.symm_apply_apply]⟩⟩⟩

/-- **The translation `τ ↦ τ + t` along the BTZ line**, an isometry of `𝔼₀`. -/
noncomputable def tauShift (t : ℝ) : E0 ≃ₜ E0 where
  toFun x := (x.1 + t, x.2)
  invFun x := (x.1 - t, x.2)
  left_inv x := by simp
  right_inv x := by simp
  continuous_toFun := by fun_prop
  continuous_invFun := by fun_prop

/-- **The rotation `z ↦ e^{iφ} z` about the BTZ line**, an isometry of `𝔼₀`. -/
noncomputable def rotE0 (φ : ℝ) : E0 ≃ₜ E0 where
  toFun x := (x.1, cexp (φ * I) * x.2)
  invFun x := (x.1, cexp (-φ * I) * x.2)
  left_inv x := by
    refine Prod.ext rfl ?_
    show cexp (-φ * I) * (cexp (φ * I) * x.2) = x.2
    rw [← mul_assoc, ← Complex.exp_add, show (-φ * I : ℂ) + φ * I = 0 by ring, Complex.exp_zero,
      one_mul]
  right_inv x := by
    refine Prod.ext rfl ?_
    show cexp (φ * I) * (cexp (-φ * I) * x.2) = x.2
    rw [← mul_assoc, ← Complex.exp_add, show (φ * I : ℂ) + -φ * I = 0 by ring, Complex.exp_zero,
      one_mul]
  continuous_toFun := by fun_prop
  continuous_invFun := by fun_prop

theorem rad_tauShift (t : ℝ) (x : E0) : rad (tauShift t x) = rad x := rfl

theorem polar_tauShift (t : ℝ) (x : E0) (θ : ℝ) : Polar (tauShift t x) θ ↔ Polar x θ := Iff.rfl

theorem rad_rotE0 (φ : ℝ) (x : E0) : rad (rotE0 φ x) = rad x := by
  show ‖cexp (φ * I) * x.2‖ = ‖x.2‖
  rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]

theorem polar_rotE0 (φ : ℝ) (x : E0) (θ : ℝ) : Polar (rotE0 φ x) θ ↔ Polar x (θ - φ) := by
  unfold Polar
  rw [rad_rotE0]
  show cexp (φ * I) * x.2 = _ ↔ _
  have hne : cexp (φ * I) ≠ 0 := Complex.exp_ne_zero _
  have e : (rad x : ℂ) * cexp (θ * I) = cexp (φ * I) * ((rad x : ℂ) * cexp (↑(θ - φ) * I)) := by
    rw [mul_left_comm, ← Complex.exp_add]; congr 2; push_cast; ring
  rw [e]
  exact ⟨fun h => mul_left_cancel₀ hne h, fun h => by rw [h]⟩

theorem le_tauShift_iff (t : ℝ) (x y : E0) : Le (tauShift t x) (tauShift t y) ↔ Le x y := by
  rw [le_iff_closed, le_iff_closed]
  show (∃ θ₁ θ₂, Polar x θ₁ ∧ Polar y θ₂ ∧ ClosedLe (x.1 + t) (rad x) (y.1 + t) (rad y) _) ↔ _
  simp only [ClosedLe, add_le_add_iff_right, show ∀ a b : ℝ, b + t - (a + t) = b - a from
    fun a b => by ring]

theorem lt_tauShift_iff (t : ℝ) (x y : E0) : Lt (tauShift t x) (tauShift t y) ↔ Lt x y := by
  rw [lt_iff_closed, lt_iff_closed]
  show (∃ θ₁ θ₂, Polar x θ₁ ∧ Polar y θ₂ ∧ ClosedLt (x.1 + t) (rad x) (y.1 + t) (rad y) _) ↔ _
  simp only [ClosedLt, show ∀ a b : ℝ, b + t - (a + t) = b - a from fun a b => by ring]

theorem le_rotE0_iff (φ : ℝ) (x y : E0) : Le (rotE0 φ x) (rotE0 φ y) ↔ Le x y := by
  rw [le_iff_closed, le_iff_closed, rad_rotE0, rad_rotE0]
  show (∃ θ₁ θ₂, _ ∧ _ ∧ ClosedLe x.1 (rad x) y.1 (rad y) _) ↔ _
  constructor
  · rintro ⟨θ₁, θ₂, h₁, h₂, h⟩
    refine ⟨θ₁ - φ, θ₂ - φ, (polar_rotE0 φ x θ₁).1 h₁, (polar_rotE0 φ y θ₂).1 h₂, ?_⟩
    rwa [show θ₂ - φ - (θ₁ - φ) = θ₂ - θ₁ by ring]
  · rintro ⟨θ₁, θ₂, h₁, h₂, h⟩
    refine ⟨θ₁ + φ, θ₂ + φ, (polar_rotE0 φ x _).2 (by rwa [add_sub_cancel_right]),
      (polar_rotE0 φ y _).2 (by rwa [add_sub_cancel_right]), ?_⟩
    rwa [show θ₂ + φ - (θ₁ + φ) = θ₂ - θ₁ by ring]

theorem lt_rotE0_iff (φ : ℝ) (x y : E0) : Lt (rotE0 φ x) (rotE0 φ y) ↔ Lt x y := by
  rw [lt_iff_closed, lt_iff_closed, rad_rotE0, rad_rotE0]
  show (∃ θ₁ θ₂, _ ∧ _ ∧ ClosedLt x.1 (rad x) y.1 (rad y) _) ↔ _
  constructor
  · rintro ⟨θ₁, θ₂, h₁, h₂, h⟩
    refine ⟨θ₁ - φ, θ₂ - φ, (polar_rotE0 φ x θ₁).1 h₁, (polar_rotE0 φ y θ₂).1 h₂, ?_⟩
    rwa [show θ₂ - φ - (θ₁ - φ) = θ₂ - θ₁ by ring]
  · rintro ⟨θ₁, θ₂, h₁, h₂, h⟩
    refine ⟨θ₁ + φ, θ₂ + φ, (polar_rotE0 φ x _).2 (by rwa [add_sub_cancel_right]),
      (polar_rotE0 φ y _).2 (by rwa [add_sub_cancel_right]), ?_⟩
    rwa [show θ₂ + φ - (θ₁ + φ) = θ₂ - θ₁ by ring]

/-- **The translations along the BTZ line are chart isomorphisms** (`chartIso_mem` for the
`τ`-translation generators of `Isom(𝔼₀)`). -/
theorem chartIso_tauShift (t : ℝ) :
    Causal.ChartIso causality causality (tauShift t).toOpenPartialHomeomorph :=
  chartIso_of_homeo _ (le_tauShift_iff t) (lt_tauShift_iff t)

/-- **The rotations about the BTZ line are chart isomorphisms** (`chartIso_mem` for the rotation
generators of `Isom(𝔼₀)`). -/
theorem chartIso_rotE0 (φ : ℝ) :
    Causal.ChartIso causality causality (rotE0 φ).toOpenPartialHomeomorph :=
  chartIso_of_homeo _ (le_rotE0_iff φ) (lt_rotE0_iff φ)

theorem tauShift_axis {t : ℝ} {x : E0} : tauShift t x ∈ axis ↔ x ∈ axis := Iff.rfl

theorem rotE0_axis {φ : ℝ} {x : E0} : rotE0 φ x ∈ axis ↔ x ∈ axis := by
  rw [← rad_eq_zero, ← rad_eq_zero, rad_rotE0]

/-- The singular loci of `𝔼₀`: `sing₀ = axis`, `sing_α = ∅` for `α ≠ 0`. -/
def singE0 (α : ℝ) : Set E0 := if α = 0 then axis else ∅

theorem singE0_zero : singE0 0 = axis := if_pos rfl

theorem singE0_of_ne {α : ℝ} (h : α ≠ 0) : singE0 α = ∅ := if_neg h

/-- The BTZ line has empty interior. -/
theorem interior_axis : interior axis = ∅ := by
  refine eq_empty_iff_forall_notMem.2 fun x hx => ?_
  obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.1 isOpen_interior x hx
  have hx0 : x.2 = 0 := (interior_subset hx : x ∈ axis)
  have hmem : ((x.1, ((δ / 2 : ℝ) : ℂ)) : E0) ∈ Metric.ball x δ := by
    rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff, dist_self, hx0, dist_zero_right,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    exact ⟨hδ, by linarith⟩
  have h1 : ((δ / 2 : ℝ) : ℂ) = 0 := (interior_subset (hball hmem) : _ ∈ axis)
  have := Complex.ofReal_eq_zero.1 h1
  linarith

/-- **`Causal.SingularFlatAxioms` for `𝔼₀`, push-up given**: every field but `pushUp` is proved
(the BTZ axioms, absolute minimality, causal arc-connectedness, tarentinity, `Z⁺ = 𝔼₀`,
`Z⁻ = 𝔼₀ ∖ sing₀`, the topology, the singular loci). The local push-up `J^±_U(I^±_U(x)) ⊂
I^±_U(x)` in every open `U` is the one input left (it holds globally, `Lt.trans_le`). -/
theorem singularFlatAxioms_of_pushUp (hP : causality.PushUp) :
    causality.SingularFlatAxioms singE0 where
  toBTZAxioms := by rw [singE0_zero]; exact btzAxioms
  pushUp := hP
  absolutelyMinimal := causallyArcConnected.absolutelyMinimal
  causallyArcConnected := causallyArcConnected
  tarentin := tarentin
  mem_Zplus := mem_Zplus
  mem_Zminus_iff p := by rw [singE0_zero]; exact mem_Zminus_iff p
  t2 := inferInstance
  secondCountable := inferInstance
  metrizable := inferInstance
  locallyCompact := inferInstance
  noIsolated p := inferInstance
  isClosed_sing α _ := by
    by_cases h : α = 0
    · rw [h, singE0_zero]; exact isClosed_axis
    · rw [singE0_of_ne h]; exact isClosed_empty
  interior_sing α _ := by
    by_cases h : α = 0
    · rw [h, singE0_zero]; exact interior_axis
    · rw [singE0_of_ne h]; exact interior_empty
  massive_line α hα p hp := by
    rw [singE0_of_ne hα.ne'] at hp; exact absurd hp (notMem_empty p)

end Isom

end E0

end Causal

namespace Causal

open Set Filter Topology Function TopologicalSpace
open scoped Real

namespace E0LM

/-! ### §2 Local forms of the model's causal facts, in every open set -/

section Local

variable {X : Type*} [TopologicalSpace X]

/-- `Z⁺` in every open set: at every `y ∈ W`, `I⁺_W(y)` meets every neighbourhood of `y`. -/
def LocZplus (D : Causal.Causality X) : Prop :=
  ∀ (W : Opens X) (y : X), y ∈ W → ∀ N ∈ 𝓝 y, ∃ z ∈ N, D.lt W y z

/-- `Z⁻` off `S` in every open set. -/
def LocZminus (D : Causal.Causality X) (S : Set X) : Prop :=
  ∀ (W : Opens X) (y : X), y ∈ W → y ∉ S → ∀ N ∈ 𝓝 y, ∃ z ∈ N, D.lt W z y

/-- Tarentin in every open set: small open diamonds of `W` around every point. -/
def LocTarentin (D : Causal.Causality X) : Prop :=
  ∀ (W : Opens X) (y : X), y ∈ W → ∀ N ∈ 𝓝 y, ∃ p ∈ N, ∃ q ∈ N, y ∈ D.openDiamond W p q

/-- No chronological past at the points of `S`, in every open set. -/
def LocNoPast (D : Causal.Causality X) (S : Set X) : Prop :=
  ∀ (W : Opens X) (y : X), y ∈ S → ∀ z, ¬ D.lt W z y

/-- The causal past of a point of `S` stays in `S`, in every open set. -/
def LocPastIn (D : Causal.Causality X) (S : Set X) : Prop :=
  ∀ (W : Opens X) (y : X), y ∈ S → ∀ z, D.le W z y → z ∈ S

variable {D : Causal.Causality X}

/-- In a causally arc-connected spacetime, the relations of `⊤` between two points of a causally
convex set `V ⊆ W` are relations of `W` (the realising curve stays in the diamond, so in `V`). -/
theorem rel_of_causallyConvex (hD : D.CausallyArcConnected) {V : Set X}
    (hV : D.CausallyConvexIn V ⊤) {W : Opens X} (hVW : V ⊆ W) {y z : X} (hy : y ∈ V)
    (hz : z ∈ V) : (D.le ⊤ y z → D.le W y z) ∧ (D.lt ⊤ y z → D.lt W y z) := by
  refine ⟨fun h => ?_, fun h => ?_⟩
  · obtain ⟨c, hc, h0, h1⟩ := (hD ⊤ le_rfl y z).1.1 h
    subst h0; subst h1
    have hmem : ∀ t ∈ Icc (0 : ℝ) 1, c t ∈ W := fun t ht =>
      hVW (hV.2 _ hy _ hz (Causal.Causality.mem_diamond.2
        ⟨hc.le_of_le le_rfl ht.1 ht.2, hc.le_of_le ht.1 ht.2 le_rfl⟩))
    have hcW : D.CausalCurveOn W c 0 1 := Causal.CurveOn.restrict hc le_rfl le_rfl le_top hmem
    exact hcW.le_of_le le_rfl zero_le_one le_rfl
  · obtain ⟨c, hc, h0, h1⟩ := (hD ⊤ le_rfl y z).2.1 h
    subst h0; subst h1
    have hc' := hc.causalCurveOn
    have hmem : ∀ t ∈ Icc (0 : ℝ) 1, c t ∈ W := fun t ht =>
      hVW (hV.2 _ hy _ hz (Causal.Causality.mem_diamond.2
        ⟨hc'.le_of_le le_rfl ht.1 ht.2, hc'.le_of_le ht.1 ht.2 le_rfl⟩))
    have hcW : D.ChronalCurveOn W c 0 1 := Causal.CurveOn.restrict hc le_rfl le_rfl le_top hmem
    exact hcW.lt_of_lt le_rfl zero_lt_one le_rfl

theorem locZplus_of (hD : D.CausallyArcConnected) (hSC : D.StronglyCausal)
    (hZ : ∀ y, y ∈ D.Zplus) : LocZplus D := by
  intro W y hy N hN
  obtain ⟨V, hV, hVsub, hVc⟩ := hSC y (N ∩ W) (inter_mem hN (W.isOpen.mem_nhds hy))
  obtain ⟨z, hzI, hzV⟩ := hZ y V hV
  exact ⟨z, (hVsub hzV).1, (rel_of_causallyConvex hD hVc (fun w hw => (hVsub hw).2)
    (mem_of_mem_nhds hV) hzV).2 (Causal.Precausality.mem_Iplus_singleton.1 hzI)⟩

theorem locZminus_of (hD : D.CausallyArcConnected) (hSC : D.StronglyCausal) {S : Set X}
    (hZ : ∀ y, y ∉ S → y ∈ D.Zminus) : LocZminus D S := by
  intro W y hy hyS N hN
  obtain ⟨V, hV, hVsub, hVc⟩ := hSC y (N ∩ W) (inter_mem hN (W.isOpen.mem_nhds hy))
  obtain ⟨z, hzI, hzV⟩ := hZ y hyS V hV
  exact ⟨z, (hVsub hzV).1, (rel_of_causallyConvex hD hVc (fun w hw => (hVsub hw).2)
    hzV (mem_of_mem_nhds hV)).2 (Causal.Precausality.mem_Iminus_singleton.1 hzI)⟩

theorem locTarentin_of (hD : D.CausallyArcConnected) (hSC : D.StronglyCausal)
    (hT : D.Tarentin) : LocTarentin D := by
  intro W y hy N hN
  obtain ⟨V, hV, hVsub, hVc⟩ := hSC y (N ∩ W) (inter_mem hN (W.isOpen.mem_nhds hy))
  obtain ⟨p, hp, q, hq, hyd⟩ := hT y V hV
  refine ⟨p, (hVsub hp).1, q, (hVsub hq).1, interior_mono (fun w hw => ?_) hyd⟩
  have hwV : w ∈ V := hVc.2 p hp q hq hw
  obtain ⟨h1, h2⟩ := Causal.Causality.mem_diamond.1 hw
  exact Causal.Causality.mem_diamond.2
    ⟨(rel_of_causallyConvex hD hVc (fun w hw => (hVsub hw).2) hp hwV).1 h1,
      (rel_of_causallyConvex hD hVc (fun w hw => (hVsub hw).2) hwV hq).1 h2⟩

end Local

/-! ### §2b The local forms for `𝔼₀` -/

section LocalModelFacts

theorem e0_locZplus : LocZplus E0.causality :=
  locZplus_of E0.causallyArcConnected E0.stronglyCausal E0.mem_Zplus

theorem e0_locZminus : LocZminus E0.causality E0.axis :=
  locZminus_of E0.causallyArcConnected E0.stronglyCausal fun y hy => (E0.mem_Zminus_iff y).2 hy

theorem e0_locTarentin : LocTarentin E0.causality :=
  locTarentin_of E0.causallyArcConnected E0.stronglyCausal E0.tarentin

theorem e0_locNoPast : LocNoPast E0.causality E0.axis := fun W _ hy z hz => by
  have h := Causal.Precausality.mem_Iminus_singleton.2 hz
  rw [E0.Iminus_axis hy W] at h
  exact notMem_empty z h

theorem e0_locPastIn : LocPastIn E0.causality E0.axis := fun W _ hy _ hz =>
  E0.Jminus_axis_subset hy W (Causal.Precausality.mem_Jminus_singleton.2 hz)

end LocalModelFacts


/-! ### §2c Push-up in every open set of `𝔼₀`, of `Y` (WP-41e SCOPE (d)) -/

section PushUpGeneric

variable {X : Type*} [TopologicalSpace X] {C : Causal.Causality X}

/-- A chart isomorphism onto a model with push-up gives push-up on its source. -/
theorem pushUpOn_of_chartIso {Z : Type*} [TopologicalSpace Z] {D : Causal.Causality Z}
    {e : OpenPartialHomeomorph X Z} (h : Causal.ChartIso C D e) (hD : D.PushUp) :
    C.PushUpOn (Causal.chartSource e) := by
  intro U hU x y z
  refine ⟨fun h₁ h₂ => ?_, fun h₁ h₂ => ?_⟩
  · have hx := C.lt_mem_left h₁
    have hy := C.lt_mem_right h₁
    have hz := C.le_mem_right h₂
    exact ((h U hU x hx z hz).2).2 (hD.lt_of_lt_of_le ((h U hU x hx y hy).2.1 h₁)
      ((h U hU y hy z hz).1.1 h₂))
  · have hx := C.le_mem_left h₁
    have hy := C.le_mem_right h₁
    have hz := C.lt_mem_right h₂
    exact ((h U hU x hx z hz).2).2 (hD.lt_of_le_of_lt ((h U hU x hx y hy).1.1 h₁)
      ((h U hU y hy z hz).2.1 h₂))

/-- **The push-up step through a link** (`lem:pushup_local`'s one step): `x ≪_U b` and
`b ≤_{U ⊓ O} b'` with push-up on `O` give `x ≪_U b'`. -/
theorem lt_of_lt_of_le_link (hC : C.CausallyArcConnected) {O U : Opens X} (hO : C.PushUpOn O)
    {x b b' : X} (h₁ : C.lt U x b) (h₂ : C.le (U ⊓ O) b b') : C.lt U x b' := by
  obtain ⟨γ, hγ, hγ0, hγ1⟩ := (hC U le_top x b).2.1 h₁
  have hbN : γ 1 ∈ U ⊓ O := by rw [hγ1]; exact C.le_mem_left h₂
  obtain ⟨l, u, hl, hu, hrel⟩ := hγ.rel 1 ⟨zero_le_one, le_rfl⟩ (U ⊓ O) inf_le_left hbN
  have hmax : max l 0 < 1 := max_lt hl zero_lt_one
  obtain ⟨s, hs1, hs2⟩ := exists_between hmax
  have hl_s : l < s := (le_max_left _ _).trans_lt hs1
  have h0_s : 0 < s := (le_max_right _ _).trans_lt hs1
  have hz' : C.lt (U ⊓ O) (γ s) (γ 1) :=
    hrel s ⟨h0_s.le, hs2.le⟩ 1 ⟨zero_le_one, le_rfl⟩ hl_s hs2 hu
  rw [hγ1] at hz'
  have hz'w : C.lt (U ⊓ O) (γ s) b' := ((hO (U ⊓ O) inf_le_right).1 hz' h₂)
  have hyz' : C.lt U (γ 0) (γ s) := hγ.lt_of_lt le_rfl h0_s hs2.le
  rw [hγ0] at hyz'
  exact C.lt_trans hyz' (C.lt_mono inf_le_left hz'w)

/-- **The push-up step through a link, past form** (`C.dual`). -/
theorem lt_of_le_link_of_lt (hC : C.CausallyArcConnected) {O U : Opens X} (hO : C.PushUpOn O)
    {b b' z : X} (h₁ : C.le (U ⊓ O) b b') (h₂ : C.lt U b' z) : C.lt U b z :=
  lt_of_lt_of_le_link (C := C.dual) (Causal.Causality.dual_causallyArcConnectedOn.2 hC)
    (Causal.Causality.dual_pushUpOn.2 hO) h₂ h₁

/-- **Real induction, downward**: a property of `[0,1]` true at `1`, open downward, and passing
to `t` from `(t, 1]`, holds at `0`. -/
theorem prop_zero_of_down {P : ℝ → Prop} (h1 : P 1)
    (hopen : ∀ t ∈ Icc (0 : ℝ) 1, P t → ∃ η > 0, ∀ s ∈ Icc (0 : ℝ) 1, t - η < s → s ≤ t → P s)
    (hstep : ∀ t ∈ Ico (0 : ℝ) 1, (∀ s ∈ Ioc t 1, P s) → P t) : P 0 := by
  set A := {t ∈ Icc (0 : ℝ) 1 | ∀ s ∈ Icc t 1, P s} with hA
  have hAne : A.Nonempty := ⟨1, ⟨zero_le_one, le_rfl⟩, fun s hs => by
    rw [le_antisymm hs.2 hs.1]; exact h1⟩
  have hAbdd : BddBelow A := ⟨0, fun t ht => ht.1.1⟩
  set m := sInf A
  have hm0 : 0 ≤ m := le_csInf hAne fun t ht => ht.1.1
  have hm1 : m ≤ 1 := csInf_le hAbdd ⟨⟨zero_le_one, le_rfl⟩, fun s hs => by
    rw [le_antisymm hs.2 hs.1]; exact h1⟩
  have habove : ∀ s ∈ Ioc m 1, P s := by
    intro s hs
    obtain ⟨a, haA, has⟩ := (csInf_lt_iff hAbdd hAne).1 hs.1
    exact haA.2 s ⟨has.le, hs.2⟩
  have hPm : P m := by
    rcases hm1.lt_or_eq with h | h
    · exact hstep m ⟨hm0, h⟩ habove
    · rw [h]; exact h1
  rcases hm0.lt_or_eq with hpos | hzero
  · exfalso
    obtain ⟨η, hη, hη'⟩ := hopen m ⟨hm0, hm1⟩ hPm
    set m' := max (m - η / 2) 0
    have hm'A : m' ∈ A := by
      refine ⟨⟨le_max_right _ _, (max_le (by linarith) zero_le_one)⟩, fun s hs => ?_⟩
      rcases le_or_gt s m with hsm | hsm
      · refine hη' s ⟨hs.1.trans' (le_max_right _ _), hs.2⟩ ?_ hsm
        have := hs.1
        have : m - η / 2 ≤ m' := le_max_left _ _
        linarith
      · exact habove s ⟨hsm, hs.2⟩
    have := csInf_le hAbdd hm'A
    have : m' < m := max_lt (by linarith) hpos
    linarith
  · rw [hzero]; exact hPm

/-- **Real induction, upward** (from `prop_zero_of_down` by `t ↦ 1 − t`). -/
theorem prop_one_of_up {P : ℝ → Prop} (h0 : P 0)
    (hopen : ∀ t ∈ Icc (0 : ℝ) 1, P t → ∃ η > 0, ∀ s ∈ Icc (0 : ℝ) 1, t ≤ s → s < t + η → P s)
    (hstep : ∀ t ∈ Ioc (0 : ℝ) 1, (∀ s ∈ Ico 0 t, P s) → P t) : P 1 := by
  have := prop_zero_of_down (P := fun t => P (1 - t)) (by simpa using h0)
    (fun t ht hPt => by
      obtain ⟨η, hη, h⟩ := hopen (1 - t) ⟨by linarith [ht.2], by linarith [ht.1]⟩ hPt
      refine ⟨η, hη, fun s hs h1 h2 => h (1 - s) ⟨by linarith [hs.2], by linarith [hs.1]⟩
        (by linarith) (by linarith)⟩)
    (fun t ht hP => hstep (1 - t) ⟨by linarith [ht.2], by linarith [ht.1]⟩ fun s hs => by
      have := hP (1 - s) ⟨by linarith [hs.2], by linarith [hs.1]⟩
      simpa using this)
  simpa using this

/-- A property `w ↦ w ∈ V`, `V` open, along a curve, is open in the parameter. -/
theorem exists_eta_of_mem_open {δ : ℝ → X} (hδ : ContinuousOn δ (Icc 0 1)) {V : Set X}
    (hV : IsOpen V) {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 1) (htV : δ t ∈ V) :
    ∃ η > 0, ∀ s ∈ Icc (0 : ℝ) 1, |s - t| < η → δ s ∈ V := by
  have h := (hδ t ht).preimage_mem_nhdsWithin (hV.mem_nhds htV)
  obtain ⟨η, hη, hball⟩ := Metric.mem_nhdsWithin_iff.1 h
  exact ⟨η, hη, fun s hs hst => hball ⟨by rwa [Metric.mem_ball, Real.dist_eq], hs⟩⟩

end PushUpGeneric


section E0PushUp

theorem e0_pushUpOn_sector {a : E0} (ha : a.2 ≠ 0) :
    E0.causality.PushUpOn (Causal.chartSource (E0.sectorChart a ha)) :=
  pushUpOn_of_chartIso (E0.chartIso_sectorChart ha) Causal.minkowski_pushUp

theorem e0_mem_sector_source {a : E0} (ha : a.2 ≠ 0) :
    a ∈ Causal.chartSource (E0.sectorChart a ha) := E0.mem_sector_self ha

/-- **Push-up in every open set of `𝔼₀`, first form**: `x ≪_U y ≤_U z ⇒ x ≪_U z`. Along a causal
curve from `y` to `z` (regular, `y` having a chronological past), each point is reached through a
sector chart, where Minkowski's push-up holds. -/
theorem e0_lt_of_lt_of_le {U : Opens E0} {x y z : E0} (h₁ : E0.causality.lt U x y) (h₂ : E0.causality.le U y z) :
    E0.causality.lt U x z := by
  obtain ⟨δ, hδ, hδ0, hδ1⟩ := (E0.causallyArcConnected U le_top y z).1.1 h₂
  have hy : y ∉ E0.axis := fun hy => e0_locNoPast U y hy x h₁
  have hcont := hδ.continuousOn E0.causality.isRelFamily_le
  have key := prop_one_of_up (P := fun t => E0.causality.lt U x (δ t)) (by simpa [hδ0] using h₁)
    (fun t ht hPt => by
      obtain ⟨η, hη, h⟩ := exists_eta_of_mem_open hcont (E0.causality.isOpen_lt_right U x) ht hPt
      exact ⟨η, hη, fun s hs h1 h2 => h s hs (by rw [abs_lt]; constructor <;> linarith)⟩)
    (fun t ht hP => by
      have hta : δ t ∉ E0.axis := by
        intro hax
        have hyt : E0.causality.le U y (δ t) := by
          have := hδ.le_of_le le_rfl ht.1.le ht.2
          rwa [hδ0] at this
        exact hy (e0_locPastIn U (δ t) hax y hyt)
      have ha : (δ t).2 ≠ 0 := hta
      set O := Causal.chartSource (E0.sectorChart (δ t) ha)
      obtain ⟨l, u, hl, hu, hrel⟩ := hδ.rel t ⟨ht.1.le, ht.2⟩ (U ⊓ O) inf_le_left
        ⟨hδ.mem t ⟨ht.1.le, ht.2⟩, e0_mem_sector_source ha⟩
      obtain ⟨s, hs1, hs2⟩ := exists_between (max_lt hl ht.1)
      have hls : l < s := (le_max_left _ _).trans_lt hs1
      have h0s : 0 < s := (le_max_right _ _).trans_lt hs1
      have hlink : E0.causality.le (U ⊓ O) (δ s) (δ t) :=
        hrel s ⟨h0s.le, hs2.le.trans ht.2⟩ t ⟨ht.1.le, ht.2⟩ hls hs2 hu
      exact lt_of_lt_of_le_link E0.causallyArcConnected (e0_pushUpOn_sector ha)
        (hP s ⟨h0s.le, hs2⟩) hlink)
  simpa [hδ1] using key

/-- **Push-up in every open set of `𝔼₀`, second form**: `x ≤_U y ≪_U z ⇒ x ≪_U z`. Backwards along
a causal curve from `x` to `y`: at a regular point through a sector chart; at a BTZ point `a`, a
point `b` just above it on the curve has `τ_a ≤ f(b)`, and a regular `w` near `b` with
`f(w) > τ_a` lies in `I⁺_B(a)` for a ball `B` (`Iplus_ball_axis`) and still in `I⁻_U(z)`. -/
theorem e0_lt_of_le_of_lt {U : Opens E0} {x y z : E0} (h₁ : E0.causality.le U x y) (h₂ : E0.causality.lt U y z) :
    E0.causality.lt U x z := by
  obtain ⟨δ, hδ, hδ0, hδ1⟩ := (E0.causallyArcConnected U le_top x y).1.1 h₁
  have hcont := hδ.continuousOn E0.causality.isRelFamily_le
  have key := prop_zero_of_down (P := fun t => E0.causality.lt U (δ t) z) (by simpa [hδ1] using h₂)
    (fun t ht hPt => by
      obtain ⟨η, hη, h⟩ := exists_eta_of_mem_open hcont (E0.causality.isOpen_lt_left U z) ht hPt
      exact ⟨η, hη, fun s hs h1 h2 => h s hs (by rw [abs_lt]; constructor <;> linarith)⟩)
    (fun t ht hP => by
      have htI : t ∈ Icc (0 : ℝ) 1 := ⟨ht.1, ht.2.le⟩
      by_cases hta : δ t ∈ E0.axis
      · -- a BTZ point
        obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 U.isOpen (δ t) (hδ.mem t htI)
        set NB : Opens E0 := ⟨Metric.ball (δ t) ε, Metric.isOpen_ball⟩
        have hNBU : NB ≤ U := hεU
        obtain ⟨l, u, hl, hu, hrel⟩ := hδ.rel t htI (U ⊓ NB) inf_le_left
          ⟨hδ.mem t htI, Metric.mem_ball_self hε⟩
        obtain ⟨s, hs1, hs2⟩ := exists_between (lt_min hu ht.2)
        have hsu : s < u := hs2.trans_le (min_le_left _ _)
        have hs1' : s < 1 := hs2.trans_le (min_le_right _ _)
        have hlink : E0.causality.le (U ⊓ NB) (δ t) (δ s) :=
          hrel t htI s ⟨ht.1.trans hs1.le, hs1'.le⟩ hl hs1 hsu
        set b := δ s
        have hbB : b ∈ Metric.ball (δ t) ε := (E0.causality.le_mem_right hlink).2
        have hfb : (δ t).1 ≤ E0.fcoord b :=
          (E0.le_axis_iff hta).1 (E0.le_of_le hlink)
        have hPb : E0.causality.lt U b z := hP s ⟨hs1, hs1'.le⟩
        have hVo : IsOpen ({w | E0.causality.lt U w z} ∩ Metric.ball (δ t) ε) :=
          (E0.causality.isOpen_lt_left U z).inter Metric.isOpen_ball
        obtain ⟨ρ, hρ, hρV⟩ := Metric.isOpen_iff.1 hVo b ⟨hPb, hbB⟩
        obtain ⟨w, hwV, hwr, hwf⟩ : ∃ w ∈ Metric.ball b ρ, 0 < E0.rad w ∧
            (δ t).1 < E0.fcoord w := by
          by_cases hb : b ∈ E0.axis
          · refine ⟨(b.1 + ρ / 2, ((ρ / 2 : ℝ) : ℂ)), ?_, ?_, ?_⟩
            · rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff, Real.dist_eq]
              have hb0 : b.2 = 0 := hb
              rw [hb0, dist_zero_right, Complex.norm_real, Real.norm_eq_abs]
              constructor
              · rw [show b.1 + ρ / 2 - b.1 = ρ / 2 by ring, abs_of_pos (by positivity)]
                linarith
              · rw [abs_of_pos (by positivity)]; linarith
            · show 0 < ‖((ρ / 2 : ℝ) : ℂ)‖
              rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
              positivity
            · have hfb' : E0.fcoord b = b.1 := by
                rw [E0.fcoord, E0.rad_eq_zero.2 hb]; ring
              show (δ t).1 < (b.1 + ρ / 2) - ‖((ρ / 2 : ℝ) : ℂ)‖ / 2
              rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
              linarith
          · refine ⟨(b.1 + ρ / 2, b.2), ?_, E0.rad_pos.2 hb, ?_⟩
            · rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff, Real.dist_eq, dist_self]
              refine ⟨?_, hρ⟩
              rw [show b.1 + ρ / 2 - b.1 = ρ / 2 by ring, abs_of_pos (by positivity)]
              linarith
            · show (δ t).1 < (b.1 + ρ / 2) - ‖b.2‖ / 2
              have : E0.fcoord b = b.1 - ‖b.2‖ / 2 := rfl
              linarith
        have hwV' := hρV hwV
        have hI : w ∈ E0.causality.Iplus NB {δ t} := by
          rw [E0.Iplus_ball_axis hta]; exact ⟨hwV'.2, hwr, hwf⟩
        exact E0.causality.lt_trans (E0.causality.lt_mono hNBU (Causal.Precausality.mem_Iplus_singleton.1 hI))
          hwV'.1
      · -- a regular point
        have ha : (δ t).2 ≠ 0 := hta
        set O := Causal.chartSource (E0.sectorChart (δ t) ha)
        obtain ⟨l, u, hl, hu, hrel⟩ := hδ.rel t htI (U ⊓ O) inf_le_left
          ⟨hδ.mem t htI, e0_mem_sector_source ha⟩
        obtain ⟨s, hs1, hs2⟩ := exists_between (lt_min hu ht.2)
        have hsu : s < u := hs2.trans_le (min_le_left _ _)
        have hs1' : s < 1 := hs2.trans_le (min_le_right _ _)
        have hlink : E0.causality.le (U ⊓ O) (δ t) (δ s) :=
          hrel t htI s ⟨ht.1.trans hs1.le, hs1'.le⟩ hl hs1 hsu
        exact lt_of_le_link_of_lt E0.causallyArcConnected (e0_pushUpOn_sector ha) hlink
          (hP s ⟨hs1, hs1'.le⟩))
  simpa [hδ0] using key

/-- **`𝔼₀` has push-up in every open set** (WP-41e SCOPE (d), discharged). -/
theorem e0_pushUp : E0.causality.PushUp :=
  Causal.Causality.pushUp_iff.2 fun _ _ _ _ => ⟨e0_lt_of_lt_of_le, e0_lt_of_le_of_lt⟩

end E0PushUp

end E0LM

end Causal

/-! ### `SingularFlatAxioms` for `E₀`: the witness of `def:singular_spacetime` with `sing₀ ≠ ∅`
(new, target `T-ett-port-e0-sfa`) -/

namespace Causal

open Set Filter Topology Function

namespace E0

section Witness

/-- **`E₀` satisfies `SingularFlatAxioms`**, with `sing₀ = axis` and `sing_α = ∅` for `α ≠ 0`
(`singE0`): gx's `singularFlatAxioms_of_pushUp` with push-up in every open set
(`E0LM.e0_pushUp`), the one field it left as a hypothesis. -/
theorem singularFlatAxioms : causality.SingularFlatAxioms singE0 :=
  singularFlatAxioms_of_pushUp E0LM.e0_pushUp

/-- The BTZ locus of `E₀` is not empty: `(0, 0) ∈ sing₀`. -/
theorem singE0_zero_nonempty : (singE0 0).Nonempty := by
  rw [singE0_zero]; exact ⟨(0, 0), rfl⟩

/-- **`E₀` is a singular flat spacetime** in the library's abstraction of
`def:singular_spacetime` (`Causality.SingularFlatSpacetime`: `SingularFlatAxioms` and
connectedness). -/
theorem singularFlatSpacetime : causality.SingularFlatSpacetime singE0 :=
  { singularFlatAxioms with connected := inferInstance }

/-- **The abstraction of `def:singular_spacetime` has a witness with `sing₀ ≠ ∅`**: `E₀`, whose
BTZ line is its singular locus. The earlier witnesses in the library, the timelike line
(`timelikeLine_singularFlatSpacetime`) and every connected T2 second-countable flat manifold
(`Causal.Flat.flat_singularFlatAxioms`), have `sing = ∅`. -/
theorem exists_singularFlatSpacetime_sing_zero_nonempty :
    ∃ (M : Type) (_ : TopologicalSpace M) (C : Causality M) (sing : ℝ → Set M),
      C.SingularFlatSpacetime sing ∧ (sing 0).Nonempty :=
  ⟨E0, inferInstance, causality, singE0, singularFlatSpacetime, singE0_zero_nonempty⟩

/-- **`E₀` is globally hyperbolic** (`def:globally_hyperbolic`, new): causal (`isCausal`), and a
diamond `J⁺(p) ∩ J⁻(q)` is closed (`isClosed_Jplus`, `isClosed_Jminus`) and lies in a ball
(`diamond_subset_ball`), hence is compact in `ℝ × ℂ`. -/
theorem globallyHyperbolic : causality.GloballyHyperbolic := by
  refine ⟨isCausal, fun p q => ?_⟩
  have hcl : IsClosed (causality.diamond ⊤ p q) := (isClosed_Jminus q).inter (isClosed_Jplus p)
  have hp : dist p p < dist q p + 1 := by rw [dist_self]; linarith [dist_nonneg (x := q) (y := p)]
  have hq : dist q p < dist q p + 1 := lt_add_one _
  exact Metric.isCompact_of_isClosed_isBounded hcl
    (Metric.isBounded_ball.subset (diamond_subset_ball hp hq))

/-! #### The abstract theorems of `Causal.SingularFlat` and `Causal.SingularGeroch` at `E₀`

Each one was witnessed on the timelike line only (no BTZ point); here at a model with a BTZ line. -/

/-- `Causality.SingularFlatAxioms.not_pastDistinguishing` (`defi:causal_E0`, l.1349–1350, the
reading of OQ-35) has an inhabitant with a BTZ point: `E₀`. -/
theorem not_pastDistinguishing_of_singularFlatAxioms : ¬ causality.PastDistinguishing :=
  singularFlatAxioms.not_pastDistinguishing singE0_zero_nonempty

/-- `cor:K_injectif` at `E₀` (`Causality.SingularFlatAxioms.K_injectif`, strong causality:
`stronglyCausal`). -/
theorem K_injectif :
    Function.Injective (fun x : E0 => causality.Kplus ⊤ {x}) ∧
      Function.Injective (fun x : E0 => causality.Kminus ⊤ {x}) :=
  singularFlatAxioms.K_injectif stronglyCausal

/-- `prop:K_densite_sing` at `E₀` (`Causality.SingularFlatAxioms.K_densite_sing`). -/
theorem K_densite_sing (x : E0) :
    causality.Jplus ⊤ {x} ⊆ closure (causality.Kplus ⊤ {x}) ∧
      causality.Jminus ⊤ {x} ⊆ closure (causality.Kminus ⊤ {x}) :=
  singularFlatAxioms.K_densite_sing x

/-- `cor:K_ordre` at `E₀` (`Causality.SingularFlatAxioms.K_ordre`, global hyperbolicity:
`globallyHyperbolic`). -/
theorem K_ordre :
    (∀ x y : E0, causality.le ⊤ x y ↔ causality.Kminus ⊤ {x} ⊆ causality.Kminus ⊤ {y}) ∧
    (∀ x y : E0, causality.le ⊤ x y ↔ causality.Kplus ⊤ {y} ⊆ causality.Kplus ⊤ {x}) ∧
    Function.Injective (fun x : E0 => causality.Kminus ⊤ {x}) ∧
    Function.Injective (fun x : E0 => causality.Kplus ⊤ {x}) :=
  singularFlatAxioms.K_ordre globallyHyperbolic

/-- `lem:past_BTZ` (b) at `E₀` (`Causality.SingularFlatAxioms.past_BTZ_b`): every causal curve of
`E₀` is its singular part, closed and in the past, followed by its regular part. -/
theorem past_BTZ_b {W : TopologicalSpace.Opens E0} {I : Set ℝ} {c : ℝ → E0}
    (hc : causality.CausalCurveIn W I c) :
    (∀ s ∈ I, ∀ s' ∈ I, s' ≤ s → c s ∈ axis → c s' ∈ axis) ∧
    c '' I = (c '' I ∩ axis) ∪ (c '' I \ axis) ∧
    IsPreconnected (c '' I ∩ axis) ∧ IsPreconnected (c '' I \ axis) ∧
    closure (c '' I ∩ axis) ∩ c '' I ⊆ c '' I ∩ axis ∧
    ∀ x ∈ c '' I ∩ axis, ∀ y ∈ c '' I \ axis, causality.le W x y := by
  have h := singularFlatAxioms.past_BTZ_b hc
  rwa [singE0_zero] at h

/-- `rem:singular_flat_spacetime_therefore` at `E₀`, what the class gives with strong causality
(`geroch_hypotheses_of_singularFlat`, and `stronglyCausal`): every hypothesis of `theo:geroch` but
the pair of admissible measures. -/
theorem geroch_hypotheses_of_singularFlat :
    TopologicalSpace.MetrizableSpace E0 ∧ LocallyCompactSpace E0 ∧ causality.Tarentin ∧
      causality.CausallyArcConnected ∧ causality.StronglyCausal ∧
      (∀ p : E0, causality.Jminus ⊤ {p} ≠ {p}) ∧ ∀ p : E0, causality.Jplus ⊤ {p} ≠ {p} := by
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := singularFlatAxioms.geroch_hypotheses_of_singularFlat
  exact ⟨h1, h2, h3, h4, stronglyCausal, h5, h6⟩

