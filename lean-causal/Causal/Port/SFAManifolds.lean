namespace Causal

open Set Filter Topology TopologicalSpace MeasureTheory

universe u

namespace SFAManifolds

/-! ### Connectedness of the massive models -/

section Connected

/-- A geodesic space is preconnected: each pair of points lies on a geodesic segment. The same
fact for metric spaces is `Causal.staticCausality.preconnectedSpace_of_geodesic`
(`Causal/LemmaKBare.lean`), outside this module's imports; this copy relaxes `MetricSpace` to
`PseudoMetricSpace`. One copy may be hoisted into `Causal/Static.lean` later. -/
theorem preconnectedSpace_of_geodesicSpace (X : Type*) [PseudoMetricSpace X] [GeodesicSpace X] :
    PreconnectedSpace X := by
  refine ⟨isPreconnected_of_forall_pair fun x _ y _ => ?_⟩
  obtain ⟨g, hg0, hg1, hg⟩ := GeodesicSpace.exists_geodesic x y
  have hL : LipschitzOnWith ⟨dist x y, dist_nonneg⟩ g (Icc 0 1) :=
    LipschitzOnWith.of_dist_le_mul fun s hs s' hs' => by
      rw [hg s hs s' hs', Real.dist_eq, mul_comm]
      rfl
  refine ⟨g '' Icc 0 1, subset_univ _, ⟨0, ⟨le_rfl, zero_le_one⟩, hg0⟩,
    ⟨1, ⟨zero_le_one, le_rfl⟩, hg1⟩, ?_⟩
  exact isPreconnected_Icc.image g hL.continuousOn

/-- `E_κ`, `κ > 0`, is connected. -/
theorem massive_connectedSpace (κ : ℝ) [Fact (0 < κ)] : ConnectedSpace (Massive κ) := by
  haveI : PreconnectedSpace (Cone κ) := preconnectedSpace_of_geodesicSpace (Cone κ)
  haveI : ConnectedSpace (Cone κ) := ⟨⟨Cone.apex⟩⟩
  exact inferInstanceAs (ConnectedSpace (ℝ × Cone κ))

end Connected

/-! ### `SingularFlatAxioms` at every `E_{≥0}`-manifold -/

section Manifold

variable {M : Type u} [TopologicalSpace M] [SingularGXStructure (Flat.isom 2) (Minkowski 2) M]
  {C : Causality M}

/-- **`SingularFlatAxioms` at every Hausdorff, second countable `E_{≥0}`-manifold**, for every
absolutely minimal causality with an isomorphic chart at each point: no field left. -/
theorem singularFlatAxioms [T2Space M] [SecondCountableTopology M] (hmin : C.AbsolutelyMinimal)
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality) :
    C.SingularFlatAxioms (SFALocal.sing M) :=
  (SFABTZ.singularFlatAxioms_iff_lines hmin hC).2 ⟨SFALine.line hC, SFAMassiveLine.massive_line hC⟩

/-- **`def:singular_spacetime`, read: a connected such `M` is a `SingularFlatSpacetime`.** -/
theorem singularFlatSpacetime [T2Space M] [SecondCountableTopology M] [ConnectedSpace M]
    (hmin : C.AbsolutelyMinimal)
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality) :
    C.SingularFlatSpacetime (SFALocal.sing M) :=
  ⟨singularFlatAxioms hmin hC, ‹ConnectedSpace M›⟩

/-- Such a `C` is a `SingularFlatSpacetime` iff `M` is connected. -/
theorem singularFlatSpacetime_iff [T2Space M] [SecondCountableTopology M]
    (hmin : C.AbsolutelyMinimal)
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality) :
    C.SingularFlatSpacetime (SFALocal.sing M) ↔ ConnectedSpace M :=
  ⟨fun h => h.connected, fun h => ⟨singularFlatAxioms hmin hC, h⟩⟩

/-- **`SingularFlatAxioms` for the natural causality** (`IsAtlasCausalityDEC25`). -/
theorem singularFlatAxioms_of_isAtlasCausalityDEC25 [T2Space M] [SecondCountableTopology M]
    (hcov : SFALocal.MassACovered M)
    (hC : IsAtlasCausalityDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality) :
    C.SingularFlatAxioms (SFALocal.sing M) :=
  singularFlatAxioms (SFALocal.of_isAtlasCausalityDEC25 hcov hC).1
    (SFALocal.of_isAtlasCausalityDEC25 hcov hC).2

/-- **A connected `E_{≥0}`-manifold with its natural causality is a `SingularFlatSpacetime`**:
`def:singular_spacetime` with `A = ℝ₊`, read through DEC-25 and OQ-18. -/
theorem singularFlatSpacetime_of_isAtlasCausalityDEC25 [T2Space M] [SecondCountableTopology M]
    [ConnectedSpace M] (hcov : SFALocal.MassACovered M)
    (hC : IsAtlasCausalityDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality) :
    C.SingularFlatSpacetime (SFALocal.sing M) :=
  ⟨singularFlatAxioms_of_isAtlasCausalityDEC25 hcov hC, ‹ConnectedSpace M›⟩

end Manifold

section Existence

variable {M : Type u} [TopologicalSpace M] [SingularGXStructure (Flat.isom 2) (Minkowski 2) M]

/-- **Every Hausdorff, second countable `E_{≥0}`-manifold carries a natural causality satisfying
`SingularFlatAxioms`**, and it is the only absolutely minimal causality with an isomorphic chart at
each point. -/
theorem exists_singularFlatAxioms [T2Space M] [SecondCountableTopology M]
    (hcov : SFALocal.MassACovered M) :
    ∃ C : Causality M, IsAtlasCausalityDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality ∧
      C.SingularFlatAxioms (SFALocal.sing M) ∧
      ∀ C' : Causality M, C'.AbsolutelyMinimal →
        IsoChartsCoverDEC25 (Flat.isom 2) C' (minkowski 2) massAModelCausality → C' = C := by
  obtain ⟨C, hC, -, huniq⟩ := EModelsBPrime.massA_causalite_models hcov
  exact ⟨C, hC, singularFlatAxioms_of_isAtlasCausalityDEC25 hcov hC, huniq⟩

/-- **Every connected, Hausdorff, second countable `E_{≥0}`-manifold carries a natural causality
making it a `SingularFlatSpacetime`**, unique as above. -/
theorem exists_singularFlatSpacetime [T2Space M] [SecondCountableTopology M] [ConnectedSpace M]
    (hcov : SFALocal.MassACovered M) :
    ∃ C : Causality M, IsAtlasCausalityDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality ∧
      C.SingularFlatSpacetime (SFALocal.sing M) ∧
      ∀ C' : Causality M, C'.AbsolutelyMinimal →
        IsoChartsCoverDEC25 (Flat.isom 2) C' (minkowski 2) massAModelCausality → C' = C := by
  obtain ⟨C, hC, hSFA, huniq⟩ := exists_singularFlatAxioms hcov
  exact ⟨C, hC, ⟨hSFA, ‹ConnectedSpace M›⟩, huniq⟩

end Existence

/-! ### Sub-families: `E₀`-manifolds and `E_{>0}`-manifolds -/

section SubFamilies

variable {M : Type u} [TopologicalSpace M] [SingularGXStructure (Flat.isom 2) (Minkowski 2) M]
  {C : Causality M}

section E0Manifolds

attribute [local instance] E0GX.singularGX

/-- **A connected, Hausdorff, second countable `E₀`-manifold with its natural causality is a
`SingularFlatSpacetime`**, out of `singularFlatSpacetime` (the `SingularFlatAxioms` form is
`SFALine.singularFlatAxioms_e0`). -/
theorem singularFlatSpacetime_e0 [T2Space M] [SecondCountableTopology M] [ConnectedSpace M]
    (hcov : SFALocalE0.E0Covered M) (hC : SFALocalE0.IsE0Natural C) :
    C.SingularFlatSpacetime (SFALocalE0.sing M) := by
  rw [← SFALocal.sing_eq_of_e0Covered hcov]
  exact singularFlatSpacetime hC.2.2 (SFALocal.isoChartsCoverDEC25_of_e0 hcov hC)

end E0Manifolds

/-- **A connected, Hausdorff, second countable `E_{>0}`-manifold is a `SingularFlatSpacetime`**
(`SFAMassiveLine.singularFlatAxioms_of_massive`). -/
theorem singularFlatSpacetime_of_massive [T2Space M] [SecondCountableTopology M] [ConnectedSpace M]
    (hmin : C.AbsolutelyMinimal)
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality)
    (hpos : ∀ x ∈ Sing (Flat.isom 2) (Minkowski 2) M, ∃ o, o ≠ none ∧
      ∃ e : OpenPartialHomeomorph M (MassAModel o), IsAEChart (Flat.isom 2) (Minkowski 2) e ∧
        x ∈ e.source) :
    C.SingularFlatSpacetime (SFALocal.sing M) :=
  ⟨SFAMassiveLine.singularFlatAxioms_of_massive hmin hC hpos, ‹ConnectedSpace M›⟩

end SubFamilies

/-! ### `prop:mesure_admissible` and `rem:singular_flat_spacetime_therefore`, unconditional -/

section Measures

variable {M : Type u} [TopologicalSpace M] [SingularGXStructure (Flat.isom 2) (Minkowski 2) M]
  [MeasurableSpace M] [BorelSpace M] {C : Causality M}

/-- **`prop:mesure_admissible` at every strongly causal, Hausdorff, second countable
`E_{≥0}`-manifold**, for every absolutely minimal causality with an isomorphic chart at each
point: no hypothesis left. -/
theorem mesure_admissible [T2Space M] [SecondCountableTopology M] (hmin : C.AbsolutelyMinimal)
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality)
    (hSC : C.StronglyCausal) :
    (∃ μ : Measure M, C.AdmissiblePast μ) ∧ ∃ μ : Measure M, C.AdmissibleFuture μ :=
  MeasuresManifolds.massA_mesure_admissible (singularFlatAxioms hmin hC) hC hSC

/-- **`rem:singular_flat_spacetime_therefore` at every strongly causal (DEC-18), Hausdorff, second
countable `E_{≥0}`-manifold**: every hypothesis of `theo:geroch`, no hypothesis left. -/
theorem geroch_hypotheses [T2Space M] [SecondCountableTopology M] (hmin : C.AbsolutelyMinimal)
    (hC : IsoChartsCoverDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality)
    (hSC : C.StronglyCausal) :
    MetrizableSpace M ∧ LocallyCompactSpace M ∧ C.Tarentin ∧ C.CausallyArcConnected ∧
      C.StronglyCausal ∧ (∀ p : M, C.Jminus ⊤ {p} ≠ {p}) ∧ (∀ p : M, C.Jplus ⊤ {p} ≠ {p}) ∧
      ∃ μp μm : Measure M, C.AdmissibleFuture μp ∧ C.AdmissiblePast μm :=
  MeasuresManifolds.massA_geroch_hypotheses (singularFlatAxioms hmin hC) hC hSC

/-- **`prop:mesure_admissible` for the natural causality**: « let `M` be a strongly causal
`E_{≥0}`-manifold » read as its natural causality being strongly causal. -/
theorem mesure_admissible_of_isAtlasCausalityDEC25 [T2Space M] [SecondCountableTopology M]
    (hcov : SFALocal.MassACovered M)
    (hC : IsAtlasCausalityDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality)
    (hSC : C.StronglyCausal) :
    (∃ μ : Measure M, C.AdmissiblePast μ) ∧ ∃ μ : Measure M, C.AdmissibleFuture μ :=
  mesure_admissible (SFALocal.of_isAtlasCausalityDEC25 hcov hC).1
    (SFALocal.of_isAtlasCausalityDEC25 hcov hC).2 hSC

/-- **`rem:singular_flat_spacetime_therefore` for the natural causality** (DEC-18). -/
theorem geroch_hypotheses_of_isAtlasCausalityDEC25 [T2Space M] [SecondCountableTopology M]
    (hcov : SFALocal.MassACovered M)
    (hC : IsAtlasCausalityDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality)
    (hSC : C.StronglyCausal) :
    MetrizableSpace M ∧ LocallyCompactSpace M ∧ C.Tarentin ∧ C.CausallyArcConnected ∧
      C.StronglyCausal ∧ (∀ p : M, C.Jminus ⊤ {p} ≠ {p}) ∧ (∀ p : M, C.Jplus ⊤ {p} ≠ {p}) ∧
      ∃ μp μm : Measure M, C.AdmissibleFuture μp ∧ C.AdmissiblePast μm :=
  geroch_hypotheses (SFALocal.of_isAtlasCausalityDEC25 hcov hC).1
    (SFALocal.of_isAtlasCausalityDEC25 hcov hC).2 hSC

end Measures

end SFAManifolds

