/-! ### Witnesses (kb/0011): `E₀` and `E_π` -/

section WitnessE0

attribute [local instance] E0GX.singularGX

/-- **Non-vacuity at `E₀`** (`sing₀ = axis ≠ ∅`): the hypotheses of `singularFlatSpacetime` and
`geroch_hypotheses` hold, `E₀` is a `SingularFlatSpacetime` out of `singularFlatSpacetime`, and
the measures come out of `mesure_admissible`. -/
theorem nonvacuous_e0 :
    E0.causality.AbsolutelyMinimal ∧
      IsoChartsCoverDEC25 (Flat.isom 2) E0.causality (minkowski 2) massAModelCausality ∧
      SFALocal.sing E0 0 = E0.axis ∧ (SFALocal.sing E0 0).Nonempty ∧
      E0.causality.SingularFlatSpacetime (SFALocal.sing E0) ∧ E0.causality.StronglyCausal ∧
      ((∃ μ : Measure E0, E0.causality.AdmissiblePast μ) ∧
        ∃ μ : Measure E0, E0.causality.AdmissibleFuture μ) := by
  obtain ⟨hmin, hC, h0, hne⟩ := SFALocal.nonvacuous_e0
  exact ⟨hmin, hC, h0, hne, singularFlatSpacetime hmin hC, E0.stronglyCausal,
    mesure_admissible hmin hC E0.stronglyCausal⟩

/-- **Non-vacuity of the natural forms at `E₀`**: `E₀` is an `E_{≥0}`-manifold whose natural
causality is `E0.causality`, a `SingularFlatSpacetime` out of
`singularFlatSpacetime_of_isAtlasCausalityDEC25`. -/
theorem nonvacuous_e0_natural :
    SFALocal.MassACovered E0 ∧
      IsAtlasCausalityDEC25 (Flat.isom 2) E0.causality (minkowski 2) massAModelCausality ∧
      (SFALocal.sing E0 0).Nonempty ∧
      E0.causality.SingularFlatSpacetime (SFALocal.sing E0) ∧
      ((∃ μ : Measure E0, E0.causality.AdmissiblePast μ) ∧
        ∃ μ : Measure E0, E0.causality.AdmissibleFuture μ) := by
  obtain ⟨-, hcov, hC, -⟩ := EModelsBPrime.massA_dec25_models_e0_sing
  obtain ⟨-, -, -, hne⟩ := SFALocal.nonvacuous_e0
  exact ⟨hcov, hC, hne, singularFlatSpacetime_of_isAtlasCausalityDEC25 hcov hC,
    mesure_admissible_of_isAtlasCausalityDEC25 hcov hC E0.stronglyCausal⟩

/-- **Non-vacuity of the `E₀`-manifold forms**: `E₀` with its natural causality as an
`E₀`-manifold, a `SingularFlatSpacetime` out of `singularFlatSpacetime_e0`, with the conclusions
of `e0Manifold_mesure_admissible_natural` and `e0Manifold_geroch_hypotheses_natural`. -/
theorem nonvacuous_e0Manifold :
    SFALocalE0.E0Covered E0 ∧ SFALocalE0.IsE0Natural E0.causality ∧
      (SFALocalE0.sing E0 0).Nonempty ∧
      E0.causality.SingularFlatSpacetime (SFALocalE0.sing E0) ∧
      ((∃ μ : Measure E0, E0.causality.AdmissiblePast μ) ∧
        ∃ μ : Measure E0, E0.causality.AdmissibleFuture μ) ∧
      ∃ μp μm : Measure E0, E0.causality.AdmissibleFuture μp ∧ E0.causality.AdmissiblePast μm := by
  obtain ⟨hcov, hC, -, hne⟩ := SFALocalE0.nonvacuous
  exact ⟨hcov, hC, hne, singularFlatSpacetime_e0 hcov hC,
    MeasuresManifolds.e0Manifold_mesure_admissible_natural hcov hC E0.stronglyCausal,
    (MeasuresManifolds.e0Manifold_geroch_hypotheses_natural hcov hC E0.stronglyCausal).2.2.2.2.2.2.2⟩

/-- **`rem:singular_flat_spacetime_therefore` at `E₀`**, out of `geroch_hypotheses`: every
hypothesis of `theo:geroch`, with a BTZ line. -/
theorem nonvacuous_e0_geroch :
    MetrizableSpace E0 ∧ LocallyCompactSpace E0 ∧ E0.causality.Tarentin ∧
      E0.causality.CausallyArcConnected ∧ E0.causality.StronglyCausal ∧
      (∀ p : E0, E0.causality.Jminus ⊤ {p} ≠ {p}) ∧ (∀ p : E0, E0.causality.Jplus ⊤ {p} ≠ {p}) ∧
      ∃ μp μm : Measure E0, E0.causality.AdmissibleFuture μp ∧ E0.causality.AdmissiblePast μm := by
  obtain ⟨hmin, hC, -⟩ := SFALocal.nonvacuous_e0
  exact geroch_hypotheses hmin hC E0.stronglyCausal

end WitnessE0

