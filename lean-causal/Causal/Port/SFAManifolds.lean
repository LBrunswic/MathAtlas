  exact ⟨hcov, hnat, singularFlatSpacetime_of_massive hmin hC SFAMassiveLine.epi_hpos⟩

/-- **`rem:singular_flat_spacetime_therefore` at `E_π`**, out of `geroch_hypotheses`: every
hypothesis of `theo:geroch`, with a non-empty massive line. -/
