namespace Causal

open Set Filter Topology TopologicalSpace Function

universe u v w

/-! ### `E₀`: the holonomy, the sector atlas, the singular structure -/

namespace E0GX

open E0 Complex
open scoped Real

/-! #### The shift of the developing angle, an isometry of `𝐌³` -/

/-- **The shift `θ ↦ θ + s` of the developing angle, in null coordinates**:
`(a, b, c) ↦ (a − 2sc + s²b, b, c − sb)` (`lift_add_angle`). -/
noncomputable def angleShift (s : ℝ) : (ℝ × ℝ × ℝ) ≃ₗ[ℝ] (ℝ × ℝ × ℝ) where
  toFun y := (y.1 - 2 * s * y.2.2 + s ^ 2 * y.2.1, y.2.1, y.2.2 - s * y.2.1)
  invFun y := (y.1 + 2 * s * y.2.2 + s ^ 2 * y.2.1, y.2.1, y.2.2 + s * y.2.1)
  map_add' y y' := by ext <;> simp <;> ring
  map_smul' c y := by ext <;> simp <;> ring
  left_inv y := by ext <;> simp; ring
  right_inv y := by ext <;> simp; ring

theorem angleShift_apply (s : ℝ) (y : ℝ × ℝ × ℝ) :
    angleShift s y = (y.1 - 2 * s * y.2.2 + s ^ 2 * y.2.1, y.2.1, y.2.2 - s * y.2.1) := rfl

theorem angleShift_angleShift (s t : ℝ) (y : ℝ × ℝ × ℝ) :
    angleShift s (angleShift t y) = angleShift (s + t) y := by
  simp only [angleShift_apply]
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp <;> ring

/-- The development with angle `θ + s` is the angle shift of the development with angle `θ`. -/
theorem lift_add_angle (x : E0) (θ s : ℝ) : lift x (θ + s) = angleShift s (lift x θ) := by
  have h : ∀ φ : ℝ, E0.lift x φ = (2 * x.1 + rad x * φ ^ 2 - rad x, rad x, -(rad x * φ)) :=
    fun φ => by unfold E0.lift E0.btzPaperNull; rfl
  rw [h, h, angleShift_apply]
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp <;> ring

/-- The angle shift in Minkowski coordinates. -/
noncomputable def holLin (s : ℝ) : Minkowski 2 ≃ₗ[ℝ] Minkowski 2 :=
  (nullToMink.symm.trans (angleShift s)).trans nullToMink

theorem holLin_apply (s : ℝ) (v : Minkowski 2) :
    holLin s v = nullToMink (angleShift s (nullToMink.symm v)) := rfl

theorem holLin_mem_lorentz (s : ℝ) : holLin s ∈ Flat.lorentz 2 := by
  have hQ : ∀ v, Flat.minkQ (holLin s v) = Flat.minkQ v := fun v => by
    rw [holLin_apply, minkQ_nullToMink]
    conv_rhs => rw [← nullToMink.apply_symm_apply v, minkQ_nullToMink]
    simp only [angleShift_apply]
    ring
  have h0 : 0 < (holLin s (Flat.timeUnit 2)).1 := by
    have : (holLin s (Flat.timeUnit 2)).1 = (2 + s ^ 2) / 2 := by
      have e : nullToMink.symm (Flat.timeUnit 2) = (1, 1, 0) := by
        show ((1 : ℝ) + (0 : EuclideanSpace ℝ (Fin 2)) 0, (1 : ℝ) - (0 : EuclideanSpace ℝ (Fin 2)) 0,
          (0 : EuclideanSpace ℝ (Fin 2)) 1) = (1, 1, 0)
        simp
      rw [holLin_apply, nullToMink_apply, e, angleShift_apply]
      simp only
      ring
    rw [this]; positivity
  refine Flat.mem_lorentz_of hQ h0 (Flat.det_eq_one_of_eq_sq (B := holLin (s / 2)) hQ ?_)
  refine LinearMap.ext fun v => ?_
  show holLin s v = holLin (s / 2) (holLin (s / 2) v)
  rw [holLin_apply, holLin_apply, holLin_apply, LinearEquiv.symm_apply_apply,
    angleShift_angleShift, add_halves]

/-- **The holonomy family**: the angle shift by `s` as an isometry of `𝐌³`; `hol (2π)` is the
holonomy of a loop about the axis. -/
noncomputable def hol (s : ℝ) : Flat.isom 2 :=
  ⟨(holLin s).toAffineEquiv, holLin_mem_lorentz s⟩

theorem hol_smul (s : ℝ) (v : Minkowski 2) : hol s • v = holLin s v := rfl

theorem hol_smul_nullToMink (s : ℝ) (y : ℝ × ℝ × ℝ) :
    hol s • nullToMink y = nullToMink (angleShift s y) := by
  rw [hol_smul, holLin_apply, LinearEquiv.symm_apply_apply]

theorem hol_add (s t : ℝ) : hol (s + t) = hol s * hol t := by
  refine Subtype.ext (AffineEquiv.ext fun v => ?_)
  show hol (s + t) • v = (hol s * hol t) • v
  rw [mul_smul, hol_smul, hol_smul, hol_smul, holLin_apply, holLin_apply, holLin_apply,
    LinearEquiv.symm_apply_apply, angleShift_angleShift]

theorem hol_zero : hol 0 = 1 := by
  refine Subtype.ext (AffineEquiv.ext fun v => ?_)
  show hol 0 • v = (1 : Flat.isom 2) • v
  rw [one_smul, hol_smul, holLin_apply]
  have : ∀ y : ℝ × ℝ × ℝ, angleShift 0 y = y := fun y => by
    simp only [angleShift_apply]
    refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp
  rw [this, LinearEquiv.apply_symm_apply]

/-- `hol (2πk)` is the `k`-th power of the holonomy `hol (2π)`. -/
theorem hol_two_pi_mul_int (k : ℤ) : hol (2 * π * k) = hol (2 * π) ^ k := by
  induction k using Int.induction_on with
  | zero => simp [hol_zero]
  | succ n ih =>
    rw [zpow_add_one, ← ih, ← hol_add]
    congr 1
    push_cast; ring
  | pred n ih =>
    rw [zpow_sub_one, ← ih, eq_mul_inv_iff_mul_eq, ← hol_add]
    congr 1
    push_cast; ring

/-- The holonomy of a loop about the axis moves a point of `𝐌³`. -/
theorem hol_two_pi_smul_ne : hol (2 * π) • nullToMink (0, 1, 0) ≠ nullToMink (0, 1, 0) := by
  rw [hol_smul_nullToMink]
  intro h
  have h1 := congrArg Prod.fst (nullToMink.injective h)
  simp only [angleShift_apply] at h1
  have : (2 * π) ^ 2 = 0 := by linarith
  exact Real.pi_ne_zero (by nlinarith [Real.pi_pos])

theorem holLin_two_pi_ne_one : holLin (2 * π) ≠ 1 := fun h =>
  hol_two_pi_smul_ne (by rw [hol_smul, h]; rfl)

/-- **The holonomy of a loop about the axis is parabolic** (`Causal.Flat.IsParabolic`): its linear
part is a non-trivial unipotent element of `SO₀(1,2)`, `(A − 1)³ = 0`. -/
theorem isParabolic_holLin_two_pi : Flat.IsParabolic (holLin (2 * π)) := by
  refine Flat.IsUnipotent.isParabolic (holLin_mem_lorentz _) ⟨3, ?_⟩ holLin_two_pi_ne_one
  have hp : ∀ v, Flat.pOf (holLin (2 * π)) v =
      nullToMink (angleShift (2 * π) (nullToMink.symm v) - nullToMink.symm v) := fun v => by
    rw [Flat.pOf_apply, holLin_apply, map_sub, LinearEquiv.apply_symm_apply]
  refine LinearMap.ext fun v => ?_
  rw [pow_succ, pow_succ, pow_one, Module.End.mul_apply, Module.End.mul_apply, hp, hp, hp,
    LinearEquiv.symm_apply_apply, LinearEquiv.symm_apply_apply, LinearMap.zero_apply,
    ← map_zero nullToMink]
  congr 1
  simp only [angleShift_apply]
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp

/-- **Two sector charts differ by the holonomy of the angle shift**: if `angle y' w = angle y w + s`
then `chartMap y' w = hol s • chartMap y w`. -/
theorem chartMap_eq_hol_smul {y y' w : E0} {s : ℝ} (h : angle y' w = angle y w + s) :
    chartMap y' w = hol s • chartMap y w := by
  show nullToMink (lift w (angle y' w)) = hol s • nullToMink (lift w (angle y w))
  rw [h, lift_add_angle, hol_smul_nullToMink]

/-! #### The sector atlas -/

/-- **The sector atlas of `E₀`**: the sector charts of the points off the axis. -/
def sectorAtlas : Set (OpenPartialHomeomorph E0 (Minkowski 2)) :=
  {e | ∃ (y : E0) (hy : y.2 ≠ 0), e = sectorChart y hy}

theorem sectorChart_mem_sectorAtlas {y : E0} (hy : y.2 ≠ 0) : sectorChart y hy ∈ sectorAtlas :=
  ⟨y, hy, rfl⟩

/-- The support of the sector atlas is `E₀ ∖ sing₀`. -/
theorem support_sectorAtlas : support sectorAtlas = axisᶜ := by
  ext x
  rw [mem_support, mem_compl_iff]
  constructor
  · rintro ⟨e, ⟨y, hy, rfl⟩, hx⟩
    exact not_mem_axis_of_mem_sector hx
  · intro hx
    exact ⟨sectorChart x hx, sectorChart_mem_sectorAtlas hx, mem_sector_self hx⟩

/-- **Near every point of their overlap, two sector charts differ by a power of the holonomy.** -/
theorem sectorChart_eventually_eq_zpow_smul {y y' : E0} (hy : y.2 ≠ 0) (hy' : y'.2 ≠ 0) {x : E0}
    (hx : x ∈ sector y) (hx' : x ∈ sector y') :
    ∃ k : ℤ, ∀ᶠ w in 𝓝 x, sectorChart y' hy' w = hol (2 * π) ^ k • sectorChart y hy w := by
  have hx0 : x.2 ≠ 0 := ne_zero_of_mem_sector hx
  obtain ⟨k₀, hk₀⟩ := (polar_angle hy x).eq_add_int (polar_angle hy' x) (rad_pos.2 hx0)
  have hc : ContinuousAt (fun w => angle y' w - angle y w) x :=
    ((continuousOn_angle y').continuousAt ((isOpen_sector y').mem_nhds hx')).sub
      ((continuousOn_angle y).continuousAt ((isOpen_sector y).mem_nhds hx))
  have hev : ∀ᶠ w in 𝓝 x,
      |(angle y' w - angle y w) - (angle y' x - angle y x)| < 2 * π := by
    have := hc.eventually (Metric.ball_mem_nhds (angle y' x - angle y x)
      (by positivity : (0 : ℝ) < 2 * π))
    filter_upwards [this] with w hw
    rw [Real.dist_eq] at hw
    exact hw
  refine ⟨k₀, ?_⟩
  filter_upwards [hev, (isOpen_sector y).mem_nhds hx] with w hw hws
  have hw0 : w.2 ≠ 0 := ne_zero_of_mem_sector hws
  obtain ⟨k, hk⟩ := (polar_angle hy w).eq_add_int (polar_angle hy' w) (rad_pos.2 hw0)
  have hkk : k = k₀ := by
    rw [hk, hk₀] at hw
    have h1 : |2 * π * ((k : ℝ) - k₀)| < 2 * π := by
      have e : angle y w + 2 * π * k - angle y w - (angle y x + 2 * π * k₀ - angle y x) =
          2 * π * ((k : ℝ) - k₀) := by ring
      rwa [e] at hw
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * π)] at h1
    have h2 : |((k : ℝ) - k₀)| < 1 := by
      have := Real.pi_pos
      by_contra hc'
      push Not at hc'
      nlinarith
    have h3 : |((k - k₀ : ℤ) : ℝ)| < 1 := by push_cast; exact h2
    have h4 : |(k - k₀ : ℤ)| < 1 := by exact_mod_cast h3
    rw [abs_lt] at h4
    omega
  show chartMap y' w = hol (2 * π) ^ k₀ • chartMap y w
  rw [← hol_two_pi_mul_int, chartMap_eq_hol_smul (hkk ▸ hk)]

theorem isGXAtlas_sectorAtlas : IsGXAtlas (Flat.isom 2) sectorAtlas := by
  refine isGXAtlas_of_eventually fun e he e' he' x hx => ?_
  obtain ⟨y, hy, rfl⟩ := he
  obtain ⟨y', hy', rfl⟩ := he'
  obtain ⟨k, hk⟩ := sectorChart_eventually_eq_zpow_smul hy hy' hx.1 hx.2
  exact ⟨_, hk⟩

/-- **On each connected component of an overlap, two sector charts differ by one power of the
parabolic holonomy** `hol (2π)` (`isParabolic_holLin_two_pi`). -/
theorem sectorChart_eq_zpow_smul_on_component {y y' : E0} (hy : y.2 ≠ 0) (hy' : y'.2 ≠ 0)
    {x : E0} (hx : x ∈ sector y) (hx' : x ∈ sector y') :
    ∃ k : ℤ, ∀ w ∈ connectedComponentIn (sector y ∩ sector y') x,
      sectorChart y' hy' w = hol (2 * π) ^ k • sectorChart y hy w := by
  obtain ⟨g, hg⟩ := isGXAtlas_sectorAtlas _ (sectorChart_mem_sectorAtlas hy) _
    (sectorChart_mem_sectorAtlas hy') x ⟨hx, hx'⟩
  obtain ⟨k, hk⟩ := sectorChart_eventually_eq_zpow_smul hy hy' hx hx'
  have hC : IsOpen (connectedComponentIn (sector y ∩ sector y') x) :=
    ((isOpen_sector y).inter (isOpen_sector y')).connectedComponentIn
  obtain ⟨t, ht, hto, hxt⟩ :=
    mem_nhds_iff.1 (hk.and (hC.mem_nhds (mem_connectedComponentIn ⟨hx, hx'⟩)))
  have hts : t ⊆ (sectorChart y hy).source := fun w hw =>
    (connectedComponentIn_subset _ _ (ht hw).2).1
  have hr : ∀ m : Minkowski 2, g • m = hol (2 * π) ^ k • m := by
    refine IsRigidAction.smul_eq_of_eqOn
      ((sectorChart y hy).isOpen_image_of_subset_source hto hts) ⟨_, x, hxt, rfl⟩ ?_
    rintro _ ⟨w, hw, rfl⟩
    show g • sectorChart y hy w = hol (2 * π) ^ k • sectorChart y hy w
    rw [← hg w (ht hw).2, (ht hw).1]
  exact ⟨k, fun w hw => by rw [hg w hw, hr]⟩

/-- Deprecated: moved to `Causal.isPreconnected_ball_diff_zero` (`Causal.MaximalAEAtlasIso`,
T-ett-maxatlas-hoist). -/
@[deprecated Causal.isPreconnected_ball_diff_zero (since := "2026-11-21")]
theorem isPreconnected_ball_diff_zero (ε : ℝ) :
    IsPreconnected (Metric.ball (0 : ℂ) ε \ {0}) :=
  Causal.isPreconnected_ball_diff_zero ε

/-- Deprecated: moved to `Causal.isPortly_ne_zero` (`Causal.MaximalAEAtlasIso`,
T-ett-maxatlas-hoist). -/
@[deprecated Causal.isPortly_ne_zero (since := "2026-11-21")]
theorem isPortly_ne_zero : IsPortly {x : ℂ × ℝ | x.1 ≠ 0} :=
  Causal.isPortly_ne_zero

/-- **`E₀ ∖ sing₀` is portly**: open, dense, and removing the axis from a connected open set leaves
it connected. -/
theorem isPortly_compl_axis : IsPortly axisᶜ := by
  have h := Causal.isPortly_ne_zero.image_of_isOpenMap (Homeomorph.prodComm ℂ ℝ).continuous
    (Homeomorph.prodComm ℂ ℝ).isOpenMap (Homeomorph.prodComm ℂ ℝ).surjective
  convert h using 1
  ext x
  constructor
  · intro hx
    exact ⟨(x.2, x.1), hx, rfl⟩
  · rintro ⟨y, hy, rfl⟩
    exact hy

/-- **The sector charts form an a.e. `(Isom(𝐌³), 𝐌³)`-atlas of `E₀`.** -/
theorem isAEAtlas_sectorAtlas : IsAEAtlas (Flat.isom 2) sectorAtlas :=
  ⟨isGXAtlas_sectorAtlas, by rw [support_sectorAtlas]; exact isPortly_compl_axis⟩

/-! #### The singular structure -/

/-- **`E₀` as a singular `(Isom(𝐌³), 𝐌³)`-manifold** (DEC-25): the maximal a.e. atlas of its
sector atlas. -/
noncomputable abbrev singularGX : SingularGXStructure (Flat.isom 2) (Minkowski 2) E0 :=
  ⟨maximalAEAtlas (Flat.isom 2) sectorAtlas, isAEAtlas_sectorAtlas.isMaximalAEAtlas_maximalAEAtlas⟩

attribute [local instance] singularGX

theorem aeAtlas_eq :
    aeAtlas (Flat.isom 2) (Minkowski 2) E0 = maximalAEAtlas (Flat.isom 2) sectorAtlas := rfl

theorem sectorAtlas_subset_aeAtlas : sectorAtlas ⊆ aeAtlas (Flat.isom 2) (Minkowski 2) E0 :=
  isAEAtlas_sectorAtlas.subset_maximalAEAtlas

/-- **No chart of the maximal a.e. atlas reaches the axis**: on a punctured neighbourhood of an
axis point such a chart would be one translate of each of two sector charts, which differ by the
holonomy `hol (2π)` on one half of it and agree on the other. -/
theorem source_inter_axis_eq_empty {e : OpenPartialHomeomorph E0 (Minkowski 2)}
    (he : e ∈ aeAtlas (Flat.isom 2) (Minkowski 2) E0) : e.source ∩ axis = ∅ := by
  refine eq_empty_iff_forall_notMem.2 fun p hp => ?_
  obtain ⟨hpe, hpa⟩ := hp
  have hp0 : p.2 = 0 := hpa
  have hM : IsGXAtlas (Flat.isom 2) (aeAtlas (Flat.isom 2) (Minkowski 2) E0) :=
    (isMaximalAEAtlas_aeAtlas (Flat.isom 2) (Minkowski 2) E0).1.1
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 e.open_source p hpe
  have hy₁ : ((0 : ℝ), (1 : ℂ)).2 ≠ 0 := one_ne_zero
  have hy₂ : ((0 : ℝ), (-1 : ℂ)).2 ≠ 0 := neg_ne_zero.2 one_ne_zero
  have hc₁ := sectorAtlas_subset_aeAtlas (sectorChart_mem_sectorAtlas hy₁)
  have hc₂ := sectorAtlas_subset_aeAtlas (sectorChart_mem_sectorAtlas hy₂)
  -- the box `ball p.1 ε × ball 0 ε` lies in the source of `e`
  have hbox : ∀ w : E0, w.1 ∈ Metric.ball p.1 ε → w.2 ∈ Metric.ball (0 : ℂ) ε →
      w ∈ e.source := by
    intro w h1 h2
    have : w ∈ Metric.ball (p.1, p.2) ε := by
      rw [← ball_prod_same]; exact ⟨h1, by rw [hp0]; exact h2⟩
    exact hball this
  -- the two slit discs, preconnected
  set D₁ : Set ℂ := Metric.ball (0 : ℂ) ε ∩ Complex.slitPlane with hD₁def
  set D₂ : Set ℂ := Metric.ball (0 : ℂ) ε ∩ {z | -z ∈ Complex.slitPlane} with hD₂def
  have hmid : ((ε / 2 : ℝ) : ℂ) ∈ D₁ := by
    refine ⟨?_, Complex.ofReal_mem_slitPlane.2 (by positivity)⟩
    rw [mem_ball_zero_iff, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
    linarith
  have hD₁ : IsPreconnected D₁ :=
    ((((convex_ball (0 : ℂ) ε).starConvex hmid.1).inter
      (Complex.starConvex_ofReal_slitPlane (by positivity))).isPathConnected
      hmid).isConnected.isPreconnected
  have hD₂ : IsPreconnected D₂ := by
    have h : D₂ = (Homeomorph.neg ℂ) ⁻¹' D₁ := by
      ext z
      simp only [hD₁def, hD₂def, mem_inter_iff, mem_setOf_eq, mem_preimage, mem_ball_zero_iff]
      show ‖z‖ < ε ∧ -z ∈ Complex.slitPlane ↔ ‖-z‖ < ε ∧ -z ∈ Complex.slitPlane
      rw [norm_neg]
    rw [h, (Homeomorph.neg ℂ).isPreconnected_preimage]
    exact hD₁
  set T₁ : Set E0 := Metric.ball p.1 ε ×ˢ D₁ with hT₁def
  set T₂ : Set E0 := Metric.ball p.1 ε ×ˢ D₂ with hT₂def
  have hT₁ : IsPreconnected T₁ := (convex_ball p.1 ε).isPreconnected.prod hD₁
  have hT₂ : IsPreconnected T₂ := (convex_ball p.1 ε).isPreconnected.prod hD₂
  have hT₁s : T₁ ⊆ e.source ∩ (sectorChart _ hy₁).source := fun w hw =>
    ⟨hbox w hw.1 hw.2.1, by
      show w.2 / 1 ∈ Complex.slitPlane
      rw [div_one]; exact hw.2.2⟩
  have hT₂s : T₂ ⊆ e.source ∩ (sectorChart _ hy₂).source := fun w hw =>
    ⟨hbox w hw.1 hw.2.1, by
      show w.2 / -1 ∈ Complex.slitPlane
      rw [div_neg, div_one]; exact hw.2.2⟩
  -- the two open half-boxes
  set U₁ : Set E0 := Metric.ball p.1 ε ×ˢ (Metric.ball (0 : ℂ) ε ∩ {z | 0 < z.im}) with hU₁def
  set U₂ : Set E0 := Metric.ball p.1 ε ×ˢ (Metric.ball (0 : ℂ) ε ∩ {z | z.im < 0}) with hU₂def
  have hU₁T : U₁ ⊆ T₁ ∩ T₂ := fun w hw =>
    ⟨⟨hw.1, hw.2.1, Complex.mem_slitPlane_iff.2 (Or.inr hw.2.2.ne')⟩,
      ⟨hw.1, hw.2.1, Complex.mem_slitPlane_iff.2 (Or.inr (by
        rw [Complex.neg_im]; exact neg_ne_zero.2 hw.2.2.ne'))⟩⟩
  have hU₂T : U₂ ⊆ T₁ ∩ T₂ := fun w hw =>
    ⟨⟨hw.1, hw.2.1, Complex.mem_slitPlane_iff.2 (Or.inr hw.2.2.ne)⟩,
      ⟨hw.1, hw.2.1, Complex.mem_slitPlane_iff.2 (Or.inr (by
        rw [Complex.neg_im]; exact neg_ne_zero.2 hw.2.2.ne))⟩⟩
  have hU₁o : IsOpen U₁ :=
    Metric.isOpen_ball.prod (Metric.isOpen_ball.inter (isOpen_lt continuous_const
      Complex.continuous_im))
  have hU₂o : IsOpen U₂ :=
    Metric.isOpen_ball.prod (Metric.isOpen_ball.inter (isOpen_lt Complex.continuous_im
      continuous_const))
  have hnorm : ‖((ε / 2 : ℝ) : ℂ) * Complex.I‖ < ε := by
    rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
    linarith
  have hnorm' : ‖-(((ε / 2 : ℝ) : ℂ) * Complex.I)‖ < ε := by rw [norm_neg]; exact hnorm
  have hq₁ : ((p.1, ((ε / 2 : ℝ) : ℂ) * Complex.I) : E0) ∈ U₁ :=
    ⟨Metric.mem_ball_self hε, mem_ball_zero_iff.2 hnorm, by
      show 0 < (((ε / 2 : ℝ) : ℂ) * Complex.I).im
      simp only [Complex.mul_im, Complex.ofReal_re, Complex.I_im, Complex.ofReal_im,
        Complex.I_re, mul_zero, add_zero, mul_one]
      positivity⟩
  have hq₂ : ((p.1, -(((ε / 2 : ℝ) : ℂ) * Complex.I)) : E0) ∈ U₂ :=
    ⟨Metric.mem_ball_self hε, mem_ball_zero_iff.2 hnorm', by
      show (-(((ε / 2 : ℝ) : ℂ) * Complex.I)).im < 0
      simp only [Complex.neg_im, Complex.mul_im, Complex.ofReal_re, Complex.I_im,
        Complex.ofReal_im, Complex.I_re, mul_zero, add_zero, mul_one, neg_lt_zero]
      positivity⟩
  -- `e` is one translate of each sector chart on the corresponding slit box
  obtain ⟨g₁, hg₁⟩ := hM e he _ hc₁ _ (hT₁s (hU₁T hq₁).1)
  obtain ⟨g₂, hg₂⟩ := hM e he _ hc₂ _ (hT₂s (hU₁T hq₁).2)
  have hg₁' : ∀ w ∈ T₁, sectorChart _ hy₁ w = g₁ • e w := fun w hw =>
    hg₁ w (hT₁.subset_connectedComponentIn (hU₁T hq₁).1 hT₁s hw)
  have hg₂' : ∀ w ∈ T₂, sectorChart _ hy₂ w = g₂ • e w := fun w hw =>
    hg₂ w (hT₂.subset_connectedComponentIn (hU₁T hq₁).2 hT₂s hw)
  -- the two sector charts agree on the upper half and differ by `hol (2π)` on the lower one
  have hang₁ : ∀ w : E0, angle ((0 : ℝ), (1 : ℂ)) w = Complex.arg w.2 := fun w => by
    show Complex.arg (1 : ℂ) + Complex.arg (w.2 / 1) = Complex.arg w.2
    rw [Complex.arg_one, div_one, zero_add]
  have hang₂ : ∀ w : E0, angle ((0 : ℝ), (-1 : ℂ)) w = π + Complex.arg (-w.2) := fun w => by
    show Complex.arg (-1 : ℂ) + Complex.arg (w.2 / -1) = π + Complex.arg (-w.2)
    rw [Complex.arg_neg_one, div_neg, div_one]
  have hU₁ : ∀ w ∈ U₁, sectorChart _ hy₂ w = sectorChart _ hy₁ w := fun w hw => by
    have h : angle ((0 : ℝ), (-1 : ℂ)) w = angle ((0 : ℝ), (1 : ℂ)) w + 0 := by
      rw [hang₁, hang₂, Complex.arg_neg_eq_arg_sub_pi_of_im_pos hw.2.2]; ring
    show chartMap _ w = chartMap _ w
    rw [chartMap_eq_hol_smul h, hol_zero, one_smul]
  have hU₂ : ∀ w ∈ U₂, sectorChart _ hy₂ w = hol (2 * π) • sectorChart _ hy₁ w := fun w hw => by
    have h : angle ((0 : ℝ), (-1 : ℂ)) w = angle ((0 : ℝ), (1 : ℂ)) w + 2 * π := by
      rw [hang₁, hang₂, Complex.arg_neg_eq_arg_add_pi_of_im_neg hw.2.2]; ring
    exact chartMap_eq_hol_smul h
  -- rigidity on the images of the half-boxes
  have hU₁e : U₁ ⊆ e.source := fun w hw => (hT₁s (hU₁T hw).1).1
  have hU₂e : U₂ ⊆ e.source := fun w hw => (hT₁s (hU₂T hw).1).1
  have hr₁ : ∀ m : Minkowski 2, g₂ • m = g₁ • m := by
    refine IsRigidAction.smul_eq_of_eqOn (e.isOpen_image_of_subset_source hU₁o hU₁e)
      ⟨_, _, hq₁, rfl⟩ ?_
    rintro _ ⟨w, hw, rfl⟩
    show g₂ • e w = g₁ • e w
    rw [← hg₂' w (hU₁T hw).2, ← hg₁' w (hU₁T hw).1, hU₁ w hw]
  have hr₂ : ∀ m : Minkowski 2, g₂ • m = (hol (2 * π) * g₁) • m := by
    refine IsRigidAction.smul_eq_of_eqOn (e.isOpen_image_of_subset_source hU₂o hU₂e)
      ⟨_, _, hq₂, rfl⟩ ?_
    rintro _ ⟨w, hw, rfl⟩
    show g₂ • e w = (hol (2 * π) * g₁) • e w
    rw [mul_smul, ← hg₂' w (hU₂T hw).2, ← hg₁' w (hU₂T hw).1, hU₂ w hw]
  apply hol_two_pi_smul_ne
  have h := (hr₂ (g₁⁻¹ • nullToMink (0, 1, 0))).symm.trans (hr₁ (g₁⁻¹ • nullToMink (0, 1, 0)))
  rwa [mul_smul, smul_inv_smul] at h

/-- **`Reg(E₀) = E₀ ∖ sing₀`.** -/
theorem reg_eq : Reg (Flat.isom 2) (Minkowski 2) E0 = axisᶜ := by
  refine Subset.antisymm (fun x hx hxa => ?_) ?_
  · obtain ⟨e, he, hxe⟩ := mem_support.1 hx
    exact eq_empty_iff_forall_notMem.1 (source_inter_axis_eq_empty he) x ⟨hxe, hxa⟩
  · rw [← support_sectorAtlas]
    exact support_mono sectorAtlas_subset_aeAtlas

/-- **`Sing(E₀) = sing₀`**, the BTZ line. -/
theorem sing_eq : Sing (Flat.isom 2) (Minkowski 2) E0 = axis := by
  rw [Sing, reg_eq, compl_compl]

theorem sing_eq_singE0_zero : Sing (Flat.isom 2) (Minkowski 2) E0 = singE0 0 := by
  rw [sing_eq, singE0_zero]

theorem sing_nonempty : (Sing (Flat.isom 2) (Minkowski 2) E0).Nonempty := by
  rw [sing_eq]
  exact ⟨(0, 0), rfl⟩

/-- **`hreg` at `κ = 0`, DEC-25's form**: every chart of the maximal a.e. atlas of `E₀` is a chart
isomorphism `E0.causality → minkowski 2` (the model-free lemma, at `E₀`). -/
theorem chartIso_of_mem_aeAtlas :
    ∀ r ∈ aeAtlas (Flat.isom 2) (Minkowski 2) E0, ChartIso E0.causality (minkowski 2) r :=
  forall_chartIso_aeAtlas_of_reg_subset minkowski_causallyArcConnected.absolutelyMinimalOn_all
    Flat.isom_strongMorphism isAEAtlas_sectorAtlas
    (by rintro a ⟨y, hy, rfl⟩; exact chartIso_sectorChart hy) E0.absolutelyMinimalOn aeAtlas_eq
    (by rw [reg_eq, support_sectorAtlas])

/-- (b′) of `existsUnique_causality_singularGX_dec25` at `E₀`, **at regular sources**: an a.e.
isomorphism chart `ψ : E₀ ⇀ E₀` whose source avoids the axis is a chart isomorphism of
`E0.causality` (`chartIso_model_of_subset_reg` at the single model `E₀`, from `hreg`). -/
theorem chartIso_of_isAEChart_of_subset_compl_axis {ψ : OpenPartialHomeomorph E0 E0}
    (hψ : IsAEChart (Flat.isom 2) (Minkowski 2) ψ) (hsub : ψ.source ⊆ axisᶜ) :
    ChartIso E0.causality E0.causality ψ :=
  chartIso_model_of_subset_reg (Xα := fun _ : Unit => E0) (a := ()) (b := ()) (minkowski 2)
    (fun _ => E0.causality) Flat.isom_strongMorphism (fun _ => E0.causallyArcConnected)
    (fun _ => chartIso_of_mem_aeAtlas) hψ (by rw [reg_eq]; exact hsub)

/-- **Non-vacuity.** `E₀` carries a singular `(Isom(𝐌³), 𝐌³)`-structure with a singular point, the
first in lean-causal: its regular locus is `E₀ ∖ sing₀`, its singular locus the BTZ line, every
sector chart is a chart of it, and the hypotheses (a) and (b) of
`existsUnique_causality_singularGX_dec25` hold at the single model `E₀` (`hreg` by the model-free
lemma). -/
theorem singularGX_nonvacuous :
    Reg (Flat.isom 2) (Minkowski 2) E0 = axisᶜ ∧
    Sing (Flat.isom 2) (Minkowski 2) E0 = singE0 0 ∧
    (Sing (Flat.isom 2) (Minkowski 2) E0).Nonempty ∧
    (∀ (y : E0) (hy : y.2 ≠ 0), sectorChart y hy ∈ aeAtlas (Flat.isom 2) (Minkowski 2) E0) ∧
    -- (a)
    (minkowski 2).CausallyArcConnected ∧
    (∀ g : Flat.isom 2, StrongMorphism (minkowski 2) (minkowski 2) fun p => g • p) ∧
    -- (b)
    E0.causality.CausallyArcConnected ∧
    (∀ r ∈ aeAtlas (Flat.isom 2) (Minkowski 2) E0, ChartIso E0.causality (minkowski 2) r) := by
  exact ⟨reg_eq, sing_eq_singE0_zero, sing_nonempty,
    fun y hy => sectorAtlas_subset_aeAtlas (sectorChart_mem_sectorAtlas hy),
    minkowski_causallyArcConnected, Flat.isom_strongMorphism, E0.causallyArcConnected,
    chartIso_of_mem_aeAtlas⟩

end E0GX


