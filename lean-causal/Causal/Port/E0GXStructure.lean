namespace Causal

open Set Filter Topology TopologicalSpace Function

universe u v w

/-! ### The model-free lemma: chart isomorphisms over the maximal a.e. atlas -/

section MaximalAEAtlasIso

variable {G : Type w} {X : Type v} [TopologicalSpace X] [Group G] [MulAction G X]
  [ContinuousConstSMul G X] [LocallyConnectedSpace X] [T2Space X] [IsRigidAction G X]
  {Y : Type u} [TopologicalSpace Y]

/-- **Chart isomorphisms pass to the maximal a.e. atlas, where they are tied to the model.** Let
`A` be an a.e. `(G,X)`-atlas of `Y` whose charts are chart isomorphisms `DY → DX`, `G` acting by
strong morphisms of `DX`, `DX` absolutely minimal on its open sets. A chart `e` of the maximal a.e.
atlas of `A` is a chart isomorphism if `DY` is absolutely minimal on its source and agrees with the
transport of `DX` along `e` near the points of its source outside `supp A`. -/
theorem chartIso_of_mem_maximalAEAtlas_of_agreeOn {DX : Causality X} {DY : Causality Y}
    (hDX : ∀ W : Opens X, DX.AbsolutelyMinimalOn W)
    (hG : ∀ g : G, StrongMorphism DX DX fun p => g • p)
    {A : Set (OpenPartialHomeomorph Y X)} (hA : IsAEAtlas G A)
    (hAiso : ∀ a ∈ A, ChartIso DY DX a) {e : OpenPartialHomeomorph Y X}
    (he : e ∈ maximalAEAtlas G A) (hmin : DY.AbsolutelyMinimalOn (chartSource e))
    (hsing : ∀ x ∈ e.source, x ∉ support A →
      ∃ O : Opens Y, x ∈ O ∧ AgreeOn DY (DX.chartTransport e) O) :
    ChartIso DY DX e := by
  have hM := hA.maximalAEAtlas
  have hCe := DX.chartTransport_chartIso e
  have hloc : ∀ x ∈ chartSource e, ∃ O : Opens Y, x ∈ O ∧ AgreeOn DY (DX.chartTransport e) O := by
    intro x hx
    by_cases hxA : x ∈ support A
    · obtain ⟨a, ha, hxa⟩ := mem_support.1 hxA
      obtain ⟨g, O, hxO, hO, heq⟩ := exists_smul_eq_of_mem_gxGroupoid
        (hM.1.symm_trans_mem (hA.subset_maximalAEAtlas ha) he) hxa hx
      exact ⟨O, hxO, (hAiso a ha).agreeOn_of_smul hG hCe hO heq⟩
    · exact hsing x hx hxA
  have hTmin : (DX.chartTransport e).AbsolutelyMinimalOn (chartSource e) :=
    hCe.absolutelyMinimalOn le_rfl (hDX _)
  have hloc' : ∀ x ∈ chartSource e, ∃ O : Opens Y, x ∈ O ∧ AgreeOn (DX.chartTransport e) DY O :=
    fun x hx => by
      obtain ⟨O, hxO, hO⟩ := hloc x hx
      exact ⟨O, hxO, hO.symm⟩
  refine hCe.congr fun V hV x y => ?_
  have h1 := imp_of_agree_locally hmin hloc hV (x := x) (y := y)
  have h2 := imp_of_agree_locally hTmin hloc' hV (x := x) (y := y)
  exact ⟨⟨h1.1, h2.1⟩, ⟨h1.2, h2.2⟩⟩

/-- The model-free lemma for a chart whose source lies in the support of the generating atlas. -/
theorem chartIso_of_mem_maximalAEAtlas_of_source_subset {DX : Causality X} {DY : Causality Y}
    (hDX : ∀ W : Opens X, DX.AbsolutelyMinimalOn W)
    (hG : ∀ g : G, StrongMorphism DX DX fun p => g • p)
    {A : Set (OpenPartialHomeomorph Y X)} (hA : IsAEAtlas G A)
    (hAiso : ∀ a ∈ A, ChartIso DY DX a) {e : OpenPartialHomeomorph Y X}
    (he : e ∈ maximalAEAtlas G A) (hmin : DY.AbsolutelyMinimalOn (chartSource e))
    (hsub : e.source ⊆ support A) : ChartIso DY DX e :=
  chartIso_of_mem_maximalAEAtlas_of_agreeOn hDX hG hA hAiso he hmin fun _ hx hxA =>
    absurd (hsub hx) hxA

/-- **The model-free lemma, every chart**: if the maximal a.e. atlas has no more support than the
generating one, and `DY` is absolutely minimal on its open sets, every chart of the maximal a.e.
atlas is a chart isomorphism. -/
theorem forall_chartIso_maximalAEAtlas_of_support_subset {DX : Causality X} {DY : Causality Y}
    (hDX : ∀ W : Opens X, DX.AbsolutelyMinimalOn W)
    (hG : ∀ g : G, StrongMorphism DX DX fun p => g • p)
    {A : Set (OpenPartialHomeomorph Y X)} (hA : IsAEAtlas G A)
    (hAiso : ∀ a ∈ A, ChartIso DY DX a) (hmin : ∀ W : Opens Y, DY.AbsolutelyMinimalOn W)
    (hsupp : support (maximalAEAtlas G A) ⊆ support A) :
    ∀ e ∈ maximalAEAtlas G A, ChartIso DY DX e :=
  fun e he => chartIso_of_mem_maximalAEAtlas_of_source_subset hDX hG hA hAiso he (hmin _)
    fun _ hx => hsupp (mem_support.2 ⟨e, he, hx⟩)

/-- **DEC-25's `hreg` from a generating atlas**: for a singular `(G,X)`-manifold `Y` whose maximal
a.e. atlas is that of an a.e. atlas `A` of chart isomorphisms, with `Reg Y ⊆ supp A`, every chart
of the maximal a.e. atlas is a chart isomorphism. -/
theorem forall_chartIso_aeAtlas_of_reg_subset [SingularGXStructure G X Y] {DX : Causality X}
    {DY : Causality Y} (hDX : ∀ W : Opens X, DX.AbsolutelyMinimalOn W)
    (hG : ∀ g : G, StrongMorphism DX DX fun p => g • p)
    {A : Set (OpenPartialHomeomorph Y X)} (hA : IsAEAtlas G A)
    (hAiso : ∀ a ∈ A, ChartIso DY DX a) (hmin : ∀ W : Opens Y, DY.AbsolutelyMinimalOn W)
    (hgen : aeAtlas G X Y = maximalAEAtlas G A) (hreg : Reg G X Y ⊆ support A) :
    ∀ r ∈ aeAtlas G X Y, ChartIso DY DX r := by
  intro r hr
  have hsupp : support (maximalAEAtlas G A) ⊆ support A := by
    have h : Reg G X Y = support (maximalAEAtlas G A) := by rw [Reg, hgen]
    rw [← h]; exact hreg
  rw [hgen] at hr
  exact forall_chartIso_maximalAEAtlas_of_support_subset hDX hG hA hAiso hmin hsupp r hr

end MaximalAEAtlasIso

/-! ### `E₀`: the holonomy, the sector atlas, the singular structure -/

namespace E0GX

open E0 Complex
open scoped Real

/-! #### The shift of the developing angle, an isometry of `𝐌³` -/

/-- **The shift `θ ↦ θ + s` of the developing angle, in null coordinates**:
`(a, b, c) ↦ (a − 2sc + s²b, b, c − sb)` (`lift_add_angle`). -/
noncomputable def angleShift (s : ℝ) : (ℝ × ℝ × ℝ) ≃ₗ[ℝ] (ℝ × ℝ × ℝ) where
  toFun y := (y.1 - 2 * s * y.2.2 + s ^ 2 * y.2.1, y.2.1, y.2.2 - s * y.2.1)
  invFun y := (y.1 + 2 * s * y.2.2 + s ^ 2 * y.2.1, y.2.1, y.2.2 + s * y.2.1)
  map_add' y y' := by ext <;> simp <;> ring
  map_smul' c y := by ext <;> simp <;> ring
  left_inv y := by ext <;> simp; ring
  right_inv y := by ext <;> simp; ring

theorem angleShift_apply (s : ℝ) (y : ℝ × ℝ × ℝ) :
    angleShift s y = (y.1 - 2 * s * y.2.2 + s ^ 2 * y.2.1, y.2.1, y.2.2 - s * y.2.1) := rfl

theorem angleShift_angleShift (s t : ℝ) (y : ℝ × ℝ × ℝ) :
    angleShift s (angleShift t y) = angleShift (s + t) y := by
  simp only [angleShift_apply]
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp <;> ring

/-- The development with angle `θ + s` is the angle shift of the development with angle `θ`. -/
theorem lift_add_angle (x : E0) (θ s : ℝ) : lift x (θ + s) = angleShift s (lift x θ) := by
  have h : ∀ φ : ℝ, E0.lift x φ = (2 * x.1 + rad x * φ ^ 2 - rad x, rad x, -(rad x * φ)) :=
    fun φ => by unfold E0.lift E0.btzPaperNull; rfl
  rw [h, h, angleShift_apply]
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp <;> ring

/-- The angle shift in Minkowski coordinates. -/
noncomputable def holLin (s : ℝ) : Minkowski 2 ≃ₗ[ℝ] Minkowski 2 :=
  (nullToMink.symm.trans (angleShift s)).trans nullToMink

theorem holLin_apply (s : ℝ) (v : Minkowski 2) :
    holLin s v = nullToMink (angleShift s (nullToMink.symm v)) := rfl

theorem holLin_mem_lorentz (s : ℝ) : holLin s ∈ Flat.lorentz 2 := by
  have hQ : ∀ v, Flat.minkQ (holLin s v) = Flat.minkQ v := fun v => by
    rw [holLin_apply, minkQ_nullToMink]
    conv_rhs => rw [← nullToMink.apply_symm_apply v, minkQ_nullToMink]
    simp only [angleShift_apply]
    ring
  have h0 : 0 < (holLin s (Flat.timeUnit 2)).1 := by
    have : (holLin s (Flat.timeUnit 2)).1 = (2 + s ^ 2) / 2 := by
      have e : nullToMink.symm (Flat.timeUnit 2) = (1, 1, 0) := by
        show ((1 : ℝ) + (0 : EuclideanSpace ℝ (Fin 2)) 0, (1 : ℝ) - (0 : EuclideanSpace ℝ (Fin 2)) 0,
          (0 : EuclideanSpace ℝ (Fin 2)) 1) = (1, 1, 0)
        simp
      rw [holLin_apply, nullToMink_apply, e, angleShift_apply]
      simp only
      ring
    rw [this]; positivity
  refine Flat.mem_lorentz_of hQ h0 (Flat.det_eq_one_of_eq_sq (B := holLin (s / 2)) hQ ?_)
  refine LinearMap.ext fun v => ?_
  show holLin s v = holLin (s / 2) (holLin (s / 2) v)
  rw [holLin_apply, holLin_apply, holLin_apply, LinearEquiv.symm_apply_apply,
    angleShift_angleShift, add_halves]

/-- **The holonomy family**: the angle shift by `s` as an isometry of `𝐌³`; `hol (2π)` is the
holonomy of a loop about the axis. -/
noncomputable def hol (s : ℝ) : Flat.isom 2 :=
  ⟨(holLin s).toAffineEquiv, holLin_mem_lorentz s⟩

theorem hol_smul (s : ℝ) (v : Minkowski 2) : hol s • v = holLin s v := rfl

theorem hol_smul_nullToMink (s : ℝ) (y : ℝ × ℝ × ℝ) :
    hol s • nullToMink y = nullToMink (angleShift s y) := by
  rw [hol_smul, holLin_apply, LinearEquiv.symm_apply_apply]

theorem hol_add (s t : ℝ) : hol (s + t) = hol s * hol t := by
  refine Subtype.ext (AffineEquiv.ext fun v => ?_)
  show hol (s + t) • v = (hol s * hol t) • v
  rw [mul_smul, hol_smul, hol_smul, hol_smul, holLin_apply, holLin_apply, holLin_apply,
    LinearEquiv.symm_apply_apply, angleShift_angleShift]

theorem hol_zero : hol 0 = 1 := by
  refine Subtype.ext (AffineEquiv.ext fun v => ?_)
  show hol 0 • v = (1 : Flat.isom 2) • v
  rw [one_smul, hol_smul, holLin_apply]
  have : ∀ y : ℝ × ℝ × ℝ, angleShift 0 y = y := fun y => by
    simp only [angleShift_apply]
    refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp
  rw [this, LinearEquiv.apply_symm_apply]

/-- `hol (2πk)` is the `k`-th power of the holonomy `hol (2π)`. -/
theorem hol_two_pi_mul_int (k : ℤ) : hol (2 * π * k) = hol (2 * π) ^ k := by
  induction k using Int.induction_on with
  | zero => simp [hol_zero]
  | succ n ih =>
    rw [zpow_add_one, ← ih, ← hol_add]
    congr 1
    push_cast; ring
  | pred n ih =>
    rw [zpow_sub_one, ← ih, eq_mul_inv_iff_mul_eq, ← hol_add]
    congr 1
    push_cast; ring

/-- The holonomy of a loop about the axis moves a point of `𝐌³`. -/
theorem hol_two_pi_smul_ne : hol (2 * π) • nullToMink (0, 1, 0) ≠ nullToMink (0, 1, 0) := by
  rw [hol_smul_nullToMink]
  intro h
  have h1 := congrArg Prod.fst (nullToMink.injective h)
  simp only [angleShift_apply] at h1
  have : (2 * π) ^ 2 = 0 := by linarith
  exact Real.pi_ne_zero (by nlinarith [Real.pi_pos])

theorem holLin_two_pi_ne_one : holLin (2 * π) ≠ 1 := fun h =>
  hol_two_pi_smul_ne (by rw [hol_smul, h]; rfl)

/-- **The holonomy of a loop about the axis is parabolic** (`Causal.Flat.IsParabolic`): its linear
part is a non-trivial unipotent element of `SO₀(1,2)`, `(A − 1)³ = 0`. -/
theorem isParabolic_holLin_two_pi : Flat.IsParabolic (holLin (2 * π)) := by
  refine Flat.IsUnipotent.isParabolic (holLin_mem_lorentz _) ⟨3, ?_⟩ holLin_two_pi_ne_one
  have hp : ∀ v, Flat.pOf (holLin (2 * π)) v =
      nullToMink (angleShift (2 * π) (nullToMink.symm v) - nullToMink.symm v) := fun v => by
    rw [Flat.pOf_apply, holLin_apply, map_sub, LinearEquiv.apply_symm_apply]
  refine LinearMap.ext fun v => ?_
  rw [pow_succ, pow_succ, pow_one, Module.End.mul_apply, Module.End.mul_apply, hp, hp, hp,
    LinearEquiv.symm_apply_apply, LinearEquiv.symm_apply_apply, LinearMap.zero_apply,
    ← map_zero nullToMink]
  congr 1
  simp only [angleShift_apply]
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp

/-- **Two sector charts differ by the holonomy of the angle shift**: if `angle y' w = angle y w + s`
then `chartMap y' w = hol s • chartMap y w`. -/
theorem chartMap_eq_hol_smul {y y' w : E0} {s : ℝ} (h : angle y' w = angle y w + s) :
    chartMap y' w = hol s • chartMap y w := by
  show nullToMink (lift w (angle y' w)) = hol s • nullToMink (lift w (angle y w))
  rw [h, lift_add_angle, hol_smul_nullToMink]

/-! #### The sector atlas -/

/-- **The sector atlas of `E₀`**: the sector charts of the points off the axis. -/
def sectorAtlas : Set (OpenPartialHomeomorph E0 (Minkowski 2)) :=
  {e | ∃ (y : E0) (hy : y.2 ≠ 0), e = sectorChart y hy}

theorem sectorChart_mem_sectorAtlas {y : E0} (hy : y.2 ≠ 0) : sectorChart y hy ∈ sectorAtlas :=
  ⟨y, hy, rfl⟩

/-- The support of the sector atlas is `E₀ ∖ sing₀`. -/
theorem support_sectorAtlas : support sectorAtlas = axisᶜ := by
  ext x
  rw [mem_support, mem_compl_iff]
  constructor
  · rintro ⟨e, ⟨y, hy, rfl⟩, hx⟩
    exact not_mem_axis_of_mem_sector hx
  · intro hx
    exact ⟨sectorChart x hx, sectorChart_mem_sectorAtlas hx, mem_sector_self hx⟩

/-- **Near every point of their overlap, two sector charts differ by a power of the holonomy.** -/
theorem sectorChart_eventually_eq_zpow_smul {y y' : E0} (hy : y.2 ≠ 0) (hy' : y'.2 ≠ 0) {x : E0}
    (hx : x ∈ sector y) (hx' : x ∈ sector y') :
    ∃ k : ℤ, ∀ᶠ w in 𝓝 x, sectorChart y' hy' w = hol (2 * π) ^ k • sectorChart y hy w := by
  have hx0 : x.2 ≠ 0 := ne_zero_of_mem_sector hx
  obtain ⟨k₀, hk₀⟩ := (polar_angle hy x).eq_add_int (polar_angle hy' x) (rad_pos.2 hx0)
  have hc : ContinuousAt (fun w => angle y' w - angle y w) x :=
    ((continuousOn_angle y').continuousAt ((isOpen_sector y').mem_nhds hx')).sub
      ((continuousOn_angle y).continuousAt ((isOpen_sector y).mem_nhds hx))
  have hev : ∀ᶠ w in 𝓝 x,
      |(angle y' w - angle y w) - (angle y' x - angle y x)| < 2 * π := by
    have := hc.eventually (Metric.ball_mem_nhds (angle y' x - angle y x)
      (by positivity : (0 : ℝ) < 2 * π))
    filter_upwards [this] with w hw
    rw [Real.dist_eq] at hw
    exact hw
  refine ⟨k₀, ?_⟩
  filter_upwards [hev, (isOpen_sector y).mem_nhds hx] with w hw hws
  have hw0 : w.2 ≠ 0 := ne_zero_of_mem_sector hws
  obtain ⟨k, hk⟩ := (polar_angle hy w).eq_add_int (polar_angle hy' w) (rad_pos.2 hw0)
  have hkk : k = k₀ := by
    rw [hk, hk₀] at hw
    have h1 : |2 * π * ((k : ℝ) - k₀)| < 2 * π := by
      have e : angle y w + 2 * π * k - angle y w - (angle y x + 2 * π * k₀ - angle y x) =
          2 * π * ((k : ℝ) - k₀) := by ring
      rwa [e] at hw
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * π)] at h1
    have h2 : |((k : ℝ) - k₀)| < 1 := by
      have := Real.pi_pos
      by_contra hc'
      push Not at hc'
      nlinarith
    have h3 : |((k - k₀ : ℤ) : ℝ)| < 1 := by push_cast; exact h2
    have h4 : |(k - k₀ : ℤ)| < 1 := by exact_mod_cast h3
    rw [abs_lt] at h4
    omega
  show chartMap y' w = hol (2 * π) ^ k₀ • chartMap y w
  rw [← hol_two_pi_mul_int, chartMap_eq_hol_smul (hkk ▸ hk)]

theorem isGXAtlas_sectorAtlas : IsGXAtlas (Flat.isom 2) sectorAtlas := by
  refine isGXAtlas_of_eventually fun e he e' he' x hx => ?_
  obtain ⟨y, hy, rfl⟩ := he
  obtain ⟨y', hy', rfl⟩ := he'
  obtain ⟨k, hk⟩ := sectorChart_eventually_eq_zpow_smul hy hy' hx.1 hx.2
  exact ⟨_, hk⟩

/-- **On each connected component of an overlap, two sector charts differ by one power of the
parabolic holonomy** `hol (2π)` (`isParabolic_holLin_two_pi`). -/
theorem sectorChart_eq_zpow_smul_on_component {y y' : E0} (hy : y.2 ≠ 0) (hy' : y'.2 ≠ 0)
    {x : E0} (hx : x ∈ sector y) (hx' : x ∈ sector y') :
    ∃ k : ℤ, ∀ w ∈ connectedComponentIn (sector y ∩ sector y') x,
      sectorChart y' hy' w = hol (2 * π) ^ k • sectorChart y hy w := by
  obtain ⟨g, hg⟩ := isGXAtlas_sectorAtlas _ (sectorChart_mem_sectorAtlas hy) _
    (sectorChart_mem_sectorAtlas hy') x ⟨hx, hx'⟩
  obtain ⟨k, hk⟩ := sectorChart_eventually_eq_zpow_smul hy hy' hx hx'
  have hC : IsOpen (connectedComponentIn (sector y ∩ sector y') x) :=
    ((isOpen_sector y).inter (isOpen_sector y')).connectedComponentIn
  obtain ⟨t, ht, hto, hxt⟩ :=
    mem_nhds_iff.1 (hk.and (hC.mem_nhds (mem_connectedComponentIn ⟨hx, hx'⟩)))
  have hts : t ⊆ (sectorChart y hy).source := fun w hw =>
    (connectedComponentIn_subset _ _ (ht hw).2).1
  have hr : ∀ m : Minkowski 2, g • m = hol (2 * π) ^ k • m := by
    refine IsRigidAction.smul_eq_of_eqOn
      ((sectorChart y hy).isOpen_image_of_subset_source hto hts) ⟨_, x, hxt, rfl⟩ ?_
    rintro _ ⟨w, hw, rfl⟩
    show g • sectorChart y hy w = hol (2 * π) ^ k • sectorChart y hy w
    rw [← hg w (ht hw).2, (ht hw).1]
  exact ⟨k, fun w hw => by rw [hg w hw, hr]⟩

/-- A punctured disc of `ℂ` is preconnected (restated from gx's `GX.isPreconnected_ball_diff_zero`,
`lean-gx/GX/Singular/Quotient.lean` l.2260). -/
theorem isPreconnected_ball_diff_zero (ε : ℝ) :
    IsPreconnected (Metric.ball (0 : ℂ) ε \ {0}) := by
  have hc : Continuous fun q : ℝ × ℝ => (q.1 : ℂ) * Complex.exp (q.2 * Complex.I) :=
    (Complex.continuous_ofReal.comp continuous_fst).mul
      (Complex.continuous_exp.comp ((Complex.continuous_ofReal.comp continuous_snd).mul
        continuous_const))
  convert (((convex_Ioo (0 : ℝ) ε).prod (convex_univ : Convex ℝ (univ : Set ℝ))).isPreconnected).image
    _ hc.continuousOn using 1
  ext w
  constructor
  · rintro ⟨hw, hw0⟩
    refine ⟨(‖w‖, Complex.arg w), ⟨⟨norm_pos_iff.2 hw0, by simpa using hw⟩, mem_univ _⟩, ?_⟩
    exact Complex.norm_mul_exp_arg_mul_I w
  · rintro ⟨q, ⟨⟨h1, h2⟩, -⟩, rfl⟩
    refine ⟨?_, ?_⟩
    · rw [mem_ball_zero_iff, norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one, Complex.norm_real,
        Real.norm_of_nonneg h1.le]
      exact h2
    · simp only [mem_singleton_iff, mul_eq_zero, Complex.ofReal_eq_zero, Complex.exp_ne_zero,
        or_false]
      exact h1.ne'

/-- `𝔼^n ∖ S` is portly for `S = {0} × Z`, here `Z = ℝ` (restated from gx's
`GX.isPortly_ne_zero`, `lean-gx/GX/Singular/Quotient.lean` l.2284, at `Z = ℝ`: lean-causal has no
instance `LocallyConnectedSpace (ℂ × Z)` for a general locally connected `Z`; the proof is gx's
verbatim, with `Z` the abbreviation below, but for `mem_setOf_eq`, dropped from one `simp only` where
it is unused at `Z = ℝ`). -/
theorem isPortly_ne_zero : IsPortly {x : ℂ × ℝ | x.1 ≠ 0} := by
  let Z := ℝ
  have hP : {x : ℂ × Z | x.1 ≠ 0} = ({0}ᶜ : Set ℂ) ×ˢ univ := by ext x; simp
  have hopen : IsOpen {x : ℂ × Z | x.1 ≠ 0} := isOpen_ne.preimage continuous_fst
  have hd : Dense {x : ℂ × Z | x.1 ≠ 0} := by
    rw [hP]; exact (dense_compl_singleton (0 : ℂ)).prod dense_univ
  refine ⟨hopen, hd, fun W hW hWc => ?_⟩
  refine isPreconnected_of_local hWc inter_subset_left
    (fun x hx => hW.inter_closure ⟨hx, hd x⟩) fun x hx => ?_
  by_cases hx1 : x.1 ≠ 0
  · refine ⟨connectedComponentIn (W ∩ {x : ℂ × Z | x.1 ≠ 0}) x,
      (hW.inter hopen).connectedComponentIn, mem_connectedComponentIn ⟨hx, hx1⟩, ?_⟩
    rw [inter_eq_left.2 (connectedComponentIn_subset _ _)]
    exact isPreconnected_connectedComponentIn
  · rw [not_ne_iff] at hx1
    obtain ⟨u, hu, v, hv, huv⟩ := mem_nhds_prod_iff.1 (hW.mem_nhds hx)
    rw [hx1] at hu
    obtain ⟨ε, hε, hεu⟩ := Metric.mem_nhds_iff.1 hu
    obtain ⟨V, hVv, hVo, hzV, hVc⟩ :=
      locallyConnectedSpace_iff_subsets_isOpen_isConnected.1 inferInstance x.2 v hv
    refine ⟨Metric.ball (0 : ℂ) ε ×ˢ V, Metric.isOpen_ball.prod hVo,
      ⟨by rw [hx1]; exact Metric.mem_ball_self hε, hzV⟩, ?_⟩
    have heq : (Metric.ball (0 : ℂ) ε ×ˢ V) ∩ (W ∩ {x : ℂ × Z | x.1 ≠ 0}) =
        (Metric.ball (0 : ℂ) ε \ {0}) ×ˢ V := by
      ext ⟨w, z⟩
      simp only [mem_inter_iff, mem_prod, Set.mem_sdiff, mem_singleton_iff]
      constructor
      · rintro ⟨⟨h1, h2⟩, -, h3⟩; exact ⟨⟨h1, h3⟩, h2⟩
      · rintro ⟨⟨h1, h2⟩, h3⟩
        exact ⟨⟨h1, h3⟩, huv ⟨hεu h1, hVv h3⟩, h2⟩
    rw [heq]
    exact (isPreconnected_ball_diff_zero ε).prod hVc.isPreconnected

/-- **`E₀ ∖ sing₀` is portly**: open, dense, and removing the axis from a connected open set leaves
it connected. -/
theorem isPortly_compl_axis : IsPortly axisᶜ := by
  have h := isPortly_ne_zero.image_of_isOpenMap (Homeomorph.prodComm ℂ ℝ).continuous
    (Homeomorph.prodComm ℂ ℝ).isOpenMap (Homeomorph.prodComm ℂ ℝ).surjective
  convert h using 1
  ext x
  constructor
  · intro hx
    exact ⟨(x.2, x.1), hx, rfl⟩
  · rintro ⟨y, hy, rfl⟩
    exact hy

/-- **The sector charts form an a.e. `(Isom(𝐌³), 𝐌³)`-atlas of `E₀`.** -/
theorem isAEAtlas_sectorAtlas : IsAEAtlas (Flat.isom 2) sectorAtlas :=
  ⟨isGXAtlas_sectorAtlas, by rw [support_sectorAtlas]; exact isPortly_compl_axis⟩

/-! #### The singular structure -/

/-- **`E₀` as a singular `(Isom(𝐌³), 𝐌³)`-manifold** (DEC-25): the maximal a.e. atlas of its
sector atlas. -/
noncomputable abbrev singularGX : SingularGXStructure (Flat.isom 2) (Minkowski 2) E0 :=
  ⟨maximalAEAtlas (Flat.isom 2) sectorAtlas, isAEAtlas_sectorAtlas.isMaximalAEAtlas_maximalAEAtlas⟩

attribute [local instance] singularGX

theorem aeAtlas_eq :
    aeAtlas (Flat.isom 2) (Minkowski 2) E0 = maximalAEAtlas (Flat.isom 2) sectorAtlas := rfl

theorem sectorAtlas_subset_aeAtlas : sectorAtlas ⊆ aeAtlas (Flat.isom 2) (Minkowski 2) E0 :=
  isAEAtlas_sectorAtlas.subset_maximalAEAtlas

/-- **No chart of the maximal a.e. atlas reaches the axis**: on a punctured neighbourhood of an
axis point such a chart would be one translate of each of two sector charts, which differ by the
holonomy `hol (2π)` on one half of it and agree on the other. -/
theorem source_inter_axis_eq_empty {e : OpenPartialHomeomorph E0 (Minkowski 2)}
    (he : e ∈ aeAtlas (Flat.isom 2) (Minkowski 2) E0) : e.source ∩ axis = ∅ := by
  refine eq_empty_iff_forall_notMem.2 fun p hp => ?_
  obtain ⟨hpe, hpa⟩ := hp
  have hp0 : p.2 = 0 := hpa
  have hM : IsGXAtlas (Flat.isom 2) (aeAtlas (Flat.isom 2) (Minkowski 2) E0) :=
    (isMaximalAEAtlas_aeAtlas (Flat.isom 2) (Minkowski 2) E0).1.1
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 e.open_source p hpe
  have hy₁ : ((0 : ℝ), (1 : ℂ)).2 ≠ 0 := one_ne_zero
  have hy₂ : ((0 : ℝ), (-1 : ℂ)).2 ≠ 0 := neg_ne_zero.2 one_ne_zero
  have hc₁ := sectorAtlas_subset_aeAtlas (sectorChart_mem_sectorAtlas hy₁)
  have hc₂ := sectorAtlas_subset_aeAtlas (sectorChart_mem_sectorAtlas hy₂)
  -- the box `ball p.1 ε × ball 0 ε` lies in the source of `e`
  have hbox : ∀ w : E0, w.1 ∈ Metric.ball p.1 ε → w.2 ∈ Metric.ball (0 : ℂ) ε →
      w ∈ e.source := by
    intro w h1 h2
    have : w ∈ Metric.ball (p.1, p.2) ε := by
      rw [← ball_prod_same]; exact ⟨h1, by rw [hp0]; exact h2⟩
    exact hball this
  -- the two slit discs, preconnected
  set D₁ : Set ℂ := Metric.ball (0 : ℂ) ε ∩ Complex.slitPlane with hD₁def
  set D₂ : Set ℂ := Metric.ball (0 : ℂ) ε ∩ {z | -z ∈ Complex.slitPlane} with hD₂def
  have hmid : ((ε / 2 : ℝ) : ℂ) ∈ D₁ := by
    refine ⟨?_, Complex.ofReal_mem_slitPlane.2 (by positivity)⟩
    rw [mem_ball_zero_iff, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
    linarith
  have hD₁ : IsPreconnected D₁ :=
    ((((convex_ball (0 : ℂ) ε).starConvex hmid.1).inter
      (Complex.starConvex_ofReal_slitPlane (by positivity))).isPathConnected
      hmid).isConnected.isPreconnected
  have hD₂ : IsPreconnected D₂ := by
    have h : D₂ = (Homeomorph.neg ℂ) ⁻¹' D₁ := by
      ext z
      simp only [hD₁def, hD₂def, mem_inter_iff, mem_setOf_eq, mem_preimage, mem_ball_zero_iff]
      show ‖z‖ < ε ∧ -z ∈ Complex.slitPlane ↔ ‖-z‖ < ε ∧ -z ∈ Complex.slitPlane
      rw [norm_neg]
    rw [h, (Homeomorph.neg ℂ).isPreconnected_preimage]
    exact hD₁
  set T₁ : Set E0 := Metric.ball p.1 ε ×ˢ D₁ with hT₁def
  set T₂ : Set E0 := Metric.ball p.1 ε ×ˢ D₂ with hT₂def
  have hT₁ : IsPreconnected T₁ := (convex_ball p.1 ε).isPreconnected.prod hD₁
  have hT₂ : IsPreconnected T₂ := (convex_ball p.1 ε).isPreconnected.prod hD₂
  have hT₁s : T₁ ⊆ e.source ∩ (sectorChart _ hy₁).source := fun w hw =>
    ⟨hbox w hw.1 hw.2.1, by
      show w.2 / 1 ∈ Complex.slitPlane
      rw [div_one]; exact hw.2.2⟩
  have hT₂s : T₂ ⊆ e.source ∩ (sectorChart _ hy₂).source := fun w hw =>
    ⟨hbox w hw.1 hw.2.1, by
      show w.2 / -1 ∈ Complex.slitPlane
      rw [div_neg, div_one]; exact hw.2.2⟩
  -- the two open half-boxes
  set U₁ : Set E0 := Metric.ball p.1 ε ×ˢ (Metric.ball (0 : ℂ) ε ∩ {z | 0 < z.im}) with hU₁def
  set U₂ : Set E0 := Metric.ball p.1 ε ×ˢ (Metric.ball (0 : ℂ) ε ∩ {z | z.im < 0}) with hU₂def
  have hU₁T : U₁ ⊆ T₁ ∩ T₂ := fun w hw =>
    ⟨⟨hw.1, hw.2.1, Complex.mem_slitPlane_iff.2 (Or.inr hw.2.2.ne')⟩,
      ⟨hw.1, hw.2.1, Complex.mem_slitPlane_iff.2 (Or.inr (by
        rw [Complex.neg_im]; exact neg_ne_zero.2 hw.2.2.ne'))⟩⟩
  have hU₂T : U₂ ⊆ T₁ ∩ T₂ := fun w hw =>
    ⟨⟨hw.1, hw.2.1, Complex.mem_slitPlane_iff.2 (Or.inr hw.2.2.ne)⟩,
      ⟨hw.1, hw.2.1, Complex.mem_slitPlane_iff.2 (Or.inr (by
        rw [Complex.neg_im]; exact neg_ne_zero.2 hw.2.2.ne))⟩⟩
  have hU₁o : IsOpen U₁ :=
    Metric.isOpen_ball.prod (Metric.isOpen_ball.inter (isOpen_lt continuous_const
      Complex.continuous_im))
  have hU₂o : IsOpen U₂ :=
    Metric.isOpen_ball.prod (Metric.isOpen_ball.inter (isOpen_lt Complex.continuous_im
      continuous_const))
  have hnorm : ‖((ε / 2 : ℝ) : ℂ) * Complex.I‖ < ε := by
    rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
    linarith
  have hnorm' : ‖-(((ε / 2 : ℝ) : ℂ) * Complex.I)‖ < ε := by rw [norm_neg]; exact hnorm
  have hq₁ : ((p.1, ((ε / 2 : ℝ) : ℂ) * Complex.I) : E0) ∈ U₁ :=
    ⟨Metric.mem_ball_self hε, mem_ball_zero_iff.2 hnorm, by
      show 0 < (((ε / 2 : ℝ) : ℂ) * Complex.I).im
      simp only [Complex.mul_im, Complex.ofReal_re, Complex.I_im, Complex.ofReal_im,
        Complex.I_re, mul_zero, add_zero, mul_one]
      positivity⟩
  have hq₂ : ((p.1, -(((ε / 2 : ℝ) : ℂ) * Complex.I)) : E0) ∈ U₂ :=
    ⟨Metric.mem_ball_self hε, mem_ball_zero_iff.2 hnorm', by
      show (-(((ε / 2 : ℝ) : ℂ) * Complex.I)).im < 0
      simp only [Complex.neg_im, Complex.mul_im, Complex.ofReal_re, Complex.I_im,
        Complex.ofReal_im, Complex.I_re, mul_zero, add_zero, mul_one, neg_lt_zero]
      positivity⟩
  -- `e` is one translate of each sector chart on the corresponding slit box
  obtain ⟨g₁, hg₁⟩ := hM e he _ hc₁ _ (hT₁s (hU₁T hq₁).1)
  obtain ⟨g₂, hg₂⟩ := hM e he _ hc₂ _ (hT₂s (hU₁T hq₁).2)
  have hg₁' : ∀ w ∈ T₁, sectorChart _ hy₁ w = g₁ • e w := fun w hw =>
    hg₁ w (hT₁.subset_connectedComponentIn (hU₁T hq₁).1 hT₁s hw)
  have hg₂' : ∀ w ∈ T₂, sectorChart _ hy₂ w = g₂ • e w := fun w hw =>
    hg₂ w (hT₂.subset_connectedComponentIn (hU₁T hq₁).2 hT₂s hw)
  -- the two sector charts agree on the upper half and differ by `hol (2π)` on the lower one
  have hang₁ : ∀ w : E0, angle ((0 : ℝ), (1 : ℂ)) w = Complex.arg w.2 := fun w => by
    show Complex.arg (1 : ℂ) + Complex.arg (w.2 / 1) = Complex.arg w.2
    rw [Complex.arg_one, div_one, zero_add]
  have hang₂ : ∀ w : E0, angle ((0 : ℝ), (-1 : ℂ)) w = π + Complex.arg (-w.2) := fun w => by
    show Complex.arg (-1 : ℂ) + Complex.arg (w.2 / -1) = π + Complex.arg (-w.2)
    rw [Complex.arg_neg_one, div_neg, div_one]
  have hU₁ : ∀ w ∈ U₁, sectorChart _ hy₂ w = sectorChart _ hy₁ w := fun w hw => by
    have h : angle ((0 : ℝ), (-1 : ℂ)) w = angle ((0 : ℝ), (1 : ℂ)) w + 0 := by
      rw [hang₁, hang₂, Complex.arg_neg_eq_arg_sub_pi_of_im_pos hw.2.2]; ring
    show chartMap _ w = chartMap _ w
    rw [chartMap_eq_hol_smul h, hol_zero, one_smul]
  have hU₂ : ∀ w ∈ U₂, sectorChart _ hy₂ w = hol (2 * π) • sectorChart _ hy₁ w := fun w hw => by
    have h : angle ((0 : ℝ), (-1 : ℂ)) w = angle ((0 : ℝ), (1 : ℂ)) w + 2 * π := by
      rw [hang₁, hang₂, Complex.arg_neg_eq_arg_add_pi_of_im_neg hw.2.2]; ring
    exact chartMap_eq_hol_smul h
  -- rigidity on the images of the half-boxes
  have hU₁e : U₁ ⊆ e.source := fun w hw => (hT₁s (hU₁T hw).1).1
  have hU₂e : U₂ ⊆ e.source := fun w hw => (hT₁s (hU₂T hw).1).1
  have hr₁ : ∀ m : Minkowski 2, g₂ • m = g₁ • m := by
    refine IsRigidAction.smul_eq_of_eqOn (e.isOpen_image_of_subset_source hU₁o hU₁e)
      ⟨_, _, hq₁, rfl⟩ ?_
    rintro _ ⟨w, hw, rfl⟩
    show g₂ • e w = g₁ • e w
    rw [← hg₂' w (hU₁T hw).2, ← hg₁' w (hU₁T hw).1, hU₁ w hw]
  have hr₂ : ∀ m : Minkowski 2, g₂ • m = (hol (2 * π) * g₁) • m := by
    refine IsRigidAction.smul_eq_of_eqOn (e.isOpen_image_of_subset_source hU₂o hU₂e)
      ⟨_, _, hq₂, rfl⟩ ?_
    rintro _ ⟨w, hw, rfl⟩
    show g₂ • e w = (hol (2 * π) * g₁) • e w
    rw [mul_smul, ← hg₂' w (hU₂T hw).2, ← hg₁' w (hU₂T hw).1, hU₂ w hw]
  apply hol_two_pi_smul_ne
  have h := (hr₂ (g₁⁻¹ • nullToMink (0, 1, 0))).symm.trans (hr₁ (g₁⁻¹ • nullToMink (0, 1, 0)))
  rwa [mul_smul, smul_inv_smul] at h

/-- **`Reg(E₀) = E₀ ∖ sing₀`.** -/
theorem reg_eq : Reg (Flat.isom 2) (Minkowski 2) E0 = axisᶜ := by
  refine Subset.antisymm (fun x hx hxa => ?_) ?_
  · obtain ⟨e, he, hxe⟩ := mem_support.1 hx
    exact eq_empty_iff_forall_notMem.1 (source_inter_axis_eq_empty he) x ⟨hxe, hxa⟩
  · rw [← support_sectorAtlas]
    exact support_mono sectorAtlas_subset_aeAtlas

/-- **`Sing(E₀) = sing₀`**, the BTZ line. -/
theorem sing_eq : Sing (Flat.isom 2) (Minkowski 2) E0 = axis := by
  rw [Sing, reg_eq, compl_compl]

theorem sing_eq_singE0_zero : Sing (Flat.isom 2) (Minkowski 2) E0 = singE0 0 := by
  rw [sing_eq, singE0_zero]

theorem sing_nonempty : (Sing (Flat.isom 2) (Minkowski 2) E0).Nonempty := by
  rw [sing_eq]
  exact ⟨(0, 0), rfl⟩

/-- **`hreg` at `κ = 0`, DEC-25's form**: every chart of the maximal a.e. atlas of `E₀` is a chart
isomorphism `E0.causality → minkowski 2` (the model-free lemma, at `E₀`). -/
theorem chartIso_of_mem_aeAtlas :
    ∀ r ∈ aeAtlas (Flat.isom 2) (Minkowski 2) E0, ChartIso E0.causality (minkowski 2) r :=
  forall_chartIso_aeAtlas_of_reg_subset minkowski_causallyArcConnected.absolutelyMinimalOn_all
    Flat.isom_strongMorphism isAEAtlas_sectorAtlas
    (by rintro a ⟨y, hy, rfl⟩; exact chartIso_sectorChart hy) E0.absolutelyMinimalOn aeAtlas_eq
    (by rw [reg_eq, support_sectorAtlas])

/-- (b′) of `existsUnique_causality_singularGX_dec25` at `E₀`, **at regular sources**: an a.e.
isomorphism chart `ψ : E₀ ⇀ E₀` whose source avoids the axis is a chart isomorphism of
`E0.causality` (`chartIso_model_of_subset_reg` at the single model `E₀`, from `hreg`). -/
theorem chartIso_of_isAEChart_of_subset_compl_axis {ψ : OpenPartialHomeomorph E0 E0}
    (hψ : IsAEChart (Flat.isom 2) (Minkowski 2) ψ) (hsub : ψ.source ⊆ axisᶜ) :
    ChartIso E0.causality E0.causality ψ :=
  chartIso_model_of_subset_reg (Xα := fun _ : Unit => E0) (a := ()) (b := ()) (minkowski 2)
    (fun _ => E0.causality) Flat.isom_strongMorphism (fun _ => E0.causallyArcConnected)
    (fun _ => chartIso_of_mem_aeAtlas) hψ (by rw [reg_eq]; exact hsub)

/-- **Non-vacuity.** `E₀` carries a singular `(Isom(𝐌³), 𝐌³)`-structure with a singular point, the
first in lean-causal: its regular locus is `E₀ ∖ sing₀`, its singular locus the BTZ line, every
sector chart is a chart of it, and the hypotheses (a) and (b) of
`existsUnique_causality_singularGX_dec25` hold at the single model `E₀` (`hreg` by the model-free
lemma). -/
theorem singularGX_nonvacuous :
    Reg (Flat.isom 2) (Minkowski 2) E0 = axisᶜ ∧
    Sing (Flat.isom 2) (Minkowski 2) E0 = singE0 0 ∧
    (Sing (Flat.isom 2) (Minkowski 2) E0).Nonempty ∧
    (∀ (y : E0) (hy : y.2 ≠ 0), sectorChart y hy ∈ aeAtlas (Flat.isom 2) (Minkowski 2) E0) ∧
    -- (a)
    (minkowski 2).CausallyArcConnected ∧
    (∀ g : Flat.isom 2, StrongMorphism (minkowski 2) (minkowski 2) fun p => g • p) ∧
    -- (b)
    E0.causality.CausallyArcConnected ∧
    (∀ r ∈ aeAtlas (Flat.isom 2) (Minkowski 2) E0, ChartIso E0.causality (minkowski 2) r) := by
  exact ⟨reg_eq, sing_eq_singE0_zero, sing_nonempty,
    fun y hy => sectorAtlas_subset_aeAtlas (sectorChart_mem_sectorAtlas hy),
    minkowski_causallyArcConnected, Flat.isom_strongMorphism, E0.causallyArcConnected,
    chartIso_of_mem_aeAtlas⟩

end E0GX

/-! ### The model-free lemma needs its support condition: a counterexample

On `ℂ` with the translations, `segCausality F` relates `x` to `y` in `U` when `y` is reached from
`x` by a horizontal rightward segment inside `U` avoiding `F` (and every point to itself); its
chronology is empty. With `DX = segCausality ∅` and `DY = segCausality {0}`, the chart
`id` on `ℂ ∖ {0}` is a chart isomorphism, generates an a.e. atlas whose maximal atlas contains
`id` on `ℂ`, and `id` is not a chart isomorphism: `-1 ≤ 1` in `DX`, not in `DY`. -/

namespace AESupportCounterexample

/-- The horizontal segment from `x` rightward to the abscissa of `y`. -/
def hseg (x y : ℂ) : Set ℂ := {z | z.im = x.im ∧ z.re ∈ Icc x.re y.re}

/-- The causal relation of `segCausality F` in `U`. -/
def SegRel (F : Set ℂ) (U : Opens ℂ) (x y : ℂ) : Prop :=
  x ∈ U ∧ y ∈ U ∧
    (x = y ∨ (x.im = y.im ∧ x.re < y.re ∧ hseg x y ⊆ U ∧ Disjoint (hseg x y) F))

/-- **Horizontal causality avoiding `F`**, with empty chronology. -/
def segCausality (F : Set ℂ) : Causality ℂ where
  le := SegRel F
  lt _ _ _ := False
  le_mem_left h := h.1
  le_mem_right h := h.2.1
  lt_mem_left h := h.elim
  lt_mem_right h := h.elim
  le_refl hx := ⟨hx, hx, Or.inl rfl⟩
  le_trans := by
    intro U x y z h₁ h₂
    obtain ⟨hx, -, h₁⟩ := h₁
    obtain ⟨-, hz, h₂⟩ := h₂
    refine ⟨hx, hz, ?_⟩
    rcases h₁ with rfl | ⟨i₁, r₁, s₁, d₁⟩
    · exact h₂
    rcases h₂ with rfl | ⟨i₂, r₂, s₂, d₂⟩
    · exact Or.inr ⟨i₁, r₁, s₁, d₁⟩
    have hsub : hseg x z ⊆ hseg x y ∪ hseg y z := by
      rintro w ⟨hw, hw1, hw2⟩
      by_cases h : w.re ≤ y.re
      · exact Or.inl ⟨hw, hw1, h⟩
      · exact Or.inr ⟨hw.trans i₁, (not_le.1 h).le, hw2⟩
    exact Or.inr ⟨i₁.trans i₂, r₁.trans r₂, hsub.trans (union_subset s₁ s₂),
      Disjoint.mono_left hsub (disjoint_union_left.2 ⟨d₁, d₂⟩)⟩
  lt_trans h _ := h.elim
  le_mono := by
    intro U V hVU x y h
    obtain ⟨hx, hy, h⟩ := h
    exact ⟨hVU hx, hVU hy, h.imp id fun h' => ⟨h'.1, h'.2.1, fun z hz => hVU (h'.2.2.1 hz),
      h'.2.2.2⟩⟩
  lt_mono _ _ _ h := h
  le_of_lt h := h.elim
  isOpen_lt_right _ _ := by simp
  isOpen_lt_left _ _ := by simp

/-- `segCausality F` is absolutely minimal on every open set: a horizontal segment is a chain of
short ones (Lebesgue number, `exists_subdivision_Icc`). -/
theorem absolutelyMinimalOn_segCausality (F : Set ℂ) (W : Opens ℂ) :
    (segCausality F).AbsolutelyMinimalOn W := by
  intro S hS V hV x y
  refine ⟨fun hxy => ?_, fun hxy => hxy.elim⟩
  obtain ⟨hx, hy, h⟩ := hxy
  rcases h with rfl | ⟨hi, hr, hsV, hdF⟩
  · obtain ⟨O, hO, hxO⟩ := hS x (hV hx)
    exact Relation.TransGen.single ⟨O, hO, ⟨hx, hxO⟩, ⟨hx, hxO⟩, Or.inl rfl⟩
  set γ : ℝ → ℂ := fun t => (t : ℂ) + (x.im : ℂ) * Complex.I with hγdef
  have hγre : ∀ t, (γ t).re = t := fun t => by simp [hγdef]
  have hγim : ∀ t, (γ t).im = x.im := fun t => by simp [hγdef]
  have hγ : Continuous γ := Complex.continuous_ofReal.add continuous_const
  have hγeq : ∀ w : ℂ, w.im = x.im → γ w.re = w := fun w hw =>
    Complex.ext (hγre _) (by rw [hγim, hw])
  have hγmem : ∀ t ∈ Icc x.re y.re, γ t ∈ hseg x y := fun t ht =>
    ⟨hγim t, by rw [hγre]; exact ht⟩
  have hcov : Icc x.re y.re ⊆ ⋃ O : S, γ ⁻¹' ((O : Opens ℂ) : Set ℂ) := fun t ht => by
    obtain ⟨O, hO, hO'⟩ := hS (γ t) (hV (hsV (hγmem t ht)))
    exact mem_iUnion.2 ⟨⟨O, hO⟩, hO'⟩
  obtain ⟨τ, hτ0, hτm, ⟨m, hm⟩, hτI, hτO⟩ :=
    exists_subdivision_Icc hr.le (fun O : S => (O.1.isOpen.preimage hγ)) hcov
  have hstep : ∀ n, ∃ O ∈ S, (segCausality F).le (V ⊓ O) (γ (τ n)) (γ (τ (n + 1))) := by
    intro n
    obtain ⟨⟨O, hO⟩, hsub⟩ := hτO n
    refine ⟨O, hO, ?_⟩
    have hn : τ n ≤ τ (n + 1) := hτm (Nat.le_succ n)
    have hI : ∀ t ∈ Icc (τ n) (τ (n + 1)), t ∈ Icc x.re y.re := fun t ht =>
      ⟨(hτI n).1.trans ht.1, ht.2.trans (hτI (n + 1)).2⟩
    have hmem : ∀ t ∈ Icc (τ n) (τ (n + 1)), γ t ∈ V ⊓ O := fun t ht =>
      ⟨hsV (hγmem t (hI t ht)), hsub ht⟩
    refine ⟨hmem _ ⟨le_rfl, hn⟩, hmem _ ⟨hn, le_rfl⟩, ?_⟩
    rcases hn.lt_or_eq with hlt | heq
    · have hseg_sub : hseg (γ (τ n)) (γ (τ (n + 1))) ⊆ γ '' Icc (τ n) (τ (n + 1)) := by
        rintro w ⟨hw1, hw2⟩
        rw [hγim] at hw1
        rw [hγre, hγre] at hw2
        exact ⟨w.re, hw2, hγeq w hw1⟩
      refine Or.inr ⟨by rw [hγim, hγim], by rw [hγre, hγre]; exact hlt, ?_, ?_⟩
      · rintro _ hw
        obtain ⟨t, ht, rfl⟩ := hseg_sub hw
        exact hmem t ht
      · refine Disjoint.mono_left (hseg_sub.trans ?_) hdF
        rintro _ ⟨t, ht, rfl⟩
        exact hγmem t (hI t ht)
    · exact Or.inl (by rw [heq])
  have hchain : ∀ n, Relation.ReflTransGen
      (fun a b => ∃ O ∈ S, (segCausality F).le (V ⊓ O) a b) x (γ (τ n)) := by
    intro n
    induction n with
    | zero => rw [hτ0, hγeq x rfl]
    | succ n ih => exact ih.tail (hstep n)
  have hym : γ (τ m) = y := by rw [hm m le_rfl, hγeq y hi.symm]
  have hc := hchain m
  rw [hym] at hc
  rcases Relation.reflTransGen_iff_eq_or_transGen.1 hc with h | h
  · exact absurd (congrArg Complex.re h) (ne_of_gt hr)
  · exact h

theorem absolutelyMinimal_segCausality (F : Set ℂ) : (segCausality F).AbsolutelyMinimal :=
  Precausality.absolutelyMinimal_iff.2 (absolutelyMinimalOn_segCausality F ⊤)

/-- The translations act by strong morphisms of `segCausality ∅`. -/
theorem strongMorphism_segCausality_empty (g : Multiplicative ℂ) :
    StrongMorphism (segCausality ∅) (segCausality ∅) fun p => g • p := by
  have hφ : ∀ p : ℂ, g • p = Multiplicative.toAdd g + p := fun _ => rfl
  refine ⟨continuous_const_smul g, isOpenMap_smul g, fun U V hV x y h => ?_, fun _ _ _ _ _ h =>
    h.elim⟩
  have hVU : ∀ {z : ℂ}, z ∈ V → g • z ∈ U := fun {z} hz => by
    have : z ∈ (V : Set ℂ) := hz
    rw [hV] at this; exact this
  obtain ⟨hx, hy, h⟩ := h
  refine ⟨hVU hx, hVU hy, ?_⟩
  rcases h with rfl | ⟨i, r, sV, -⟩
  · exact Or.inl rfl
  refine Or.inr ⟨?_, ?_, fun w hw => ?_, disjoint_empty _⟩
  · rw [hφ, hφ, Complex.add_im, Complex.add_im, i]
  · rw [hφ, hφ, Complex.add_re, Complex.add_re]; linarith
  · obtain ⟨hw1, hw2, hw3⟩ := hw
    rw [hφ, Complex.add_im] at hw1
    rw [hφ, Complex.add_re] at hw2
    rw [hφ, Complex.add_re] at hw3
    have hmem : w - Multiplicative.toAdd g ∈ hseg x y :=
      ⟨by rw [Complex.sub_im]; linarith, by rw [Complex.sub_re]; linarith,
        by rw [Complex.sub_re]; linarith⟩
    have := hVU (sV hmem)
    rwa [hφ, add_sub_cancel] at this

/-- The translations of `ℂ` act rigidly (by affine maps). -/
theorem isRigidAction_translation : IsRigidAction (Multiplicative ℂ) ℂ :=
  isRigidAction_of_affine fun g =>
    ⟨(AffineEquiv.constVAdd ℝ ℂ (Multiplicative.toAdd g)).toAffineMap, fun _ => rfl⟩

attribute [local instance] isRigidAction_translation

/-- `ℂ ∖ {0}` is portly in `ℂ`. -/
theorem isPortly_compl_zero : IsPortly ({0}ᶜ : Set ℂ) := by
  have hopen : IsOpen ({0}ᶜ : Set ℂ) := isOpen_compl_singleton
  have hd : Dense ({0}ᶜ : Set ℂ) := dense_compl_singleton 0
  refine ⟨hopen, hd, fun W hW hWc => ?_⟩
  refine isPreconnected_of_local hWc inter_subset_left
    (fun x hx => hW.inter_closure ⟨hx, hd x⟩) fun x hx => ?_
  by_cases hx0 : x = 0
  · subst hx0
    obtain ⟨ε, hε, hεW⟩ := Metric.isOpen_iff.1 hW 0 hx
    refine ⟨Metric.ball 0 ε, Metric.isOpen_ball, Metric.mem_ball_self hε, ?_⟩
    have heq : Metric.ball (0 : ℂ) ε ∩ (W ∩ {0}ᶜ) = Metric.ball 0 ε \ {0} := by
      ext z
      simp only [mem_inter_iff, Set.mem_sdiff, mem_compl_iff]
      exact ⟨fun h => ⟨h.1, h.2.2⟩, fun h => ⟨h.1, hεW h.1, h.2⟩⟩
    rw [heq]
    exact E0GX.isPreconnected_ball_diff_zero ε
  · refine ⟨connectedComponentIn (W ∩ {0}ᶜ) x, (hW.inter hopen).connectedComponentIn,
      mem_connectedComponentIn ⟨hx, hx0⟩, ?_⟩
    rw [inter_eq_left.2 (connectedComponentIn_subset _ _)]
    exact isPreconnected_connectedComponentIn

/-- The generating chart: the identity of `ℂ ∖ {0}`. -/
noncomputable def puncturedChart : OpenPartialHomeomorph ℂ ℂ :=
  OpenPartialHomeomorph.ofSet {0}ᶜ isOpen_compl_singleton

theorem isAEAtlas_puncturedChart :
    IsAEAtlas (Multiplicative ℂ) ({puncturedChart} : Set (OpenPartialHomeomorph ℂ ℂ)) := by
  have hsupp : support ({puncturedChart} : Set (OpenPartialHomeomorph ℂ ℂ)) = {0}ᶜ := by
    ext x
    rw [mem_support]
    constructor
    · rintro ⟨e, he, hx⟩
      rw [mem_singleton_iff.1 he] at hx; exact hx
    · intro hx; exact ⟨_, mem_singleton _, hx⟩
  refine ⟨isGXAtlas_of_eventually fun e he e' he' x _ => ⟨1, Eventually.of_forall fun z => ?_⟩,
    by rw [hsupp]; exact isPortly_compl_zero⟩
  rw [mem_singleton_iff.1 he, mem_singleton_iff.1 he', one_smul]

theorem chartIso_puncturedChart :
    ChartIso (segCausality {0}) (segCausality ∅) puncturedChart := by
  intro U hU x _ y _
  have hU' : (U : Set ℂ) ⊆ {0}ᶜ := hU
  have himg : chartImage puncturedChart U = U := by
    apply SetLike.coe_injective
    rw [coe_chartImage_of_le hU]
    exact image_id _
  rw [himg]
  refine ⟨?_, Iff.rfl⟩
  show SegRel {0} U x y ↔ SegRel ∅ U x y
  constructor
  · rintro ⟨hx, hy, h⟩
    exact ⟨hx, hy, h.imp id fun h' => ⟨h'.1, h'.2.1, h'.2.2.1, disjoint_empty _⟩⟩
  · rintro ⟨hx, hy, h⟩
    refine ⟨hx, hy, h.imp id fun h' => ⟨h'.1, h'.2.1, h'.2.2.1, ?_⟩⟩
    rw [disjoint_singleton_right]
    intro h0
    exact hU' (h'.2.2.1 h0) rfl

theorem refl_mem_maximalAEAtlas :
    OpenPartialHomeomorph.refl ℂ ∈
      maximalAEAtlas (Multiplicative ℂ) ({puncturedChart} : Set (OpenPartialHomeomorph ℂ ℂ)) := by
  have hid : ∀ e ∈ insert (OpenPartialHomeomorph.refl ℂ)
      ({puncturedChart} : Set (OpenPartialHomeomorph ℂ ℂ)), ∀ z, e z = z := by
    rintro e (rfl | he) z
    · rfl
    · rw [mem_singleton_iff.1 he]; rfl
  have hGX : IsGXAtlas (Multiplicative ℂ) (insert (OpenPartialHomeomorph.refl ℂ)
      ({puncturedChart} : Set (OpenPartialHomeomorph ℂ ℂ))) :=
    isGXAtlas_of_eventually fun e he e' he' _ _ =>
      ⟨1, Eventually.of_forall fun z => by rw [hid e he, hid e' he', one_smul]⟩
  have hB : IsAEAtlas (Multiplicative ℂ) (insert (OpenPartialHomeomorph.refl ℂ)
      ({puncturedChart} : Set (OpenPartialHomeomorph ℂ ℂ))) :=
    ⟨hGX, isAEAtlas_puncturedChart.2.mono (support_mono (subset_insert _ _)) (isOpen_support _)⟩
  exact subset_maximalAEAtlas hB (hGX.isThinner_completion_of_subset (subset_insert _ _))
    (mem_insert _ _)

theorem not_chartIso_refl :
    ¬ ChartIso (segCausality {0}) (segCausality ∅) (OpenPartialHomeomorph.refl ℂ) := by
  intro h
  have hmem : ∀ z : ℂ, z ∈ chartImage (OpenPartialHomeomorph.refl ℂ) ⊤ := fun z =>
    mem_chartImage_of_mem (mem_univ z) trivial
  have hR : (segCausality ∅).le (chartImage (OpenPartialHomeomorph.refl ℂ) ⊤) (-1) 1 :=
    ⟨hmem _, hmem _, Or.inr ⟨by simp, by norm_num, fun z _ => hmem z, disjoint_empty _⟩⟩
  obtain ⟨-, -, h'⟩ := ((h ⊤ (fun z _ => mem_univ z) (-1) trivial 1 trivial).1).2 hR
  rcases h' with h' | ⟨-, -, -, hd⟩
  · have := congrArg Complex.re h'
    norm_num at this
  · have h0 : (0 : ℂ) ∈ hseg (-1) 1 := ⟨by simp, by norm_num, by norm_num⟩
    exact disjoint_left.1 hd h0 (mem_singleton 0)

/-- **The model-free lemma fails without its support condition** (the roadmap's wording): an a.e.
atlas of chart isomorphisms, the group acting by strong morphisms, `DY` absolutely minimal (on
every open set, and `DX` too), and a chart of the maximal a.e. atlas which is not a chart
isomorphism. Its source meets the complement of the generating support, where `DY` is free. -/
theorem counterexample :
    IsAEAtlas (Multiplicative ℂ) ({puncturedChart} : Set (OpenPartialHomeomorph ℂ ℂ)) ∧
    (∀ a ∈ ({puncturedChart} : Set (OpenPartialHomeomorph ℂ ℂ)),
      ChartIso (segCausality {0}) (segCausality ∅) a) ∧
    (∀ g : Multiplicative ℂ, StrongMorphism (segCausality ∅) (segCausality ∅) fun p => g • p) ∧
    (segCausality {0}).AbsolutelyMinimal ∧
    (∀ W : Opens ℂ, (segCausality {0}).AbsolutelyMinimalOn W) ∧
    (∀ W : Opens ℂ, (segCausality ∅).AbsolutelyMinimalOn W) ∧
    OpenPartialHomeomorph.refl ℂ ∈
      maximalAEAtlas (Multiplicative ℂ) ({puncturedChart} : Set (OpenPartialHomeomorph ℂ ℂ)) ∧
    ¬ ChartIso (segCausality {0}) (segCausality ∅) (OpenPartialHomeomorph.refl ℂ) :=
  ⟨isAEAtlas_puncturedChart, fun a ha => by rw [mem_singleton_iff.1 ha]; exact chartIso_puncturedChart,
    strongMorphism_segCausality_empty, absolutelyMinimal_segCausality _,
    absolutelyMinimalOn_segCausality _, absolutelyMinimalOn_segCausality _,
    refl_mem_maximalAEAtlas, not_chartIso_refl⟩

end AESupportCounterexample

end Causal
