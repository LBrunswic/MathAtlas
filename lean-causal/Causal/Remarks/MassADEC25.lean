namespace Causal

open Set TopologicalSpace Topology

universe u v w y z

section Atlas

variable {G : Type w} {X : Type v} [TopologicalSpace X] [Group G] [MulAction G X]
  {M : Type u} [TopologicalSpace M] [SingularGXStructure G X M]
  {A : Type z} {Xα : A → Type y} [∀ a, TopologicalSpace (Xα a)]
  [∀ a, SingularGXStructure G X (Xα a)]

variable (G) in
/-- **The natural causality of a singular `(G,X)`-manifold over its DEC-25 atlas**: every chart of
the maximal a.e. atlas is an isomorphism onto `X`, every `X_A`-chart (`IsAEChart` into a model) an
isomorphism onto its model, and the causality is absolutely minimal. -/
def IsAtlasCausalityDEC25 (C : Causality M) (DX : Causality X) (DY : ∀ a, Causality (Xα a)) :
    Prop :=
  (∀ e ∈ aeAtlas G X M, ChartIso C DX e) ∧
    (∀ a (e : OpenPartialHomeomorph M (Xα a)), IsAEChart G X e → ChartIso C (DY a) e) ∧
    C.AbsolutelyMinimal

variable (G) in
/-- **The isomorphic charts cover `M`**: at every point, some chart of the maximal a.e. atlas or
some `X_A`-chart is an isomorphism for `C` (the hypothesis of the uniqueness half of
`existsUnique_causality_singularGX_dec25`). -/
def IsoChartsCoverDEC25 (C : Causality M) (DX : Causality X) (DY : ∀ a, Causality (Xα a)) :
    Prop :=
  ∀ x : M, (∃ e ∈ aeAtlas G X M, x ∈ e.source ∧ ChartIso C DX e) ∨
    ∃ a, ∃ e : OpenPartialHomeomorph M (Xα a), IsAEChart G X e ∧ x ∈ e.source ∧
      ChartIso C (DY a) e

/-- The natural causality has isomorphic charts at every point, once the `X_A`-charts cover the
singular locus. -/
theorem IsAtlasCausalityDEC25.isoChartsCover {C : Causality M} {DX : Causality X}
    {DY : ∀ a, Causality (Xα a)} (hC : IsAtlasCausalityDEC25 G C DX DY)
    (hcov : ∀ x ∈ Sing G X M, ∃ a, ∃ e : OpenPartialHomeomorph M (Xα a), IsAEChart G X e ∧
      x ∈ e.source) :
    IsoChartsCoverDEC25 G C DX DY := by
  intro x
  by_cases hx : x ∈ Reg G X M
  · obtain ⟨e, he, hxe⟩ := mem_support.1 hx
    exact Or.inl ⟨e, he, hxe, hC.1 e he⟩
  · obtain ⟨a, e, he, hxe⟩ := hcov x hx
    exact Or.inr ⟨a, e, he, hxe, hC.2.1 a e he⟩

variable (G X M) in
/-- The charts of the maximal a.e. atlas, as an index type. -/
abbrev AtlasIndexDEC25 : Type (max u v) := {e : OpenPartialHomeomorph M X // e ∈ aeAtlas G X M}

variable (G X M Xα) in
/-- The `X_A`-charts, as an index type. -/
abbrev ModelChartIndexDEC25 : Type (max z u y) :=
  Σ a, {e : OpenPartialHomeomorph M (Xα a) // IsAEChart G X e}

/-- **The bridge to `Causal.Remarks.MassiveManifold`**: the natural causality of the DEC-25 atlas
is `IsAtlasCausality` for the family of all charts of the maximal a.e. atlas (`I`) and all
`X_A`-charts (`J`), lifted to a common universe. -/
theorem isAtlasCausalityDEC25_iff {C : Causality M} {DX : Causality X}
    {DY : ∀ a, Causality (Xα a)} :
    IsAtlasCausalityDEC25 G C DX DY ↔
      IsAtlasCausality C (fun i : ULift.{max y z} (AtlasIndexDEC25 G X M) => i.down.1)
        (fun j : ULift.{v} (ModelChartIndexDEC25 G X M Xα) => j.down.1) (fun j => j.down.2.1)
        DX DY := by
  constructor
  · rintro ⟨hX, hY, hmin⟩
    exact ⟨fun i => hX i.down.1 i.down.2, fun j => hY j.down.1 j.down.2.1 j.down.2.2, hmin⟩
  · rintro ⟨hX, hY, hmin⟩
    exact ⟨fun e he => hX ⟨⟨e, he⟩⟩, fun a e he => hY ⟨⟨a, e, he⟩⟩, hmin⟩

/-- The charts which are isomorphisms for `C`, as the two index families of
`Causal.IsAtlasCausality`: for an absolutely minimal `C` whose isomorphic charts cover `M`, they
form an atlas for which `C` is `IsAtlasCausality`, and they cover `M`. -/
theorem isAtlasCausality_isoCharts {C : Causality M} {DX : Causality X}
    {DY : ∀ a, Causality (Xα a)} (hmin : C.AbsolutelyMinimal)
    (hcover : IsoChartsCoverDEC25 G C DX DY) :
    IsAtlasCausality C
        (fun i : ULift.{max y z} {e : OpenPartialHomeomorph M X //
          e ∈ aeAtlas G X M ∧ ChartIso C DX e} => i.down.1)
        (fun j : ULift.{v} (Σ a, {e : OpenPartialHomeomorph M (Xα a) //
          IsAEChart G X e ∧ ChartIso C (DY a) e}) => j.down.1)
        (fun j => j.down.2.1) DX DY ∧
      ∀ x : M, (∃ i : ULift.{max y z} {e : OpenPartialHomeomorph M X //
          e ∈ aeAtlas G X M ∧ ChartIso C DX e}, x ∈ i.down.1.source) ∨
        ∃ j : ULift.{v} (Σ a, {e : OpenPartialHomeomorph M (Xα a) //
          IsAEChart G X e ∧ ChartIso C (DY a) e}), x ∈ j.down.2.1.source := by
  refine ⟨⟨fun i => i.down.2.2, fun j => j.down.2.2.2, hmin⟩, fun x => ?_⟩
  rcases hcover x with ⟨e, he, hxe, hiso⟩ | ⟨a, e, he, hxe, hiso⟩
  · exact Or.inl ⟨⟨⟨e, he, hiso⟩⟩, hxe⟩
  · exact Or.inr ⟨⟨⟨a, e, he, hiso⟩⟩, hxe⟩

/-- **`cor:massA_cac` under DEC-25, local form**: an absolutely minimal causality for which some
chart at every point is an isomorphism, with causally arc-connected models, is causally
arc-connected. Neither `hreg` nor (b′) is used, nor the action of `G`. -/
theorem massA_cac_dec25_of_isoChartsCover {C : Causality M} {DX : Causality X}
    {DY : ∀ a, Causality (Xα a)} (ha : DX.CausallyArcConnected)
    (hb : ∀ a, (DY a).CausallyArcConnected) (hmin : C.AbsolutelyMinimal)
    (hcover : IsoChartsCoverDEC25 G C DX DY) : C.CausallyArcConnected := by
  obtain ⟨hC, hcov⟩ := isAtlasCausality_isoCharts hmin hcover
  exact massA_cac hcov ha hb hC

/-- **`cor:massA_cac` under DEC-25**: the natural causality of a singular `(G,X)`-manifold whose
singular points lie in `X_A`-charts, with causally arc-connected models, is causally
arc-connected. -/
theorem massA_cac_dec25 {C : Causality M} {DX : Causality X} {DY : ∀ a, Causality (Xα a)}
    (ha : DX.CausallyArcConnected) (hb : ∀ a, (DY a).CausallyArcConnected)
    (hcov : ∀ x ∈ Sing G X M, ∃ a, ∃ e : OpenPartialHomeomorph M (Xα a), IsAEChart G X e ∧
      x ∈ e.source)
    (hC : IsAtlasCausalityDEC25 G C DX DY) : C.CausallyArcConnected :=
  massA_cac_dec25_of_isoChartsCover ha hb hC.2.2 (hC.isoChartsCover hcov)

/-- **`cor:pushup_sing` under DEC-25, local form**: if moreover the models have the push-up
property, so has the causality. -/
theorem pushup_sing_dec25_of_isoChartsCover {C : Causality M} {DX : Causality X}
    {DY : ∀ a, Causality (Xα a)} (ha : DX.CausallyArcConnected)
    (hb : ∀ a, (DY a).CausallyArcConnected) (hpX : DX.PushUp) (hpY : ∀ a, (DY a).PushUp)
    (hmin : C.AbsolutelyMinimal) (hcover : IsoChartsCoverDEC25 G C DX DY) : C.PushUp := by
  obtain ⟨hC, hcov⟩ := isAtlasCausality_isoCharts hmin hcover
  exact pushup_sing hcov ha hb hpX hpY hC

/-- **`cor:pushup_sing` under DEC-25**: the natural causality of a singular `(G,X)`-manifold whose
singular points lie in `X_A`-charts, with causally arc-connected push-up models, has the push-up
property. -/
theorem pushup_sing_dec25 {C : Causality M} {DX : Causality X} {DY : ∀ a, Causality (Xα a)}
    (ha : DX.CausallyArcConnected) (hb : ∀ a, (DY a).CausallyArcConnected)
    (hpX : DX.PushUp) (hpY : ∀ a, (DY a).PushUp)
    (hcov : ∀ x ∈ Sing G X M, ∃ a, ∃ e : OpenPartialHomeomorph M (Xα a), IsAEChart G X e ∧
      x ∈ e.source)
    (hC : IsAtlasCausalityDEC25 G C DX DY) : C.PushUp :=
  pushup_sing_dec25_of_isoChartsCover ha hb hpX hpY hC.2.2 (hC.isoChartsCover hcov)

/-- **The uniqueness half of `cor:massA_causalite` under DEC-25**: an absolutely minimal causality
`C'` for which some chart at every point is an isomorphism is the natural causality `C`. No
hypothesis on the models: neither (a), (b), `hreg` nor (b′). -/
theorem massA_causalite_unique_dec25 {C C' : Causality M} {DX : Causality X}
    {DY : ∀ a, Causality (Xα a)} (hC : IsAtlasCausalityDEC25 G C DX DY)
    (hmin' : C'.AbsolutelyMinimal) (hcover' : IsoChartsCoverDEC25 G C' DX DY) : C' = C := by
  refine eq_of_agreeOn_locally hmin' hC.2.2 fun x => ?_
  rcases hcover' x with ⟨e, he, hxe, h'⟩ | ⟨a, e, he, hxe, h'⟩
  · exact ⟨chartSource e, hxe, fun V hV y z => h'.agree (hC.1 e he) hV y z⟩
  · exact ⟨chartSource e, hxe, fun V hV y z => h'.agree (hC.2.1 a e he) hV y z⟩

/-- **The uniqueness half of `cor:massA_causalite` under DEC-25, symmetric form**: two natural
causalities of a singular `(G,X)`-manifold whose singular points lie in `X_A`-charts are equal. -/
theorem IsAtlasCausalityDEC25.eq {C C' : Causality M} {DX : Causality X}
    {DY : ∀ a, Causality (Xα a)}
    (hcov : ∀ x ∈ Sing G X M, ∃ a, ∃ e : OpenPartialHomeomorph M (Xα a), IsAEChart G X e ∧
      x ∈ e.source)
    (hC : IsAtlasCausalityDEC25 G C DX DY) (hC' : IsAtlasCausalityDEC25 G C' DX DY) : C' = C :=
  massA_causalite_unique_dec25 hC hC'.2.2 (hC'.isoChartsCover hcov)

variable [ContinuousConstSMul G X] [LocallyConnectedSpace X]

/-- **The existence half of `cor:massA_causalite` under DEC-25**, with `hreg` (the second half of
(b)) and (b′) (`hiso`, OQ-64) as named hypotheses: a corollary of
`existsUnique_causality_singularGX_dec25`. -/
theorem massA_causalite_dec25 (DX : Causality X) (DY : ∀ a, Causality (Xα a))
    (ha : DX.CausallyArcConnected) (hG : ∀ g : G, StrongMorphism DX DX fun p => g • p)
    (hb : ∀ a, (DY a).CausallyArcConnected)
    (hreg : ∀ a, ∀ r ∈ aeAtlas G X (Xα a), ChartIso (DY a) DX r)
    (hiso : ∀ a b (ψ : OpenPartialHomeomorph (Xα a) (Xα b)), IsAEChart G X ψ →
      ChartIso (DY a) (DY b) ψ)
    (hcov : ∀ x ∈ Sing G X M, ∃ a, ∃ e : OpenPartialHomeomorph M (Xα a), IsAEChart G X e ∧
      x ∈ e.source) :
    ∃ C : Causality M, IsAtlasCausalityDEC25 G C DX DY ∧
      ∀ C' : Causality M, C'.AbsolutelyMinimal → IsoChartsCoverDEC25 G C' DX DY → C' = C := by
  obtain ⟨C, hCX, hCY, hmin, -⟩ :=
    existsUnique_causality_singularGX_dec25 DX DY ha hG hb hreg hiso hcov
  have hC : IsAtlasCausalityDEC25 G C DX DY := ⟨hCX, hCY, hmin⟩
  exact ⟨C, hC, fun C' hmin' hcover' => massA_causalite_unique_dec25 hC hmin' hcover'⟩

/-- **The existence half of `cor:massA_causalite` is exactly (b′)** (OQ-64), for abstract models:
under (a) and (b) (`hreg` included), every singular `(G,X)`-manifold in the universe of the models
whose singular points lie in `X_A`-charts carries a natural causality if and only if every a.e.
isomorphism between open subsets of the models is an isomorphism of topological spacetimes. From
`forall_exists_causality_singularGX_iff` and `massA_causalite_dec25`. -/
theorem forall_exists_isAtlasCausalityDEC25_iff (DX : Causality X) (DY : ∀ a, Causality (Xα a))
    (ha : DX.CausallyArcConnected) (hG : ∀ g : G, StrongMorphism DX DX fun p => g • p)
    (hb : ∀ a, (DY a).CausallyArcConnected)
    (hreg : ∀ a, ∀ r ∈ aeAtlas G X (Xα a), ChartIso (DY a) DX r) :
    (∀ (N : Type y) [TopologicalSpace N] [SingularGXStructure G X N],
      (∀ x ∈ Sing G X N, ∃ a, ∃ e : OpenPartialHomeomorph N (Xα a), IsAEChart G X e ∧
        x ∈ e.source) →
      ∃ C : Causality N, IsAtlasCausalityDEC25 G C DX DY) ↔
      ∀ a b (ψ : OpenPartialHomeomorph (Xα a) (Xα b)), IsAEChart G X ψ →
        ChartIso (DY a) (DY b) ψ := by
  constructor
  · intro h
    refine (forall_exists_causality_singularGX_iff DX DY ha hG hb hreg).1 fun N _ _ hcov => ?_
    obtain ⟨C, hC⟩ := h N hcov
    exact ⟨C, hC.1, hC.2.1⟩
  · intro hiso N _ _ hcov
    obtain ⟨C, hC, -⟩ := massA_causalite_dec25 (M := N) DX DY ha hG hb hreg hiso hcov
    exact ⟨C, hC⟩

/-- **The three corollaries under DEC-25, assembled**: under (a), (b), `hreg`, (b′) and the push-up
of the models, the natural causality exists, is unique, causally arc-connected and push-up. -/
theorem massA_singular_dec25 (DX : Causality X) (DY : ∀ a, Causality (Xα a))
    (ha : DX.CausallyArcConnected) (hG : ∀ g : G, StrongMorphism DX DX fun p => g • p)
    (hb : ∀ a, (DY a).CausallyArcConnected)
    (hreg : ∀ a, ∀ r ∈ aeAtlas G X (Xα a), ChartIso (DY a) DX r)
    (hiso : ∀ a b (ψ : OpenPartialHomeomorph (Xα a) (Xα b)), IsAEChart G X ψ →
      ChartIso (DY a) (DY b) ψ)
    (hpX : DX.PushUp) (hpY : ∀ a, (DY a).PushUp)
    (hcov : ∀ x ∈ Sing G X M, ∃ a, ∃ e : OpenPartialHomeomorph M (Xα a), IsAEChart G X e ∧
      x ∈ e.source) :
    ∃ C : Causality M, IsAtlasCausalityDEC25 G C DX DY ∧
      (∀ C' : Causality M, C'.AbsolutelyMinimal → IsoChartsCoverDEC25 G C' DX DY → C' = C) ∧
      C.CausallyArcConnected ∧ C.PushUp := by
  obtain ⟨C, hC, huniq⟩ := massA_causalite_dec25 DX DY ha hG hb hreg hiso hcov
  exact ⟨C, hC, huniq, massA_cac_dec25 ha hb hcov hC, pushup_sing_dec25 ha hb hpX hpY hcov hC⟩

end Atlas

/-! ### The model spaces of `E^{1,2}_{≥0}` -/

section Models

/-- **The model spaces of `E^{1,2}_{≥0}`** (`ETT.tex:1324–1331`): `E₀` (the extreme BTZ model,
`Causal.E0`) at `none`, `E_κ` (`Causal.Massive κ`) at `some κ`, `κ > 0`. -/
abbrev MassAModel : Option {κ : ℝ // 0 < κ} → Type
  | none => E0
  | some κ => Massive κ.1

noncomputable instance instTopologicalSpaceMassAModel : ∀ o, TopologicalSpace (MassAModel o)
  | none => inferInstanceAs (TopologicalSpace E0)
  | some κ => inferInstanceAs (TopologicalSpace (Massive κ.1))

/-- The causalities of the model spaces (`defi:causal_Ealpha`, `defi:causal_E0`). -/
noncomputable def massAModelCausality : ∀ o, Causality (MassAModel o)
  | none => E0.causality
  | some κ => massiveOf κ

/-- **The model facts of `E^{1,2}_{≥0}`, every one discharged**: each model `E_κ`, `κ ≥ 0`, is
causally arc-connected (`cor:model_minimal`'s premise) and has the push-up property
(`rem:pushup`). -/
theorem massAModel_facts (o : Option {κ : ℝ // 0 < κ}) :
    (massAModelCausality o).CausallyArcConnected ∧ (massAModelCausality o).PushUp := by
  rcases o with _ | κ
  · exact ⟨E0.causallyArcConnected, E0LM.e0_pushUp⟩
  · exact ⟨@massive_causallyArcConnected κ.1 ⟨κ.2⟩, @massive_pushUp κ.1 ⟨κ.2⟩⟩

variable {G : Type w} [Group G] [MulAction G (Minkowski 2)] {M : Type u} [TopologicalSpace M]
  [SingularGXStructure G (Minkowski 2) M] [∀ o, SingularGXStructure G (Minkowski 2) (MassAModel o)]

/-- **`cor:massA_cac` and `cor:pushup_sing` for the models of `E^{1,2}_{≥0}`, local form**, their
singular `(G, E^{1,2})`-structures abstract and `G` any group acting on `E^{1,2}` (`Isom(E^{1,2})`
in the paper; its action is not used): an absolutely minimal causality on a singular
`(G, E^{1,2})`-manifold for which some chart at each point (of the maximal a.e. atlas, or into some
`E_κ`, `κ ≥ 0`) is an isomorphism is causally arc-connected and has the push-up property. No model
hypothesis is left, and no covering hypothesis: the isomorphic charts cover. -/
theorem massA_dec25_models_of_isoChartsCover {C : Causality M} (hmin : C.AbsolutelyMinimal)
    (hcover : IsoChartsCoverDEC25 G C (minkowski 2) massAModelCausality) :
    C.CausallyArcConnected ∧ C.PushUp :=
  ⟨massA_cac_dec25_of_isoChartsCover (minkowski_model_facts 2).1
      (fun o => (massAModel_facts o).1) hmin hcover,
    pushup_sing_dec25_of_isoChartsCover (minkowski_model_facts 2).1
      (fun o => (massAModel_facts o).1) (minkowski_model_facts 2).2.1
      (fun o => (massAModel_facts o).2) hmin hcover⟩

/-- **`cor:massA_cac`, `cor:pushup_sing` and the uniqueness half of `cor:massA_causalite` for the
models of `E^{1,2}_{≥0}`**, their singular `(G, E^{1,2})`-structures abstract, `G` any group acting
on `E^{1,2}`: the natural causality of an `E_{≥0}`-manifold (DEC-25) is causally arc-connected, has
the push-up property, and is the only absolutely minimal causality with an isomorphic chart at
every point. No model hypothesis is left. -/
theorem massA_dec25_models
    (hcov : ∀ x ∈ Sing G (Minkowski 2) M, ∃ o,
      ∃ e : OpenPartialHomeomorph M (MassAModel o), IsAEChart G (Minkowski 2) e ∧ x ∈ e.source)
    {C : Causality M} (hC : IsAtlasCausalityDEC25 G C (minkowski 2) massAModelCausality) :
    C.CausallyArcConnected ∧ C.PushUp ∧
      ∀ C' : Causality M, C'.AbsolutelyMinimal →
        IsoChartsCoverDEC25 G C' (minkowski 2) massAModelCausality → C' = C :=
  ⟨(massA_dec25_models_of_isoChartsCover hC.2.2 (hC.isoChartsCover hcov)).1,
    (massA_dec25_models_of_isoChartsCover hC.2.2 (hC.isoChartsCover hcov)).2,
    fun _ hmin' hcover' => massA_causalite_unique_dec25 hC hmin' hcover'⟩

end Models

section ModelsIsom

variable {M : Type u} [TopologicalSpace M] [SingularGXStructure (Flat.isom 2) (Minkowski 2) M]
  [∀ o, SingularGXStructure (Flat.isom 2) (Minkowski 2) (MassAModel o)]

/-- **The three corollaries for the models of `E^{1,2}_{≥0}`**, `G = Isom(E^{1,2})`
(`Causal.Flat.isom 2`), the singular structures of the models abstract: with every model fact
discharged ((a): `minkowski_model_facts`; (b), causal arc-connectedness, and push-up:
`massAModel_facts`), the only hypotheses left are `hreg` (the second half of (b)) and (b′) at the
models, which depend on their singular structures (not built here), and the covering of the
singular locus by `X_A`-charts. -/
theorem massA_singular_dec25_models
    (hreg : ∀ o, ∀ r ∈ aeAtlas (Flat.isom 2) (Minkowski 2) (MassAModel o),
      ChartIso (massAModelCausality o) (minkowski 2) r)
    (hiso : ∀ o o' (ψ : OpenPartialHomeomorph (MassAModel o) (MassAModel o')),
      IsAEChart (Flat.isom 2) (Minkowski 2) ψ →
        ChartIso (massAModelCausality o) (massAModelCausality o') ψ)
    (hcov : ∀ x ∈ Sing (Flat.isom 2) (Minkowski 2) M, ∃ o,
      ∃ e : OpenPartialHomeomorph M (MassAModel o), IsAEChart (Flat.isom 2) (Minkowski 2) e ∧
        x ∈ e.source) :
    ∃ C : Causality M, IsAtlasCausalityDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality ∧
      (∀ C' : Causality M, C'.AbsolutelyMinimal →
        IsoChartsCoverDEC25 (Flat.isom 2) C' (minkowski 2) massAModelCausality → C' = C) ∧
      C.CausallyArcConnected ∧ C.PushUp := by
  have hm := minkowski_model_facts 2
  exact massA_singular_dec25 (minkowski 2) massAModelCausality hm.1 hm.2.2
    (fun o => (massAModel_facts o).1) hreg hiso hm.2.1 (fun o => (massAModel_facts o).2) hcov

/-- **The existence half of `cor:massA_causalite` for the models of `E^{1,2}_{≥0}` is exactly (b′)
at the models** (OQ-64), given `hreg`: every singular `(Isom(E^{1,2}), E^{1,2})`-manifold whose
singular points lie in `X_A`-charts into the `E_κ`, `κ ≥ 0`, carries a natural causality if and
only if every a.e. isomorphism between open subsets of the `E_κ` is an isomorphism of topological
spacetimes. -/
theorem forall_exists_massA_dec25_models_iff
    (hreg : ∀ o, ∀ r ∈ aeAtlas (Flat.isom 2) (Minkowski 2) (MassAModel o),
      ChartIso (massAModelCausality o) (minkowski 2) r) :
    (∀ (N : Type) [TopologicalSpace N] [SingularGXStructure (Flat.isom 2) (Minkowski 2) N],
      (∀ x ∈ Sing (Flat.isom 2) (Minkowski 2) N, ∃ o,
        ∃ e : OpenPartialHomeomorph N (MassAModel o), IsAEChart (Flat.isom 2) (Minkowski 2) e ∧
          x ∈ e.source) →
      ∃ C : Causality N, IsAtlasCausalityDEC25 (Flat.isom 2) C (minkowski 2) massAModelCausality) ↔
      ∀ o o' (ψ : OpenPartialHomeomorph (MassAModel o) (MassAModel o')),
        IsAEChart (Flat.isom 2) (Minkowski 2) ψ →
          ChartIso (massAModelCausality o) (massAModelCausality o') ψ :=
  forall_exists_isAtlasCausalityDEC25_iff (minkowski 2) massAModelCausality
    (minkowski_model_facts 2).1 (minkowski_model_facts 2).2.2 (fun o => (massAModel_facts o).1)
    hreg

end ModelsIsom

/-! ### The hypotheses are satisfiable -/

section Line

attribute [local instance] lineSingularGX

/-- **Witness** (kb/0011): `ℝ` with the translations and the timelike line, one model space `ℝ`
(as in `singularGX_dec25_line`; the singular locus is empty). The timelike line is the natural
causality of the DEC-25 atlas, and the theorems of this file apply to it: it is causally
arc-connected, has push-up, and is the only absolutely minimal causality with an isomorphic chart at
every point. -/
theorem massA_dec25_line :
    IsAtlasCausalityDEC25 (Multiplicative ℝ) timelikeLine timelikeLine
        (fun _ : Unit => timelikeLine) ∧
      timelikeLine.CausallyArcConnected ∧ timelikeLine.PushUp ∧
      ∀ C' : Causality ℝ, C'.AbsolutelyMinimal →
        IsoChartsCoverDEC25 (Multiplicative ℝ) C' timelikeLine (fun _ : Unit => timelikeLine) →
          C' = timelikeLine := by
  obtain ⟨hcac, -, -, hreg, hiso, hsing, -⟩ := singularGX_dec25_line
  have hC : IsAtlasCausalityDEC25 (Multiplicative ℝ) timelikeLine timelikeLine
      (fun _ : Unit => timelikeLine) :=
    ⟨hreg (), fun _ e he => hiso () () e he, hcac.absolutelyMinimal⟩
  have hcov : ∀ x ∈ Sing (Multiplicative ℝ) ℝ ℝ, ∃ _ : Unit,
      ∃ e : OpenPartialHomeomorph ℝ ℝ, IsAEChart (Multiplicative ℝ) ℝ e ∧ x ∈ e.source :=
    fun x hx => by
      rw [hsing] at hx
      exact absurd hx (notMem_empty x)
  exact ⟨hC, massA_cac_dec25 hcac (fun _ => hcac) hcov hC,
    pushup_sing_dec25 hcac (fun _ => hcac) timelikeLine_pushUp (fun _ => timelikeLine_pushUp)
      hcov hC,
    fun C' hmin' hcover' => massA_causalite_unique_dec25 hC hmin' hcover'⟩

end Line

section MinkowskiWitness

/-- `E^{1,2}` with `Isom(E^{1,2})` (`Causal.Flat.isom 2`) as a singular `(G,X)`-manifold: the
maximal atlas of its regular structure (one chart, the identity); no singular point. -/
noncomputable abbrev minkowskiSingularGX :
    SingularGXStructure (Flat.isom 2) (Minkowski 2) (Minkowski 2) :=
  SingularGXStructure.ofHasGroupoid (Flat.isom 2) (Minkowski 2) (Minkowski 2)

attribute [local instance] minkowskiSingularGX

/-- **Witness at the paper's `(G, X) = (Isom(E^{1,2}), E^{1,2})`** (kb/0011): `M = E^{1,2}`, one
model space `E^{1,2}` with the same structure and causality. `minkowski 2` is the natural causality
of the DEC-25 atlas (every chart of the maximal a.e. atlas and every `X_A`-chart an isomorphism:
(b′) holds at regular sources, `chartIso_model_of_subset_reg`), so the theorems of this file apply:
it is causally arc-connected, has push-up, and is the only absolutely minimal causality with an
isomorphic chart at every point. The model is not an `E_κ` with a singular line: those are witnessed in
`Causal.Remarks.MassAModelsInstance` (`massA_dec25_models_e0`, `epi_witness`). -/
theorem massA_dec25_minkowski :
    IsAtlasCausalityDEC25 (Flat.isom 2) (minkowski 2) (minkowski 2)
        (fun _ : Unit => minkowski 2) ∧
      (minkowski 2).CausallyArcConnected ∧ (minkowski 2).PushUp ∧
      ∀ C' : Causality (Minkowski 2), C'.AbsolutelyMinimal →
        IsoChartsCoverDEC25 (Flat.isom 2) C' (minkowski 2) (fun _ : Unit => minkowski 2) →
          C' = minkowski 2 := by
  have hreg : ∀ r ∈ aeAtlas (Flat.isom 2) (Minkowski 2) (Minkowski 2),
      ChartIso (minkowski 2) (minkowski 2) r :=
    fun r hr => chartIso_of_mem_maximalAtlas minkowski_causallyArcConnected
      Flat.isom_strongMorphism
      (fun e he => by rw [chartedSpaceSelf_atlas.1 he]; exact chartIso_refl _)
      minkowski_absolutelyMinimal hr
  have hR : Reg (Flat.isom 2) (Minkowski 2) (Minkowski 2) = univ := by
    rw [Reg]
    exact support_maximalAtlas
  have hiso : ∀ (_ : Unit) (ψ : OpenPartialHomeomorph (Minkowski 2) (Minkowski 2)),
      IsAEChart (Flat.isom 2) (Minkowski 2) ψ → ChartIso (minkowski 2) (minkowski 2) ψ :=
    fun _ ψ hψ => chartIso_model_of_subset_reg (Xα := fun _ : Unit => Minkowski 2) (a := ())
      (b := ()) (minkowski 2) (fun _ => minkowski 2) Flat.isom_strongMorphism
      (fun _ => minkowski_causallyArcConnected) (fun _ => hreg) hψ
      (by rw [hR]; exact subset_univ _)
  have hC : IsAtlasCausalityDEC25 (Flat.isom 2) (minkowski 2) (minkowski 2)
      (fun _ : Unit => minkowski 2) := ⟨hreg, hiso, minkowski_absolutelyMinimal⟩
  have hcov : ∀ x ∈ Sing (Flat.isom 2) (Minkowski 2) (Minkowski 2), ∃ _ : Unit,
      ∃ e : OpenPartialHomeomorph (Minkowski 2) (Minkowski 2),
        IsAEChart (Flat.isom 2) (Minkowski 2) e ∧ x ∈ e.source := fun x hx => by
    have : x ∈ Reg (Flat.isom 2) (Minkowski 2) (Minkowski 2) := by rw [hR]; exact mem_univ x
    exact absurd this hx
  exact ⟨hC, massA_cac_dec25 minkowski_causallyArcConnected
      (fun _ => minkowski_causallyArcConnected) hcov hC,
    pushup_sing_dec25 minkowski_causallyArcConnected (fun _ => minkowski_causallyArcConnected)
      minkowski_pushUp (fun _ => minkowski_pushUp) hcov hC,
    fun C' hmin' hcover' => massA_causalite_unique_dec25 hC hmin' hcover'⟩

end MinkowskiWitness

/-! ### « Natural » needs absolute minimality: the two lines under DEC-25 -/

section TwoLines

attribute [local instance] lineSingularGX

/-- A chart composed with a chart of the maximal a.e. atlas of its target: if `e : M ⇀ N` is an
a.e. isomorphism chart and `φ` a chart of the maximal a.e. atlas of `N`, `e ≫ φ` is a chart of the
maximal a.e. atlas of `M` (maximality, `IsMaximalAEAtlas.mem_of_compatible`). -/
theorem IsAEChart.trans_chart_mem_aeAtlas {G : Type w} {X : Type v} [TopologicalSpace X] [Group G]
    [MulAction G X] [ContinuousConstSMul G X] [LocallyConnectedSpace X] [IsRigidAction G X]
    {M : Type u}
    [TopologicalSpace M] [SingularGXStructure G X M] {N : Type y} [TopologicalSpace N]
    [SingularGXStructure G X N] {e : OpenPartialHomeomorph M N} (he : IsAEChart G X e)
    {φ : OpenPartialHomeomorph N X} (hφ : φ ∈ aeAtlas G X N) : e.trans φ ∈ aeAtlas G X M := by
  apply (isMaximalAEAtlas_aeAtlas G X M).mem_of_compatible
  intro c hc z hz
  have hzR : z ∈ Reg G X M := mem_support.2 ⟨c, hc, hz.2⟩
  have hzs : z ∈ e.source ∧ e z ∈ φ.source := by
    have := hz.1
    rw [OpenPartialHomeomorph.trans_source] at this
    exact this
  obtain ⟨g, hg⟩ := he.regularOn.exists_smul_eq z ⟨hzs.1, hzR⟩ c hc φ hφ hz.2 hzs.2
  exact ⟨g⁻¹, hg.mono fun w hw => by
    rw [OpenPartialHomeomorph.coe_trans, Function.comp_apply, hw, inv_smul_smul]⟩

/-- `ℝ ⊔ ℝ`, charted by its two copies of `ℝ` (`Causal.twoLinesAtlas`), as a singular
`(G,X)`-manifold for the translations of `ℝ`: the maximal atlas of its `(G,X)`-structure, which is a
maximal a.e. atlas; no singular point. -/
noncomputable abbrev twoLinesSingularGX : SingularGXStructure (Multiplicative ℝ) ℝ (ℝ ⊕ ℝ) :=
  letI := twoLinesAtlas
  haveI := twoLinesAtlas_hasGroupoid
  SingularGXStructure.ofHasGroupoid (Multiplicative ℝ) ℝ (ℝ ⊕ ℝ)

attribute [local instance] twoLinesSingularGX

/-- **Without absolute minimality the natural causality is not unique, under DEC-25 too**
(OQ-18). `ℝ ⊔ ℝ`, a singular `(G,X)`-manifold for the translations of the timelike line with no
singular point, and one model space `ℝ` with the same structure and causality: the absolutely
minimal causality `C` of `GX_maximal_not_unique` is natural (`IsAtlasCausalityDEC25`), and a
second causality `C' ≠ C`, not absolutely minimal (`≤_M` enlarged to all pairs, non-local,
kb/0014), makes every chart of the maximal a.e. atlas and every `X_A`-chart an isomorphism as
well. So the uniqueness half of `cor:massA_causalite` holds among absolutely minimal causalities
(`massA_causalite_unique_dec25`) and not among all, in the library's gluing-free reading of
`defi:causalite`. -/
theorem twoLines_dec25_not_unique :
    Sing (Multiplicative ℝ) ℝ (ℝ ⊕ ℝ) = ∅ ∧
      ∃ C C' : Causality (ℝ ⊕ ℝ), C ≠ C' ∧
        IsAtlasCausalityDEC25 (Multiplicative ℝ) C timelikeLine (fun _ : Unit => timelikeLine) ∧
        ¬ C'.AbsolutelyMinimal ∧
        (∀ e ∈ aeAtlas (Multiplicative ℝ) ℝ (ℝ ⊕ ℝ), ChartIso C' timelikeLine e) ∧
        ∀ (_ : Unit) (e : OpenPartialHomeomorph (ℝ ⊕ ℝ) ℝ), IsAEChart (Multiplicative ℝ) ℝ e →
          ChartIso C' timelikeLine e := by
  obtain ⟨-, -, C, C', hne, hmin, hmin', hiso⟩ := GX_maximal_not_unique
  have hrefl : OpenPartialHomeomorph.refl ℝ ∈ aeAtlas (Multiplicative ℝ) ℝ ℝ := by
    rw [aeAtlas_line]
    exact StructureGroupoid.subset_maximalAtlas _ (chartedSpaceSelf_atlas.2 rfl)
  have hA : ∀ e : OpenPartialHomeomorph (ℝ ⊕ ℝ) ℝ, IsAEChart (Multiplicative ℝ) ℝ e →
      e ∈ aeAtlas (Multiplicative ℝ) ℝ (ℝ ⊕ ℝ) := fun e he => by
    have := he.trans_chart_mem_aeAtlas hrefl
    rwa [OpenPartialHomeomorph.trans_refl] at this
  have hsing : Sing (Multiplicative ℝ) ℝ (ℝ ⊕ ℝ) = ∅ := by
    letI := twoLinesAtlas
    haveI := twoLinesAtlas_hasGroupoid
    rw [Sing, compl_empty_iff]
    exact support_maximalAtlas
  exact ⟨hsing, C, C', hne, ⟨fun e he => (hiso e he).1, fun _ e he => (hiso e (hA e he)).1, hmin⟩,
    hmin', fun e he => (hiso e he).2, fun _ e he => (hiso e (hA e he)).2⟩

end TwoLines

end Causal
