namespace Causal

open Set TopologicalSpace Topology Relation

universe u v w

/-! ### The gluing clause -/

section Clause

variable {M : Type u} [TopologicalSpace M]

namespace Precausality

/-- The **gluing axiom** of `defi:causalite`'s sheaf clause: for every open `U` and every cover
of `U` by open sets, the relations of `U` are generated by those of the members (each step a
relation of some `U ∩ O`). The converse inclusion is axiom (b). -/
def CoverGluing (P : Precausality M) : Prop :=
  ∀ (U : Opens M) (S : Set (Opens M)), (∀ x ∈ U, ∃ O ∈ S, x ∈ O) → ∀ x y : M,
    (P.le U x y → TransGen (fun a b => ∃ O ∈ S, P.le (U ⊓ O) a b) x y) ∧
    (P.lt U x y → TransGen (fun a b => ∃ O ∈ S, P.lt (U ⊓ O) a b) x y)

/-- The **hereditary form** of gluing: absolutely minimal on every open set. -/
def Glues (P : Precausality M) : Prop := ∀ W : Opens M, P.AbsolutelyMinimalOn W

variable {P : Precausality M}

/-- The hereditary form is the gluing axiom asked at every open set. -/
theorem glues_iff_coverGluing : P.Glues ↔ P.CoverGluing := by
  constructor
  · intro h U S hS x y
    exact h U S hS U le_rfl x y
  · intro h W S hS V hV x y
    exact h V S (fun z hz => hS z (hV hz)) x y

/-- Gluing gives absolute minimality (`def:topological_space_causality_absolutely`). -/
theorem Glues.absolutelyMinimal (h : P.Glues) : P.AbsolutelyMinimal :=
  absolutelyMinimal_iff.2 (h ⊤)

end Precausality

/-- A **glued causality** (`defi:causalite` read with gluing, DEC-167): a causality of the
library (the "equivalently" form) whose relations glue on every open set. -/
structure GluedCausality (M : Type u) [TopologicalSpace M] extends Causality M where
  /-- The gluing clause, hereditary form (OQ-95). -/
  glues : toPrecausality.Glues

end Clause

/-- Two causalities with the same precausality are equal. -/
theorem causality_eq_of_toPrecausality {M : Type u} [TopologicalSpace M] {A B : Causality M}
    (h : A.toPrecausality = B.toPrecausality) : A = B := by
  cases A; cases B; cases h; rfl

namespace GluedCausality

variable {M : Type u} [TopologicalSpace M] {N : Type v} [TopologicalSpace N]

theorem toCausality_injective : Function.Injective (toCausality : GluedCausality M → Causality M) := by
  rintro ⟨C₁, h₁⟩ ⟨C₂, h₂⟩ (rfl : C₁ = C₂)
  rfl

@[ext] theorem ext {C₁ C₂ : GluedCausality M} (h : C₁.toCausality = C₂.toCausality) : C₁ = C₂ :=
  toCausality_injective h

variable (C : GluedCausality M)

/-- **DEC-167: every causality is absolutely minimal.** -/
theorem absolutelyMinimal : C.toPrecausality.AbsolutelyMinimal := C.glues.absolutelyMinimal

theorem absolutelyMinimalOn (W : Opens M) : C.toPrecausality.AbsolutelyMinimalOn W := C.glues W

/-- A causally arc-connected causality glues. -/
def ofCausallyArcConnected (D : Causality M) (hD : D.CausallyArcConnected) : GluedCausality M where
  toCausality := D
  glues := hD.absolutelyMinimalOn_all

/-- A locally causally arc-connected causality absolutely minimal on `M` glues. -/
def ofLocallyCausallyArcConnected (D : Causality M) (hloc : D.LocallyCausallyArcConnected)
    (hmin : D.AbsolutelyMinimal) : GluedCausality M where
  toCausality := D
  glues := hloc.absolutelyMinimalOn hmin

/-- Time reversal. -/
def dual : GluedCausality M where
  toCausality := C.toCausality.dual
  glues W := Precausality.dual_absolutelyMinimalOn.2 (C.glues W)

/-- The restriction to the open set `W`, as a spacetime of its own (`ex:open_subset`). -/
def onOpen (W : Opens M) : GluedCausality W where
  toCausality := (C.toCausality.restrict W).toSubtype
  glues := Causality.restrict_toSubtype_absolutelyMinimalOn_all C.glues W

theorem onOpen_le_iff (W : Opens M) (V : Opens W) (x y : W) :
    (C.onOpen W).le V x y ↔ C.le (imageOpens V) x y := Iff.rfl

theorem onOpen_lt_iff (W : Opens M) (V : Opens W) (x y : W) :
    (C.onOpen W).lt V x y ↔ C.lt (imageOpens V) x y := Iff.rfl

/-- The pull-back along a local homeomorphism (`ex:open_subset`, second sentence). -/
noncomputable def pullback {φ : N → M} (hφ : IsLocalHomeomorph φ) : GluedCausality N where
  toCausality := C.toCausality.pullback hφ.continuous
  glues := C.toCausality.pullback_absolutelyMinimalOn_all_of_isLocalHomeomorph hφ C.glues

end GluedCausality

/-! ### The lines -/

/-- The timelike line glues. -/
def timelikeLineG : GluedCausality ℝ := ⟨timelikeLine, timelikeLine_absolutelyMinimalOn⟩

/-- The lightlike line glues. -/
def lightlikeLineG : GluedCausality ℝ := ⟨lightlikeLine, lightlikeLine_absolutelyMinimalOn⟩

/-! ### `prop:GX_espace_temps_topo` under gluing -/

section GX

variable {M : Type u} {X : Type v} [TopologicalSpace M] [TopologicalSpace X]
  {G : Type w} [Group G] [MulAction G X] [ContinuousConstSMul G X] [ChartedSpace X M]
  [HasGroupoid M (gxGroupoid G X)]

/-- **`prop:GX_espace_temps_topo`, under gluing (DEC-167), uniqueness as printed.** A
`(G,X)`-manifold modelled on a causally arc-connected `X` on which `G` acts by strong morphisms
carries exactly one glued causality for which every chart of the maximal atlas is an isomorphism.
-/
theorem existsUnique_gluedCausality_GX (D : Causality X) (hD : D.CausallyArcConnected)
    (hG : ∀ g : G, StrongMorphism D D fun p => g • p) :
    ∃! C : GluedCausality M,
      ∀ e ∈ (gxGroupoid G X).maximalAtlas M, ChartIso C.toCausality D e := by
  obtain ⟨C, hC, hall, huniq⟩ :=
    existsUnique_causality_GX_absolutelyMinimalOn_all (M := M) (G := G) D hD hG
  exact ⟨⟨C, hall⟩, hC, fun C' hC' => GluedCausality.ext (huniq _ hC' C'.absolutelyMinimal)⟩

/-- The same, the model a glued causality (the paper's "`X` a topological spacetime"). -/
theorem existsUnique_gluedCausality_GX' (D : GluedCausality X)
    (hD : D.CausallyArcConnected)
    (hG : ∀ g : G, StrongMorphism D.toCausality D.toCausality fun p => g • p) :
    ∃! C : GluedCausality M,
      ∀ e ∈ (gxGroupoid G X).maximalAtlas M, ChartIso C.toCausality D.toCausality e :=
  existsUnique_gluedCausality_GX D.toCausality hD hG

end GX

/-! ### `ex:open_subset` under gluing -/

section OpenSubset

variable {M : Type u} [TopologicalSpace M] {N : Type v} [TopologicalSpace N]

/-- **`ex:open_subset`, second sentence, under gluing, as printed**: along a local
homeomorphism `φ : N → M`, `N` carries exactly one glued causality making `φ` a local isomorphism.
-/
theorem existsUnique_gluedCausality_localIsomorphism (C : GluedCausality M) {φ : N → M}
    (hφ : IsLocalHomeomorph φ) :
    ∃! L : GluedCausality N, LocalIsomorphism L.toCausality C.toCausality φ := by
  have h₀ := C.toCausality.pullback_localIsomorphism hφ
  exact ⟨C.pullback hφ, h₀, fun L hL => GluedCausality.ext
    (LocalIsomorphism.unique hL h₀ L.absolutelyMinimal (C.pullback hφ).absolutelyMinimal)⟩

namespace GluedCausality

variable (C : GluedCausality M)

/-- `ex:open_subset`, first sentence, existence: the inclusion of `W` with the restricted glued
causality is a strong morphism. -/
theorem onOpen_strongMorphism (W : Opens M) :
    StrongMorphism (C.onOpen W).toCausality C.toCausality Subtype.val :=
  (LocalCausality.inclusionStrong_iff _ _).1 (C.toCausality.restrict_inclusionStrong W)

/-- The restriction is the **greatest** causality on `W` whose inclusion is a strong morphism. -/
theorem le_onOpen_of_strongMorphism {W : Opens M} {L : Causality W}
    (h : StrongMorphism L C.toCausality Subtype.val) (V : Opens W) (x y : W) :
    (L.le V x y → (C.onOpen W).le V x y) ∧ (L.lt V x y → (C.onOpen W).lt V x y) := by
  have hV : (V : Set W) = Subtype.val ⁻¹' (imageOpens V : Set M) :=
    (Set.preimage_image_eq _ Subtype.val_injective).symm
  exact ⟨fun hxy => h.map_le _ V hV hxy, fun hxy => h.map_lt _ V hV hxy⟩

/-- The restriction is the **unique** causality on `W` whose inclusion is a strong morphism
reflecting the relations. -/
theorem eq_onOpen_of_reflects {W : Opens M} {L : Causality W}
    (h : StrongMorphism L C.toCausality Subtype.val)
    (hrefl : ∀ (V : Opens W) (x y : W), (C.le (imageOpens V) x y → L.le V x y) ∧
      (C.lt (imageOpens V) x y → L.lt V x y)) :
    L = (C.onOpen W).toCausality := by
  have key : L.toPrecausality = (C.onOpen W).toPrecausality := by
    ext V x y
    · exact ⟨(C.le_onOpen_of_strongMorphism h V x y).1, (hrefl V x y).1⟩
    · exact ⟨(C.le_onOpen_of_strongMorphism h V x y).2, (hrefl V x y).2⟩
  exact causality_eq_of_toPrecausality key

/-- The inclusion of `W` with the restricted causality is a local isomorphism. -/
theorem onOpen_localIsomorphism (W : Opens M) :
    LocalIsomorphism (C.onOpen W).toCausality C.toCausality Subtype.val := by
  refine ⟨W.isOpen.isOpenEmbedding_subtypeVal.isLocalHomeomorph, fun _ =>
    ⟨⊤, trivial, Subtype.val_injective.injOn, fun V' _ U hU y _ z _ => ?_⟩⟩
  have hUV : imageOpens V' = U := SetLike.coe_injective (by rw [hU]; rfl)
  subst hUV
  exact ⟨Iff.rfl, Iff.rfl⟩

/-- `ex:open_subset`, first sentence, read through the second (OQ-107 (b)): the restriction is
the unique glued causality on `W` for which the inclusion is a local isomorphism. -/
theorem existsUnique_onOpen_localIsomorphism (W : Opens M) :
    ∃! L : GluedCausality W, LocalIsomorphism L.toCausality C.toCausality Subtype.val :=
  ⟨C.onOpen W, C.onOpen_localIsomorphism W, fun L hL => GluedCausality.ext
    (LocalIsomorphism.unique hL (C.onOpen_localIsomorphism W) L.absolutelyMinimal
      (C.onOpen W).absolutelyMinimal)⟩

/-- Every open subset of a glued causality is, with the restricted causality, absolutely
minimal. -/
theorem onOpen_absolutelyMinimal (W : Opens M) :
    (C.onOpen W).toPrecausality.AbsolutelyMinimal :=
  (C.onOpen W).absolutelyMinimal

end GluedCausality

/-- The diagonal causality of `W`, as a glued causality on `↥W`. -/
def diagonalG (W : Opens M) : GluedCausality W where
  toCausality := (LocalCausality.diagonal W).toSubtype
  glues V' := ((LocalCausality.diagonal W).toSubtype_absolutelyMinimalOn_iff V').2
    (LocalCausality.diagonal_extend_absolutelyMinimalOn _ _)

/-- **`ex:open_subset`, first sentence, uniqueness is FALSE under gluing**: on the timelike line,
the open set `ℝ` carries two distinct glued causalities, the restriction and the diagonal one,
whose inclusion is a strong morphism. -/
theorem not_openSubset_unique :
    ¬ ∀ (C : GluedCausality ℝ) (W : Opens ℝ),
      ∃! L : GluedCausality W, StrongMorphism L.toCausality C.toCausality Subtype.val := by
  intro h
  obtain ⟨L, -, hL⟩ := h timelikeLineG ⊤
  have e₁ := hL (timelikeLineG.onOpen ⊤) (timelikeLineG.onOpen_strongMorphism ⊤)
  have e₂ := hL (diagonalG ⊤)
    ((LocalCausality.inclusionStrong_iff _ _).1 (LocalCausality.diagonal_inclusionStrong _))
  have h₁ : (timelikeLineG.onOpen ⊤).le ⊤ ⟨0, trivial⟩ ⟨1, trivial⟩ := by
    show timelikeLine.le (imageOpens ⊤) 0 1
    rw [GluingGeneric.imageOpens_top]
    exact ⟨zero_le_one, fun _ _ => trivial⟩
  rw [e₁, ← e₂] at h₁
  exact zero_ne_one h₁.1

end OpenSubset

/-! ### `rem:deux_pushup` under gluing -/

section DeuxPushup

/-- Push-up does not imply plainness under gluing: the lightlike line. -/
theorem lightlike_pushUp_not_plain :
    lightlikeLineG.PushUp ∧ ¬ lightlikeLineG.CausallyPlain :=
  ⟨lightlikeLine_pushUp, lightlikeLine_not_causallyPlain⟩

/-- **Under gluing, plainness implies push-up** on every `T1` space. -/
theorem GluedCausality.pushUp_of_causallyPlain {M : Type u} [TopologicalSpace M] [T1Space M]
    (C : GluedCausality M) (hp : C.CausallyPlain) : C.PushUp :=
  Causality.pushUp_of_causallyPlain_of_absolutelyMinimal C.absolutelyMinimal hp

/-- **`rem:deux_pushup`, "neither implies the other", is FALSE under gluing**, already over the
topological spacetimes on `ℝ`: plainness implies push-up. -/
theorem not_deux_pushup_neither :
    ¬ (¬ (∀ C : GluedCausality ℝ, C.PushUp → C.CausallyPlain) ∧
      ¬ (∀ C : GluedCausality ℝ, C.CausallyPlain → C.PushUp)) :=
  fun h => h.2 fun C hp => C.pushUp_of_causallyPlain hp

/-- The strongest true form of `rem:deux_pushup` under gluing, on Hausdorff spaces: plainness
implies push-up, strictly (the lightlike line). -/
theorem deux_pushup_glued :
    (∀ (M : Type u) [TopologicalSpace M] [T1Space M] (C : GluedCausality M),
        C.CausallyPlain → C.PushUp) ∧
      ∃ C : GluedCausality ℝ, C.IsCausal ∧ C.PushUp ∧ ¬ C.CausallyPlain :=
  ⟨fun _ _ _ C hp => C.pushUp_of_causallyPlain hp,
    lightlikeLineG, lightlikeLine_isCausal, lightlikeLine_pushUp, lightlikeLine_not_causallyPlain⟩

/-- The library's no-gluing witness of the converse half does not glue. -/
theorem deuxPushup_not_glues : ¬ deuxPushup.toPrecausality.Glues :=
  fun h => deuxPushup_not_absolutelyMinimal h.absolutelyMinimal

end DeuxPushup

/-! ### `cexemple:point_transparent` under gluing -/

section Transparent

/-- **The transparent-point line does not glue** (hereditary form): it is absolutely minimal on
`ℝ` and not on `ℝ ∖ {0}`. In the hereditary reading it is no topological spacetime. -/
theorem transparentLine_not_glues :
    transparentLine.AbsolutelyMinimal ∧ ¬ transparentLine.toPrecausality.Glues :=
  ⟨transparentLine_absolutelyMinimal, fun h => transparentLine_not_absolutelyMinimalOn (h _)⟩

/-- No glued causality is the transparent-point line. -/
theorem not_exists_gluedCausality_transparentLine :
    ¬ ∃ C : GluedCausality ℝ, C.toCausality = transparentLine := by
  rintro ⟨C, hC⟩
  exact transparentLine_not_glues.2 (hC ▸ C.glues)

/-- In the M-only reading the transparent-point line is a causality whose restriction to
`ℝ ∖ {0}`, as a spacetime of its own, is not absolutely minimal: that reading has no `onOpen`. -/
theorem transparentLine_onOpen_not_absolutelyMinimal :
    transparentLine.AbsolutelyMinimal ∧
      ¬ ((transparentLine.restrict realMinusZero).toSubtype).AbsolutelyMinimal :=
  transparentLine_restrict_toSubtype_not_absolutelyMinimal

/-- `cexemple:point_transparent` re-read under gluing: its assertions about the precausality
(causally plain, absolutely minimal on `ℝ`, its restriction to `ℝ ∖ {0}` not absolutely minimal)
hold, and it is not a glued causality; "absolute minimality is not inherited by open subsets"
fails for every glued causality. -/
theorem point_transparent_glued :
    (transparentLine.CausallyPlain ∧ transparentLine.AbsolutelyMinimal ∧
        ¬ transparentLine.AbsolutelyMinimalOn realMinusZero) ∧
      ¬ transparentLine.toPrecausality.Glues ∧
      ∀ (M : Type u) [TopologicalSpace M] (C : GluedCausality M) (W : Opens M),
        (C.onOpen W).toPrecausality.AbsolutelyMinimal :=
  ⟨point_transparent, transparentLine_not_glues.2, fun _ _ C W => C.onOpen_absolutelyMinimal W⟩

end Transparent

end Causal
