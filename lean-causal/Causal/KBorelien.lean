import Causal.MeasureRemarks
import Causal.Minkowski
import Causal.Subdivision
import Mathlib.MeasureTheory.MeasurableSpace.Card
import Mathlib.MeasureTheory.Constructions.BorelSpace.Real
import Mathlib.MeasureTheory.Constructions.BorelSpace.Complex

/-!
# `rem:K_borelien` is false as printed: a tarentin spacetime whose `K^-(p)` is not Borel

`rem:K_borelien` — `ETT.tex:829`. **Not marked**: the remark's conclusion is false under its
own hypothesis (a sorry-free counterexample, local and causal). Its true forms: with `J^-(p)`
Borel, `Causal.Causality.measurableSet_Kminus` (`Causal.MeasureRemarks`); with causal plainness
or push-up at a point of `Z^-(M)`, `measurableSet_Kminus_of_causallyPlain`,
`measurableSet_Kminus_of_pushUp` (here).

> Definition \ref{defi:futur_continue} presents $K^\pm(p)$ as an intersection over the
> \emph{uncountable} family of sequences converging to $p$, so its measurability is not
> immediate --- yet inner regularity is applied to it in Proposition \ref{prop:cont_ext_cont}.
> Lemma \ref{lem:K_facile} settles the point: if $M$ is tarentin, one may choose a single
> sequence $(p_n)$ with $p\in \ring J^+(p_n)$, and then $K^-(p)$ is a countable union of sets
> open in $J^\pm(p)$, hence a Borel subset of $M$. (`ETT.tex:829–835`)

## The finding (sorry-free)

**Minkowski space with spokes** `spokesCausality A`, on `ℝ × E` (`E` a real normed space,
`A ⊆ E`): `≪_U` is the chronological relation of Minkowski space (`Causal.Static`), and `≤_U` is
generated by `=`, `≪_U` and the **spokes**: in the slice `t = 0`, `(0, z) ≤_U (0, c z)` for
`z ∈ A`, `c ∈ [0, 1]`, when the radial segment `{(0, s z) : s ∈ [c, 1]}` lies in `U`. A spoke
is a spacelike segment travelled towards the origin `o = (0, 0)`.

With `p = (1, 0)`: every `(0, z)`, `z ∈ A`, lies below `o ≪ p`, and near `(0, z)` with `‖z‖ > 1`
the past `J^-(p)` is that of `o` (`spokes_le_origin_of_le`), so `(0, z) ∈ K^-(p)`, directly from
the definition (`spokes_mem_Kminus`); for `z ∉ A`, `(0, z) ∉ J^-(p)` (`spokes_not_le`). Hence on
the slice, outside the unit ball, `K^-(p)` **is** `A` (`spokes_Kminus_slice`). Take `E = ℂ` and
`A` the cone over `{x + i : x ∈ T}` (`coneOver T`), `T ⊆ ℝ` not Borel
(`exists_not_measurableSet_real`, by cardinality): `x ↦ (0, 2x + 2i)` pulls `K^-(p)` back to
`T` (`spokes_measurableSet_of_measurableSet_Kminus`), so `K^-(p)` is not Borel, nor is `J^-(p)`
(`spokes_counterexample`).

The witness is a topological spacetime (`ℝ × ℂ ≅ ℝ³`, second countable, Hausdorff), tarentin
(`spokes_tarentin`), **causal** (`spokes_isCausal`) and **absolutely minimal**
(`spokes_absolutelyMinimal`, `A` being a cone): a local causality, not an artefact of the missing
gluing axiom (kb/0014, kb/0019). So `KBorelienAsPrinted` is false (`not_kBorelienAsPrinted`),
and so is its future form (`not_kBorelienPlusAsPrinted`, by time reversal; the reversed witness
is tarentin, causal and absolutely minimal too, `spokes_counterexample_future`).

## Hypothesis checklist

| paper hypothesis | here |
|---|---|
| `M` a topological spacetime (`ETT.tex:254`): second countable, Hausdorff, `≪` open | ✓ carried by the counterexample (`ℝ × ℂ`, Minkowski's `≪`) |
| `M` tarentin | ✓ carried by the counterexample (`spokes_tarentin`) |
| (not in the remark) a local causality | ✓ the counterexample is absolutely minimal, and causal |
| "hence a Borel subset of `M`" | ✗ refuted (`not_kBorelienAsPrinted`); true with `J^-(p)` Borel (`measurableSet_Kminus`), or causally plain, or push-up, at `p ∈ Z^-(M)` |

## SCOPE (disclosed)

* The remark's argument is correct up to its last step: `K^-(p)` is a countable union of sets
  open in `J^-(p)`, indeed `K^-(p) = J^-(p) ∩ O` with `O` open (`Kminus_eq_inter_isOpen`). The
  last step needs `J^-(p)` Borel, and the counterexample has `J^-(p)` not Borel.
* The witness is neither causally plain nor has push-up (`spokes_counterexample`): it cannot,
  since either gives `K^-(p) = I^-(p)`, open, at every point of `Z^-(M) = M`
  (`prop:tarentin_fort_K`). Strong causality and causal arc-connectedness of the witness are
  not established here.
* Where the paper uses the remark (`prop:cont_ext_cont`, tarentin and globally hyperbolic),
  `J^-(p)` is closed and the true form applies (`measurableSet_K_of_globallyHyperbolic`); the
  library's `prop:cont_ext_cont` does not use the remark at all.
* Off the slice `t = 0` the witness's `J^-(p)` is `(I^-(p) ∪ I^-({0} × A)) ∪ {p}`, Borel
  (prose, not formalized): its non-Borel part lies in a Lebesgue-null slice, so it says nothing
  about measurability for the completion of a measure which does not charge that slice.

Provenance: mathlib `fabf563a` (tag `v4.31.0`), pinned via `lakefile.toml`.
-/

namespace Causal

open Set TopologicalSpace Topology Filter MeasureTheory Relation

/-! ### True forms: `J^-(p)` Borel, or `K^-(p) = I^-(p)` -/

namespace Causality

variable {M : Type*} [TopologicalSpace M] [FirstCountableTopology M] [MeasurableSpace M]
  [OpensMeasurableSpace M] {C : Causality M} {p : M}

/-- `rem:K_borelien`, a true form with no hypothesis on `J^-(p)`: on a **causally plain**
spacetime, at a point strongly tarentin in the past, `K^-(p) = I^-(p)` (`prop:tarentin_fort_K`)
is open, hence Borel. -/
theorem measurableSet_Kminus_of_causallyPlain (hP : C.CausallyPlain) (hp : p ∈ C.Zminus) :
    MeasurableSet (C.Kminus ⊤ {p}) := by
  rw [Kminus_eq_Iminus_of_mem_Zminus hP hp]
  exact C.isOpen_Iminus.measurableSet

/-- `rem:K_borelien`, a true form with no hypothesis on `J^-(p)`: with **push-up**, at a point
strongly tarentin in the past, `K^-(p) = I^-(p)` is open, hence Borel. -/
theorem measurableSet_Kminus_of_pushUp (hP : C.PushUp) (hp : p ∈ C.Zminus) :
    MeasurableSet (C.Kminus ⊤ {p}) := by
  rw [PushUp.Kminus_eq_Iminus hP hp]
  exact C.isOpen_Iminus.measurableSet

end Causality

/-! ### Minkowski space with spokes -/

namespace Spokes

section Base

variable {E : Type*} [NormedAddCommGroup E]

/-- The reflexive chronological relation of Minkowski space in `U`. -/
def base (U : Set (ℝ × E)) (x y : ℝ × E) : Prop := (x = y ∧ x ∈ U) ∨ staticLt U x y

namespace base

variable {U V : Set (ℝ × E)} {x y z : ℝ × E}

theorem mem_left (h : base U x y) : x ∈ U := by
  rcases h with ⟨-, h⟩ | h
  exacts [h, h.staticLe.mem_left]

theorem mem_right (h : base U x y) : y ∈ U := by
  rcases h with ⟨rfl, h⟩ | h
  exacts [h, h.staticLe.mem_right]

theorem trans (h₁ : base U x y) (h₂ : base U y z) : base U x z := by
  rcases h₁ with ⟨rfl, -⟩ | h₁
  · exact h₂
  · rcases h₂ with ⟨rfl, -⟩ | h₂
    · exact Or.inr h₁
    · exact Or.inr (h₁.trans h₂)

theorem mono (h : base V x y) (hVU : V ⊆ U) : base U x y := by
  rcases h with ⟨rfl, h⟩ | h
  exacts [Or.inl ⟨rfl, hVU h⟩, Or.inr (h.mono hVU)]

theorem fst_le (h : base U x y) : x.1 ≤ y.1 := by
  rcases h with ⟨rfl, -⟩ | h
  exacts [le_rfl, h.1.le]

/-- Two points of one time slice are related by `base` only if they are equal. -/
theorem eq_of_fst_eq (h : base U x y) (he : x.1 = y.1) : x = y := by
  rcases h with ⟨rfl, -⟩ | h
  · rfl
  · exact absurd he h.1.ne

end base

end Base

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- A **spoke step** in `U`: in the slice `t = 0`, from `(0, z)` with `z ∈ A` to `(0, c z)`,
`c ∈ [0, 1]`, along a radial segment lying in `U`. -/
def rel (A : Set E) (U : Set (ℝ × E)) (a b : ℝ × E) : Prop :=
  a.1 = 0 ∧ b.1 = 0 ∧ a.2 ∈ A ∧
    ∃ c ∈ Icc (0 : ℝ) 1, b.2 = c • a.2 ∧ ∀ s ∈ Icc c 1, ((0 : ℝ), s • a.2) ∈ U

/-- The causal relation in `U`: a chronological step, or a spoke between two chronological
steps. -/
def le (A : Set E) (U : Set (ℝ × E)) (x y : ℝ × E) : Prop :=
  base U x y ∨ ∃ a b, base U x a ∧ rel A U a b ∧ base U b y

namespace rel

variable {A : Set E} {U V : Set (ℝ × E)} {a b d : ℝ × E}

theorem mem_left (h : rel A U a b) : a ∈ U := by
  obtain ⟨ha, -, -, c, hc, -, hU⟩ := h
  have := hU 1 ⟨hc.2, le_rfl⟩
  rwa [one_smul, ← ha] at this

theorem mem_right (h : rel A U a b) : b ∈ U := by
  obtain ⟨-, hb, -, c, hc, hbc, hU⟩ := h
  have := hU c ⟨le_rfl, hc.2⟩
  rwa [← hbc, ← hb] at this

theorem mono (h : rel A V a b) (hVU : V ⊆ U) : rel A U a b := by
  obtain ⟨ha, hb, hA, c, hc, hbc, hU⟩ := h
  exact ⟨ha, hb, hA, c, hc, hbc, fun s hs => hVU (hU s hs)⟩

theorem trans (h₁ : rel A U a b) (h₂ : rel A U b d) : rel A U a d := by
  obtain ⟨ha, hb, hA, c, hc, hbc, hU⟩ := h₁
  obtain ⟨-, hd, -, c', hc', hdc, hU'⟩ := h₂
  refine ⟨ha, hd, hA, c' * c, ⟨mul_nonneg hc'.1 hc.1, mul_le_one₀ hc'.2 hc.1 hc.2⟩, ?_,
    fun s hs => ?_⟩
  · rw [hdc, hbc, smul_smul]
  · rcases le_or_gt c s with hcs | hsc
    · exact hU s ⟨hcs, hs.2⟩
    · have hc0 : 0 < c := lt_of_le_of_lt ((mul_nonneg hc'.1 hc.1).trans hs.1) hsc
      have := hU' (s / c) ⟨(le_div_iff₀ hc0).2 hs.1, (div_le_one hc0).2 hsc.le⟩
      rwa [hbc, smul_smul, div_mul_cancel₀ s hc0.ne'] at this

/-- A spoke step in `M` is a spoke step without segment condition. -/
theorem univ_iff : rel A univ a b ↔
    a.1 = 0 ∧ b.1 = 0 ∧ a.2 ∈ A ∧ ∃ c ∈ Icc (0 : ℝ) 1, b.2 = c • a.2 := by
  constructor
  · rintro ⟨ha, hb, hA, c, hc, hbc, -⟩
    exact ⟨ha, hb, hA, c, hc, hbc⟩
  · rintro ⟨ha, hb, hA, c, hc, hbc⟩
    exact ⟨ha, hb, hA, c, hc, hbc, fun _ _ => mem_univ _⟩

/-- Two opposite spoke steps are trivial. -/
theorem eq_of_rel (h₁ : rel A U a b) (h₂ : rel A U b a) : a = b := by
  obtain ⟨ha, hb, -, c, hc, hbc, -⟩ := h₁
  obtain ⟨-, -, -, c', hc', hac, -⟩ := h₂
  refine Prod.ext (ha.trans hb.symm) ?_
  have h0 : (1 - c' * c) • a.2 = 0 := by
    rw [sub_smul, one_smul, ← smul_smul, ← hbc, ← hac, sub_self]
  rcases smul_eq_zero.1 h0 with h | h
  · have hcc : c = 1 := by
      have : c' * c ≤ c := mul_le_of_le_one_left hc.1 hc'.2
      linarith [hc.2]
    rw [hbc, hcc, one_smul]
  · rw [hbc, h, smul_zero]

end rel

namespace le

variable {A : Set E} {U V : Set (ℝ × E)} {x y z : ℝ × E}

theorem mem_left (h : le A U x y) : x ∈ U := by
  rcases h with h | ⟨a, b, h, -, -⟩
  exacts [h.mem_left, h.mem_left]

theorem mem_right (h : le A U x y) : y ∈ U := by
  rcases h with h | ⟨a, b, -, -, h⟩
  exacts [h.mem_right, h.mem_right]

theorem trans (h₁ : le A U x y) (h₂ : le A U y z) : le A U x z := by
  rcases h₁ with h₁ | ⟨a, b, hxa, hab, hby⟩
  · rcases h₂ with h₂ | ⟨a', b', hya', ha'b', hb'z⟩
    · exact Or.inl (h₁.trans h₂)
    · exact Or.inr ⟨a', b', h₁.trans hya', ha'b', hb'z⟩
  · rcases h₂ with h₂ | ⟨a', b', hya', ha'b', hb'z⟩
    · exact Or.inr ⟨a, b, hxa, hab, hby.trans h₂⟩
    · have hba' : b = a' := (hby.trans hya').eq_of_fst_eq (by rw [hab.2.1, ha'b'.1])
      subst hba'
      exact Or.inr ⟨a, b', hxa, hab.trans ha'b', hb'z⟩

theorem mono (h : le A V x y) (hVU : V ⊆ U) : le A U x y := by
  rcases h with h | ⟨a, b, h₁, h₂, h₃⟩
  exacts [Or.inl (h.mono hVU), Or.inr ⟨a, b, h₁.mono hVU, h₂.mono hVU, h₃.mono hVU⟩]

/-- Time does not decrease along `≤`. -/
theorem fst_le (h : le A U x y) : x.1 ≤ y.1 := by
  rcases h with h | ⟨a, b, h₁, h₂, h₃⟩
  · exact h.fst_le
  · have := h₁.fst_le
    have := h₃.fst_le
    linarith [h₂.1, h₂.2.1]

end le

end Spokes

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

variable (E) in
/-- The point `p = (1, 0)` of `ℝ × E`. -/
def spokesP : ℝ × E := (1, 0)

/-- **Minkowski space with spokes along `A`**: `≪_U` is the chronological relation of Minkowski
space `ℝ × E`; `≤_U` is generated by `=`, `≪_U` and the spokes `(0, z) → (0, c z)`, `z ∈ A`,
`c ∈ [0, 1]`, whose radial segment lies in `U`. -/
noncomputable def spokesCausality (A : Set E) : Causality (ℝ × E) where
  le U x y := Spokes.le A (U : Set (ℝ × E)) x y
  lt U x y := staticLt (U : Set (ℝ × E)) x y
  le_mem_left h := h.mem_left
  le_mem_right h := h.mem_right
  lt_mem_left h := h.staticLe.mem_left
  lt_mem_right h := h.staticLe.mem_right
  le_refl hx := Or.inl (Or.inl ⟨rfl, hx⟩)
  le_trans h₁ h₂ := h₁.trans h₂
  lt_trans h₁ h₂ := h₁.trans h₂
  le_mono hVU _ _ h := h.mono hVU
  lt_mono hVU _ _ h := h.mono hVU
  le_of_lt h := Or.inl (Or.inr h)
  isOpen_lt_right U x := (staticCausality E).isOpen_lt_right U x
  isOpen_lt_left U x := (staticCausality E).isOpen_lt_left U x

namespace spokesCausality

variable {A : Set E} {U : Opens (ℝ × E)} {x y : ℝ × E}

theorem le_iff : (spokesCausality A).le U x y ↔ Spokes.le A (U : Set (ℝ × E)) x y := Iff.rfl

theorem lt_iff : (spokesCausality A).lt U x y ↔ staticLt (U : Set (ℝ × E)) x y := Iff.rfl

/-- `≪` is that of Minkowski space. -/
theorem lt_eq : (spokesCausality A).lt = (staticCausality E).lt := rfl

theorem le_top_iff : (spokesCausality A).le ⊤ x y ↔ Spokes.le A univ x y := by
  rw [le_iff, Opens.coe_top]

theorem lt_top_iff : (spokesCausality A).lt ⊤ x y ↔ ‖y.2 - x.2‖ < y.1 - x.1 := by
  rw [lt_iff, Opens.coe_top, staticLt_univ_iff, dist_comm, dist_eq_norm]

end spokesCausality

/-! ### `K^-(p)` on the slice `t = 0` -/

section Kminus

variable {A : Set E}

/-- A spoke point lies in the causal past of the origin. -/
theorem spokes_le_origin {z : E} (hz : z ∈ A) :
    (spokesCausality A).le ⊤ ((0 : ℝ), z) (0, 0) := by
  rw [spokesCausality.le_top_iff]
  refine Or.inr ⟨((0 : ℝ), z), (0, 0), Or.inl ⟨rfl, mem_univ _⟩, ?_, Or.inl ⟨rfl, mem_univ _⟩⟩
  exact Spokes.rel.univ_iff.2 ⟨rfl, rfl, hz, 0, ⟨le_rfl, zero_le_one⟩, (zero_smul ℝ z).symm⟩

/-- The origin lies in the chronological past of `p = (1, 0)`. -/
theorem spokes_origin_lt : (spokesCausality A).lt ⊤ ((0 : ℝ), (0 : E)) (spokesP E) := by
  rw [spokesCausality.lt_top_iff]
  simp [spokesP]

/-- **Near a spoke point outside the unit ball, the past of `p` is that of the origin.** -/
theorem spokes_le_origin_of_le {x : ℝ × E} (h : (spokesCausality A).le ⊤ x (spokesP E))
    (hx : 1 + |x.1| < ‖x.2‖) : (spokesCausality A).le ⊤ x (0, 0) := by
  rw [spokesCausality.le_top_iff] at h ⊢
  rcases h with (⟨rfl, -⟩ | h) | ⟨a, b, hxa, hab, -⟩
  · exact absurd hx (by norm_num [spokesP])
  · have := h.dist_lt
    rw [dist_eq_norm] at this
    simp only [spokesP, sub_zero] at this
    linarith [le_abs_self x.1, neg_abs_le x.1]
  · obtain ⟨ha, -, hA, -⟩ := hab
    refine Or.inr ⟨a, (0, 0), hxa, ?_, Or.inl ⟨rfl, mem_univ _⟩⟩
    exact Spokes.rel.univ_iff.2 ⟨ha, rfl, hA, 0, ⟨le_rfl, zero_le_one⟩, (zero_smul ℝ a.2).symm⟩

/-- Off the spokes and outside the open unit ball, a point of the slice `t = 0` is not in the
causal past of `p`. -/
theorem spokes_not_le {z : E} (hz : z ∉ A) (h1 : 1 ≤ ‖z‖) :
    ¬ (spokesCausality A).le ⊤ ((0 : ℝ), z) (spokesP E) := by
  rw [spokesCausality.le_top_iff]
  rintro ((⟨h, -⟩ | h) | ⟨a, b, hxa, hab, -⟩)
  · simp [spokesP] at h
  · have := h.dist_lt
    rw [dist_eq_norm] at this
    simp only [spokesP, sub_zero] at this
    linarith
  · have hxa' := hxa.eq_of_fst_eq hab.1.symm
    subst hxa'
    exact hz hab.2.2.1

/-- **A spoke point outside the unit ball is continuously reachable from `p`**, directly from
`defi:futur_continue`: for every sequence `u_n → p`, eventually `o ≪ u_n`. -/
theorem spokes_mem_Kminus {z : E} (hz : z ∈ A) (h1 : 1 < ‖z‖) :
    ((0 : ℝ), z) ∈ (spokesCausality A).Kminus ⊤ {spokesP E} := by
  rw [Causality.mem_Kminus_singleton]
  intro u hu
  have hev : ∀ᶠ n in atTop, (spokesCausality A).lt ⊤ ((0 : ℝ), (0 : E)) (u n) :=
    hu.eventually (((spokesCausality A).isOpen_lt_right ⊤ _).mem_nhds (spokes_origin_lt (A := A)))
  obtain ⟨N, hN⟩ := eventually_atTop.1 hev
  refine ⟨N, ?_⟩
  have hzp : (spokesCausality A).le ⊤ ((0 : ℝ), z) (spokesP E) :=
    (spokesCausality A).le_trans (spokes_le_origin hz)
      ((spokesCausality A).le_of_lt (spokes_origin_lt (A := A)))
  refine ⟨Precausality.mem_Jminus_singleton.2 hzp, mem_nhdsWithin.2 ⟨{x | 1 + |x.1| < ‖x.2‖},
    isOpen_lt (continuous_const.add continuous_fst.abs) continuous_snd.norm, by simpa using h1,
    fun x ⟨hxV, hxJ⟩ => ⟨hxJ, ?_⟩⟩⟩
  rw [Precausality.mem_Jminus_singleton] at hxJ
  have hxo := spokes_le_origin_of_le hxJ hxV
  simp only [mem_iInter, Precausality.mem_Jminus_singleton]
  intro n hn
  exact (spokesCausality A).le_trans hxo ((spokesCausality A).le_of_lt (hN n hn))

/-- **On the slice `t = 0`, outside the unit ball, `K^-(p)` is `A`.** -/
theorem spokes_Kminus_slice {z : E} (h1 : 1 < ‖z‖) :
    ((0 : ℝ), z) ∈ (spokesCausality A).Kminus ⊤ {spokesP E} ↔ z ∈ A := by
  refine ⟨fun hK => ?_, fun hz => spokes_mem_Kminus hz h1⟩
  by_contra hz
  have hJ := Causality.Kminus_subset_Jminus hK
  rw [Precausality.mem_Jminus_singleton] at hJ
  exact spokes_not_le hz h1.le hJ

end Kminus

/-! ### The witness is a topological spacetime, tarentin, causal and absolutely minimal -/

section Properties

variable {A : Set E}

/-- **Tarentin** (`def:tarentin_spacetime`): the chronological diamonds of Minkowski space are
open and lie in the diamonds. -/
theorem spokes_tarentin : (spokesCausality A).Tarentin := by
  intro x N hN
  obtain ⟨p, hp, hpN⟩ := staticCausality.mem_Zminus (X := E) x N hN
  obtain ⟨q, hq, hqN⟩ := staticCausality.mem_Zplus (X := E) x N hN
  rw [Precausality.mem_Iminus_singleton] at hp
  rw [Precausality.mem_Iplus_singleton] at hq
  refine ⟨p, hpN, q, hqN, ?_⟩
  have hsub : {z | (spokesCausality A).lt ⊤ p z} ∩ {z | (spokesCausality A).lt ⊤ z q} ⊆
      (spokesCausality A).diamond ⊤ p q := fun z hz =>
    Causality.mem_diamond.2 ⟨(spokesCausality A).le_of_lt hz.1, (spokesCausality A).le_of_lt hz.2⟩
  exact interior_maximal hsub
    (((spokesCausality A).isOpen_lt_right ⊤ p).inter ((spokesCausality A).isOpen_lt_left ⊤ q))
    ⟨hp, hq⟩

/-- **Causal** (`def:causal_spacetime`): time does not decrease along `≤`, and a spoke moves
strictly towards the origin. -/
theorem spokes_isCausal : (spokesCausality A).IsCausal := by
  intro x y h₁ h₂
  rw [spokesCausality.le_top_iff] at h₁ h₂
  have hxy : x.1 = y.1 := le_antisymm h₁.fst_le h₂.fst_le
  rcases h₁ with h₁ | ⟨a, b, hxa, hab, hby⟩
  · exact h₁.eq_of_fst_eq hxy
  rcases h₂ with h₂ | ⟨a', b', hya', ha'b', hb'x⟩
  · exact (h₂.eq_of_fst_eq hxy.symm).symm
  have hx0 : x.1 = 0 := le_antisymm (hab.1 ▸ hxa.fst_le) (hab.2.1 ▸ hxy ▸ hby.fst_le)
  have hxa' := hxa.eq_of_fst_eq (hx0.trans hab.1.symm)
  have hby' := hby.eq_of_fst_eq (hab.2.1.trans (hxy ▸ hx0).symm)
  have hya'' := hya'.eq_of_fst_eq ((hxy ▸ hx0).trans ha'b'.1.symm)
  have hb'x' := hb'x.eq_of_fst_eq (ha'b'.2.1.trans hx0.symm)
  subst hxa' hby' hya'' hb'x'
  exact hab.eq_of_rel ha'b'

/-- Every point is strongly tarentin in the past: `≪` is that of Minkowski space. -/
theorem spokes_mem_Zminus (x : ℝ × E) : x ∈ (spokesCausality A).Zminus :=
  staticCausality.mem_Zminus x

/-- **Absolutely minimal** (`def:topological_space_causality_absolutely`) when `A` is a cone: a
spoke step is a chain of spoke steps inside the members of any cover (Lebesgue number), and the
chronological steps are Minkowski's, which is absolutely minimal. -/
theorem spokes_absolutelyMinimal (hA : ∀ z ∈ A, ∀ c : ℝ, 0 < c → c • z ∈ A) :
    (spokesCausality A).AbsolutelyMinimal := by
  have hst := Precausality.absolutelyMinimal_iff.1 (staticCausality.absolutelyMinimal (X := E))
  refine Precausality.absolutelyMinimal_iff.2 fun S hS V hV x y => ?_
  set R : ℝ × E → ℝ × E → Prop := fun a b => ∃ O ∈ S, (spokesCausality A).le (V ⊓ O) a b
    with hR
  -- a chronological step is a chain of chronological steps (Minkowski space)
  have hbase : ∀ a b, Spokes.base (V : Set (ℝ × E)) a b → ReflTransGen R a b := by
    rintro a b (⟨rfl, -⟩ | h)
    · exact ReflTransGen.refl
    · exact (TransGen.mono (fun c d ⟨O, hO, hcd⟩ => ⟨O, hO, Or.inl (Or.inr hcd)⟩)
        ((hst S hS V hV a b).2 h)).to_reflTransGen
  -- a spoke step is a chain of spoke steps (Lebesgue number)
  have hrel : ∀ a b, Spokes.rel A (V : Set (ℝ × E)) a b → ReflTransGen R a b := by
    rintro a b ⟨ha, hb, hAa, c, hc, hbc, hseg⟩
    let φ : ℝ → ℝ × E := fun s => ((0 : ℝ), s • a.2)
    have hφ : Continuous φ := continuous_const.prodMk (continuous_id.smul continuous_const)
    have hcover : Icc c 1 ⊆ ⋃ i : S, φ ⁻¹' ((V ⊓ i.1 : Opens (ℝ × E)) : Set (ℝ × E)) := by
      intro s hs
      obtain ⟨O, hO, hsO⟩ := hS (φ s) trivial
      exact mem_iUnion.2 ⟨⟨O, hO⟩, ⟨hseg s hs, hsO⟩⟩
    obtain ⟨t, ht0, hmono, ⟨m, hm⟩, htI, hsub⟩ := exists_subdivision_Icc hc.2
      (fun i : S => (V ⊓ i.1).isOpen.preimage hφ) hcover
    have key : ∀ n, ReflTransGen R (φ (t n)) b := by
      intro n
      induction n with
      | zero =>
        have : φ (t 0) = b := Prod.ext (by simp [φ, hb]) (by simp [φ, ht0, hbc])
        rw [this]
      | succ n ih =>
        obtain ⟨i, hi⟩ := hsub n
        have hle : t n ≤ t (n + 1) := hmono (Nat.le_succ n)
        rcases hle.eq_or_lt with heq | hlt
        · rwa [← heq]
        have h0 : 0 ≤ t n := hc.1.trans (htI n).1
        have hpos : 0 < t (n + 1) := h0.trans_lt hlt
        refine ReflTransGen.head ⟨i.1, i.2, Or.inr ⟨φ (t (n + 1)), φ (t n),
          Or.inl ⟨rfl, hi ⟨hle, le_rfl⟩⟩, ?_, Or.inl ⟨rfl, hi ⟨le_rfl, hle⟩⟩⟩⟩ ih
        refine ⟨rfl, rfl, hA a.2 hAa _ hpos, t n / t (n + 1),
          ⟨div_nonneg h0 hpos.le, (div_le_one hpos).2 hle⟩, ?_, fun σ hσ => ?_⟩
        · simp only [φ]
          rw [smul_smul, div_mul_cancel₀ _ hpos.ne']
        · have hmem := hi (show σ * t (n + 1) ∈ Icc (t n) (t (n + 1)) from
            ⟨(div_le_iff₀ hpos).1 hσ.1, mul_le_of_le_one_left hpos.le hσ.2⟩)
          simp only [φ, mem_preimage] at hmem ⊢
          rwa [smul_smul]
    have hfin : φ (t m) = a := Prod.ext (by simp [φ, ha]) (by simp [φ, hm m le_rfl])
    rw [← hfin]
    exact key m
  refine ⟨fun h => ?_, fun h => TransGen.mono (fun _ _ h => h) ((hst S hS V hV x y).2 h)⟩
  have hx : x ∈ V := h.mem_left
  obtain ⟨O, hO, hxO⟩ := hS x trivial
  have hrefl : R x x := ⟨O, hO, (spokesCausality A).le_refl ⟨hx, hxO⟩⟩
  refine TransGen.head' hrefl ?_
  rcases h with h | ⟨a, b, h₁, h₂, h₃⟩
  · exact hbase x y h
  · exact ((hbase x a h₁).trans (hrel a b h₂)).trans (hbase b y h₃)

end Properties

/-! ### A set of reals which is not Borel, and the cone over it -/

/-- **There is a subset of `ℝ` which is not Borel**: the Borel σ-algebra of `ℝ` is generated by
countably many intervals, so it has at most `𝔠` members, and `ℝ` has `2^𝔠` subsets. -/
theorem exists_not_measurableSet_real : ∃ T : Set ℝ, ¬ MeasurableSet T := by
  by_contra h
  push Not at h
  set s : Set (Set ℝ) := ⋃ (a : ℚ) (b : ℚ) (_ : a < b), {Ioo (a : ℝ) (b : ℝ)} with hs_def
  have hs : Cardinal.mk s ≤ Cardinal.continuum := by
    refine (Set.Countable.le_aleph0 ?_).trans Cardinal.aleph0_le_continuum
    exact countable_iUnion fun a => countable_iUnion fun b =>
      countable_iUnion fun _ => countable_singleton _
  have hcard := MeasurableSpace.cardinal_measurableSet_le_continuum hs
  have huniv : {t | MeasurableSet[MeasurableSpace.generateFrom s] t} = univ := by
    ext t
    simp only [mem_setOf_eq, mem_univ, iff_true]
    rw [hs_def, ← Real.borel_eq_generateFrom_Ioo_rat, ← BorelSpace.measurable_eq]
    exact h t
  rw [huniv, Cardinal.mk_univ, Cardinal.mk_set, Cardinal.mk_real] at hcard
  exact (Cardinal.cantor _).not_ge hcard

/-- The cone over `{x + i : x ∈ T}` in `ℂ`. -/
def coneOver (T : Set ℝ) : Set ℂ := {z | 0 < z.im ∧ z.re / z.im ∈ T}

theorem coneOver_smul {T : Set ℝ} {z : ℂ} (hz : z ∈ coneOver T) {c : ℝ} (hc : 0 < c) :
    c • z ∈ coneOver T := by
  obtain ⟨him, hT⟩ := hz
  refine ⟨?_, ?_⟩
  · rw [Complex.smul_im, smul_eq_mul]; exact mul_pos hc him
  · rw [Complex.smul_im, Complex.smul_re, smul_eq_mul, smul_eq_mul,
      mul_div_mul_left _ _ hc.ne']
    exact hT

/-- **`K^-(p)` Borel forces `T` Borel**: `x ↦ (0, 2x + 2i)` pulls `K^-(p)` back to `T`. -/
theorem spokes_measurableSet_of_measurableSet_Kminus {T : Set ℝ}
    (h : MeasurableSet ((spokesCausality (coneOver T)).Kminus ⊤ {spokesP ℂ})) :
    MeasurableSet T := by
  let g : ℝ → ℝ × ℂ := fun x => ((0 : ℝ), ((2 * x : ℝ) : ℂ) + 2 * Complex.I)
  have hg : Continuous g := continuous_const.prodMk
    ((Complex.continuous_ofReal.comp (continuous_const.mul continuous_id)).add continuous_const)
  have hre : ∀ x : ℝ, (((2 * x : ℝ) : ℂ) + 2 * Complex.I).re = 2 * x := fun x => by simp
  have him : ∀ x : ℝ, (((2 * x : ℝ) : ℂ) + 2 * Complex.I).im = 2 := fun x => by simp
  have hT : T = g ⁻¹' (spokesCausality (coneOver T)).Kminus ⊤ {spokesP ℂ} := by
    ext x
    have h1 : 1 < ‖((2 * x : ℝ) : ℂ) + 2 * Complex.I‖ := by
      have := Complex.abs_im_le_norm (((2 * x : ℝ) : ℂ) + 2 * Complex.I)
      rw [him, abs_two] at this
      linarith
    rw [mem_preimage, spokes_Kminus_slice h1]
    simp only [coneOver, mem_setOf_eq, hre, him]
    constructor
    · intro hx
      refine ⟨two_pos, ?_⟩
      rwa [mul_div_cancel_left₀ x two_ne_zero]
    · rintro ⟨-, hx⟩
      rwa [mul_div_cancel_left₀ x two_ne_zero] at hx
  rw [hT]
  exact h.preimage hg.measurable

/-! ### The printed remark, refuted -/

/-- `rem:K_borelien` **as printed** (`ETT.tex:829–835`): on a tarentin topological spacetime,
`K^-(p)` is Borel. At universe `0`. Kept as a `Prop` for the finding (kb/0022). -/
def KBorelienAsPrinted : Prop :=
  ∀ (M : Type) [TopologicalSpace M] [SecondCountableTopology M] [T2Space M]
    [MeasurableSpace M] [BorelSpace M] (C : Causality M), C.Tarentin →
    ∀ p : M, MeasurableSet (C.Kminus ⊤ {p})

/-- The same for `K^+(p)`. -/
def KBorelienPlusAsPrinted : Prop :=
  ∀ (M : Type) [TopologicalSpace M] [SecondCountableTopology M] [T2Space M]
    [MeasurableSpace M] [BorelSpace M] (C : Causality M), C.Tarentin →
    ∀ p : M, MeasurableSet (C.Kplus ⊤ {p})

/-- **The counterexample**: Minkowski space `ℝ × ℂ` with spokes along the cone over a non-Borel
`T` is a second countable Hausdorff spacetime, tarentin, causal and absolutely minimal, and
neither `K^-(p)` nor `J^-(p)` is Borel at `p = (1, 0)`; it is neither causally plain nor has
push-up, as it must (`measurableSet_Kminus_of_causallyPlain`, `measurableSet_Kminus_of_pushUp`). -/
theorem spokes_counterexample : ∃ T : Set ℝ,
    (spokesCausality (coneOver T)).Tarentin ∧ (spokesCausality (coneOver T)).IsCausal ∧
    (spokesCausality (coneOver T)).AbsolutelyMinimal ∧
    ¬ MeasurableSet ((spokesCausality (coneOver T)).Kminus ⊤ {spokesP ℂ}) ∧
    ¬ MeasurableSet ((spokesCausality (coneOver T)).Jminus ⊤ {spokesP ℂ}) ∧
    ¬ (spokesCausality (coneOver T)).CausallyPlain ∧ ¬ (spokesCausality (coneOver T)).PushUp := by
  obtain ⟨T, hT⟩ := exists_not_measurableSet_real
  have hK := fun h => hT (spokes_measurableSet_of_measurableSet_Kminus h)
  refine ⟨T, spokes_tarentin, spokes_isCausal,
    spokes_absolutelyMinimal fun z hz c hc => coneOver_smul hz hc, hK,
    fun hJ => hK (Causality.measurableSet_Kminus spokes_tarentin hJ),
    fun hP => hK (Causality.measurableSet_Kminus_of_causallyPlain hP (spokes_mem_Zminus _)),
    fun hP => hK (Causality.measurableSet_Kminus_of_pushUp hP (spokes_mem_Zminus _))⟩

/-- **The counterexample, future form**: the time-reversed witness is tarentin, causal and
absolutely minimal, and neither `K^+(p)` nor `J^+(p)` is Borel at `p = (1, 0)`. -/
theorem spokes_counterexample_future : ∃ T : Set ℝ,
    (spokesCausality (coneOver T)).dual.Tarentin ∧
    (spokesCausality (coneOver T)).dual.IsCausal ∧
    (spokesCausality (coneOver T)).dual.AbsolutelyMinimal ∧
    ¬ MeasurableSet ((spokesCausality (coneOver T)).dual.Kplus ⊤ {spokesP ℂ}) ∧
    ¬ MeasurableSet ((spokesCausality (coneOver T)).dual.Jplus ⊤ {spokesP ℂ}) := by
  obtain ⟨T, hT, hC, hA, hK, hJ, -⟩ := spokes_counterexample
  exact ⟨T, Causality.dual_tarentin.2 hT, Causality.dual_isCausal.2 hC,
    Causality.dual_absolutelyMinimal.2 hA, hK, hJ⟩

/-- **Finding: `rem:K_borelien` is false as printed.** -/
theorem not_kBorelienAsPrinted : ¬ KBorelienAsPrinted := by
  intro h
  obtain ⟨T, hT, -, -, hK, -⟩ := spokes_counterexample
  exact hK (h (ℝ × ℂ) (spokesCausality (coneOver T)) hT (spokesP ℂ))

/-- **Finding: the future form is false as well**, by time reversal. -/
theorem not_kBorelienPlusAsPrinted : ¬ KBorelienPlusAsPrinted := by
  intro h
  obtain ⟨T, hT, -, -, hK, -⟩ := spokes_counterexample
  exact hK (h (ℝ × ℂ) (spokesCausality (coneOver T)).dual
    (Causality.dual_tarentin.2 hT) (spokesP ℂ))

end Causal
