namespace Causal

open Set TopologicalSpace Topology Relation

universe u v

variable {M : Type u} [TopologicalSpace M] {ι : Type v}

namespace Precausality

variable {U : ι → Opens M} {P : ι → Precausality M} {V W : Opens M} {x y z : M}

/-- One step of a generated causal chain in `V`: a relation `≤^i_{V ∩ U_i}` for some `i`. -/
def LinkLe (U : ι → Opens M) (P : ι → Precausality M) (V : Opens M) (x y : M) : Prop :=
  ∃ i, (P i).le (V ⊓ U i) x y

/-- One step of a generated chronological chain in `V`. -/
def LinkLt (U : ι → Opens M) (P : ι → Precausality M) (V : Opens M) (x y : M) : Prop :=
  ∃ i, (P i).lt (V ⊓ U i) x y

theorem LinkLe.mem_left (h : LinkLe U P V x y) : x ∈ V := by
  obtain ⟨i, hi⟩ := h
  exact (inf_le_left : V ⊓ U i ≤ V) ((P i).le_mem_left hi)

theorem LinkLe.mem_right (h : LinkLe U P V x y) : y ∈ V := by
  obtain ⟨i, hi⟩ := h
  exact (inf_le_left : V ⊓ U i ≤ V) ((P i).le_mem_right hi)

theorem LinkLt.mem_left (h : LinkLt U P V x y) : x ∈ V := by
  obtain ⟨i, hi⟩ := h
  exact (inf_le_left : V ⊓ U i ≤ V) ((P i).lt_mem_left hi)

theorem LinkLt.mem_right (h : LinkLt U P V x y) : y ∈ V := by
  obtain ⟨i, hi⟩ := h
  exact (inf_le_left : V ⊓ U i ≤ V) ((P i).lt_mem_right hi)

theorem LinkLe.mono (hVW : V ≤ W) (h : LinkLe U P V x y) : LinkLe U P W x y := by
  obtain ⟨i, hi⟩ := h
  exact ⟨i, (P i).le_mono (inf_le_inf_right _ hVW) hi⟩

theorem LinkLt.mono (hVW : V ≤ W) (h : LinkLt U P V x y) : LinkLt U P W x y := by
  obtain ⟨i, hi⟩ := h
  exact ⟨i, (P i).lt_mono (inf_le_inf_right _ hVW) hi⟩

/-- **`def:precausality_generated_notation_lemma`.** The precausality generated by the family
`(U_i, ≤^i, ≪^i)`: `p ≤_V q` (resp. `p ≪_V q`) if there is a finite sequence of points of `V`
from `p` to `q` whose steps are relations `≤^i_{V ∩ U_i}` (resp. `≪^i_{V ∩ U_i}`). -/
def generated (U : ι → Opens M) (hU : ∀ x : M, ∃ i, x ∈ U i) (P : ι → Precausality M) :
    Precausality M where
  le V := TransGen (LinkLe U P V)
  lt V := TransGen (LinkLt U P V)
  le_mem_left h := by
    obtain ⟨_, hz, -⟩ := TransGen.head'_iff.1 h
    exact hz.mem_left
  le_mem_right h := by
    obtain ⟨_, -, hz⟩ := TransGen.tail'_iff.1 h
    exact hz.mem_right
  lt_mem_left h := by
    obtain ⟨_, hz, -⟩ := TransGen.head'_iff.1 h
    exact hz.mem_left
  lt_mem_right h := by
    obtain ⟨_, -, hz⟩ := TransGen.tail'_iff.1 h
    exact hz.mem_right
  le_refl := by
    intro V x hx
    obtain ⟨i, hi⟩ := hU x
    exact TransGen.single ⟨i, (P i).le_refl ⟨hx, hi⟩⟩
  le_trans h₁ h₂ := h₁.trans h₂
  lt_trans h₁ h₂ := h₁.trans h₂
  le_mono h _ _ h' := TransGen.mono (fun _ _ hl => hl.mono h) h'
  lt_mono h _ _ h' := TransGen.mono (fun _ _ hl => hl.mono h) h'

variable {hU : ∀ x : M, ∃ i, x ∈ U i}

theorem generated_le : (generated U hU P).le V x y ↔ TransGen (LinkLe U P V) x y := Iff.rfl

theorem generated_lt : (generated U hU P).lt V x y ↔ TransGen (LinkLt U P V) x y := Iff.rfl

/-- A relation of the family is a relation of the generated precausality. -/
theorem generated_le_of_le {i : ι} (h : (P i).le (V ⊓ U i) x y) : (generated U hU P).le V x y :=
  TransGen.single ⟨i, h⟩

theorem generated_lt_of_lt {i : ι} (h : (P i).lt (V ⊓ U i) x y) : (generated U hU P).lt V x y :=
  TransGen.single ⟨i, h⟩

/-- Hypothesis (B): the local precausalities agree on the open subsets of the overlaps. -/
def Compatible (U : ι → Opens M) (P : ι → Precausality M) : Prop :=
  ∀ (i j : ι) (V : Opens M), V ≤ U i ⊓ U j → ∀ x y : M,
    ((P i).le V x y ↔ (P j).le V x y) ∧ ((P i).lt V x y ↔ (P j).lt V x y)

/-- Minimality, causal half: a precausality containing the family contains the generated one. -/
theorem generated_le_imp (Q : Precausality M)
    (hQ : ∀ (i : ι) (V : Opens M), V ≤ U i → ∀ x y, (P i).le V x y → Q.le V x y)
    (h : (generated U hU P).le V x y) : Q.le V x y := by
  induction h with
  | single hl =>
    obtain ⟨i, hi⟩ := hl
    exact Q.le_mono inf_le_left (hQ i _ inf_le_right _ _ hi)
  | tail _ hl ih =>
    obtain ⟨i, hi⟩ := hl
    exact Q.le_trans ih (Q.le_mono inf_le_left (hQ i _ inf_le_right _ _ hi))

/-- Minimality, chronological half. -/
theorem generated_lt_imp (Q : Precausality M)
    (hQ : ∀ (i : ι) (V : Opens M), V ≤ U i → ∀ x y, (P i).lt V x y → Q.lt V x y)
    (h : (generated U hU P).lt V x y) : Q.lt V x y := by
  induction h with
  | single hl =>
    obtain ⟨i, hi⟩ := hl
    exact Q.lt_mono inf_le_left (hQ i _ inf_le_right _ _ hi)
  | tail _ hl ih =>
    obtain ⟨i, hi⟩ := hl
    exact Q.lt_trans ih (Q.lt_mono inf_le_left (hQ i _ inf_le_right _ _ hi))

/-- Under (B) the generated precausality extends the family: causal half. -/
theorem generated_le_iff (hB : Compatible U P) {i : ι} (hV : V ≤ U i) :
    (generated U hU P).le V x y ↔ (P i).le V x y := by
  constructor
  · intro h
    have key : ∀ a b, LinkLe U P V a b → (P i).le V a b := by
      rintro a b ⟨j, hj⟩
      have hle : V ⊓ U j ≤ U j ⊓ U i := le_inf inf_le_right (inf_le_left.trans hV)
      exact (P i).le_mono inf_le_left ((hB j i _ hle a b).1.1 hj)
    induction h with
    | single hl => exact key _ _ hl
    | tail _ hl ih => exact (P i).le_trans ih (key _ _ hl)
  · intro h
    refine TransGen.single ⟨i, ?_⟩
    rwa [inf_eq_left.2 hV]

/-- Under (B) the generated precausality extends the family: chronological half. -/
theorem generated_lt_iff (hB : Compatible U P) {i : ι} (hV : V ≤ U i) :
    (generated U hU P).lt V x y ↔ (P i).lt V x y := by
  constructor
  · intro h
    have key : ∀ a b, LinkLt U P V a b → (P i).lt V a b := by
      rintro a b ⟨j, hj⟩
      have hle : V ⊓ U j ≤ U j ⊓ U i := le_inf inf_le_right (inf_le_left.trans hV)
      exact (P i).lt_mono inf_le_left ((hB j i _ hle a b).2.1 hj)
    induction h with
    | single hl => exact key _ _ hl
    | tail _ hl ih => exact (P i).lt_trans ih (key _ _ hl)
  · intro h
    refine TransGen.single ⟨i, ?_⟩
    rwa [inf_eq_left.2 hV]

/-- **`lem:union_causalite`.** Under (A) and (B) there exists a minimal precausality extending
the family, and it is unique: it agrees with `(≤^i, ≪^i)` on the open subsets of `U_i`, and it is
contained in every precausality containing the family. -/
theorem existsUnique_minimal_extension (hU : ∀ x : M, ∃ i, x ∈ U i) (hB : Compatible U P) :
    ∃! G : Precausality M,
      (∀ (i : ι) (V : Opens M), V ≤ U i → ∀ x y,
        (G.le V x y ↔ (P i).le V x y) ∧ (G.lt V x y ↔ (P i).lt V x y)) ∧
      ∀ Q : Precausality M,
        (∀ (i : ι) (V : Opens M), V ≤ U i → ∀ x y,
          ((P i).le V x y → Q.le V x y) ∧ ((P i).lt V x y → Q.lt V x y)) →
        ∀ (V : Opens M) (x y : M), (G.le V x y → Q.le V x y) ∧ (G.lt V x y → Q.lt V x y) := by
  refine ⟨generated U hU P, ⟨fun i V hV x y => ⟨generated_le_iff hB hV, generated_lt_iff hB hV⟩,
    fun Q hQ V x y => ⟨generated_le_imp Q fun i V hV x y => (hQ i V hV x y).1,
      generated_lt_imp Q fun i V hV x y => (hQ i V hV x y).2⟩⟩, ?_⟩
  rintro G ⟨hext, hmin⟩
  -- `G` and the generated precausality contain each other
  have h₁ := hmin (generated U hU P) fun i V hV x y =>
    ⟨(generated_le_iff hB hV).2, (generated_lt_iff hB hV).2⟩
  ext V x y
  · exact ⟨(h₁ V x y).1, generated_le_imp G fun i V hV x y => (hext i V hV x y).1.2⟩
  · exact ⟨(h₁ V x y).2, generated_lt_imp G fun i V hV x y => (hext i V hV x y).2.2⟩

/-! ### Absolute minimality -/

section AbsolutelyMinimal

variable {Q : Precausality M} {S : Set (Opens M)}

/-- Absolute minimality of the open subset `W`, seen as a spacetime: for every cover of `W` by
open sets, every relation in an open subset `V` of `W` is a chain of relations localised in the
members of the cover. -/
def AbsolutelyMinimalOn (Q : Precausality M) (W : Opens M) : Prop :=
  ∀ S : Set (Opens M), (∀ x ∈ W, ∃ O ∈ S, x ∈ O) → ∀ V : Opens M, V ≤ W → ∀ x y : M,
    (Q.le V x y → TransGen (fun a b => ∃ O ∈ S, Q.le (V ⊓ O) a b) x y) ∧
    (Q.lt V x y → TransGen (fun a b => ∃ O ∈ S, Q.lt (V ⊓ O) a b) x y)

/-- **`def:topological_space_causality_absolutely`.** "A precausality `(≤,≪)` on `M` is
absolutely minimal if for every open cover `(U_i)` the precausality generated by
`(U_i, ≤_{U_i}, ≪_{U_i})` is equal to `(≤,≪)`." -/
def AbsolutelyMinimal (Q : Precausality M) : Prop :=
  ∀ (S : Set (Opens M)) (hS : ∀ x : M, ∃ O : S, x ∈ (O : Opens M)),
    generated (fun O : S => (O : Opens M)) hS (fun _ => Q) = Q

/-- "Generation can only shrink a precausality": causal half. -/
theorem le_of_transGen (h : TransGen (fun a b => ∃ O ∈ S, Q.le (V ⊓ O) a b) x y) :
    Q.le V x y := by
  induction h with
  | single hl =>
    obtain ⟨O, -, hO⟩ := hl
    exact Q.le_mono inf_le_left hO
  | tail _ hl ih =>
    obtain ⟨O, -, hO⟩ := hl
    exact Q.le_trans ih (Q.le_mono inf_le_left hO)

/-- "Generation can only shrink a precausality": chronological half. -/
theorem lt_of_transGen (h : TransGen (fun a b => ∃ O ∈ S, Q.lt (V ⊓ O) a b) x y) :
    Q.lt V x y := by
  induction h with
  | single hl =>
    obtain ⟨O, -, hO⟩ := hl
    exact Q.lt_mono inf_le_left hO
  | tail _ hl ih =>
    obtain ⟨O, -, hO⟩ := hl
    exact Q.lt_trans ih (Q.lt_mono inf_le_left hO)

/-- The paper's definition of absolute minimality is absolute minimality of `M` on the
relations. -/
theorem absolutelyMinimal_iff : Q.AbsolutelyMinimal ↔ Q.AbsolutelyMinimalOn ⊤ := by
  constructor
  · intro h S hS V _ x y
    have hS' : ∀ x : M, ∃ O : S, x ∈ (O : Opens M) := fun x => by
      obtain ⟨O, hO, hx⟩ := hS x trivial
      exact ⟨⟨O, hO⟩, hx⟩
    have hgen := h S hS'
    refine ⟨fun hxy => ?_, fun hxy => ?_⟩
    · have hxy' : (generated (fun O : S => (O : Opens M)) hS' (fun _ => Q)).le V x y := by
        rw [hgen]; exact hxy
      exact TransGen.mono (fun a b ⟨O, hO⟩ => ⟨O.1, O.2, hO⟩) hxy'
    · have hxy' : (generated (fun O : S => (O : Opens M)) hS' (fun _ => Q)).lt V x y := by
        rw [hgen]; exact hxy
      exact TransGen.mono (fun a b ⟨O, hO⟩ => ⟨O.1, O.2, hO⟩) hxy'
  · intro h S hS
    have hS' : ∀ x ∈ (⊤ : Opens M), ∃ O ∈ S, x ∈ O := fun x _ => by
      obtain ⟨O, hx⟩ := hS x
      exact ⟨O.1, O.2, hx⟩
    ext V x y
    · constructor
      · intro hxy
        exact generated_le_imp Q (fun _ _ _ _ _ hab => hab) hxy
      · intro hxy
        exact TransGen.mono (fun a b ⟨O, hO, hab⟩ => ⟨⟨O, hO⟩, hab⟩)
          ((h S hS' V le_top x y).1 hxy)
    · constructor
      · intro hxy
        exact generated_lt_imp Q (fun _ _ _ _ _ hab => hab) hxy
      · intro hxy
        exact TransGen.mono (fun a b ⟨O, hO, hab⟩ => ⟨⟨O, hO⟩, hab⟩)
          ((h S hS' V le_top x y).2 hxy)

/-- Absolute minimality against an indexed family covering `W`: causal half. -/
theorem AbsolutelyMinimalOn.linkLe_of_family (h : Q.AbsolutelyMinimalOn W) (O : ι → Opens M)
    (hO : ∀ x ∈ W, ∃ i, x ∈ O i) (hV : V ≤ W) (hxy : Q.le V x y) :
    TransGen (LinkLe O (fun _ => Q) V) x y := by
  have hS : ∀ x ∈ W, ∃ O' ∈ range O, x ∈ O' := fun x hx => by
    obtain ⟨i, hi⟩ := hO x hx
    exact ⟨O i, mem_range_self i, hi⟩
  refine TransGen.mono ?_ ((h (range O) hS V hV x y).1 hxy)
  rintro a b ⟨_, ⟨i, rfl⟩, hab⟩
  exact ⟨i, hab⟩

/-- Absolute minimality against an indexed family covering `W`: chronological half. -/
theorem AbsolutelyMinimalOn.linkLt_of_family (h : Q.AbsolutelyMinimalOn W) (O : ι → Opens M)
    (hO : ∀ x ∈ W, ∃ i, x ∈ O i) (hV : V ≤ W) (hxy : Q.lt V x y) :
    TransGen (LinkLt O (fun _ => Q) V) x y := by
  have hS : ∀ x ∈ W, ∃ O' ∈ range O, x ∈ O' := fun x hx => by
    obtain ⟨i, hi⟩ := hO x hx
    exact ⟨O i, mem_range_self i, hi⟩
  refine TransGen.mono ?_ ((h (range O) hS V hV x y).2 hxy)
  rintro a b ⟨_, ⟨i, rfl⟩, hab⟩
  exact ⟨i, hab⟩

theorem dual_absolutelyMinimalOn : Q.dual.AbsolutelyMinimalOn W ↔ Q.AbsolutelyMinimalOn W := by
  have key : ∀ R : Precausality M, R.AbsolutelyMinimalOn W → R.dual.AbsolutelyMinimalOn W := by
    intro R h S hS V hV x y
    refine ⟨fun hxy => ?_, fun hxy => ?_⟩
    · exact transGen_swap.2 ((h S hS V hV y x).1 hxy)
    · exact transGen_swap.2 ((h S hS V hV y x).2 hxy)
  exact ⟨fun h => by simpa using key _ h, key Q⟩

/-- An open subset of an absolutely minimal open subset need not be absolutely minimal
(`cexemple:point_transparent`); what is inherited is the property against the covers of the
larger set. This is the form used below. -/
theorem AbsolutelyMinimalOn.exists_lt_inf [T1Space M] (h : Q.AbsolutelyMinimalOn W)
    (hV : V ≤ W) (O : Opens M) {p : M} (hpO : p ∈ O) (hpy : Q.lt V p y) :
    ∃ r, Q.lt (V ⊓ O) p r ∧ (r = y ∨ Q.lt V r y) := by
  -- the cover `{O, M ∖ {p}}`
  let O' : Opens M := ⟨{p}ᶜ, isOpen_compl_singleton⟩
  have hS : ∀ x ∈ W, ∃ N ∈ ({O, O'} : Set (Opens M)), x ∈ N := by
    intro x _
    by_cases hx : x = p
    · exact ⟨O, by simp, hx ▸ hpO⟩
    · exact ⟨O', by simp, hx⟩
  obtain ⟨r, ⟨N, hN, hpr⟩, hry⟩ := TransGen.head'_iff.1 ((h _ hS V hV p y).2 hpy)
  have hNO : N = O := by
    rcases hN with rfl | hN
    · rfl
    · exfalso
      rw [mem_singleton_iff] at hN
      subst hN
      exact ((inf_le_right : V ⊓ O' ≤ O') (Q.lt_mem_left hpr)) rfl
  subst hNO
  refine ⟨r, hpr, ?_⟩
  rcases reflTransGen_iff_eq_or_transGen.1 hry with h' | h'
  · exact Or.inl h'.symm
  · exact Or.inr (lt_of_transGen h')

end AbsolutelyMinimal

/-- **`lem:precausalite_engendre_minimale`.** "If the precausalities `(≤^i,≪^i)` are absolutely
minimal, then so is `(≤,≪)`", the precausality they generate. -/
theorem generated_absolutelyMinimal (hU : ∀ x : M, ∃ i, x ∈ U i)
    (hA : ∀ i, (P i).AbsolutelyMinimalOn (U i)) : (generated U hU P).AbsolutelyMinimal := by
  rw [absolutelyMinimal_iff]
  intro S hS V _ x y
  have hS' : ∀ (i : ι), ∀ x ∈ U i, ∃ O ∈ S, x ∈ O := fun _ x _ => hS x trivial
  refine ⟨fun hxy => ?_, fun hxy => ?_⟩
  · -- one link of the chain, refined along the cover `S`
    have key : ∀ a b, LinkLe U P V a b →
        TransGen (fun a b => ∃ O ∈ S, (generated U hU P).le (V ⊓ O) a b) a b := by
      rintro a b ⟨i, hi⟩
      refine TransGen.mono ?_ (((hA i) S (hS' i) (V ⊓ U i) inf_le_right a b).1 hi)
      rintro c d ⟨O, hO, hcd⟩
      refine ⟨O, hO, TransGen.single ⟨i, ?_⟩⟩
      rwa [inf_right_comm]
    induction hxy with
    | single hl => exact key _ _ hl
    | tail _ hl ih => exact ih.trans (key _ _ hl)
  · have key : ∀ a b, LinkLt U P V a b →
        TransGen (fun a b => ∃ O ∈ S, (generated U hU P).lt (V ⊓ O) a b) a b := by
      rintro a b ⟨i, hi⟩
      refine TransGen.mono ?_ (((hA i) S (hS' i) (V ⊓ U i) inf_le_right a b).2 hi)
      rintro c d ⟨O, hO, hcd⟩
      refine ⟨O, hO, TransGen.single ⟨i, ?_⟩⟩
      rwa [inf_right_comm]
    induction hxy with
    | single hl => exact key _ _ hl
    | tail _ hl ih => exact ih.trans (key _ _ hl)

theorem dual_generated (hU : ∀ x : M, ∃ i, x ∈ U i) :
    (generated U hU P).dual = generated U hU fun i => (P i).dual := by
  ext V x y
  · exact (transGen_swap (r := LinkLe U P V)).symm
  · exact (transGen_swap (r := LinkLt U P V)).symm

theorem dual_compatible : Compatible U (fun i => (P i).dual) ↔ Compatible U P :=
  ⟨fun h i j V hV x y => h i j V hV y x, fun h i j V hV x y => h i j V hV y x⟩

end Precausality

namespace Causality

variable {U : ι → Opens M} {C : ι → Causality M} {V : Opens M} {A : Set M} {a p x y z : M}

/-- The generated precausality of a family of causalities is a causality: "properties (a), (b)
and (c) are clear from the construction", and so is openness of `≪`. -/
def generated (U : ι → Opens M) (hU : ∀ x : M, ∃ i, x ∈ U i) (C : ι → Causality M) :
    Causality M where
  toPrecausality := Precausality.generated U hU fun i => (C i).toPrecausality
  le_of_lt h := TransGen.mono (fun _ _ ⟨i, hi⟩ => ⟨i, (C i).le_of_lt hi⟩) h
  isOpen_lt_right V x := by
    rw [isOpen_iff_mem_nhds]
    intro y hy
    obtain ⟨z, hxz, i, hi⟩ := TransGen.tail'_iff.1 hy
    refine Filter.mem_of_superset (((C i).isOpen_lt_right (V ⊓ U i) z).mem_nhds hi) ?_
    intro y' hy'
    exact TransGen.tail' hxz ⟨i, hy'⟩
  isOpen_lt_left V x := by
    rw [isOpen_iff_mem_nhds]
    intro y hy
    obtain ⟨z, ⟨i, hi⟩, hzx⟩ := TransGen.head'_iff.1 hy
    refine Filter.mem_of_superset (((C i).isOpen_lt_left (V ⊓ U i) z).mem_nhds hi) ?_
    intro y' hy'
    exact TransGen.head' ⟨i, hy'⟩ hzx

variable {hU : ∀ x : M, ∃ i, x ∈ U i}

@[simp] theorem generated_toPrecausality :
    (generated U hU C).toPrecausality =
      Precausality.generated U hU fun i => (C i).toPrecausality := rfl

theorem dual_generated (hU : ∀ x : M, ∃ i, x ∈ U i) :
    (generated U hU C).dual = generated U hU fun i => (C i).dual := by
  ext V x y
  · exact (transGen_swap (r := Precausality.LinkLe U (fun i => (C i).toPrecausality) V)).symm
  · exact (transGen_swap (r := Precausality.LinkLt U (fun i => (C i).toPrecausality) V)).symm

/-- `theo:causalite_engendre`, first assertion: the precausality generated by absolutely minimal
causalities is an absolutely minimal causality. Neither (B) nor (C) is used. -/
theorem generated_absolutelyMinimal (hU : ∀ x : M, ∃ i, x ∈ U i)
    (hA : ∀ i, (C i).AbsolutelyMinimalOn (U i)) :
    (generated U hU C).AbsolutelyMinimal :=
  Precausality.generated_absolutelyMinimal hU hA

section Plain

variable [T1Space M] (hA : ∀ i, (C i).AbsolutelyMinimalOn (U i))
  (hB : Precausality.Compatible U fun i => (C i).toPrecausality)
  (hP : ∀ i, (C i).CausallyPlainOn (U i))

include hA hB hP

/-- One causal step followed by a chronological relation: the endpoint is in the closure of the
chronological future of the starting point. -/
theorem mem_closure_Iplus_of_link_of_lt {i : ι} (hap : (C i).le (V ⊓ U i) a p)
    (hpy : (generated U hU C).lt V p y) : y ∈ closure ((generated U hU C).Iplus V {a}) := by
  -- the first chronological step, in the chart `j`
  obtain ⟨q, ⟨j, hj⟩, hqy⟩ := TransGen.head'_iff.1 hpy
  have hpUi : p ∈ U i := (inf_le_right : V ⊓ U i ≤ U i) ((C i).le_mem_right hap)
  -- absolute minimality of the chart `j` brings that step inside `U i`
  obtain ⟨r, hpr, hrq⟩ := (hA j).exists_lt_inf inf_le_right (U i) hpUi hj
  have hle : V ⊓ U j ⊓ U i ≤ U j ⊓ U i := inf_le_inf_right _ inf_le_right
  have hpr' : (C i).lt (V ⊓ U i) p r :=
    (C i).lt_mono (inf_le_inf_right _ inf_le_left) ((hB j i _ hle p r).2.1 hpr)
  -- `r = y`, or `r ≪ y` for the generated causality
  have hry : r = y ∨ (generated U hU C).lt V r y := by
    have hqy' : q = y ∨ (generated U hU C).lt V q y := by
      rcases reflTransGen_iff_eq_or_transGen.1 hqy with h | h
      · exact Or.inl h.symm
      · exact Or.inr h
    rcases hrq with rfl | hrq
    · exact hqy'
    · have hrq' : (generated U hU C).lt V r q := TransGen.single ⟨j, hrq⟩
      rcases hqy' with rfl | hqy'
      · exact Or.inr hrq'
      · exact Or.inr (hrq'.trans hqy')
  -- in the chart `i`, `r` lies in the closure of the chronological future of `a`
  have hr : r ∈ closure ((C i).Iplus (V ⊓ U i) {a}) := by
    refine ((hP i) (V ⊓ U i) inf_le_right {a}).1 ?_
    refine interior_maximal ?_ (isOpen_Iplus (A := {p})) (by simpa using hpr')
    intro w hw
    have hpw : (C i).lt (V ⊓ U i) p w := by simpa using hw
    simpa using (C i).le_trans hap ((C i).le_of_lt hpw)
  have hsub : (C i).Iplus (V ⊓ U i) {a} ⊆ (generated U hU C).Iplus V {a} := by
    intro w hw
    have haw : (C i).lt (V ⊓ U i) a w := by simpa using hw
    have : (generated U hU C).lt V a w := TransGen.single ⟨i, haw⟩
    simpa using this
  rcases hry with rfl | hry
  · exact closure_mono hsub hr
  · -- `I^-(y)` is an open neighbourhood of `r`: it meets the chronological future of `a`
    have hopen : IsOpen {w | (generated U hU C).lt V w y} :=
      (generated U hU C).isOpen_lt_left V y
    obtain ⟨w, hwy, hw⟩ := mem_closure_iff.1 hr _ hopen hry
    have haw : (generated U hU C).lt V a w := by simpa using hsub hw
    have hay : (generated U hU C).lt V a y := haw.trans hwy
    exact subset_closure (by simpa using hay)

/-- The chronological future of a causal future lies in the closure of the chronological
future. -/
theorem mem_closure_Iplus_of_le_of_lt (haz : (generated U hU C).le V a z)
    (hzy : (generated U hU C).lt V z y) : y ∈ closure ((generated U hU C).Iplus V {a}) := by
  have haz' : TransGen (Precausality.LinkLe U (fun i => (C i).toPrecausality) V) a z := haz
  clear haz
  induction haz' using TransGen.head_induction_on with
  | single hl =>
    obtain ⟨i, hi⟩ := hl
    exact mem_closure_Iplus_of_link_of_lt hA hB hP hi hzy
  | @head a' c' hl _ ih =>
    obtain ⟨i, hi⟩ := hl
    rw [mem_closure_iff]
    intro N hN hyN
    obtain ⟨y', hy'N, hy'⟩ := mem_closure_iff.1 ih N hN hyN
    have hcy' : (generated U hU C).lt V c' y' := by simpa using hy'
    have := mem_closure_Iplus_of_link_of_lt (hU := hU) hA hB hP hi hcy'
    exact mem_closure_iff.1 this N hN hy'N

/-- `theo:causalite_engendre`, plainness, future half. -/
theorem generated_interior_Jplus_subset (V : Opens M) (A : Set M) :
    interior ((generated U hU C).Jplus V A) ⊆ closure ((generated U hU C).Iplus V A) := by
  intro x hx
  obtain ⟨i, hi⟩ := hU x
  rw [mem_closure_iff]
  intro N hN hxN
  -- `B = J^+_V(A) ∩ U i` is its own causal future in `V ∩ U i`
  set B : Set M := (generated U hU C).Jplus V A ∩ U i with hBdef
  have hsub : N ∩ interior ((generated U hU C).Jplus V A) ∩ U i ⊆
      (C i).Jplus (V ⊓ U i) B := by
    rintro w ⟨⟨-, hwJ⟩, hwU⟩
    have hwJ' := interior_subset hwJ
    have hwV : w ∈ V := Precausality.Jplus_subset_carrier hwJ'
    exact ⟨w, ⟨hwJ', hwU⟩, (C i).le_refl ⟨hwV, hwU⟩⟩
  have hopen : IsOpen (N ∩ interior ((generated U hU C).Jplus V A) ∩ U i) :=
    (hN.inter isOpen_interior).inter (U i).isOpen
  have hxint : x ∈ interior ((C i).Jplus (V ⊓ U i) B) :=
    interior_maximal hsub hopen ⟨⟨hxN, hx⟩, hi⟩
  have hxcl : x ∈ closure ((C i).Iplus (V ⊓ U i) B) :=
    ((hP i) (V ⊓ U i) inf_le_right B).1 hxint
  obtain ⟨y, hyN, z, hzB, hzy⟩ := mem_closure_iff.1 hxcl N hN hxN
  obtain ⟨a, haA, haz⟩ := hzB.1
  have hzy' : (generated U hU C).lt V z y := TransGen.single ⟨i, hzy⟩
  have hy := mem_closure_Iplus_of_le_of_lt hA hB hP haz hzy'
  obtain ⟨y', hy'N, hy'⟩ := mem_closure_iff.1 hy N hN hyN
  exact ⟨y', hy'N, Precausality.Iplus_mono (singleton_subset_iff.2 haA) hy'⟩

end Plain

/-- `theo:causalite_engendre`, second assertion: "if moreover each `(≤^i,≪^i)` is causally
plain, then so is the generated causality." -/
theorem generated_causallyPlain [T1Space M] (hU : ∀ x : M, ∃ i, x ∈ U i)
    (hA : ∀ i, (C i).AbsolutelyMinimalOn (U i))
    (hB : Precausality.Compatible U fun i => (C i).toPrecausality)
    (hP : ∀ i, (C i).CausallyPlainOn (U i)) : (generated U hU C).CausallyPlain := by
  intro V A
  refine ⟨generated_interior_Jplus_subset hA hB hP V A, ?_⟩
  have hA' : ∀ i, ((C i).dual).AbsolutelyMinimalOn (U i) :=
    fun i => Precausality.dual_absolutelyMinimalOn.2 (hA i)
  have hB' : Precausality.Compatible U fun i => ((C i).dual).toPrecausality :=
    Precausality.dual_compatible.2 hB
  have hP' : ∀ i, ((C i).dual).CausallyPlainOn (U i) := fun i => dual_causallyPlainOn.2 (hP i)
  have := generated_interior_Jplus_subset (hU := hU) hA' hB' hP' V A
  rw [← dual_generated hU] at this
  exact this

/-- **`theo:causalite_engendre`.** Let `(U_i)` be an open cover of `M`, each `U_i` being endowed
with an absolutely minimal causality, (A), these causalities agreeing on the overlaps, (B). Then
the generated precausality is a causality, it restricts to the given one on each `U_i`, and it is
absolutely minimal; if moreover each of the given causalities is causally plain, so is the
generated one. -/
theorem generated_isAbsolutelyMinimal_and_causallyPlain [T1Space M]
    (hU : ∀ x : M, ∃ i, x ∈ U i) (hA : ∀ i, (C i).AbsolutelyMinimalOn (U i))
    (hB : Precausality.Compatible U fun i => (C i).toPrecausality) :
    (∀ (i : ι) (V : Opens M), V ≤ U i → ∀ x y,
      ((generated U hU C).le V x y ↔ (C i).le V x y) ∧
      ((generated U hU C).lt V x y ↔ (C i).lt V x y)) ∧
    (generated U hU C).AbsolutelyMinimal ∧
    ((∀ i, (C i).CausallyPlainOn (U i)) → (generated U hU C).CausallyPlain) :=
  ⟨fun _ _ hV _ _ => ⟨Precausality.generated_le_iff (hU := hU) hB hV,
      Precausality.generated_lt_iff (hU := hU) hB hV⟩,
    generated_absolutelyMinimal hU hA, generated_causallyPlain hU hA hB⟩

end Causality

end Causal
